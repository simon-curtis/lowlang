const inv_2sqrsigma0 = 0.15086504887537272
const log2 = 0.69314718055994529
const inv_log2 = 1.4426950408889634
const two_52 = 4503599627370496.0
const two_63 = 9223372036854775808.0

struct Sampler {
    p: *Prng
    sigma_min: f64
}

fn rint(x: f64) -> i64 {
    let sx = i64(x - 1.0)
    var tx = i64(x)
    var rp = i64(x + two_52) - 4503599627370496
    var rn = i64(x - two_52) + 4503599627370496
    var m = sx >> 63
    rn &= m
    rp &= ~m
    let ub = u32(u64(tx) >> 52)
    m = -i64((((ub + 1) & 0xfff) - 2) >> 31)
    rp &= m
    rn &= m
    tx &= ~m
    tx | rn | rp
}

fn expm_p63(x: f64, ccs: f64) -> u64 {
    var y = 2.0737723660090831e-09
    y = 2.529950637944207e-08 - y * x
    y = 2.7560735616047781e-07 - y * x
    y = 2.7555863502191225e-06 - y * x
    y = 2.4801566833585381e-05 - y * x
    y = 0.00019841273927731189 - y * x
    y = 0.001388888894063187 - y * x
    y = 0.0083333333278008351 - y * x
    y = 0.041666666666110491 - y * x
    y = 0.16666666666698401 - y * x
    y = 0.50000000000001921 - y * x
    y = 0.99999999999999489 - y * x
    y = 1.0 - y * x
    y = y * ccs
    u64(i64(y * two_63))
}

fn base_sample(p: *Prng) -> i64 {
    let lo = p.next_u64()
    let hi = p.next_u8()
    let v0 = u32(lo) & 0xffffff
    let v1 = u32(lo >> 24) & 0xffffff
    let v2 = u32(lo >> 48) | hi << 16
    let dist: u32[] = [
        10745844, 3068844, 3741698,
        5559083, 1580863, 8248194,
        2260429, 13669192, 2736639,
        708981, 4421575, 10046180,
        169348, 7122675, 4136815,
        30538, 13063405, 7650655,
        4132, 14505003, 7826148,
        417, 16768101, 11363290,
        31, 8444042, 8086568,
        1, 12844466, 265321,
        0, 1232676, 13644283,
        0, 38047, 9111839,
        0, 870, 6138264,
        0, 14, 12545723,
        0, 0, 3104126,
        0, 0, 28824,
        0, 0, 198,
        0, 0, 1
    ]
    var z = 0
    var u = 0
    for u < dist.len {
        var cc = (v0 - dist[u + 2]) >> 31
        cc = (v1 - dist[u + 1] - cc) >> 31
        cc = (v2 - dist[u] - cc) >> 31
        z += i64(cc)
        u += 3
    }
    z
}

fn accept_exp(p: *Prng, x: f64, ccs: f64) -> bool {
    var s = u32(i64(x * inv_log2))
    let r = x - f64(i64(s)) * log2
    s ^= (s ^ 63) & -((63 - s) >> 31)
    let z = ((expm_p63(r, ccs) << 1) - 1) >> u64(s)
    var i = 64
    var w: u32 = 0
    for true {
        i -= 8
        w = p.next_u8() - (u32(z >> u64(i)) & 0xff)
        if w != 0 || i <= 0 {
            break
        }
    }
    w >> 31 != 0
}

fn sample(sp: *Sampler, mu: f64, isigma: f64) -> i64 {
    let s = i64(floor(mu))
    let r = mu - f64(s)
    let dss = isigma * isigma * 0.5
    let ccs = isigma * sp.sigma_min
    for true {
        let z0 = base_sample(sp.p)
        let b = i64(sp.p.next_u8() & 1)
        let z = b + ((b << 1) - 1) * z0
        let d = f64(z) - r
        var x = d * d * dss
        x = x - f64(z0 * z0) * inv_2sqrsigma0
        if accept_exp(sp.p, x, ccs) {
            return s + z
        }
    }
    0
}
