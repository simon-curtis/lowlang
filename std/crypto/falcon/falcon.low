import std/crypto
import std/crypto/sha3
import std/io

/// A Falcon parameter set.
pub enum Level {
    /// Falcon-512: degree 512, public key 897 bytes, padded signature 666 bytes.
    Falcon512
    /// Falcon-1024: degree 1024, public key 1793 bytes, padded signature 1280 bytes.
    Falcon1024
}

/// Where the SHAKE256 stream that signing draws its 40-byte nonce and its sampler seeds from comes from.
pub enum Randomness {
    /// The stream is seeded with 48 bytes from `crypto.random`, so signing the same message twice gives two signatures.
    Hedged
    /// The stream is seeded with the given 48 bytes. Intended for known-answer tests: reusing a seed for two messages reuses the nonce.
    Given(u8[])
}

struct Shape {
    log_n: i64
    padded: i64
    bound: i64
    fg_bits: i64
    sigma_min: f64
    inv_sigma: f64
}

fn shape(level: Level) -> Shape {
    match level {
        Falcon512 => Shape { log_n: 9, padded: 666, bound: 34034726, fg_bits: 6, sigma_min: 1.2778336969128337, inv_sigma: 0.0060336696681577238 }
        Falcon1024 => Shape { log_n: 10, padded: 1280, bound: 70265242, fg_bits: 5, sigma_min: 1.2982803343442919, inv_sigma: 0.0059386453095331164 }
    }
}

fn private_len(s: Shape) -> i64 {
    1 + (2 * s.fg_bits + 8) << s.log_n >> 3
}

fn decode_private(s: Shape, private: u8[]) -> Basis ! io.Error {
    if private.len != private_len(s) || private[0] != u8(0x50 + s.log_n) {
        fail Invalid
    }
    let n = 1 << s.log_n
    let fg_len = s.fg_bits << s.log_n >> 3
    let f = decode_trim(private, 1, n, s.fg_bits) ?? fail Invalid
    let g = decode_trim(private, 1 + fg_len, n, s.fg_bits) ?? fail Invalid
    let big_f = decode_trim(private, 1 + 2 * fg_len, n, 8) ?? fail Invalid
    let big_g = complete_private(f, g, big_f) ?? fail Invalid
    Basis { f, g, big_f, big_g }
}

fn framed(s: Shape, nonce: u8[], body: u8[], length: i64) -> u8[] {
    let out: u8[] = __make(length)
    out[0] = u8(0x30 + s.log_n)
    __memmove(out[1..], nonce)
    __memmove(out[41..], body)
    out
}

fn seeded(randomness: Randomness) -> *sha3.Shake ! io.Error {
    let seed = match randomness {
        Hedged => crypto.random(48)
        Given(bytes) => bytes
    }
    if seed.len != 48 {
        fail Invalid
    }
    let rng = sha3.shake256()
    sha3.absorb(rng, seed)
    rng
}

fn hash_to_point(nonce: u8[], message: u8[], n: i64) -> i64[] {
    let x = sha3.shake256()
    sha3.absorb(x, nonce)
    sha3.absorb(x, message)
    let c: i64[] = __make(n)
    var count = 0
    for count < n {
        let pair = sha3.squeeze(x, 2)
        let w = i64(pair[0]) << 8 | i64(pair[1])
        if w < 5 * q {
            c[count] = w % q
            count += 1
        }
    }
    c
}

fn centered(x: i64) -> i64 {
    if x > q / 2 {
        return x - q
    }
    x
}

fn short_enough(s1: i64[], s2: i64[], bound: i64) -> bool {
    var norm = 0
    for i in 0..s1.len {
        let a = centered(s1[i])
        norm += a * a + s2[i] * s2[i]
    }
    norm < bound
}

fn padding_is_zero(body: u8[], from: i64) -> bool {
    var rest: u8 = 0
    for i in from..body.len {
        rest |= body[i]
    }
    rest == 0
}

/// Returns the size of a public key for `level`: 897 or 1793 bytes.
pub fn public_key_size(level: Level) -> i64 {
    1 + (14 * (1 << shape(level).log_n) + 7) / 8
}

/// Returns the size of a padded signature for `level`: 666 or 1280 bytes.
pub fn signature_size(level: Level) -> i64 {
    shape(level).padded
}

/// Returns the size of a private key for `level`: 1281 or 2305 bytes.
pub fn private_key_size(level: Level) -> i64 {
    private_len(shape(level))
}

/// Signs `message` with `private` and returns a padded signature of `signature_size(level)` bytes (round-3 specification, version 1.2).
///
/// The private key is the header byte `0x59` or `0x5a` followed by `f` and `g` in 6-bit (Falcon-512) or 5-bit (Falcon-1024) coefficients and `F` in 8-bit coefficients, the encoding of the NIST known-answer files; `G` is recomputed from them. The signature is the header byte `0x39` or `0x3a`, the 40-byte nonce and the compressed `s2`, padded with zero bytes; when the compressed `s2` does not fit, signing samples again with the same nonce, as the reference implementation does. Fails with `Invalid` for a private key of the wrong length or header, a coefficient outside its range, an `f` that is not invertible modulo 12289 or a `G` outside -127..127, and for `Given` randomness that is not 48 bytes.
///
/// Signing follows the reference implementation's constant-time discipline: the secret basis enters only native `f64` additions, subtractions, multiplications, divisions and square roots, integer arithmetic without secret branches or secret table indices, and modular arithmetic by the constant 12289, which compiles to multiplications. The base sampler compares every row of its table, and the rejection steps branch only on uniformly random bytes. Division and square root on `f64` take data-dependent time on some older x86 processors, as in the reference implementation.
pub fn sign(level: Level, private: u8[], message: u8[], randomness: Randomness) -> u8[] ! io.Error {
    let s = shape(level)
    let key = decode_private(s, private)?
    let rng = seeded(randomness)?
    let nonce = sha3.squeeze(rng, 40)
    let hm = hash_to_point(nonce, message, 1 << s.log_n)
    for true {
        let body = encode_compressed(sign_vector(s, key, hm, rng)) ?? continue
        if 41 + body.len <= s.padded {
            return framed(s, nonce, body, s.padded)
        }
    }
    []
}

/// Signs `message` with `private` as the NIST round-3 API does and returns the signature at its natural length.
///
/// The nonce is the 40 bytes of `nonce` and the sampler is seeded from SHAKE256 of the 48 bytes of `seed`, the two values the known-answer harness draws from its generator, in that order, after the 48 bytes of the key-generation seed. The result is the header byte `0x39` or `0x3a`, the nonce and the compressed `s2`, which `verify` accepts as it is; the NIST wrapper writes the same compressed `s2` after the header byte `0x29` or `0x2a`. Intended for known-answer tests; use `sign` otherwise. Fails with `Invalid` for the private keys `sign` rejects, a nonce that is not 40 bytes, a seed that is not 48 bytes and an `s2` with a coefficient beyond 2047, which the compressed encoding cannot hold and for which the reference implementation fails too.
pub fn sign_internal(level: Level, private: u8[], message: u8[], nonce: u8[], seed: u8[]) -> u8[] ! io.Error {
    let s = shape(level)
    let key = decode_private(s, private)?
    if nonce.len != 40 {
        fail Invalid
    }
    let rng = seeded(Given(seed))?
    let hm = hash_to_point(nonce, message, 1 << s.log_n)
    let body = encode_compressed(sign_vector(s, key, hm, rng)) ?? fail Invalid
    framed(s, nonce, body, 41 + body.len)
}

/// Returns whether `signature` is a valid Falcon signature of `message` under `public` (round-3 specification, version 1.2).
///
/// The public key is the header byte `0x09` or `0x0a` followed by the 14-bit encoding of `h`. The signature is the header byte `0x39` or `0x3a`, the 40-byte nonce and the compressed encoding of `s2`, either at its natural length, which for a rare signature can exceed `signature_size(level)` (the known-answer file of Falcon-1024 holds one of 1281 bytes), or padded with zero bytes to exactly `signature_size(level)` bytes. Returns `false`, without failing, for a key or signature of the wrong length or header, a public key coefficient that is not below 12289, a compressed coefficient outside -2047..2047, the encoding `-0`, non-zero bits after the last coefficient, partial or non-zero padding, and a signature whose norm is not below the bound. Verification touches only public data. The uncompressed signature format and the key-recovery mode are not supported.
pub fn verify(level: Level, public: u8[], message: u8[], signature: u8[]) -> bool {
    let s = shape(level)
    let n = 1 << s.log_n
    if public.len != public_key_size(level) || public[0] != u8(s.log_n) {
        return false
    }
    if signature.len < 42 || signature[0] != u8(0x30 + s.log_n) {
        return false
    }
    let h = decode_public(public[1..], n) ?? return false
    let body = signature[41..]
    let decoded = decode_compressed(body, n) ?? return false
    let padded = signature.len == s.padded
    if padded && !padding_is_zero(body, decoded.length) {
        return false
    }
    if !padded && decoded.length != body.len {
        return false
    }
    let s2 = decoded.coefficients
    let c = hash_to_point(signature[1..41], message, n)
    let residues: i64[] = __make(n)
    for i in 0..n {
        residues[i] = (s2[i] % q + q) % q
    }
    let product = negacyclic_multiply(residues, h)
    let s1: i64[] = __make(n)
    for i in 0..n {
        s1[i] = (c[i] - product[i] + q) % q
    }
    short_enough(s1, s2, s.bound)
}
