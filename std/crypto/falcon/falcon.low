import std/crypto/sha3

/// A Falcon parameter set.
pub enum Level {
    /// Falcon-512: degree 512, public key 897 bytes, padded signature 666 bytes.
    Falcon512
    /// Falcon-1024: degree 1024, public key 1793 bytes, padded signature 1280 bytes.
    Falcon1024
}

struct Shape {
    log_n: i64
    padded: i64
    bound: i64
}

fn shape(level: Level) -> Shape {
    match level {
        Falcon512 => Shape { log_n: 9, padded: 666, bound: 34034726 }
        Falcon1024 => Shape { log_n: 10, padded: 1280, bound: 70265242 }
    }
}

fn hash_to_point(nonce: u8[], message: u8[], n: i64) -> i64[] {
    let x = sha3.shake256()
    sha3.absorb(x, nonce)
    sha3.absorb(x, message)
    let c: i64[] = __make(n)
    var count = 0
    for count < n {
        let pair = sha3.squeeze(x, 2)
        let w = i64(pair[0]) << 8 | i64(pair[1])
        if w < 5 * q {
            c[count] = w % q
            count += 1
        }
    }
    c
}

fn centered(x: i64) -> i64 {
    if x > q / 2 {
        return x - q
    }
    x
}

fn short_enough(s1: i64[], s2: i64[], bound: i64) -> bool {
    var norm = 0
    for i in 0..s1.len {
        let a = centered(s1[i])
        norm += a * a + s2[i] * s2[i]
    }
    norm < bound
}

fn padding_is_zero(body: u8[], from: i64) -> bool {
    var rest: u8 = 0
    for i in from..body.len {
        rest |= body[i]
    }
    rest == 0
}

/// Returns the size of a public key for `level`: 897 or 1793 bytes.
pub fn public_key_size(level: Level) -> i64 {
    1 + (14 * (1 << shape(level).log_n) + 7) / 8
}

/// Returns the size of a padded signature for `level`: 666 or 1280 bytes.
pub fn signature_size(level: Level) -> i64 {
    shape(level).padded
}

/// Returns whether `signature` is a valid Falcon signature of `message` under `public` (round-3 specification, version 1.2).
///
/// The public key is the header byte `0x09` or `0x0a` followed by the 14-bit encoding of `h`. The signature is the header byte `0x39` or `0x3a`, the 40-byte nonce and the compressed encoding of `s2`, either at its natural length, which for a rare signature can exceed `signature_size(level)` (the known-answer file of Falcon-1024 holds one of 1281 bytes), or padded with zero bytes to exactly `signature_size(level)` bytes. Returns `false`, without failing, for a key or signature of the wrong length or header, a public key coefficient that is not below 12289, a compressed coefficient outside -2047..2047, the encoding `-0`, non-zero bits after the last coefficient, partial or non-zero padding, and a signature whose norm is not below the bound. Verification touches only public data. The uncompressed signature format and the key-recovery mode are not supported.
pub fn verify(level: Level, public: u8[], message: u8[], signature: u8[]) -> bool {
    let s = shape(level)
    let n = 1 << s.log_n
    if public.len != public_key_size(level) || public[0] != u8(s.log_n) {
        return false
    }
    if signature.len < 42 || signature[0] != u8(0x30 + s.log_n) {
        return false
    }
    let h = decode_public(public[1..], n) ?? return false
    let body = signature[41..]
    let decoded = decode_compressed(body, n) ?? return false
    let padded = signature.len == s.padded
    if padded && !padding_is_zero(body, decoded.length) {
        return false
    }
    if !padded && decoded.length != body.len {
        return false
    }
    let s2 = decoded.coefficients
    let c = hash_to_point(signature[1..41], message, n)
    let residues: i64[] = __make(n)
    for i in 0..n {
        residues[i] = (s2[i] % q + q) % q
    }
    let product = negacyclic_multiply(residues, h)
    let s1: i64[] = __make(n)
    for i in 0..n {
        s1[i] = (c[i] - product[i] + q) % q
    }
    short_enough(s1, s2, s.bound)
}
