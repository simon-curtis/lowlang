const q = 12289

struct Decoded {
    coefficients: []i64
    length: i64
}

fn decode_public(bytes: []u8, n: i64) -> []i64? {
    if bytes.len != (14 * n + 7) / 8 {
        return none
    }
    let h: []i64 = __make(n)
    var acc = 0
    var acc_len = 0
    var at = 0
    for i in 0..n {
        for acc_len < 14 {
            acc = (acc << 8 | i64(bytes[at])) & 0xffffff
            at += 1
            acc_len += 8
        }
        acc_len -= 14
        let w = acc >> acc_len & 0x3fff
        if w >= q {
            return none
        }
        h[i] = w
    }
    if acc & ((1 << acc_len) - 1) != 0 {
        return none
    }
    h
}

fn decode_compressed(bytes: []u8, n: i64) -> Decoded? {
    let x: []i64 = __make(n)
    var acc = 0
    var acc_len = 0
    var v = 0
    for u in 0..n {
        if v >= bytes.len {
            return none
        }
        acc = (acc << 8 | i64(bytes[v])) & 0xffff
        v += 1
        let b = acc >> acc_len
        let sign = b & 128
        var m = b & 127
        for true {
            if acc_len == 0 {
                if v >= bytes.len {
                    return none
                }
                acc = (acc << 8 | i64(bytes[v])) & 0xffff
                v += 1
                acc_len = 8
            }
            acc_len -= 1
            if (acc >> acc_len) & 1 != 0 {
                break
            }
            m += 128
            if m > 2047 {
                return none
            }
        }
        if sign != 0 && m == 0 {
            return none
        }
        x[u] = if sign != 0 { -m } else { m }
    }
    if acc & ((1 << acc_len) - 1) != 0 {
        return none
    }
    Decoded { coefficients: x, length: v }
}
