const q = 12289

struct Decoded {
    coefficients: i64[]
    length: i64
}

fn decode_public(bytes: u8[], n: i64) -> i64[]? {
    if bytes.len != (14 * n + 7) / 8 {
        return none
    }
    let h: i64[] = __make(n)
    var acc = 0
    var acc_len = 0
    var at = 0
    for i in 0..n {
        for acc_len < 14 {
            acc = (acc << 8 | i64(bytes[at])) & 0xffffff
            at += 1
            acc_len += 8
        }
        acc_len -= 14
        let w = acc >> acc_len & 0x3fff
        if w >= q {
            return none
        }
        h[i] = w
    }
    if acc & ((1 << acc_len) - 1) != 0 {
        return none
    }
    h
}

fn decode_compressed(bytes: u8[], n: i64) -> Decoded? {
    let x: i64[] = __make(n)
    var acc = 0
    var acc_len = 0
    var v = 0
    for u in 0..n {
        if v >= bytes.len {
            return none
        }
        acc = (acc << 8 | i64(bytes[v])) & 0xffff
        v += 1
        let b = acc >> acc_len
        let sign = b & 128
        var m = b & 127
        for true {
            if acc_len == 0 {
                if v >= bytes.len {
                    return none
                }
                acc = (acc << 8 | i64(bytes[v])) & 0xffff
                v += 1
                acc_len = 8
            }
            acc_len -= 1
            if (acc >> acc_len) & 1 != 0 {
                break
            }
            m += 128
            if m > 2047 {
                return none
            }
        }
        if sign != 0 && m == 0 {
            return none
        }
        x[u] = if sign != 0 { -m } else { m }
    }
    if acc & ((1 << acc_len) - 1) != 0 {
        return none
    }
    Decoded { coefficients: x, length: v }
}

fn decode_trim(bytes: u8[], at: i64, n: i64, bits: i64) -> i64[]? {
    let x: i64[] = __make(n)
    let mask = (1 << bits) - 1
    let sign = 1 << (bits - 1)
    var acc = 0
    var acc_len = 0
    var v = at
    var u = 0
    for u < n {
        acc = (acc << 8 | i64(bytes[v])) & 0xffffffff
        v += 1
        acc_len += 8
        for acc_len >= bits && u < n {
            acc_len -= bits
            let w = acc >> acc_len & mask
            if w == sign {
                return none
            }
            x[u] = w - (w & sign) * 2
            u += 1
        }
    }
    if acc & ((1 << acc_len) - 1) != 0 {
        return none
    }
    x
}

fn encode_compressed(x: i64[]) -> u8[]? {
    for t in x {
        if t < -2047 || t > 2047 {
            return none
        }
    }
    var out: u8[] = []
    var acc = 0
    var acc_len = 0
    for t in x {
        let negative = t >> 63 & 1
        let w = (t ^ -negative) + negative
        acc = (acc << 8 | negative << 7 | w & 127) << ((w >> 7) + 1) | 1
        acc &= 0xffffffff
        acc_len += 9 + (w >> 7)
        for acc_len >= 8 {
            acc_len -= 8
            out.push(u8(acc >> acc_len))
        }
    }
    if acc_len > 0 {
        out.push(u8(acc << (8 - acc_len)))
    }
    out
}
