fn modp_set(x: i64, p: u32) -> u32 {
    let w = u32(x)
    w + (p & (0 - (w >> 31)))
}

fn modp_norm(x: u32, p: u32) -> i64 {
    i64(i32(x - (p & (((x - ((p + 1) >> 1)) >> 31) - 1))))
}

fn modp_ninv31(p: u32) -> u32 {
    var y = 2 - p
    y *= 2 - p * y
    y *= 2 - p * y
    y *= 2 - p * y
    y *= 2 - p * y
    0x7fffffff & (0 - y)
}

fn modp_r(p: u32) -> u32 {
    (u32(1) << 31) - p
}

fn modp_add(a: u32, b: u32, p: u32) -> u32 {
    let d = a + b - p
    d + (p & (0 - (d >> 31)))
}

fn modp_sub(a: u32, b: u32, p: u32) -> u32 {
    let d = a - b
    d + (p & (0 - (d >> 31)))
}

fn modp_montymul(a: u32, b: u32, p: u32, p0i: u32) -> u32 {
    let z = u64(a) * u64(b)
    let w = ((z * u64(p0i)) & 0x7fffffff) * u64(p)
    let d = u32((z + w) >> 31) - p
    d + (p & (0 - (d >> 31)))
}

fn modp_r2(p: u32, p0i: u32) -> u32 {
    var z = modp_r(p)
    z = modp_add(z, z, p)
    for _ in 0..5 {
        z = modp_montymul(z, z, p, p0i)
    }
    (z + (p & (0 - (z & 1)))) >> 1
}

fn modp_rx(x: u32, p: u32, p0i: u32, r2: u32) -> u32 {
    let e = x - 1
    var r = r2
    var z = modp_r(p)
    var i: u32 = 0
    for (u32(1) << i) <= e {
        if (e & (u32(1) << i)) != 0 {
            z = modp_montymul(z, r, p, p0i)
        }
        r = modp_montymul(r, r, p, p0i)
        i += 1
    }
    z
}

fn modp_div(a: u32, b: u32, p: u32, p0i: u32, r: u32) -> u32 {
    let e = p - 2
    var z = r
    var i = 30
    for i >= 0 {
        z = modp_montymul(z, z, p, p0i)
        let z2 = modp_montymul(z, b, p, p0i)
        z ^= (z ^ z2) & (0 - ((e >> u32(i)) & 1))
        i -= 1
    }
    z = modp_montymul(z, 1, p, p0i)
    modp_montymul(a, z, p, p0i)
}

fn reversed10(x: i64) -> i64 {
    var r = 0
    for i in 0..10 {
        r |= (x >> i & 1) << (9 - i)
    }
    r
}

fn modp_mkgm2(gm: u32[], igm: u32[], log_n: i64, g0: u32, p: u32, p0i: u32) {
    let n = 1 << log_n
    let r2 = modp_r2(p, p0i)
    var g = modp_montymul(g0, r2, p, p0i)
    for _ in log_n..10 {
        g = modp_montymul(g, g, p, p0i)
    }
    let ig = modp_div(r2, g, p, p0i, modp_r(p))
    let k = 10 - log_n
    var x1 = modp_r(p)
    var x2 = modp_r(p)
    for u in 0..n {
        let v = reversed10(u << k)
        gm[v] = x1
        igm[v] = x2
        x1 = modp_montymul(x1, g, p, p0i)
        x2 = modp_montymul(x2, ig, p, p0i)
    }
}

fn modp_ntt2_ext(a: u32[], stride: i64, gm: u32[], log_n: i64, p: u32, p0i: u32) {
    if log_n == 0 {
        return
    }
    let n = 1 << log_n
    var t = n
    var m = 1
    for m < n {
        let ht = t >> 1
        var v1 = 0
        for u in 0..m {
            let s = gm[m + u]
            let r1 = v1 * stride
            let r2 = r1 + ht * stride
            for v in 0..ht {
                let x = a[r1 + v * stride]
                let y = modp_montymul(a[r2 + v * stride], s, p, p0i)
                a[r1 + v * stride] = modp_add(x, y, p)
                a[r2 + v * stride] = modp_sub(x, y, p)
            }
            v1 += t
        }
        t = ht
        m <<= 1
    }
}

fn modp_intt2_ext(a: u32[], stride: i64, igm: u32[], log_n: i64, p: u32, p0i: u32) {
    if log_n == 0 {
        return
    }
    let n = 1 << log_n
    var t = 1
    var m = n
    for m > 1 {
        let hm = m >> 1
        let dt = t << 1
        var v1 = 0
        for u in 0..hm {
            let s = igm[hm + u]
            let r1 = v1 * stride
            let r2 = r1 + t * stride
            for v in 0..t {
                let x = a[r1 + v * stride]
                let y = a[r2 + v * stride]
                a[r1 + v * stride] = modp_add(x, y, p)
                a[r2 + v * stride] = modp_montymul(modp_sub(x, y, p), s, p, p0i)
            }
            v1 += dt
        }
        t = dt
        m = hm
    }
    let ni = u32(1) << u32(31 - log_n)
    for k in 0..n {
        a[k * stride] = modp_montymul(a[k * stride], ni, p, p0i)
    }
}

fn modp_ntt2(a: u32[], gm: u32[], log_n: i64, p: u32, p0i: u32) {
    modp_ntt2_ext(a, 1, gm, log_n, p, p0i)
}

fn modp_intt2(a: u32[], igm: u32[], log_n: i64, p: u32, p0i: u32) {
    modp_intt2_ext(a, 1, igm, log_n, p, p0i)
}

fn modp_poly_rec_res(f: u32[], log_n: i64, p: u32, p0i: u32, r2: u32) {
    let hn = 1 << (log_n - 1)
    for u in 0..hn {
        let w0 = f[u << 1]
        let w1 = f[(u << 1) + 1]
        f[u] = modp_montymul(modp_montymul(w0, w1, p, p0i), r2, p, p0i)
    }
}

fn zint_sub(a: u32[], b: u32[], len: i64, ctl: u32) -> u32 {
    var cc: u32 = 0
    let m = 0 - ctl
    for u in 0..len {
        var aw = a[u]
        let w = aw - b[u] - cc
        cc = w >> 31
        aw ^= ((w & 0x7fffffff) ^ aw) & m
        a[u] = aw
    }
    cc
}

fn zint_mul_small(m: u32[], mlen: i64, x: u32) -> u32 {
    var cc: u32 = 0
    for u in 0..mlen {
        let z = u64(m[u]) * u64(x) + u64(cc)
        m[u] = u32(z) & 0x7fffffff
        cc = u32(z >> 31)
    }
    cc
}

fn zint_mod_small_unsigned(d: u32[], dlen: i64, p: u32, p0i: u32, r2: u32) -> u32 {
    var x: u32 = 0
    var u = dlen
    for u > 0 {
        u -= 1
        x = modp_montymul(x, r2, p, p0i)
        var w = d[u] - p
        w += p & (0 - (w >> 31))
        x = modp_add(x, w, p)
    }
    x
}

fn zint_mod_small_signed(d: u32[], dlen: i64, p: u32, p0i: u32, r2: u32, rx: u32) -> u32 {
    if dlen == 0 {
        return 0
    }
    let z = zint_mod_small_unsigned(d, dlen, p, p0i, r2)
    modp_sub(z, rx & (0 - (d[dlen - 1] >> 30)), p)
}

fn zint_add_mul_small(x: u32[], y: u32[], len: i64, s: u32) {
    var cc: u32 = 0
    for u in 0..len {
        let z = u64(y[u]) * u64(s) + u64(x[u]) + u64(cc)
        x[u] = u32(z) & 0x7fffffff
        cc = u32(z >> 31)
    }
    x[len] = cc
}

fn zint_norm_zero(x: u32[], p: u32[], len: i64) {
    var r: u32 = 0
    var bb: u32 = 0
    var u = len
    for u > 0 {
        u -= 1
        let wx = x[u]
        let wp = (p[u] >> 1) | (bb << 30)
        bb = p[u] & 1
        var cc = wp - wx
        cc = ((0 - cc) >> 31) | (0 - (cc >> 31))
        r |= cc & ((r & 1) - 1)
    }
    zint_sub(x, p, len, r >> 31)
}

fn zint_rebuild_crt(xx: u32[], xlen: i64, xstride: i64, num: i64, normalize_signed: bool, tmp: u32[]) {
    let primes = small_primes()
    tmp[0] = primes[0]
    for u in 1..xlen {
        let p = primes[3 * u]
        let s = primes[3 * u + 2]
        let p0i = modp_ninv31(p)
        let r2 = modp_r2(p, p0i)
        for v in 0..num {
            let x = xx[v * xstride..]
            let xp = x[u]
            let xq = zint_mod_small_unsigned(x, u, p, p0i, r2)
            let xr = modp_montymul(s, modp_sub(xp, xq, p), p, p0i)
            zint_add_mul_small(x, tmp, u, xr)
        }
        tmp[u] = zint_mul_small(tmp, u, p)
    }
    if normalize_signed {
        for u in 0..num {
            zint_norm_zero(xx[u * xstride..], tmp, xlen)
        }
    }
}

fn zint_negate(a: u32[], len: i64, ctl: u32) {
    var cc = ctl
    let m = (0 - ctl) >> 1
    for u in 0..len {
        let aw = (a[u] ^ m) + cc
        a[u] = aw & 0x7fffffff
        cc = aw >> 31
    }
}

fn zint_co_reduce(a: u32[], b: u32[], len: i64, xa: i64, xb: i64, ya: i64, yb: i64) -> u32 {
    var cca = 0
    var ccb = 0
    for u in 0..len {
        let wa = u64(a[u])
        let wb = u64(b[u])
        let za = wa * u64(xa) + wb * u64(xb) + u64(cca)
        let zb = wa * u64(ya) + wb * u64(yb) + u64(ccb)
        if u > 0 {
            a[u - 1] = u32(za) & 0x7fffffff
            b[u - 1] = u32(zb) & 0x7fffffff
        }
        cca = i64(za) >> 31
        ccb = i64(zb) >> 31
    }
    a[len - 1] = u32(cca)
    b[len - 1] = u32(ccb)
    let nega = u32(u64(cca) >> 63)
    let negb = u32(u64(ccb) >> 63)
    zint_negate(a, len, nega)
    zint_negate(b, len, negb)
    nega | (negb << 1)
}

fn zint_finish_mod(a: u32[], len: i64, m: u32[], neg: u32) {
    var cc: u32 = 0
    for u in 0..len {
        cc = (a[u] - m[u] - cc) >> 31
    }
    let xm = (0 - neg) >> 1
    let ym = 0 - (neg | (1 - cc))
    cc = neg
    for u in 0..len {
        let mw = (m[u] ^ xm) & ym
        let aw = a[u] - mw - cc
        a[u] = aw & 0x7fffffff
        cc = aw >> 31
    }
}

fn zint_co_reduce_mod(a: u32[], b: u32[], m: u32[], len: i64, m0i: u32, xa: i64, xb: i64, ya: i64, yb: i64) {
    var cca = 0
    var ccb = 0
    let fa = ((a[0] * u32(xa) + b[0] * u32(xb)) * m0i) & 0x7fffffff
    let fb = ((a[0] * u32(ya) + b[0] * u32(yb)) * m0i) & 0x7fffffff
    for u in 0..len {
        let wa = u64(a[u])
        let wb = u64(b[u])
        let za = wa * u64(xa) + wb * u64(xb) + u64(m[u]) * u64(fa) + u64(cca)
        let zb = wa * u64(ya) + wb * u64(yb) + u64(m[u]) * u64(fb) + u64(ccb)
        if u > 0 {
            a[u - 1] = u32(za) & 0x7fffffff
            b[u - 1] = u32(zb) & 0x7fffffff
        }
        cca = i64(za) >> 31
        ccb = i64(zb) >> 31
    }
    a[len - 1] = u32(cca)
    b[len - 1] = u32(ccb)
    zint_finish_mod(a, len, m, u32(u64(cca) >> 63))
    zint_finish_mod(b, len, m, u32(u64(ccb) >> 63))
}

fn zint_bezout(u0: u32[], v0: u32[], x: u32[], y: u32[], len: i64) -> bool {
    if len == 0 {
        return false
    }
    let u1: u32[] = __make(len)
    let v1: u32[] = __make(len)
    let a: u32[] = __make(len)
    let b: u32[] = __make(len)
    let x0i = modp_ninv31(x[0])
    let y0i = modp_ninv31(y[0])
    __memmove(a, x[..len])
    __memmove(b, y[..len])
    u0[0] = 1
    for i in 1..len {
        u0[i] = 0
    }
    for i in 0..len {
        v0[i] = 0
    }
    __memmove(u1, y[..len])
    __memmove(v1, x[..len])
    v1[0] -= 1
    var num = 62 * len + 30
    for num >= 30 {
        bezout_step(u0, v0, u1, v1, a, b, x, y, len, x0i, y0i)
        num -= 30
    }
    var rc = a[0] ^ 1
    for j in 1..len {
        rc |= a[j]
    }
    ((1 - ((rc | (0 - rc)) >> 31)) & x[0] & y[0]) != 0
}

fn bezout_step(u0: u32[], v0: u32[], u1: u32[], v1: u32[], a: u32[], b: u32[], x: u32[], y: u32[], len: i64, x0i: u32, y0i: u32) {
    var c0: u32 = 0xffffffff
    var c1: u32 = 0xffffffff
    var a0: u32 = 0
    var a1: u32 = 0
    var b0: u32 = 0
    var b1: u32 = 0
    var j = len
    for j > 0 {
        j -= 1
        let aw = a[j]
        let bw = b[j]
        a0 ^= (a0 ^ aw) & c0
        a1 ^= (a1 ^ aw) & c1
        b0 ^= (b0 ^ bw) & c0
        b1 ^= (b1 ^ bw) & c1
        c1 = c0
        c0 &= (((aw | bw) + 0x7fffffff) >> 31) - 1
    }
    a1 |= a0 & c1
    a0 &= ~c1
    b1 |= b0 & c1
    b0 &= ~c1
    var a_hi = (u64(a0) << 31) + u64(a1)
    var b_hi = (u64(b0) << 31) + u64(b1)
    var a_lo = a[0]
    var b_lo = b[0]
    var pa = 1
    var pb = 0
    var qa = 0
    var qb = 1
    for i in 0..31 {
        let rz = b_hi - a_hi
        let rt = u32((rz ^ ((a_hi ^ b_hi) & (a_hi ^ rz))) >> 63)
        let oa = (a_lo >> u32(i)) & 1
        let ob = (b_lo >> u32(i)) & 1
        let c_ab = oa & ob & rt
        let c_ba = oa & ob & ~rt
        let c_a = c_ab | (oa ^ 1)
        a_lo -= b_lo & (0 - c_ab)
        a_hi -= b_hi & (0 - u64(c_ab))
        pa -= qa & (0 - i64(c_ab))
        pb -= qb & (0 - i64(c_ab))
        b_lo -= a_lo & (0 - c_ba)
        b_hi -= a_hi & (0 - u64(c_ba))
        qa -= pa & (0 - i64(c_ba))
        qb -= pb & (0 - i64(c_ba))
        a_lo += a_lo & (c_a - 1)
        pa += pa & (i64(c_a) - 1)
        pb += pb & (i64(c_a) - 1)
        a_hi ^= (a_hi ^ (a_hi >> 1)) & (0 - u64(c_a))
        b_lo += b_lo & (0 - c_a)
        qa += qa & (0 - i64(c_a))
        qb += qb & (0 - i64(c_a))
        b_hi ^= (b_hi ^ (b_hi >> 1)) & (u64(c_a) - 1)
    }
    let r = zint_co_reduce(a, b, len, pa, pb, qa, qb)
    pa -= (pa + pa) & (0 - i64(r & 1))
    pb -= (pb + pb) & (0 - i64(r & 1))
    qa -= (qa + qa) & (0 - i64(r >> 1))
    qb -= (qb + qb) & (0 - i64(r >> 1))
    zint_co_reduce_mod(u0, u1, y, len, y0i, pa, pb, qa, qb)
    zint_co_reduce_mod(v0, v1, x, len, x0i, pa, pb, qa, qb)
}

fn zint_add_scaled_mul_small(x: u32[], xlen: i64, y: u32[], ylen: i64, k: i64, sch: i64, scl: u32) {
    if ylen == 0 {
        return
    }
    let ysign = (0 - (y[ylen - 1] >> 30)) >> 1
    var tw: u32 = 0
    var cc = 0
    for u in sch..xlen {
        let v = u - sch
        let wy = if v < ylen { y[v] } else { ysign }
        let wys = ((wy << scl) & 0x7fffffff) | tw
        tw = wy >> (31 - scl)
        let z = u64(i64(wys) * k + i64(x[u]) + cc)
        x[u] = u32(z) & 0x7fffffff
        cc = i64(i32(u32(z >> 31)))
    }
}

fn zint_sub_scaled(x: u32[], xlen: i64, y: u32[], ylen: i64, sch: i64, scl: u32) {
    if ylen == 0 {
        return
    }
    let ysign = (0 - (y[ylen - 1] >> 30)) >> 1
    var tw: u32 = 0
    var cc: u32 = 0
    for u in sch..xlen {
        let v = u - sch
        let wy = if v < ylen { y[v] } else { ysign }
        let wys = ((wy << scl) & 0x7fffffff) | tw
        tw = wy >> (31 - scl)
        let w = x[u] - wys - cc
        x[u] = w & 0x7fffffff
        cc = w >> 31
    }
}

fn zint_one_to_plain(x: u32[]) -> i64 {
    var w = x[0]
    w |= (w & 0x40000000) << 1
    i64(i32(w))
}

fn poly_big_to_fp(d: f64[], f: u32[], flen: i64, fstride: i64, log_n: i64) {
    let n = 1 << log_n
    if flen == 0 {
        for u in 0..n {
            d[u] = 0.0
        }
        return
    }
    for u in 0..n {
        let fu = f[u * fstride..]
        let neg = 0 - (fu[flen - 1] >> 30)
        let xm = neg >> 1
        var cc = neg & 1
        var x = 0.0
        var fsc = 1.0
        for v in 0..flen {
            var w = (fu[v] ^ xm) + cc
            cc = w >> 31
            w &= 0x7fffffff
            w -= (w << 1) & neg
            x = x + f64(i64(i32(w))) * fsc
            fsc = fsc * 2147483648.0
        }
        d[u] = x
    }
}

fn poly_big_to_small(d: i64[], s: u32[], lim: i64, log_n: i64) -> bool {
    let n = 1 << log_n
    for u in 0..n {
        let z = zint_one_to_plain(s[u..])
        if z < -lim || z > lim {
            return false
        }
        d[u] = z
    }
    true
}

fn poly_sub_scaled(big_f: u32[], big_flen: i64, big_fstride: i64, f: u32[], flen: i64, fstride: i64, k: i64[], sch: i64, scl: u32, log_n: i64) {
    let n = 1 << log_n
    for u in 0..n {
        var kf = -k[u]
        var x = u * big_fstride
        var y = 0
        for v in 0..n {
            zint_add_scaled_mul_small(big_f[x..], big_flen, f[y..], flen, kf, sch, scl)
            if u + v == n - 1 {
                x = 0
                kf = -kf
            } else {
                x += big_fstride
            }
            y += fstride
        }
    }
}

fn poly_sub_scaled_ntt(big_f: u32[], big_flen: i64, big_fstride: i64, f: u32[], flen: i64, fstride: i64, k: i64[], sch: i64, scl: u32, log_n: i64) {
    let n = 1 << log_n
    let tlen = flen + 1
    let gm: u32[] = __make(n)
    let igm: u32[] = __make(n)
    let fk: u32[] = __make(n * tlen)
    let t1: u32[] = __make(if n > tlen { n } else { tlen })
    let primes = small_primes()
    for u in 0..tlen {
        let p = primes[3 * u]
        let p0i = modp_ninv31(p)
        let r2 = modp_r2(p, p0i)
        let rx = modp_rx(u32(flen), p, p0i, r2)
        modp_mkgm2(gm, igm, log_n, primes[3 * u + 1], p, p0i)
        for v in 0..n {
            t1[v] = modp_set(k[v], p)
        }
        modp_ntt2(t1, gm, log_n, p, p0i)
        for v in 0..n {
            fk[u + v * tlen] = zint_mod_small_signed(f[v * fstride..], flen, p, p0i, r2, rx)
        }
        modp_ntt2_ext(fk[u..], tlen, gm, log_n, p, p0i)
        for v in 0..n {
            let at = u + v * tlen
            fk[at] = modp_montymul(modp_montymul(t1[v], fk[at], p, p0i), r2, p, p0i)
        }
        modp_intt2_ext(fk[u..], tlen, igm, log_n, p, p0i)
    }
    zint_rebuild_crt(fk, tlen, tlen, n, true, t1)
    for u in 0..n {
        zint_sub_scaled(big_f[u * big_fstride..], big_flen, fk[u * tlen..], tlen, sch, scl)
    }
}
