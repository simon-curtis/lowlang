import std/crypto/sha3

const inverse_of_q = 8.1373586133940925e-05

struct Basis {
    f: i64[]
    g: i64[]
    big_f: i64[]
    big_g: i64[]
}

struct Tree {
    sp: *Sampler
    gm: f64[]
    inv_sigma: f64
}

fn copy(dst: f64[], src: f64[], n: i64) {
    __memmove(dst, src[..n])
}

fn residues(x: i64[]) -> i64[] {
    let r: i64[] = __make(x.len)
    for i in 0..x.len {
        r[i] = x[i] + (q & (x[i] >> 63))
    }
    r
}

fn complete_private(f: i64[], g: i64[], big_f: i64[]) -> i64[]? {
    let t = transform(f.len)
    let a = forward(t, residues(g))
    let b = forward(t, residues(big_f))
    let d = forward(t, residues(f))
    for i in 0..a.len {
        if d[i] == 0 {
            return none
        }
        a[i] = a[i] * b[i] % q * power(d[i], q - 2) % q
    }
    backward(t, a)
    for i in 0..a.len {
        let w = a[i] - (q & ~((a[i] - (q >> 1)) >> 63))
        if w < -127 || w > 127 {
            return none
        }
        a[i] = w
    }
    a
}

fn load_fft(gm: f64[], r: f64[], x: i64[], log_n: i64) {
    for u in 0..x.len {
        r[u] = f64(x[u])
    }
    fft(gm, r, log_n)
}

fn load_basis(gm: f64[], buf: f64[], key: Basis, log_n: i64) {
    let n = 1 << log_n
    load_fft(gm, buf[n..], key.f, log_n)
    load_fft(gm, buf, key.g, log_n)
    load_fft(gm, buf[3 * n..], key.big_f, log_n)
    load_fft(gm, buf[2 * n..], key.big_g, log_n)
    poly_neg(buf[n..], n)
    poly_neg(buf[3 * n..], n)
}

fn sample_tree(tr: Tree, t0: f64[], t1: f64[], g00: f64[], g01: f64[], g11: f64[], log_n: i64, tmp: f64[]) {
    if log_n == 0 {
        let leaf = sqrt(g00[0]) * tr.inv_sigma
        t0[0] = f64(tr.sp.sample(t0[0], leaf))
        t1[0] = f64(tr.sp.sample(t1[0], leaf))
        return
    }
    let gm = tr.gm
    let n = 1 << log_n
    let hn = n >> 1
    poly_ldl_fft(g00, g01, g11, n)
    poly_split_fft(gm, tmp, tmp[hn..], g00, n)
    copy(g00, tmp, n)
    poly_split_fft(gm, tmp, tmp[hn..], g11, n)
    copy(g11, tmp, n)
    copy(tmp, g01, n)
    copy(g01, g00, hn)
    copy(g01[hn..], g11, hn)
    let z1 = tmp[n..]
    let merged = tmp[2 * n..]
    poly_split_fft(gm, z1, z1[hn..], t1, n)
    sample_tree(tr, z1, z1[hn..], g11, g11[hn..], g01[hn..], log_n - 1, z1[n..])
    poly_merge_fft(gm, merged, z1, z1[hn..], n)
    copy(z1, t1, n)
    poly_sub(z1, merged, n)
    copy(t1, merged, n)
    poly_mul_fft(tmp, z1, n)
    poly_add(t0, tmp, n)
    poly_split_fft(gm, tmp, tmp[hn..], t0, n)
    sample_tree(tr, tmp, tmp[hn..], g00, g00[hn..], g01, log_n - 1, tmp[n..])
    poly_merge_fft(gm, t0, tmp, tmp[hn..], n)
}

fn gram(buf: f64[], n: i64) {
    let b00 = buf
    let b01 = buf[n..]
    let b10 = buf[2 * n..]
    let b11 = buf[3 * n..]
    let t0 = buf[4 * n..]
    let t1 = buf[5 * n..]
    copy(t0, b01, n)
    poly_mulselfadj_fft(t0, n)
    copy(t1, b00, n)
    poly_muladj_fft(t1, b10, n)
    poly_mulselfadj_fft(b00, n)
    poly_add(b00, t0, n)
    copy(t0, b01, n)
    poly_muladj_fft(b01, b11, n)
    poly_add(b01, t1, n)
    poly_mulselfadj_fft(b10, n)
    copy(t1, b11, n)
    poly_mulselfadj_fft(t1, n)
    poly_add(b10, t1, n)
}

fn short_half(sqn: u32, s2: i64[], bound: i64) -> bool {
    var sum = sqn
    var ng = 0 - (sum >> 31)
    for z in s2 {
        sum += u32(z * z)
        ng |= sum
    }
    sum |= 0 - (ng >> 31)
    i64(sum) <= bound
}

fn sign_attempt(s: Shape, tr: Tree, key: Basis, hm: i64[]) -> i64[]? {
    let gm = tr.gm
    let log_n = s.log_n
    let n = 1 << log_n
    let buf: f64[] = __make(9 * n)
    load_basis(gm, buf, key, log_n)
    gram(buf, n)
    let t0 = buf[5 * n..]
    let t1 = buf[6 * n..]
    for u in 0..n {
        t0[u] = f64(hm[u])
    }
    fft(gm, t0, log_n)
    copy(t1, t0, n)
    poly_mul_fft(t1, buf[4 * n..], n)
    poly_mulconst(t1, -inverse_of_q, n)
    poly_mul_fft(t0, buf[3 * n..], n)
    poly_mulconst(t0, inverse_of_q, n)
    copy(buf[3 * n..], t0, 2 * n)
    sample_tree(tr, buf[3 * n..], buf[4 * n..], buf, buf[n..], buf[2 * n..], log_n, buf[5 * n..])
    copy(buf[4 * n..], buf[3 * n..], 2 * n)
    load_basis(gm, buf, key, log_n)
    let z0 = buf[4 * n..]
    let z1 = buf[5 * n..]
    let tx = buf[6 * n..]
    let ty = buf[7 * n..]
    copy(tx, z0, n)
    copy(ty, z1, n)
    poly_mul_fft(tx, buf, n)
    poly_mul_fft(ty, buf[2 * n..], n)
    poly_add(tx, ty, n)
    copy(ty, z0, n)
    poly_mul_fft(ty, buf[n..], n)
    copy(z0, tx, n)
    poly_mul_fft(z1, buf[3 * n..], n)
    poly_add(z1, ty, n)
    inverse_fft(gm, z0, log_n)
    inverse_fft(gm, z1, log_n)
    var sqn: u32 = 0
    var ng: u32 = 0
    for u in 0..n {
        let z = hm[u] - rint(z0[u])
        sqn += u32(z * z)
        ng |= sqn
    }
    sqn |= 0 - (ng >> 31)
    let s2: i64[] = __make(n)
    for u in 0..n {
        s2[u] = -rint(z1[u])
    }
    if !short_half(sqn, s2, s.bound) {
        return none
    }
    s2
}

fn sign_vector(s: Shape, key: Basis, hm: i64[], rng: *sha3.Shake) -> i64[] {
    let gm = fft_roots()
    for true {
        let sp = new(Sampler { p: prng(rng), sigma_min: s.sigma_min })
        let tr = Tree { sp, gm, inv_sigma: s.inv_sigma }
        match sign_attempt(s, tr, key, hm) {
            some(s2) => return s2
            none => {}
        }
    }
    []
}
