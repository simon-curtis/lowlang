import std/crypto
import std/crypto/limb

fn zero(a: []u8) -> bool {
    var acc: u8 = 0
    for byte in a {
        acc |= byte
    }
    acc == 0
}

fn montgomery(g: *Group, a: []u8) -> []u64 {
    let plain = limb.from_bytes(a, g.n.m.len)
    let out = element(g.n)
    to_mont(g.n, out, plain)
    out
}

fn serialized(g: *Group, a: []u64) -> []u8 {
    let plain = element(g.n)
    from_mont(g.n, plain, a)
    encode(plain)
}

/// Returns the scalar of the big-endian encoding `b`, or `none` when `b` is not `g.size` bytes or encodes an integer that is not below the group order.
///
/// The scalar is the same bytes. The running time does not depend on the bytes.
pub fn order_from_bytes(g: *Group, b: []u8) -> []u8? {
    if b.len != g.size {
        return none
    }
    let plain = limb.from_bytes(b, g.n.m.len)
    if !below(plain, g.n.m) {
        return none
    }
    let out: []u8 = __make(b.len)
    __memmove(out, b)
    out
}

/// Returns the big-endian integer `data` reduced modulo the group order, as a big-endian scalar of `g.size` bytes.
///
/// `data` can be up to `2 g.size - 1` bytes, such as the `g.size + 16` bytes that give a uniformly random scalar. The running time depends only on the length of `data`.
pub fn order_reduce(g: *Group, data: []u8) -> []u8 {
    let plain = reduce_wide(g.n, data)
    encode(plain)
}

/// Returns `(a + b) mod n` for big-endian scalars below the group order.
pub fn order_add(g: *Group, a: []u8, b: []u8) -> []u8 {
    let x = montgomery(g, a)
    let y = montgomery(g, b)
    add(g.n, x, x, y)
    serialized(g, x)
}

/// Returns `(a - b) mod n` for big-endian scalars below the group order.
pub fn order_sub(g: *Group, a: []u8, b: []u8) -> []u8 {
    let x = montgomery(g, a)
    let y = montgomery(g, b)
    sub(g.n, x, x, y)
    serialized(g, x)
}

/// Returns `(a * b) mod n` for big-endian scalars below the group order.
pub fn order_mul(g: *Group, a: []u8, b: []u8) -> []u8 {
    let x = montgomery(g, a)
    let y = montgomery(g, b)
    mul(g.n, x, x, y)
    serialized(g, x)
}

/// Returns `(-a) mod n` for a big-endian scalar below the group order.
pub fn order_neg(g: *Group, a: []u8) -> []u8 {
    let zero = element(g.n)
    let x = montgomery(g, a)
    sub(g.n, x, zero, x)
    serialized(g, x)
}

/// Returns the inverse of `a` modulo the group order, or zero for zero, as `a^(n - 2)`.
///
/// The exponent is public, so the running time does not depend on `a`.
pub fn order_invert(g: *Group, a: []u8) -> []u8 {
    let x = montgomery(g, a)
    invert(g.n, x, x)
    serialized(g, x)
}

/// Returns a uniformly random nonzero scalar, from `g.size + 16` bytes of `random` in `std/crypto` reduced modulo the group order, redrawn in the negligible case that the result is zero.
pub fn order_random(g: *Group) -> []u8 {
    var s = order_reduce(g, crypto.random(g.size + 16))
    for zero(s) {
        s = order_reduce(g, crypto.random(g.size + 16))
    }
    s
}
