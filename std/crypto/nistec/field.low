import std/crypto/limb

/// Arithmetic modulo an odd prime in Montgomery form over 64-bit limbs, built once by `field` and shared by reference.
///
/// `add`, `sub`, `mul`, `to_mont` and `from_mont` run in a time that does not depend on the values. Elements are limb slices of `m.len` limbs, least significant first, and are kept below the modulus.
pub struct Field {
    /// The modulus, least significant limb first.
    pub m: u64[]
    inv: u64
    r2: u64[]
    /// The element 1 in Montgomery form.
    pub one: u64[]
    unit: u64[]
    t: u64[]
    w: u64[]
}

/// Returns the field modulo `modulus`, an odd prime of 4 or 6 limbs, least significant limb first.
pub fn field(modulus: u64[]) -> *Field {
    let l = modulus.len
    var inv: u64 = 1
    for _ in 0..6 {
        inv = inv * (2 - modulus[0] * inv)
    }
    let unit: u64[] = __make(l)
    unit[0] = 1
    let f = new(Field { m: modulus, inv: 0 - inv, r2: __make(l), one: __make(l), unit, t: __make(l + 2), w: __make(l) })
    let x: u64[] = __make(l)
    x[0] = 1
    for _ in 0..64 * l {
        add(f, x, x, x)
    }
    __memmove(f.one, x)
    for _ in 0..64 * l {
        add(f, x, x, x)
    }
    __memmove(f.r2, x)
    f
}

/// Returns a new zero element of `f`.
pub fn element(f: *Field) -> u64[] {
    __make(f.m.len)
}

/// Sets `d` to `a + b` modulo the modulus of `f`. `d` can be `a` or `b`.
pub fn add(f: *Field, d: u64[], a: u64[], b: u64[]) {
    let w = f.w
    let carry = limb.add(d, a, b)
    let borrow = limb.sub(w, d, f.m)
    let keep = limb.mask_of(carry | (borrow ^ 1))
    limb.choose(d, w, d, keep)
}

/// Sets `d` to `a - b` modulo the modulus of `f`. `d` can be `a` or `b`.
pub fn sub(f: *Field, d: u64[], a: u64[], b: u64[]) {
    let borrow = limb.sub(d, a, b)
    limb.add_masked(d, f.m, limb.mask_of(borrow))
}

/// Sets `d` to the Montgomery product `a * b / R` modulo the modulus of `f`, where `R = 2^(64 m.len)`. `d` can be `a` or `b`.
pub fn mul(f: *Field, d: u64[], a: u64[], b: u64[]) {
    if f.m.len == 4 {
        return mul4(f, d, a, b)
    }
    let m = f.m
    let t = f.t
    let l = m.len
    let inv = f.inv
    for j in 0..l + 2 {
        t[j] = 0
    }
    for i in 0..l {
        let bi = b[i]
        var c: u64 = 0
        for j in 0..l {
            let x = a[j]
            let lo = x * bi
            let hi = __mulhi(x, bi)
            let tj = t[j]
            let s1 = lo + tj
            let c1 = limb.carry(lo, tj, s1)
            let s2 = s1 + c
            let c2 = limb.carry(s1, c, s2)
            t[j] = s2
            c = hi + c1 + c2
        }
        let top = t[l]
        let sum = top + c
        t[l] = sum
        t[l + 1] = limb.carry(top, c, sum)
        let q = t[0] * inv
        let m0 = m[0]
        let lo0 = q * m0
        let t0 = t[0]
        let s0 = lo0 + t0
        c = __mulhi(q, m0) + limb.carry(lo0, t0, s0)
        for j in 1..l {
            let x = m[j]
            let lo = q * x
            let hi = __mulhi(q, x)
            let tj = t[j]
            let s1 = lo + tj
            let c1 = limb.carry(lo, tj, s1)
            let s2 = s1 + c
            let c2 = limb.carry(s1, c, s2)
            t[j - 1] = s2
            c = hi + c1 + c2
        }
        let last = t[l]
        let total = last + c
        t[l - 1] = total
        t[l] = t[l + 1] + limb.carry(last, c, total)
    }
    let w = f.w
    let borrow = limb.sub(w, t, m)
    let keep = limb.mask_of(t[l] | (borrow ^ 1))
    limb.choose(d, w, t, keep)
}

fn mul4(f: *Field, d: u64[], a: u64[], b: u64[]) {
    let m = f.m
    let inv = f.inv
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let a3 = a[3]
    let m0 = m[0]
    let m1 = m[1]
    let m2 = m[2]
    let m3 = m[3]
    var t0: u64 = 0
    var t1: u64 = 0
    var t2: u64 = 0
    var t3: u64 = 0
    var t4: u64 = 0
    var t5: u64 = 0
    var c: u64 = 0
    let b0 = b[0]
    c = 0
    let lox00 = a0 * b0
    let sx00 = lox00 + t0
    let ux00 = sx00 + c
    c = __mulhi(a0, b0) + limb.carry(lox00, t0, sx00) + limb.carry(sx00, c, ux00)
    t0 = ux00
    let lox01 = a1 * b0
    let sx01 = lox01 + t1
    let ux01 = sx01 + c
    c = __mulhi(a1, b0) + limb.carry(lox01, t1, sx01) + limb.carry(sx01, c, ux01)
    t1 = ux01
    let lox02 = a2 * b0
    let sx02 = lox02 + t2
    let ux02 = sx02 + c
    c = __mulhi(a2, b0) + limb.carry(lox02, t2, sx02) + limb.carry(sx02, c, ux02)
    t2 = ux02
    let lox03 = a3 * b0
    let sx03 = lox03 + t3
    let ux03 = sx03 + c
    c = __mulhi(a3, b0) + limb.carry(lox03, t3, sx03) + limb.carry(sx03, c, ux03)
    t3 = ux03
    let top0 = t4 + c
    t5 = limb.carry(t4, c, top0)
    t4 = top0
    let q0 = t0 * inv
    let r00 = q0 * m0
    let v00 = r00 + t0
    c = __mulhi(q0, m0) + limb.carry(r00, t0, v00)
    let loy01 = q0 * m1
    let sy01 = loy01 + t1
    let uy01 = sy01 + c
    c = __mulhi(q0, m1) + limb.carry(loy01, t1, sy01) + limb.carry(sy01, c, uy01)
    t0 = uy01
    let loy02 = q0 * m2
    let sy02 = loy02 + t2
    let uy02 = sy02 + c
    c = __mulhi(q0, m2) + limb.carry(loy02, t2, sy02) + limb.carry(sy02, c, uy02)
    t1 = uy02
    let loy03 = q0 * m3
    let sy03 = loy03 + t3
    let uy03 = sy03 + c
    c = __mulhi(q0, m3) + limb.carry(loy03, t3, sy03) + limb.carry(sy03, c, uy03)
    t2 = uy03
    let total0 = t4 + c
    t3 = total0
    t4 = t5 + limb.carry(t4, c, total0)
    let b1 = b[1]
    c = 0
    let lox10 = a0 * b1
    let sx10 = lox10 + t0
    let ux10 = sx10 + c
    c = __mulhi(a0, b1) + limb.carry(lox10, t0, sx10) + limb.carry(sx10, c, ux10)
    t0 = ux10
    let lox11 = a1 * b1
    let sx11 = lox11 + t1
    let ux11 = sx11 + c
    c = __mulhi(a1, b1) + limb.carry(lox11, t1, sx11) + limb.carry(sx11, c, ux11)
    t1 = ux11
    let lox12 = a2 * b1
    let sx12 = lox12 + t2
    let ux12 = sx12 + c
    c = __mulhi(a2, b1) + limb.carry(lox12, t2, sx12) + limb.carry(sx12, c, ux12)
    t2 = ux12
    let lox13 = a3 * b1
    let sx13 = lox13 + t3
    let ux13 = sx13 + c
    c = __mulhi(a3, b1) + limb.carry(lox13, t3, sx13) + limb.carry(sx13, c, ux13)
    t3 = ux13
    let top1 = t4 + c
    t5 = limb.carry(t4, c, top1)
    t4 = top1
    let q1 = t0 * inv
    let r10 = q1 * m0
    let v10 = r10 + t0
    c = __mulhi(q1, m0) + limb.carry(r10, t0, v10)
    let loy11 = q1 * m1
    let sy11 = loy11 + t1
    let uy11 = sy11 + c
    c = __mulhi(q1, m1) + limb.carry(loy11, t1, sy11) + limb.carry(sy11, c, uy11)
    t0 = uy11
    let loy12 = q1 * m2
    let sy12 = loy12 + t2
    let uy12 = sy12 + c
    c = __mulhi(q1, m2) + limb.carry(loy12, t2, sy12) + limb.carry(sy12, c, uy12)
    t1 = uy12
    let loy13 = q1 * m3
    let sy13 = loy13 + t3
    let uy13 = sy13 + c
    c = __mulhi(q1, m3) + limb.carry(loy13, t3, sy13) + limb.carry(sy13, c, uy13)
    t2 = uy13
    let total1 = t4 + c
    t3 = total1
    t4 = t5 + limb.carry(t4, c, total1)
    let b2 = b[2]
    c = 0
    let lox20 = a0 * b2
    let sx20 = lox20 + t0
    let ux20 = sx20 + c
    c = __mulhi(a0, b2) + limb.carry(lox20, t0, sx20) + limb.carry(sx20, c, ux20)
    t0 = ux20
    let lox21 = a1 * b2
    let sx21 = lox21 + t1
    let ux21 = sx21 + c
    c = __mulhi(a1, b2) + limb.carry(lox21, t1, sx21) + limb.carry(sx21, c, ux21)
    t1 = ux21
    let lox22 = a2 * b2
    let sx22 = lox22 + t2
    let ux22 = sx22 + c
    c = __mulhi(a2, b2) + limb.carry(lox22, t2, sx22) + limb.carry(sx22, c, ux22)
    t2 = ux22
    let lox23 = a3 * b2
    let sx23 = lox23 + t3
    let ux23 = sx23 + c
    c = __mulhi(a3, b2) + limb.carry(lox23, t3, sx23) + limb.carry(sx23, c, ux23)
    t3 = ux23
    let top2 = t4 + c
    t5 = limb.carry(t4, c, top2)
    t4 = top2
    let q2 = t0 * inv
    let r20 = q2 * m0
    let v20 = r20 + t0
    c = __mulhi(q2, m0) + limb.carry(r20, t0, v20)
    let loy21 = q2 * m1
    let sy21 = loy21 + t1
    let uy21 = sy21 + c
    c = __mulhi(q2, m1) + limb.carry(loy21, t1, sy21) + limb.carry(sy21, c, uy21)
    t0 = uy21
    let loy22 = q2 * m2
    let sy22 = loy22 + t2
    let uy22 = sy22 + c
    c = __mulhi(q2, m2) + limb.carry(loy22, t2, sy22) + limb.carry(sy22, c, uy22)
    t1 = uy22
    let loy23 = q2 * m3
    let sy23 = loy23 + t3
    let uy23 = sy23 + c
    c = __mulhi(q2, m3) + limb.carry(loy23, t3, sy23) + limb.carry(sy23, c, uy23)
    t2 = uy23
    let total2 = t4 + c
    t3 = total2
    t4 = t5 + limb.carry(t4, c, total2)
    let b3 = b[3]
    c = 0
    let lox30 = a0 * b3
    let sx30 = lox30 + t0
    let ux30 = sx30 + c
    c = __mulhi(a0, b3) + limb.carry(lox30, t0, sx30) + limb.carry(sx30, c, ux30)
    t0 = ux30
    let lox31 = a1 * b3
    let sx31 = lox31 + t1
    let ux31 = sx31 + c
    c = __mulhi(a1, b3) + limb.carry(lox31, t1, sx31) + limb.carry(sx31, c, ux31)
    t1 = ux31
    let lox32 = a2 * b3
    let sx32 = lox32 + t2
    let ux32 = sx32 + c
    c = __mulhi(a2, b3) + limb.carry(lox32, t2, sx32) + limb.carry(sx32, c, ux32)
    t2 = ux32
    let lox33 = a3 * b3
    let sx33 = lox33 + t3
    let ux33 = sx33 + c
    c = __mulhi(a3, b3) + limb.carry(lox33, t3, sx33) + limb.carry(sx33, c, ux33)
    t3 = ux33
    let top3 = t4 + c
    t5 = limb.carry(t4, c, top3)
    t4 = top3
    let q3 = t0 * inv
    let r30 = q3 * m0
    let v30 = r30 + t0
    c = __mulhi(q3, m0) + limb.carry(r30, t0, v30)
    let loy31 = q3 * m1
    let sy31 = loy31 + t1
    let uy31 = sy31 + c
    c = __mulhi(q3, m1) + limb.carry(loy31, t1, sy31) + limb.carry(sy31, c, uy31)
    t0 = uy31
    let loy32 = q3 * m2
    let sy32 = loy32 + t2
    let uy32 = sy32 + c
    c = __mulhi(q3, m2) + limb.carry(loy32, t2, sy32) + limb.carry(sy32, c, uy32)
    t1 = uy32
    let loy33 = q3 * m3
    let sy33 = loy33 + t3
    let uy33 = sy33 + c
    c = __mulhi(q3, m3) + limb.carry(loy33, t3, sy33) + limb.carry(sy33, c, uy33)
    t2 = uy33
    let total3 = t4 + c
    t3 = total3
    t4 = t5 + limb.carry(t4, c, total3)
    let w0 = t0 - m0
    var under = limb.borrow(t0, m0, w0)
    let e1 = t1 - m1
    let w1 = e1 - under
    under = limb.borrow(t1, m1, e1) | limb.borrow(e1, under, w1)
    let e2 = t2 - m2
    let w2 = e2 - under
    under = limb.borrow(t2, m2, e2) | limb.borrow(e2, under, w2)
    let e3 = t3 - m3
    let w3 = e3 - under
    under = limb.borrow(t3, m3, e3) | limb.borrow(e3, under, w3)
    let keep = limb.mask_of(t4 | (under ^ 1))
    d[0] = limb.blend(keep, w0, t0)
    d[1] = limb.blend(keep, w1, t1)
    d[2] = limb.blend(keep, w2, t2)
    d[3] = limb.blend(keep, w3, t3)
}

/// Sets `d` to the Montgomery form `a * R` of the integer `a`, which must be below the modulus. `d` can be `a`.
pub fn to_mont(f: *Field, d: u64[], a: u64[]) {
    mul(f, d, a, f.r2)
}

/// Sets `d` to the integer that the Montgomery form `a` stands for. `d` can be `a`.
pub fn from_mont(f: *Field, d: u64[], a: u64[]) {
    mul(f, d, a, f.unit)
}

/// Sets `d` to `a` raised to `exponent`, a plain integer of limbs, least significant limb first.
///
/// The squarings and multiplications follow the 4-bit digits of `exponent`, so it must be a public constant; `a` can be secret.
pub fn power(f: *Field, d: u64[], a: u64[], exponent: u64[]) {
    var table: u64[][] = []
    let first = element(f)
    __memmove(first, f.one)
    table.push(first)
    for i in 1..16 {
        let next = element(f)
        mul(f, next, table[i - 1], a)
        table.push(next)
    }
    let r = element(f)
    __memmove(r, f.one)
    var started = false
    var i = exponent.len * 16 - 1
    for i >= 0 {
        if started {
            for _ in 0..4 {
                mul(f, r, r, r)
            }
        }
        let nibble = i64((exponent[i / 16] >> ((i % 16) * 4)) & 15)
        if nibble != 0 {
            mul(f, r, r, table[nibble])
            started = true
        }
        i -= 1
    }
    __memmove(d, r)
}

/// Sets `d` to the inverse of `a` modulo the modulus of `f`, by raising it to the modulus minus two. The inverse of zero is zero.
pub fn invert(f: *Field, d: u64[], a: u64[]) {
    let e = element(f)
    __memmove(e, f.m)
    e[0] -= 2
    power(f, d, a, e)
}

/// Returns whether the integer `a` is below `m`.
pub fn below(a: u64[], m: u64[]) -> bool {
    let scratch: u64[] = __make(m.len)
    limb.sub(scratch, a, m) == 1
}

/// Returns the limbs of the integer `a` as big-endian bytes, `8 a.len` long.
pub fn encode(a: u64[]) -> u8[] {
    limb.to_bytes(a, a.len * 8)
}

/// Returns the limbs, least significant first, of the big-endian lower-case hexadecimal text `s`, whose length must be a multiple of 16.
pub fn hex_limbs(s: str) -> u64[] {
    let limbs = s.len / 16
    let out: u64[] = __make(limbs)
    for i in 0..s.len {
        let c = s[i]
        let v = if c >= '0' && c <= '9' { c - '0' } else { c - 'a' + 10 }
        let at = s.len - 1 - i
        out[at / 16] |= u64(v) << (4 * (at % 16))
    }
    out
}

/// Returns the big-endian integer `data` reduced modulo the modulus of `f`, as the limbs of a plain integer.
///
/// The modulus must have its top bit set, as the P-256 and P-384 primes and orders do. The low `8 m.len` bytes of `data` can be any value; the bytes above them must stay below the modulus, which holds for up to `8 m.len - 1` of them, so `data` can be up to `16 m.len - 1` bytes, such as the 48 bytes of `hash_to_field` for P-256. The running time depends only on the length of `data`.
pub fn reduce_wide(f: *Field, data: u8[]) -> u64[] {
    let size = f.m.len * 8
    let cut = if data.len > size { data.len - size } else { 0 }
    let raw = limb.from_bytes(data[cut..], f.m.len)
    let out = element(f)
    sub(f, out, raw, f.m)
    if cut > 0 {
        let high = limb.from_bytes(data[..cut], f.m.len)
        let scaled = element(f)
        to_mont(f, scaled, high)
        add(f, out, out, scaled)
    }
    out
}

/// Returns the Montgomery form of the big-endian integer `data`, of any length, reduced modulo the modulus of `f`.
///
/// It folds `data` from the most significant end in chunks of `8 (m.len - 1)` bytes, each below the modulus, multiplying by `2^(64 (m.len - 1))` between chunks, so it holds for any modulus above `2^(64 (m.len - 1))`, such as the 64 bytes per element that RFC 9380 hashes to a 381-bit field. The running time depends only on the length of `data`.
pub fn reduce_mont(f: *Field, data: u8[]) -> u64[] {
    let l = f.m.len
    let size = 8 * (l - 1)
    let shift = element(f)
    shift[l - 1] = 1
    to_mont(f, shift, shift)
    let out = element(f)
    let chunk = element(f)
    var start = data.len % size
    if start > 0 {
        to_mont(f, out, limb.from_bytes(data[..start], l))
    }
    for start < data.len {
        mul(f, out, out, shift)
        to_mont(f, chunk, limb.from_bytes(data[start..start + size], l))
        add(f, out, out, chunk)
        start += size
    }
    out
}
