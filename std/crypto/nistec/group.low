import std/crypto/limb

/// A point of a short Weierstrass curve `y^2 = x^3 - 3 x + b` in homogeneous projective coordinates `(X : Y : Z)`, with `x = X / Z` and `y = Y / Z`, each a field element in Montgomery form. The point at infinity has `Z = 0`.
pub struct Point {
    /// The `X` coordinate.
    pub x: u64[]
    /// The `Y` coordinate.
    pub y: u64[]
    /// The `Z` coordinate.
    pub z: u64[]
}

/// A NIST prime curve: its field, its scalar field, its coefficient `b`, its base point and the scratch space the point addition works in.
///
/// A `Group` is not safe for concurrent use; make one per green thread.
pub struct Group {
    /// The size in bytes of a scalar, a field element and so of each coordinate of a point.
    pub size: i64
    /// The field of the coordinates, modulo the prime `p`.
    pub p: *Field
    /// The field of the scalars, modulo the order `n` of the base point.
    pub n: *Field
    /// The coefficient `b` of the curve equation in Montgomery form.
    pub b: u64[]
    /// The base point.
    pub g: Point
    t0: u64[]
    t1: u64[]
    t2: u64[]
    t3: u64[]
    t4: u64[]
    x3: u64[]
    y3: u64[]
    z3: u64[]
}

struct Constants {
    p: str
    n: str
    b: str
    gx: str
    gy: str
}

fn p256_constants() -> Constants {
    Constants {
        p: "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"
        n: "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"
        b: "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b"
        gx: "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"
        gy: "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"
    }
}

fn p384_constants() -> Constants {
    Constants {
        p: "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff"
        n: "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"
        b: "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef"
        gx: "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7"
        gy: "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"
    }
}

/// Returns NIST P-256 (secp256r1, FIPS 186-4), with 32-byte scalars and coordinates.
pub fn p256() -> *Group {
    build(p256_constants(), 32)
}

/// Returns NIST P-384 (secp384r1, FIPS 186-4), with 48-byte scalars and coordinates.
pub fn p384() -> *Group {
    build(p384_constants(), 48)
}

fn build(c: Constants, size: i64) -> *Group {
    let p = field(hex_limbs(c.p))
    let n = field(hex_limbs(c.n))
    let b = element(p)
    to_mont(p, b, hex_limbs(c.b))
    let gx = element(p)
    to_mont(p, gx, hex_limbs(c.gx))
    let gy = element(p)
    to_mont(p, gy, hex_limbs(c.gy))
    let z = element(p)
    __memmove(z, p.one)
    new(Group {
        size
        p
        n
        b
        g: Point { x: gx, y: gy, z }
        t0: element(p)
        t1: element(p)
        t2: element(p)
        t3: element(p)
        t4: element(p)
        x3: element(p)
        y3: element(p)
        z3: element(p)
    })
}

/// Returns a new point at infinity, the neutral element.
pub fn infinity(g: *Group) -> Point {
    let y = element(g.p)
    __memmove(y, g.p.one)
    Point { x: element(g.p), y, z: element(g.p) }
}

/// Returns whether `a` is the point at infinity.
pub fn is_infinity(a: Point) -> bool {
    limb.is_zero(a.z)
}

/// Sets `out` to `a + c` with the complete addition formulas of Renes, Costello and Batina, which hold for every pair of points including doubling and infinity. `out` can be `a` or `c`.
pub fn point_add(g: *Group, out: Point, a: Point, c: Point) {
    let f = g.p
    let t0 = g.t0
    let t1 = g.t1
    let t2 = g.t2
    let t3 = g.t3
    let t4 = g.t4
    let x3 = g.x3
    let y3 = g.y3
    let z3 = g.z3
    mul(f, t0, a.x, c.x)
    mul(f, t1, a.y, c.y)
    mul(f, t2, a.z, c.z)
    add(f, t3, a.x, a.y)
    add(f, t4, c.x, c.y)
    mul(f, t3, t3, t4)
    add(f, t4, t0, t1)
    sub(f, t3, t3, t4)
    add(f, t4, a.y, a.z)
    add(f, x3, c.y, c.z)
    mul(f, t4, t4, x3)
    add(f, x3, t1, t2)
    sub(f, t4, t4, x3)
    add(f, x3, a.x, a.z)
    add(f, y3, c.x, c.z)
    mul(f, x3, x3, y3)
    add(f, y3, t0, t2)
    sub(f, y3, x3, y3)
    mul(f, z3, g.b, t2)
    sub(f, x3, y3, z3)
    add(f, z3, x3, x3)
    add(f, x3, x3, z3)
    sub(f, z3, t1, x3)
    add(f, x3, t1, x3)
    mul(f, y3, g.b, y3)
    add(f, t1, t2, t2)
    add(f, t2, t1, t2)
    sub(f, y3, y3, t2)
    sub(f, y3, y3, t0)
    add(f, t1, y3, y3)
    add(f, y3, t1, y3)
    add(f, t1, t0, t0)
    add(f, t0, t1, t0)
    sub(f, t0, t0, t2)
    mul(f, t1, t4, y3)
    mul(f, t2, t0, y3)
    mul(f, y3, x3, z3)
    add(f, y3, y3, t2)
    mul(f, x3, t3, x3)
    sub(f, x3, x3, t1)
    mul(f, z3, t4, z3)
    mul(f, t1, t3, t0)
    add(f, z3, z3, t1)
    __memmove(out.x, x3)
    __memmove(out.y, y3)
    __memmove(out.z, z3)
}

/// Returns a new point `-a`.
pub fn negate(g: *Group, a: Point) -> Point {
    let zero = element(g.p)
    let y = element(g.p)
    sub(g.p, y, zero, a.y)
    let x = element(g.p)
    __memmove(x, a.x)
    let z = element(g.p)
    __memmove(z, a.z)
    Point { x, y, z }
}

fn lookup(entry: Point, table: Point[], index: u64) {
    limb.clear(entry.x)
    limb.clear(entry.y)
    limb.clear(entry.z)
    for k, row in table {
        let mask = limb.mask_of(limb.same(u64(k), index))
        limb.gather(entry.x, row.x, mask)
        limb.gather(entry.y, row.y, mask)
        limb.gather(entry.z, row.z, mask)
    }
}

/// Returns `scalar * base` for a big-endian `scalar` of any length.
///
/// The scalar is read in 4-bit windows through a table lookup that touches every entry, so the running time and the memory accesses do not depend on its value. The scalar is not reduced.
pub fn scalar_mul(g: *Group, base: Point, scalar: u8[]) -> Point {
    var table: Point[] = []
    table.push(infinity(g))
    for i in 1..16 {
        let next = infinity(g)
        point_add(g, next, table[i - 1], base)
        table.push(next)
    }
    let acc = infinity(g)
    let entry = infinity(g)
    for byte in scalar {
        for half in 0..2 {
            for _ in 0..4 {
                point_add(g, acc, acc, acc)
            }
            let nibble = if half == 0 { byte >> 4 } else { byte & 15 }
            lookup(entry, table, u64(nibble))
            point_add(g, acc, acc, entry)
        }
    }
    acc
}

/// Returns `a` scaled to `Z = 1`, or `none` for the point at infinity.
pub fn affine(g: *Group, a: Point) -> Point? {
    if limb.is_zero(a.z) {
        return none
    }
    let f = g.p
    let zinv = element(f)
    invert(f, zinv, a.z)
    let x = element(f)
    mul(f, x, a.x, zinv)
    let y = element(f)
    mul(f, y, a.y, zinv)
    let z = element(f)
    __memmove(z, f.one)
    Point { x, y, z }
}

fn on_curve(g: *Group, x: u64[], y: u64[]) -> bool {
    let f = g.p
    let left = element(f)
    mul(f, left, y, y)
    let right = curve_rhs(g, x)
    limb.equal(left, right)
}

fn curve_rhs(g: *Group, x: u64[]) -> u64[] {
    let f = g.p
    let right = element(f)
    mul(f, right, x, x)
    mul(f, right, right, x)
    let triple = element(f)
    add(f, triple, x, x)
    add(f, triple, triple, x)
    sub(f, right, right, triple)
    add(f, right, right, g.b)
    right
}

/// Returns the uncompressed SEC1 point `0x04 || x || y` of the affine point `a`, with big-endian coordinates.
///
/// `a` must have `Z = 1`, as `affine` returns it.
pub fn encode_point(g: *Group, a: Point) -> u8[] {
    let f = g.p
    let x = element(f)
    from_mont(f, x, a.x)
    let y = element(f)
    from_mont(f, y, a.y)
    sec1_point(encode(x), encode(y))
}

/// Returns the uncompressed SEC1 point `0x04 || x || y` for the big-endian coordinates `x` and `y`.
pub fn sec1_point(x: u8[], y: u8[]) -> u8[] {
    let out: u8[] = __make(1 + x.len + y.len)
    out[0] = 4
    __memmove(out[1..], x)
    __memmove(out[1 + x.len..], y)
    out
}

fn field_element(g: *Group, data: u8[]) -> u64[]? {
    let f = g.p
    let raw = limb.from_bytes(data, f.m.len)
    if data.len != g.size || !below(raw, f.m) {
        return none
    }
    let out = element(f)
    to_mont(f, out, raw)
    out
}

/// Returns the point with the big-endian affine coordinates `x` and `y`, or `none` when either is not `size` bytes, is not below the field prime, or the pair is not on the curve.
pub fn point_at(g: *Group, x: u8[], y: u8[]) -> Point? {
    let mx = match field_element(g, x) {
        some(found) => found
        none => return none
    }
    let my = match field_element(g, y) {
        some(found) => found
        none => return none
    }
    if !on_curve(g, mx, my) {
        return none
    }
    let z = element(g.p)
    __memmove(z, g.p.one)
    Point { x: mx, y: my, z }
}

/// Returns the compressed SEC1 point `0x02 || x` or `0x03 || x`, the prefix giving the parity of `y`, for `a`, or `none` when `a` is the point at infinity, which has no compressed form.
pub fn compress(g: *Group, a: Point) -> u8[]? {
    let f = g.p
    let q = match affine(g, a) {
        some(found) => found
        none => return none
    }
    let x = element(f)
    from_mont(f, x, q.x)
    let y = element(f)
    from_mont(f, y, q.y)
    let out: u8[] = __make(1 + g.size)
    out[0] = u8(2 + (y[0] & 1))
    __memmove(out[1..], encode(x))
    out
}

/// Returns the point of the compressed SEC1 encoding `data`, or `none` when it is not `1 + size` bytes starting with `0x02` or `0x03`, `x` is not below the field prime, or no point of the curve has that `x`.
pub fn decompress(g: *Group, data: u8[]) -> Point? {
    if data.len != 1 + g.size || (data[0] != 2 && data[0] != 3) {
        return none
    }
    let f = g.p
    let x = match field_element(g, data[1..]) {
        some(found) => found
        none => return none
    }
    let rhs = curve_rhs(g, x)
    let y = element(f)
    let exponent = sqrt_exponent(f)
    power(f, y, rhs, exponent)
    let check = element(f)
    mul(f, check, y, y)
    if !limb.equal(check, rhs) {
        return none
    }
    let plain = element(f)
    from_mont(f, plain, y)
    if u8(plain[0] & 1) != data[0] - 2 {
        let zero = element(f)
        let flipped = element(f)
        sub(f, flipped, zero, y)
        __memmove(y, flipped)
    }
    let z = element(f)
    __memmove(z, f.one)
    Point { x, y, z }
}

/// Returns `(p + 1) / 4` for the prime `p` of `f`, which must be 3 modulo 4: the exponent of a square root.
pub fn sqrt_exponent(f: *Field) -> u64[] {
    let out = element(f)
    let one = element(f)
    one[0] = 1
    limb.add(out, f.m, one)
    for i in 0..out.len {
        let high = if i + 1 < out.len { out[i + 1] << 62 } else { 0 }
        out[i] = out[i] >> 2 | high
    }
    out
}
