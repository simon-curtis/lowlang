/// Returns `n` bytes from the cryptographically secure random generator of the target.
///
/// On Linux the bytes come from the `getrandom` system call with no flags, so the call blocks until the kernel pool is initialised, and a short or interrupted read is retried until `n` bytes are filled. On Windows they come from `ProcessPrng`. For `browser/wasm32` the host fills the buffer from `crypto.getRandomValues`. An `n` of 0 returns an empty slice. Panics if the generator reports an error, because continuing without secure random bytes would be unsafe.
pub fn random(n: i64) -> []u8 {
    fill(n) catch {
        e => panic("crypto: the random generator failed: {e}")
    }
}
