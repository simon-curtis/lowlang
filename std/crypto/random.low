import std/crypto/aead
import std/io

const key_size = 32
const refill_blocks = 12
const state_at = 64
const zeros_at = 192
const buffer_at = 256
const buffer_size = 768
const reseed_after = (1 << 20) / buffer_size
const chunk_size = 4096
const lock_word = 0
const guard_word = 1
const refills_word = 2
const pos_word = 3
const pid_word = 4
const counter_word = 12
const key_word = 4

fn state_words() -> []i64 {
    let words: ptr[i64] = __static_block()
    view(words, 64)
}

fn state_bytes() -> []u8 {
    let bytes: ptr[u8] = __static_block()
    view(bytes, 1024)
}

fn state_cipher() -> []u32 {
    let bytes = state_bytes()
    let raw: ptr = __slice_ptr(bytes[state_at..state_at + 128])
    let cipher: ptr[u32] = raw
    view(cipher, 32)
}

fn os_bytes(n: i64) -> []u8 {
    fill(n) catch {
        e => panic("crypto: the random generator failed: {e}")
    }
}

fn alive(words: []i64, pid: i64) -> bool {
    let guard = words[guard_word]
    if guard > 0 {
        let marker: ptr[i64] = ptr(guard)
        return load(marker) != 0
    }
    words[pid_word] == pid
}

fn pid_if_unguarded(words: []i64) -> i64 {
    if words[guard_word] > 0 {
        return 0
    }
    process_id()
}

fn erase(bytes: []u8, from: i64, n: i64) {
    var at = from
    var left = n
    for left > 0 {
        let m = if left < 64 { left } else { 64 }
        __memmove(bytes[at..at + m], bytes[zeros_at..zeros_at + m])
        at += m
        left -= m
    }
}

fn refill(words: []i64, cipher: []u32, bytes: []u8) {
    cipher[counter_word] = 0
    aead.chacha20_blocks(cipher, bytes[buffer_at..buffer_at + 64 * refill_blocks], refill_blocks)
    for i in 0..8 {
        cipher[key_word + i] = io.u32_le(bytes, buffer_at + 4 * i)
    }
    cipher[counter_word] = 0
    erase(bytes, buffer_at, key_size)
    words[pos_word] = key_size
}

fn refills_for(words: []i64, n: i64) -> i64 {
    let available = buffer_size - words[pos_word]
    if n <= available {
        return 0
    }
    let usable = buffer_size - key_size
    (n - available + usable - 1) / usable
}

fn take(dst: []u8) -> bool {
    let words = state_words()
    let cipher = state_cipher()
    let bytes = state_bytes()
    let pid = pid_if_unguarded(words)
    __lock(mut words[lock_word])
    if words[refills_word] <= 0 || !alive(words, pid) {
        __unlock(mut words[lock_word])
        return false
    }
    let refills = refills_for(words, dst.len)
    if refills > words[refills_word] {
        __unlock(mut words[lock_word])
        return false
    }
    words[refills_word] -= refills
    var at = 0
    for at < dst.len {
        if words[pos_word] == buffer_size {
            refill(words, cipher, bytes)
        }
        let from = buffer_at + words[pos_word]
        let room = buffer_size - words[pos_word]
        let m = if dst.len - at < room { dst.len - at } else { room }
        __memmove(dst[at..at + m], bytes[from..from + m])
        erase(bytes, from, m)
        words[pos_word] += m
        at += m
    }
    __unlock(mut words[lock_word])
    true
}

fn install() {
    let seed = os_bytes(key_size)
    let pid = process_id()
    let words = state_words()
    let cipher = state_cipher()
    let bytes = state_bytes()
    var page = 0
    if words[guard_word] == 0 {
        page = fork_guard()
    }
    __lock(mut words[lock_word])
    if words[guard_word] == 0 {
        words[guard_word] = page
        page = 0
    }
    if words[guard_word] > 0 {
        let marker: ptr[i64] = ptr(words[guard_word])
        store(marker, 1)
    }
    words[pid_word] = pid
    for i in 0..8 {
        cipher[key_word + i] = io.u32_le(seed, 4 * i)
    }
    erase(bytes, buffer_at, buffer_size)
    words[pos_word] = buffer_size
    words[refills_word] = reseed_after
    __unlock(mut words[lock_word])
    fork_release(page)
    wipe(seed)
}

fn draw(dst: []u8) {
    for !take(dst) {
        install()
    }
}

/// Returns `n` bytes from the cryptographically secure random generator of the process.
///
/// The bytes come from a ChaCha20 generator keyed with 32 bytes from the operating system. A refill runs twelve ChaCha20 blocks under the key, replaces the key with the first 32 bytes of the first block and keeps the other 736 bytes as a buffer that requests consume. Bytes leave the buffer zeroed and the working state of the rounds is zeroed when the refill ends, so a state captured after a request holds neither the key that produced its bytes nor the bytes themselves, only keystream that no request has taken yet. The generator takes a fresh key from the operating system after 1 MiB of output and in a forked child, so a child never repeats its parent's output. On Linux a child is recognised by a page mapped with `MADV_WIPEONFORK` that reads 0 in the child; when the page cannot be mapped the process id is compared instead, and Windows and `browser/wasm32` have no `fork`. The state lives in a 1024-byte block of process memory that belongs to this module, guarded by a lock that does not yield, so any number of green threads and OS threads can call `random` at once. The lock is held only across loops over that block: the result is allocated, the operating system source is read and the marker page is mapped outside it. Requests over 4096 bytes are served in chunks of 4096.
///
/// The operating system source is the `getrandom` system call with no flags on Linux, which blocks until the kernel pool is initialised and retries a short or interrupted read, `ProcessPrng` on Windows, and `crypto.getRandomValues` through the host for `browser/wasm32`. An `n` of 0 returns an empty slice. Panics if the operating system source reports an error, because continuing without secure random bytes would be unsafe.
pub fn random(n: i64) -> []u8 {
    let out = io.buffer(n)
    var at = 0
    for at < n {
        let m = if n - at < chunk_size { n - at } else { chunk_size }
        draw(out[at..at + m])
        at += m
    }
    out
}
