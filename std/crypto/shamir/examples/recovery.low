import std/crypto/shamir
import std/slices

fn describe(e: shamir.Error) -> str {
    match e {
        BadThreshold => "threshold out of range"
        BadShareCount => "too many shares"
        EmptySecret => "empty secret"
        BadRandomness => "wrong amount of randomness"
        TooFewShares => "too few shares"
        DuplicateX => "duplicate share"
        ZeroX => "share at zero"
        LengthMismatch => "shares of different lengths"
    }
}

fn attempt(shares: []shamir.Share) -> str {
    let got = shamir.combine(shares) catch { e => return describe(e) }
    "recovered {got.len} bytes"
}

fn run() ! shamir.Error {
    let secret = bytes("vault passphrase")
    let shares = shamir.split(secret, 5, 3)?
    print("{shares.len} shares, {shares[0].y.len} bytes each, x coordinates:")
    for share in shares {
        print("  {share.x}")
    }

    let quorum = shamir.combine([shares[4], shares[0], shares[2]])?
    print("shares 5, 1 and 3 recover {str(quorum)}")

    let everyone = shamir.combine(shares)?
    print("all five recover {str(everyone)}")

    let short = shamir.combine([shares[1], shares[3]])?
    print("two shares recover the secret: {slices.equal(short, secret)}")

    print("a repeated share: {attempt([shares[1], shares[1], shares[2]])}")
}

/// Splits a passphrase into five shares with a threshold of three, recovers it from any three shares, and shows that two shares do not recover it and a repeated share is rejected.
fn main() {
    run() catch {
        e => print("failed: {describe(e)}")
    }
}
