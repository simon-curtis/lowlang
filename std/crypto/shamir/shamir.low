import std/crypto

/// One share of a split secret.
pub struct Share {
    /// The x coordinate of the share, in `1..=255` and distinct among the shares of one secret.
    pub x: u8
    /// The value of the polynomial at `x` for each byte of the secret, so it is as long as the secret.
    pub y: u8[]
}

/// The error type of the `shamir` functions.
pub enum Error {
    /// The threshold is below 2 or above the share count.
    BadThreshold
    /// The share count is above 255, the number of nonzero elements of GF(2^8).
    BadShareCount
    /// The secret is empty.
    EmptySecret
    /// The randomness given to `split_with` is not `(k - 1) * secret.len` bytes.
    BadRandomness
    /// `combine` was given fewer than two shares.
    TooFewShares
    /// Two shares carry the same x coordinate.
    DuplicateX
    /// A share has x coordinate 0, the position of the secret.
    ZeroX
    /// The shares do not all have the same length.
    LengthMismatch
}

fn mul(a: u8, b: u8) -> u8 {
    var x = u32(a)
    var y = u32(b)
    var product: u32 = 0
    for _ in 0..8 {
        product = product ^ (x & (0 - (y & 1)))
        x = (x << 1) ^ (0x11b & (0 - (x >> 7)))
        y = y >> 1
    }
    u8(product)
}

fn inv(a: u8) -> u8 {
    var power = mul(a, a)
    var out: u8 = 1
    for _ in 0..7 {
        out = mul(out, power)
        power = mul(power, power)
    }
    out
}

fn evaluate(secret: u8, coefficients: u8[], x: u8) -> u8 {
    var acc: u8 = 0
    for i in 0..coefficients.len {
        acc = mul(acc, x) ^ coefficients[coefficients.len - 1 - i]
    }
    mul(acc, x) ^ secret
}

fn weight(shares: Share[], i: i64) -> u8 {
    var numerator: u8 = 1
    var denominator: u8 = 1
    for j in 0..shares.len {
        if j != i {
            numerator = mul(numerator, shares[j].x)
            denominator = mul(denominator, shares[j].x ^ shares[i].x)
        }
    }
    mul(numerator, inv(denominator))
}

fn check_shares(shares: Share[]) ! Error {
    if shares.len < 2 {
        fail TooFewShares
    }
    let seen: u8[] = __make(256)
    for share in shares {
        if share.x == 0 {
            fail ZeroX
        }
        if share.y.len != shares[0].y.len {
            fail LengthMismatch
        }
        if seen[i64(share.x)] != 0 {
            fail DuplicateX
        }
        seen[i64(share.x)] = 1
    }
}

fn check_split(secret: u8[], n: i64, k: i64) ! Error {
    if k < 2 || k > n {
        fail BadThreshold
    }
    if n > 255 {
        fail BadShareCount
    }
    if secret.len == 0 {
        fail EmptySecret
    }
}

/// Splits `secret` into `n` shares, any `k` of which recover it, using the system random source.
///
/// Each secret byte is the constant term of a random polynomial of degree `k - 1` over GF(2^8) with the AES reduction polynomial `0x11b`; the share with x coordinate `x` holds the polynomial values at `x`, for `x` in `1..=n`. Fewer than `k` shares reveal nothing about the secret. Fails with `BadThreshold` when `k` is below 2 or above `n`, `BadShareCount` when `n` is above 255 and `EmptySecret` when `secret` is empty.
pub fn split(secret: u8[], n: i64, k: i64) -> Share[] ! Error {
    check_split(secret, n, k)?
    let random = crypto.random((k - 1) * secret.len)
    evaluate_shares(secret, n, k, random)
}

/// Splits `secret` as `split` does, taking the polynomial coefficients from `random` instead of the system random source.
///
/// `random` holds `k - 1` coefficients for each secret byte, byte after byte: the coefficient of `x^j` for secret byte `i` is `random[i * (k - 1) + j - 1]`. The shares are secret only when `random` is uniformly random and used once, so a caller outside tests uses `split`. Fails with `BadRandomness` when `random` is not `(k - 1) * secret.len` bytes, and as `split` does otherwise.
pub fn split_with(secret: u8[], n: i64, k: i64, random: u8[]) -> Share[] ! Error {
    check_split(secret, n, k)?
    if random.len != (k - 1) * secret.len {
        fail BadRandomness
    }
    evaluate_shares(secret, n, k, random)
}

fn evaluate_shares(secret: u8[], n: i64, k: i64, random: u8[]) -> Share[] {
    let degree = k - 1
    var shares: Share[] = []
    for position in 1..n + 1 {
        let x = u8(position)
        let y: u8[] = __make(secret.len)
        for i in 0..secret.len {
            y[i] = evaluate(secret[i], random[i * degree..(i + 1) * degree], x)
        }
        shares.push(Share { x, y })
    }
    shares
}

/// Returns the secret that `shares` encode, by Lagrange interpolation at x coordinate 0.
///
/// Any `k` shares of a `split` recover the secret and more shares give the same result. Fewer than `k` shares give bytes unrelated to the secret, since the shares carry no check value. The arithmetic does not branch on or index memory by share values. Fails with `TooFewShares` for fewer than two shares, `ZeroX` for a share with x coordinate 0, `LengthMismatch` for shares of unequal length and `DuplicateX` for two shares with one x coordinate.
pub fn combine(shares: Share[]) -> u8[] ! Error {
    check_shares(shares)?
    let length = shares[0].y.len
    let out: u8[] = __make(length)
    for i in 0..shares.len {
        let w = weight(shares, i)
        for b in 0..length {
            out[b] = out[b] ^ mul(w, shares[i].y[b])
        }
    }
    out
}
