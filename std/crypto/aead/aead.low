import std/io

/// An authenticated cipher bound to a key, which seals and opens messages.
///
/// Built by `aes_gcm`, `chacha20_poly1305` or `xchacha20_poly1305`. A nonce must not be reused with the same key.
pub struct Aead {
    /// The length in bytes of the key the cipher was built from.
    pub key_size: i64
    /// The length in bytes of the nonce `seal` and `open` expect.
    pub nonce_size: i64
    /// The length in bytes of the authentication tag `seal` appends to the ciphertext.
    pub tag_size: i64
    /// Encrypts and authenticates a message.
    ///
    /// The arguments are the nonce, the plaintext and the additional data. The additional data is authenticated but neither encrypted nor included in the output. Returns the ciphertext followed by the tag, `plaintext.len + tag_size` bytes.
    pub seal: fn([]u8, []u8, []u8) -> []u8
    /// Verifies and decrypts a sealed message.
    ///
    /// The arguments are the nonce, the ciphertext followed by the tag, and the additional data. Returns the plaintext, `tag_size` bytes shorter than the sealed input. Fails with `io.Error.Invalid` when the sealed input is shorter than the tag, the tag does not match or the nonce length is not accepted by the cipher. The tag is compared in constant time and no plaintext is returned on failure.
    pub open: fn([]u8, []u8, []u8) -> []u8 ! io.Error
}
