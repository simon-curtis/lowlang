import std/io
import std/crypto/hash

struct Poly {
    r0: u64
    r1: u64
    r2: u64
    r3: u64
    r4: u64
    h0: u64
    h1: u64
    h2: u64
    h3: u64
    h4: u64
    pad: []u8
}

fn chacha_words(b: []u8, at: i64, count: i64) -> []u32 {
    let w: []u32 = __make(count)
    for i in 0..count {
        w[i] = io.u32_le(b, at + 4 * i)
    }
    w
}

fn chacha_constants(s: []u32) {
    s[0] = 0x61707865
    s[1] = 0x3320646e
    s[2] = 0x79622d32
    s[3] = 0x6b206574
}

fn zero_words(s: []u32) {
    for i in 0..s.len {
        s[i] = 0
    }
}

fn chacha_rounds(state: []u32) {
    let raw: ptr = __slice_ptr(state[..32])
    let at: ptr[u32] = raw
    let s = view(at, 32)
    var a0 = s[0]
    var b0 = s[4]
    var c0 = s[8]
    var d0 = s[12]
    a0 += b0
    d0 ^= a0
    d0 = d0 << 16 | d0 >> 16
    c0 += d0
    b0 ^= c0
    b0 = b0 << 12 | b0 >> 20
    a0 += b0
    d0 ^= a0
    d0 = d0 << 8 | d0 >> 24
    c0 += d0
    b0 ^= c0
    b0 = b0 << 7 | b0 >> 25
    s[16] = a0
    s[20] = b0
    s[24] = c0
    s[28] = d0
    var a1 = s[1]
    var b1 = s[5]
    var c1 = s[9]
    var d1 = s[13]
    a1 += b1
    d1 ^= a1
    d1 = d1 << 16 | d1 >> 16
    c1 += d1
    b1 ^= c1
    b1 = b1 << 12 | b1 >> 20
    a1 += b1
    d1 ^= a1
    d1 = d1 << 8 | d1 >> 24
    c1 += d1
    b1 ^= c1
    b1 = b1 << 7 | b1 >> 25
    s[17] = a1
    s[21] = b1
    s[25] = c1
    s[29] = d1
    var a2 = s[2]
    var b2 = s[6]
    var c2 = s[10]
    var d2 = s[14]
    a2 += b2
    d2 ^= a2
    d2 = d2 << 16 | d2 >> 16
    c2 += d2
    b2 ^= c2
    b2 = b2 << 12 | b2 >> 20
    a2 += b2
    d2 ^= a2
    d2 = d2 << 8 | d2 >> 24
    c2 += d2
    b2 ^= c2
    b2 = b2 << 7 | b2 >> 25
    s[18] = a2
    s[22] = b2
    s[26] = c2
    s[30] = d2
    var a3 = s[3]
    var b3 = s[7]
    var c3 = s[11]
    var d3 = s[15]
    a3 += b3
    d3 ^= a3
    d3 = d3 << 16 | d3 >> 16
    c3 += d3
    b3 ^= c3
    b3 = b3 << 12 | b3 >> 20
    a3 += b3
    d3 ^= a3
    d3 = d3 << 8 | d3 >> 24
    c3 += d3
    b3 ^= c3
    b3 = b3 << 7 | b3 >> 25
    s[19] = a3
    s[23] = b3
    s[27] = c3
    s[31] = d3
    var a4 = s[16]
    var b4 = s[21]
    var c4 = s[26]
    var d4 = s[31]
    a4 += b4
    d4 ^= a4
    d4 = d4 << 16 | d4 >> 16
    c4 += d4
    b4 ^= c4
    b4 = b4 << 12 | b4 >> 20
    a4 += b4
    d4 ^= a4
    d4 = d4 << 8 | d4 >> 24
    c4 += d4
    b4 ^= c4
    b4 = b4 << 7 | b4 >> 25
    s[16] = a4
    s[21] = b4
    s[26] = c4
    s[31] = d4
    var a5 = s[17]
    var b5 = s[22]
    var c5 = s[27]
    var d5 = s[28]
    a5 += b5
    d5 ^= a5
    d5 = d5 << 16 | d5 >> 16
    c5 += d5
    b5 ^= c5
    b5 = b5 << 12 | b5 >> 20
    a5 += b5
    d5 ^= a5
    d5 = d5 << 8 | d5 >> 24
    c5 += d5
    b5 ^= c5
    b5 = b5 << 7 | b5 >> 25
    s[17] = a5
    s[22] = b5
    s[27] = c5
    s[28] = d5
    var a6 = s[18]
    var b6 = s[23]
    var c6 = s[24]
    var d6 = s[29]
    a6 += b6
    d6 ^= a6
    d6 = d6 << 16 | d6 >> 16
    c6 += d6
    b6 ^= c6
    b6 = b6 << 12 | b6 >> 20
    a6 += b6
    d6 ^= a6
    d6 = d6 << 8 | d6 >> 24
    c6 += d6
    b6 ^= c6
    b6 = b6 << 7 | b6 >> 25
    s[18] = a6
    s[23] = b6
    s[24] = c6
    s[29] = d6
    var a7 = s[19]
    var b7 = s[20]
    var c7 = s[25]
    var d7 = s[30]
    a7 += b7
    d7 ^= a7
    d7 = d7 << 16 | d7 >> 16
    c7 += d7
    b7 ^= c7
    b7 = b7 << 12 | b7 >> 20
    a7 += b7
    d7 ^= a7
    d7 = d7 << 8 | d7 >> 24
    c7 += d7
    b7 ^= c7
    b7 = b7 << 7 | b7 >> 25
    s[19] = a7
    s[20] = b7
    s[25] = c7
    s[30] = d7
    for _ in 0..9 {
        var a8 = s[16]
        var b8 = s[20]
        var c8 = s[24]
        var d8 = s[28]
        a8 += b8
        d8 ^= a8
        d8 = d8 << 16 | d8 >> 16
        c8 += d8
        b8 ^= c8
        b8 = b8 << 12 | b8 >> 20
        a8 += b8
        d8 ^= a8
        d8 = d8 << 8 | d8 >> 24
        c8 += d8
        b8 ^= c8
        b8 = b8 << 7 | b8 >> 25
        s[16] = a8
        s[20] = b8
        s[24] = c8
        s[28] = d8
        var a9 = s[17]
        var b9 = s[21]
        var c9 = s[25]
        var d9 = s[29]
        a9 += b9
        d9 ^= a9
        d9 = d9 << 16 | d9 >> 16
        c9 += d9
        b9 ^= c9
        b9 = b9 << 12 | b9 >> 20
        a9 += b9
        d9 ^= a9
        d9 = d9 << 8 | d9 >> 24
        c9 += d9
        b9 ^= c9
        b9 = b9 << 7 | b9 >> 25
        s[17] = a9
        s[21] = b9
        s[25] = c9
        s[29] = d9
        var a10 = s[18]
        var b10 = s[22]
        var c10 = s[26]
        var d10 = s[30]
        a10 += b10
        d10 ^= a10
        d10 = d10 << 16 | d10 >> 16
        c10 += d10
        b10 ^= c10
        b10 = b10 << 12 | b10 >> 20
        a10 += b10
        d10 ^= a10
        d10 = d10 << 8 | d10 >> 24
        c10 += d10
        b10 ^= c10
        b10 = b10 << 7 | b10 >> 25
        s[18] = a10
        s[22] = b10
        s[26] = c10
        s[30] = d10
        var a11 = s[19]
        var b11 = s[23]
        var c11 = s[27]
        var d11 = s[31]
        a11 += b11
        d11 ^= a11
        d11 = d11 << 16 | d11 >> 16
        c11 += d11
        b11 ^= c11
        b11 = b11 << 12 | b11 >> 20
        a11 += b11
        d11 ^= a11
        d11 = d11 << 8 | d11 >> 24
        c11 += d11
        b11 ^= c11
        b11 = b11 << 7 | b11 >> 25
        s[19] = a11
        s[23] = b11
        s[27] = c11
        s[31] = d11
        var a12 = s[16]
        var b12 = s[21]
        var c12 = s[26]
        var d12 = s[31]
        a12 += b12
        d12 ^= a12
        d12 = d12 << 16 | d12 >> 16
        c12 += d12
        b12 ^= c12
        b12 = b12 << 12 | b12 >> 20
        a12 += b12
        d12 ^= a12
        d12 = d12 << 8 | d12 >> 24
        c12 += d12
        b12 ^= c12
        b12 = b12 << 7 | b12 >> 25
        s[16] = a12
        s[21] = b12
        s[26] = c12
        s[31] = d12
        var a13 = s[17]
        var b13 = s[22]
        var c13 = s[27]
        var d13 = s[28]
        a13 += b13
        d13 ^= a13
        d13 = d13 << 16 | d13 >> 16
        c13 += d13
        b13 ^= c13
        b13 = b13 << 12 | b13 >> 20
        a13 += b13
        d13 ^= a13
        d13 = d13 << 8 | d13 >> 24
        c13 += d13
        b13 ^= c13
        b13 = b13 << 7 | b13 >> 25
        s[17] = a13
        s[22] = b13
        s[27] = c13
        s[28] = d13
        var a14 = s[18]
        var b14 = s[23]
        var c14 = s[24]
        var d14 = s[29]
        a14 += b14
        d14 ^= a14
        d14 = d14 << 16 | d14 >> 16
        c14 += d14
        b14 ^= c14
        b14 = b14 << 12 | b14 >> 20
        a14 += b14
        d14 ^= a14
        d14 = d14 << 8 | d14 >> 24
        c14 += d14
        b14 ^= c14
        b14 = b14 << 7 | b14 >> 25
        s[18] = a14
        s[23] = b14
        s[24] = c14
        s[29] = d14
        var a15 = s[19]
        var b15 = s[20]
        var c15 = s[25]
        var d15 = s[30]
        a15 += b15
        d15 ^= a15
        d15 = d15 << 16 | d15 >> 16
        c15 += d15
        b15 ^= c15
        b15 = b15 << 12 | b15 >> 20
        a15 += b15
        d15 ^= a15
        d15 = d15 << 8 | d15 >> 24
        c15 += d15
        b15 ^= c15
        b15 = b15 << 7 | b15 >> 25
        s[19] = a15
        s[20] = b15
        s[25] = c15
        s[30] = d15
    }
}

fn chacha_words_at(out: []u8, at: i64) -> []u32 {
    let raw: ptr = __slice_ptr(out[at..at + 64])
    let words: ptr[u32] = raw
    view(words, 16)
}

fn chacha_add(state: []u32, out: []u32) {
    let raw: ptr = __slice_ptr(state[..32])
    let at: ptr[u32] = raw
    let s = view(at, 32)
    let target: ptr = __slice_ptr(out[..16])
    let to: ptr[u32] = target
    let words = view(to, 16)
    words[0] = s[16] + s[0]
    words[1] = s[17] + s[1]
    words[2] = s[18] + s[2]
    words[3] = s[19] + s[3]
    words[4] = s[20] + s[4]
    words[5] = s[21] + s[5]
    words[6] = s[22] + s[6]
    words[7] = s[23] + s[7]
    words[8] = s[24] + s[8]
    words[9] = s[25] + s[9]
    words[10] = s[26] + s[10]
    words[11] = s[27] + s[11]
    words[12] = s[28] + s[12]
    words[13] = s[29] + s[13]
    words[14] = s[30] + s[14]
    words[15] = s[31] + s[15]
}

fn chacha_wipe(state: []u32) {
    let raw: ptr = __slice_ptr(state[..32])
    let at: ptr[u32] = raw
    let s = view(at, 32)
    s[16] = 0
    s[17] = 0
    s[18] = 0
    s[19] = 0
    s[20] = 0
    s[21] = 0
    s[22] = 0
    s[23] = 0
    s[24] = 0
    s[25] = 0
    s[26] = 0
    s[27] = 0
    s[28] = 0
    s[29] = 0
    s[30] = 0
    s[31] = 0
}

/// Computes the ChaCha20 block function (RFC 8439 section 2.3) of the state in `s` and stores the 64 output bytes in `out`.
///
/// `s` has 32 words. Words 4 to 11 are the key, word 12 is the block counter and words 13 to 15 are the nonce, each the little-endian word of RFC 8439, and the call sets words 0 to 3 to the constants. Words 16 to 31 are the working state of the 20 rounds. Every round loads and stores that state in `s`, so none of it is held on the stack, and the call zeroes it before it returns. Words 0 to 15 are left as they were, so the caller keeps the key in memory it owns and clears it itself. Panics when `s` has fewer than 32 words or `out` fewer than 64 bytes.
pub fn chacha20_state(s: []u32, out: []u8) {
    let words = chacha_words_at(out, 0)
    chacha_constants(s)
    chacha_rounds(s)
    chacha_add(s, words)
    chacha_wipe(s)
}

/// Stores `blocks` consecutive ChaCha20 blocks of the state in `s` in `out`, starting at the block counter in word 12.
///
/// `s` is laid out as for `chacha20_state`. Each block adds 1 to word 12, so the call leaves the counter `blocks` higher, and the working words 16 to 31 are zeroed once, after the last block. Words 0 to 15 other than the counter and the constants are left as they were. Panics when `s` has fewer than 32 words or `out` fewer than `64 * blocks` bytes.
pub fn chacha20_blocks(s: []u32, out: []u8, blocks: i64) {
    chacha_constants(s)
    for i in 0..blocks {
        let words = chacha_words_at(out, 64 * i)
        chacha_rounds(s)
        chacha_add(s, words)
        s[12] += 1
    }
    chacha_wipe(s)
}

fn chacha_load(s: []u32, k: []u32, n: []u32) {
    for i in 0..8 {
        s[4 + i] = k[i]
    }
    for i in 0..n.len {
        s[13 + i] = n[i]
    }
}

fn chacha_block_words(k: []u32, counter: u32, n: []u32, out: []u8) {
    let s: []u32 = __make(32)
    chacha_load(s, k, n)
    s[12] = counter
    chacha20_state(s, out)
    zero_words(s)
}

/// Returns the 64-byte ChaCha20 block function output for block `counter` (RFC 8439 section 2.3).
///
/// `key` is 32 bytes and `nonce` is 12 bytes. The lengths are not validated.
pub fn chacha20_block(key: []u8, counter: u32, nonce: []u8) -> []u8 {
    let out: []u8 = __make(64)
    let k = chacha_words(key, 0, 8)
    chacha_block_words(k, counter, chacha_words(nonce, 0, 3), out)
    zero_words(k)
    out
}

fn chacha_xor(k: []u32, first: u32, n: []u32, src: []u8, dst: []u8) {
    let s: []u32 = __make(32)
    chacha_load(s, k, n)
    let stream: []u8 = __make(64)
    var counter = first
    var at = 0
    for at < src.len {
        s[12] = counter
        chacha20_state(s, stream)
        let m = if src.len - at < 64 { src.len - at } else { 64 }
        for i in 0..m {
            dst[at + i] = src[at + i] ^ stream[i]
        }
        counter += 1
        at += 64
    }
    zero_words(s)
    for i in 0..stream.len {
        stream[i] = 0
    }
}

fn poly(key: []u8) -> *Poly {
    let pad: []u8 = __make(16)
    __memmove(pad, key[16..32])
    new(Poly {
        r0: u64(io.u32_le(key, 0)) & 0x3ffffff
        r1: u64(io.u32_le(key, 3)) >> 2 & 0x3ffff03
        r2: u64(io.u32_le(key, 6)) >> 4 & 0x3ffc0ff
        r3: u64(io.u32_le(key, 9)) >> 6 & 0x3f03fff
        r4: u64(io.u32_le(key, 12)) >> 8 & 0x00fffff
        h0: 0
        h1: 0
        h2: 0
        h3: 0
        h4: 0
        pad
    })
}

fn poly_blocks(p: *Poly, m: []u8, hibit: u64) {
    let mask: u64 = 0x3ffffff
    let r0 = p.r0
    let r1 = p.r1
    let r2 = p.r2
    let r3 = p.r3
    let r4 = p.r4
    let s1 = r1 * 5
    let s2 = r2 * 5
    let s3 = r3 * 5
    let s4 = r4 * 5
    var h0 = p.h0
    var h1 = p.h1
    var h2 = p.h2
    var h3 = p.h3
    var h4 = p.h4
    var at = 0
    for at + 16 <= m.len {
        h0 += u64(io.u32_le(m, at)) & mask
        h1 += u64(io.u32_le(m, at + 3)) >> 2 & mask
        h2 += u64(io.u32_le(m, at + 6)) >> 4 & mask
        h3 += u64(io.u32_le(m, at + 9)) >> 6 & mask
        h4 += u64(io.u32_le(m, at + 12)) >> 8 | hibit
        let d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1
        var d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2
        var d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3
        var d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4
        var d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
        h0 = d0 & mask
        d1 += d0 >> 26
        h1 = d1 & mask
        d2 += d1 >> 26
        h2 = d2 & mask
        d3 += d2 >> 26
        h3 = d3 & mask
        d4 += d3 >> 26
        h4 = d4 & mask
        h0 += (d4 >> 26) * 5
        h1 += h0 >> 26
        h0 &= mask
        at += 16
    }
    p.h0 = h0
    p.h1 = h1
    p.h2 = h2
    p.h3 = h3
    p.h4 = h4
}

fn poly_padded(p: *Poly, data: []u8) {
    let full = data.len - data.len % 16
    poly_blocks(p, data[..full], 1 << 24)
    if full < data.len {
        let last: []u8 = __make(16)
        __memmove(last, data[full..])
        poly_blocks(p, last, 1 << 24)
    }
}

fn poly_finish(p: *Poly) -> []u8 {
    let mask: u64 = 0x3ffffff
    var h0 = p.h0
    var h1 = p.h1
    var h2 = p.h2
    var h3 = p.h3
    var h4 = p.h4
    h2 += h1 >> 26
    h1 &= mask
    h3 += h2 >> 26
    h2 &= mask
    h4 += h3 >> 26
    h3 &= mask
    h0 += (h4 >> 26) * 5
    h4 &= mask
    h1 += h0 >> 26
    h0 &= mask
    var g0 = h0 + 5
    var g1 = h1 + (g0 >> 26)
    g0 &= mask
    var g2 = h2 + (g1 >> 26)
    g1 &= mask
    var g3 = h3 + (g2 >> 26)
    g2 &= mask
    var g4 = h4 + (g3 >> 26) - (1 << 26)
    g3 &= mask
    let keep = 0 - (g4 >> 63)
    let take = ~keep
    h0 = h0 & keep | g0 & take
    h1 = h1 & keep | g1 & take
    h2 = h2 & keep | g2 & take
    h3 = h3 & keep | g3 & take
    h4 = h4 & keep | g4 & take
    let pad = p.pad
    let w0 = (h0 | h1 << 26) & 0xffffffff
    let w1 = (h1 >> 6 | h2 << 20) & 0xffffffff
    let w2 = (h2 >> 12 | h3 << 14) & 0xffffffff
    let w3 = (h3 >> 18 | h4 << 8) & 0xffffffff
    let out: []u8 = __make(16)
    let f0 = w0 + u64(io.u32_le(pad, 0))
    let f1 = w1 + u64(io.u32_le(pad, 4)) + (f0 >> 32)
    let f2 = w2 + u64(io.u32_le(pad, 8)) + (f1 >> 32)
    let f3 = w3 + u64(io.u32_le(pad, 12)) + (f2 >> 32)
    io.set_le32(out, 0, i64(f0))
    io.set_le32(out, 4, i64(f1))
    io.set_le32(out, 8, i64(f2))
    io.set_le32(out, 12, i64(f3))
    out
}

/// Computes the Poly1305 one-time authenticator of `message` (RFC 8439 section 2.5).
///
/// `key` is 32 bytes and must authenticate one message only. Returns the 16-byte tag. Fails with `io.Error.Invalid` when `key` is not 32 bytes. An empty `message` is accepted.
pub fn poly1305(key: []u8, message: []u8) -> []u8 ! io.Error {
    if key.len != 32 {
        fail io.Error.Invalid
    }
    let p = poly(key)
    let full = message.len - message.len % 16
    poly_blocks(p, message[..full], 1 << 24)
    if full < message.len {
        let last: []u8 = __make(16)
        let n = __memmove(last, message[full..])
        last[n] = 1
        poly_blocks(p, last, 0)
    }
    poly_finish(p)
}

fn chacha_tag(k: []u32, n: []u32, ciphertext: []u8, aad: []u8) -> []u8 {
    let block: []u8 = __make(64)
    chacha_block_words(k, 0, n, block)
    let p = poly(block[..32])
    poly_padded(p, aad)
    poly_padded(p, ciphertext)
    let lengths: []u8 = __make(16)
    io.set_le32(lengths, 0, aad.len)
    io.set_le32(lengths, 4, aad.len >> 32)
    io.set_le32(lengths, 8, ciphertext.len)
    io.set_le32(lengths, 12, ciphertext.len >> 32)
    poly_blocks(p, lengths, 1 << 24)
    poly_finish(p)
}

fn chacha_seal(k: []u32, nonce: []u8, plaintext: []u8, aad: []u8) -> []u8 {
    let n = chacha_words(nonce, 0, 3)
    let out: []u8 = __make(plaintext.len + 16)
    let body = out[..plaintext.len]
    chacha_xor(k, 1, n, plaintext, body)
    let tag = chacha_tag(k, n, body, aad)
    __memmove(out[plaintext.len..], tag)
    out
}

fn chacha_open(k: []u32, nonce: []u8, sealed: []u8, aad: []u8) -> []u8 ! io.Error {
    if nonce.len != 12 || sealed.len < 16 {
        fail io.Error.Invalid
    }
    let n = chacha_words(nonce, 0, 3)
    let size = sealed.len - 16
    let body = sealed[..size]
    let expected = chacha_tag(k, n, body, aad)
    if !hash.equal(expected, sealed[size..]) {
        fail io.Error.Invalid
    }
    let out: []u8 = __make(size)
    chacha_xor(k, 1, n, body, out)
    out
}

/// Returns a ChaCha20-Poly1305 `Aead` keyed with the 32-byte `key` (RFC 8439 section 2.8).
///
/// The nonce is 12 bytes and the tag is 16 bytes. Fails with `io.Error.Invalid` when `key` is not 32 bytes. `seal` requires a 12-byte nonce. `open` fails with `io.Error.Invalid` when the nonce is not 12 bytes, the sealed input is shorter than 16 bytes or the tag does not match.
pub fn chacha20_poly1305(key: []u8) -> Aead ! io.Error {
    if key.len != 32 {
        fail io.Error.Invalid
    }
    let k = chacha_words(key, 0, 8)
    Aead {
        key_size: 32
        nonce_size: 12
        tag_size: 16
        seal: fn(nonce, plaintext, aad) { chacha_seal(k, nonce, plaintext, aad) }
        open: fn(nonce, sealed, aad) { chacha_open(k, nonce, sealed, aad) }
    }
}

/// Returns `data` XORed with the ChaCha20 keystream that starts at block `counter` (RFC 8439 section 2.4).
///
/// `key` is 32 bytes and `nonce` is 12 bytes. Encryption and decryption are the same operation, and the result is as long as `data`. The key words and the keystream block the call made are zeroed before it returns. Fails with `io.Error.Invalid` when `key` or `nonce` has the wrong length. No authentication is applied.
pub fn chacha20_xor(key: []u8, counter: u32, nonce: []u8, data: []u8) -> []u8 ! io.Error {
    if key.len != 32 || nonce.len != 12 {
        fail io.Error.Invalid
    }
    let out: []u8 = __make(data.len)
    let k = chacha_words(key, 0, 8)
    chacha_xor(k, counter, chacha_words(nonce, 0, 3), data, out)
    for i in 0..k.len {
        k[i] = 0
    }
    out
}

fn hchacha_core(k: []u32, n: []u32) -> []u8 {
    let s: []u32 = __make(32)
    for i in 0..8 {
        s[4 + i] = k[i]
    }
    for i in 0..4 {
        s[12 + i] = n[i]
    }
    chacha_constants(s)
    chacha_rounds(s)
    let out: []u8 = __make(32)
    for i in 0..4 {
        io.set_le32(out, 4 * i, i64(s[16 + i]))
        io.set_le32(out, 16 + 4 * i, i64(s[28 + i]))
    }
    zero_words(s)
    out
}

/// Returns the 32-byte HChaCha20 subkey derived from `key` and `nonce` (draft-irtf-cfrg-xchacha section 2.2).
///
/// `key` is 32 bytes and `nonce` is 16 bytes. Fails with `io.Error.Invalid` when either has the wrong length.
pub fn hchacha20(key: []u8, nonce: []u8) -> []u8 ! io.Error {
    if key.len != 32 || nonce.len != 16 {
        fail io.Error.Invalid
    }
    hchacha_core(chacha_words(key, 0, 8), chacha_words(nonce, 0, 4))
}

fn xchacha_subkey(k: []u32, nonce: []u8) -> []u32 {
    chacha_words(hchacha_core(k, chacha_words(nonce, 0, 4)), 0, 8)
}

fn xchacha_tail(nonce: []u8) -> []u8 {
    let tail: []u8 = __make(12)
    __memmove(tail[4..], nonce[16..24])
    tail
}

fn xchacha_seal(k: []u32, nonce: []u8, plaintext: []u8, aad: []u8) -> []u8 {
    chacha_seal(xchacha_subkey(k, nonce), xchacha_tail(nonce), plaintext, aad)
}

fn xchacha_open(k: []u32, nonce: []u8, sealed: []u8, aad: []u8) -> []u8 ! io.Error {
    if nonce.len != 24 {
        fail io.Error.Invalid
    }
    chacha_open(xchacha_subkey(k, nonce), xchacha_tail(nonce), sealed, aad)?
}

/// Returns an XChaCha20-Poly1305 `Aead` keyed with the 32-byte `key` (draft-irtf-cfrg-xchacha).
///
/// The nonce is 24 bytes and the tag is 16 bytes. The first 16 nonce bytes derive a subkey with `hchacha20`; the last 8 bytes, preceded by four zero bytes, form the ChaCha20-Poly1305 nonce. Fails with `io.Error.Invalid` when `key` is not 32 bytes. `seal` requires a 24-byte nonce. `open` fails with `io.Error.Invalid` when the nonce is not 24 bytes, the sealed input is shorter than 16 bytes or the tag does not match.
pub fn xchacha20_poly1305(key: []u8) -> Aead ! io.Error {
    if key.len != 32 {
        fail io.Error.Invalid
    }
    let k = chacha_words(key, 0, 8)
    Aead {
        key_size: 32
        nonce_size: 24
        tag_size: 16
        seal: fn(nonce, plaintext, aad) { xchacha_seal(k, nonce, plaintext, aad) }
        open: fn(nonce, sealed, aad) { xchacha_open(k, nonce, sealed, aad) }
    }
}
