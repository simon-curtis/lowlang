import std/testing
import std/text

fn hex(s: str) -> []u8 {
    text.decode_hex(s) or []
}

fn test_wipe_zeroes_the_round_keys(t: *testing.T) {
    let key = aes_key(hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")) or return
    let block = hex("00112233445566778899aabbccddeeff")
    let out = hex("00000000000000000000000000000000")
    encrypt_block_into(key, block, 0, out, 0)
    t.equal(text.encode_hex(out), "8ea2b7ca516745bfeafc49904b496089")
    aes_wipe(key)
    for w in key.rk {
        t.equal(w, 0)
    }
    encrypt_block_into(key, block, 0, out, 0)
    t.not_equal(text.encode_hex(out), "8ea2b7ca516745bfeafc49904b496089")
}
