import std/io
import std/testing

fn pattern(start: i64, n: i64) -> u8[] {
    var out: u8[] = []
    for i in 0..n {
        out.push(u8(start + i))
    }
    out
}

fn fresh() -> *CtrDrbg {
    instantiate(pattern(1, 32), pattern(100, 16), []) catch {
        e => panic("instantiate failed")
    }
}

fn test_counter_starts_at_one_and_counts_requests(t: *testing.T) {
    let d = fresh()
    t.equal(d.counter, 1)
    let out = generate(d, 16, []) or []
    t.equal(out.len, 16)
    t.equal(d.counter, 2)
    reseed(d, pattern(5, 32), []) or return
    t.equal(d.counter, 1)
}

fn test_reseed_is_required_after_2_to_the_48_requests(t: *testing.T) {
    let d = fresh()
    d.counter = 281474976710656
    let last = generate(d, 16, []) or []
    t.equal(last.len, 16)
    t.equal(d.counter, 281474976710657)
    let refused = generate(d, 16, []) catch {
        ReseedRequired => bytes("reseed required")
        _ => bytes("other error")
    }
    t.equal(str(refused), "reseed required")
    reseed(d, pattern(9, 32), []) or return
    t.equal(d.counter, 1)
    let again = generate(d, 16, []) or []
    t.equal(again.len, 16)
}

fn test_refusal_leaves_the_state_unchanged(t: *testing.T) {
    let d = fresh()
    d.counter = 281474976710657
    let key = io.buffer(32)
    io.copy(key, d.key)
    let v = io.buffer(16)
    io.copy(v, d.v)
    let refused = generate(d, 16, pattern(3, 20)) or []
    t.equal(refused.len, 0)
    t.equal_slice(d.key, key)
    t.equal_slice(d.v, v)
    t.equal(d.counter, 281474976710657)
}

fn test_uninstantiate_erases_the_state(t: *testing.T) {
    let d = fresh()
    uninstantiate(d)
    t.equal_slice(d.key, io.buffer(32))
    t.equal_slice(d.v, io.buffer(16))
    t.equal(d.counter, 0)
    t.is_false(d.live)
}
