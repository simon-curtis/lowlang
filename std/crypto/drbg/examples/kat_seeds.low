import std/crypto/drbg
import std/text

fn run() ! drbg.Error {
    var entropy: u8[] = []
    for i in 0..48 {
        entropy.push(u8(i))
    }
    let d = drbg.instantiate_without_df(entropy, [])?
    for count in 0..3 {
        let seed = drbg.generate(d, 48, [])?
        let message = drbg.generate(d, 33 * (count + 1), [])?
        print("count {count}: seed {text.encode_hex(seed)}, message of {message.len} bytes")
    }
}

/// Seeds AES-256 CTR_DRBG without the derivation function with the bytes 0 to 47, as the NIST post-quantum known-answer harness does, and draws the seed and message of its first three entries.
fn main() {
    run() catch {
        e => print("failed: {e}")
    }
}
