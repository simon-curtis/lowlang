import std/crypto/drbg
import std/text

fn unhex(s: str) -> []u8 {
    text.decode_hex(s) or []
}

fn run() ! drbg.Error {
    let entropy = unhex("2d4c9f46b981c6a0b2b5d8c69391e569ff13851437ebc0fc00d616340252fed5")
    let nonce = unhex("0bf814b411f65ec4866be1abb59d3c32")
    let reseed_entropy = unhex("93500fae4fa32b86033b7a7bac9d37e710dcc67ca266bc8607d665937766d207")

    let d = drbg.instantiate(entropy, nonce, [])?
    drbg.reseed(d, reseed_entropy, [])?
    let first = drbg.generate(d, 64, [])?
    let second = drbg.generate(d, 64, [])?
    print("first  {text.encode_hex(first)}")
    print("second {text.encode_hex(second)}")

    let mixed = drbg.generate(d, 16, bytes("per-request context"))?
    print("with additional input {text.encode_hex(mixed)}")

    let refused = drbg.generate(d, 65537, []) catch {
        RequestTooLarge => bytes("more than 65536 bytes refused")
        _ => bytes("other failure")
    }
    print(str(refused))

    drbg.uninstantiate(d)
    let erased = drbg.generate(d, 16, []) catch {
        Uninstantiated => bytes("generator erased")
        _ => bytes("other failure")
    }
    print(str(erased))
}

/// Instantiates AES-256 CTR_DRBG from a NIST CAVP entropy input and nonce, reseeds, generates twice (the second output is the CAVP expected value), mixes in additional input and shows the errors for an oversized request and an erased generator.
fn main() {
    run() catch {
        e => print("failed: {e}")
    }
}
