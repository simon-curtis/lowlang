import std/crypto/cipher
import std/text

fn pattern(start: i64, n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8(start + i))
    }
    out
}

fn key_check(n: i64) -> str {
    cipher.aes(pattern(0, n)) catch {
        InvalidKey => return "{n} byte key rejected"
        _ => return "{n} byte key failed"
    }
    "{n} byte key accepted"
}

fn run() ! cipher.Error {
    let block = cipher.aes(pattern(0, 16))?
    let iv = pattern(0x20, 16)

    let sealed = cipher.cbc_seal(block, iv, bytes("transfer 250 to account 9"))?
    print("cbc {sealed.len} bytes: {text.encode_hex(sealed)}")
    print("cbc opened: {str(cipher.cbc_open(block, iv, sealed)?)}")

    let truncated = cipher.cbc_open(block, iv, sealed[..20]) catch {
        InvalidLength => bytes("length rejected")
        _ => bytes("other failure")
    }
    print("cbc truncated: {str(truncated)}")

    let stream = cipher.ctr(block, iv, bytes("any length at all"))?
    print("ctr {text.encode_hex(stream)}")
    print("ctr back: {str(cipher.ctr(block, iv, stream)?)}")

    let disk = cipher.xts(pattern(0, 32))?
    let sector = cipher.xts_encrypt(disk, pattern(0, 16), pattern(0, 40))?
    print("xts {text.encode_hex(sector)}")
    let restored = cipher.xts_decrypt(disk, pattern(0, 16), sector)?
    print("xts restored: {text.encode_hex(restored) == text.encode_hex(pattern(0, 40))}")
    print(key_check(16))
    print(key_check(15))
}

/// Encrypts with AES in CBC (PKCS#7 padded), CTR and XTS modes under fixed keys, then decrypts, and shows the errors for a bad length and a bad key.
fn main() {
    run() catch {
        e => print("failed: {e}")
    }
}
