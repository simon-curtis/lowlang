import std/crypto/zk/kzg
import std/crypto/zk/pairing

fn polynomial(c: *pairing.Curve, coefficients: []u64) -> [][]u64 {
    var out: [][]u64 = []
    for v in coefficients {
        push(mut out, pairing.fr_from_u64(c, v))
    }
    out
}

fn show(c: *pairing.Curve, name: str) ! kzg.Error {
    let srs = kzg.srs_from_tau(c, 8, pairing.fr_from_u64(c, 0x2545f4914f6cdd1d))
    let p = polynomial(c, [5, 4, 3, 2, 1])
    let commitment = kzg.commit(srs, p)?

    let z = pairing.fr_from_u64(c, 7)
    let opening = kzg.open(srs, p, z)?
    print("{name}: p(7) = {pairing.fr_limbs(c, opening.value)[0]}")
    print("  opening verifies: {kzg.verify(srs.verifier, commitment, z, opening.value, opening.proof)}")

    let other = pairing.fr_from_u64(c, 3268)
    print("  the same proof for y = 3268: {kzg.verify(srs.verifier, commitment, z, other, opening.proof)}")

    let z2 = pairing.fr_from_u64(c, 11)
    let second = kzg.open(srs, p, z2)?
    let challenge = pairing.fr_from_u64(c, 0x9e3779b97f4a7c15)
    let batch = kzg.verify_batch(srs.verifier, [commitment, commitment], [z, z2], [opening.value, second.value], [opening.proof, second.proof], challenge)?
    print("  batch of two openings verifies: {batch}")

    print("  nine coefficients: {capacity(srs, polynomial(c, [1, 1, 1, 1, 1, 1, 1, 1, 1]))}")
}

fn capacity(srs: kzg.Srs, p: [][]u64) -> str {
    kzg.commit(srs, p) catch {
        Size => return "rejected, the setup has eight powers"
        _ => return "failed"
    }
    "committed"
}

fn main() ! kzg.Error {
    show(pairing.bn254(), "BN254")?
    show(pairing.bls12_381(), "BLS12-381")?
}
