import std/crypto/hash
import std/crypto/hashtocurve
import std/crypto/limb
import std/crypto/nistec

fn e_sgn(g: *Group, a: []u64) -> u64 {
    if g.degree == 1 { fp_sgn(g.curve, a) } else { f2_sgn(g.curve, a) }
}

fn e_is_zero(a: []u64) -> bool {
    limb.is_zero(a)
}

fn e_from_hex(g: *Group, parts: []str, at: i64) -> []u64 {
    let c = g.curve
    if g.degree == 1 {
        return plain_to_fp(c, parts[at])
    }
    f2_new(c, plain_to_fp(c, parts[at]), plain_to_fp(c, parts[at + 1]))
}

fn fp_from_wide(c: *Curve, data: []u8) -> []u64 {
    reduce_bytes(c.q, data)
}

fn hash_to_field_elements(g: *Group, msg: []u8, dst: []u8, count: i64) -> [][]u64 ! Error {
    let c = g.curve
    let length = 64 * count * g.degree
    let uniform = hashtocurve.expand_message_xmd(hash.sha256(), msg, dst, length) catch {
        _ => fail Length
    }
    var out: [][]u64 = []
    for i in 0..count {
        if g.degree == 1 {
            push(mut out, fp_from_wide(c, uniform[64 * i..64 * (i + 1)]))
        } else {
            let first = fp_from_wide(c, uniform[64 * (2 * i)..64 * (2 * i + 1)])
            let second = fp_from_wide(c, uniform[64 * (2 * i + 1)..64 * (2 * i + 2)])
            push(mut out, f2_new(c, first, second))
        }
    }
    out
}

fn horner(g: *Group, parts: []str, x: []u64) -> []u64 {
    let step = g.degree
    let count = parts.len / step
    var acc = e_from_hex(g, parts, (count - 1) * step)
    var i = count - 2
    for i >= 0 {
        acc = e_add(g, e_mul(g, acc, x), e_from_hex(g, parts, i * step))
        i -= 1
    }
    acc
}

struct Isogeny {
    a: []u64
    b: []u64
    z: []u64
    x_num: []str
    x_den: []str
    y_num: []str
    y_den: []str
}

fn isogeny(g: *Group) -> Isogeny {
    if g.degree == 1 {
        return Isogeny {
            a: e_from_hex(g, [iso11_a()], 0)
            b: e_from_hex(g, [iso11_b()], 0)
            z: fp_small(g.curve, 11)
            x_num: iso11_x_numerator()
            x_den: iso11_x_denominator()
            y_num: iso11_y_numerator()
            y_den: iso11_y_denominator()
        }
    }
    Isogeny {
        a: e_from_hex(g, iso3_a(), 0)
        b: e_from_hex(g, iso3_b(), 0)
        z: e_from_hex(g, iso3_z(), 0)
        x_num: iso3_x_numerator()
        x_den: iso3_x_denominator()
        y_num: iso3_y_numerator()
        y_den: iso3_y_denominator()
    }
}

fn curve_value(g: *Group, iso: Isogeny, x: []u64) -> []u64 {
    let xx = e_mul(g, x, x)
    let x3 = e_mul(g, xx, x)
    e_add(g, e_add(g, x3, e_mul(g, iso.a, x)), iso.b)
}

fn simplified_swu(g: *Group, iso: Isogeny, u: []u64) -> Affine {
    let uu = e_mul(g, u, u)
    let tv1 = e_mul(g, iso.z, uu)
    let tv2 = e_add(g, e_mul(g, tv1, tv1), tv1)
    var x1 = e_zero(g)
    if e_is_zero(tv2) {
        x1 = e_mul(g, iso.b, e_inv(g, e_mul(g, iso.z, iso.a)))
    } else {
        let factor = e_neg(g, e_mul(g, iso.b, e_inv(g, iso.a)))
        x1 = e_mul(g, factor, e_add(g, e_one(g), e_inv(g, tv2)))
    }
    let gx1 = curve_value(g, iso, x1)
    var x = x1
    var y = e_zero(g)
    match e_sqrt(g, gx1) {
        some(root) => {
            y = root
        }
        none => {
            x = e_mul(g, tv1, x1)
            let gx2 = curve_value(g, iso, x)
            y = e_sqrt(g, gx2) ?? e_zero(g)
        }
    }
    if e_sgn(g, u) != e_sgn(g, y) {
        y = e_neg(g, y)
    }
    Affine { x, y }
}

fn isogeny_map(g: *Group, iso: Isogeny, p: Affine) -> Point {
    let x_den = horner(g, iso.x_den, p.x)
    let y_den = horner(g, iso.y_den, p.x)
    if e_is_zero(x_den) || e_is_zero(y_den) {
        return identity(g)
    }
    let x = e_mul(g, horner(g, iso.x_num, p.x), e_inv(g, x_den))
    let y_scale = e_mul(g, horner(g, iso.y_num, p.x), e_inv(g, y_den))
    let y = e_mul(g, p.y, y_scale)
    Point { x, y, z: e_one(g) }
}

fn map_field_element(g: *Group, u: []u64) -> Point {
    let iso = isogeny(g)
    isogeny_map(g, iso, simplified_swu(g, iso, u))
}

fn bls_only(g: *Group) ! Error {
    if g.curve.kind != Bls12381 {
        fail Unsupported
    }
}

/// Returns the point of the group `g` that the simplified SWU map and the isogeny of RFC 9380 section 6.6.3 send the field element `u` to, before the cofactor is cleared.
///
/// `u` is the big-endian encoding of an `Fq` element for `G1`, or of an `Fq2` element for `G2` with the imaginary part first, as `hash_to_field` returns it. The map is for BLS12-381 only and runs in a time that depends on `u`. Fails with `Unsupported` on another curve, `Length` or `NotCanonical`.
pub fn map_to_curve(g: *Group, u: []u8) -> Point ! Error {
    bls_only(g)?
    if u.len != g.degree * element_size(g.curve) {
        fail Length
    }
    let value = read_e(g, u, true)?
    map_field_element(g, value)
}

/// Returns the point of the BLS12-381 group `g` for `msg` under the domain separation tag `dst`, with the random-oracle suite `BLS12381G1_XMD:SHA-256_SSWU_RO_` for `G1` and `BLS12381G2_XMD:SHA-256_SSWU_RO_` for `G2` of RFC 9380: two field elements from `expand_message_xmd` with SHA-256, each mapped to the curve, added and multiplied by the effective cofactor.
///
/// The running time depends on `msg`, so use it for public messages. Fails with `Unsupported` on BN254 and with `Length` when `dst` or `msg` are too long for `expand_message_xmd`.
pub fn hash_to_curve(g: *Group, msg: []u8, dst: []u8) -> Point ! Error {
    bls_only(g)?
    let u = hash_to_field_elements(g, msg, dst, 2)?
    let q0 = map_field_element(g, u[0])
    let q1 = map_field_element(g, u[1])
    clear_cofactor(g, add(g, q0, q1))
}

/// Returns the point of the BLS12-381 group `g` for `msg` under `dst` with the non-uniform suite `BLS12381G1_XMD:SHA-256_SSWU_NU_` for `G1` and `BLS12381G2_XMD:SHA-256_SSWU_NU_` for `G2`: one field element, mapped and multiplied by the effective cofactor.
///
/// The output is not uniform over the group. Fails like `hash_to_curve`.
pub fn encode_to_curve(g: *Group, msg: []u8, dst: []u8) -> Point ! Error {
    bls_only(g)?
    let u = hash_to_field_elements(g, msg, dst, 1)?
    clear_cofactor(g, map_field_element(g, u[0]))
}

/// Returns the `count` elements of `Fq` (for `G1`) or `Fq2` (for `G2`) that `hash_to_curve` derives from `msg` and `dst`, which is `hash_to_field` of RFC 9380 section 5.2 with `L = 64` for BLS12-381, each as big-endian bytes with the imaginary part of an `Fq2` element first.
///
/// Fails with `Unsupported` on BN254 and `Length` when the input is too long for `expand_message_xmd`.
pub fn hash_to_field(g: *Group, msg: []u8, dst: []u8, count: i64) -> [][]u8 ! Error {
    bls_only(g)?
    let elements = hash_to_field_elements(g, msg, dst, count)?
    var out: [][]u8 = []
    for e in elements {
        push(mut out, write_e(g, e, true))
    }
    out
}
