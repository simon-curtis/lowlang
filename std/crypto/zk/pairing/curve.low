import std/crypto/limb
import std/crypto/nistec

/// A pairing-friendly curve of the module.
pub enum Kind {
    /// BN254, also called alt_bn128 and bn256: the curve of EIP-196 and EIP-197, with `y^2 = x^3 + 3`.
    Bn254
    /// BLS12-381: the curve of EIP-2537 and the ZCash encodings, with `y^2 = x^3 + 4`.
    Bls12381
}

/// A pairing-friendly curve with its base field `Fq`, its scalar field `Fr`, the extension tower `Fq2`, `Fq6` and `Fq12` over `Fq`, and the constants of its pairing.
///
/// A base field element is `n` limbs in Montgomery form. An `Fq2` element is `2n` limbs `a0 + a1 u` with `u^2 = -1`, an `Fq6` element is three `Fq2` elements `c0 + c1 v + c2 v^2` with `v^3 = xi`, and an `Fq12` element is two `Fq6` elements `d0 + d1 w` with `w^2 = v`. The constant `xi` is `9 + u` for BN254 and `1 + u` for BLS12-381.
///
/// A `Curve` shares scratch space with the fields it holds, so it is not safe for concurrent use; make one per green thread.
pub struct Curve {
    /// Which curve this is.
    pub kind: Kind
    /// The base field, modulo the prime `q`.
    pub q: *nistec.Field
    /// The scalar field, modulo the order `r` of `G1`, `G2` and `GT`.
    pub r: *nistec.Field
    /// The number of 64-bit limbs of a base field element.
    pub n: i64
    p: Params
    xi: u64
    b: []u64
    b2: []u64
    gamma1: [][]u64
    gamma2: [][]u64
    e_fp_root: []u64
    e_fq2_a: []u64
    e_half: []u64
    hard: []u64
    cleared1: []u64
    cleared2: []u64
}

/// Returns BN254.
pub fn bn254() -> *Curve {
    build(Bn254, bn254_params())
}

/// Returns BLS12-381.
pub fn bls12_381() -> *Curve {
    build(Bls12381, bls12_381_params())
}

fn build(kind: Kind, p: Params) -> *Curve {
    let q = nistec.field(nistec.hex_limbs(p.q))
    let r = nistec.field(nistec.hex_limbs(p.r))
    let n = q.m.len
    let c = new(Curve {
        kind
        q
        r
        n
        p
        xi: p.xi
        b: __make(n)
        b2: __make(2 * n)
        gamma1: []
        gamma2: []
        e_fp_root: shift_right(plus_small(q.m, 1), 2)
        e_fq2_a: shift_right(minus_small(q.m, 3), 2)
        e_half: shift_right(minus_small(q.m, 1), 1)
        hard: nistec.hex_limbs(p.hard)
        cleared1: nistec.hex_limbs(p.clear1)
        cleared2: nistec.hex_limbs(p.clear2)
    })
    c.b = fp_small(c, p.b)
    let b_as_f2 = f2_from_fp(c, c.b)
    c.b2 = match kind {
        Bn254 => f2_mul(c, b_as_f2, f2_inv(c, f2_xi(c)))
        Bls12381 => f2_mul(c, b_as_f2, f2_xi(c))
    }
    let sixth = divide_small(minus_small(q.m, 1), 6)
    let g = f2_pow(c, f2_xi(c), sixth)
    var first: [][]u64 = []
    var second: [][]u64 = []
    var power = f2_one(c)
    for _ in 0..6 {
        push(mut first, power)
        let conjugate = f2_conj(c, power)
        push(mut second, f2_mul(c, power, conjugate))
        power = f2_mul(c, power, g)
    }
    c.gamma1 = first
    c.gamma2 = second
    c
}

fn plus_small(x: []u64, k: u64) -> []u64 {
    let out: []u64 = __make(x.len)
    let add: []u64 = __make(x.len)
    add[0] = k
    limb.add(out, x, add)
    out
}

fn minus_small(x: []u64, k: u64) -> []u64 {
    let out: []u64 = __make(x.len)
    let sub: []u64 = __make(x.len)
    sub[0] = k
    limb.sub(out, x, sub)
    out
}

fn shift_right(x: []u64, bits: i64) -> []u64 {
    let out: []u64 = __make(x.len)
    for i in 0..x.len {
        var v = x[i] >> bits
        if i + 1 < x.len {
            v |= x[i + 1] << (64 - bits)
        }
        out[i] = v
    }
    out
}

fn divide_small(x: []u64, d: u64) -> []u64 {
    let out: []u64 = __make(x.len)
    var rem: u64 = 0
    var i = x.len - 1
    for i >= 0 {
        var bit = 63
        for bit >= 0 {
            rem = rem * 2 + ((x[i] >> bit) & 1)
            if rem >= d {
                rem -= d
                out[i] |= u64(1) << bit
            }
            bit -= 1
        }
        i -= 1
    }
    out
}

fn bit_length(x: []u64) -> i64 {
    var i = x.len - 1
    for i >= 0 {
        if x[i] != 0 {
            var bit = 63
            for (x[i] >> bit) & 1 == 0 {
                bit -= 1
            }
            return i * 64 + bit + 1
        }
        i -= 1
    }
    0
}

fn bit_at(x: []u64, index: i64) -> u64 {
    (x[index / 64] >> (index % 64)) & 1
}
