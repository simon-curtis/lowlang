import std/crypto/limb
import std/crypto/nistec

/// The reason a point or field element encoding was rejected.
pub enum Error {
    /// The input has the wrong length.
    Length
    /// A field element is not below the field's modulus.
    NotCanonical
    /// The coordinates do not satisfy the curve equation, or `x` has no `y`.
    NotOnCurve
    /// The point is on the curve but not in the subgroup of prime order.
    NotInSubgroup
    /// The flag bits or padding bytes of the encoding are inconsistent.
    Flags
    /// The encoding or operation is not defined for this curve.
    Unsupported
    /// A domain size is not a power of two within the two-adicity of the scalar field.
    Size
}

fn element_size(c: *Curve) -> i64 {
    c.n * 8
}

fn read_fp(c: *Curve, data: []u8) -> []u64 ! Error {
    let plain = limb.from_bytes(data, c.n)
    if !nistec.below(plain, c.q.m) {
        fail NotCanonical
    }
    let out = fp_zero(c)
    nistec.to_mont(c.q, out, plain)
    out
}

fn write_fp(c: *Curve, a: []u64) -> []u8 {
    limb.to_bytes(fp_plain(c, a), element_size(c))
}

fn all_zero(data: []u8) -> bool {
    var acc: u8 = 0
    for byte in data {
        acc |= byte
    }
    acc == 0
}

fn checked(g: *Group, p: Point) -> Point ! Error {
    if !on_curve(g, p) {
        fail NotOnCurve
    }
    if !in_subgroup(g, p) {
        fail NotInSubgroup
    }
    p
}

fn point_of(g: *Group, x: []u64, y: []u64) -> Point ! Error {
    checked(g, Point { x, y, z: e_one(g) })?
}

fn read_e(g: *Group, data: []u8, high_first: bool) -> []u64 ! Error {
    let c = g.curve
    let size = element_size(c)
    if g.degree == 1 {
        return read_fp(c, data[..size])?
    }
    let first = read_fp(c, data[..size])?
    let second = read_fp(c, data[size..2 * size])?
    if high_first {
        return f2_new(c, second, first)
    }
    f2_new(c, first, second)
}

fn write_e(g: *Group, a: []u64, high_first: bool) -> []u8 {
    let c = g.curve
    if g.degree == 1 {
        return write_fp(c, a)
    }
    let low = write_fp(c, a[..c.n])
    let high = write_fp(c, a[c.n..])
    let size = element_size(c)
    let out: []u8 = __make(2 * size)
    if high_first {
        __memmove(out, high)
        __memmove(out[size..], low)
    } else {
        __memmove(out, low)
        __memmove(out[size..], high)
    }
    out
}

fn coordinate_size(g: *Group, c: *Curve) -> i64 {
    element_size(c) * g.degree
}

fn evm_padding(c: *Curve) -> i64 {
    match c.kind {
        Bn254 => 0
        Bls12381 => 16
    }
}

fn evm_high_first(c: *Curve) -> bool {
    match c.kind {
        Bn254 => true
        Bls12381 => false
    }
}

/// Returns the length in bytes of the Ethereum encoding of a point of `g`: `x` then `y`, big-endian, with `Fq2` elements as the imaginary part then the real part for BN254 (EIP-197) and the real part then the imaginary part for BLS12-381 (EIP-2537), each base field element of BLS12-381 padded with 16 zero bytes in front to 64 bytes. The point at infinity is all zeros.
pub fn evm_size(g: *Group) -> i64 {
    let c = g.curve
    2 * g.degree * (element_size(c) + evm_padding(c))
}

/// Returns the Ethereum encoding of `p`, `evm_size(g)` bytes.
pub fn encode_evm(g: *Group, p: Point) -> []u8 {
    let c = g.curve
    let pad = evm_padding(c)
    let size = element_size(c)
    let width = size + pad
    let out: []u8 = __make(evm_size(g))
    let a = to_affine(g, p) ?? return out
    let x = write_e(g, a.x, evm_high_first(c))
    let y = write_e(g, a.y, evm_high_first(c))
    let half = g.degree * width
    for k in 0..g.degree {
        __memmove(out[k * width + pad..], x[k * size..(k + 1) * size])
        __memmove(out[half + k * width + pad..], y[k * size..(k + 1) * size])
    }
    out
}

/// Returns the point of the Ethereum encoding `data`, which must be `evm_size(g)` bytes with every field element below the modulus and every padding byte zero. The point at infinity is all zeros. Any other point must satisfy the curve equation and lie in the subgroup of prime order.
///
/// Fails with `Length`, `NotCanonical`, `Flags`, `NotOnCurve` or `NotInSubgroup`.
pub fn decode_evm(g: *Group, data: []u8) -> Point ! Error {
    let p = decode_evm_unchecked(g, data)?
    if is_identity(p) {
        return p
    }
    checked(g, p)?
}

/// Returns the point of the Ethereum encoding `data` like `decode_evm`, but without the subgroup check. The point must still satisfy the curve equation. Use it where the protocol checks the subgroup itself, such as the addition of EIP-2537.
pub fn decode_evm_unchecked(g: *Group, data: []u8) -> Point ! Error {
    let c = g.curve
    if data.len != evm_size(g) {
        fail Length
    }
    let pad = evm_padding(c)
    let size = element_size(c)
    let width = size + pad
    let half = g.degree * width
    let x_bytes: []u8 = __make(g.degree * size)
    let y_bytes: []u8 = __make(g.degree * size)
    for k in 0..g.degree {
        if !all_zero(data[k * width..k * width + pad]) {
            fail Flags
        }
        if !all_zero(data[half + k * width..half + k * width + pad]) {
            fail Flags
        }
        __memmove(x_bytes[k * size..], data[k * width + pad..(k + 1) * width])
        __memmove(y_bytes[k * size..], data[half + k * width + pad..half + (k + 1) * width])
    }
    let x = read_e(g, x_bytes, evm_high_first(c))?
    let y = read_e(g, y_bytes, evm_high_first(c))?
    if limb.is_zero(x) && limb.is_zero(y) {
        return identity(g)
    }
    let p = Point { x, y, z: e_one(g) }
    if !on_curve(g, p) {
        fail NotOnCurve
    }
    p
}

fn zcash_flag_check(c: *Curve) ! Error {
    if c.kind != Bls12381 {
        fail Unsupported
    }
}

/// Returns the ZCash serialization of `p` for BLS12-381: 48 bytes compressed or 96 uncompressed for `G1`, 96 or 192 for `G2`, each coordinate big-endian with the `Fq2` imaginary part first. The top three bits of the first byte are the compression flag, the infinity flag and, for compressed points, the flag that `y` is the lexicographically larger of the two roots.
///
/// Fails with `Unsupported` for BN254.
pub fn serialize_zcash(g: *Group, p: Point, compressed: bool) -> []u8 ! Error {
    let c = g.curve
    zcash_flag_check(c)?
    let size = coordinate_size(g, c)
    let a = to_affine(g, p)
    match a {
        none => {
            let out: []u8 = __make(if compressed { size } else { 2 * size })
            out[0] = if compressed { 0xc0 } else { 0x40 }
            out
        }
        some(point) => {
            let x = write_e(g, point.x, true)
            if compressed {
                let out: []u8 = __make(size)
                __memmove(out, x)
                out[0] |= 0x80
                if e_larger(g, point.y) {
                    out[0] |= 0x20
                }
                return out
            }
            let y = write_e(g, point.y, true)
            let out: []u8 = __make(2 * size)
            __memmove(out, x)
            __memmove(out[size..], y)
            out
        }
    }
}

fn e_larger(g: *Group, a: []u64) -> bool {
    if g.degree == 1 { fp_larger(g.curve, a) } else { f2_larger(g.curve, a) }
}

fn e_sqrt(g: *Group, a: []u64) -> []u64? {
    if g.degree == 1 { fp_sqrt(g.curve, a) } else { f2_sqrt(g.curve, a) }
}

/// Returns the point of the ZCash serialization `data` for BLS12-381, compressed or uncompressed by its first flag bit and `Length`-checked against the size that flag implies. A point other than infinity must be on the curve and in the subgroup of prime order; infinity must have every other bit zero.
///
/// Fails with `Length`, `Flags`, `NotCanonical`, `NotOnCurve`, `NotInSubgroup` or `Unsupported` for BN254.
pub fn deserialize_zcash(g: *Group, data: []u8) -> Point ! Error {
    let c = g.curve
    zcash_flag_check(c)?
    let size = coordinate_size(g, c)
    if data.len == 0 {
        fail Length
    }
    let first = data[0]
    let compressed = first & 0x80 != 0
    let infinity = first & 0x40 != 0
    let larger = first & 0x20 != 0
    if data.len != (if compressed { size } else { 2 * size }) {
        fail Length
    }
    let body: []u8 = __make(data.len)
    __memmove(body, data)
    body[0] = first & 0x1f
    if infinity {
        if larger || !all_zero(body) {
            fail Flags
        }
        return identity(g)
    }
    if !compressed && larger {
        fail Flags
    }
    let x = read_e(g, body[..size], true)?
    if !compressed {
        let y = read_e(g, body[size..], true)?
        return point_of(g, x, y)?
    }
    let xx = e_mul(g, x, x)
    let rhs = e_add(g, e_mul(g, xx, x), g.b)
    let root = e_sqrt(g, rhs) ?? fail NotOnCurve
    var y = root
    if e_larger(g, y) != larger {
        y = e_neg(g, y)
    }
    point_of(g, x, y)?
}

/// Returns the order `r` of the scalar field as a big-endian 32-byte integer.
pub fn fr_modulus_bytes(c: *Curve) -> []u8 {
    nistec.encode(c.r.m)
}

/// Returns the field element `a` of `Fr` as a big-endian 32-byte scalar.
pub fn fr_bytes(c: *Curve, a: []u64) -> []u8 {
    let plain: []u64 = __make(c.r.m.len)
    nistec.from_mont(c.r, plain, a)
    nistec.encode(plain)
}

/// Returns the element of `Fr` of the 32-byte big-endian scalar `data`, which must be below `r`.
///
/// Fails with `Length` or `NotCanonical`.
pub fn fr_from_bytes(c: *Curve, data: []u8) -> []u64 ! Error {
    if data.len != c.r.m.len * 8 {
        fail Length
    }
    let plain = limb.from_bytes(data, c.r.m.len)
    if !nistec.below(plain, c.r.m) {
        fail NotCanonical
    }
    let out: []u64 = __make(c.r.m.len)
    nistec.to_mont(c.r, out, plain)
    out
}
