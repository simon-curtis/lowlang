import std/crypto
import std/crypto/limb
import std/crypto/nistec

fn reduce_bytes(f: *nistec.Field, data: []u8) -> []u64 {
    let n = f.m.len
    let size = n * 8
    let cut = if data.len > size { data.len - size } else { 0 }
    let low_plain = limb.from_bytes(data[cut..], n)
    let low = nistec.element(f)
    nistec.to_mont(f, low, low_plain)
    if cut == 0 {
        return low
    }
    let high_plain = limb.from_bytes(data[..cut], n)
    let high = nistec.element(f)
    nistec.to_mont(f, high, high_plain)
    let radix = nistec.element(f)
    nistec.to_mont(f, radix, f.one)
    let scaled = nistec.element(f)
    nistec.mul(f, scaled, high, radix)
    nistec.add(f, low, low, scaled)
    low
}

/// Returns the element of `Fr` for the big-endian integer `data` of up to 64 bytes for BLS12-381 and BN254, reduced modulo `r`, in Montgomery form.
///
/// The running time depends only on the length of `data`.
pub fn fr_reduce(c: *Curve, data: []u8) -> []u64 {
    reduce_bytes(c.r, data)
}

/// Returns the element of `Fr` for the small integer `v`.
pub fn fr_from_u64(c: *Curve, v: u64) -> []u64 {
    let plain = nistec.element(c.r)
    plain[0] = v
    let out = nistec.element(c.r)
    nistec.to_mont(c.r, out, plain)
    out
}

/// Returns the zero of `Fr`.
pub fn fr_zero(c: *Curve) -> []u64 {
    nistec.element(c.r)
}

/// Returns the one of `Fr`.
pub fn fr_one(c: *Curve) -> []u64 {
    let out = nistec.element(c.r)
    __memmove(out, c.r.one)
    out
}

/// Returns `a + b` in `Fr`. The running time does not depend on the values.
pub fn fr_add(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let out = nistec.element(c.r)
    nistec.add(c.r, out, a, b)
    out
}

/// Returns `a - b` in `Fr`. The running time does not depend on the values.
pub fn fr_sub(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let out = nistec.element(c.r)
    nistec.sub(c.r, out, a, b)
    out
}

/// Returns `-a` in `Fr`. The running time does not depend on the value.
pub fn fr_neg(c: *Curve, a: []u64) -> []u64 {
    fr_sub(c, fr_zero(c), a)
}

/// Returns `a * b` in `Fr`. The running time does not depend on the values.
pub fn fr_mul(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let out = nistec.element(c.r)
    nistec.mul(c.r, out, a, b)
    out
}

/// Returns the inverse of `a` in `Fr`, or zero for zero. The running time does not depend on the value.
pub fn fr_inv(c: *Curve, a: []u64) -> []u64 {
    let out = nistec.element(c.r)
    nistec.invert(c.r, out, a)
    out
}

/// Returns `a` raised to the plain integer `exponent`, given as limbs, least significant first.
///
/// The running time follows the bits of `exponent`, so it must be public.
pub fn fr_pow(c: *Curve, a: []u64, exponent: []u64) -> []u64 {
    let out = nistec.element(c.r)
    nistec.power(c.r, out, a, exponent)
    out
}

/// Returns whether `a` is zero in `Fr`.
pub fn fr_is_zero(a: []u64) -> bool {
    limb.is_zero(a)
}

/// Returns whether `a` and `b` are equal in `Fr`. The running time does not depend on the values.
pub fn fr_equal(a: []u64, b: []u64) -> bool {
    limb.equal(a, b)
}

/// Returns a uniformly random element of `Fr` from `std/crypto`'s generator, by reducing 64 random bytes, so the bias is below 2^-250.
pub fn fr_random(c: *Curve) -> []u64 {
    fr_reduce(c, crypto.random(64))
}

/// Returns the plain integer of the element `a` of `Fr` as limbs, least significant first.
pub fn fr_limbs(c: *Curve, a: []u64) -> []u64 {
    let out = nistec.element(c.r)
    nistec.from_mont(c.r, out, a)
    out
}
