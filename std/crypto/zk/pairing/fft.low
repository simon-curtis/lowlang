/// A multiplicative subgroup of `Fr` of order `size`, a power of two, with the powers of its generator.
pub struct Domain {
    /// The curve whose scalar field the domain lies in.
    pub curve: *Curve
    /// The number of elements of the subgroup.
    pub size: i64
    /// The generator `omega` of the subgroup, a primitive root of unity of order `size`.
    pub omega: []u64
    /// The inverse of `size` in `Fr`.
    pub size_inverse: []u64
    roots: [][]u64
}

/// Returns the domain of `size` elements, which must be a power of two up to `2^28` for BN254 and `2^32` for BLS12-381.
///
/// The generator is the `size`-th root of unity `g^((r - 1) / size)` for the generator `g` of `Fr*`, which is 5 for BN254 (as in snarkjs and arkworks) and 7 for BLS12-381 (as in the consensus specification and arkworks), so that the roots of the smaller domains are its powers. Fails with `Size`.
pub fn domain(c: *Curve, size: i64) -> Domain ! Error {
    if size < 1 || size & (size - 1) != 0 {
        fail Size
    }
    var log = 0
    for (i64(1) << log) < size {
        log += 1
    }
    let top = root_of_unity(c, log)?
    var roots: [][]u64 = []
    var current = fr_one(c)
    for _ in 0..size / 2 {
        push(mut roots, current)
        current = fr_mul(c, current, top)
    }
    let inverse = fr_inv(c, fr_from_u64(c, u64(size)))
    Domain { curve: c, size, omega: top, size_inverse: inverse, roots }
}

/// Returns the generator of the subgroup of order `2^log` of `Fr*` that `domain` uses, for `0 <= log <= 28` on BN254 and `0 <= log <= 32` on BLS12-381. Fails with `Size`.
pub fn root_of_unity(c: *Curve, log: i64) -> []u64 ! Error {
    if log < 0 || log > c.p.two_adicity {
        fail Size
    }
    let exponent = minus_small(c.r.m, 1)
    let base = fr_from_u64(c, c.p.generator)
    fr_pow(c, base, exponent_shifted(exponent, log))
}

fn exponent_shifted(order_minus_one: []u64, log: i64) -> []u64 {
    var out = order_minus_one
    var left = log
    for left > 0 {
        let step = if left > 63 { 63 } else { left }
        out = shift_right(out, step)
        left -= step
    }
    out
}

/// Returns the power `omega^index` of the generator of `d` for `0 <= index < size / 2`.
pub fn domain_root(d: Domain, index: i64) -> []u64 {
    d.roots[index]
}

fn reverse_bits(value: i64, bits: i64) -> i64 {
    var out = 0
    for k in 0..bits {
        out |= ((value >> k) & 1) << (bits - 1 - k)
    }
    out
}

fn transform(d: Domain, values: [][]u64) -> [][]u64 {
    let c = d.curve
    let n = d.size
    var bits = 0
    for (i64(1) << bits) < n {
        bits += 1
    }
    var out: [][]u64 = []
    for i in 0..n {
        push(mut out, values[reverse_bits(i, bits)])
    }
    var half = 1
    for half < n {
        let stride = n / (2 * half)
        var start = 0
        for start < n {
            for k in 0..half {
                let twiddle = d.roots[k * stride]
                let odd = fr_mul(c, twiddle, out[start + k + half])
                let even = out[start + k]
                out[start + k] = fr_add(c, even, odd)
                out[start + k + half] = fr_sub(c, even, odd)
            }
            start += 2 * half
        }
        half *= 2
    }
    out
}

/// Returns the evaluations of the polynomial whose coefficients `values[i]` (of `x^i`, lowest degree first) are given, at the points `omega^0` to `omega^(size - 1)` of `d`, by the radix-2 number-theoretic transform.
///
/// `values` must have exactly `d.size` elements of `Fr`. The input is not modified. The running time does not depend on the values.
pub fn fft(d: Domain, values: [][]u64) -> [][]u64 {
    transform(d, values)
}

/// Returns the coefficients of the polynomial of degree below `d.size` that takes the values `values[i]` at `omega^i`, the inverse of `fft`.
pub fn ifft(d: Domain, values: [][]u64) -> [][]u64 {
    let c = d.curve
    let n = d.size
    let spectrum = transform(d, values)
    var out: [][]u64 = []
    for i in 0..n {
        let at = if i == 0 { 0 } else { n - i }
        push(mut out, fr_mul(c, spectrum[at], d.size_inverse))
    }
    out
}

fn scale_by_powers(c: *Curve, values: [][]u64, ratio: []u64) -> [][]u64 {
    var out: [][]u64 = []
    var power = fr_one(c)
    for v in values {
        push(mut out, fr_mul(c, v, power))
        power = fr_mul(c, power, ratio)
    }
    out
}

/// Returns the evaluations of the polynomial with the given coefficients at the points `shift * omega^i`, the coset of `d` by `shift`.
pub fn coset_fft(d: Domain, values: [][]u64, shift: []u64) -> [][]u64 {
    transform(d, scale_by_powers(d.curve, values, shift))
}

/// Returns the coefficients of the polynomial of degree below `d.size` that takes the values `values[i]` at `shift * omega^i`, the inverse of `coset_fft`. `shift` must not be zero.
pub fn coset_ifft(d: Domain, values: [][]u64, shift: []u64) -> [][]u64 {
    let c = d.curve
    let coefficients = ifft(d, values)
    scale_by_powers(c, coefficients, fr_inv(c, shift))
}

/// Returns the value at `x` of the polynomial with the given coefficients, lowest degree first, by Horner's rule.
pub fn evaluate(c: *Curve, coefficients: [][]u64, x: []u64) -> []u64 {
    var acc = fr_zero(c)
    var i = coefficients.len - 1
    for i >= 0 {
        acc = fr_add(c, fr_mul(c, acc, x), coefficients[i])
        i -= 1
    }
    acc
}
