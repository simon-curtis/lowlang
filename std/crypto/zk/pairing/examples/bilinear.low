import std/crypto/zk/pairing
import std/text

fn scalar(n: u8) -> []u8 {
    var k: []u8 = []
    for _ in 0..31 {
        push(mut k, 0)
    }
    push(mut k, n)
    k
}

fn show(label: str, data: []u8) {
    print("{label} {text.encode_hex(data)}")
}

fn describe(g: *pairing.Group, data: []u8) -> str {
    let p = pairing.deserialize_zcash(g, data) catch {
        Length => return "rejected, wrong length"
        _ => return "rejected"
    }
    if pairing.is_identity(p) { "infinity" } else { "a point of the subgroup" }
}

fn main() ! pairing.Error {
    let c = pairing.bls12_381()
    let one = pairing.g1(c)
    let two = pairing.g2(c)
    let p = one.generator
    let q = two.generator

    let a = scalar(6)
    let b = scalar(7)
    let ap = pairing.scalar_mul(one, p, a)
    let bq = pairing.scalar_mul(two, q, b)

    let lhs = pairing.pairing(c, ap, bq)
    let rhs = pairing.gt_pow(c, pairing.pairing(c, p, q), [42])
    print("e(6P, 7Q) == e(P, Q)^42: {pairing.gt_equal(lhs, rhs)}")

    let negated = pairing.negate(one, pairing.scalar_mul(one, p, scalar(42)))
    let holds = pairing.pairing_check(c, [ap, negated], [bq, q])
    print("e(6P, 7Q) * e(-42P, Q) == 1: {holds}")
    let fails = pairing.pairing_check(c, [ap, negated], [bq, bq])
    print("with 7Q in place of Q: {fails}")

    let ap_bytes = pairing.serialize_zcash(one, ap, true)?
    let bq_bytes = pairing.serialize_zcash(two, bq, true)?
    show("6P compressed", ap_bytes)
    show("7Q compressed", bq_bytes)

    let message = bytes("abc")
    let dst = bytes("QUUX-V01-CS02-with-BLS12381G1_XMD:SHA-256_SSWU_RO_")
    let h = pairing.hash_to_curve(one, message, dst)?
    let h_bytes = pairing.serialize_zcash(one, h, true)?
    show("hash_to_curve", h_bytes)
    print("in subgroup: {pairing.in_subgroup(one, h)}")

    print("decode 32 zero bytes: {describe(one, scalar(0))}")
    print("decode compressed 6P: {describe(one, ap_bytes)}")
}
