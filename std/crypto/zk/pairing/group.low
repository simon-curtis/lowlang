import std/crypto/limb
import std/crypto/nistec

/// A point of `G1` or `G2` in homogeneous projective coordinates `(X : Y : Z)` with `x = X / Z` and `y = Y / Z`, each a base field element (`G1`) or an `Fq2` element (`G2`) in Montgomery form. The point at infinity has `Z = 0`.
pub struct Point {
    /// The `X` coordinate.
    pub x: []u64
    /// The `Y` coordinate.
    pub y: []u64
    /// The `Z` coordinate.
    pub z: []u64
}

/// A point with `Z = 1`, as the coordinates `x` and `y`.
pub struct Affine {
    /// The `x` coordinate.
    pub x: []u64
    /// The `y` coordinate.
    pub y: []u64
}

/// The group `G1`, of points over `Fq`, or `G2`, of points over `Fq2` on the twist, of a curve.
///
/// The addition and doubling are the complete formulas of Renes, Costello and Batina for `y^2 = x^3 + b`, which hold for every pair of points including equal points, opposite points and infinity.
pub struct Group {
    /// The curve the group belongs to.
    pub curve: *Curve
    /// The degree of the coordinate field over `Fq`: 1 for `G1` and 2 for `G2`.
    pub degree: i64
    /// The coefficient `b` of the group's curve equation.
    pub b: []u64
    /// The generator of the prime-order subgroup.
    pub generator: Point
    b3: []u64
}

/// Returns `G1` of `c`.
pub fn g1(c: *Curve) -> *Group {
    let b = c.b
    let b3 = fp_scale(c, b, 3)
    let x = nistec.hex_limbs(c.p.g1x)
    let y = nistec.hex_limbs(c.p.g1y)
    let gx = fp_zero(c)
    nistec.to_mont(c.q, gx, x)
    let gy = fp_zero(c)
    nistec.to_mont(c.q, gy, y)
    new(Group { curve: c, degree: 1, b, generator: Point { x: gx, y: gy, z: fp_one(c) }, b3 })
}

/// Returns `G2` of `c`.
pub fn g2(c: *Curve) -> *Group {
    let b = c.b2
    let b3 = f2_scale(c, b, 3)
    let gx = f2_new(c, plain_to_fp(c, c.p.g2x0), plain_to_fp(c, c.p.g2x1))
    let gy = f2_new(c, plain_to_fp(c, c.p.g2y0), plain_to_fp(c, c.p.g2y1))
    new(Group { curve: c, degree: 2, b, generator: Point { x: gx, y: gy, z: f2_one(c) }, b3 })
}

fn plain_to_fp(c: *Curve, hex: str) -> []u64 {
    let out = fp_zero(c)
    nistec.to_mont(c.q, out, nistec.hex_limbs(hex))
    out
}

fn e_zero(g: *Group) -> []u64 {
    __make(g.degree * g.curve.n)
}

fn e_one(g: *Group) -> []u64 {
    if g.degree == 1 { fp_one(g.curve) } else { f2_one(g.curve) }
}

fn e_add(g: *Group, a: []u64, b: []u64) -> []u64 {
    if g.degree == 1 { fp_add(g.curve, a, b) } else { f2_add(g.curve, a, b) }
}

fn e_sub(g: *Group, a: []u64, b: []u64) -> []u64 {
    if g.degree == 1 { fp_sub(g.curve, a, b) } else { f2_sub(g.curve, a, b) }
}

fn e_neg(g: *Group, a: []u64) -> []u64 {
    if g.degree == 1 { fp_neg(g.curve, a) } else { f2_neg(g.curve, a) }
}

fn e_mul(g: *Group, a: []u64, b: []u64) -> []u64 {
    if g.degree == 1 { fp_mul(g.curve, a, b) } else { f2_mul(g.curve, a, b) }
}

fn e_inv(g: *Group, a: []u64) -> []u64 {
    if g.degree == 1 { fp_inv(g.curve, a) } else { f2_inv(g.curve, a) }
}

/// Returns the point at infinity, the neutral element.
pub fn identity(g: *Group) -> Point {
    Point { x: e_zero(g), y: e_one(g), z: e_zero(g) }
}

/// Returns whether `a` is the point at infinity.
pub fn is_identity(a: Point) -> bool {
    limb.is_zero(a.z)
}

/// Returns the point `(x, y)`.
///
/// The coordinates are not checked; `on_curve` and `in_subgroup` do that.
pub fn from_affine(g: *Group, a: Affine) -> Point {
    Point { x: a.x, y: a.y, z: e_one(g) }
}

/// Returns `a + b`. It is complete: `a` and `b` can be any points, equal or opposite, or infinity. The running time does not depend on the values.
pub fn add(g: *Group, a: Point, b: Point) -> Point {
    var t0 = e_mul(g, a.x, b.x)
    var t1 = e_mul(g, a.y, b.y)
    var t2 = e_mul(g, a.z, b.z)
    var t3 = e_add(g, a.x, a.y)
    var t4 = e_add(g, b.x, b.y)
    t3 = e_mul(g, t3, t4)
    t4 = e_add(g, t0, t1)
    t3 = e_sub(g, t3, t4)
    t4 = e_add(g, a.y, a.z)
    var x3 = e_add(g, b.y, b.z)
    t4 = e_mul(g, t4, x3)
    x3 = e_add(g, t1, t2)
    t4 = e_sub(g, t4, x3)
    x3 = e_add(g, a.x, a.z)
    var y3 = e_add(g, b.x, b.z)
    x3 = e_mul(g, x3, y3)
    y3 = e_add(g, t0, t2)
    y3 = e_sub(g, x3, y3)
    x3 = e_add(g, t0, t0)
    t0 = e_add(g, x3, t0)
    t2 = e_mul(g, g.b3, t2)
    var z3 = e_add(g, t1, t2)
    t1 = e_sub(g, t1, t2)
    y3 = e_mul(g, g.b3, y3)
    x3 = e_mul(g, t4, y3)
    t2 = e_mul(g, t3, t1)
    x3 = e_sub(g, t2, x3)
    y3 = e_mul(g, y3, t0)
    t1 = e_mul(g, t1, z3)
    y3 = e_add(g, t1, y3)
    t0 = e_mul(g, t0, t3)
    z3 = e_mul(g, z3, t4)
    z3 = e_add(g, z3, t0)
    Point { x: x3, y: y3, z: z3 }
}

/// Returns `2 a`, with the complete doubling formulas.
pub fn double(g: *Group, a: Point) -> Point {
    var t0 = e_mul(g, a.y, a.y)
    var z3 = e_add(g, t0, t0)
    z3 = e_add(g, z3, z3)
    z3 = e_add(g, z3, z3)
    var t1 = e_mul(g, a.y, a.z)
    var t2 = e_mul(g, a.z, a.z)
    t2 = e_mul(g, g.b3, t2)
    var x3 = e_mul(g, t2, z3)
    var y3 = e_add(g, t0, t2)
    z3 = e_mul(g, t1, z3)
    t1 = e_add(g, t2, t2)
    t2 = e_add(g, t1, t2)
    t0 = e_sub(g, t0, t2)
    y3 = e_mul(g, t0, y3)
    y3 = e_add(g, x3, y3)
    t1 = e_mul(g, a.x, a.y)
    x3 = e_mul(g, t0, t1)
    x3 = e_add(g, x3, x3)
    Point { x: x3, y: y3, z: z3 }
}

/// Returns `-a`.
pub fn negate(g: *Group, a: Point) -> Point {
    Point { x: a.x, y: e_neg(g, a.y), z: a.z }
}

/// Returns `a - b`.
pub fn sub(g: *Group, a: Point, b: Point) -> Point {
    add(g, a, negate(g, b))
}

/// Returns whether `a` and `b` are the same point.
pub fn equal(g: *Group, a: Point, b: Point) -> bool {
    let left = e_mul(g, a.x, b.z)
    let right = e_mul(g, b.x, a.z)
    let up = e_mul(g, a.y, b.z)
    let down = e_mul(g, b.y, a.z)
    limb.equal(left, right) && limb.equal(up, down)
}

/// Returns `a` as coordinates, or `none` for the point at infinity.
pub fn to_affine(g: *Group, a: Point) -> Affine? {
    if is_identity(a) {
        return none
    }
    let inverse = e_inv(g, a.z)
    Affine { x: e_mul(g, a.x, inverse), y: e_mul(g, a.y, inverse) }
}

/// Returns whether the point `a` satisfies the curve equation of the group.
pub fn on_curve(g: *Group, a: Point) -> bool {
    let yy = e_mul(g, a.y, a.y)
    let y2z = e_mul(g, yy, a.z)
    let xx = e_mul(g, a.x, a.x)
    let x3 = e_mul(g, xx, a.x)
    let zz = e_mul(g, a.z, a.z)
    let z3 = e_mul(g, zz, a.z)
    let bz = e_mul(g, g.b, z3)
    limb.equal(y2z, e_add(g, x3, bz))
}

fn lookup(g: *Group, table: []Point, index: u64) -> Point {
    let entry = Point { x: e_zero(g), y: e_zero(g), z: e_zero(g) }
    for k, row in table {
        let mask = limb.mask_of(limb.same(u64(k), index))
        limb.gather(entry.x, row.x, mask)
        limb.gather(entry.y, row.y, mask)
        limb.gather(entry.z, row.z, mask)
    }
    entry
}

fn multiples(g: *Group, base: Point) -> []Point {
    var table: []Point = []
    push(mut table, identity(g))
    for i in 1..16 {
        push(mut table, add(g, table[i - 1], base))
    }
    table
}

/// Returns `scalar * base` for a big-endian `scalar` of any length.
///
/// The scalar is read in 4-bit windows through a table lookup that touches every entry, so the running time and the memory accesses do not depend on its value, only on its length. The scalar is not reduced. Use it for secret scalars.
pub fn scalar_mul(g: *Group, base: Point, scalar: []u8) -> Point {
    let table = multiples(g, base)
    var acc = identity(g)
    for byte in scalar {
        for half in 0..2 {
            for _ in 0..4 {
                acc = double(g, acc)
            }
            let nibble = if half == 0 { byte >> 4 } else { byte & 15 }
            let entry = lookup(g, table, u64(nibble))
            acc = add(g, acc, entry)
        }
    }
    acc
}

/// Returns `scalar * base` for a big-endian `scalar` of any length, skipping the work for zero bits.
///
/// The running time depends on the scalar, so use it only for public scalars.
pub fn scalar_mul_vartime(g: *Group, base: Point, scalar: []u8) -> Point {
    var acc = identity(g)
    for byte in scalar {
        var bit = 7
        for bit >= 0 {
            acc = double(g, acc)
            if (byte >> bit) & 1 == 1 {
                acc = add(g, acc, base)
            }
            bit -= 1
        }
    }
    acc
}

/// Returns whether `a` lies in the subgroup of prime order `r`.
///
/// For BN254 `G1` every curve point does. For BLS12-381 `G1` it tests `phi(a) = -x^2 a` for the endomorphism `phi(x, y) = (beta x, y)` and the curve parameter `x`, which holds exactly on the subgroup of curve points; every other group multiplies by `r` and tests for infinity. The curve equation is not checked; use `on_curve` first.
pub fn in_subgroup(g: *Group, a: Point) -> bool {
    let c = g.curve
    if c.kind == Bn254 && g.degree == 1 {
        return true
    }
    if c.kind == Bls12381 && g.degree == 1 {
        let x = limb.to_bytes(c.abs_x, 8)
        let once = scalar_mul_vartime(g, a, x)
        let twice = scalar_mul_vartime(g, once, x)
        let image = Point { x: fp_mul(c, c.beta, a.x), y: a.y, z: a.z }
        return equal(g, image, negate(g, twice))
    }
    let order = limb.to_bytes(c.r.m, c.r.m.len * 8)
    is_identity(scalar_mul_vartime(g, a, order))
}

/// Returns `a` multiplied by the cofactor that maps any point of the curve into the subgroup of order `r`.
///
/// For BN254 `G1` the cofactor is 1. For BLS12-381 the multiplier is the effective cofactor of RFC 9380 section 8.8, `1 - x` for `G1` and the `h_eff` of the `G2` suite for `G2`, which differs from the cofactor `h` by a factor coprime to `r`.
pub fn clear_cofactor(g: *Group, a: Point) -> Point {
    let c = g.curve
    let limbs = if g.degree == 1 { c.cleared1 } else { c.cleared2 }
    scalar_mul_vartime(g, a, limb.to_bytes(limbs, limbs.len * 8))
}
