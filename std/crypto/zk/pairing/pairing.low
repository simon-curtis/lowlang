import std/crypto/limb

struct Jacobian {
    x: []u64
    y: []u64
    z: []u64
}

struct Step {
    t: Jacobian
    line: []u64
}

fn line_element(c: *Curve, constant: []u64, cross_slot: i64, cross: []u64, twist: []u64) -> []u64 {
    let m = 2 * c.n
    let out: []u64 = __make(12 * c.n)
    __memmove(out, constant)
    __memmove(out[cross_slot * m..], cross)
    __memmove(out[4 * m..], twist)
    out
}

fn line_at(c: *Curve, constant: []u64, cross: []u64, twist: []u64) -> []u64 {
    match c.kind {
        Bn254 => line_element(c, constant, 3, cross, twist)
        Bls12381 => line_element(c, f2_mul_xi(c, constant), 5, cross, twist)
    }
}

fn double_step(c: *Curve, t: Jacobian, xp: []u64, yp: []u64) -> Step {
    let a = f2_sqr(c, t.x)
    let b = f2_sqr(c, t.y)
    let cc = f2_sqr(c, b)
    let sum = f2_sqr(c, f2_add(c, t.x, b))
    let half = f2_sub(c, f2_sub(c, sum, a), cc)
    let d = f2_add(c, half, half)
    let e = f2_scale(c, a, 3)
    let f = f2_sqr(c, e)
    let x3 = f2_sub(c, f, f2_add(c, d, d))
    let eight_c = f2_scale(c, cc, 8)
    let y3 = f2_sub(c, f2_mul(c, e, f2_sub(c, d, x3)), eight_c)
    let yz = f2_mul(c, t.y, t.z)
    let z3 = f2_add(c, yz, yz)
    let zz = f2_sqr(c, t.z)
    let constant = f2_mul_fp(c, f2_mul(c, z3, zz), yp)
    let cross = f2_neg(c, f2_mul_fp(c, f2_mul(c, e, zz), xp))
    let twist = f2_sub(c, f2_mul(c, e, t.x), f2_add(c, b, b))
    Step { t: Jacobian { x: x3, y: y3, z: z3 }, line: line_at(c, constant, cross, twist) }
}

fn add_step(c: *Curve, t: Jacobian, qx: []u64, qy: []u64, xp: []u64, yp: []u64) -> Step {
    let zz = f2_sqr(c, t.z)
    let u2 = f2_mul(c, qx, zz)
    let s2 = f2_mul(c, qy, f2_mul(c, t.z, zz))
    let h = f2_sub(c, u2, t.x)
    let hh = f2_sqr(c, h)
    let i = f2_scale(c, hh, 4)
    let j = f2_mul(c, h, i)
    let n = f2_sub(c, s2, t.y)
    let r = f2_add(c, n, n)
    let v = f2_mul(c, t.x, i)
    let x3 = f2_sub(c, f2_sub(c, f2_sqr(c, r), j), f2_add(c, v, v))
    let yj = f2_mul(c, t.y, j)
    let y3 = f2_sub(c, f2_mul(c, r, f2_sub(c, v, x3)), f2_add(c, yj, yj))
    let zh = f2_mul(c, t.z, h)
    let z3 = f2_add(c, zh, zh)
    let constant = f2_mul_fp(c, zh, yp)
    let cross = f2_neg(c, f2_mul_fp(c, n, xp))
    let twist = f2_sub(c, f2_mul(c, n, qx), f2_mul(c, qy, zh))
    Step { t: Jacobian { x: x3, y: y3, z: z3 }, line: line_at(c, constant, cross, twist) }
}

fn miller_loop(c: *Curve, p: Affine, q: Affine) -> []u64 {
    let digits = c.p.loop
    var t = Jacobian { x: q.x, y: q.y, z: f2_one(c) }
    var f = f12_one(c)
    let neg_y = f2_neg(c, q.y)
    for i in 1..digits.len {
        f = f12_sqr(c, f)
        let d = double_step(c, t, p.x, p.y)
        t = d.t
        f = f12_mul(c, f, d.line)
        let digit = digits[i]
        if digit == '1' {
            let a = add_step(c, t, q.x, q.y, p.x, p.y)
            t = a.t
            f = f12_mul(c, f, a.line)
        } else if digit == 'n' {
            let a = add_step(c, t, q.x, neg_y, p.x, p.y)
            t = a.t
            f = f12_mul(c, f, a.line)
        }
    }
    match c.kind {
        Bn254 => {
            let q1x = f2_mul(c, f2_conj(c, q.x), c.gamma1[2])
            let q1y = f2_mul(c, f2_conj(c, q.y), c.gamma1[3])
            let a = add_step(c, t, q1x, q1y, p.x, p.y)
            t = a.t
            f = f12_mul(c, f, a.line)
            let q2x = f2_mul(c, q.x, c.gamma2[2])
            let q2y = f2_neg(c, f2_mul(c, q.y, c.gamma2[3]))
            let b = add_step(c, t, q2x, q2y, p.x, p.y)
            f = f12_mul(c, f, b.line)
            f
        }
        Bls12381 => f12_conj(c, f)
    }
}

fn final_exponentiation(c: *Curve, f: []u64) -> []u64 {
    let conjugate = f12_conj(c, f)
    let inverse = f12_inv(c, f)
    let easy1 = f12_mul(c, conjugate, inverse)
    let easy2 = f12_mul(c, f12_frobenius(c, easy1, 2), easy1)
    f12_pow(c, easy2, c.hard)
}

/// Returns the optimal ate pairing `e(p, q)` of `p` in `G1` and `q` in `G2` of the curve `c`, an element of `GT` as twelve base field elements, or the identity of `GT` when either point is at infinity.
///
/// The points must lie in the subgroup of order `r`; the decoders in this module check that. The running time depends on the points, so use it for public data.
pub fn pairing(c: *Curve, p: Point, q: Point) -> []u64 {
    let g_one = g1(c)
    let g_two = g2(c)
    let a = to_affine(g_one, p) ?? return f12_one(c)
    let b = to_affine(g_two, q) ?? return f12_one(c)
    final_exponentiation(c, miller_loop(c, a, b))
}

/// Returns the product of `e(ps[i], qs[i])` over all `i`, with one final exponentiation, which is how a verifier checks a pairing equation.
///
/// `ps` and `qs` must have the same length, and every point must lie in its subgroup. Pairs with a point at infinity contribute 1.
pub fn pairing_product(c: *Curve, ps: []Point, qs: []Point) -> []u64 {
    let g_one = g1(c)
    let g_two = g2(c)
    var f = f12_one(c)
    for i in 0..ps.len {
        let a = to_affine(g_one, ps[i])
        let b = to_affine(g_two, qs[i])
        match a {
            some(pa) => match b {
                some(pb) => {
                    f = f12_mul(c, f, miller_loop(c, pa, pb))
                }
                none => {}
            }
            none => {}
        }
    }
    final_exponentiation(c, f)
}

/// Returns whether the product of `e(ps[i], qs[i])` is the identity of `GT`.
pub fn pairing_check(c: *Curve, ps: []Point, qs: []Point) -> bool {
    f12_is_one(c, pairing_product(c, ps, qs))
}

/// Returns the identity of `GT`.
pub fn gt_one(c: *Curve) -> []u64 {
    f12_one(c)
}

/// Returns `a * b` in `GT`.
pub fn gt_mul(c: *Curve, a: []u64, b: []u64) -> []u64 {
    f12_mul(c, a, b)
}

/// Returns the inverse of `a` in `GT`.
pub fn gt_inv(c: *Curve, a: []u64) -> []u64 {
    f12_inv(c, a)
}

/// Returns `a` raised to the plain integer `exponent`, given as limbs, least significant first.
///
/// The running time follows the bits of `exponent`, so it must be public.
pub fn gt_pow(c: *Curve, a: []u64, exponent: []u64) -> []u64 {
    f12_pow(c, a, exponent)
}

/// Returns whether `a` is the identity of `GT`.
pub fn gt_is_one(c: *Curve, a: []u64) -> bool {
    f12_is_one(c, a)
}

/// Returns whether `a` and `b` are the same element of `GT`.
pub fn gt_equal(a: []u64, b: []u64) -> bool {
    limb.equal(a, b)
}

/// Returns the encoding of `a` as its twelve base field coefficients in the order of the tower, `d0.c0.a0`, `d0.c0.a1`, `d0.c1.a0` and so on through `d1.c2.a1`, each big-endian and canonical, `12 * 8 n` bytes.
pub fn gt_bytes(c: *Curve, a: []u64) -> []u8 {
    var out: []u8 = []
    for k in 0..12 {
        for b in write_fp(c, a[k * c.n..(k + 1) * c.n]) {
            push(mut out, b)
        }
    }
    out
}

/// Returns the element of `Fq12` that `gt_bytes` encodes, or fails with `Length` or `NotCanonical`. It does not check that the element lies in `GT`.
pub fn gt_from_bytes(c: *Curve, data: []u8) -> []u64 ! Error {
    let size = c.n * 8
    if data.len != 12 * size {
        fail Length
    }
    let out: []u64 = __make(12 * c.n)
    for k in 0..12 {
        let value = read_fp(c, data[k * size..(k + 1) * size])?
        __memmove(out[k * c.n..], value)
    }
    out
}
