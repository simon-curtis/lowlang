import std/crypto/limb
import std/crypto/nistec

fn fp_zero(c: *Curve) -> []u64 {
    __make(c.n)
}

fn fp_one(c: *Curve) -> []u64 {
    let out: []u64 = __make(c.n)
    __memmove(out, c.q.one)
    out
}

fn fp_small(c: *Curve, k: u64) -> []u64 {
    let plain: []u64 = __make(c.n)
    plain[0] = k
    let out: []u64 = __make(c.n)
    nistec.to_mont(c.q, out, plain)
    out
}

fn fp_add(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let out: []u64 = __make(c.n)
    nistec.add(c.q, out, a, b)
    out
}

fn fp_sub(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let out: []u64 = __make(c.n)
    nistec.sub(c.q, out, a, b)
    out
}

fn fp_neg(c: *Curve, a: []u64) -> []u64 {
    let zero: []u64 = __make(c.n)
    fp_sub(c, zero, a)
}

fn fp_mul(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let out: []u64 = __make(c.n)
    nistec.mul(c.q, out, a, b)
    out
}

fn fp_scale(c: *Curve, a: []u64, k: u64) -> []u64 {
    var acc = a
    for _ in 1..k {
        acc = fp_add(c, acc, a)
    }
    acc
}

fn fp_inv(c: *Curve, a: []u64) -> []u64 {
    let out: []u64 = __make(c.n)
    nistec.invert(c.q, out, a)
    out
}

fn fp_pow(c: *Curve, a: []u64, e: []u64) -> []u64 {
    let out: []u64 = __make(c.n)
    nistec.power(c.q, out, a, e)
    out
}

fn fp_plain(c: *Curve, a: []u64) -> []u64 {
    let out: []u64 = __make(c.n)
    nistec.from_mont(c.q, out, a)
    out
}

fn fp_sgn(c: *Curve, a: []u64) -> u64 {
    let plain = fp_plain(c, a)
    plain[0] & 1
}

fn fp_larger(c: *Curve, a: []u64) -> bool {
    let plain = fp_plain(c, a)
    let negated = fp_plain(c, fp_neg(c, a))
    let diff: []u64 = __make(c.n)
    limb.sub(diff, negated, plain) == 1
}

fn fp_sqrt(c: *Curve, a: []u64) -> []u64? {
    let root = fp_pow(c, a, c.e_fp_root)
    let square = fp_mul(c, root, root)
    if limb.equal(square, a) {
        return root
    }
    none
}

fn f2_one(c: *Curve) -> []u64 {
    let out: []u64 = __make(2 * c.n)
    __memmove(out, c.q.one)
    out
}

fn f2_new(c: *Curve, a0: []u64, a1: []u64) -> []u64 {
    let out: []u64 = __make(2 * c.n)
    __memmove(out, a0)
    __memmove(out[c.n..], a1)
    out
}

fn f2_from_fp(c: *Curve, a: []u64) -> []u64 {
    f2_new(c, a, fp_zero(c))
}

fn f2_xi(c: *Curve) -> []u64 {
    f2_new(c, fp_small(c, c.xi), fp_one(c))
}

fn f2_add(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let n = c.n
    f2_new(c, fp_add(c, a[..n], b[..n]), fp_add(c, a[n..], b[n..]))
}

fn f2_sub(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let n = c.n
    f2_new(c, fp_sub(c, a[..n], b[..n]), fp_sub(c, a[n..], b[n..]))
}

fn f2_neg(c: *Curve, a: []u64) -> []u64 {
    let n = c.n
    f2_new(c, fp_neg(c, a[..n]), fp_neg(c, a[n..]))
}

fn f2_conj(c: *Curve, a: []u64) -> []u64 {
    let n = c.n
    f2_new(c, a[..n], fp_neg(c, a[n..]))
}

fn f2_mul(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let n = c.n
    let a0 = a[..n]
    let a1 = a[n..]
    let b0 = b[..n]
    let b1 = b[n..]
    let v0 = fp_mul(c, a0, b0)
    let v1 = fp_mul(c, a1, b1)
    let cross = fp_mul(c, fp_add(c, a0, a1), fp_add(c, b0, b1))
    let real = fp_sub(c, v0, v1)
    let imag = fp_sub(c, fp_sub(c, cross, v0), v1)
    f2_new(c, real, imag)
}

fn f2_sqr(c: *Curve, a: []u64) -> []u64 {
    let n = c.n
    let a0 = a[..n]
    let a1 = a[n..]
    let real = fp_mul(c, fp_add(c, a0, a1), fp_sub(c, a0, a1))
    let product = fp_mul(c, a0, a1)
    f2_new(c, real, fp_add(c, product, product))
}

fn f2_mul_fp(c: *Curve, a: []u64, k: []u64) -> []u64 {
    let n = c.n
    f2_new(c, fp_mul(c, a[..n], k), fp_mul(c, a[n..], k))
}

fn f2_scale(c: *Curve, a: []u64, k: u64) -> []u64 {
    let n = c.n
    f2_new(c, fp_scale(c, a[..n], k), fp_scale(c, a[n..], k))
}

fn f2_mul_xi(c: *Curve, a: []u64) -> []u64 {
    let n = c.n
    let a0 = a[..n]
    let a1 = a[n..]
    let real = fp_sub(c, fp_scale(c, a0, c.xi), a1)
    let imag = fp_add(c, a0, fp_scale(c, a1, c.xi))
    f2_new(c, real, imag)
}

fn f2_inv(c: *Curve, a: []u64) -> []u64 {
    let n = c.n
    let a0 = a[..n]
    let a1 = a[n..]
    let norm = fp_add(c, fp_mul(c, a0, a0), fp_mul(c, a1, a1))
    let inverse = fp_inv(c, norm)
    f2_new(c, fp_mul(c, a0, inverse), fp_neg(c, fp_mul(c, a1, inverse)))
}

fn f2_is_zero(a: []u64) -> bool {
    limb.is_zero(a)
}

fn f2_pow(c: *Curve, a: []u64, e: []u64) -> []u64 {
    var out = f2_one(c)
    var i = e.len - 1
    for i >= 0 {
        var bit = 63
        for bit >= 0 {
            out = f2_sqr(c, out)
            if (e[i] >> bit) & 1 == 1 {
                out = f2_mul(c, out, a)
            }
            bit -= 1
        }
        i -= 1
    }
    out
}

fn f2_sgn(c: *Curve, a: []u64) -> u64 {
    let n = c.n
    let low = fp_plain(c, a[..n])
    if limb.is_zero(low) {
        let high = fp_plain(c, a[n..])
        return high[0] & 1
    }
    low[0] & 1
}

fn f2_larger(c: *Curve, a: []u64) -> bool {
    let n = c.n
    if !limb.is_zero(a[n..]) {
        return fp_larger(c, a[n..])
    }
    fp_larger(c, a[..n])
}

fn f2_sqrt(c: *Curve, a: []u64) -> []u64? {
    if f2_is_zero(a) {
        return a
    }
    let a1 = f2_pow(c, a, c.e_fq2_a)
    let alpha = f2_mul(c, f2_sqr(c, a1), a)
    let norm = f2_mul(c, f2_conj(c, alpha), alpha)
    let minus_one = f2_neg(c, f2_one(c))
    if limb.equal(norm, minus_one) {
        return none
    }
    let x0 = f2_mul(c, a1, a)
    var root: []u64 = []
    if limb.equal(alpha, minus_one) {
        let unit = f2_new(c, fp_zero(c), fp_one(c))
        root = f2_mul(c, unit, x0)
    } else {
        let one_plus = f2_add(c, f2_one(c), alpha)
        let b = f2_pow(c, one_plus, c.e_half)
        root = f2_mul(c, b, x0)
    }
    let square = f2_sqr(c, root)
    if limb.equal(square, a) {
        return root
    }
    none
}

fn f6_new(c: *Curve, a0: []u64, a1: []u64, a2: []u64) -> []u64 {
    let m = 2 * c.n
    let out: []u64 = __make(6 * c.n)
    __memmove(out, a0)
    __memmove(out[m..], a1)
    __memmove(out[2 * m..], a2)
    out
}

fn f6_add(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let m = 2 * c.n
    f6_new(c, f2_add(c, a[..m], b[..m]), f2_add(c, a[m..2 * m], b[m..2 * m]), f2_add(c, a[2 * m..], b[2 * m..]))
}

fn f6_sub(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let m = 2 * c.n
    f6_new(c, f2_sub(c, a[..m], b[..m]), f2_sub(c, a[m..2 * m], b[m..2 * m]), f2_sub(c, a[2 * m..], b[2 * m..]))
}

fn f6_neg(c: *Curve, a: []u64) -> []u64 {
    let m = 2 * c.n
    f6_new(c, f2_neg(c, a[..m]), f2_neg(c, a[m..2 * m]), f2_neg(c, a[2 * m..]))
}

fn f6_mul(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let m = 2 * c.n
    let a0 = a[..m]
    let a1 = a[m..2 * m]
    let a2 = a[2 * m..]
    let b0 = b[..m]
    let b1 = b[m..2 * m]
    let b2 = b[2 * m..]
    let v0 = f2_mul(c, a0, b0)
    let v1 = f2_mul(c, a1, b1)
    let v2 = f2_mul(c, a2, b2)
    let t12 = f2_mul(c, f2_add(c, a1, a2), f2_add(c, b1, b2))
    let t01 = f2_mul(c, f2_add(c, a0, a1), f2_add(c, b0, b1))
    let t02 = f2_mul(c, f2_add(c, a0, a2), f2_add(c, b0, b2))
    let c0 = f2_add(c, v0, f2_mul_xi(c, f2_sub(c, f2_sub(c, t12, v1), v2)))
    let c1 = f2_add(c, f2_sub(c, f2_sub(c, t01, v0), v1), f2_mul_xi(c, v2))
    let c2 = f2_add(c, f2_sub(c, f2_sub(c, t02, v0), v2), v1)
    f6_new(c, c0, c1, c2)
}

fn f6_mul_v(c: *Curve, a: []u64) -> []u64 {
    let m = 2 * c.n
    f6_new(c, f2_mul_xi(c, a[2 * m..]), a[..m], a[m..2 * m])
}

fn f6_inv(c: *Curve, a: []u64) -> []u64 {
    let m = 2 * c.n
    let a0 = a[..m]
    let a1 = a[m..2 * m]
    let a2 = a[2 * m..]
    let t0 = f2_sub(c, f2_sqr(c, a0), f2_mul_xi(c, f2_mul(c, a1, a2)))
    let t1 = f2_sub(c, f2_mul_xi(c, f2_sqr(c, a2)), f2_mul(c, a0, a1))
    let t2 = f2_sub(c, f2_sqr(c, a1), f2_mul(c, a0, a2))
    let inner = f2_add(c, f2_mul(c, a2, t1), f2_mul(c, a1, t2))
    let den = f2_add(c, f2_mul(c, a0, t0), f2_mul_xi(c, inner))
    let inverse = f2_inv(c, den)
    f6_new(c, f2_mul(c, t0, inverse), f2_mul(c, t1, inverse), f2_mul(c, t2, inverse))
}

fn f12_new(c: *Curve, d0: []u64, d1: []u64) -> []u64 {
    let k = 6 * c.n
    let out: []u64 = __make(12 * c.n)
    __memmove(out, d0)
    __memmove(out[k..], d1)
    out
}

fn f12_one(c: *Curve) -> []u64 {
    let out: []u64 = __make(12 * c.n)
    __memmove(out, c.q.one)
    out
}

fn f12_is_one(c: *Curve, a: []u64) -> bool {
    limb.equal(a, f12_one(c))
}

fn f12_mul(c: *Curve, a: []u64, b: []u64) -> []u64 {
    let k = 6 * c.n
    let a0 = a[..k]
    let a1 = a[k..]
    let b0 = b[..k]
    let b1 = b[k..]
    let v0 = f6_mul(c, a0, b0)
    let v1 = f6_mul(c, a1, b1)
    let cross = f6_mul(c, f6_add(c, a0, a1), f6_add(c, b0, b1))
    let d0 = f6_add(c, v0, f6_mul_v(c, v1))
    let d1 = f6_sub(c, f6_sub(c, cross, v0), v1)
    f12_new(c, d0, d1)
}

fn f12_sqr(c: *Curve, a: []u64) -> []u64 {
    let k = 6 * c.n
    let a0 = a[..k]
    let a1 = a[k..]
    let ab = f6_mul(c, a0, a1)
    let sum = f6_add(c, a0, a1)
    let shifted = f6_add(c, a0, f6_mul_v(c, a1))
    let product = f6_mul(c, sum, shifted)
    let d0 = f6_sub(c, f6_sub(c, product, ab), f6_mul_v(c, ab))
    f12_new(c, d0, f6_add(c, ab, ab))
}

fn f12_conj(c: *Curve, a: []u64) -> []u64 {
    let k = 6 * c.n
    f12_new(c, a[..k], f6_neg(c, a[k..]))
}

fn f12_inv(c: *Curve, a: []u64) -> []u64 {
    let k = 6 * c.n
    let a0 = a[..k]
    let a1 = a[k..]
    let norm = f6_sub(c, f6_mul(c, a0, a0), f6_mul_v(c, f6_mul(c, a1, a1)))
    let inverse = f6_inv(c, norm)
    f12_new(c, f6_mul(c, a0, inverse), f6_neg(c, f6_mul(c, a1, inverse)))
}

fn f12_power_of_w(slot: i64) -> i64 {
    match slot {
        0 => 0
        1 => 2
        2 => 4
        3 => 1
        4 => 3
        _ => 5
    }
}

fn f12_frobenius(c: *Curve, a: []u64, times: i64) -> []u64 {
    let m = 2 * c.n
    let out: []u64 = __make(12 * c.n)
    for slot in 0..6 {
        let part = a[slot * m..(slot + 1) * m]
        let power = f12_power_of_w(slot)
        let image = if times == 1 {
            f2_mul(c, f2_conj(c, part), c.gamma1[power])
        } else {
            f2_mul(c, part, c.gamma2[power])
        }
        __memmove(out[slot * m..], image)
    }
    out
}

fn f12_pow(c: *Curve, a: []u64, e: []u64) -> []u64 {
    let top = bit_length(e)
    var out = f12_one(c)
    var i = top - 1
    for i >= 0 {
        out = f12_sqr(c, out)
        if bit_at(e, i) == 1 {
            out = f12_mul(c, out, a)
        }
        i -= 1
    }
    out
}
