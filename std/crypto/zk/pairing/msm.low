fn window_size(count: i64) -> i64 {
    if count < 4 {
        return 1
    }
    if count < 32 {
        return 3
    }
    let bits = bit_length([u64(count)])
    if bits < 7 { 3 } else { bits - 4 }
}

fn digit(scalar: []u8, from: i64, width: i64) -> i64 {
    var out = 0
    for k in 0..width {
        let position = from + k
        let byte = position / 8
        if byte < scalar.len {
            let bit = (scalar[scalar.len - 1 - byte] >> (position % 8)) & 1
            out |= i64(bit) << k
        }
    }
    out
}

/// Returns the sum of `scalars[i] * points[i]`, with the bucket method of Pippenger.
///
/// Each scalar is big-endian and of any length; a zero scalar costs nothing. The running time and the memory accesses depend on the scalars, so use it only for public scalars, such as the verification of a proof or a commitment to public polynomial values. Use `scalar_mul` for secret ones. `points` and `scalars` must have the same length.
pub fn msm(g: *Group, points: []Point, scalars: [][]u8) -> Point {
    var kept_points: []Point = []
    var kept_scalars: [][]u8 = []
    for i in 0..points.len {
        let trimmed = trim_leading_zeros(scalars[i])
        if trimmed.len > 0 {
            push(mut kept_points, points[i])
            push(mut kept_scalars, trimmed)
        }
    }
    bucket_sum(g, kept_points, kept_scalars)
}

fn trim_leading_zeros(scalar: []u8) -> []u8 {
    var start = 0
    for start < scalar.len && scalar[start] == 0 {
        start += 1
    }
    scalar[start..]
}

fn bucket_sum(g: *Group, points: []Point, scalars: [][]u8) -> Point {
    var longest = 0
    for s in scalars {
        if s.len > longest {
            longest = s.len
        }
    }
    let count = points.len
    if count == 0 || longest == 0 {
        return identity(g)
    }
    let width = window_size(count)
    let windows = (longest * 8 + width - 1) / width
    let size = (1 << width) - 1
    var acc = identity(g)
    var w = windows - 1
    for w >= 0 {
        for _ in 0..width {
            acc = double(g, acc)
        }
        var buckets: []Point = []
        for _ in 0..size {
            push(mut buckets, identity(g))
        }
        for i in 0..count {
            let d = digit(scalars[i], w * width, width)
            if d != 0 {
                buckets[d - 1] = add(g, buckets[d - 1], points[i])
            }
        }
        var running = identity(g)
        var sum = identity(g)
        var j = size - 1
        for j >= 0 {
            running = add(g, running, buckets[j])
            sum = add(g, sum, running)
            j -= 1
        }
        acc = add(g, acc, sum)
        w -= 1
    }
    acc
}

/// Returns the sum of `scalars[i] * points[i]` as the sum of `scalar_mul` of each pair.
///
/// The running time and the memory accesses depend on the number of points and the lengths of the scalars, not on their values, so the scalars may be secret. It is slower than `msm`. `points` and `scalars` must have the same length.
pub fn msm_secret(g: *Group, points: []Point, scalars: [][]u8) -> Point {
    var acc = identity(g)
    for i in 0..points.len {
        acc = add(g, acc, scalar_mul(g, points[i], scalars[i]))
    }
    acc
}
