import std/crypto/zk/groth16
import std/crypto/zk/pairing

fn cubic(c: *pairing.Curve) -> *groth16.R1cs {
    let r = groth16.r1cs(c, 1)
    let x = groth16.allocate(r)
    let square = groth16.product(r, groth16.wire(c, x), groth16.wire(c, x))
    let cube = groth16.product(r, groth16.wire(c, square), groth16.wire(c, x))
    let total = groth16.sum(groth16.sum(groth16.wire(c, cube), groth16.wire(c, x)), groth16.constant(c, 5))
    groth16.enforce(r, total, groth16.constant(c, 1), groth16.wire(c, 1))
    r
}

fn witness(c: *pairing.Curve, x: u64) -> [][]u64 {
    let value = pairing.fr_from_u64(c, x)
    let square = pairing.fr_mul(c, value, value)
    let cube = pairing.fr_mul(c, square, value)
    let y = pairing.fr_add(c, pairing.fr_add(c, cube, value), pairing.fr_from_u64(c, 5))
    [pairing.fr_one(c), y, value, square, cube]
}

fn attempt(key: groth16.ProvingKey, r: *groth16.R1cs, w: [][]u64) -> str {
    let proof = groth16.prove(key, r, w) catch {
        Unsatisfied => return "refused, the witness does not satisfy the constraints"
        _ => return "failed"
    }
    "proved"
}

fn show(c: *pairing.Curve, name: str) ! groth16.Error {
    let r = cubic(c)
    let w = witness(c, 3)
    print("{name}: {r.constraints.len} constraints, {r.wires} wires, x = 3 gives y = {pairing.fr_limbs(c, w[1])[0]}")

    let keys = groth16.setup(r)?
    let proof = groth16.prove(keys.proving, r, w)?
    let public = [w[1]]
    print("  proof of y = 35: {groth16.verify(keys.verifying, public, proof)}")
    print("  the same proof for y = 36: {groth16.verify(keys.verifying, [pairing.fr_from_u64(c, 36)], proof)}")

    let bytes_form = groth16.proof_to_bytes(c, proof)
    let decoded = groth16.proof_from_bytes(c, bytes_form)?
    print("  proof of {bytes_form.len} bytes decodes and verifies: {groth16.verify(keys.verifying, public, decoded)}")

    let json = groth16.proof_to_json(c, proof)
    let from_json = groth16.proof_from_json(c, json)?
    print("  snarkjs JSON round trip verifies: {groth16.verify(keys.verifying, public, from_json)}")

    let wrong = witness(c, 4)
    print("  {attempt(keys.proving, r, [wrong[0], w[1], wrong[2], wrong[3], wrong[4]])}")
}

fn main() ! groth16.Error {
    show(pairing.bn254(), "BN254")?
    show(pairing.bls12_381(), "BLS12-381")?
}
