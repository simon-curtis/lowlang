import std/crypto/zk/pairing

/// The reason a Groth16 operation, key, proof or circuit file was rejected.
pub enum Error {
    /// A file or encoding ends before its declared contents, or has bytes left over.
    Truncated
    /// A file does not start with the magic bytes of its format.
    Magic
    /// A file has a version, section or feature this module does not read.
    Unsupported
    /// A file is for a different scalar field than the curve.
    Prime
    /// A file or document is inconsistent: a wire out of range, a missing member or a malformed number.
    Malformed
    /// A point or field element failed its checks.
    Point(error: pairing.Error)
    /// The witness does not satisfy the constraints.
    Unsatisfied
    /// The circuit needs a domain larger than the scalar field has roots of unity for.
    Size
    /// The number of public inputs does not match the circuit.
    Inputs
}

/// One term `coeff * wire` of a linear combination. `coeff` is an element of `Fr`.
pub struct Term {
    /// The index of the wire; wire 0 is the constant 1.
    pub wire: i64
    /// The coefficient, an element of `Fr` in Montgomery form.
    pub coeff: []u64
}

/// One rank-1 constraint `a * b = c` between three linear combinations of the wires.
pub struct Constraint {
    /// The left linear combination.
    pub a: []Term
    /// The right linear combination.
    pub b: []Term
    /// The linear combination the product must equal.
    pub c: []Term
}

/// A rank-1 constraint system over the scalar field of a curve.
///
/// Wire 0 is the constant 1, wires `1` to `public` are the public inputs and outputs, and the rest are private. A witness is the list of the values of all wires.
pub struct R1cs {
    /// The curve whose `Fr` the coefficients and witness values belong to.
    pub curve: *pairing.Curve
    /// The number of wires, including the constant wire and the public ones.
    pub wires: i64
    /// The number of public wires, not counting the constant wire.
    pub public: i64
    /// The constraints, in order.
    pub constraints: []Constraint
}

/// Returns an empty system with `public` public wires and no private ones.
pub fn r1cs(c: *pairing.Curve, public: i64) -> *R1cs {
    new(R1cs { curve: c, wires: public + 1, public, constraints: [] })
}

/// Adds a private wire to `r` and returns its index.
pub fn allocate(r: *R1cs) -> i64 {
    let index = r.wires
    r.wires += 1
    index
}

/// Returns the linear combination of the single wire `index`.
pub fn wire(c: *pairing.Curve, index: i64) -> []Term {
    [Term { wire: index, coeff: pairing.fr_one(c) }]
}

/// Returns the linear combination that is the constant `value`.
pub fn constant(c: *pairing.Curve, value: u64) -> []Term {
    [Term { wire: 0, coeff: pairing.fr_from_u64(c, value) }]
}

/// Returns the linear combination `x + y`.
pub fn sum(x: []Term, y: []Term) -> []Term {
    var out: []Term = []
    for t in x {
        push(mut out, t)
    }
    for t in y {
        push(mut out, t)
    }
    out
}

/// Returns the linear combination `k * x` for the element `k` of `Fr`.
pub fn scale(c: *pairing.Curve, x: []Term, k: []u64) -> []Term {
    var out: []Term = []
    for t in x {
        push(mut out, Term { wire: t.wire, coeff: pairing.fr_mul(c, t.coeff, k) })
    }
    out
}

/// Adds the constraint `a * b = c` to `r`.
pub fn enforce(r: *R1cs, a: []Term, b: []Term, c: []Term) {
    push(mut r.constraints, Constraint { a, b, c })
}

/// Adds a private wire `z` and the constraint `x * y = z`, and returns the index of `z`.
pub fn product(r: *R1cs, x: []Term, y: []Term) -> i64 {
    let z = allocate(r)
    enforce(r, x, y, wire(r.curve, z))
    z
}

/// Returns the value of the linear combination `x` under the witness.
pub fn evaluate(c: *pairing.Curve, x: []Term, witness: [][]u64) -> []u64 {
    var acc = pairing.fr_zero(c)
    for t in x {
        acc = pairing.fr_add(c, acc, pairing.fr_mul(c, t.coeff, witness[t.wire]))
    }
    acc
}

/// Returns whether the witness has `r.wires` values, starts with 1, and satisfies every constraint.
pub fn satisfied(r: *R1cs, witness: [][]u64) -> bool {
    let c = r.curve
    if witness.len != r.wires || !pairing.fr_equal(witness[0], pairing.fr_one(c)) {
        return false
    }
    for k in r.constraints {
        let left = evaluate(c, k.a, witness)
        let right = evaluate(c, k.b, witness)
        let expected = evaluate(c, k.c, witness)
        if !pairing.fr_equal(pairing.fr_mul(c, left, right), expected) {
            return false
        }
    }
    true
}
