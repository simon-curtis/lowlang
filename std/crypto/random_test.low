import std/io
import std/sync
import std/testing
import std/text

fn hex(s: str) -> u8[] {
    text.decode_hex(s) or []
}

fn known_key() -> u8[] {
    hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
}

fn known_stream() -> u8[] {
    hex("")
}

fn seed_state(key: u8[], refills: i64) {
    let words = state_words()
    let cipher = state_cipher()
    let bytes = state_bytes()
    __lock(mut words[lock_word])
    for i in 0..8 {
        cipher[key_word + i] = io.u32_le(key, 4 * i)
    }
    erase(bytes, buffer_at, buffer_size)
    words[pos_word] = buffer_size
    words[guard_word] = -1
    words[pid_word] = process_id()
    words[refills_word] = refills
    __unlock(mut words[lock_word])
}

fn state_key() -> u8[] {
    let cipher = state_cipher()
    let copy = io.buffer(key_size)
    for i in 0..8 {
        io.set_le32(copy, 4 * i, i64(cipher[key_word + i]))
    }
    copy
}

fn buffer_copy(from: i64, n: i64) -> u8[] {
    let copy = io.buffer(n)
    __memmove(copy, state_bytes()[buffer_at + from..buffer_at + from + n])
    copy
}

fn all_zero(b: u8[]) -> bool {
    for x in b {
        if x != 0 {
            return false
        }
    }
    true
}

fn test_a_request_serves_the_first_block_after_the_next_key(t: *testing.T) {
    seed_state(known_key(), reseed_after)
    let out = io.buffer(100)
    t.is_true(take(out))
    t.equal_slice(out, known_stream()[32..132])
    t.equal_slice(state_key(), known_stream()[..32])
    t.equal(state_words()[pos_word], 132)
    t.equal(state_words()[refills_word], reseed_after - 1)
}

fn test_unread_keystream_stays_in_the_buffer(t: *testing.T) {
    seed_state(known_key(), reseed_after)
    let out = io.buffer(100)
    t.is_true(take(out))
    t.equal_slice(buffer_copy(132, 124), known_stream()[132..256])
}

fn test_consumed_bytes_and_the_old_key_are_erased(t: *testing.T) {
    seed_state(known_key(), reseed_after)
    let out = io.buffer(100)
    t.is_true(take(out))
    t.is_true(all_zero(buffer_copy(0, 132)))
    let bytes = text.encode_hex(state_bytes())
    t.is_false(text.contains(bytes, text.encode_hex(known_key())))
}

fn test_the_state_holds_no_returned_bytes(t: *testing.T) {
    let out = random(64)
    let state = text.encode_hex(state_bytes())
    for at in 0..57 {
        t.is_false(text.contains(state, text.encode_hex(out[at..at + 8])))
    }
}

fn test_consecutive_requests_continue_the_buffer(t: *testing.T) {
    seed_state(known_key(), reseed_after)
    let first = io.buffer(40)
    let second = io.buffer(40)
    t.is_true(take(first))
    t.is_true(take(second))
    t.equal_slice(first, known_stream()[32..72])
    t.equal_slice(second, known_stream()[72..112])
    t.equal(state_words()[refills_word], reseed_after - 1)
}

fn test_a_request_across_a_refill_takes_the_next_key_each_time(t: *testing.T) {
    seed_state(known_key(), reseed_after)
    let out = io.buffer(buffer_size - key_size + 10)
    t.is_true(take(out))
    t.equal_slice(out[..224], known_stream()[32..256])
    t.equal(state_words()[refills_word], reseed_after - 2)
    t.equal(state_words()[pos_word], key_size + 10)
    t.is_false(text.encode_hex(state_key()) == text.encode_hex(known_stream()[..32]))
}

fn test_spent_refills_reseed_from_the_operating_system(t: *testing.T) {
    seed_state(known_key(), 1)
    let out = io.buffer(buffer_size)
    t.is_false(take(out))
    draw(out)
    t.not_equal(text.encode_hex(out[..32]), text.encode_hex(known_stream()[32..64]))
    t.is_true(state_words()[refills_word] > 0)
}

fn test_another_process_id_reseeds_from_the_operating_system(t: *testing.T) {
    seed_state(known_key(), reseed_after)
    state_words()[pid_word] = process_id() + 1
    let out = io.buffer(20)
    t.is_false(take(out))
    draw(out)
    t.not_equal(text.encode_hex(out), text.encode_hex(known_stream()[32..52]))
    t.equal(state_words()[pid_word], process_id())
}

fn test_a_cleared_fork_marker_reseeds_from_the_operating_system(t: *testing.T) {
    let first = random(16)
    t.equal(first.len, 16)
    let guard = state_words()[guard_word]
    if guard < 0 {
        t.skip("the target has no fork marker")
        return
    }
    let marker: ptr[i64] = ptr(guard)
    store(marker, 0)
    let out = io.buffer(16)
    t.is_false(take(out))
    draw(out)
    t.equal(load(marker), 1)
    t.is_true(take(out))
}

fn test_a_fresh_process_seeds_on_the_first_request(t: *testing.T) {
    let out = random(16)
    t.equal(out.len, 16)
    t.is_true(state_words()[refills_word] > 0)
}

fn test_lengths(t: *testing.T) {
    for n in [0, 1, 15, 16, 17, 31, 32, 33, 63, 64, 65, 735, 736, 737, 4095, 4096, 4097, 8192, 10000] {
        t.equal(random(n).len, n)
    }
}

fn test_chunks_cross_the_reseed_budget(t: *testing.T) {
    seed_state(known_key(), 10)
    let out = random(12000)
    t.equal(out.len, 12000)
    t.is_true(state_words()[refills_word] > 0)
}

fn test_outputs_differ(t: *testing.T) {
    var seen: [str: bool] = [:]
    for _ in 0..200 {
        let key = text.encode_hex(random(16))
        t.is_false(seen[key] ?? false)
        seen[key] = true
    }
}

fn test_no_long_zero_runs(t: *testing.T) {
    let out = random(65536)
    var zeros = 0
    for b in out {
        if b == 0 {
            zeros += 1
        }
    }
    t.is_true(zeros > 65536 / 256 / 2)
    t.is_true(zeros < 65536 / 256 * 2)
}

fn draw_many(count: i64, out: chan[str], group: sync.WaitGroup) {
    for _ in 0..count {
        out <- text.encode_hex(random(16))
    }
    group.done()
}

fn test_concurrent_green_threads_draw_distinct_bytes(t: *testing.T) {
    let out = chan[str](4096)
    let group = sync.wait_group()
    let threads = 16
    let each = 250
    for _ in 0..threads {
        group.add(1)
        spawn draw_many(each, out, group)
    }
    group.wait()
    close(out)
    var seen: [str: bool] = [:]
    var total = 0
    for item in out {
        t.is_false(seen[item] ?? false)
        seen[item] = true
        total += 1
    }
    t.equal(total, threads * each)
}

fn test_concurrent_requests_across_the_reseed_budget(t: *testing.T) {
    seed_state(known_key(), 30)
    let out = chan[str](4096)
    let group = sync.wait_group()
    for _ in 0..8 {
        group.add(1)
        spawn draw_many(200, out, group)
    }
    group.wait()
    close(out)
    var seen: [str: bool] = [:]
    var total = 0
    for item in out {
        t.is_false(seen[item] ?? false)
        seen[item] = true
        total += 1
    }
    t.equal(total, 1600)
    t.is_true(state_words()[refills_word] > 0)
}
