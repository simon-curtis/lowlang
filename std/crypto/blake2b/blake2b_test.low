import std/testing
import std/text

fn digest_hex(options: Options, data: u8[]) -> str {
    text.encode_hex(sum(options, data) or [])
}

fn test_abc(t: *testing.T) {
    t.equal(digest_hex(Options {}, bytes("abc")), "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923")
}

fn test_empty(t: *testing.T) {
    t.equal(digest_hex(Options {}, []), "786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce")
}

fn test_keyed(t: *testing.T) {
    var key: u8[] = []
    for i in 0..64 {
        key.push(u8(i))
    }
    t.equal(digest_hex(Options { key }, []), "10ebb67700b1868efb4417987acf4690ae9d972fb7a590c2f02871799aaa4786b5e996e8f0f4eb981fc214b005f42d2ff4233499391653df7aefcbc13fc51568")
}

fn test_split_updates_match_one_update(t: *testing.T) {
    var data: u8[] = []
    for i in 0..300 {
        data.push(u8(i * 7 + 3))
    }
    let whole = sum(Options {}, data) or []
    for cut in [0, 1, 127, 128, 129, 256, 300] {
        let h = hasher(Options {}) or panic("options")
        update(h, data[..cut])
        update(h, data[cut..])
        t.equal(text.encode_hex(finalize(h)), text.encode_hex(whole))
    }
}

fn test_finalize_keeps_absorbing(t: *testing.T) {
    let h = hasher(Options {}) or panic("options")
    update(h, bytes("ab"))
    let first = finalize(h)
    update(h, bytes("c"))
    t.equal(text.encode_hex(finalize(h)), digest_hex(Options {}, bytes("abc")))
    t.is_true(text.encode_hex(first) != digest_hex(Options {}, bytes("abc")))
}

fn test_salt(t: *testing.T) {
    t.equal(digest_hex(Options { salt: bytes("0123456789abcdef") }, bytes("abc")), "c6104a4b90a13393da2bb00c06b0acf57a31cf55da241aa4d7661f9daec31f40ad0a21ab8e077647680f08bd36d45cd71b395b65d46337dce570d20c0b00b55b")
}

fn counting(n: i64) -> u8[] {
    var out: u8[] = []
    for i in 0..n {
        out.push(u8(i))
    }
    out
}

fn test_keyed_over_several_blocks(t: *testing.T) {
    var key: u8[] = []
    for _ in 0..64 {
        key.push('k')
    }
    var data: u8[] = []
    for _ in 0..3 {
        for b in counting(256) {
            data.push(b)
        }
    }
    t.equal(digest_hex(Options { size: 32, key }, data), "0fe7aa3ec6a7b76a5d54f6c1c8c41d49d0f28df29ba02429b85c03503dc70dd5")
}

fn test_exactly_one_block(t: *testing.T) {
    t.equal(digest_hex(Options { size: 20 }, counting(128)), "e6992372ab022447b34f6d6032fbab707a11adef")
}

fn refusal(options: Options) -> str {
    let h = hasher(options) catch {
        e => return "{e}"
    }
    "accepted {finalize(h).len}"
}

fn test_rejects_sizes_keys_and_parameters(t: *testing.T) {
    t.equal(refusal(Options { size: 0 }), "Size")
    t.equal(refusal(Options { size: 65 }), "Size")
    t.equal(refusal(Options { key: counting(65) }), "Key")
    t.equal(refusal(Options { salt: counting(17) }), "Parameter")
    t.equal(refusal(Options { personal: counting(17) }), "Parameter")
    t.equal(refusal(Options { size: 1, key: counting(64), salt: counting(16), personal: counting(16) }), "accepted 1")
}
