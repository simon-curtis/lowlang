import std/crypto/blake2b
import std/text

fn outcome(options: blake2b.Options) -> str {
    let h = blake2b.hasher(options) catch {
        e => return "refused with {e}"
    }
    "a {blake2b.finalize(h).len}-byte digest"
}

/// Hashes with BLAKE2b at two digest sizes and with a key, absorbs a message in pieces, and shows the parameter checks.
fn main() {
    let full = blake2b.sum(blake2b.Options {}, bytes("abc")) or []
    print("blake2b-512 {text.encode_hex(full[..16])}")
    let short = blake2b.sum(blake2b.Options { size: 32 }, bytes("abc")) or []
    print("blake2b-256 {text.encode_hex(short)}")
    let keyed = blake2b.sum(blake2b.Options { size: 32, key: bytes("secret key") }, bytes("abc")) or []
    print("keyed differs: {text.encode_hex(keyed) != text.encode_hex(short)}")

    let h = blake2b.hasher(blake2b.Options { size: 32 }) or panic("options")
    blake2b.update(h, bytes("a"))
    let prefix = blake2b.finalize(h)
    blake2b.update(h, bytes("bc"))
    print("pieces match: {text.encode_hex(blake2b.finalize(h)) == text.encode_hex(short)}")
    print("prefix differs: {text.encode_hex(prefix) != text.encode_hex(short)}")

    print("size 65: {outcome(blake2b.Options { size: 65 })}")
    print("17-byte salt: {outcome(blake2b.Options { salt: bytes("seventeen bytes!!") })}")
}
