import std/io
import std/sys

fn fill(n: i64) -> u8[] ! io.Error {
    sys.random_bytes(n)
}

fn fork_guard() -> i64 {
    sys.map_fork_marker() catch {
        _ => -1
    }
}

fn fork_release(page: i64) {
    if page > 0 {
        sys.unmap(page, 4096)
    }
}

fn process_id() -> i64 {
    sys.pid()
}
