import std/crypto/hash
import std/crypto/mlkem
import std/crypto/sha3
import std/crypto/x25519
import std/io
import std/text

const hybrid_id = 0x647a

struct Expanded {
    decapsulation: u8[]
    encapsulation: u8[]
    x25519_private: u8[]
    x25519_public: u8[]
}

fn shake256(data: u8[], length: i64) -> u8[] {
    let sponge = sha3.shake256()
    sha3.absorb(sponge, data)
    sha3.squeeze(sponge, length)
}

fn x25519_secret(private: u8[], public: u8[]) -> u8[] {
    x25519.shared(private, public) or io.buffer(32)
}

fn hybrid_expand(seed: u8[]) -> Expanded {
    let expanded = shake256(seed, 96)
    let keys = mlkem.generate_seeded(Kem768, expanded[..32], expanded[32..64])
    let x25519_private = expanded[64..]
    let x25519_public = x25519.public_key(x25519_private)
    Expanded { decapsulation: keys.decapsulation, encapsulation: keys.encapsulation, x25519_private, x25519_public }
}

fn hybrid_key_pair(seed: u8[]) -> KeyPair {
    let expanded = hybrid_expand(seed)
    var public: u8[] = []
    io.append(mut public, expanded.encapsulation)
    io.append(mut public, expanded.x25519_public)
    KeyPair { private: seed, public }
}

fn hybrid_derive_key_pair(ikm: u8[]) -> KeyPair {
    var labeled: u8[] = []
    io.append(mut labeled, ikm)
    text.append(mut labeled, "HPKE-v1")
    io.append(mut labeled, kem_suite_id(hybrid_id))
    io.put_be(mut labeled, 13, 2)
    text.append(mut labeled, "DeriveKeyPair")
    io.put_be(mut labeled, 32, 2)
    hybrid_key_pair(shake256(labeled, 32))
}

fn hybrid_combine(shared_mlkem: u8[], shared_x25519: u8[], ciphertext_x25519: u8[], public_x25519: u8[]) -> u8[] {
    let label: u8[] = [0x5c, 0x2e, 0x2f, 0x2f, 0x5e, 0x5c]
    var input: u8[] = []
    io.append(mut input, shared_mlkem)
    io.append(mut input, shared_x25519)
    io.append(mut input, ciphertext_x25519)
    io.append(mut input, public_x25519)
    io.append(mut input, label)
    let algorithm = sha3.sha3_256()
    hash.sum(algorithm, input)
}

fn hybrid_encap(recipient_public: u8[], randomness: u8[]) -> Encapsulated ! Error {
    let public_mlkem = recipient_public[..1184]
    let public_x25519 = recipient_public[1184..]
    let sealed = mlkem.encapsulate_seeded(Kem768, public_mlkem, randomness[..32]) catch { _ => fail Error.Encap }
    let ephemeral = randomness[32..]
    let ciphertext_x25519 = x25519.public_key(ephemeral)
    let shared_x25519 = x25519_secret(ephemeral, public_x25519)
    var enc: u8[] = []
    io.append(mut enc, sealed.ciphertext)
    io.append(mut enc, ciphertext_x25519)
    let shared = hybrid_combine(sealed.shared, shared_x25519, ciphertext_x25519, public_x25519)
    Encapsulated { shared, enc }
}

fn hybrid_decap(enc: u8[], seed: u8[]) -> u8[] ! Error {
    let expanded = hybrid_expand(seed)
    let ciphertext_x25519 = enc[1088..]
    let shared_mlkem = mlkem.decapsulate(Kem768, expanded.decapsulation, enc[..1088]) catch { _ => fail Error.Decap }
    let shared_x25519 = x25519_secret(expanded.x25519_private, ciphertext_x25519)
    hybrid_combine(shared_mlkem, shared_x25519, ciphertext_x25519, expanded.x25519_public)
}
