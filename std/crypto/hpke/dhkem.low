import std/crypto/x25519
import std/io

const dhkem_id = 0x0020

fn dhkem_derive_key_pair(ikm: []u8) -> KeyPair {
    let id = kem_suite_id(dhkem_id)
    let prk = labeled_extract(id, [], "dkp_prk", ikm)
    let private = labeled_expand(id, prk, "sk", [], 32)
    KeyPair { private, public: x25519.public_key(private) }
}

fn dhkem_shared_secret(dh: []u8, kem_context: []u8) -> []u8 {
    let id = kem_suite_id(dhkem_id)
    let prk = labeled_extract(id, [], "eae_prk", dh)
    labeled_expand(id, prk, "shared_secret", kem_context, 32)
}

fn dhkem_encap(recipient_public: []u8, ikm_e: []u8, sender_private: []u8) -> Encapsulated ! Error {
    let ephemeral = dhkem_derive_key_pair(ikm_e)
    var dh: []u8 = []
    let ephemeral_dh = x25519.shared(ephemeral.private, recipient_public) catch { _ => fail Error.Encap }
    io.append(mut dh, ephemeral_dh)
    var kem_context: []u8 = []
    io.append(mut kem_context, ephemeral.public)
    io.append(mut kem_context, recipient_public)
    if sender_private.len > 0 {
        let static_dh = x25519.shared(sender_private, recipient_public) catch { _ => fail Error.Encap }
        let sender_public = x25519.public_key(sender_private)
        io.append(mut dh, static_dh)
        io.append(mut kem_context, sender_public)
    }
    let shared = dhkem_shared_secret(dh, kem_context)
    Encapsulated { shared, enc: ephemeral.public }
}

fn dhkem_decap(enc: []u8, recipient_private: []u8, sender_public: []u8) -> []u8 ! Error {
    var dh: []u8 = []
    let ephemeral_dh = x25519.shared(recipient_private, enc) catch { _ => fail Error.Decap }
    io.append(mut dh, ephemeral_dh)
    var kem_context: []u8 = []
    let recipient_public = x25519.public_key(recipient_private)
    io.append(mut kem_context, enc)
    io.append(mut kem_context, recipient_public)
    if sender_public.len > 0 {
        let static_dh = x25519.shared(recipient_private, sender_public) catch { _ => fail Error.Decap }
        io.append(mut dh, static_dh)
        io.append(mut kem_context, sender_public)
    }
    dhkem_shared_secret(dh, kem_context)
}
