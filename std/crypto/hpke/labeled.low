import std/crypto/hash
import std/io
import std/text

fn kem_suite_id(kem_id: i64) -> u8[] {
    var id: u8[] = []
    text.append(mut id, "KEM")
    io.put_be(mut id, kem_id, 2)
    id
}

fn labeled_extract(suite_id: u8[], salt: u8[], label: str, ikm: u8[]) -> u8[] {
    var labeled: u8[] = []
    text.append(mut labeled, "HPKE-v1")
    io.append(mut labeled, suite_id)
    text.append(mut labeled, label)
    io.append(mut labeled, ikm)
    hash.hkdf_extract(hash.sha256(), salt, labeled)
}

fn labeled_expand(suite_id: u8[], prk: u8[], label: str, info: u8[], length: i64) -> u8[] {
    var labeled: u8[] = []
    io.put_be(mut labeled, length, 2)
    text.append(mut labeled, "HPKE-v1")
    io.append(mut labeled, suite_id)
    text.append(mut labeled, label)
    io.append(mut labeled, info)
    hash.hkdf_expand(hash.sha256(), prk, labeled, length)
}
