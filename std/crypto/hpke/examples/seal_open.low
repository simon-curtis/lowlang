import std/crypto/hpke
import std/text

fn unhex(s: str) -> []u8 {
    text.decode_hex(s) or []
}

fn deterministic() ! hpke.Error {
    let suite = hpke.Suite { kem: hpke.Kem.DhkemX25519, aead: hpke.AeadId.ChaCha20Poly1305 }
    let info = bytes("Ode on a Grecian Urn")
    let aad = bytes("Count-0")
    let message = bytes("Beauty is truth, truth beauty")

    let recipient = hpke.derive_key_pair(suite.kem, unhex("1ac01f181fdf9f352797655161c58b75c656a6cc2716dcb66372da835542e1df"))?
    print("recipient public {text.encode_hex(recipient.public)}")

    let ephemeral = unhex("909a9b35d3dc4713a5e72a4da274b55d3d3821a37e5d099e74a647db583a904b")
    let sender = hpke.setup_sender_seeded(suite, recipient.public, info, hpke.base(), ephemeral)?
    print("enc {text.encode_hex(sender.enc)}")
    let sealed = hpke.seal(sender.context, aad, message)?
    print("ciphertext {text.encode_hex(sealed)}")
    print("sender export {text.encode_hex(hpke.export(sender.context, [], 32)?)}")

    let receiver = hpke.setup_recipient(suite, sender.enc, recipient.private, info, hpke.base())?
    let opened = hpke.open(receiver, aad, sealed)?
    print("opened {str(opened)}")
    print("recipient export {text.encode_hex(hpke.export(receiver, [], 32)?)}")

    let replay = hpke.open(receiver, aad, sealed) or bytes("rejected")
    print("second open of the same message: {str(replay)}")
}

fn hybrid() ! hpke.Error {
    let suite = hpke.Suite { kem: hpke.Kem.Mlkem768X25519, aead: hpke.AeadId.Aes256Gcm }
    let recipient = hpke.generate_key_pair(suite.kem)
    print("hybrid public key {recipient.public.len} bytes, private key {recipient.private.len} bytes")

    let psk = bytes("0123456789abcdef0123456789abcdef")
    let credentials = hpke.psk(psk, bytes("key one"))
    let sealed = hpke.seal_single(suite, recipient.public, bytes("hybrid"), credentials, [], bytes("post-quantum hello"))?
    print("enc {sealed.enc.len} bytes, ciphertext {sealed.ciphertext.len} bytes")
    let opened = hpke.open_single(suite, sealed.enc, recipient.private, bytes("hybrid"), credentials, [], sealed.ciphertext)?
    print("opened {str(opened)}")

    let key = bytes("0123456789abcdef0123456789abcdef")
    print("authenticated mode: {authenticated(suite, recipient.public, key)}")
}

fn authenticated(suite: hpke.Suite, public: []u8, sender_key: []u8) -> str {
    hpke.seal_single(suite, public, [], hpke.auth(sender_key), [], bytes("x")) catch {
        Unsupported => return "unsupported"
        _ => return "failed"
    }
    "accepted"
}

/// Seals a message to a DHKEM(X25519) recipient with ChaCha20-Poly1305 using the inputs of RFC 9180 appendix A.2, so the printed `enc` and ciphertext are the RFC's, then opens it, exports a secret from both contexts and shows that a message opens once. Then runs the post-quantum MLKEM768-X25519 suite with a pre-shared key and shows that it refuses the authenticated modes.
fn main() ! hpke.Error {
    deterministic()?
    hybrid()?
}
