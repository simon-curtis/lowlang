import std/testing
import std/text

struct ScheduleCase {
    label: str
    kem: Kem
    aead: AeadId
    info: str
    ikm_r: str
    ikm_e: str
    ikm_s: str
    psk: str
    psk_id: str
    shared_secret: str
    key: str
    base_nonce: str
    exporter_secret: str
}

fn hex(s: str) -> []u8 {
    text.decode_hex(s) or []
}

fn case_name(c: ScheduleCase) -> str {
    c.label
}

fn credentials_of(c: ScheduleCase, sender_key: []u8) -> Credentials {
    auth_psk(sender_key, hex(c.psk), hex(c.psk_id))
}

fn test_encapsulation_and_key_schedule(t: *testing.T) {
    t.table_of(schedule_cases(), case_name, fn(st, c) {
        let suite = Suite { kem: c.kem, aead: c.aead }
        let recipient = derive_key_pair(c.kem, hex(c.ikm_r)) or KeyPair { private: [], public: [] }
        var sender_private: []u8 = []
        var sender_public: []u8 = []
        if c.ikm_s != "" {
            let sender = derive_key_pair(c.kem, hex(c.ikm_s)) or KeyPair { private: [], public: [] }
            sender_private = sender.private
            sender_public = sender.public
        }
        let encapsulated = encap(c.kem, recipient.public, hex(c.ikm_e), sender_private) or Encapsulated { shared: [], enc: [] }
        st.equal(text.encode_hex(encapsulated.shared), c.shared_secret)
        let decapsulated = decap(c.kem, encapsulated.enc, recipient.private, sender_public) or []
        st.equal(text.encode_hex(decapsulated), c.shared_secret)
        let derived = key_schedule(suite, credentials_of(c, sender_private), encapsulated.shared, hex(c.info))
        st.equal(text.encode_hex(derived.key), c.key)
        st.equal(text.encode_hex(derived.base_nonce), c.base_nonce)
        st.equal(text.encode_hex(derived.exporter_secret), c.exporter_secret)
    })
}

fn sender_and_recipient() -> []*Context {
    let suite = Suite { kem: Kem.DhkemX25519, aead: AeadId.Aes256Gcm }
    let keys = derive_key_pair(suite.kem, hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")) or KeyPair { private: [], public: [] }
    let setup = setup_sender(suite, keys.public, [], base()) or return []
    let receiver = setup_recipient(suite, setup.enc, keys.private, [], base()) or return []
    [setup.context, receiver]
}

fn test_nonce_is_base_nonce_xor_sequence(t: *testing.T) {
    let pair = sender_and_recipient()
    let c = pair[0]
    c.base_nonce = hex("000000000000000000000000")
    c.seq = 0x0102030405060708
    let nonce = next_nonce(c) or []
    equal_hex(t, nonce, "000000000102030405060708")
    c.base_nonce = hex("ffffffffffffffffffffffff")
    c.seq = 1
    let flipped = next_nonce(c) or []
    equal_hex(t, flipped, "fffffffffffffffffffffffe")
}

fn equal_hex(t: *testing.T, got: []u8, want: str) {
    t.equal(text.encode_hex(got), want)
}

fn test_sequence_advances_after_success_only(t: *testing.T) {
    let pair = sender_and_recipient()
    let sender = pair[0]
    let receiver = pair[1]
    let first = seal(sender, [], hex("01")) or []
    let second = seal(sender, [], hex("02")) or []
    t.equal(sender.seq, 2)
    t.equal(open_status(receiver, second), "Open")
    t.equal(receiver.seq, 0)
    t.equal(open_status(receiver, first), "ok")
    t.equal(receiver.seq, 1)
}

fn open_status(c: *Context, ciphertext: []u8) -> str {
    open(c, [], ciphertext) catch {
        Open => return "Open"
        Limit => return "Limit"
        _ => return "other"
    }
    "ok"
}

fn seal_status(c: *Context) -> str {
    seal(c, [], hex("00")) catch {
        Limit => return "Limit"
        _ => return "other"
    }
    "ok"
}

fn test_sequence_limit_is_rejected(t: *testing.T) {
    let pair = sender_and_recipient()
    let sender = pair[0]
    let receiver = pair[1]
    sender.seq = sequence_limit - 1
    receiver.seq = sequence_limit - 1
    let last = seal(sender, [], hex("00")) or []
    t.equal(sender.seq, sequence_limit)
    t.equal(seal_status(sender), "Limit")
    t.equal(open_status(receiver, last), "ok")
    t.equal(receiver.seq, sequence_limit)
    t.equal(open_status(receiver, last), "Limit")
}

