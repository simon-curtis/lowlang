import std/crypto
import std/crypto/aead
import std/io
import std/text

/// The ways an HPKE operation fails.
pub enum Error {
    /// An argument has the wrong length or form: a key, an encapsulated key, a pre-shared key without its identifier or the reverse, an ephemeral seed, or an export length above `255 * 32`.
    Invalid
    /// The operation does not exist for this suite or context: the authenticated modes with a hybrid KEM, `seal` and `open` with the export-only AEAD, `seal` on a recipient context, `open` on a sender context.
    Unsupported
    /// Encapsulation failed: the ML-KEM encapsulation key is rejected or, with DHKEM, the Diffie-Hellman output is all zeros.
    Encap
    /// Decapsulation failed: with DHKEM, the Diffie-Hellman output is all zeros; with the hybrid KEM, ML-KEM decapsulation fails.
    Decap
    /// The ciphertext does not authenticate under the key, nonce and additional data.
    Open
    /// The sequence number of the context is exhausted.
    Limit
}

/// A key encapsulation mechanism (RFC 9180 section 7.1, `draft-ietf-hpke-pq-05` section 4).
pub enum Kem {
    /// DHKEM(X25519, HKDF-SHA256), id 0x0020: 32-byte private and public keys and encapsulated keys. Supports all four modes.
    DhkemX25519 = 0x0020
    /// MLKEM768-X25519 (the X-Wing construction), id 0x647a: 32-byte private keys, 1216-byte public keys and 1120-byte encapsulated keys. Supports the base and PSK modes only.
    Mlkem768X25519 = 0x647a
}

/// An AEAD algorithm (RFC 9180 section 7.3).
pub enum AeadId {
    /// AES-256-GCM, id 0x0002.
    Aes256Gcm = 0x0002
    /// ChaCha20-Poly1305, id 0x0003.
    ChaCha20Poly1305 = 0x0003
    /// Export-only, id 0xFFFF: the context derives secrets with `export` and has no `seal` or `open`.
    ExportOnly = 0xFFFF
}

/// A KEM and an AEAD, combined with HKDF-SHA256 (id 0x0001) as the key derivation function.
pub struct Suite {
    /// The key encapsulation mechanism.
    pub kem: Kem
    /// The AEAD algorithm.
    pub aead: AeadId
}

/// A private key and its public key in their serialized form.
pub struct KeyPair {
    /// The private key, 32 bytes for both KEMs.
    pub private: u8[]
    /// The public key, 32 bytes for DHKEM(X25519) and 1216 bytes for MLKEM768-X25519.
    pub public: u8[]
}

/// The authentication inputs that select one of the four modes of RFC 9180 section 5.
///
/// Build it with `base`, `psk`, `auth` or `auth_psk`.
pub struct Credentials {
    /// The pre-shared key, empty in the base and auth modes.
    pub psk: u8[]
    /// The identifier of the pre-shared key, empty exactly when `psk` is empty.
    pub psk_id: u8[]
    /// The sender's private key when sending and the sender's public key when receiving, empty in the base and PSK modes.
    pub sender_key: u8[]
}

/// The result of setting up a sender.
pub struct Setup {
    /// The encapsulated key to send to the recipient.
    pub enc: u8[]
    /// The sender context.
    pub context: *Context
}

/// A single-shot sealed message.
pub struct Sealed {
    /// The encapsulated key.
    pub enc: u8[]
    /// The ciphertext followed by the 16-byte tag.
    pub ciphertext: u8[]
}

/// An HPKE encryption context with its key, base nonce, exporter secret and sequence number.
///
/// A context built by `setup_sender` seals and one built by `setup_recipient` opens; both export.
pub struct Context {
    suite: Suite
    sending: bool
    cipher: aead.Aead?
    base_nonce: u8[]
    exporter_secret: u8[]
    seq: u64
}

struct Schedule {
    key: u8[]
    base_nonce: u8[]
    exporter_secret: u8[]
}

struct Encapsulated {
    shared: u8[]
    enc: u8[]
}

const sequence_limit: u64 = 0xFFFFFFFFFFFFFFFF
const max_export = 255 * 32
const private_size = 32

/// Returns the credentials of the base mode: no pre-shared key and no sender key.
pub fn base() -> Credentials {
    Credentials { psk: [], psk_id: [], sender_key: [] }
}

/// Returns the credentials of the PSK mode, authenticating both sides with the pre-shared key `psk` named `psk_id`.
///
/// `setup_sender` and `setup_recipient` fail with `Invalid` when exactly one of `psk` and `psk_id` is empty; with both empty the credentials are those of the base mode.
pub fn psk(psk: u8[], psk_id: u8[]) -> Credentials {
    Credentials { psk, psk_id, sender_key: [] }
}

/// Returns the credentials of the auth mode, which authenticates the sender with a key pair.
///
/// `sender_key` is the sender's private key for `setup_sender` and the sender's public key for `setup_recipient`. Only `Kem.DhkemX25519` supports it.
pub fn auth(sender_key: u8[]) -> Credentials {
    Credentials { psk: [], psk_id: [], sender_key }
}

/// Returns the credentials of the auth-PSK mode, combining `auth` and `psk`.
pub fn auth_psk(sender_key: u8[], psk: u8[], psk_id: u8[]) -> Credentials {
    Credentials { psk, psk_id, sender_key }
}

fn key_size(a: AeadId) -> i64 {
    match a {
        Aes256Gcm => 32
        ChaCha20Poly1305 => 32
        ExportOnly => 0
    }
}

fn nonce_size(a: AeadId) -> i64 {
    match a {
        Aes256Gcm => 12
        ChaCha20Poly1305 => 12
        ExportOnly => 0
    }
}

fn public_size(kem: Kem) -> i64 {
    match kem {
        DhkemX25519 => 32
        Mlkem768X25519 => 1216
    }
}

fn enc_size(kem: Kem) -> i64 {
    match kem {
        DhkemX25519 => 32
        Mlkem768X25519 => 1120
    }
}

fn ephemeral_size(kem: Kem) -> i64 {
    match kem {
        DhkemX25519 => 32
        Mlkem768X25519 => 64
    }
}

fn ephemeral_valid(kem: Kem, size: i64) -> bool {
    match kem {
        DhkemX25519 => size >= 32
        Mlkem768X25519 => size == 64
    }
}

fn authenticates(kem: Kem) -> bool {
    match kem {
        DhkemX25519 => true
        Mlkem768X25519 => false
    }
}

fn mode_id(c: Credentials) -> i64 {
    let by_psk = if c.psk.len > 0 { 1 } else { 0 }
    let by_key = if c.sender_key.len > 0 { 2 } else { 0 }
    by_psk + by_key
}

fn check_credentials(kem: Kem, c: Credentials, sender_key_size: i64) ! Error {
    if (c.psk.len == 0) != (c.psk_id.len == 0) {
        fail Error.Invalid
    }
    if c.sender_key.len == 0 {
        return
    }
    if !authenticates(kem) {
        fail Error.Unsupported
    }
    if c.sender_key.len != sender_key_size {
        fail Error.Invalid
    }
}

fn hpke_suite_id(suite: Suite) -> u8[] {
    var id: u8[] = []
    text.append(mut id, "HPKE")
    io.put_be(mut id, suite.kem.index, 2)
    io.put_be(mut id, 1, 2)
    io.put_be(mut id, suite.aead.index, 2)
    id
}

/// Returns a key pair for `kem` generated from `crypto.random`.
pub fn generate_key_pair(kem: Kem) -> KeyPair {
    match kem {
        DhkemX25519 => {
            let ikm = crypto.random(32)
            dhkem_derive_key_pair(ikm)
        }
        Mlkem768X25519 => {
            let seed = crypto.random(32)
            hybrid_key_pair(seed)
        }
    }
}

/// Returns the key pair that `DeriveKeyPair` produces from the input keying material `ikm` (RFC 9180 section 7.1.3, `draft-ietf-hpke-pq-05` section 4).
///
/// The same `ikm` always gives the same pair. Fails with `Invalid` when `ikm` is shorter than 32 bytes.
pub fn derive_key_pair(kem: Kem, ikm: u8[]) -> KeyPair ! Error {
    if ikm.len < 32 {
        fail Error.Invalid
    }
    match kem {
        DhkemX25519 => dhkem_derive_key_pair(ikm)
        Mlkem768X25519 => hybrid_derive_key_pair(ikm)
    }
}

/// Returns the serialized form of the public key `public` (`SerializePublicKey`), which is the key itself.
///
/// Fails with `Invalid` when `public` does not have the length of a public key for `kem`.
pub fn serialize_public_key(kem: Kem, public: u8[]) -> u8[] ! Error {
    if public.len != public_size(kem) {
        fail Error.Invalid
    }
    let out = io.buffer(public.len)
    io.copy(out, public)
    out
}

/// Returns the public key encoded in `bytes` (`DeserializePublicKey`), which is `bytes` itself.
///
/// Fails with `Invalid` when `bytes` does not have the length of a public key for `kem`.
pub fn deserialize_public_key(kem: Kem, bytes: u8[]) -> u8[] ! Error {
    serialize_public_key(kem, bytes)
}

fn encap(kem: Kem, recipient_public: u8[], ikm_e: u8[], sender_private: u8[]) -> Encapsulated ! Error {
    match kem {
        DhkemX25519 => dhkem_encap(recipient_public, ikm_e, sender_private)
        Mlkem768X25519 => hybrid_encap(recipient_public, ikm_e)
    }
}

fn decap(kem: Kem, enc: u8[], recipient_private: u8[], sender_public: u8[]) -> u8[] ! Error {
    match kem {
        DhkemX25519 => dhkem_decap(enc, recipient_private, sender_public)
        Mlkem768X25519 => hybrid_decap(enc, recipient_private)
    }
}

fn key_schedule(suite: Suite, c: Credentials, shared: u8[], info: u8[]) -> Schedule {
    let id = hpke_suite_id(suite)
    let psk_id_hash = labeled_extract(id, [], "psk_id_hash", c.psk_id)
    let info_hash = labeled_extract(id, [], "info_hash", info)
    var context: u8[] = []
    context.push(u8(mode_id(c)))
    io.append(mut context, psk_id_hash)
    io.append(mut context, info_hash)
    let secret = labeled_extract(id, shared, "secret", c.psk)
    let key = labeled_expand(id, secret, "key", context, key_size(suite.aead))
    let base_nonce = labeled_expand(id, secret, "base_nonce", context, nonce_size(suite.aead))
    let exporter_secret = labeled_expand(id, secret, "exp", context, 32)
    Schedule { key, base_nonce, exporter_secret }
}

fn new_context(suite: Suite, sending: bool, s: Schedule) -> *Context ! Error {
    let cipher = cipher_of(suite.aead, s.key)?
    new(Context { suite, sending, cipher, base_nonce: s.base_nonce, exporter_secret: s.exporter_secret, seq: 0 })
}

fn cipher_of(a: AeadId, key: u8[]) -> aead.Aead? ! Error {
    match a {
        Aes256Gcm => {
            let cipher = aead.aes_gcm(key) catch { _ => fail Error.Invalid }
            cipher
        }
        ChaCha20Poly1305 => {
            let cipher = aead.chacha20_poly1305(key) catch { _ => fail Error.Invalid }
            cipher
        }
        ExportOnly => none
    }
}

/// Starts a sender context for `recipient_public` with fresh ephemeral randomness (`SetupBaseS`, `SetupPSKS`, `SetupAuthS` and `SetupAuthPSKS` of RFC 9180 section 5.1).
///
/// `info` is application context bound into the keys. Fails with `Invalid` for a recipient public key or credentials of the wrong form, `Unsupported` for the authenticated modes with `Kem.Mlkem768X25519`, and `Encap` when encapsulation fails.
pub fn setup_sender(suite: Suite, recipient_public: u8[], info: u8[], credentials: Credentials) -> Setup ! Error {
    let ikm_e = crypto.random(ephemeral_size(suite.kem))
    setup_sender_seeded(suite, recipient_public, info, credentials, ikm_e)
}

/// Starts a sender context with caller-supplied ephemeral randomness `ikm_e`, for known-answer tests.
///
/// For `Kem.DhkemX25519` `ikm_e` is the input of `DeriveKeyPair` for the ephemeral key, at least 32 bytes. For `Kem.Mlkem768X25519` it is exactly 64 bytes: the ML-KEM message followed by the X25519 ephemeral private key. Reusing `ikm_e` reuses the ephemeral key, so production code uses `setup_sender`.
pub fn setup_sender_seeded(suite: Suite, recipient_public: u8[], info: u8[], credentials: Credentials, ikm_e: u8[]) -> Setup ! Error {
    let kem = suite.kem
    check_credentials(kem, credentials, private_size)?
    deserialize_public_key(kem, recipient_public)?
    if !ephemeral_valid(kem, ikm_e.len) {
        fail Error.Invalid
    }
    let sealed = encap(kem, recipient_public, ikm_e, credentials.sender_key)?
    let schedule = key_schedule(suite, credentials, sealed.shared, info)
    let context = new_context(suite, true, schedule)?
    Setup { enc: sealed.enc, context }
}

/// Starts a recipient context from the encapsulated key `enc` and the recipient private key (`SetupBaseR`, `SetupPSKR`, `SetupAuthR` and `SetupAuthPSKR`).
///
/// `credentials` must match the sender's; for the authenticated modes `sender_key` is the sender's public key. Fails with `Invalid` when `enc`, the private key or the credentials have the wrong form, `Unsupported` for the authenticated modes with `Kem.Mlkem768X25519`, and `Decap` when decapsulation fails. A tampered `enc` does not fail with the hybrid KEM: the context is built from an unrelated secret and `open` fails with `Open`.
pub fn setup_recipient(suite: Suite, enc: u8[], recipient_private: u8[], info: u8[], credentials: Credentials) -> *Context ! Error {
    let kem = suite.kem
    check_credentials(kem, credentials, public_size(kem))?
    if enc.len != enc_size(kem) || recipient_private.len != private_size {
        fail Error.Invalid
    }
    let shared = decap(kem, enc, recipient_private, credentials.sender_key)?
    let schedule = key_schedule(suite, credentials, shared, info)
    new_context(suite, false, schedule)
}

fn next_nonce(c: *Context) -> u8[] ! Error {
    if c.seq == sequence_limit {
        fail Error.Limit
    }
    let nonce = io.buffer(c.base_nonce.len)
    io.copy(nonce, c.base_nonce)
    for i in 0..8 {
        let at = nonce.len - 1 - i
        nonce[at] = nonce[at] ^ u8(c.seq >> (8 * i))
    }
    nonce
}

/// Encrypts `plaintext` with additional data `aad` and returns the ciphertext followed by the 16-byte tag (`Context.Seal`).
///
/// Each call uses the next sequence number as the nonce. Fails with `Unsupported` on a recipient context or with the export-only AEAD, and with `Limit` when the sequence number is exhausted.
pub fn seal(c: *Context, aad: u8[], plaintext: u8[]) -> u8[] ! Error {
    if !c.sending {
        fail Error.Unsupported
    }
    let cipher = c.cipher ?? fail Error.Unsupported
    let nonce = next_nonce(c)?
    let sealed = cipher.seal(nonce, plaintext, aad)
    c.seq += 1
    sealed
}

/// Decrypts and authenticates `ciphertext` with additional data `aad` (`Context.Open`).
///
/// Messages must be opened in the order they were sealed. Fails with `Open` when authentication fails, in which case the sequence number does not advance, `Unsupported` on a sender context or with the export-only AEAD, and `Limit` when the sequence number is exhausted.
pub fn open(c: *Context, aad: u8[], ciphertext: u8[]) -> u8[] ! Error {
    if c.sending {
        fail Error.Unsupported
    }
    let cipher = c.cipher ?? fail Error.Unsupported
    let nonce = next_nonce(c)?
    let plaintext = cipher.open(nonce, ciphertext, aad) catch { _ => fail Error.Open }
    c.seq += 1
    plaintext
}

/// Returns `length` bytes of secret derived from the context and `exporter_context` (`Context.Export`).
///
/// The sender and recipient contexts of one exchange return the same bytes. Fails with `Invalid` when `length` is negative or above 8160.
pub fn export(c: *Context, exporter_context: u8[], length: i64) -> u8[] ! Error {
    if length < 0 || length > max_export {
        fail Error.Invalid
    }
    let id = hpke_suite_id(c.suite)
    labeled_expand(id, c.exporter_secret, "sec", exporter_context, length)
}

/// Encrypts one message to `recipient_public` in a single call (`SealBase`, `SealPSK`, `SealAuth` and `SealAuthPSK`).
pub fn seal_single(suite: Suite, recipient_public: u8[], info: u8[], credentials: Credentials, aad: u8[], plaintext: u8[]) -> Sealed ! Error {
    let setup = setup_sender(suite, recipient_public, info, credentials)?
    let ciphertext = seal(setup.context, aad, plaintext)?
    Sealed { enc: setup.enc, ciphertext }
}

/// Decrypts the first message of a sender with `enc` in a single call (`OpenBase`, `OpenPSK`, `OpenAuth` and `OpenAuthPSK`).
pub fn open_single(suite: Suite, enc: u8[], recipient_private: u8[], info: u8[], credentials: Credentials, aad: u8[], ciphertext: u8[]) -> u8[] ! Error {
    let context = setup_recipient(suite, enc, recipient_private, info, credentials)?
    open(context, aad, ciphertext)
}
