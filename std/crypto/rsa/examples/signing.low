import std/base64
import std/crypto/hash
import std/crypto/rsa
import std/io
import std/text

fn load_key() -> rsa.PrivateKey ! io.Error {
    let encoded = text.join([
        "MIIEowIBAAKCAQEAtm4sbwmf69FdFFUlqGja6B6z8SzWkTw5ZSzJ0Rnzp1Oj1gCF",
        "CAoknRNKJHHouaDUIHGCfasWLsZczeDQ/ySl9EEpnaCKzZgI5rM8u1IbA6VOuLjX",
        "6uybU02NMN56TXNjrMNzm9XGDSpA4G6RFmgN/YAHYWLmtL0x1nwMbJGwmsXk62yD",
        "1BdgfHjfzyRUByklczxBT9zbrDtqsjVmcBSmYEis6tXTCMj1sXLKkycU5myAjWWe",
        "4pOsx7YONltxRxtr6cgQnAlvAYhvujUbqoiwNEQPP+mg5rtqsrpRh1a/G1WGGFAV",
        "ym0IoOJRGcssQ5s1FxQ9/e4jjSpO+OD0IdVirwIDAQABAoIBADTA/FFpt5iiVOfF",
        "zZt7It5fzoot/KhIAZLr1jqE5iwbaDPAt7eA82CGzPhoBjPzuZPeLy129XW2P+z7",
        "F4TIjMLquwWNgMX+MojACQ5kKlKuEWsibLHPFQWMVgltNHHELe0uIfbM5TY2Y0dj",
        "Qcp4cZ8+UCQNzQgz878B5TfaE3dVyKTsEufU9oNbYIQ+8cHjt07IAmLfgdj71kcj",
        "KH3B4OVTEfjU2EKnfo+69ACsY95jxrpVOOjGz/nV/aYwMEyQK59vbkPVjiAFfIjA",
        "rem6tF8Kfdd4cRWkR91Mpi0ALdCmwzYtPVc4DrtAb+3uX0SNaPD8eLF3SQGHR46i",
        "tnEodXUCgYEA2eLX+4/333f5qer1HK2Rg3zzuXZNrtFrz+ynvzYUQwZ3vWZG0hgp",
        "lEE14yqXKp78RrKqzOJGYfb7kkHGpx0reX1CoW77as8gqqnZeujSSwXhOzlSXbd5",
        "fZA8SAr82jBMf/0MI7C1bMuLHZvkE394tVoxvNLpOi4QypuBtfWpcH0CgYEA1leW",
        "JhqBlQTSlamezOT019UoMlTLs8tvqMeuhgt+oiJRfSOEt0ljVzWvwr7eBoqGVJzU",
        "Sx9F7Uhl0mztekzWB283I2RAZUkqRC+eo8Uut8YH00bMUKT0u9sZ+376/r3C9zG+",
        "YHFFks5ETrnePwdv0d5u+Tq+NBgr04Kd/naJE5sCgYBbslENSNibjoVe0kgXqqBL",
        "wwFbcwNcaDxERCeQnDTIxGcOKYXyk0KkZxFDqj/2KvSm2Dhzg2L1hZj4Q4BUAj2y",
        "olmxUOC0YbkwucySInumITJZ11TnpfiWNGZ6N02UkbEQSDGcr5ia0cqZSmshHYty",
        "XyQBgI2w84QTkIB1UI7fjQKBgDEzwd/VTdGrXbvFSBK4rAuvfp6vIGORW3xe+g0D",
        "LnqBbjtPn/ODAS7PwBzwO3885UEfDwx/jUm+yMDZCFp+sNLcEMgrBy048l7cn4nw",
        "hZzh9IHnSpdohlVpIjm9GFjJrquX25+/4LymZL+9ourNBjoi2U6U0Xyb39OZtDLp",
        "euXpAoGBAIS68idkPyivzLdbieHR2VpwFFdYHL4nYqnwh9gb4ZJAWgSXHKiXXOmt",
        "xhjuQNU8AvuyvwBME69Jy/SGxsU4SDzGRxyeuduDaZ7PH0v0E1OzTXOMfXotoTrv",
        "xFbQk75BBGHFCc+g7ARXsfu/PXk85KvwZhF9ApSudPwYyAAKKpPP",
    ], "")
    let der = base64.decode(encoded) or fail io.Error.Invalid
    rsa.parse_private(der)?
}

fn run() ! io.Error {
    let key = load_key()?
    let public = rsa.public(key)
    print("modulus {public.n.len * 8} bits, exponent {text.encode_hex(public.e)}")

    let sha256 = hash.sha256()
    let digest = hash.sum(sha256, bytes("release-1.4.2.tar.gz contents"))

    let pkcs1 = rsa.sign_pkcs1v15(key, sha256, digest)?
    print("pkcs1v15 signature {pkcs1.len} bytes, starts {text.encode_hex(pkcs1[..16])}")
    print("pkcs1v15 verifies: {rsa.verify_pkcs1v15(public, sha256, digest, pkcs1)}")

    let pss = rsa.sign_pss(key, sha256, digest)?
    print("pss signature {pss.len} bytes")
    print("pss verifies: {rsa.verify_pss(public, sha256, digest, pss)}")
    let pss_again = rsa.sign_pss(key, sha256, digest)?
    print("pss signatures repeat: {hash.equal(pss, pss_again)}")

    let other = hash.sum(sha256, bytes("release-1.4.3.tar.gz contents"))
    print("other digest, pkcs1v15: {rsa.verify_pkcs1v15(public, sha256, other, pkcs1)}")
    print("other digest, pss: {rsa.verify_pss(public, sha256, other, pss)}")
    print("pss under the pkcs1v15 check: {rsa.verify_pkcs1v15(public, sha256, digest, pss)}")
    let sha512 = hash.sha512()
    let wide = hash.sum(sha512, bytes("release-1.4.2.tar.gz contents"))
    print("sha256 signature under sha512: {rsa.verify_pkcs1v15(public, sha512, wide, pkcs1)}")
}

/// Signs a release digest with a 2048-bit PKCS#1 key in both RSA schemes, verifies the signatures with the public half, and shows what a changed digest, a scheme mismatch or a hash mismatch does.
fn main() {
    run() catch {
        e => print("failed: {e}")
    }
}
