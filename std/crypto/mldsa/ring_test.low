import std/testing

fn schoolbook(a: []i64, b: []i64) -> []i64 {
    let out: []i64 = __make(256)
    for i in 0..256 {
        for j in 0..256 {
            let p = a[i] * b[j] % q
            if i + j < 256 {
                out[i + j] = (out[i + j] + p) % q
            } else {
                out[i + j - 256] = (out[i + j - 256] - p + q) % q
            }
        }
    }
    out
}

fn poly(seed: i64) -> []i64 {
    let f: []i64 = __make(256)
    var x = seed
    for i in 0..256 {
        x = (x * 6364136223846793005 + 1442695040888963407) >> 3 & 0x7fffff
        f[i] = x % q
    }
    f
}

fn test_the_transform_multiplies_polynomials(t: *testing.T) {
    let zetas = zeta_table()
    let a = poly(1)
    let b = poly(2)
    let expected = schoolbook(a, b)
    ntt(zetas, a)
    ntt(zetas, b)
    let product: []i64 = __make(256)
    multiply_add(product, a, b)
    inverse_ntt(zetas, product)
    for i in 0..256 {
        t.equal(canonical(product[i]), expected[i])
    }
}

fn specified_high(gamma2: i64, r: i64) -> i64 {
    let alpha = 2 * gamma2
    var r0 = r % alpha
    if r0 > alpha / 2 {
        r0 -= alpha
    }
    if r - r0 == q - 1 {
        return 0
    }
    (r - r0) / alpha
}

fn specified_low(gamma2: i64, r: i64) -> i64 {
    let alpha = 2 * gamma2
    var r0 = r % alpha
    if r0 > alpha / 2 {
        r0 -= alpha
    }
    if r - r0 == q - 1 {
        return r0 - 1
    }
    r0
}

fn test_rounding_matches_the_specification(t: *testing.T) {
    for gamma2 in [95232, 261888] {
        var r = 0
        for r < q {
            t.equal(high_bits(gamma2, r), specified_high(gamma2, r))
            t.equal(low_bits(gamma2, r), specified_low(gamma2, r))
            r += 997
        }
        for r2 in q - 600..q {
            t.equal(high_bits(gamma2, r2), specified_high(gamma2, r2))
            t.equal(low_bits(gamma2, r2), specified_low(gamma2, r2))
        }
    }
}
