import std/crypto/sha3

struct Secrets {
    s1: [][]i64
    s2: [][]i64
}

fn xof256(parts: [][]u8, n: i64) -> []u8 {
    let x = sha3.shake256()
    for part in parts {
        sha3.absorb(x, part)
    }
    sha3.squeeze(x, n)
}

fn nonce(seed: []u8, n: i64) -> []u8 {
    let out: []u8 = __make(seed.len + 2)
    __memmove(out, seed)
    out[seed.len] = u8(n)
    out[seed.len + 1] = u8(n >> 8)
    out
}

fn sample_ntt(rho: []u8, row: i64, column: i64) -> []i64 {
    let seed: []u8 = __make(34)
    __memmove(seed, rho)
    seed[32] = u8(column)
    seed[33] = u8(row)
    let xof = sha3.shake128()
    sha3.absorb(xof, seed)
    let f: []i64 = __make(256)
    var count = 0
    for count < 256 {
        let block = sha3.squeeze(xof, 168)
        var p = 0
        for p < 168 && count < 256 {
            let z = i64(block[p]) | i64(block[p + 1]) << 8 | (i64(block[p + 2]) & 127) << 16
            if z < q {
                f[count] = z
                count += 1
            }
            p += 3
        }
    }
    f
}

fn expand_a(k: i64, l: i64, rho: []u8) -> [][]i64 {
    var a: [][]i64 = []
    for r in 0..k {
        for c in 0..l {
            push(mut a, sample_ntt(rho, r, c))
        }
    }
    a
}

fn half_byte(eta: i64, b: i64) -> i64 {
    if eta == 2 {
        if b < 15 {
            return 2 - (b - 5 * (b * 13 >> 6))
        }
        return 100
    }
    if b < 9 {
        return 4 - b
    }
    100
}

fn sample_bounded(eta: i64, seed: []u8) -> []i64 {
    let xof = sha3.shake256()
    sha3.absorb(xof, seed)
    let f: []i64 = __make(256)
    var count = 0
    for count < 256 {
        let block = sha3.squeeze(xof, 136)
        var p = 0
        for p < 136 && count < 256 {
            let z = i64(block[p])
            let c0 = half_byte(eta, z & 15)
            let c1 = half_byte(eta, z >> 4)
            if c0 != 100 {
                f[count] = c0
                count += 1
            }
            if c1 != 100 && count < 256 {
                f[count] = c1
                count += 1
            }
            p += 1
        }
    }
    f
}

fn expand_s(k: i64, l: i64, eta: i64, rho: []u8) -> Secrets {
    var s1: [][]i64 = []
    var s2: [][]i64 = []
    for r in 0..l {
        push(mut s1, sample_bounded(eta, nonce(rho, r)))
    }
    for r in 0..k {
        push(mut s2, sample_bounded(eta, nonce(rho, l + r)))
    }
    Secrets { s1, s2 }
}

fn expand_mask(l: i64, gamma1: i64, bits: i64, rho: []u8, kappa: i64) -> [][]i64 {
    var y: [][]i64 = []
    for r in 0..l {
        let v = xof256([nonce(rho, kappa + r)], 32 * bits)
        push(mut y, subtract_from(gamma1, decode(v, 0, bits)))
    }
    y
}

fn sample_in_ball(seed: []u8, tau: i64) -> []i64 {
    let xof = sha3.shake256()
    sha3.absorb(xof, seed)
    var block = sha3.squeeze(xof, 136)
    var signs: u64 = 0
    for i in 0..8 {
        signs |= u64(block[i]) << (8 * i)
    }
    var p = 8
    let c: []i64 = __make(256)
    for i in 256 - tau..256 {
        var j = 256
        for j > i {
            if p == block.len {
                block = sha3.squeeze(xof, 136)
                p = 0
            }
            j = i64(block[p])
            p += 1
        }
        c[i] = c[j]
        c[j] = 1 - 2 * i64(signs & 1)
        signs >>= 1
    }
    c
}
