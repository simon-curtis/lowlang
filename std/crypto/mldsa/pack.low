fn encode(out: u8[], at: i64, f: i64[], d: i64) {
    var acc: u64 = 0
    var bits = 0
    var p = at
    for i in 0..256 {
        acc |= u64(f[i]) << bits
        bits += d
        for bits >= 8 {
            out[p] = u8(acc)
            acc >>= 8
            bits -= 8
            p += 1
        }
    }
}

fn decode(b: u8[], at: i64, d: i64) -> i64[] {
    let f: i64[] = __make(256)
    let mask: u64 = (1 << u64(d)) - 1
    var acc: u64 = 0
    var bits = 0
    var p = at
    for i in 0..256 {
        for bits < d {
            acc |= u64(b[p]) << bits
            bits += 8
            p += 1
        }
        f[i] = i64(acc & mask)
        acc >>= d
        bits -= d
    }
    f
}

fn subtract_from(c: i64, f: i64[]) -> i64[] {
    let g: i64[] = __make(256)
    for i in 0..256 {
        g[i] = c - f[i]
    }
    g
}

fn encode_hint(out: u8[], at: i64, omega: i64, hints: i64[][]) {
    var index = 0
    for i in 0..hints.len {
        for j in 0..256 {
            if hints[i][j] != 0 {
                out[at + index] = u8(j)
                index += 1
            }
        }
        out[at + omega + i] = u8(index)
    }
}

fn decode_hint(b: u8[], at: i64, omega: i64, k: i64) -> i64[][]? {
    var hints: i64[][] = []
    var index = 0
    for i in 0..k {
        let h: i64[] = __make(256)
        let limit = i64(b[at + omega + i])
        if limit < index || limit > omega {
            return none
        }
        let first = index
        for index < limit {
            let j = i64(b[at + index])
            if index > first && i64(b[at + index - 1]) >= j {
                return none
            }
            h[j] = 1
            index += 1
        }
        hints.push(h)
    }
    for i in index..omega {
        if b[at + i] != 0 {
            return none
        }
    }
    some(hints)
}
