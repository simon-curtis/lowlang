const q = 8380417

fn bit_reverse8(x: i64) -> i64 {
    var r = 0
    for b in 0..8 {
        r |= (x >> b & 1) << (7 - b)
    }
    r
}

fn zeta_table() -> []i64 {
    let powers: []i64 = __make(256)
    var p = 1
    for i in 0..256 {
        powers[i] = p
        p = p * 1753 % q
    }
    let zetas: []i64 = __make(256)
    for i in 0..256 {
        zetas[i] = (powers[bit_reverse8(i)] << 32) % q
    }
    zetas
}

fn mont(a: i64) -> i64 {
    let t = i32(a) * 58728449
    (a - i64(t) * q) >> 32
}

fn fold(x: i64) -> i64 {
    x - ((x + 4194304) >> 23) * q
}

fn canonical(x: i64) -> i64 {
    let r = fold(fold(fold(x)))
    r + (r >> 63 & q)
}

fn centered(x: i64) -> i64 {
    let r = canonical(x)
    r - (((q - 1) / 2 - r) >> 63 & q)
}

fn magnitude(x: i64) -> i64 {
    let s = x >> 63
    (x ^ s) - s
}

fn ntt(zetas: []i64, f: []i64) {
    var k = 0
    var len = 128
    for len > 0 {
        var start = 0
        for start < 256 {
            k += 1
            let z = zetas[k]
            for j in start..start + len {
                let t = mont(z * f[j + len])
                f[j + len] = f[j] - t
                f[j] = f[j] + t
            }
            start += 2 * len
        }
        len >>= 1
    }
}

fn inverse_ntt(zetas: []i64, f: []i64) {
    var k = 256
    var len = 1
    for len < 256 {
        var start = 0
        for start < 256 {
            k -= 1
            let z = -zetas[k]
            for j in start..start + len {
                let t = f[j]
                f[j] = t + f[j + len]
                f[j + len] = mont(z * (t - f[j + len]))
            }
            start += 2 * len
        }
        len <<= 1
    }
    for j in 0..256 {
        f[j] = mont(41978 * f[j])
    }
}

fn multiply_add(acc: []i64, a: []i64, b: []i64) {
    for i in 0..256 {
        acc[i] += mont(a[i] * b[i])
    }
}

fn high_bits(gamma2: i64, r: i64) -> i64 {
    let a = (r + 127) >> 7
    if gamma2 == 261888 {
        (a * 1025 + (1 << 21)) >> 22 & 15
    } else {
        let t = (a * 11275 + (1 << 23)) >> 24
        t ^ ((43 - t) >> 63 & t)
    }
}

fn low_bits(gamma2: i64, r: i64) -> i64 {
    let a0 = r - high_bits(gamma2, r) * 2 * gamma2
    a0 - (((q - 1) / 2 - a0) >> 63 & q)
}

fn make_hint(gamma2: i64, before: i64, after: i64) -> i64 {
    let x = high_bits(gamma2, before) ^ high_bits(gamma2, after)
    (x | -x) >> 63 & 1
}

fn use_hint(gamma2: i64, hint: i64, r: i64) -> i64 {
    let a1 = high_bits(gamma2, r)
    if hint == 0 {
        return a1
    }
    let m = (q - 1) / (2 * gamma2)
    if low_bits(gamma2, r) > 0 {
        (a1 + 1) % m
    } else {
        (a1 + m - 1) % m
    }
}

fn exceeds(f: []i64, bound: i64) -> i64 {
    var over = 0
    for x in f {
        over |= (bound - 1 - magnitude(x)) >> 63
    }
    over & 1
}
