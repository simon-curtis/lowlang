import std/testing

fn hint_bytes(omega: i64, k: i64, indices: i64[][]) -> u8[] {
    let b: u8[] = __make(omega + k)
    var at = 0
    for i in 0..k {
        for j in indices[i] {
            b[at] = u8(j)
            at += 1
        }
        b[omega + i] = u8(at)
    }
    b
}

fn test_a_well_formed_hint_decodes(t: *testing.T) {
    let b = hint_bytes(10, 3, [[1, 5, 255], [], [0, 2]])
    let h = decode_hint(b, 0, 10, 3) ?? return
    t.equal(h[0][1], 1)
    t.equal(h[0][5], 1)
    t.equal(h[0][255], 1)
    t.equal(h[0][2], 0)
    t.equal(h[2][0], 1)
    t.equal(h[2][2], 1)
    t.equal(h[1][0], 0)
}

fn test_a_hint_with_a_count_above_the_limit_is_rejected(t: *testing.T) {
    let b = hint_bytes(4, 2, [[1, 2, 3], [4, 5]])
    t.is_none(decode_hint(b, 0, 4, 2))
}

fn test_a_hint_with_decreasing_indices_is_rejected(t: *testing.T) {
    let b = hint_bytes(10, 2, [[5, 3], []])
    t.is_none(decode_hint(b, 0, 10, 2))
}

fn test_a_hint_with_repeated_indices_is_rejected(t: *testing.T) {
    let b = hint_bytes(10, 2, [[5, 5], []])
    t.is_none(decode_hint(b, 0, 10, 2))
}

fn test_a_hint_with_decreasing_counts_is_rejected(t: *testing.T) {
    let b = hint_bytes(10, 2, [[1, 2], []])
    b[10 + 1] = 1
    t.is_none(decode_hint(b, 0, 10, 2))
}

fn test_a_hint_with_nonzero_padding_is_rejected(t: *testing.T) {
    let b = hint_bytes(10, 2, [[1, 2], [3]])
    b[7] = 9
    t.is_none(decode_hint(b, 0, 10, 2))
}

fn test_indices_may_restart_in_the_next_polynomial(t: *testing.T) {
    let b = hint_bytes(10, 2, [[200, 201], [1, 2]])
    t.is_some(decode_hint(b, 0, 10, 2))
}
