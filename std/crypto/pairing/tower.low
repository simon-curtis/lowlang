import std/crypto/limb
import std/crypto/nistec

fn fp2_add(c: *Curve, d: u64[], a: u64[], b: u64[]) {
    let l = c.l
    nistec.add(c.fp, d[..l], a[..l], b[..l])
    nistec.add(c.fp, d[l..2 * l], a[l..2 * l], b[l..2 * l])
}

fn fp2_sub(c: *Curve, d: u64[], a: u64[], b: u64[]) {
    let l = c.l
    nistec.sub(c.fp, d[..l], a[..l], b[..l])
    nistec.sub(c.fp, d[l..2 * l], a[l..2 * l], b[l..2 * l])
}

fn fp2_neg(c: *Curve, d: u64[], a: u64[]) {
    let l = c.l
    let zero = take(c, l)
    limb.clear(zero)
    nistec.sub(c.fp, d[..l], zero, a[..l])
    nistec.sub(c.fp, d[l..2 * l], zero, a[l..2 * l])
    c.top -= l
}

fn fp2_conj(c: *Curve, d: u64[], a: u64[]) {
    let l = c.l
    let zero = take(c, l)
    limb.clear(zero)
    __memmove(d[..l], a[..l])
    nistec.sub(c.fp, d[l..2 * l], zero, a[l..2 * l])
    c.top -= l
}

fn fp2_mul(c: *Curve, d: u64[], a: u64[], b: u64[]) {
    let l = c.l
    let f = c.fp
    let mark = c.top
    let t0 = take(c, l)
    let t1 = take(c, l)
    let t2 = take(c, l)
    let t3 = take(c, l)
    nistec.mul(f, t0, a[..l], b[..l])
    nistec.mul(f, t1, a[l..2 * l], b[l..2 * l])
    nistec.add(f, t2, a[..l], a[l..2 * l])
    nistec.add(f, t3, b[..l], b[l..2 * l])
    nistec.mul(f, t2, t2, t3)
    nistec.sub(f, t2, t2, t0)
    nistec.sub(f, t2, t2, t1)
    nistec.sub(f, d[..l], t0, t1)
    __memmove(d[l..2 * l], t2)
    c.top = mark
}

fn fp2_square(c: *Curve, d: u64[], a: u64[]) {
    let l = c.l
    let f = c.fp
    let mark = c.top
    let t0 = take(c, l)
    let t1 = take(c, l)
    nistec.add(f, t0, a[..l], a[l..2 * l])
    nistec.sub(f, t1, a[..l], a[l..2 * l])
    nistec.mul(f, t0, t0, t1)
    nistec.mul(f, t1, a[..l], a[l..2 * l])
    nistec.add(f, d[l..2 * l], t1, t1)
    __memmove(d[..l], t0)
    c.top = mark
}

fn fp2_scale(c: *Curve, d: u64[], a: u64[], s: u64[]) {
    let l = c.l
    nistec.mul(c.fp, d[..l], a[..l], s)
    nistec.mul(c.fp, d[l..2 * l], a[l..2 * l], s)
}

fn fp2_mul_xi(c: *Curve, d: u64[], a: u64[]) {
    let l = c.l
    let f = c.fp
    let mark = c.top
    let t0 = take(c, l)
    let t1 = take(c, l)
    nistec.mul(f, t0, a[..l], c.xi0)
    nistec.sub(f, t0, t0, a[l..2 * l])
    nistec.mul(f, t1, a[l..2 * l], c.xi0)
    nistec.add(f, t1, t1, a[..l])
    __memmove(d[..l], t0)
    __memmove(d[l..2 * l], t1)
    c.top = mark
}

fn fp2_inverse(c: *Curve, d: u64[], a: u64[]) {
    let l = c.l
    let f = c.fp
    let mark = c.top
    let t0 = take(c, l)
    let t1 = take(c, l)
    nistec.mul(f, t0, a[..l], a[..l])
    nistec.mul(f, t1, a[l..2 * l], a[l..2 * l])
    nistec.add(f, t0, t0, t1)
    nistec.invert(f, t0, t0)
    nistec.mul(f, d[..l], a[..l], t0)
    nistec.mul(f, t1, a[l..2 * l], t0)
    limb.clear(t0)
    nistec.sub(f, d[l..2 * l], t0, t1)
    c.top = mark
}

fn fp2_power(c: *Curve, d: u64[], a: u64[], exponent: u64[]) {
    let l = c.l
    let mark = c.top
    let acc = take(c, 2 * l)
    let base = take(c, 2 * l)
    __memmove(base, a)
    limb.clear(acc)
    __memmove(acc[..l], c.fp.one)
    var i = exponent.len * 64 - 1
    for i >= 0 {
        fp2_square(c, acc, acc)
        if (exponent[i >> 6] >> (i & 63)) & 1 == 1 {
            fp2_mul(c, acc, acc, base)
        }
        i -= 1
    }
    __memmove(d, acc)
    c.top = mark
}

fn fp6_add(c: *Curve, d: u64[], a: u64[], b: u64[]) {
    for i in 0..3 {
        let s = 2 * c.l * i
        let e = s + 2 * c.l
        fp2_add(c, d[s..e], a[s..e], b[s..e])
    }
}

fn fp6_sub(c: *Curve, d: u64[], a: u64[], b: u64[]) {
    for i in 0..3 {
        let s = 2 * c.l * i
        let e = s + 2 * c.l
        fp2_sub(c, d[s..e], a[s..e], b[s..e])
    }
}

fn fp6_neg(c: *Curve, d: u64[], a: u64[]) {
    for i in 0..3 {
        let s = 2 * c.l * i
        let e = s + 2 * c.l
        fp2_neg(c, d[s..e], a[s..e])
    }
}

fn fp6_mul_v(c: *Curve, d: u64[], a: u64[]) {
    let n = 2 * c.l
    let mark = c.top
    let t = take(c, n)
    fp2_mul_xi(c, t, a[2 * n..3 * n])
    __memmove(d[2 * n..3 * n], a[n..2 * n])
    __memmove(d[n..2 * n], a[..n])
    __memmove(d[..n], t)
    c.top = mark
}

fn fp6_mul(c: *Curve, d: u64[], a: u64[], b: u64[]) {
    let n = 2 * c.l
    let mark = c.top
    let t0 = take(c, n)
    let t1 = take(c, n)
    let t2 = take(c, n)
    let s = take(c, n)
    let u = take(c, n)
    let r0 = take(c, n)
    let r1 = take(c, n)
    let a0 = a[..n]
    let a1 = a[n..2 * n]
    let a2 = a[2 * n..3 * n]
    let b0 = b[..n]
    let b1 = b[n..2 * n]
    let b2 = b[2 * n..3 * n]
    fp2_mul(c, t0, a0, b0)
    fp2_mul(c, t1, a1, b1)
    fp2_mul(c, t2, a2, b2)
    fp2_add(c, s, a1, a2)
    fp2_add(c, u, b1, b2)
    fp2_mul(c, r0, s, u)
    fp2_sub(c, r0, r0, t1)
    fp2_sub(c, r0, r0, t2)
    fp2_mul_xi(c, r0, r0)
    fp2_add(c, r0, r0, t0)
    fp2_add(c, s, a0, a1)
    fp2_add(c, u, b0, b1)
    fp2_mul(c, r1, s, u)
    fp2_sub(c, r1, r1, t0)
    fp2_sub(c, r1, r1, t1)
    fp2_mul_xi(c, s, t2)
    fp2_add(c, r1, r1, s)
    fp2_add(c, s, a0, a2)
    fp2_add(c, u, b0, b2)
    fp2_mul(c, u, s, u)
    fp2_sub(c, u, u, t0)
    fp2_sub(c, u, u, t2)
    fp2_add(c, d[2 * n..3 * n], u, t1)
    __memmove(d[..n], r0)
    __memmove(d[n..2 * n], r1)
    c.top = mark
}

fn fp6_inverse(c: *Curve, d: u64[], a: u64[]) {
    let n = 2 * c.l
    let mark = c.top
    let x = take(c, n)
    let y = take(c, n)
    let z = take(c, n)
    let t = take(c, n)
    let f = take(c, n)
    let a0 = a[..n]
    let a1 = a[n..2 * n]
    let a2 = a[2 * n..3 * n]
    fp2_square(c, x, a0)
    fp2_mul(c, t, a1, a2)
    fp2_mul_xi(c, t, t)
    fp2_sub(c, x, x, t)
    fp2_square(c, y, a2)
    fp2_mul_xi(c, y, y)
    fp2_mul(c, t, a0, a1)
    fp2_sub(c, y, y, t)
    fp2_square(c, z, a1)
    fp2_mul(c, t, a0, a2)
    fp2_sub(c, z, z, t)
    fp2_mul(c, f, a2, y)
    fp2_mul(c, t, a1, z)
    fp2_add(c, f, f, t)
    fp2_mul_xi(c, f, f)
    fp2_mul(c, t, a0, x)
    fp2_add(c, f, f, t)
    fp2_inverse(c, f, f)
    fp2_mul(c, d[..n], x, f)
    fp2_mul(c, d[n..2 * n], y, f)
    fp2_mul(c, d[2 * n..3 * n], z, f)
    c.top = mark
}

fn fp12_one(c: *Curve, d: u64[]) {
    limb.clear(d)
    __memmove(d[..c.l], c.fp.one)
}

fn fp12_mul(c: *Curve, d: u64[], a: u64[], b: u64[]) {
    let n = 6 * c.l
    let mark = c.top
    let t0 = take(c, n)
    let t1 = take(c, n)
    let s = take(c, n)
    let u = take(c, n)
    fp6_mul(c, t0, a[..n], b[..n])
    fp6_mul(c, t1, a[n..2 * n], b[n..2 * n])
    fp6_add(c, s, a[..n], a[n..2 * n])
    fp6_add(c, u, b[..n], b[n..2 * n])
    fp6_mul(c, s, s, u)
    fp6_sub(c, s, s, t0)
    fp6_sub(c, d[n..2 * n], s, t1)
    fp6_mul_v(c, t1, t1)
    fp6_add(c, d[..n], t0, t1)
    c.top = mark
}

fn fp12_square(c: *Curve, d: u64[], a: u64[]) {
    let n = 6 * c.l
    let mark = c.top
    let t = take(c, n)
    let s = take(c, n)
    let u = take(c, n)
    fp6_mul(c, t, a[..n], a[n..2 * n])
    fp6_add(c, s, a[..n], a[n..2 * n])
    fp6_mul_v(c, u, a[n..2 * n])
    fp6_add(c, u, u, a[..n])
    fp6_mul(c, s, s, u)
    fp6_sub(c, s, s, t)
    fp6_mul_v(c, u, t)
    fp6_sub(c, d[..n], s, u)
    fp6_add(c, d[n..2 * n], t, t)
    c.top = mark
}

fn fp12_conj(c: *Curve, d: u64[], a: u64[]) {
    let n = 6 * c.l
    __memmove(d[..n], a[..n])
    fp6_neg(c, d[n..2 * n], a[n..2 * n])
}

fn fp12_inverse(c: *Curve, d: u64[], a: u64[]) {
    let n = 6 * c.l
    let mark = c.top
    let t0 = take(c, n)
    let t1 = take(c, n)
    fp6_mul(c, t0, a[..n], a[..n])
    fp6_mul(c, t1, a[n..2 * n], a[n..2 * n])
    fp6_mul_v(c, t1, t1)
    fp6_sub(c, t0, t0, t1)
    fp6_inverse(c, t0, t0)
    fp6_mul(c, d[..n], a[..n], t0)
    fp6_mul(c, t1, a[n..2 * n], t0)
    fp6_neg(c, d[n..2 * n], t1)
    c.top = mark
}

fn slot(c: *Curve, i: i64) -> i64 {
    let n = 2 * c.l
    if i % 2 == 0 { n * (i / 2) } else { 3 * n + n * (i / 2) }
}

fn fp12_frobenius(c: *Curve, d: u64[], a: u64[]) {
    let n = 2 * c.l
    for i in 0..6 {
        let at = slot(c, i)
        let out = d[at..at + n]
        fp2_conj(c, out, a[at..at + n])
        fp2_mul(c, out, out, c.gamma[n * i..n * (i + 1)])
    }
}

fn fp12_power(c: *Curve, d: u64[], a: u64[], exponent: u64[]) {
    let mark = c.top
    let acc = take(c, 12 * c.l)
    let base = take(c, 12 * c.l)
    __memmove(base, a)
    fp12_one(c, acc)
    var i = exponent.len * 64 - 1
    for i >= 0 {
        fp12_square(c, acc, acc)
        if (exponent[i >> 6] >> (i & 63)) & 1 == 1 {
            fp12_mul(c, acc, acc, base)
        }
        i -= 1
    }
    __memmove(d, acc)
    c.top = mark
}
