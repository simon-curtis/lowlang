import std/crypto/pairing

fn scalar(c: *pairing.Curve, value: u64) -> u64[] {
    var out: u64[] = [value]
    for out.len < c.fr.m.len {
        out.push(0)
    }
    out
}

fn bilinear(c: *pairing.Curve, name: str) {
    let left = pairing.mul(c, c.g1, scalar(c, 6))
    let right = pairing.mul(c, c.g2, scalar(c, 35))
    let product = pairing.neg(c, pairing.mul(c, c.g1, scalar(c, 210)))
    print("{name}: e(6 G1, 35 G2) e(-210 G1, G2) = 1: {pairing.check(c, [left, product], [right, c.g2])}")
    print("{name}: e(G1, G2) is not 1: {!pairing.gt_equal(pairing.pair(c, c.g1, c.g2), pairing.gt_one(c))}")
}

/// Checks bilinearity on both curves with one product of pairings, then commits to the polynomial `3 + x + 4 x^2 + x^3 + 5 x^4` against the powers of a public point `s = 7` with a multi-scalar multiplication, the shape of a KZG commitment, and compares it with `f(7) G1`.
fn main() {
    bilinear(pairing.bn254(), "bn254")
    bilinear(pairing.bls12_381(), "bls12-381")

    let c = pairing.bls12_381()
    let coefficients: u64[] = [3, 1, 4, 1, 5]
    var powers: pairing.Point[] = []
    var scalars: u64[][] = []
    var power = c.g1
    for k in coefficients {
        powers.push(power)
        scalars.push(scalar(c, k))
        power = pairing.mul_public(c, power, [7])
    }
    let commitment = pairing.msm(c, powers, scalars)
    print("commitment equals f(7) G1 = 12554 G1: {pairing.equal(c, commitment, pairing.mul_public(c, c.g1, [12554]))}")
    print("constant-time msm agrees: {pairing.equal(c, pairing.msm_secret(c, powers, scalars), commitment)}")
}
