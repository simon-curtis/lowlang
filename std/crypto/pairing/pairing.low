import std/crypto/limb
import std/crypto/nistec

struct Pair {
    px: u64[]
    py: u64[]
    qx: u64[]
    qy: u64[]
    minus_qy: u64[]
    t: Point
}

struct Line {
    at_y: u64[]
    at_x: u64[]
    rest: u64[]
}

fn line_of(c: *Curve) -> Line {
    let n = 2 * c.l
    Line { at_y: take(c, n), at_x: take(c, n), rest: take(c, n) }
}

fn evaluate(c: *Curve, f: u64[], line: Line, pair: Pair) {
    let n = 2 * c.l
    let mark = c.top
    let sparse = take(c, 12 * c.l)
    limb.clear(sparse)
    fp2_scale(c, line.at_y, line.at_y, pair.py)
    fp2_scale(c, line.at_x, line.at_x, pair.px)
    match c.twist {
        D => {
            __memmove(sparse[..n], line.at_y)
            __memmove(sparse[3 * n..4 * n], line.at_x)
            __memmove(sparse[4 * n..5 * n], line.rest)
        }
        M => {
            __memmove(sparse[..n], line.rest)
            __memmove(sparse[n..2 * n], line.at_x)
            __memmove(sparse[4 * n..5 * n], line.at_y)
        }
    }
    fp12_mul(c, f, f, sparse)
    c.top = mark
}

fn double_step(c: *Curve, t: Point, line: Line) {
    let n = 2 * c.l
    let mark = c.top
    let a = take(c, n)
    let b = take(c, n)
    let cc = take(c, n)
    let e = take(c, n)
    let f = take(c, n)
    let g = take(c, n)
    let h = take(c, n)
    let j = take(c, n)
    fp2_mul(c, a, t.x, t.y)
    fp2_scale(c, a, a, c.half)
    fp2_square(c, b, t.y)
    fp2_square(c, cc, t.z)
    fp2_add(c, e, cc, cc)
    fp2_add(c, e, e, cc)
    fp2_mul(c, e, e, c.b2)
    fp2_add(c, f, e, e)
    fp2_add(c, f, f, e)
    fp2_add(c, g, b, f)
    fp2_scale(c, g, g, c.half)
    fp2_add(c, h, t.y, t.z)
    fp2_square(c, h, h)
    fp2_sub(c, h, h, b)
    fp2_sub(c, h, h, cc)
    fp2_square(c, j, t.x)
    fp2_neg(c, line.at_y, h)
    fp2_add(c, line.at_x, j, j)
    fp2_add(c, line.at_x, line.at_x, j)
    fp2_sub(c, line.rest, e, b)
    fp2_sub(c, t.x, b, f)
    fp2_mul(c, t.x, t.x, a)
    fp2_square(c, e, e)
    fp2_add(c, j, e, e)
    fp2_add(c, j, j, e)
    fp2_square(c, t.y, g)
    fp2_sub(c, t.y, t.y, j)
    fp2_mul(c, t.z, b, h)
    c.top = mark
}

fn add_step(c: *Curve, t: Point, qx: u64[], qy: u64[], line: Line) {
    let n = 2 * c.l
    let mark = c.top
    let o = take(c, n)
    let k = take(c, n)
    let d = take(c, n)
    let e = take(c, n)
    let f = take(c, n)
    let g = take(c, n)
    let h = take(c, n)
    fp2_mul(c, o, qy, t.z)
    fp2_sub(c, o, t.y, o)
    fp2_mul(c, k, qx, t.z)
    fp2_sub(c, k, t.x, k)
    fp2_square(c, f, o)
    fp2_mul(c, f, f, t.z)
    fp2_square(c, d, k)
    fp2_mul(c, e, k, d)
    fp2_mul(c, g, t.x, d)
    fp2_add(c, h, e, f)
    fp2_sub(c, h, h, g)
    fp2_sub(c, h, h, g)
    fp2_mul(c, t.x, k, h)
    fp2_sub(c, g, g, h)
    fp2_mul(c, g, g, o)
    fp2_mul(c, f, t.y, e)
    fp2_sub(c, t.y, g, f)
    fp2_mul(c, t.z, t.z, e)
    __memmove(line.at_y, k)
    fp2_neg(c, line.at_x, o)
    fp2_mul(c, line.rest, qx, o)
    fp2_mul(c, d, k, qy)
    fp2_sub(c, line.rest, line.rest, d)
    c.top = mark
}

fn frobenius_twist(c: *Curve, x: u64[], y: u64[]) {
    let n = 2 * c.l
    fp2_conj(c, x, x)
    fp2_mul(c, x, x, c.gamma[2 * n..3 * n])
    fp2_conj(c, y, y)
    fp2_mul(c, y, y, c.gamma[3 * n..4 * n])
}

fn bn_tail(c: *Curve, f: u64[], pairs: Pair[], line: Line) {
    let n = 2 * c.l
    for pair in pairs {
        let x: u64[] = __make(n)
        let y: u64[] = __make(n)
        __memmove(x, pair.qx)
        __memmove(y, pair.qy)
        frobenius_twist(c, x, y)
        add_step(c, pair.t, x, y, line)
        evaluate(c, f, line, pair)
        frobenius_twist(c, x, y)
        fp2_neg(c, y, y)
        add_step(c, pair.t, x, y, line)
        evaluate(c, f, line, pair)
    }
}

fn pair_of(c: *Curve, p: Point, q: Point) -> Pair? {
    let pa = affine(c, p) ?? return none
    let qa = affine(c, q) ?? return none
    let minus_qy: u64[] = __make(2 * c.l)
    fp2_neg(c, minus_qy, qa.y)
    Pair { px: pa.x, py: pa.y, qx: qa.x, qy: qa.y, minus_qy, t: clone(qa) }
}

fn miller(c: *Curve, ps: Point[], qs: Point[]) -> u64[] {
    var pairs: Pair[] = []
    for i in 0..ps.len {
        match pair_of(c, ps[i], qs[i]) {
            some(found) => pairs.push(found)
            none => {}
        }
    }
    let f: u64[] = __make(12 * c.l)
    fp12_one(c, f)
    let mark = c.top
    let line = line_of(c)
    for i in 1..c.digits.len {
        fp12_square(c, f, f)
        for pair in pairs {
            double_step(c, pair.t, line)
            evaluate(c, f, line, pair)
            let digit = c.digits[i]
            if digit != 0 {
                let y = if digit > 0 { pair.qy } else { pair.minus_qy }
                add_step(c, pair.t, pair.qx, y, line)
                evaluate(c, f, line, pair)
            }
        }
    }
    match c.family {
        Bn => bn_tail(c, f, pairs, line)
        Bls12 => {}
    }
    if c.negative {
        fp12_conj(c, f, f)
    }
    c.top = mark
    f
}

fn final_exponentiation(c: *Curve, f: u64[]) -> u64[] {
    let out: u64[] = __make(12 * c.l)
    let mark = c.top
    let t = take(c, 12 * c.l)
    fp12_inverse(c, t, f)
    fp12_conj(c, out, f)
    fp12_mul(c, out, out, t)
    fp12_frobenius(c, t, out)
    fp12_frobenius(c, t, t)
    fp12_mul(c, out, out, t)
    fp12_power(c, out, out, c.hard)
    c.top = mark
    out
}

/// Returns the optimal ate pairing `e(p, q)` of a point of `G1` and a point of `G2`, an element of `Fp12`; either point at infinity gives `1`.
///
/// The Miller loop and the final exponentiation follow public loop constants, and the points are taken as public: the running time depends on them.
pub fn pair(c: *Curve, p: Point, q: Point) -> u64[] {
    final_exponentiation(c, miller(c, [p], [q]))
}

/// Returns whether the product of `e(ps[i], qs[i])` over all `i` is `1`, sharing one Miller loop squaring chain and one final exponentiation. `ps` and `qs` must have the same length.
///
/// The points are taken as public: the running time depends on them.
pub fn check(c: *Curve, ps: Point[], qs: Point[]) -> bool {
    let product = final_exponentiation(c, miller(c, ps, qs))
    let one: u64[] = __make(12 * c.l)
    fp12_one(c, one)
    limb.equal(product, one)
}

/// Returns the identity of `GT`, the element `1` of `Fp12`.
pub fn gt_one(c: *Curve) -> u64[] {
    let out: u64[] = __make(12 * c.l)
    fp12_one(c, out)
    out
}

/// Returns the product `a b` of two elements of `GT`.
pub fn gt_mul(c: *Curve, a: u64[], b: u64[]) -> u64[] {
    let out: u64[] = __make(12 * c.l)
    fp12_mul(c, out, a, b)
    out
}

/// Returns `a` raised to the plain integer `exponent`, least significant limb first. The exponent must be public.
pub fn gt_pow(c: *Curve, a: u64[], exponent: u64[]) -> u64[] {
    let out: u64[] = __make(12 * c.l)
    fp12_power(c, out, a, exponent)
    out
}

/// Returns whether the elements `a` and `b` of `GT` are equal.
pub fn gt_equal(a: u64[], b: u64[]) -> bool {
    limb.equal(a, b)
}
