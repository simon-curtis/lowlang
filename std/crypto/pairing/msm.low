import std/crypto/limb

fn window_bits(count: i64) -> i64 {
    if count < 8 {
        return 2
    }
    if count < 64 {
        return 4
    }
    if count < 1024 {
        return 6
    }
    8
}

fn digit(scalar: u64[], start: i64, bits: i64) -> u64 {
    let at = start >> 6
    let shift = start & 63
    var value = scalar[at] >> shift
    if shift + bits > 64 && at + 1 < scalar.len {
        value |= scalar[at + 1] << (64 - shift)
    }
    value & ((1 << bits) - 1)
}

fn buckets_of(c: *Curve, n: i64, count: i64) -> Point[] {
    var out: Point[] = []
    for _ in 0..count {
        out.push(infinity_of(c, n))
    }
    out
}

fn reset(c: *Curve, buckets: Point[]) {
    for b in buckets {
        field_one(c, b.x)
        field_one(c, b.y)
        limb.clear(b.z)
    }
}

fn bucket_sum(c: *Curve, acc: Point, buckets: Point[]) {
    let n = acc.x.len
    let running = infinity_of(c, n)
    let total = infinity_of(c, n)
    var k = buckets.len - 1
    for k >= 1 {
        add_into(c, running, running, buckets[k])
        add_into(c, total, total, running)
        k -= 1
    }
    add_into(c, acc, acc, total)
}

fn longest(scalars: u64[][]) -> i64 {
    var most = 0
    for s in scalars {
        if s.len > most {
            most = s.len
        }
    }
    most
}

fn widened(scalar: u64[], size: i64) -> u64[] {
    if scalar.len == size {
        return scalar
    }
    let out: u64[] = __make(size)
    __memmove(out, scalar)
    out
}

fn place_public(c: *Curve, buckets: Point[], point: Point, value: u64) {
    if value != 0 {
        add_into(c, buckets[value], buckets[value], point)
    }
}

fn place_secret(c: *Curve, buckets: Point[], slot: Point, point: Point, value: u64) {
    lookup(slot, buckets, value)
    add_into(c, slot, slot, point)
    for k, b in buckets {
        choose_point(b, slot, b, limb.mask_of(limb.same(u64(k), value)))
    }
}

fn pippenger(c: *Curve, points: Point[], scalars: u64[][], secret: bool) -> Point {
    if points.len == 0 {
        return g1_infinity(c)
    }
    let size = longest(scalars)
    let degree = points[0].x.len
    let acc = infinity_of(c, degree)
    let full = window_bits(points.len)
    let bits = if secret && full > 4 { 4 } else { full }
    let buckets = buckets_of(c, degree, 1 << bits)
    let slot = blank(degree)
    var wide: u64[][] = []
    for s in scalars {
        wide.push(widened(s, size))
    }
    var window = (size * 64 + bits - 1) / bits - 1
    for window >= 0 {
        for _ in 0..bits {
            double_into(c, acc, acc)
        }
        reset(c, buckets)
        for i in 0..points.len {
            let value = digit(wide[i], window * bits, bits)
            if secret {
                place_secret(c, buckets, slot, points[i], value)
            } else {
                place_public(c, buckets, points[i], value)
            }
        }
        bucket_sum(c, acc, buckets)
        window -= 1
    }
    acc
}

/// Returns the sum of `scalars[i] points[i]` with Pippenger's bucket method, for points of one group and plain integer scalars of limbs, least significant first. No points give the point at infinity of `G1`.
///
/// Which bucket a point joins depends on the scalars, so the running time and the memory accesses depend on them: use it when the scalars are public, as in verification. `msm_secret` hides them.
pub fn msm(c: *Curve, points: Point[], scalars: u64[][]) -> Point {
    pippenger(c, points, scalars, false)
}

/// Returns the sum of `scalars[i] points[i]` with Pippenger's bucket method, reading and writing every bucket for each point and adding with complete formulas, so the running time and the memory accesses depend only on the number of points and the number of limbs of the longest scalar.
///
/// Use it when the scalars are secret, as for a prover's witness.
pub fn msm_secret(c: *Curve, points: Point[], scalars: u64[][]) -> Point {
    pippenger(c, points, scalars, true)
}
