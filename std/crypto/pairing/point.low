import std/crypto/limb
import std/crypto/nistec

/// Sets `d` to `a + b` in `Fp` when `a` has `l` limbs and in `Fp2` when it has `2 l`. `d` can be `a` or `b`.
pub fn field_add(c: *Curve, d: u64[], a: u64[], b: u64[]) {
    if a.len == c.l {
        nistec.add(c.fp, d, a, b)
    } else {
        fp2_add(c, d, a, b)
    }
}

/// Sets `d` to `a - b` in `Fp` or `Fp2`, by the length of `a`. `d` can be `a` or `b`.
pub fn field_sub(c: *Curve, d: u64[], a: u64[], b: u64[]) {
    if a.len == c.l {
        nistec.sub(c.fp, d, a, b)
    } else {
        fp2_sub(c, d, a, b)
    }
}

/// Sets `d` to `a b` in `Fp` or `Fp2`, by the length of `a`. `d` can be `a` or `b`.
pub fn field_mul(c: *Curve, d: u64[], a: u64[], b: u64[]) {
    if a.len == c.l {
        nistec.mul(c.fp, d, a, b)
    } else {
        fp2_mul(c, d, a, b)
    }
}

/// Sets `d` to `a^2` in `Fp` or `Fp2`, by the length of `a`. `d` can be `a`.
pub fn field_square(c: *Curve, d: u64[], a: u64[]) {
    if a.len == c.l {
        nistec.mul(c.fp, d, a, a)
    } else {
        fp2_square(c, d, a)
    }
}

/// Sets `d` to the inverse of `a` in `Fp` or `Fp2`, by the length of `a`, or zero for zero. `d` can be `a`. The running time does not depend on `a`.
pub fn field_inverse(c: *Curve, d: u64[], a: u64[]) {
    if a.len == c.l {
        nistec.invert(c.fp, d, a)
    } else {
        fp2_inverse(c, d, a)
    }
}

/// Sets `d` to `-a` in `Fp` or `Fp2`, by the length of `a`. `d` can be `a`.
pub fn field_neg(c: *Curve, d: u64[], a: u64[]) {
    let zero_a: u64[] = __make(a.len)
    field_sub(c, d, zero_a, a)
}

/// Sets `d` to `a` raised to the plain integer `exponent`, least significant limb first, in `Fp` or `Fp2` by the length of `a`. The squarings and multiplications follow the bits of `exponent`, so it must be public; `a` can be secret.
pub fn field_power(c: *Curve, d: u64[], a: u64[], exponent: u64[]) {
    if a.len == c.l {
        nistec.power(c.fp, d, a, exponent)
    } else {
        fp2_power(c, d, a, exponent)
    }
}

fn field_one(c: *Curve, d: u64[]) {
    limb.clear(d)
    __memmove(d[..c.l], c.fp.one)
}

fn coefficient(c: *Curve, n: i64) -> u64[] {
    if n == c.l { c.b } else { c.b2 }
}

fn blank(n: i64) -> Point {
    Point { x: __make(n), y: __make(n), z: __make(n) }
}

fn infinity_of(c: *Curve, n: i64) -> Point {
    let out = blank(n)
    field_one(c, out.x)
    field_one(c, out.y)
    out
}

fn copy_point(out: Point, a: Point) {
    __memmove(out.x, a.x)
    __memmove(out.y, a.y)
    __memmove(out.z, a.z)
}

fn clone(a: Point) -> Point {
    let out = blank(a.x.len)
    copy_point(out, a)
    out
}

fn choose_point(out: Point, a: Point, b: Point, mask: u64) {
    limb.choose(out.x, a.x, b.x, mask)
    limb.choose(out.y, a.y, b.y, mask)
    limb.choose(out.z, a.z, b.z, mask)
}

/// Returns the point at infinity of `G1`.
pub fn g1_infinity(c: *Curve) -> Point {
    infinity_of(c, c.l)
}

/// Returns the point at infinity of `G2`.
pub fn g2_infinity(c: *Curve) -> Point {
    infinity_of(c, 2 * c.l)
}

/// Returns whether `a` is the point at infinity.
pub fn is_infinity(a: Point) -> bool {
    limb.is_zero(a.z)
}

fn double_into(c: *Curve, out: Point, a: Point) {
    let n = a.x.len
    let mark = c.top
    let xx = take(c, n)
    let yy = take(c, n)
    let yyyy = take(c, n)
    let d = take(c, n)
    let e = take(c, n)
    let t = take(c, n)
    field_square(c, xx, a.x)
    field_square(c, yy, a.y)
    field_square(c, yyyy, yy)
    field_add(c, d, a.x, yy)
    field_square(c, d, d)
    field_sub(c, d, d, xx)
    field_sub(c, d, d, yyyy)
    field_add(c, d, d, d)
    field_add(c, e, xx, xx)
    field_add(c, e, e, xx)
    field_mul(c, out.z, a.y, a.z)
    field_add(c, out.z, out.z, out.z)
    field_square(c, t, e)
    field_sub(c, t, t, d)
    field_sub(c, out.x, t, d)
    field_sub(c, t, d, out.x)
    field_mul(c, t, e, t)
    field_add(c, yyyy, yyyy, yyyy)
    field_add(c, yyyy, yyyy, yyyy)
    field_add(c, yyyy, yyyy, yyyy)
    field_sub(c, out.y, t, yyyy)
    c.top = mark
}

fn add_into(c: *Curve, out: Point, a: Point, b: Point) {
    let n = a.x.len
    let mark = c.top
    let z1z1 = take(c, n)
    let z2z2 = take(c, n)
    let u1 = take(c, n)
    let u2 = take(c, n)
    let s1 = take(c, n)
    let s2 = take(c, n)
    let h = take(c, n)
    let i = take(c, n)
    let j = take(c, n)
    let r = take(c, n)
    let v = take(c, n)
    let sum = Point { x: take(c, n), y: take(c, n), z: take(c, n) }
    let twice = Point { x: take(c, n), y: take(c, n), z: take(c, n) }
    field_square(c, z1z1, a.z)
    field_square(c, z2z2, b.z)
    field_mul(c, u1, a.x, z2z2)
    field_mul(c, u2, b.x, z1z1)
    field_mul(c, s1, a.y, b.z)
    field_mul(c, s1, s1, z2z2)
    field_mul(c, s2, b.y, a.z)
    field_mul(c, s2, s2, z1z1)
    field_sub(c, h, u2, u1)
    field_add(c, i, h, h)
    field_square(c, i, i)
    field_mul(c, j, h, i)
    field_sub(c, r, s2, s1)
    field_add(c, r, r, r)
    field_mul(c, v, u1, i)
    field_square(c, sum.x, r)
    field_sub(c, sum.x, sum.x, j)
    field_sub(c, sum.x, sum.x, v)
    field_sub(c, sum.x, sum.x, v)
    field_sub(c, sum.y, v, sum.x)
    field_mul(c, sum.y, sum.y, r)
    field_mul(c, s1, s1, j)
    field_add(c, s1, s1, s1)
    field_sub(c, sum.y, sum.y, s1)
    field_add(c, sum.z, a.z, b.z)
    field_square(c, sum.z, sum.z)
    field_sub(c, sum.z, sum.z, z1z1)
    field_sub(c, sum.z, sum.z, z2z2)
    field_mul(c, sum.z, sum.z, h)
    double_into(c, twice, a)
    let a_infinite = limb.zero_limbs(a.z)
    let b_infinite = limb.zero_limbs(b.z)
    let doubling = limb.zero_limbs(h) & limb.zero_limbs(r)
    choose_point(sum, twice, sum, limb.mask_of(doubling))
    choose_point(sum, b, sum, limb.mask_of(a_infinite))
    choose_point(sum, a, sum, limb.mask_of(b_infinite))
    copy_point(out, sum)
    c.top = mark
}

/// Returns `a + b` for two points of the same group, with formulas that cover doubling, inverses and infinity through masks, so the running time does not depend on the points.
pub fn add(c: *Curve, a: Point, b: Point) -> Point {
    let out = blank(a.x.len)
    add_into(c, out, a, b)
    out
}

/// Returns `2 a`.
pub fn double(c: *Curve, a: Point) -> Point {
    let out = blank(a.x.len)
    double_into(c, out, a)
    out
}

/// Returns `-a`.
pub fn neg(c: *Curve, a: Point) -> Point {
    let out = clone(a)
    field_neg(c, out.y, a.y)
    out
}

fn lookup(entry: Point, table: Point[], index: u64) {
    limb.clear(entry.x)
    limb.clear(entry.y)
    limb.clear(entry.z)
    for k, row in table {
        let mask = limb.mask_of(limb.same(u64(k), index))
        limb.gather(entry.x, row.x, mask)
        limb.gather(entry.y, row.y, mask)
        limb.gather(entry.z, row.z, mask)
    }
}

/// Returns `scalar a` for a plain integer `scalar` of limbs, least significant first, of any length; it is not reduced.
///
/// The scalar is read in 4-bit windows from a table of 16 multiples through a lookup that reads every entry, and every addition is complete, so the running time and the memory accesses depend only on the number of limbs of `scalar`.
pub fn mul(c: *Curve, a: Point, scalar: u64[]) -> Point {
    let n = a.x.len
    var table: Point[] = [infinity_of(c, n)]
    for k in 1..16 {
        let next = blank(n)
        add_into(c, next, table[k - 1], a)
        table.push(next)
    }
    let acc = infinity_of(c, n)
    let entry = blank(n)
    var i = scalar.len * 16 - 1
    for i >= 0 {
        for _ in 0..4 {
            double_into(c, acc, acc)
        }
        lookup(entry, table, (scalar[i >> 4] >> (4 * (i & 15))) & 15)
        add_into(c, acc, acc, entry)
        i -= 1
    }
    acc
}

/// Returns `scalar a` by doubling and adding along the bits of the plain integer `scalar`, least significant limb first.
///
/// The sequence of doublings and additions follows the bits of `scalar`, which must be public, such as a group order or a cofactor; it does not depend on `a`.
pub fn mul_public(c: *Curve, a: Point, scalar: u64[]) -> Point {
    let acc = infinity_of(c, a.x.len)
    var i = scalar.len * 64 - 1
    for i >= 0 {
        double_into(c, acc, acc)
        if (scalar[i >> 6] >> (i & 63)) & 1 == 1 {
            add_into(c, acc, acc, a)
        }
        i -= 1
    }
    acc
}

/// Returns whether `a` and `b` are the same point, comparing `X1 Z2^2` with `X2 Z1^2` and `Y1 Z2^3` with `Y2 Z1^3`.
pub fn equal(c: *Curve, a: Point, b: Point) -> bool {
    let n = a.x.len
    let a_infinite = is_infinity(a)
    let b_infinite = is_infinity(b)
    if a_infinite || b_infinite {
        return a_infinite && b_infinite
    }
    let mark = c.top
    let z1z1 = take(c, n)
    let z2z2 = take(c, n)
    let left = take(c, n)
    let right = take(c, n)
    field_square(c, z1z1, a.z)
    field_square(c, z2z2, b.z)
    field_mul(c, left, a.x, z2z2)
    field_mul(c, right, b.x, z1z1)
    let xs = limb.equal(left, right)
    field_mul(c, z1z1, z1z1, a.z)
    field_mul(c, z2z2, z2z2, b.z)
    field_mul(c, left, a.y, z2z2)
    field_mul(c, right, b.y, z1z1)
    let ys = limb.equal(left, right)
    c.top = mark
    xs && ys
}

/// Returns `a` scaled to `Z = 1`, or `none` for the point at infinity.
pub fn affine(c: *Curve, a: Point) -> Point? {
    if is_infinity(a) {
        return none
    }
    let n = a.x.len
    let out = blank(n)
    let inverse: u64[] = __make(n)
    let t: u64[] = __make(n)
    field_inverse(c, inverse, a.z)
    field_square(c, t, inverse)
    field_mul(c, out.x, a.x, t)
    field_mul(c, t, t, inverse)
    field_mul(c, out.y, a.y, t)
    field_one(c, out.z)
    out
}

/// Returns the point with the affine coordinates `x` and `y` in Montgomery form, `l` limbs each for `G1` and `2 l` for `G2`, without checking that it is on the curve.
pub fn from_affine(c: *Curve, x: u64[], y: u64[]) -> Point {
    let out = blank(x.len)
    __memmove(out.x, x)
    __memmove(out.y, y)
    field_one(c, out.z)
    out
}

/// Returns whether `a` satisfies `Y^2 = X^3 + b Z^6`, with the coefficient of `G1` or of the twist by the size of its coordinates. The point at infinity is on the curve.
pub fn on_curve(c: *Curve, a: Point) -> bool {
    let n = a.x.len
    let mark = c.top
    let left = take(c, n)
    let right = take(c, n)
    let z6 = take(c, n)
    field_square(c, left, a.y)
    field_square(c, right, a.x)
    field_mul(c, right, right, a.x)
    field_square(c, z6, a.z)
    field_mul(c, z6, z6, a.z)
    field_square(c, z6, z6)
    field_mul(c, z6, z6, coefficient(c, n))
    field_add(c, right, right, z6)
    let ok = limb.equal(left, right)
    c.top = mark
    ok
}

/// Returns whether `a` is on the curve and `r a` is the point at infinity, so that `a` lies in the subgroup of prime order `r`.
pub fn in_subgroup(c: *Curve, a: Point) -> bool {
    on_curve(c, a) && is_infinity(mul_public(c, a, c.fr.m))
}
