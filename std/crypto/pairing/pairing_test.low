import std/crypto/nistec
import std/testing
import std/text

fn plain(c: *Curve, value: u64) -> u64[] {
    let out: u64[] = __make(c.fr.m.len)
    out[0] = value
    out
}

fn gt_slots(c: *Curve, e: u64[]) -> str[] {
    var out: str[] = []
    for i in 0..6 {
        let at = slot(c, i)
        let real: u64[] = __make(c.l)
        let imaginary: u64[] = __make(c.l)
        nistec.from_mont(c.fp, real, e[at..at + c.l])
        nistec.from_mont(c.fp, imaginary, e[at + c.l..at + 2 * c.l])
        out.push(text.encode_hex(nistec.encode(real)) + text.encode_hex(nistec.encode(imaginary)))
    }
    out
}

