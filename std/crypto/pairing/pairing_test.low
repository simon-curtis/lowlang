/// The BN254 value is py_ecc 8.0's `pairing(G2, G1)`, rewritten from its degree-12 basis over `Fp` to the coefficients of `w^0` to `w^5` over `Fp2`. The BLS12-381 value is gnark-crypto 0.22's `Pair` of the generators: the cube of py_ecc's value with `w` negated, since py_ecc neither conjugates for the negative `x` nor cubes.
fn test_generator_pairing_matches_reference_implementations(t: *testing.T) {
    let bn = bn254()
    t.equal_slice(gt_slots(bn, pair(bn, bn.g1, bn.g2)), bn254_generator_pairing())
    let bls = bls12_381()
    t.equal_slice(gt_slots(bls, pair(bls, bls.g1, bls.g2)), bls12_381_generator_pairing())
}

fn multiples(c: *Curve, base: Point, count: i64) -> Point[] {
    var out: Point[] = []
    for i in 0..count {
        out.push(mul(c, base, plain(c, u64(3 * i + 1))))
    }
    out
}

fn scalars_of(c: *Curve, count: i64) -> u64[][] {
    var out: u64[][] = []
    for i in 0..count {
        let s: u64[] = __make(c.fr.m.len)
        s[0] = 0x9e3779b97f4a7c15 * u64(i + 1)
        s[1] = u64(i) * 77
        s[c.fr.m.len - 1] = u64(i) & 0xfff
        out.push(s)
    }
    out
}

fn naive(c: *Curve, points: Point[], scalars: u64[][]) -> Point {
    var acc = infinity_of(c, points[0].x.len)
    for i in 0..points.len {
        acc = add(c, acc, mul_public(c, points[i], scalars[i]))
    }
    acc
}

fn test_msm_matches_a_sum_of_scalar_multiplications(t: *testing.T) {
    let c = bn254()
    for count in [1, 5, 20] {
        for base in [c.g1, c.g2] {
            let points = multiples(c, base, count)
            let scalars = scalars_of(c, count)
            let want = naive(c, points, scalars)
            t.is_true(equal(c, msm(c, points, scalars), want))
            t.is_true(equal(c, msm_secret(c, points, scalars), want))
        }
    }
}

fn test_msm_handles_repeated_and_opposite_points(t: *testing.T) {
    let c = bls12_381()
    let p = c.g1
    let points = [p, p, neg(c, p), g1_infinity(c), p]
    let one = plain(c, 1)
    let scalars = [one, one, one, plain(c, 9), plain(c, 5)]
    let want = mul(c, p, plain(c, 6))
    t.is_true(equal(c, msm(c, points, scalars), want))
    t.is_true(equal(c, msm_secret(c, points, scalars), want))
}

fn test_complete_addition_covers_doubling_inverses_and_infinity(t: *testing.T) {
    for c in [bn254(), bls12_381()] {
        for p in [c.g1, c.g2] {
            let o = infinity_of(c, p.x.len)
            let scaled = mul(c, p, plain(c, 5))
            t.is_true(equal(c, add(c, scaled, scaled), double(c, scaled)))
            t.is_true(is_infinity(add(c, scaled, neg(c, scaled))))
            t.is_true(equal(c, add(c, o, scaled), scaled))
            t.is_true(equal(c, add(c, scaled, o), scaled))
            t.is_true(is_infinity(add(c, o, o)))
            t.is_true(equal(c, mul(c, p, plain(c, 77)), mul_public(c, p, plain(c, 77))))
            t.is_false(equal(c, scaled, p))
        }
    }
}

fn test_scalar_multiplication_by_the_order_wraps_to_infinity(t: *testing.T) {
    for c in [bn254(), bls12_381()] {
        t.is_true(is_infinity(mul(c, c.g1, c.fr.m)))
        t.is_true(is_infinity(mul(c, c.g2, c.fr.m)))
        let below: u64[] = __make(c.fr.m.len)
        __memmove(below, c.fr.m)
        below[0] -= 1
        t.is_true(equal(c, mul(c, c.g1, below), neg(c, c.g1)))
    }
}
