import std/crypto/ecdsa
import std/crypto/hash
import std/io
import std/text

/// Signs a SHA-256 digest with a P-256 key in raw and DER form, verifies both, rejects a tampered digest, and derives an ECDH secret both sides agree on.
fn main() ! io.Error {
    let sha256 = hash.sha256()
    let alice = hash.sum(sha256, bytes("alice"))
    let bob = hash.sum(sha256, bytes("bob"))

    let public = ecdsa.public_key(ecdsa.Curve.P256, alice)?
    let point = ecdsa.coordinates(ecdsa.Curve.P256, public) ?? return
    print("public x {text.encode_hex(point.x)}")
    print("public y {text.encode_hex(point.y)}")

    let digest = hash.sum(sha256, bytes("pay 10 to carol"))
    let raw = ecdsa.sign_raw(ecdsa.Curve.P256, alice, digest)?
    let encoded = ecdsa.sign(ecdsa.Curve.P256, alice, digest)?
    print("raw signature {text.encode_hex(raw)}")
    print("der signature is {encoded.len} bytes")

    print("raw verifies: {ecdsa.verify_raw(ecdsa.Curve.P256, public, digest, raw)}")
    print("der verifies: {ecdsa.verify(ecdsa.Curve.P256, public, digest, encoded)}")
    let other = hash.sum(sha256, bytes("pay 99 to carol"))
    print("other digest verifies: {ecdsa.verify(ecdsa.Curve.P256, public, other, encoded)}")
    print("raw signature given to der verify: {ecdsa.verify(ecdsa.Curve.P256, public, digest, raw)}")

    let bob_public = ecdsa.public_key(ecdsa.Curve.P256, bob)?
    let from_alice = ecdsa.ecdh(ecdsa.Curve.P256, alice, bob_public)?
    let from_bob = ecdsa.ecdh(ecdsa.Curve.P256, bob, public)?
    print("ecdh {text.encode_hex(from_alice)}")
    print("both agree: {hash.equal(from_alice, from_bob)}")

    let generated = ecdsa.generate(ecdsa.Curve.P384)
    print("p384 scalar is {generated.len} bytes")
}
