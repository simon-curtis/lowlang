import std/crypto/limb

/// An elliptic curve supported by the module.
pub enum Curve {
    /// NIST P-256 (secp256r1, FIPS 186-4), with 32-byte scalars and field elements.
    P256
    /// NIST P-384 (secp384r1, FIPS 186-4), with 48-byte scalars and field elements.
    P384
}

struct Point {
    x: []u64
    y: []u64
    z: []u64
}

struct Group {
    size: i64
    p: *Field
    n: *Field
    b: []u64
    g: Point
    t0: []u64
    t1: []u64
    t2: []u64
    t3: []u64
    t4: []u64
    x3: []u64
    y3: []u64
    z3: []u64
}

struct Constants {
    p: str
    n: str
    b: str
    gx: str
    gy: str
}

fn constants(curve: Curve) -> Constants {
    match curve {
        P256 => Constants {
            p: "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"
            n: "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"
            b: "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b"
            gx: "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"
            gy: "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"
        }
        P384 => Constants {
            p: "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff"
            n: "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"
            b: "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef"
            gx: "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7"
            gy: "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"
        }
    }
}

fn group(curve: Curve) -> *Group {
    let c = constants(curve)
    let p = field(hex_limbs(c.p))
    let n = field(hex_limbs(c.n))
    let b = element(p)
    to_mont(p, b, hex_limbs(c.b))
    let gx = element(p)
    to_mont(p, gx, hex_limbs(c.gx))
    let gy = element(p)
    to_mont(p, gy, hex_limbs(c.gy))
    let z = element(p)
    __memmove(z, p.one)
    new(Group {
        size: scalar_size(curve)
        p
        n
        b
        g: Point { x: gx, y: gy, z }
        t0: element(p)
        t1: element(p)
        t2: element(p)
        t3: element(p)
        t4: element(p)
        x3: element(p)
        y3: element(p)
        z3: element(p)
    })
}

fn infinity(g: *Group) -> Point {
    let y = element(g.p)
    __memmove(y, g.p.one)
    Point { x: element(g.p), y, z: element(g.p) }
}

fn point_add(g: *Group, out: Point, a: Point, c: Point) {
    let f = g.p
    let t0 = g.t0
    let t1 = g.t1
    let t2 = g.t2
    let t3 = g.t3
    let t4 = g.t4
    let x3 = g.x3
    let y3 = g.y3
    let z3 = g.z3
    mul(f, t0, a.x, c.x)
    mul(f, t1, a.y, c.y)
    mul(f, t2, a.z, c.z)
    add(f, t3, a.x, a.y)
    add(f, t4, c.x, c.y)
    mul(f, t3, t3, t4)
    add(f, t4, t0, t1)
    sub(f, t3, t3, t4)
    add(f, t4, a.y, a.z)
    add(f, x3, c.y, c.z)
    mul(f, t4, t4, x3)
    add(f, x3, t1, t2)
    sub(f, t4, t4, x3)
    add(f, x3, a.x, a.z)
    add(f, y3, c.x, c.z)
    mul(f, x3, x3, y3)
    add(f, y3, t0, t2)
    sub(f, y3, x3, y3)
    mul(f, z3, g.b, t2)
    sub(f, x3, y3, z3)
    add(f, z3, x3, x3)
    add(f, x3, x3, z3)
    sub(f, z3, t1, x3)
    add(f, x3, t1, x3)
    mul(f, y3, g.b, y3)
    add(f, t1, t2, t2)
    add(f, t2, t1, t2)
    sub(f, y3, y3, t2)
    sub(f, y3, y3, t0)
    add(f, t1, y3, y3)
    add(f, y3, t1, y3)
    add(f, t1, t0, t0)
    add(f, t0, t1, t0)
    sub(f, t0, t0, t2)
    mul(f, t1, t4, y3)
    mul(f, t2, t0, y3)
    mul(f, y3, x3, z3)
    add(f, y3, y3, t2)
    mul(f, x3, t3, x3)
    sub(f, x3, x3, t1)
    mul(f, z3, t4, z3)
    mul(f, t1, t3, t0)
    add(f, z3, z3, t1)
    __memmove(out.x, x3)
    __memmove(out.y, y3)
    __memmove(out.z, z3)
}

fn lookup(entry: Point, table: []Point, index: u64) {
    limb.clear(entry.x)
    limb.clear(entry.y)
    limb.clear(entry.z)
    for k, row in table {
        let mask = limb.mask_of(limb.same(u64(k), index))
        limb.gather(entry.x, row.x, mask)
        limb.gather(entry.y, row.y, mask)
        limb.gather(entry.z, row.z, mask)
    }
}

fn scalar_mul(g: *Group, base: Point, scalar: []u8) -> Point {
    var table: []Point = []
    push(mut table, infinity(g))
    for i in 1..16 {
        let next = infinity(g)
        point_add(g, next, table[i - 1], base)
        push(mut table, next)
    }
    let acc = infinity(g)
    let entry = infinity(g)
    for byte in scalar {
        for half in 0..2 {
            for _ in 0..4 {
                point_add(g, acc, acc, acc)
            }
            let nibble = if half == 0 { byte >> 4 } else { byte & 15 }
            lookup(entry, table, u64(nibble))
            point_add(g, acc, acc, entry)
        }
    }
    acc
}

fn affine(g: *Group, a: Point) -> Point? {
    if limb.is_zero(a.z) {
        return none
    }
    let f = g.p
    let zinv = element(f)
    invert(f, zinv, a.z)
    let x = element(f)
    mul(f, x, a.x, zinv)
    let y = element(f)
    mul(f, y, a.y, zinv)
    let z = element(f)
    __memmove(z, f.one)
    Point { x, y, z }
}

fn on_curve(g: *Group, x: []u64, y: []u64) -> bool {
    let f = g.p
    let left = element(f)
    mul(f, left, y, y)
    let right = element(f)
    mul(f, right, x, x)
    mul(f, right, right, x)
    let triple = element(f)
    add(f, triple, x, x)
    add(f, triple, triple, x)
    sub(f, right, right, triple)
    add(f, right, right, g.b)
    limb.equal(left, right)
}

fn encode_point(g: *Group, a: Point) -> []u8 {
    let f = g.p
    let x = element(f)
    from_mont(f, x, a.x)
    let y = element(f)
    from_mont(f, y, a.y)
    sec1_point(encode(x), encode(y))
}

fn sec1_point(x: []u8, y: []u8) -> []u8 {
    let out: []u8 = __make(1 + x.len + y.len)
    out[0] = 4
    __memmove(out[1..], x)
    __memmove(out[1 + x.len..], y)
    out
}

fn split_point(size: i64, data: []u8) -> Coordinates? {
    Coordinates { x: data[1..1 + size], y: data[1 + size..] } when data.len == 1 + 2 * size && data[0] == 4
}

fn decode_point(g: *Group, data: []u8) -> Point? {
    let c = match split_point(g.size, data) {
        some(found) => found
        none => return none
    }
    let f = g.p
    let l = f.m.len
    let rx = limb.from_bytes(c.x, l)
    let ry = limb.from_bytes(c.y, l)
    if !below(rx, f.m) || !below(ry, f.m) {
        return none
    }
    let x = element(f)
    to_mont(f, x, rx)
    let y = element(f)
    to_mont(f, y, ry)
    if !on_curve(g, x, y) {
        return none
    }
    let z = element(f)
    __memmove(z, f.one)
    Point { x, y, z }
}
