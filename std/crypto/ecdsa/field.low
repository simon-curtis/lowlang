import std/crypto/limb

struct Field {
    m: []u64
    inv: u64
    r2: []u64
    one: []u64
    unit: []u64
    t: []u64
    w: []u64
}

fn field(modulus: []u64) -> *Field {
    let l = modulus.len
    var inv: u64 = 1
    for _ in 0..6 {
        inv = inv * (2 - modulus[0] * inv)
    }
    let unit: []u64 = __make(l)
    unit[0] = 1
    let f = new(Field { m: modulus, inv: 0 - inv, r2: __make(l), one: __make(l), unit, t: __make(l + 2), w: __make(l) })
    let x: []u64 = __make(l)
    x[0] = 1
    for _ in 0..64 * l {
        add(f, x, x, x)
    }
    __memmove(f.one, x)
    for _ in 0..64 * l {
        add(f, x, x, x)
    }
    __memmove(f.r2, x)
    f
}

fn element(f: *Field) -> []u64 {
    __make(f.m.len)
}

fn add(f: *Field, d: []u64, a: []u64, b: []u64) {
    let w = f.w
    let carry = limb.add(d, a, b)
    let borrow = limb.sub(w, d, f.m)
    let keep = limb.mask_of(carry | (borrow ^ 1))
    limb.choose(d, w, d, keep)
}

fn sub(f: *Field, d: []u64, a: []u64, b: []u64) {
    let borrow = limb.sub(d, a, b)
    limb.add_masked(d, f.m, limb.mask_of(borrow))
}

fn mul(f: *Field, d: []u64, a: []u64, b: []u64) {
    let m = f.m
    let t = f.t
    let l = m.len
    let inv = f.inv
    for j in 0..l + 2 {
        t[j] = 0
    }
    for i in 0..l {
        let bi = b[i]
        var c: u64 = 0
        for j in 0..l {
            let x = a[j]
            let lo = x * bi
            let hi = __mulhi(x, bi)
            let tj = t[j]
            let s1 = lo + tj
            let c1 = limb.carry(lo, tj, s1)
            let s2 = s1 + c
            let c2 = limb.carry(s1, c, s2)
            t[j] = s2
            c = hi + c1 + c2
        }
        let top = t[l]
        let sum = top + c
        t[l] = sum
        t[l + 1] = limb.carry(top, c, sum)
        let q = t[0] * inv
        let m0 = m[0]
        let lo0 = q * m0
        let t0 = t[0]
        let s0 = lo0 + t0
        c = __mulhi(q, m0) + limb.carry(lo0, t0, s0)
        for j in 1..l {
            let x = m[j]
            let lo = q * x
            let hi = __mulhi(q, x)
            let tj = t[j]
            let s1 = lo + tj
            let c1 = limb.carry(lo, tj, s1)
            let s2 = s1 + c
            let c2 = limb.carry(s1, c, s2)
            t[j - 1] = s2
            c = hi + c1 + c2
        }
        let last = t[l]
        let total = last + c
        t[l - 1] = total
        t[l] = t[l + 1] + limb.carry(last, c, total)
    }
    let w = f.w
    let borrow = limb.sub(w, t, m)
    let keep = limb.mask_of(t[l] | (borrow ^ 1))
    limb.choose(d, w, t, keep)
}

fn to_mont(f: *Field, d: []u64, a: []u64) {
    mul(f, d, a, f.r2)
}

fn from_mont(f: *Field, d: []u64, a: []u64) {
    mul(f, d, a, f.unit)
}

fn power(f: *Field, d: []u64, a: []u64, exponent: []u64) {
    let r = element(f)
    __memmove(r, f.one)
    var i = exponent.len - 1
    for i >= 0 {
        let word = exponent[i]
        var bit = 63
        for bit >= 0 {
            mul(f, r, r, r)
            if (word >> bit) & 1 == 1 {
                mul(f, r, r, a)
            }
            bit -= 1
        }
        i -= 1
    }
    __memmove(d, r)
}

fn invert(f: *Field, d: []u64, a: []u64) {
    let e = element(f)
    __memmove(e, f.m)
    e[0] -= 2
    power(f, d, a, e)
}

fn below(a: []u64, m: []u64) -> bool {
    let scratch: []u64 = __make(m.len)
    limb.sub(scratch, a, m) == 1
}

fn encode(a: []u64) -> []u8 {
    limb.to_bytes(a, a.len * 8)
}

fn hex_limbs(s: str) -> []u64 {
    let limbs = s.len / 16
    let out: []u64 = __make(limbs)
    for i in 0..s.len {
        let c = s[i]
        let v = if c >= '0' && c <= '9' { c - '0' } else { c - 'a' + 10 }
        let at = s.len - 1 - i
        out[at / 16] |= u64(v) << (4 * (at % 16))
    }
    out
}
