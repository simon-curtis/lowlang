import std/crypto/der
import std/io
import std/text

fn run() ! io.Error {
    let curve: []u8 = [0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07]
    let record = der.sequence([
        der.integer([0x01, 0x2c]),
        der.encode(0x0c, bytes("Ada Lovelace")),
        der.encode(0x06, curve),
        der.encode(0x17, bytes("261113120000Z")),
        der.encode(0x01, [0xff]),
    ])
    print("encoded {record.len} bytes: {text.encode_hex(record)}")

    let outer = der.whole(record, 0x30)?
    let fields = der.reader(outer.content)
    let id = der.unsigned(fields)?
    let name = der.expect(fields, 0x0c)?
    let oid = der.expect(fields, 0x06)?
    let issued = der.expect(fields, 0x17)?
    let active = der.expect(fields, 0x01)?
    der.finish(fields)?

    print("id {text.encode_hex(id)} is {der.small_int(id)?}")
    print("name {str(name.content)}")
    print("curve {der.oid(oid.content)?} is prime256v1: {der.oid(oid.content)? == der.prime256v1}")
    print("issued at unix time {der.time(issued)?}")
    print("active {der.boolean(active.content)?}")

    let cut = der.whole(record[..20], 0x30) or {
        print("a truncated record is malformed")
        return
    }
    print("accepted tag {cut.tag}")
}

/// Builds a small DER record with `sequence`, `integer` and `encode`, then walks it back with a `reader`, and shows that truncated input is rejected.
fn main() {
    run() catch {
        e => print("failed: {e}")
    }
}
