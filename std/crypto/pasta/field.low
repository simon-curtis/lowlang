import std/crypto/limb
import std/crypto/nistec

const two_adicity = 32

fn reversed_bytes(data: u8[]) -> u8[] {
    var out: u8[] = []
    var i = data.len - 1
    for i >= 0 {
        out.push(data[i])
        i -= 1
    }
    out
}

/// Returns the element 0 of `f`.
pub fn field_zero(f: *nistec.Field) -> u64[] {
    nistec.element(f)
}

/// Returns the element 1 of `f`.
pub fn field_one(f: *nistec.Field) -> u64[] {
    let out = nistec.element(f)
    __memmove(out, f.one)
    out
}

/// Returns `a + b`.
pub fn field_add(f: *nistec.Field, a: u64[], b: u64[]) -> u64[] {
    let out = nistec.element(f)
    nistec.add(f, out, a, b)
    out
}

/// Returns `a - b`.
pub fn field_sub(f: *nistec.Field, a: u64[], b: u64[]) -> u64[] {
    let out = nistec.element(f)
    nistec.sub(f, out, a, b)
    out
}

/// Returns `a * b`.
pub fn field_mul(f: *nistec.Field, a: u64[], b: u64[]) -> u64[] {
    let out = nistec.element(f)
    nistec.mul(f, out, a, b)
    out
}

/// Returns `a * a`.
pub fn field_square(f: *nistec.Field, a: u64[]) -> u64[] {
    field_mul(f, a, a)
}

/// Returns `-a`.
pub fn field_neg(f: *nistec.Field, a: u64[]) -> u64[] {
    field_sub(f, nistec.element(f), a)
}

/// Returns `a` raised to `exponent`, a plain integer of limbs, least significant first. The multiplications follow the bits of `exponent`.
pub fn field_pow(f: *nistec.Field, a: u64[], exponent: u64[]) -> u64[] {
    let out = nistec.element(f)
    nistec.power(f, out, a, exponent)
    out
}

/// Returns the inverse of `a`, and 0 for 0.
pub fn field_invert(f: *nistec.Field, a: u64[]) -> u64[] {
    let out = nistec.element(f)
    nistec.invert(f, out, a)
    out
}

/// Returns the element `value`.
pub fn field_from_u64(f: *nistec.Field, value: u64) -> u64[] {
    let plain = nistec.element(f)
    plain[0] = value
    let out = nistec.element(f)
    nistec.to_mont(f, out, plain)
    out
}

/// Returns the element of the plain integer `plain`, which must be below the modulus.
pub fn field_from_plain(f: *nistec.Field, plain: u64[]) -> u64[] {
    let out = nistec.element(f)
    nistec.to_mont(f, out, plain)
    out
}

/// Returns the plain integer, limbs least significant first, that the element `a` stands for.
pub fn field_to_plain(f: *nistec.Field, a: u64[]) -> u64[] {
    let out = nistec.element(f)
    nistec.from_mont(f, out, a)
    out
}

/// Returns the element of the 32-byte little-endian integer `data`, or none when `data` is not 32 bytes or the integer is not below the modulus.
pub fn field_from_bytes(f: *nistec.Field, data: u8[]) -> u64[]? {
    if data.len != 32 {
        return none
    }
    let plain = limb.from_bytes(reversed_bytes(data), 4)
    if !nistec.below(plain, f.m) {
        return none
    }
    field_from_plain(f, plain)
}

/// Returns the 32-byte little-endian integer that the element `a` stands for.
pub fn field_to_bytes(f: *nistec.Field, a: u64[]) -> u8[] {
    reversed_bytes(limb.to_bytes(field_to_plain(f, a), 32))
}

/// Returns the element of the 64-byte little-endian integer `data`, reduced modulo the modulus.
pub fn field_from_uniform(f: *nistec.Field, data: u8[]) -> u64[] {
    nistec.reduce_mont(f, reversed_bytes(data))
}

/// Returns whether `a` is zero.
pub fn field_is_zero(a: u64[]) -> bool {
    limb.is_zero(a)
}

/// Returns whether `a` and `b` are the same element.
pub fn field_equal(a: u64[], b: u64[]) -> bool {
    limb.equal(a, b)
}

/// Returns whether the integer that `a` stands for is odd.
pub fn field_is_odd(f: *nistec.Field, a: u64[]) -> bool {
    field_to_plain(f, a)[0] & 1 == 1
}

fn shifted_right(a: u64[], bits: i64) -> u64[] {
    let out: u64[] = __make(a.len)
    let words = bits / 64
    let rest = bits % 64
    for i in 0..a.len {
        let from = i + words
        if from < a.len {
            var v = a[from] >> rest
            if rest > 0 && from + 1 < a.len {
                v |= a[from + 1] << (64 - rest)
            }
            out[i] = v
        }
    }
    out
}

fn odd_part(f: *nistec.Field) -> u64[] {
    let minus_one = nistec.element(f)
    __memmove(minus_one, f.m)
    minus_one[0] -= 1
    shifted_right(minus_one, two_adicity)
}

/// Returns the element `5^t`, a root of unity of order `2^32`, where `modulus = t 2^32 + 1`, for a field whose multiplicative generator is 5.
pub fn field_root_of_unity(f: *nistec.Field) -> u64[] {
    field_pow(f, field_from_u64(f, 5), odd_part(f))
}

/// Returns `5^(2^32)`, an element of odd order `t`, for a field whose multiplicative generator is 5.
pub fn field_delta(f: *nistec.Field) -> u64[] {
    var out = field_from_u64(f, 5)
    for _ in 0..two_adicity {
        out = field_square(f, out)
    }
    out
}

/// Returns whether `a` is a square, zero included.
pub fn field_is_square(f: *nistec.Field, a: u64[]) -> bool {
    let half = shifted_right(f.m, 1)
    let power = field_pow(f, a, half)
    field_is_zero(power) || field_equal(power, f.one)
}

/// Returns a square root of `a`, or none when `a` is not a square. It is Tonelli-Shanks and its running time depends on `a`.
pub fn field_sqrt(f: *nistec.Field, a: u64[]) -> u64[]? {
    square_root(f, a, root_powers(f))
}

/// Returns `r^(2^i)` for `i` from 0 to 31, where `r` is `field_root_of_unity(f)`.
fn root_powers(f: *nistec.Field) -> u64[][] {
    var out: u64[][] = [field_root_of_unity(f)]
    for out.len < two_adicity {
        out.push(field_square(f, out[out.len - 1]))
    }
    out
}

fn square_root(f: *nistec.Field, a: u64[], roots: u64[][]) -> u64[]? {
    if field_is_zero(a) {
        return a
    }
    let t = odd_part(f)
    let half = shifted_right(t, 1)
    let w = field_pow(f, a, half)
    var x = field_mul(f, a, w)
    var b = field_mul(f, x, w)
    var v = two_adicity
    for !field_equal(b, f.one) {
        var m = 0
        var probe = b
        for !field_equal(probe, f.one) && m < v {
            probe = field_square(f, probe)
            m += 1
        }
        if m >= v {
            return none
        }
        b = field_mul(f, b, roots[two_adicity - m])
        x = field_mul(f, x, roots[two_adicity - m - 1])
        v = m
    }
    if !field_equal(field_square(f, x), a) {
        return none
    }
    x
}
