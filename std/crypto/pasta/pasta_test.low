import std/crypto/nistec
import std/testing

fn number(f: *nistec.Field, value: u64) -> u64[] {
    field_from_u64(f, value)
}

fn test_fields_follow_the_ring_laws(t: *testing.T) {
    for f in [fp(), fq()] {
        let a = field_from_uniform(f, bytes("a pseudo random element of the field, long enough for sixty four bytes"))
        let b = field_from_uniform(f, bytes("another pseudo random element, also long enough for sixty four bytes!"))
        t.is_true(field_equal(field_add(f, a, b), field_add(f, b, a)))
        t.is_true(field_equal(field_mul(f, a, b), field_mul(f, b, a)))
        t.is_true(field_equal(field_sub(f, field_add(f, a, b), b), a))
        t.is_true(field_is_zero(field_add(f, a, field_neg(f, a))))
        t.is_true(field_equal(field_mul(f, a, field_invert(f, a)), field_one(f)))
        t.is_true(field_equal(field_square(f, a), field_mul(f, a, a)))
        t.is_true(field_is_zero(field_invert(f, field_zero(f))))
        t.is_true(field_equal(field_pow(f, a, [3]), field_mul(f, a, field_square(f, a))))
        t.is_true(field_equal(field_mul(f, a, field_add(f, b, field_one(f))), field_add(f, field_mul(f, a, b), a)))
    }
}

fn test_square_roots_exist_for_squares_only(t: *testing.T) {
    for f in [fp(), fq()] {
        let a = number(f, 1234567)
        let square = field_square(f, a)
        t.is_true(field_is_square(f, square))
        let root = field_sqrt(f, square) ?? return t.fatal("root")
        t.is_true(field_equal(field_square(f, root), square))
        t.is_true(field_is_zero(field_sqrt(f, field_zero(f)) ?? return t.fatal("zero")))
        var found = false
        for i in 2..40 {
            let candidate = number(f, u64(i))
            if !field_is_square(f, candidate) {
                found = true
                t.is_true(field_sqrt(f, candidate) == none)
            }
        }
        t.is_true(found)
    }
}

fn test_field_encodings_are_canonical(t: *testing.T) {
    for f in [fp(), fq()] {
        let a = number(f, 0xdeadbeef)
        let data = field_to_bytes(f, a)
        t.is_true(data.len == 32)
        t.is_true(data[0] == 0xef)
        t.is_true(field_equal(field_from_bytes(f, data) ?? return t.fatal("decode"), a))
        let minus_one = field_to_bytes(f, field_neg(f, field_one(f)))
        t.is_true(field_from_bytes(f, minus_one) != none)
        var modulus = minus_one
        modulus[0] += 1
        t.is_true(field_from_bytes(f, modulus) == none)
        t.is_true(field_from_bytes(f, data[..31]) == none)
        var wide: u8[] = []
        for _ in 0..32 {
            wide.push(255)
        }
        t.is_true(field_from_bytes(f, wide) == none)
        t.is_true(field_to_plain(f, number(f, 77))[0] == 77)
        t.is_true(field_equal(field_from_plain(f, [77, 0, 0, 0]), number(f, 77)))
        t.is_true(field_is_odd(f, number(f, 3)))
        t.is_false(field_is_odd(f, number(f, 4)))
    }
}

fn test_roots_of_unity_have_the_two_adic_order(t: *testing.T) {
    for f in [fp(), fq()] {
        var root = field_root_of_unity(f)
        for _ in 0..31 {
            root = field_square(f, root)
        }
        t.is_true(field_equal(root, field_neg(f, field_one(f))))
        t.is_true(field_equal(field_square(f, root), field_one(f)))
        let delta = field_delta(f)
        t.is_false(field_equal(delta, field_one(f)))
        t.is_true(field_equal(field_pow(f, delta, [0x1, 0x0]), delta))
    }
}

fn test_group_laws(t: *testing.T) {
    for c in [pallas(), vesta()] {
        let g = generator(c)
        let f = c.scalar
        t.is_false(is_identity(g))
        t.is_true(is_identity(identity(c)))
        t.is_true(equal(c, double(c, g), add(c, g, g)))
        t.is_true(equal(c, add(c, g, identity(c)), g))
        t.is_true(equal(c, add(c, identity(c), g), g))
        t.is_true(is_identity(add(c, g, neg(c, g))))
        t.is_true(is_identity(sub(c, g, g)))
        let three = mul(c, g, number(f, 3))
        t.is_true(equal(c, three, add(c, g, double(c, g))))
        t.is_true(equal(c, mul(c, three, number(f, 5)), mul(c, g, number(f, 15))))
        t.is_true(is_identity(mul(c, g, field_zero(f))))
        t.is_true(equal(c, mul(c, g, field_neg(f, field_one(f))), neg(c, g)))
        t.is_true(equal(c, add(c, mul(c, g, number(f, 4)), mul(c, g, number(f, 6))), mul(c, g, number(f, 10))))
    }
}

fn test_the_multi_scalar_multiplication_matches_the_sum_of_products(t: *testing.T) {
    for c in [pallas(), vesta()] {
        let f = c.scalar
        var points: Point[] = []
        var scalars: u64[][] = []
        var expected = identity(c)
        for i in 1..40 {
            let point = mul(c, generator(c), number(f, u64(i * i + 1)))
            let scalar = field_from_uniform(f, bytes("scalar {i} padded to sixty four bytes with some more text to fill it up"))
            points.push(point)
            scalars.push(scalar)
            expected = add(c, expected, mul(c, point, scalar))
        }
        t.is_true(equal(c, msm(c, points, scalars), expected))
        t.is_true(is_identity(msm(c, [], [])))
        t.is_true(is_identity(msm(c, [generator(c)], [field_zero(f)])))
    }
}

fn test_points_encode_in_compressed_form(t: *testing.T) {
    for c in [pallas(), vesta()] {
        let g = generator(c)
        let data = to_bytes(c, g)
        t.is_true(data.len == 32)
        t.is_true(equal(c, from_bytes(c, data) ?? return t.fatal("decode"), g))
        let point = mul(c, g, number(c.scalar, 12345))
        let encoded = to_bytes(c, point)
        t.is_true(equal(c, from_bytes(c, encoded) ?? return t.fatal("decode"), point))
        let xy = coordinates(c, point) ?? return t.fatal("coordinates")
        t.is_true(xy.len == 2)
        t.is_true(coordinates(c, identity(c)) == none)
        t.is_true(equal(c, from_bytes(c, to_bytes(c, identity(c))) ?? return t.fatal("identity"), identity(c)))
        t.is_true(from_bytes(c, encoded[..31]) == none)
        var flipped = encoded
        flipped[31] ^= 0x80
        t.is_true(equal(c, from_bytes(c, flipped) ?? return t.fatal("negated"), neg(c, point)))
        var rejected = 0
        for i in 0..8 {
            var candidate = encoded
            candidate[1] = u8(i)
            if from_bytes(c, candidate) == none {
                rejected += 1
            }
        }
        t.is_true(rejected > 0)
    }
}
