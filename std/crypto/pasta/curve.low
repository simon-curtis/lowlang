import std/crypto/limb
import std/crypto/nistec
import std/slices

/// A curve of the Pasta cycle, `y^2 = x^3 + 5` over its base field. The group order of Pallas is the modulus of the base field of Vesta and the other way round.
pub struct Curve {
    /// The field of the coordinates.
    pub base: *nistec.Field
    /// The field of the scalars, which is the order of the group.
    pub scalar: *nistec.Field
    /// A primitive cube root of unity of the scalar field.
    pub zeta: u64[]
    name: str
    b: u64[]
    generator_x: u64[]
    generator_y: u64[]
    iso_a: u64[]
    iso_b: u64[]
    swu_z: u64[]
    iso_map: u64[][]
}

/// A point of a Pasta curve in Jacobian coordinates, `(x / z^2, y / z^3)`; `z = 0` is the point at infinity.
pub struct Point {
    x: u64[]
    y: u64[]
    z: u64[]
}

/// Returns the field of 255-bit prime `0x4000...0001`, the base field of Pallas and the scalar field of Vesta.
pub fn fp() -> *nistec.Field {
    nistec.field(nistec.hex_limbs("40000000000000000000000000000000224698fc094cf91b992d30ed00000001"))
}

/// Returns the base field of Vesta and the scalar field of Pallas.
pub fn fq() -> *nistec.Field {
    nistec.field(nistec.hex_limbs("40000000000000000000000000000000224698fc0994a8dd8c46eb2100000001"))
}

fn constant(f: *nistec.Field, hex: str) -> u64[] {
    field_from_plain(f, nistec.hex_limbs(hex))
}

fn constants(f: *nistec.Field, hexes: str[]) -> u64[][] {
    var out: u64[][] = []
    for hex in hexes {
        out.push(constant(f, hex))
    }
    out
}

fn curve_over(base: *nistec.Field, scalar: *nistec.Field, name: str, zeta: str, iso_a: str, iso_map: str[]) -> *Curve {
    new(Curve {
        base,
        scalar,
        zeta: constant(scalar, zeta),
        name,
        b: field_from_u64(base, 5),
        generator_x: field_neg(base, field_one(base)),
        generator_y: field_from_u64(base, 2),
        iso_a: constant(base, iso_a),
        iso_b: field_from_u64(base, 1265),
        swu_z: field_neg(base, field_from_u64(base, 13)),
        iso_map: constants(base, iso_map),
    })
}

/// Returns Pallas, whose base field is `fp` and whose scalar field is `fq`.
pub fn pallas() -> *Curve {
    curve_over(fp(), fq(), "pallas", "06819a58283e528e511db4d81cf70f5a0fed467d47c033af2aa9d2e050aa0e4f", "18354a2eb0ea8c9c49be2d7258370742b74134581a27a59f92bb4b0b657a014b", [
        "0e38e38e38e38e38e38e38e38e38e38e4081775473d8375b775f6034aaaaaaab",
        "3509afd51872d88e267c7ffa51cf412a0f93b82ee4b994958cf863b02814fb76",
        "17329b9ec525375398c7d7ac3d98fd13380af066cfeb6d690eb64faef37ea4f7",
        "1c71c71c71c71c71c71c71c71c71c71c8102eea8e7b06eb6eebec06955555580",
        "1d572e7ddc099cff5a607fcce0494a799c434ac1c96b6980c47f2ab668bcd71f",
        "325669becaecd5d11d13bf2a7f22b105b4abf9fb9a1fc81c2aa3af1eae5b6604",
        "1a12f684bda12f684bda12f684bda12f7642b01ad461bad25ad985b5e38e38e4",
        "1a84d7ea8c396c47133e3ffd28e7a09507c9dc17725cca4ac67c31d8140a7dbb",
        "3fb98ff0d2ddcadd303216cce1db9ff11765e924f745937802e2be87d225b234",
        "025ed097b425ed097b425ed097b425ed0ac03e8e134eb3e493e53ab371c71c4f",
        "0c02c5bcca0e6b7f0790bfb3506defb65941a3a4a97aa1b35a28279b1d1b42ae",
        "17033d3c60c68173573b3d7f7d681310d976bbfabbc5661d4d90ab820b12320a",
        "40000000000000000000000000000000224698fc094cf91b992d30ecfffffde5",
    ])
}

/// Returns Vesta, whose base field is `fq` and whose scalar field is `fp`.
pub fn vesta() -> *Curve {
    curve_over(fq(), fp(), "vesta", "12ccca834acdba712caad5dc57aab1b01d1f8bd237ad31491dad5ebdfdfe4ab9", "267f9b2ee592271a81639c4d96f787739673928c7d01b212c515ad7242eaa6b1", [
        "38e38e38e38e38e38e38e38e38e38e390205dd51cfa0961a43cd42c800000001",
