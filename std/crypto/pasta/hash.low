import std/crypto/blake2b
import std/crypto/nistec

struct IsoPoint {
    x: u64[]
    y: u64[]
    infinity: bool
}

fn joined(parts: u8[][]) -> u8[] {
    var out: u8[] = []
    for part in parts {
        for b in part {
            out.push(b)
        }
    }
    out
}

fn digest(data: u8[]) -> u8[] {
    let h = blake2b.personalised([])
    blake2b.update(h, data)
    blake2b.finalize(h)
}

fn exclusive_or(a: u8[], b: u8[]) -> u8[] {
    var out: u8[] = []
    for i in 0..a.len {
        out.push(a[i] ^ b[i])
    }
    out
}

fn hash_to_field(c: *Curve, prefix: str, message: u8[]) -> u64[][] {
    let tail = joined([bytes(prefix), bytes("-"), bytes(c.name), bytes("_XMD:BLAKE2b_SSWU_RO_"), [u8(22 + c.name.len + prefix.len)]])
    let zeros: u8[] = __make(128)
    let b0 = digest(joined([zeros, message, [0, 128, 0], tail]))
    let b1 = digest(joined([b0, [1], tail]))
    let b2 = digest(joined([exclusive_or(b0, b1), [2], tail]))
    [nistec.reduce_mont(c.base, b1), nistec.reduce_mont(c.base, b2)]
}

fn iso_rhs(c: *Curve, x: u64[]) -> u64[] {
    let f = c.base
    let cube = field_mul(f, field_square(f, x), x)
    field_add(f, field_add(f, cube, field_mul(f, c.iso_a, x)), c.iso_b)
}

fn map_to_iso(c: *Curve, u: u64[]) -> IsoPoint {
    let f = c.base
    let z_u2 = field_mul(f, c.swu_z, field_square(f, u))
    let ta = field_add(f, field_square(f, z_u2), z_u2)
    var x = if field_is_zero(ta) {
        field_mul(f, c.iso_b, field_invert(f, field_mul(f, c.swu_z, c.iso_a)))
    } else {
        let numerator = field_mul(f, c.iso_b, field_add(f, ta, field_one(f)))
        field_mul(f, numerator, field_invert(f, field_neg(f, field_mul(f, c.iso_a, ta))))
    }
    var found = square_root(f, iso_rhs(c, x), c.roots)
    if found == none {
        x = field_mul(f, z_u2, x)
        found = square_root(f, iso_rhs(c, x), c.roots)
    }
    var y = found ?? panic("hash to curve: no square root")
    if field_is_odd(f, u) != field_is_odd(f, y) {
        y = field_neg(f, y)
    }
    IsoPoint { x, y, infinity: false }
}

fn iso_add(c: *Curve, p: IsoPoint, q: IsoPoint) -> IsoPoint {
    if p.infinity {
        return q
    }
    if q.infinity {
        return p
    }
    let f = c.base
    var slope: u64[] = []
    if field_equal(p.x, q.x) {
        if !field_equal(p.y, q.y) || field_is_zero(p.y) {
            return IsoPoint { x: p.x, y: p.y, infinity: true }
        }
        let numerator = field_add(f, field_mul(f, field_from_u64(f, 3), field_square(f, p.x)), c.iso_a)
        slope = field_mul(f, numerator, field_invert(f, field_add(f, p.y, p.y)))
    } else {
        slope = field_mul(f, field_sub(f, q.y, p.y), field_invert(f, field_sub(f, q.x, p.x)))
    }
    let x = field_sub(f, field_sub(f, field_square(f, slope), p.x), q.x)
    let y = field_sub(f, field_mul(f, slope, field_sub(f, p.x, x)), p.y)
    IsoPoint { x, y, infinity: false }
}

fn horner(f: *nistec.Field, coefficients: u64[][], x: u64[]) -> u64[] {
    var out = coefficients[0]
    for i in 1..coefficients.len {
        out = field_add(f, field_mul(f, out, x), coefficients[i])
    }
    out
}

fn isogeny(c: *Curve, p: IsoPoint) -> Point {
    if p.infinity {
        return identity(c)
    }
    let f = c.base
    let k = c.iso_map
    let one = field_one(f)
    let num_x = horner(f, [k[0], k[1], k[2], k[3]], p.x)
    let div_x = horner(f, [one, k[4], k[5]], p.x)
    let num_y = field_mul(f, horner(f, [k[6], k[7], k[8], k[9]], p.x), p.y)
    let div_y = horner(f, [one, k[10], k[11], k[12]], p.x)
    if field_is_zero(div_x) || field_is_zero(div_y) {
        return identity(c)
    }
    Point {
        x: field_mul(f, num_x, field_invert(f, div_x)),
        y: field_mul(f, num_y, field_invert(f, div_y)),
        z: one,
    }
}

/// Returns the point that `message` hashes to under the domain `prefix`, by the simplified SWU map to the 3-isogenous curve and the isogeny back, with `expand_message_xmd` over BLAKE2b-512, as `pasta_curves` computes it.
pub fn hash_to_curve(c: *Curve, prefix: str, message: u8[]) -> Point {
    let u = hash_to_field(c, prefix, message)
    isogeny(c, iso_add(c, map_to_iso(c, u[0]), map_to_iso(c, u[1])))
}
