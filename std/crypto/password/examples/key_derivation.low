import std/crypto/hash
import std/crypto/password
import std/text

fn filled(value: u8, n: i64) -> []u8 {
    var out: []u8 = []
    for _ in 0..n {
        push(mut out, value)
    }
    out
}

fn run() ! password.Error {
    let stretched = password.pbkdf2(hash.sha256(), bytes("passwd"), bytes("salt"), 1, 64)
    print("pbkdf2-sha256 {text.encode_hex(stretched)}")

    let memory_hard = password.scrypt(bytes(""), bytes(""), 16, 1, 1, 64, 1048576)?
    print("scrypt        {text.encode_hex(memory_hard)}")

    let cheap = password.scrypt(bytes("pw"), bytes("salt"), 1048576, 8, 1, 32, 1048576) catch {
        MemoryLimit => bytes("limit of 1 MiB refuses N=2^20")
        _ => bytes("other failure")
    }
    print(str(cheap))
    print("scrypt needs {password.scrypt_memory(16384, 8, 1)} bytes at N=16384")

    let tag = password.argon2id_keyed(filled(1, 32), filled(2, 16), filled(3, 8), filled(4, 12), 3, 32, 4, 32)
    print("argon2id      {text.encode_hex(tag)}")
    let invalid = password.argon2id(bytes("pw"), bytes("short"), 1, 8, 1, 32)
    print("salt under 8 bytes returns {invalid.len} bytes")

    let digest = password.blake2b(bytes("abc"), 32, [])
    print("blake2b-256   {text.encode_hex(digest)}")
    let keyed = password.blake2b(bytes("abc"), 32, bytes("secret key"))
    print("keyed differs: {!hash.equal(digest, keyed)}")
}

/// Derives keys from fixed inputs with PBKDF2, scrypt and Argon2id, then hashes with BLAKE2b, and shows the parameter checks.
fn main() {
    run() catch {
        e => print("failed: {e}")
    }
}
