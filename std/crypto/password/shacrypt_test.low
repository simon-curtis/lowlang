import std/testing

fn repeated(n: i64, c: u8) -> str {
    var out: u8[] = []
    for _ in 0..n {
        out.push(c)
    }
    __str_view(out)
}

fn letters(n: i64) -> str {
    var out: u8[] = []
    for i in 0..n {
        out.push(u8('a' + i % 26))
    }
    __str_view(out)
}

fn test_sha_crypt_libxcrypt_vectors(t: *testing.T) {
    t.is_true(verify("password", "$5$saltstring$OH4IDuTlsuTYPdED1gsuiRMyTAwNlRWyA6Xr3I4/dQ5"))
    t.is_true(verify("password", "$6$saltstring$adDbXsJjcDlq2662QPgd.tkSOVmnG9Tt3oXl4HR60SusC3AGjirnDenVZp3DGwLwqy6iYKCzannhaX9DR72nN1"))
    t.is_true(verify("", "$5$saltstring$FdNfA4gXqvCeO6iZs7G/.wwwoywYZqo0l1pwmfWaBA7"))
    t.is_true(verify("", "$6$saltstring$kyGrqt6gmjAdtFLPrflEFifSYLCWWq1pyx95SvqinLDy2UHmj0sTF0MSLMwxPFZc3tu5kQckI8fks0zOPda3n1"))
    t.is_true(verify("Hello world!", "$5$rounds=10000$saltstringsaltst$3xv.VbSHBb41AL9AvLeujZkZRBAwqFMz2.opqey6IcA"))
    t.is_true(verify("Hello world!", "$6$rounds=10000$saltstringsaltst$OW1/O6BYHV6BcXZu8QVeXbDWra3Oeqh0sbHbbMCVNSnCM/UrjmM0Dp8vOuZeHBy/YTBmSK6H9qs/y3RnOaw5v."))
    t.is_true(verify("This is just a test", "$5$rounds=1000$toolongsaltstrin$wpGO18XGV5dzj1x8TEo8nGI4ZKtakadnYP9LHFL4C4A"))
    t.is_true(verify("a very much longer text to encrypt.  This one even stretches over morethan one line.", "$6$rounds=1400$anotherlongsalts$POfYwTEok97VWcjxIiSOjiykti.o/pQs.wPvMxQ6Fm7I6IoYN3CmLs66x9t0oSwbtEW7o7UmJEiDwGqd8p4ur1"))
    t.is_true(verify("we have a short salt string but not a short password", "$5$rounds=77777$short$JiO1O3ZpDAxGJeaDIuqCoEFysAe1mZNJRs3pw0KQRd/"))
    t.is_true(verify("a short string", "$6$rounds=123456$asaltof16chars..$BtCwjqMJGx5hrJhZywWvt0RLE8uZ4oPwcelCjmw2kSYu.Ec6ycULevoBK25fs2xXgMNrCzIMVcgEJAstJeonj1"))
    t.is_true(verify("password", "$6$rounds=5000$saltstring$adDbXsJjcDlq2662QPgd.tkSOVmnG9Tt3oXl4HR60SusC3AGjirnDenVZp3DGwLwqy6iYKCzannhaX9DR72nN1"))
    t.is_true(verify("password", "$6$$bLTg4cpho8PIUrjfsE7qlU08Qx2UEfw..xOc6I1wpGVtyVYToGrr7BzRdAAnEr5lYFr1Z9WcCf1xNZ1HG9qFW1"))
    t.is_true(verify("password", "$5$s$PSEyOUK2.61cifBEF9dRKkFNBHSjVRV95vwjY2WRTZ2"))
}

fn test_sha_crypt_password_lengths_around_the_digest_size(t: *testing.T) {
    t.equal(sha_crypt("6", repeated(200, 'x'), "longpw", some(1000)), "$6$rounds=1000$longpw$I.TraCRKGD9TZtf4DrHj0L3nZmFFJocAdREkU1zt1BvYUANyZsH6ttudkGMfb4hgXWVx329/4udSRHAV9Av4o0")
    t.equal(sha_crypt("5", repeated(200, 'x'), "longpw", some(1000)), "$5$rounds=1000$longpw$GWMY6gAKbLymsVq1vyCG7TnhzcXQs.h3LnxsB.CSll0")
    let sha256 = ["EiBxV.eeZAytxUwX7.X7bK.JFPwtI4T7k6Ta2ut3Sj4", "glYBHHiZ4Qk06PqFxgklv8GMupVXxzFbLuYIMeyyWt1", "wLBQo7Y0Jx6712AVB1.T5MZT2wHoAq1yNm8LdgrvKN3", "RpH5L6wsVtJLYGvdJS53eCi05AabtqzOwm0I46bm7EA", "OwQgPc7YLSl1/5xAT8R.6xhv42ChvfbBz/vy2/9NHJ9", "U5DYpziJfu4MZGsONrrlrrZMGSHJpJvY1uwAiVxvl78"]
    let sha512 = ["bicVufTNDTZ.TrGrMZ6uRe3RO9W72UyA9I44dVX7PR8GmoLQV1xmYPtJLMLdYcjMxIrrm84XNtV78OsoxrDMs1", "j8FRYPUGEnZFH5VqEesbDBAbzsXYfS9UGcvusr57nMBO0czgtA.lHszNjN5kUuuwZEOS/J48osn9/g3tfZwgP/", "epx0qV23aD5FSHaLjHJZiOpI4W9qq4F0VjtNEk7tsj/hp3KV40aNqYo5liRYyafRcTg24km6KshSI8DGDHWw30", "LtgcabeZnMhCZNHOaI.HJgIflY24q1LMOTqzf2qIxOuI7JYkbRrdvtFVde4AtuEQk3fI/YCqSeh4at.7nlgt/0", "tU9g9Lee354XNXTFrCevbFme3hKC8htGASqrU2fQtFtelJ6n18JVCBLp6bu4mWHVuuEMPuSqLz1u/j7du/5.J/", "XaBUW6WXk.tno1Qj1x/QW7r6kIX.8KQVrX42ZdgU6i0AWfKCSTnPVfD/CBEdonA4Fu3qyr.uXvmLKtuVgMEea1"]
    for i, n in [31, 32, 33, 63, 64, 65] {
        t.equal(sha_crypt("5", letters(n), "lengths", none), "$5$lengths${sha256[i]}")
        t.equal(sha_crypt("6", letters(n), "lengths", some(1001)), "$6$rounds=1001$lengths${sha512[i]}")
    }
}

fn test_sha_crypt_rounds_are_clamped_when_hashing(t: *testing.T) {
    t.equal(sha_crypt("5", "the minimum number is still observed", "roundstoolow", some(10)), "$5$rounds=1000$roundstoolow$yfvwcWrQ8l/K0DAWyuPMDNHpIVlTQebY9l/gL972bIC")
}

fn test_sha_crypt_salt_is_truncated_to_sixteen_characters(t: *testing.T) {
    t.equal(sha_crypt("5", "This is just a test", "toolongsaltstring", some(1000)), "$5$rounds=1000$toolongsaltstrin$wpGO18XGV5dzj1x8TEo8nGI4ZKtakadnYP9LHFL4C4A")
}

fn test_sha_crypt_rejects_mismatches_and_malformed_strings(t: *testing.T) {
    let good = "$5$saltstring$OH4IDuTlsuTYPdED1gsuiRMyTAwNlRWyA6Xr3I4/dQ5"
    t.is_false(verify("Password", good))
    t.is_false(verify("password", good[..good.len - 1]))
    t.is_false(verify("password", "$5$saltstring$OH4IDuTlsuTYPdED1gsuiRMyTAwNlRWyA6Xr3I4/dQ6"))
    t.is_false(verify("password", "$5$saltstring$OH4IDuTlsuTYPdED1gsuiRMyTAwNlRWyA6Xr3I4/dQ5$"))
    t.is_false(verify("password", "$6$saltstring$OH4IDuTlsuTYPdED1gsuiRMyTAwNlRWyA6Xr3I4/dQ5"))
    t.is_false(verify("password", "$5$rounds=5000x$saltstring$OH4IDuTlsuTYPdED1gsuiRMyTAwNlRWyA6Xr3I4/dQ5"))
    t.is_false(verify("password", "$5$rounds=$saltstring$OH4IDuTlsuTYPdED1gsuiRMyTAwNlRWyA6Xr3I4/dQ5"))
    t.is_false(verify("password", "$5$rounds=99999999999999999999999$saltstring$x"))
    t.is_false(verify("password", "$5$turns=5000$saltstring$OH4IDuTlsuTYPdED1gsuiRMyTAwNlRWyA6Xr3I4/dQ5"))
    t.is_false(verify("the minimum number is still observed", "$5$rounds=10$roundstoolow$yfvwcWrQ8l/K0DAWyuPMDNHpIVlTQebY9l/gL972bIC"))
    t.is_false(verify("password", "$5$"))
    t.is_false(verify("password", "$5$$"))
}

fn test_hash_sha512_crypt_round_trips(t: *testing.T) {
    let encoded = hash_sha512_crypt("correct horse", 1000) catch { e => t.must(e, "") }
    t.equal(encoded.len, "$6$rounds=1000$".len + 16 + 1 + 86)
    t.is_true(verify("correct horse", encoded))
    t.is_false(verify("correct horsf", encoded))
    t.equal(hash_sha512_crypt(repeated(512, 'a'), 1000) catch { e => t.expect_error(e, Error.PasswordTooLong, "") }, "")
}

fn test_crypt_passwords_stop_at_511_bytes(t: *testing.T) {
    t.is_true(verify(repeated(511, 'a'), "$6$rounds=1000$len$pFq2pfsaU4RdOh5JluvRN588PSE1bv1R2rppuFwOM5.2zzkFyBcqXillU833PAKdIcyhcwe/Lrna09yFUcwGu1"))
    t.is_true(verify(repeated(511, 'a'), "$5$len$kt87rTq9.S3dZDnQRqu8HzgLBcy/lWzN9LQv.dxt1c1"))
    t.is_true(verify(repeated(511, 'a'), "$y$j75$.2U.1EE/4Q.07ck0AoU1D.$z.AoLKoy3w/BxvitIfJ8gtVXA2RzCWcb/sxf.yDiLOD"))
    t.is_false(verify(repeated(512, 'a'), "$5${sha_crypt("5", repeated(512, 'a'), "len", none)["$5$".len..]}"))
    t.is_false(verify(repeated(512, 'a'), "$y$j75$.2U.1EE/4Q.07ck0AoU1D.$z.AoLKoy3w/BxvitIfJ8gtVXA2RzCWcb/sxf.yDiLOD"))
}
