import std/testing
import std/text

fn test_yescrypt_libxcrypt_defaults(t: *testing.T) {
    t.is_true(verify("password", "$y$j9T$.2U.1EE/4Q.07ck0AoU1D.$oTWzmC2x.N26ebvBUewT97nMFz0Ppuhjrf1cD6RWPLA"))
    t.is_true(verify("", "$y$j9T$.2U.1EE/4Q.07ck0AoU1D.$SmJZIbjHRp4Z4W4wxy1fs7FwUQaU7p33Xm6oOyuYI22"))
    t.is_true(verify("password", "$y$j75$.2U.1EE/4Q.07ck0AoU1D.$UUBGdkwYE4EcJWxkJIrjkQLwZ/LQ2pJbWrAs4l4c.HA"))
    t.is_true(verify("password", "$y$j7T$.2U.1EE/4Q.07ck0AoU1D.$vyKDvujbERuHsZr0y5JoSlRPxN8SJb39BxHnOBy85pB"))
    t.is_true(verify("password", "$y$jBT$.2U.1EE/4Q.07ck0AoU1D.$U1XzFhzuAinixqDhmz7/bkffiKNbR38KbgbdYk2e1S6"))
}

fn test_yescrypt_passwords_and_salts(t: *testing.T) {
    t.is_true(verify(repeated(300, 'x'), "$y$j75$.2U.1EE/4Q.07ck0AoU1D.$QMyeTTlGK/ReuCDu7jkmqcMKne0hSLNm71lR6H8mmmA"))
    t.is_true(verify("pässwörd", "$y$j8D$.2U.1EE/4Q.07ck0AoU1D.$656Ts0pbdYwv5ENJXF.3G2cMYjIQe.EfscZ0Q2iLfF3"))
    t.is_true(verify("password", "$y$j5/$z1$pjTPTtrdhT0akcqm.XpmZ4zahukoeytFdopNlvNJh/D"))
    t.is_true(verify("password", "$y$j75$.2U.1EE/4Q.07ck0AoU1D.F2GA/3JMl3MYV4PkF5Sw/6V6m6YIW7bUG8eg09hsm9k2XAnEHBqQ1CtcnCwoXDz.$DqmkfbjBWKjIcUS5D5zMRpf0zprxjBVvCiWyQfDC1u8"))
    t.is_true(verify("password", "$y$j75$$MY7LY7iSiXDbIK//WLX8B9MRa5LUgGVUicMJCn3sKE1"))
    t.is_true(verify("password", "$y$j75$.2U.1EE/4.$bSwpfQ97O68N334ziuGMFqKV62ngXnnSsDJ8iwJk4QC"))
}

fn test_yescrypt_parallelism_and_time(t: *testing.T) {
    t.is_true(verify("password", "$y$j75..$.2U.1EE/4Q.07ck0AoU1D.$pe6ipkfiTD6bLwqjzzAi34F6XxOGxxY8UU40TksvL48"))
    t.is_true(verify("password", "$y$j75./$.2U.1EE/4Q.07ck0AoU1D.$2w4.IVhvOru/ZkraHFjg15BFYYwia8DF8SdvbGfe0c6"))
    t.is_true(verify("password", "$y$j75/.$.2U.1EE/4Q.07ck0AoU1D.$PD8Z/3m/.h1kGIFfIg0k6BLnmlRjuksieEfupKfC5k/"))
    t.is_true(verify("password", "$y$j75//$.2U.1EE/4Q.07ck0AoU1D.$slZpE3/PeAhZUYrl5R3fwQeveCIQTnktr.HHcbf7PmC"))
    t.is_true(verify("password", "$y$j75/2$.2U.1EE/4Q.07ck0AoU1D.$tBOqIgUihcvVpvTWP4uw8m4sToU8cF/lS/suOaw.sf4"))
    t.is_true(verify("password", "$y$j75000$.2U.1EE/4Q.07ck0AoU1D.$EQYpC9gUU/PzQLMXe.ZxsujZZa.b7dZB9MYB90/nMx3"))
    t.is_true(verify("password", "$y$jB5..$.2U.1EE/4Q.07ck0AoU1D.$gTKAaHVtXZRB3mQGXOF8cKuKhgicWORsSiGO3/wuj3."))
    t.is_true(verify("password", "$y$jAT0..$.2U.1EE/4Q.07ck0AoU1D.$4IAs4imbCdfGxrb5Q.ltsjPfEhOwqMkcpiOrOH6doM5"))
    t.is_true(verify("password", "$y$j9T./$.2U.1EE/4Q.07ck0AoU1D.$KD4HRIQi7FJz7S0ERx3NVqUEBPDin2vVJ1o13hmfGV4"))
    t.is_true(verify("password", "$y$j9T//$.2U.1EE/4Q.07ck0AoU1D.$qD9BVkm1Di/dDbCaMmzsLsd0WfFlfiWbe3Ovfkx76s6"))
    t.is_true(verify("password", "$y$j6nv$.2U.1EE/4Q.07ck0AoU1D.$lHmuYGfSSTUAAeWM3jkD4TZ6TP38VxZ8IQkwg9UlKz2"))
    t.is_true(verify("password", "$y$j3kD./$.2U.1EE/4Q.07ck0AoU1D.$FpfXu9c0F.EP83hUPRjtkF5rLjtXKoh9hyBANp/xrGA"))
    t.is_true(verify("password", "$y$j1.$.2U.1EE/4Q.07ck0AoU1D.$w/USFXxkkEOreL7KegyQArLSCyuyRBsFFZOY9Z/jS//"))
}

fn test_yescrypt_scrypt_and_worm_flavors(t: *testing.T) {
    t.is_true(verify("password", "$y$.75$.2U.1EE/4Q.07ck0AoU1D.$ukr/0GuqTHZCBnbIjUyINDfGvecwulJNLW2XT9GU.J9"))
    t.is_true(verify("password", "$y$.1.$.2U.1EE/4Q.07ck0AoU1D.$I4Z9nEgK3YIaRYyQpFPolmiGN6RLjbW6B.lwIIIbg4A"))
    t.is_true(verify("password", "$y$.75./$.2U.1EE/4Q.07ck0AoU1D.$nbpi9wjawzfUYbDfFFjJhIlgvh2kr0dyMA5R1XfOmPD"))
    t.is_true(verify("password", "$y$/75$.2U.1EE/4Q.07ck0AoU1D.$c0BuAEIzuImF30cPW/nHvSEbltt6JCWkBRGexCfxln/"))
    t.is_true(verify("password", "$y$/75/.$.2U.1EE/4Q.07ck0AoU1D.$OGBpwu28PJ4rdOKQqRh5Mlaqz4SE0upB21CBEy8MX/5"))
    t.is_true(verify("password", "$y$/75/0$.2U.1EE/4Q.07ck0AoU1D.$uer1.UT6uhP.08mFIT5Rrtbk0R0N/mchlUVp..nU1i3"))
    t.is_true(verify("password", "$y$/710./$.2U.1EE/4Q.07ck0AoU1D.$wMhCIH06JiNdxr7B.HKROrQg7jRiDASeiOm8QA0Ijg."))
}

fn test_yescrypt_rejects_mismatches_and_truncation(t: *testing.T) {
    let good = "$y$j75$.2U.1EE/4Q.07ck0AoU1D.$UUBGdkwYE4EcJWxkJIrjkQLwZ/LQ2pJbWrAs4l4c.HA"
    t.is_false(verify("Password", good))
    t.is_false(verify("password", good[..good.len - 1]))
    t.is_false(verify("password", "{good}A"))
    t.is_false(verify("password", "$y$j75$.2U.1EE/4Q.07ck0AoU1D.$UUBGdkwYE4EcJWxkJIrjkQLwZ/LQ2pJbWrAs4l4c.HB"))
    t.is_false(verify("password", "$y$j75$.2U.1EE/4Q.07ck0AoU1D."))
    t.is_false(verify("password", "$y$$$"))
    t.is_false(verify("password", "$y$"))
}

fn test_yescrypt_salt_base64_is_strict(t: *testing.T) {
    t.equal_slice(decode_crypt64("z1", 64) ?? [], [0xFF])
    t.is_true(decode_crypt64("", 64) != none)
    t.is_true(decode_crypt64(".2U.1EE/4Q.07ck0AoU1D..", 64) != none)
    t.is_true(decode_crypt64("a", 64) == none)
    t.is_true(decode_crypt64("abcdefghijklmnopqrstuv", 64) == none)
    t.is_true(decode_crypt64(".2U.1EE/4Q.07ck0AoU1Dz", 64) == none)
    t.is_true(decode_crypt64(".2U.1EE/4Q.07ck0AoU1D!", 64) == none)
    t.is_true(decode_crypt64("....................................................................................", 64) != none)
    t.is_true(decode_crypt64("........................................................................................", 64) == none)
}

fn test_yescrypt_rejects_unsupported_parameters(t: *testing.T) {
    t.is_true(yescrypt_params("j75") != none)
    t.is_true(yescrypt_params("j1.") != none)
    t.is_true(yescrypt_params("j..") == none)
    t.is_true(yescrypt_params("j/...") == none)
    t.is_true(yescrypt_params("jUT") == none)
    t.is_true(yescrypt_params("jzzzzzz5") == none)
    t.is_true(yescrypt_params("j7") == none)
    t.is_true(yescrypt_params("j75.") == none)
    t.is_true(yescrypt_params("j751.") == none)
    t.is_true(yescrypt_params("j753.") == none)
    t.is_true(yescrypt_params("j75/kD") != none)
    t.is_true(yescrypt_params("j75/kE") == none)
    t.is_true(yescrypt_params("i75") == none)
    t.is_true(yescrypt_params("z75") == none)
    t.is_true(yescrypt_params(".75//") == none)
}

fn test_yescrypt_memory_limit(t: *testing.T) {
    t.is_true(yescrypt_params("jET") != none)
    t.is_true(yescrypt_params("jFT") == none)
    t.is_true(yescrypt_params(".Kv") == none)
    t.is_true(yescrypt_params("jA5kzzzzz.") == none)
}

fn test_hash_yescrypt_round_trips(t: *testing.T) {
    let encoded = hash_yescrypt("correct horse", 10, 8) catch { e => t.must(e, "") }
    t.is_true(text.starts_with(encoded, "$y$j75$"))
    t.equal(encoded.len, "$y$j75$".len + 22 + 1 + 43)
    t.is_true(verify("correct horse", encoded))
    t.is_false(verify("correct horsf", encoded))
    t.equal(hash_yescrypt("x", 1, 8) catch { e => t.expect_error(e, Error.InvalidParameters, "") }, "")
    t.equal(hash_yescrypt("x", 10, 0) catch { e => t.expect_error(e, Error.InvalidParameters, "") }, "")
    t.equal(hash_yescrypt("x", 31, 32) catch { e => t.expect_error(e, Error.MemoryLimit, "") }, "")
}
