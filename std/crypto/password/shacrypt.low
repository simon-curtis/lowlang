import std/base64
import std/crypto
import std/crypto/hash
import std/text

const crypt_alphabet = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
const sha_crypt_default_rounds = 5000
const sha_crypt_min_rounds = 1000
const sha_crypt_max_rounds = 999999999
const sha_crypt_max_salt = 16
const crypt_max_password = 511

fn sha256_crypt_order() -> i64[] {
    [0, 10, 20, 21, 1, 11, 12, 22, 2, 3, 13, 23, 24, 4, 14, 15, 25, 5, 6, 16, 26, 27, 7, 17, 18, 28, 8, 9, 19, 29, 31, 30]
}

fn sha512_crypt_order() -> i64[] {
    [0, 21, 42, 22, 43, 1, 44, 2, 23, 3, 24, 45, 25, 46, 4, 47, 5, 26, 6, 27, 48, 28, 49, 7, 50, 8, 29, 9, 30, 51, 31, 52, 10, 53, 11, 32, 12, 33, 54, 34, 55, 13, 56, 14, 35, 15, 36, 57, 37, 58, 16, 59, 17, 38, 18, 39, 60, 40, 61, 19, 62, 20, 41, 63]
}

fn repeat_to(block: u8[], length: i64) -> u8[] {
    let out: u8[] = __make(length)
    for i in 0..length {
        out[i] = block[i % block.len]
    }
    out
}

fn sha_crypt_digest(algorithm: hash.Algorithm, password: u8[], salt: u8[], rounds: i64) -> u8[] {
    let size = algorithm.size
    let b = algorithm.digest()
    b.update(password)
    b.update(salt)
    b.update(password)
    let alternate = b.finish()
    let a = algorithm.digest()
    a.update(password)
    a.update(salt)
    var left = password.len
    for left > size {
        a.update(alternate)
        left -= size
    }
    a.update(alternate[..left])
    var length = password.len
    for length > 0 {
        if length & 1 != 0 { a.update(alternate) } else { a.update(password) }
        length >>= 1
    }
    var result = a.finish()
    let dp = algorithm.digest()
    for _ in 0..password.len {
        dp.update(password)
    }
    let p = repeat_to(dp.finish(), password.len)
    let ds = algorithm.digest()
    for _ in 0..16 + i64(result[0]) {
        ds.update(salt)
    }
    let s = repeat_to(ds.finish(), salt.len)
    for round in 0..rounds {
        let c = algorithm.digest()
        if round & 1 != 0 { c.update(p) } else { c.update(result) }
        if round % 3 != 0 {
            c.update(s)
        }
        if round % 7 != 0 {
            c.update(p)
        }
        if round & 1 != 0 { c.update(result) } else { c.update(p) }
        result = c.finish()
    }
    result
}

fn sha_crypt_text(digest: u8[]) -> str {
    let order = if digest.len == 32 { sha256_crypt_order() } else { sha512_crypt_order() }
    var out: u8[] = []
    var at = 0
    for at < order.len {
        let n = if order.len - at < 3 { order.len - at } else { 3 }
        var value = 0
        for k in 0..n {
            value = value << 8 | i64(digest[order[at + k]])
        }
        for _ in 0..(8 * n + 5) / 6 {
            out.push(crypt_alphabet[value & 63])
            value >>= 6
        }
        at += n
    }
    __str_view(out)
}

fn sha_crypt(variant: str, password: str, salt: str, rounds: i64?) -> str {
    let algorithm = if variant == "5" { hash.sha256() } else { hash.sha512() }
    let used_salt = if salt.len > sha_crypt_max_salt { salt[..sha_crypt_max_salt] } else { salt }
    let count = match rounds {
        some(n) => match n { < sha_crypt_min_rounds => sha_crypt_min_rounds, > sha_crypt_max_rounds => sha_crypt_max_rounds, _ => n }
        none => sha_crypt_default_rounds
    }
    let field = if rounds == none { "" } else { "rounds={count}$" }
    let digest = sha_crypt_digest(algorithm, bytes(password), bytes(used_salt), count)
    "${variant}${field}{used_salt}${sha_crypt_text(digest)}"
}

/// Hashes `password` with SHA-512-crypt and returns a `$6$` string, the format of `crypt(3)` and `/etc/shadow`.
///
/// `rounds` is clamped to `[1000, 999999999]`. The salt is 16 characters of the crypt alphabet `./0-9A-Za-z` from 12 random bytes of `crypto.random`. The result has the form `$6$rounds=<rounds>$<salt>$<digest, 86 characters>`. Fails with `PasswordTooLong` for a password over 511 bytes, which `crypt(3)` refuses.
pub fn hash_sha512_crypt(password: str, rounds: i64) -> str ! Error {
    if password.len > crypt_max_password {
        fail Error.PasswordTooLong
    }
    sha_crypt("6", password, base64.encode_with(crypto.random(12), crypt_alphabet, false), some(rounds))
}

fn verify_sha_crypt(password: str, encoded: str, parts: str[]) -> bool {
    var rounds: i64? = none
    if parts.len == 5 {
        if !text.starts_with(parts[2], "rounds=") {
            return false
        }
        rounds = some(text.parse_uint(parts[2]["rounds=".len..], 10) or return false)
    }
    let computed = sha_crypt(parts[1], password, parts[parts.len - 2], rounds)
    hash.equal(bytes(computed), bytes(encoded))
}
