import std/crypto/bls12381
import std/crypto/hash
import std/crypto/nistec
import std/crypto/pairing
import std/text

fn secret_key(c: *pairing.Curve, seed: str) -> u64[] {
    let key = nistec.element(c.fr)
    nistec.from_mont(c.fr, key, nistec.reduce_mont(c.fr, hash.sum(hash.sha512(), bytes(seed))))
    key
}

fn describe(c: *pairing.Curve, data: u8[]) -> str {
    let _ = bls12381.decode_g2(c, data) catch {
        NotOnCurve => return "not on the curve"
        NotInSubgroup => return "not in the subgroup"
        _ => return "malformed"
    }
    "a point"
}

/// Signs a message with a BLS signature in the basic scheme of the IETF BLS signature draft with public keys in G1: the message is hashed to G2 with RFC 9380 and the signature is checked with one product of two pairings. py_ecc's `G2Basic` gives the same public key and signature for this key.
fn main() {
    let c = pairing.bls12_381()
    let h = bls12381.hasher(c)
    let dst = bytes("BLS_SIG_BLS12381G2_XMD:SHA-256_SSWU_RO_NUL_")
    let key = secret_key(c, "alice")
    let public = pairing.mul(c, c.g1, key)
    print("public key {text.encode_hex(bls12381.compress_g1(c, public))}")

    let message = bytes("pay 10 to carol")
    let signature = pairing.mul(c, bls12381.hash_to_g2(h, message, dst), key)
    let encoded = bls12381.compress_g2(c, signature)
    print("signature {text.encode_hex(encoded)}")

    let decoded = bls12381.decode_g2(c, encoded) or pairing.g2_infinity(c)
    let point = bls12381.hash_to_g2(h, message, dst)
    print("verifies: {pairing.check(c, [pairing.neg(c, c.g1), public], [decoded, point])}")
    let other = bls12381.hash_to_g2(h, bytes("pay 99 to carol"), dst)
    print("other message verifies: {pairing.check(c, [pairing.neg(c, c.g1), public], [decoded, other])}")

    var flipped: u8[] = []
    for b in encoded {
        flipped.push(b)
    }
    flipped[0] ^= 0x20
    let negated = bls12381.decode_g2(c, flipped) or c.g2
    print("the other square root verifies: {pairing.check(c, [pairing.neg(c, c.g1), public], [negated, point])}")
    flipped[95] ^= 0x01
    print("a changed byte decodes as: {describe(c, flipped)}")
}
