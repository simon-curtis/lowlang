import std/big
import std/crypto/hash
import std/crypto/hashtocurve
import std/crypto/limb
import std/crypto/nistec
import std/crypto/pairing

struct Map {
    z: u64[]
    a: u64[]
    b: u64[]
    c1: i64
    c3: u64[]
    c4: u64[]
    c5: u64[]
    c6: u64[]
    c7: u64[]
    x_numerator: u64[][]
    x_denominator: u64[][]
    y_numerator: u64[][]
    y_denominator: u64[][]
    cofactor: u64[]
}

/// The hash-to-curve suites of RFC 9380 section 8.8 for BLS12-381, with the constants of their simplified SWU maps, isogenies and cofactors in Montgomery form.
///
/// Build one with `hasher` and reuse it; like the `pairing.Curve` it holds, it is not safe for concurrent use.
pub struct Hasher {
    /// The curve the points belong to.
    pub curve: *pairing.Curve
    g1: Map
    g2: Map
}

fn fp_of(c: *pairing.Curve, hex: str) -> u64[] {
    let out = nistec.element(c.fp)
    nistec.to_mont(c.fp, out, nistec.hex_limbs(hex))
    out
}

fn fp2_of(c: *pairing.Curve, real: str, imaginary: str) -> u64[] {
    let out: u64[] = __make(2 * c.l)
    __memmove(out, fp_of(c, real))
    __memmove(out[c.l..], fp_of(c, imaginary))
    out
}

fn small_fp(c: *pairing.Curve, value: u64) -> u64[] {
    let plain = nistec.element(c.fp)
    plain[0] = value
    let out = nistec.element(c.fp)
    nistec.to_mont(c.fp, out, plain)
    out
}

fn small_fp2(c: *pairing.Curve, real: u64, imaginary: u64) -> u64[] {
    let out: u64[] = __make(2 * c.l)
    __memmove(out, small_fp(c, real))
    __memmove(out[c.l..], small_fp(c, imaginary))
    out
}

fn negated(c: *pairing.Curve, a: u64[]) -> u64[] {
    let out: u64[] = __make(a.len)
    pairing.field_neg(c, out, a)
    out
}

fn exponent(a: big.Int) -> u64[] {
    let words = (big.bit_len(a) + 63) / 64
    limb.from_bytes(big.to_bytes(a), if words > 0 { words } else { 1 })
}

fn g1_table(c: *pairing.Curve, hex: str[]) -> u64[][] {
    var out: u64[][] = []
    for h in hex {
        out.push(fp_of(c, h))
    }
    out
}

fn g2_table(c: *pairing.Curve, hex: str[]) -> u64[][] {
    var out: u64[][] = []
    for i in 0..hex.len / 2 {
        out.push(fp2_of(c, hex[2 * i], hex[2 * i + 1]))
    }
    out
}

fn map_of(c: *pairing.Curve, order: big.Int, z: u64[], a: u64[], b: u64[], cofactor: str) -> Map {
    let minus_one = big.sub(order, big.one())
    let c1 = big.trailing_zeros(minus_one)
    let c2 = big.shr(minus_one, c1)
    let c3 = big.shr(big.sub(c2, big.one()), 1)
    let c4 = big.sub(big.shl(big.one(), c1), big.one())
    let c5 = big.shl(big.one(), c1 - 1)
    let c6: u64[] = __make(z.len)
    pairing.field_power(c, c6, z, exponent(c2))
    let c7: u64[] = __make(z.len)
    pairing.field_power(c, c7, z, exponent(big.shr(big.add(c2, big.one()), 1)))
    let empty: u64[][] = []
    Map {
        z
        a
        b
        c1
        c3: exponent(c3)
        c4: exponent(c4)
        c5: exponent(c5)
        c6
        c7
        x_numerator: empty
        x_denominator: empty
        y_numerator: empty
        y_denominator: empty
        cofactor: nistec.hex_limbs(cofactor)
    }
}

/// Returns the hasher for the BLS12-381 curve `c`, which must be `pairing.bls12_381()`.
pub fn hasher(c: *pairing.Curve) -> *Hasher {
    let p = big.from_bytes(nistec.encode(c.fp.m))
    var g1 = map_of(c, p, small_fp(c, 11), fp_of(c, "00144698a3b8e9433d693a02c96d4982b0ea985383ee66a8d8e8981aefd881ac98936f8da0e0f97f5cf428082d584c1d"), fp_of(c, "12e2908d11688030018b12e8753eee3b2016c1f0f24f4070a0b9c14fcef35ef55a23215a316ceaa5d1cc48e98e172be0"), "000000000000000000000000000000000000000000000000d201000000010001")
    g1.x_numerator = g1_table(c, g1_x_numerator())
    g1.x_denominator = g1_table(c, g1_x_denominator())
    g1.y_numerator = g1_table(c, g1_y_numerator())
    g1.y_denominator = g1_table(c, g1_y_denominator())
    var g2 = map_of(c, big.mul(p, p), negated(c, small_fp2(c, 2, 1)), small_fp2(c, 0, 240), small_fp2(c, 1012, 1012), "0bc69f08f2ee75b3584c6a0ea91b352888e2a8e9145ad7689986ff031508ffe1329c2f178731db956d82bf015d1212b02ec0ec69d7477c1ae954cbc06689f6a359894c0adebbf6b4e8020005aaa95551")
    g2.x_numerator = g2_table(c, g2_x_numerator())
    g2.x_denominator = g2_table(c, g2_x_denominator())
    g2.y_numerator = g2_table(c, g2_y_numerator())
    g2.y_denominator = g2_table(c, g2_y_denominator())
    new(Hasher { curve: c, g1, g2 })
}

fn times(c: *pairing.Curve, a: u64[], b: u64[]) -> u64[] {
    let out: u64[] = __make(a.len)
    pairing.field_mul(c, out, a, b)
    out
}

fn plus(c: *pairing.Curve, a: u64[], b: u64[]) -> u64[] {
    let out: u64[] = __make(a.len)
    pairing.field_add(c, out, a, b)
    out
}

fn squared(c: *pairing.Curve, a: u64[]) -> u64[] {
    let out: u64[] = __make(a.len)
    pairing.field_square(c, out, a)
    out
}

fn raised(c: *pairing.Curve, a: u64[], e: u64[]) -> u64[] {
    let out: u64[] = __make(a.len)
    pairing.field_power(c, out, a, e)
    out
}

fn pick(a: u64[], b: u64[], choice: u64) -> u64[] {
    let out: u64[] = __make(a.len)
    limb.choose(out, b, a, limb.mask_of(choice))
    out
}

fn one_like(c: *pairing.Curve, a: u64[]) -> u64[] {
    let out: u64[] = __make(a.len)
    __memmove(out, c.fp.one)
    out
}

fn sgn0(c: *pairing.Curve, a: u64[]) -> u64 {
    let real = nistec.element(c.fp)
    nistec.from_mont(c.fp, real, a[..c.l])
    if a.len == c.l {
        return real[0] & 1
    }
    let imaginary = nistec.element(c.fp)
    nistec.from_mont(c.fp, imaginary, a[c.l..])
    real[0] & 1 | limb.zero_limbs(real) & imaginary[0] & 1
}

struct Root {
    square: u64
    root: u64[]
}

fn sqrt_ratio(c: *pairing.Curve, m: Map, u: u64[], v: u64[]) -> Root {
    var tv1 = m.c6
    var tv2 = raised(c, v, m.c4)
    var tv3 = times(c, squared(c, tv2), v)
    var tv5 = times(c, raised(c, times(c, u, tv3), m.c3), tv2)
    tv2 = times(c, tv5, v)
    tv3 = times(c, tv5, u)
    var tv4 = times(c, tv3, tv2)
    tv5 = raised(c, tv4, m.c5)
    let square = limb.same_limbs(tv5, one_like(c, tv5))
    tv2 = times(c, tv3, m.c7)
    tv5 = times(c, tv4, tv1)
    tv3 = pick(tv2, tv3, square)
    tv4 = pick(tv5, tv4, square)
    var i = m.c1
    for i >= 2 {
        tv5 = tv4
        for _ in 0..i - 2 {
            tv5 = squared(c, tv5)
        }
        let e1 = limb.same_limbs(tv5, one_like(c, tv5))
        tv2 = times(c, tv3, tv1)
        tv1 = squared(c, tv1)
        tv5 = times(c, tv4, tv1)
        tv3 = pick(tv2, tv3, e1)
        tv4 = pick(tv5, tv4, e1)
        i -= 1
    }
    Root { square, root: tv3 }
}

fn simple_swu(c: *pairing.Curve, m: Map, u: u64[]) -> pairing.Point {
    let tv1 = times(c, m.z, squared(c, u))
    let tv2 = plus(c, squared(c, tv1), tv1)
    let tv3 = times(c, m.b, plus(c, tv2, one_like(c, tv2)))
    let nonzero = limb.zero_limbs(tv2) ^ 1
    let tv4 = times(c, m.a, pick(m.z, negated(c, tv2), nonzero))
    let tv6 = squared(c, tv4)
    let gx = times(c, plus(c, squared(c, tv3), times(c, m.a, tv6)), tv3)
    let tv6_cubed = times(c, tv6, tv4)
    let numerator = plus(c, gx, times(c, m.b, tv6_cubed))
    let root = sqrt_ratio(c, m, numerator, tv6_cubed)
    let y1 = times(c, times(c, tv1, u), root.root)
    let x = pick(times(c, tv1, tv3), tv3, root.square)
    let y = pick(y1, root.root, root.square)
    let same_sign = sgn0(c, u) ^ sgn0(c, y) ^ 1
    let signed = pick(negated(c, y), y, same_sign)
    let inverse: u64[] = __make(tv4.len)
    pairing.field_inverse(c, inverse, tv4)
    pairing.from_affine(c, times(c, x, inverse), signed)
}

fn polynomial(c: *pairing.Curve, coefficients: u64[][], x: u64[], monic: bool) -> u64[] {
    var acc = if monic { one_like(c, x) } else { coefficients[coefficients.len - 1] }
    var j = if monic { coefficients.len - 1 } else { coefficients.len - 2 }
    for j >= 0 {
        acc = plus(c, times(c, acc, x), coefficients[j])
        j -= 1
    }
    acc
}

fn isogeny(c: *pairing.Curve, m: Map, p: pairing.Point) -> pairing.Point {
    let x_num = polynomial(c, m.x_numerator, p.x, false)
    let x_den = polynomial(c, m.x_denominator, p.x, true)
    let y_num = polynomial(c, m.y_numerator, p.x, false)
    let y_den = polynomial(c, m.y_denominator, p.x, true)
    let inverse: u64[] = __make(p.x.len)
    pairing.field_inverse(c, inverse, times(c, x_den, y_den))
    let x = times(c, times(c, x_num, y_den), inverse)
    let y = times(c, times(c, times(c, p.y, y_num), x_den), inverse)
    let out = pairing.from_affine(c, x, y)
    limb.choose(out.z, inverse, out.z, limb.mask_of(limb.zero_limbs(inverse)))
    out
}

fn map_curve(c: *pairing.Curve, m: Map, u: u64[]) -> pairing.Point {
    isogeny(c, m, simple_swu(c, m, u))
}

fn map_to_group(c: *pairing.Curve, m: Map, u: u64[]) -> pairing.Point {
    pairing.mul_public(c, map_curve(c, m, u), m.cofactor)
}

fn hash_to_field(c: *pairing.Curve, msg: u8[], dst: u8[], count: i64, degree: i64) -> u64[][] {
    let size = 64 * count * degree
    let uniform = hashtocurve.expand_message_xmd(hash.sha256(), msg, dst, size) or __make(size)
    var out: u64[][] = []
    for i in 0..count {
        let element: u64[] = __make(degree * c.l)
        for j in 0..degree {
            let at = 64 * (j + i * degree)
            __memmove(element[j * c.l..], nistec.reduce_mont(c.fp, uniform[at..at + 64]))
        }
        out.push(element)
    }
    out
}

fn hash_to(h: *Hasher, m: Map, degree: i64, msg: u8[], dst: u8[]) -> pairing.Point {
    let c = h.curve
    let u = hash_to_field(c, msg, dst, 2, degree)
    let sum = pairing.add(c, map_curve(c, m, u[0]), map_curve(c, m, u[1]))
    pairing.mul_public(c, sum, m.cofactor)
}

fn encode_to(h: *Hasher, m: Map, degree: i64, msg: u8[], dst: u8[]) -> pairing.Point {
    let c = h.curve
    let u = hash_to_field(c, msg, dst, 1, degree)
    map_to_group(c, m, u[0])
}

/// Returns the point of `G1` that `hash_to_curve` of RFC 9380 gives for `msg` and the domain separation tag `dst` under the suite `BLS12381G1_XMD:SHA-256_SSWU_RO_`: two field elements from `hash_to_field` with `L = 64`, each mapped with the simplified SWU map to the 11-isogenous curve and back, added, and multiplied by `h_eff = 0xd201000000010001`.
///
/// Every step runs for every input, with masks instead of branches, so the running time does not depend on `msg`.
pub fn hash_to_g1(h: *Hasher, msg: u8[], dst: u8[]) -> pairing.Point {
    hash_to(h, h.g1, 1, msg, dst)
}

/// Returns the point of `G1` that `encode_to_curve` of RFC 9380 gives for `msg` and `dst` under the suite `BLS12381G1_XMD:SHA-256_SSWU_NU_`: one field element mapped and multiplied by `h_eff`. Its output is not uniformly distributed; `hash_to_g1` is.
pub fn encode_to_g1(h: *Hasher, msg: u8[], dst: u8[]) -> pairing.Point {
    encode_to(h, h.g1, 1, msg, dst)
}

/// Returns the point of `G2` that `hash_to_curve` of RFC 9380 gives for `msg` and `dst` under the suite `BLS12381G2_XMD:SHA-256_SSWU_RO_`, through the 3-isogenous curve `y^2 = x^3 + 240 i x + 1012 (1 + i)` and `h_eff` of section 8.8.2.
///
/// The running time does not depend on `msg`.
pub fn hash_to_g2(h: *Hasher, msg: u8[], dst: u8[]) -> pairing.Point {
    hash_to(h, h.g2, 2, msg, dst)
}

/// Returns the point of `G2` that `encode_to_curve` of RFC 9380 gives for `msg` and `dst` under the suite `BLS12381G2_XMD:SHA-256_SSWU_NU_`.
pub fn encode_to_g2(h: *Hasher, msg: u8[], dst: u8[]) -> pairing.Point {
    encode_to(h, h.g2, 2, msg, dst)
}
