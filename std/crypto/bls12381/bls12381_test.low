import std/crypto/limb
import std/crypto/pairing
import std/testing
import std/text

fn padded(digit: str) -> str {
    text.repeat("0", 95) + digit
}

fn squares_back(c: *pairing.Curve, a: u64[]) -> bool {
    let root = fp2_sqrt(c, a) ?? return false
    let square: u64[] = __make(2 * c.l)
    pairing.field_square(c, square, root)
    limb.equal(square, a)
}

/// `-1` takes the branch of Algorithm 9 of Adj and Rodríguez-Henríquez, "Square root computation over even extension fields", where `a^((p-1)/2)` is `-1`, which random points of `G2` almost never reach; `3 + u` has norm 10, a square mod `p`, and `1 + u`, the non-residue that builds the tower, has norm 2, which is not.
fn test_fp2_square_root_covers_both_branches_and_rejects_non_residues(t: *testing.T) {
    let c = pairing.bls12_381()
    let minus_one = "1a0111ea397fe69a4b1ba7b6434bacd764774b84f38512bf6730d2a0f6b0f6241eabfffeb153ffffb9feffffffffaaaa"
    t.is_true(squares_back(c, fp2_of(c, minus_one, padded("0"))))
    t.is_true(squares_back(c, fp2_of(c, padded("0"), minus_one)))
    t.is_true(squares_back(c, fp2_of(c, padded("3"), padded("1"))))
    t.is_false(squares_back(c, fp2_of(c, padded("1"), padded("1"))))
}
