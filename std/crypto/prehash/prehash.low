import std/crypto/hash
import std/crypto/sha3

/// A hash function the pre-hash signature schemes ML-DSA (FIPS 204) and SLH-DSA (FIPS 205) accept for HashML-DSA and HashSLH-DSA.
pub enum Hash {
    /// SHA-224, object identifier 2.16.840.1.101.3.4.2.4.
    Sha224
    /// SHA-256, object identifier 2.16.840.1.101.3.4.2.1.
    Sha256
    /// SHA-384, object identifier 2.16.840.1.101.3.4.2.2.
    Sha384
    /// SHA-512, object identifier 2.16.840.1.101.3.4.2.3.
    Sha512
    /// SHA-512/224, object identifier 2.16.840.1.101.3.4.2.5.
    Sha512_224
    /// SHA-512/256, object identifier 2.16.840.1.101.3.4.2.6.
    Sha512_256
    /// SHA3-224, object identifier 2.16.840.1.101.3.4.2.7.
    Sha3_224
    /// SHA3-256, object identifier 2.16.840.1.101.3.4.2.8.
    Sha3_256
    /// SHA3-384, object identifier 2.16.840.1.101.3.4.2.9.
    Sha3_384
    /// SHA3-512, object identifier 2.16.840.1.101.3.4.2.10.
    Sha3_512
    /// SHAKE128 with a 32-byte output, object identifier 2.16.840.1.101.3.4.2.11.
    Shake128
    /// SHAKE256 with a 64-byte output, object identifier 2.16.840.1.101.3.4.2.12.
    Shake256
}

fn oid_arc(h: Hash) -> u8 {
    match h {
        Sha256 => 1
        Sha384 => 2
        Sha512 => 3
        Sha224 => 4
        Sha512_224 => 5
        Sha512_256 => 6
        Sha3_224 => 7
        Sha3_256 => 8
        Sha3_384 => 9
        Sha3_512 => 10
        Shake128 => 11
        Shake256 => 12
    }
}

/// Returns the DER encoding of the object identifier of `h`, 11 bytes: the tag, the length and the nine arcs of 2.16.840.1.101.3.4.2.n.
pub fn oid(h: Hash) -> []u8 {
    [0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, oid_arc(h)]
}

fn shake(x: *sha3.Shake, message: []u8, n: i64) -> []u8 {
    sha3.absorb(x, message)
    sha3.squeeze(x, n)
}

/// Returns the digest of `message` under `h`: the hash's own length for the SHA-2 and SHA-3 functions, 32 bytes for SHAKE128 and 64 bytes for SHAKE256.
pub fn digest(h: Hash, message: []u8) -> []u8 {
    match h {
        Sha224 => hash.sum(hash.sha224(), message)
        Sha256 => hash.sum(hash.sha256(), message)
        Sha384 => hash.sum(hash.sha384(), message)
        Sha512 => hash.sum(hash.sha512(), message)
        Sha512_224 => hash.sum(hash.sha512_224(), message)
        Sha512_256 => hash.sum(hash.sha512_256(), message)
        Sha3_224 => hash.sum(sha3.sha3_224(), message)
        Sha3_256 => hash.sum(sha3.sha3_256(), message)
        Sha3_384 => hash.sum(sha3.sha3_384(), message)
        Sha3_512 => hash.sum(sha3.sha3_512(), message)
        Shake128 => shake(sha3.shake128(), message, 32)
        Shake256 => shake(sha3.shake256(), message, 64)
    }
}
