import std/json

/// The decision a request handler makes about a paused request.
pub enum Verdict {
    /// Let the request go to the network.
    Continue
    /// Abort the request with a generic failure. The page sees a network error.
    Fail
}

/// A request the page is about to make.
pub struct Request {
    /// The absolute URL of the request.
    pub url: str
    /// The HTTP method, for example `GET`.
    pub method: str
    /// The DevTools resource type, for example `Document`, `Script`, `Image`, `XHR` or `Fetch`.
    pub resource: str
}

/// Callbacks invoked for the network activity of a page.
///
/// `request` runs on its own task for every request, so calls can overlap. `response` and `failure` run on the page's event task, in the order the browser reports events, and delay the following events while they run.
///
/// ```low
/// fn skip_images(r: cdp.Request) -> cdp.Verdict {
///     if r.resource == "Image" {
///         return Fail
///     }
///     Continue
/// }
///
/// let handlers = cdp.Handlers {
///     request: skip_images
///     response: fn(url: str, status: i64) { print("{status} {url}") }
///     failure: fn(url: str, reason: str) { print("{url} failed: {reason}") }
/// }
/// ```
pub struct Handlers {
    /// Called before a request is sent, including requests of frames and workers of the page. The page waits for the returned `Verdict`.
    pub request: fn(Request) -> Verdict
    /// Called with the URL and HTTP status code when response headers arrive.
    pub response: fn(str, i64)
    /// Called with the URL and the browser's error text when a request fails. The URL is empty when the request was not seen being sent.
    pub failure: fn(str, str)
}

/// A page in its own isolated browser context.
///
/// The context is disposed when the browser connection closes. Frames, workers and other targets that the page opens are intercepted through the same `Handlers`.
pub struct Page {
    /// The browser the page lives in.
    pub browser: *BrowserHandle
    /// The id of the browser context created for the page.
    pub context: str
    /// The id of the page target.
    pub target: str
    /// The id of the session attached to the page, used as the `session` argument of `call`.
    pub session: str
    subscription: *Subscription
}

enum Attach {
    Ready(session: str)
    Failed(failure: Error)
}

struct Dispatch {
    browser: *BrowserHandle
    context: str
    target: str
    handlers: Handlers
    ready: chan[Attach]
    urls: [str: str]
    sessions: [str: bool]
}

/// Opens a blank page in `b`. See `open_page_on`.
pub fn open_page(b: Browser, handlers: Handlers) -> Page ! Error {
    open_page_on(b.handle, handlers)
}

/// Creates an isolated browser context with downloads denied, opens a blank page in it and starts routing its network activity to `handlers`.
///
/// Every page receives only the events of its own context. Fails with `Timeout` when the page does not attach within `10000` milliseconds, and with the error of the first failing command, or of the command that prepares the page for interception, otherwise; a failed open disposes the context. Further pages that the page itself opens, such as popups, are closed as soon as they attach. A target of the page that cannot be prepared for interception is closed instead of resumed.
pub fn open_page_on(b: *BrowserHandle, handlers: Handlers) -> Page ! Error {
    let c = b.connection
    let created = call(c, "", "Target.createBrowserContext", [json.bool_member("disposeOnDetach", true)])?
    let context = json.text_of(created, "browserContextId")
    let subscription = subscribe(c)
    let page = started(b, context, handlers, subscription) catch {
        e => {
            unsubscribe(c, subscription)
            attempt(c, "", "Target.disposeBrowserContext", [json.text_member("browserContextId", context)])
            fail e
        }
    }
    page
}

fn started(b: *BrowserHandle, context: str, handlers: Handlers, subscription: *Subscription) -> Page ! Error {
    let c = b.connection
    call(c, "", "Browser.setDownloadBehavior", [json.text_member("behavior", "deny"), json.text_member("browserContextId", context)])?
    let d = new(Dispatch { browser: b, context, target: "", handlers, ready: chan[Attach](1), urls: [:], sessions: [:] })
    spawn dispatch(d, subscription)
    call(c, "", "Target.setAutoAttach", attach_options())?
    let target = call(c, "", "Target.createTarget", [json.text_member("url", "about:blank"), json.text_member("browserContextId", context)])?
    let attach: Attach? = select {
        a = <-d.ready => a
        after(10000) => none
    }
    let outcome = match attach {
        some(a) => a
        none => fail Timeout
    }
    match outcome {
        Ready(session) => Page { browser: b, context, target: json.text_of(target, "targetId"), session, subscription }
        Failed(failure) => fail failure
    }
}

/// Ends the page: its events stop and its browser context, with every target in it, is disposed.
///
/// Fails with the errors of `call` when the browser cannot dispose the context; the page's events have stopped by then.
pub fn close_page(p: Page) ! Error {
    unsubscribe(p.browser.connection, p.subscription)
    call(p.browser.connection, "", "Target.disposeBrowserContext", [json.text_member("browserContextId", p.context)])?
}

/// Starts navigating the page to `url`.
///
/// A non-empty `referrer` is sent as the referrer. Returns once the browser accepts the navigation, without waiting for the page to load. Fails with `Protocol(text)` when the browser rejects the navigation, for example because the host cannot be resolved, and with the errors of `call` otherwise.
pub fn navigate(p: Page, url: str, referrer: str) ! Error {
    var params = [json.text_member("url", url)]
    if referrer.len > 0 {
        push(mut params, json.text_member("referrer", referrer))
    }
    let result = call(p.browser.connection, p.session, "Page.navigate", params)?
    let failed = json.text_of(result, "errorText")
    if failed.len > 0 {
        fail Protocol(failed)
    }
}

fn attach_options() -> []json.Member {
    [json.bool_member("autoAttach", true), json.bool_member("waitForDebuggerOnStart", true), json.bool_member("flatten", true)]
}

fn dispatch(d: *Dispatch, s: *Subscription) {
    for {
        let next: Event? = select {
            e = <-s.events => e
            <-s.done => none
        }
        match next {
            some(e) => handle(d, e)
            none => return
        }
    }
}

fn handle(d: *Dispatch, e: Event) {
    if e.method == "Target.attachedToTarget" {
        let info = json.field(e.params, "targetInfo")
        if json.text_of(info, "browserContextId") != d.context {
            return
        }
        d.sessions[json.text_of(e.params, "sessionId")] = true
        let first = d.target.len == 0 && json.text_of(info, "type") == "page"
        if first {
            d.target = json.text_of(info, "targetId")
        }
        spawn attached(d, e.params, first)
        return
    }
    if e.method == "Target.detachedFromTarget" {
        delete(mut d.sessions, json.text_of(e.params, "sessionId"))
        return
    }
    if !(d.sessions[e.session] ?? false) {
        return
    }
    if e.method == "Fetch.requestPaused" {
        spawn paused(d, e.session, e.params)
    } else if e.method == "Network.requestWillBeSent" {
        d.urls["{e.session}/{json.text_of(e.params, "requestId")}"] = json.text_of(json.field(e.params, "request"), "url")
    } else if e.method == "Network.responseReceived" {
        let r = json.field(e.params, "response")
        d.handlers.response(json.text_of(r, "url"), json.int_of(r, "status"))
    } else if e.method == "Network.loadingFailed" {
        let key = "{e.session}/{json.text_of(e.params, "requestId")}"
        d.handlers.failure(d.urls[key] ?? "", json.text_of(e.params, "errorText"))
    }
}

fn attached(d: *Dispatch, params: json.Value, first: bool) {
    let c = d.browser.connection
    let session = json.text_of(params, "sessionId")
    let info = json.field(params, "targetInfo")
    let kind = json.text_of(info, "type")
    let id = json.text_of(info, "targetId")
    if kind == "page" && !first {
        attempt(c, "", "Target.closeTarget", [json.text_member("targetId", id)])
        return
    }
    prepare(c, session, kind == "page") catch {
        e => {
            attempt(c, "", "Target.closeTarget", [json.text_member("targetId", id)])
            if first {
                d.ready <- Failed(e)
            }
            return
        }
    }
    attempt(c, session, "Runtime.runIfWaitingForDebugger", [])
    if first {
        d.ready <- Ready(session)
    }
}

fn prepare(c: *Connection, session: str, page: bool) ! Error {
    call(c, session, "Fetch.enable", [json.array_member("patterns", [json.object_value([json.text_member("urlPattern", "*")])])])?
    call(c, session, "Network.enable", [])?
    if page {
        call(c, session, "Network.setBypassServiceWorker", [json.bool_member("bypass", true)])?
    }
    call(c, session, "Target.setAutoAttach", attach_options())?
}

fn paused(d: *Dispatch, session: str, params: json.Value) {
    let request = json.field(params, "request")
    let r = Request { url: json.text_of(request, "url"), method: json.text_of(request, "method"), resource: json.text_of(params, "resourceType") }
    let id = json.text_of(params, "requestId")
    settle(d.browser.connection, session, id, d.handlers.request(r)) or {}
}

fn settle(c: *Connection, session: str, id: str, v: Verdict) ! Error {
    match v {
        Continue => {
            call(c, session, "Fetch.continueRequest", [json.text_member("requestId", id)])?
        }
        Fail => {
            call(c, session, "Fetch.failRequest", [json.text_member("requestId", id), json.text_member("errorReason", "Failed")])?
        }
    }
}

fn attempt(c: *Connection, session: str, method: str, params: []json.Member) {
    call(c, session, method, params) or json.Value.Null
}
