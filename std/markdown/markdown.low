/// Parses `source` as GitHub Flavored Markdown and returns its blocks.
///
/// Reference link definitions are collected first and resolve links and images anywhere in the document. Headings, paragraphs and table cells carry their parsed inline content.
pub fn parse(source: str) -> []Block {
    let parser = parse_blocks(source)
    convert_children(parser, parser.doc)
}

/// Parses `source` as inline Markdown and returns its spans.
///
/// There are no reference definitions, so `[text][label]` stays text.
pub fn parse_inline(source: str) -> []Inline {
    let none_defined: [str: Reference] = [:]
    parse_inlines(source, none_defined)
}

/// Parses `source` and renders it as HTML the way `marked` does with its default options.
pub fn to_html(source: str) -> str {
    render(Renderer {}, parse(source))
}
