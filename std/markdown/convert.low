import std/text

fn convert_children(p: *Parser, node: *Node) -> []Block {
    var out: []Block = []
    for i, child in node.children {
        let has_next = i + 1 < node.children.len
        let followed = !child.blank_end && (has_next || (node.kind == Kind.Root && p.final_newline))
        push(mut out, convert_block(p, child, followed))
    }
    out
}

fn first_word(s: str) -> str {
    var end = 0
    for end < s.len && !is_line_space(s[end]) {
        end += 1
    }
    s[..end]
}

fn without_final_newline(s: str) -> str {
    if s.len > 0 && s[s.len - 1] == '\n' { s[..s.len - 1] } else { s }
}

fn convert_block(p: *Parser, node: *Node, followed: bool) -> Block {
    match node.kind {
        Title => {
            let raw = trim_space(str(node.content))
            Block.Heading(node.level, raw, parse_inlines(raw, p.refs))
        }
        Para => Block.Paragraph(parse_inlines(paragraph_text(node), p.refs))
        Fence => {
            let lang = if node.fenced { first_word(node.info) } else { "" }
            let info = if node.fenced { node.info } else { "" }
            Block.Code(lang, info, without_final_newline(str(node.content)))
        }
        Markup => Block.Html(if followed { "{str(node.content)}\n" } else { str(node.content) })
        Divider => Block.Rule
        Quoted => Block.Quote(convert_children(p, node))
        Listing => Block.List(convert_list(p, node))
        Grid => Block.Table(convert_table(p, node))
        _ => Block.Rule
    }
}

fn paragraph_text(node: *Node) -> str {
    without_final_newline(str(node.content))
}

fn convert_list(p: *Parser, node: *Node) -> List {
    var items: []Item = []
    for i, entry in node.children {
        if i + 1 == node.children.len {
            trim_last_paragraph(entry)
        }
        push(mut items, convert_item(p, entry))
    }
    List { ordered: node.ordered, start: node.start, tight: node.tight, items }
}

fn trim_last_paragraph(container: *Node) {
    if container.children.len == 0 {
        return
    }
    let last = container.children[container.children.len - 1]
    match last.kind {
        Para => {
            last.content = bytes("{trim_end_blanks(without_final_newline(str(last.content)))}\n")
        }
        Quoted => trim_last_paragraph(last)
        _ => {}
    }
}

fn task_marker_len(s: str) -> i64 {
    if s.len < 5 || s[0] != '[' || s[2] != ']' || !(s[1] == ' ' || s[1] == 'x' || s[1] == 'X') {
        return 0
    }
    var i = 3
    for i < s.len && is_blank(s[i]) {
        i += 1
    }
    if i == 3 || i >= s.len || is_line_space(s[i]) {
        return 0
    }
    i
}

fn convert_item(p: *Parser, entry: *Node) -> Item {
    var checked: bool? = none
    if entry.children.len > 0 && entry.children[0].kind == Kind.Para {
        let first = entry.children[0]
        let content = str(first.content)
        let marker = task_marker_len(content)
        if marker > 0 {
            checked = content[1] != ' '
            first.content = bytes(content[marker..])
        }
    }
    Item { blocks: convert_children(p, entry), checked }
}

fn convert_table(p: *Parser, node: *Node) -> Table {
    let width = node.aligns.len
    let header = convert_cells(p, split_cells(node.header, width), node.aligns)
    var rows: [][]Cell = []
    let lines = text.split(without_final_newline(str(node.content)), '\n')
    for line in lines {
        if line != "" {
            push(mut rows, convert_cells(p, split_cells(line, width), node.aligns))
        }
    }
    Table { header, rows }
}

fn convert_cells(p: *Parser, raws: []str, aligns: []Align) -> []Cell {
    var cells: []Cell = []
    for i, raw in raws {
        push(mut cells, Cell { raw, content: parse_inlines(raw, p.refs), align: aligns[i] })
    }
    cells
}
