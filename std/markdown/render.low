import std/builder
import std/html
import std/text

/// The hooks that turn parts of a document into HTML.
///
/// `Renderer {}` renders like `marked`. Setting a field replaces one hook and leaves the rest. Every hook receives the renderer, so it can call `render_inline` on content or `render` on blocks and nest whatever the renderer does for the rest. A hook can also return what the matching `default_*` function returns, after changing its arguments.
pub struct Renderer {
    /// Renders a fenced or indented code block from its first-word language, empty for none, and its literal text. The result is the whole block, including any trailing line ending.
    pub code_block: fn(Renderer, str, str) -> str = default_code_block
    /// Renders a code span from its text. The result is the whole span.
    pub code_span: fn(Renderer, str) -> str = default_code_span
    /// Renders a heading from its level, its raw source text and its content already rendered as HTML. The result is the whole heading, including any trailing line ending.
    pub heading: fn(Renderer, i64, str, str) -> str = default_heading
    /// Renders a raw HTML block from its text, which ends with a line ending only when the next block follows on the very next line. Returning an empty string drops the block.
    pub html_block: fn(Renderer, str) -> str = default_html_block
    /// Renders a raw HTML tag or comment inside a paragraph from its text. The result replaces it.
    pub html_inline: fn(Renderer, str) -> str = default_html_inline
    /// Renders a table. The result is the whole table, including any trailing line ending.
    pub table: fn(Renderer, Table) -> str = default_table
}

/// Escapes `s` for HTML text and attribute values.
///
/// `&`, `<`, `>`, `"` and `'` become `&amp;`, `&lt;`, `&gt;`, `&quot;` and `&#39;`.
pub fn escape_html(s: str) -> str {
    html.escape(s)
}

/// Renders `blocks` as HTML with the hooks of `r`.
pub fn render(r: Renderer, blocks: []Block) -> str {
    var out = builder.builder()
    for block in blocks {
        write_block(r, mut out, block)
    }
    builder.to_str(out)
}

/// Renders `content` as HTML with the hooks of `r`.
pub fn render_inline(r: Renderer, content: []Inline) -> str {
    var out = builder.builder()
    write_inlines(r, mut out, content)
    builder.to_str(out)
}

/// Renders a fenced or indented code block as `<pre><code>`, with a `language-` class when `lang` is not empty.
pub fn default_code_block(r: Renderer, lang: str, code: str) -> str {
    let body = if code == "" { "" } else { "{without_final_newline(code)}\n" }
    let class = if lang == "" { "" } else { " class=\"language-{escape_loose(lang)}\"" }
    "<pre><code{class}>{html.escape(body)}</code></pre>\n"
}

/// Renders a code span as `<code>`.
pub fn default_code_span(r: Renderer, code: str) -> str {
    "<code>{html.escape(code)}</code>"
}

/// Renders a heading as `<h1>` to `<h6>` followed by a line ending.
pub fn default_heading(r: Renderer, level: i64, raw: str, inner: str) -> str {
    "<h{level}>{inner}</h{level}>\n"
}

/// Renders a raw HTML block as its text, unchanged.
pub fn default_html_block(r: Renderer, source: str) -> str {
    source
}

/// Renders raw inline HTML as its text, unchanged.
pub fn default_html_inline(r: Renderer, source: str) -> str {
    source
}

/// Renders a table as `<table>` with a `<thead>` and, when there are rows, a `<tbody>`.
pub fn default_table(r: Renderer, t: Table) -> str {
    var out = builder.builder()
    builder.write(mut out, "<table>\n<thead>\n")
    write_row(r, mut out, t.header, "th")
    builder.write(mut out, "</thead>\n")
    if t.rows.len > 0 {
        builder.write(mut out, "<tbody>")
        for row in t.rows {
            write_row(r, mut out, row, "td")
        }
        builder.write(mut out, "</tbody>")
    }
    builder.write(mut out, "</table>\n")
    builder.to_str(out)
}

/// Returns the text of `content` as a reader sees it: no markup, character references decoded to the characters they stand for, and a line ending for every break.
pub fn plain_text(content: []Inline) -> str {
    var out = builder.builder()
    write_plain(mut out, content)
    builder.to_str(out)
}

fn write_plain(mut out: builder.Builder, content: []Inline) {
    for node in content {
        match node {
            Text(value) => builder.write(mut out, value)
            Escape(value) => builder.write(mut out, value)
            Entity(_, value) => builder.write(mut out, value)
            Code(value) => builder.write(mut out, value)
            Emphasis(children) => write_plain(mut out, children)
            Strong(children) => write_plain(mut out, children)
            Strikethrough(children) => write_plain(mut out, children)
            Link(_, _, children) => write_plain(mut out, children)
            Image(_, _, alt) => write_plain(mut out, alt)
            Autolink(_, label) => builder.write(mut out, label)
            Html(value) => builder.write(mut out, value)
            SoftBreak => builder.write_byte(mut out, '\n')
            HardBreak => builder.write_byte(mut out, '\n')
        }
    }
}

fn escape_loose(s: str) -> str {
    escape_html_with(s, false)
}

fn escape_html_with(s: str, encode: bool) -> str {
    var out: []u8 = []
    var i = 0
    for i < s.len {
        let c = s[i]
        match c {
            '&' => {
                if !encode && reference_end(s, i) > 0 {
                    push(mut out, c)
                } else {
                    text.append(mut out, "&amp;")
                }
            }
            '<' => text.append(mut out, "&lt;")
            '>' => text.append(mut out, "&gt;")
            '"' => text.append(mut out, "&quot;")
            '\'' => text.append(mut out, "&#39;")
            _ => push(mut out, c)
        }
        i += 1
    }
    str(out)
}

fn reference_end(s: str, at: i64) -> i64 {
    var i = at + 1
    if byte_at(s, i) == '#' {
        i += 1
        let hex = byte_at(s, i) == 'x' || byte_at(s, i) == 'X'
        if hex {
            i += 1
        }
        let start = i
        for i < s.len && (if hex { is_hex(s[i]) } else { is_digit(s[i]) }) {
            i += 1
        }
        let limit = if hex { 6 } else { 7 }
        if i - start >= 1 && i - start <= limit && byte_at(s, i) == ';' {
            return i + 1 - at
        }
        return 0
    }
    let start = i
    for i < s.len && is_word(s[i]) {
        i += 1
    }
    if i > start && byte_at(s, i) == ';' {
        return i + 1 - at
    }
    0
}

fn clean_url(href: str) -> str {
    var out: []u8 = []
    for i in 0..href.len {
        let c = href[i]
        let keep = is_alnum(c) || c == '%' || c == ';' || c == ',' || c == '/' || c == '?' || c == ':' || c == '@' || c == '&' || c == '=' || c == '+' || c == '$' || c == '-' || c == '_' || c == '.' || c == '!' || c == '~' || c == '*' || c == '\'' || c == '(' || c == ')' || c == '#'
        if keep {
            push(mut out, c)
        } else {
            push(mut out, '%')
            text.append_hex(mut out, i64(c), 2, true)
        }
    }
    str(out)
}

fn entity_html(raw: str) -> str {
    if byte_at(raw, 1) != '#' {
        return raw
    }
    escape_html_with(entity_plain(raw), false)
}

fn write_alt(mut out: builder.Builder, content: []Inline) {
    for node in content {
        match node {
            Text(value) => builder.write(mut out, value)
            Escape(value) => builder.write(mut out, value)
            Entity(raw, _) => builder.write(mut out, entity_plain(raw))
            Code(value) => builder.write(mut out, value)
            Emphasis(children) => write_alt(mut out, children)
            Strong(children) => write_alt(mut out, children)
            Strikethrough(children) => write_alt(mut out, children)
            Link(_, _, children) => write_alt(mut out, children)
            Image(_, _, alt) => write_alt(mut out, alt)
            Autolink(_, label) => builder.write(mut out, label)
            Html(value) => builder.write(mut out, value)
            SoftBreak => builder.write_byte(mut out, '\n')
            HardBreak => builder.write_byte(mut out, '\n')
        }
    }
}

fn entity_plain(raw: str) -> str {
    if byte_at(raw, 1) != '#' {
        return raw
    }
    let hex = byte_at(raw, 2) == 'x' || byte_at(raw, 2) == 'X'
    let digits = raw[if hex { 3 } else { 2 }..raw.len - 1]
    let code = text.parse_uint(digits, if hex { 16 } else { 10 }) or 0
    if code == 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF) {
        return text.from_char(0xFFFD)
    }
    if code == 38 {
        return "&amp;"
    }
    text.from_char(u32(code))
}

fn write_inlines(r: Renderer, mut out: builder.Builder, content: []Inline) {
    for node in content {
        write_inline(r, mut out, node)
    }
}

fn write_wrapped(r: Renderer, mut out: builder.Builder, tag: str, children: []Inline) {
    builder.write(mut out, "<{tag}>")
    write_inlines(r, mut out, children)
    builder.write(mut out, "</{tag}>")
}

fn write_inline(r: Renderer, mut out: builder.Builder, node: Inline) {
    match node {
        Text(value) => builder.write(mut out, escape_html_with(value, false))
        Escape(value) => builder.write(mut out, escape_html_with(value, false))
        Entity(raw, _) => builder.write(mut out, entity_html(raw))
        Code(value) => builder.write(mut out, r.code_span(r, value))
        Emphasis(children) => write_wrapped(r, mut out, "em", children)
        Strong(children) => write_wrapped(r, mut out, "strong", children)
        Strikethrough(children) => write_wrapped(r, mut out, "del", children)
        Link(href, title, children) => write_link(r, mut out, href, title, children)
        Image(src, title, alt) => write_image(mut out, src, title, alt)
        Autolink(href, label) => write_autolink(mut out, href, label)
        Html(value) => builder.write(mut out, r.html_inline(r, value))
        SoftBreak => builder.write_byte(mut out, '\n')
        HardBreak => builder.write(mut out, "<br>")
    }
}

fn write_link(r: Renderer, mut out: builder.Builder, href: str, title: str, children: []Inline) {
    builder.write(mut out, "<a href=\"{escape_loose(clean_url(href))}\"")
    if title != "" {
        builder.write(mut out, " title=\"{escape_loose(title)}\"")
    }
    builder.write_byte(mut out, '>')
    write_inlines(r, mut out, children)
    builder.write(mut out, "</a>")
}

fn write_autolink(mut out: builder.Builder, href: str, label: str) {
    builder.write(mut out, "<a href=\"{html.escape(clean_url(href))}\">{html.escape(label)}</a>")
}

fn write_image(mut out: builder.Builder, src: str, title: str, alt: []Inline) {
    var scratch = builder.builder()
    write_alt(mut scratch, alt)
    let text_alt = builder.to_str(scratch)
    builder.write(mut out, "<img src=\"{escape_loose(clean_url(src))}\" alt=\"{escape_loose(text_alt)}\"")
    if title != "" {
        builder.write(mut out, " title=\"{escape_loose(title)}\"")
    }
    builder.write_byte(mut out, '>')
}

fn write_row(r: Renderer, mut out: builder.Builder, cells: []Cell, tag: str) {
    builder.write(mut out, "<tr>\n")
    for cell in cells {
        let align = match cell.align {
            Default => ""
            Left => " align=\"left\""
            Center => " align=\"center\""
            Right => " align=\"right\""
        }
        builder.write(mut out, "<{tag}{align}>")
        write_inlines(r, mut out, cell.content)
        builder.write(mut out, "</{tag}>\n")
    }
    builder.write(mut out, "</tr>\n")
}

fn write_block(r: Renderer, mut out: builder.Builder, block: Block) {
    match block {
        Heading(level, raw, content) => {
            let inner = render_inline(r, content)
            builder.write(mut out, r.heading(r, level, raw, inner))
        }
        Paragraph(content) => {
            builder.write(mut out, "<p>")
            write_inlines(r, mut out, content)
            builder.write(mut out, "</p>\n")
        }
        Code(lang, _, code) => builder.write(mut out, r.code_block(r, lang, code))
        Html(source) => builder.write(mut out, r.html_block(r, source))
        List(list) => write_list(r, mut out, list)
        Quote(children) => {
            builder.write(mut out, "<blockquote>\n")
            for child in children {
                write_block(r, mut out, child)
            }
            builder.write(mut out, "</blockquote>\n")
        }
        Table(t) => builder.write(mut out, r.table(r, t))
        Rule => builder.write(mut out, "<hr>\n")
    }
}

fn write_list(r: Renderer, mut out: builder.Builder, list: List) {
    let tag = if list.ordered { "ol" } else { "ul" }
    let start = if list.ordered && list.start != 1 { " start=\"{list.start}\"" } else { "" }
    builder.write(mut out, "<{tag}{start}>\n")
    for item in list.items {
        write_item(r, mut out, item, list.tight)
    }
    builder.write(mut out, "</{tag}>\n")
}

fn checkbox_html(checked: bool) -> str {
    if checked {
        "<input checked=\"\" disabled=\"\" type=\"checkbox\"> "
    } else {
        "<input disabled=\"\" type=\"checkbox\"> "
    }
}

fn write_item(r: Renderer, mut out: builder.Builder, item: Item, tight: bool) {
    builder.write(mut out, "<li>")
    var pending = item.checked
    for block in item.blocks {
        match block {
            Paragraph(content) => {
                if !tight {
                    builder.write(mut out, "<p>")
                }
                match pending {
                    some(checked) => builder.write(mut out, checkbox_html(checked))
                    none => {}
                }
                pending = none
                write_inlines(r, mut out, content)
                if !tight {
                    builder.write(mut out, "</p>\n")
                }
            }
            _ => write_block(r, mut out, block)
        }
    }
    builder.write(mut out, "</li>\n")
}
