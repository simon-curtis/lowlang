fn skip_whitespace(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len && is_line_space(s[i]) {
        i += 1
    }
    i
}

fn attribute_name_start(c: u8) -> bool {
    is_alpha(c) || c == '_' || c == ':'
}

fn attribute_name_part(c: u8) -> bool {
    is_word(c) || c == '.' || c == ':' || c == '-'
}

fn unquoted_value_part(c: u8) -> bool {
    !is_line_space(c) && c != '"' && c != '\'' && c != '=' && c != '<' && c != '>' && c != '`'
}

fn attribute_end(s: str, at: i64) -> i64 {
    var i = at + 1
    for i < s.len && attribute_name_part(s[i]) {
        i += 1
    }
    let after_name = i
    var j = skip_whitespace(s, i)
    if byte_at(s, j) != '=' {
        return after_name
    }
    j = skip_whitespace(s, j + 1)
    let c = byte_at(s, j)
    if c == '"' || c == '\'' {
        let close = find_byte_from(s, j + 1, c)
        if close < 0 {
            return after_name
        }
        return close + 1
    }
    var k = j
    for k < s.len && unquoted_value_part(s[k]) {
        k += 1
    }
    if k == j {
        return after_name
    }
    k
}

fn open_tag_end(s: str, at: i64) -> i64 {
    if byte_at(s, at) != '<' || !is_alpha(byte_at(s, at + 1)) {
        return -1
    }
    var i = at + 2
    for i < s.len && (is_alnum(s[i]) || s[i] == '-') {
        i += 1
    }
    for {
        let j = skip_whitespace(s, i)
        let c = byte_at(s, j)
        if c == '>' {
            return j + 1
        }
        if c == '/' && byte_at(s, j + 1) == '>' {
            return j + 2
        }
        if j == i || !attribute_name_start(c) {
            return -1
        }
        i = attribute_end(s, j)
    }
    -1
}

fn close_tag_end(s: str, at: i64) -> i64 {
    if byte_at(s, at) != '<' || byte_at(s, at + 1) != '/' || !is_alpha(byte_at(s, at + 2)) {
        return -1
    }
    var i = at + 3
    for i < s.len && (is_alnum(s[i]) || s[i] == '-') {
        i += 1
    }
    i = skip_whitespace(s, i)
    if byte_at(s, i) == '>' {
        return i + 1
    }
    -1
}

fn comment_end(s: str, at: i64) -> i64 {
    if !starts_with_at(s, at, "<!--") {
        return -1
    }
    if starts_with_at(s, at + 4, ">") {
        return at + 5
    }
    if starts_with_at(s, at + 4, "->") {
        return at + 6
    }
    let close = find_from(s, at + 4, "-->")
    if close < 0 {
        return -1
    }
    close + 3
}

fn starts_with_at(s: str, at: i64, prefix: str) -> bool {
    at >= 0 && at + prefix.len <= s.len && s[at..at + prefix.len] == prefix
}

fn inline_html_end(s: str, at: i64) -> i64 {
    if byte_at(s, at) != '<' {
        return -1
    }
    let next = byte_at(s, at + 1)
    if next == '!' {
        let comment = comment_end(s, at)
        if comment >= 0 {
            return comment
        }
        if starts_with_at(s, at + 2, "[CDATA[") {
            let close = find_from(s, at + 9, "]]>")
            return if close < 0 { -1 } else { close + 3 }
        }
        var i = at + 2
        for i < s.len && is_alpha(s[i]) {
            i += 1
        }
        if i > at + 2 && i < s.len && is_line_space(s[i]) {
            let close = find_byte_from(s, i, '>')
            return if close < 0 { -1 } else { close + 1 }
        }
        return -1
    }
    if next == '?' {
        let close = find_from(s, at + 2, "?>")
        return if close < 0 { -1 } else { close + 2 }
    }
    if next == '/' {
        return close_tag_end(s, at)
    }
    open_tag_end(s, at)
}
