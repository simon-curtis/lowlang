import std/html
import std/text

enum TokKind {
    Edge
    Done
    Run
    Bracket
    ImageBracket
}

struct Tok {
    kind: TokKind
    node: Inline
    ch: u8 = 0
    count: i64 = 0
    orig: i64 = 0
    can_open: bool = false
    can_close: bool = false
    active: bool = true
    at: i64 = 0
}

struct InlineParser {
    s: str
    pos: i64
    toks: []Tok
    buf: []u8
    refs: [str: Reference]
}

fn done(node: Inline) -> Tok {
    Tok { kind: TokKind.Done, node }
}

fn parse_inlines(s: str, refs: [str: Reference]) -> []Inline {
    var p = InlineParser { s, pos: 0, toks: [], buf: [], refs }
    for p.pos < s.len {
        inline_step(mut p)
    }
    flush_text(mut p)
    link_autolinks(resolve(p.toks))
}

fn flush_text(mut p: InlineParser) {
    if p.buf.len > 0 {
        push(mut p.toks, done(Inline.Text(str(p.buf))))
        truncate(mut p.buf, 0)
    }
}

fn emit(mut p: InlineParser, node: Inline) {
    flush_text(mut p)
    push(mut p.toks, done(node))
}

fn inline_step(mut p: InlineParser) {
    let c = p.s[p.pos]
    match c {
        '\\' => step_backslash(mut p)
        '\n' => step_newline(mut p)
        '`' => step_code(mut p)
        '*' => step_run(mut p)
        '_' => step_run(mut p)
        '~' => step_run(mut p)
        '[' => step_open(mut p, false)
        '!' => step_bang(mut p)
        ']' => step_close(mut p)
        '<' => step_angle(mut p)
        '&' => step_entity(mut p)
        _ => step_text(mut p)
    }
}

fn step_text(mut p: InlineParser) {
    push(mut p.buf, p.s[p.pos])
    p.pos += 1
}

fn step_backslash(mut p: InlineParser) {
    let next = byte_at(p.s, p.pos + 1)
    if next == '\n' && !is_blank_line(p.s[p.pos + 2..]) && !at_end_of_lines(p.s, p.pos + 2) {
        emit(mut p, Inline.HardBreak)
        p.pos = skip_blanks(p.s, p.pos + 2)
        return
    }
    if next != 0 && is_ascii_punct(next) {
        emit(mut p, Inline.Escape(p.s[p.pos + 1..p.pos + 2]))
        p.pos += 2
        return
    }
    push(mut p.buf, '\\')
    p.pos += 1
}

fn at_end_of_lines(s: str, from: i64) -> bool {
    trim_space(s[from..]) == ""
}

fn step_newline(mut p: InlineParser) {
    var spaces = 0
    for spaces < p.buf.len && p.buf[p.buf.len - 1 - spaces] == ' ' {
        spaces += 1
    }
    let last = at_end_of_lines(p.s, p.pos + 1)
    p.pos += 1
    if spaces >= 2 && !last {
        truncate(mut p.buf, p.buf.len - spaces)
        emit(mut p, Inline.HardBreak)
        p.pos = skip_blanks(p.s, p.pos)
    } else {
        emit(mut p, Inline.SoftBreak)
    }
}

fn step_code(mut p: InlineParser) {
    var n = 0
    for p.pos + n < p.s.len && p.s[p.pos + n] == '`' {
        n += 1
    }
    var at = p.pos + n
    for at < p.s.len {
        let close = find_byte_from(p.s, at, '`')
        if close < 0 {
            break
        }
        var m = 0
        for close + m < p.s.len && p.s[close + m] == '`' {
            m += 1
        }
        if m == n {
            emit(mut p, Inline.Code(code_span_text(p.s[p.pos + n..close])))
            p.pos = close + m
            return
        }
        at = close + m
    }
    for i in 0..n {
        push(mut p.buf, '`')
    }
    p.pos += n
}

fn code_span_text(raw: str) -> str {
    let flat = text.replace(raw, "\n", " ")
    var all_space = true
    for i in 0..flat.len {
        if flat[i] != ' ' {
            all_space = false
            break
        }
    }
    if !all_space && flat.len >= 2 && flat[0] == ' ' && flat[flat.len - 1] == ' ' {
        return flat[1..flat.len - 1]
    }
    flat
}

fn step_run(mut p: InlineParser) {
    let c = p.s[p.pos]
    var n = 0
    for p.pos + n < p.s.len && p.s[p.pos + n] == c {
        n += 1
    }
    if c == '~' && n > 2 {
        for i in 0..n {
            push(mut p.buf, c)
        }
        p.pos += n
        return
    }
    let before = code_before(p.s, p.pos)
    let after = code_after(p.s, p.pos + n)
    let space_before = is_space_code(before)
    let space_after = is_space_code(after)
    let punct_before = is_punct_code(before)
    let punct_after = is_punct_code(after)
    let left = !space_after && (!punct_after || space_before || punct_before)
    let right = !space_before && (!punct_before || space_after || punct_after)
    var can_open = left
    var can_close = right
    if c == '_' {
        can_open = left && (!right || punct_before)
        can_close = right && (!left || punct_after)
    }
    flush_text(mut p)
    push(mut p.toks, Tok { kind: TokKind.Run, node: Inline.SoftBreak, ch: c, count: n, orig: n, can_open, can_close })
    p.pos += n
}

fn step_open(mut p: InlineParser, image: bool) {
    flush_text(mut p)
    let kind = if image { TokKind.ImageBracket } else { TokKind.Bracket }
    push(mut p.toks, Tok { kind, node: Inline.SoftBreak, at: p.pos })
    p.pos += if image { 2 } else { 1 }
}

fn step_bang(mut p: InlineParser) {
    if byte_at(p.s, p.pos + 1) == '[' {
        step_open(mut p, true)
        return
    }
    push(mut p.buf, '!')
    p.pos += 1
}

fn last_bracket(toks: []Tok) -> i64 {
    var i = toks.len - 1
    for i >= 0 {
        if toks[i].kind == TokKind.Bracket || toks[i].kind == TokKind.ImageBracket {
            return i
        }
        i -= 1
    }
    -1
}

fn bracket_text(kind: TokKind) -> str {
    if kind == TokKind.ImageBracket { "![" } else { "[" }
}

struct LinkTarget {
    end: i64
    href: str
    title: str
}

fn no_target() -> LinkTarget {
    LinkTarget { end: -1, href: "", title: "" }
}

fn inline_target(s: str, from: i64) -> LinkTarget {
    var at = skip_newline_space(s, from + 1)
    let destination = link_destination(s, at)
    if destination.end < 0 {
        return no_target()
    }
    var end = destination.end
    var title = ""
    let spaced = skip_newline_space(s, end)
    if spaced != end {
        let candidate = link_title(s, spaced)
        if candidate.end >= 0 {
            title = candidate.value
            end = candidate.end
        }
    }
    end = skip_newline_space(s, end)
    if byte_at(s, end) != ')' {
        return no_target()
    }
    LinkTarget { end: end + 1, href: destination.value, title }
}

fn reference_target(p: InlineParser, opener_at: i64, after: i64) -> LinkTarget {
    let own_end = after - 1
    let full = label_end(p.s, after)
    var key = ""
    var end = after
    if full > after + 2 {
        key = normalize_label(p.s[after + 1..full - 1])
        end = full
    } else if full == after + 2 {
        if label_end(p.s, opener_at) != own_end + 1 {
            return no_target()
        }
        key = normalize_label(p.s[opener_at + 1..own_end])
        end = full
    } else if full < 0 {
        if label_end(p.s, opener_at) != own_end + 1 {
            return no_target()
        }
        key = normalize_label(p.s[opener_at + 1..own_end])
    } else {
        return no_target()
    }
    let found = p.refs[key] ?? return no_target()
    LinkTarget { end, href: found.href, title: found.title }
}

fn step_close(mut p: InlineParser) {
    flush_text(mut p)
    let idx = last_bracket(p.toks)
    if idx < 0 {
        push(mut p.buf, ']')
        p.pos += 1
        return
    }
    let opener = p.toks[idx]
    if !opener.active {
        p.toks[idx] = done(Inline.Text(bracket_text(opener.kind)))
        push(mut p.buf, ']')
        p.pos += 1
        return
    }
    let open_at = if opener.kind == TokKind.ImageBracket { opener.at + 1 } else { opener.at }
    var target = no_target()
    if byte_at(p.s, p.pos + 1) == '(' {
        target = inline_target(p.s, p.pos + 1)
    }
    if target.end < 0 {
        target = reference_target(p, open_at, p.pos + 1)
    }
    if target.end < 0 {
        p.toks[idx] = done(Inline.Text(bracket_text(opener.kind)))
        push(mut p.buf, ']')
        p.pos += 1
        return
    }
    let inner = resolve(p.toks[idx + 1..])
    truncate(mut p.toks, idx)
    if opener.kind == TokKind.ImageBracket {
        push(mut p.toks, done(Inline.Image(target.href, target.title, inner)))
    } else {
        push(mut p.toks, done(Inline.Link(target.href, target.title, inner)))
        for i in 0..p.toks.len {
            if p.toks[i].kind == TokKind.Bracket {
                p.toks[i].active = false
            }
        }
    }
    p.pos = target.end
}

fn is_scheme_char(c: u8) -> bool {
    is_alnum(c) || c == '+' || c == '.' || c == '-'
}

fn is_email_local_char(c: u8) -> bool {
    is_alnum(c) || c == '.' || c == '!' || c == '#' || c == '$' || c == '%' || c == '&' || c == '\'' || c == '*' || c == '+' || c == '/' || c == '=' || c == '?' || c == '^' || c == '_' || c == '`' || c == '{' || c == '|' || c == '}' || c == '~' || c == '-'
}

fn email_label_end(s: str, from: i64) -> i64 {
    var i = from
    if !is_alnum(byte_at(s, i)) {
        return -1
    }
    for {
        var j = i
        for j < s.len && (is_alnum(s[j]) || s[j] == '-') {
            j += 1
        }
        if j - i > 63 {
            return -1
        }
        for j > i && s[j - 1] == '-' {
            j -= 1
        }
        i = j
        if byte_at(s, i) == '.' && is_alnum(byte_at(s, i + 1)) {
            i += 1
        } else {
            break
        }
    }
    i
}

fn angle_autolink_end(s: str, at: i64) -> i64 {
    let start = at + 1
    if is_alpha(byte_at(s, start)) {
        var i = start + 1
        for i < s.len && is_scheme_char(s[i]) {
            i += 1
        }
        let scheme_len = i - start
        if scheme_len >= 2 && scheme_len <= 32 && byte_at(s, i) == ':' {
            i += 1
            for i < s.len && !is_line_space(s[i]) && s[i] >= 0x20 && s[i] != '<' && s[i] != '>' {
                i += 1
            }
            if byte_at(s, i) == '>' {
                return i
            }
        }
    }
    var i = start
    for i < s.len && is_email_local_char(s[i]) {
        i += 1
    }
    if i > start && byte_at(s, i) == '@' {
        let end = email_label_end(s, i + 1)
        if end > 0 && byte_at(s, end) == '>' {
            return end
        }
    }
    -1
}

fn step_angle(mut p: InlineParser) {
    let close = angle_autolink_end(p.s, p.pos)
    if close >= 0 {
        let label = p.s[p.pos + 1..close]
        let href = if !has_scheme(label) { "mailto:{label}" } else { label }
        emit(mut p, Inline.Autolink(href, label))
        p.pos = close + 1
        return
    }
    let end = inline_html_end(p.s, p.pos)
    if end >= 0 {
        emit(mut p, Inline.Html(p.s[p.pos..end]))
        p.pos = end
        return
    }
    push(mut p.buf, '<')
    p.pos += 1
}

fn has_scheme(label: str) -> bool {
    if !is_alpha(byte_at(label, 0)) {
        return false
    }
    var i = 1
    for i < label.len && is_scheme_char(label[i]) {
        i += 1
    }
    i >= 2 && i <= 32 && byte_at(label, i) == ':'
}

fn step_entity(mut p: InlineParser) {
    let end = entity_end(p.s, p.pos)
    if end < 0 {
        push(mut p.buf, '&')
        p.pos += 1
        return
    }
    let raw = p.s[p.pos..end]
    emit(mut p, Inline.Entity(raw, html.unescape(raw)))
    p.pos = end
}

