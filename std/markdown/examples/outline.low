import std/markdown
import std/text

fn collect_links(content: []markdown.Inline, mut found: []str) {
    for node in content {
        match node {
            Link(href, _, children) => {
                push(mut found, "{markdown.plain_text(children)} -> {href}")
                collect_links(children, mut found)
            }
            Autolink(href, _) => push(mut found, href)
            Emphasis(children) => collect_links(children, mut found)
            Strong(children) => collect_links(children, mut found)
            Strikethrough(children) => collect_links(children, mut found)
            _ => {}
        }
    }
}

fn walk(blocks: []markdown.Block, mut found: []str) {
    for block in blocks {
        match block {
            Heading(level, raw, content) => {
                let indent = "  ".repeat(level - 1)
                print("{indent}{raw}")
                collect_links(content, mut found)
            }
            Paragraph(content) => collect_links(content, mut found)
            List(list) => {
                for item in list.items {
                    walk(item.blocks, mut found)
                }
            }
            Quote(children) => walk(children, mut found)
            Table(table) => {
                for row in table.rows {
                    for cell in row {
                        collect_links(cell.content, mut found)
                    }
                }
            }
            _ => {}
        }
    }
}

/// Parses a document, prints its heading outline indented by level, and lists every link found in headings, paragraphs, lists, quotes and tables.
fn main() {
    let source = "# Low\n\nSee [the docs](https://example.com/docs) or https://example.com.\n\n## Install\n\n- grab the [release](https://example.com/release)\n- read *the [notes](notes.md)*\n\n### Windows\n\n> Needs [WSL](https://learn.microsoft.com)\n\n| Tool | Link |\n|---|---|\n| editor | [zed](https://zed.dev) |\n"
    var found: []str = []
    walk(markdown.parse(source), mut found)
    print("links:")
    for link in found {
        print("  {link}")
    }
}
