import std/builder
import std/markdown
import std/text

fn slug(raw: str) -> str {
    var out = builder.builder()
    var dash = false
    let lowered = text.lower(raw)
    for i in 0..lowered.len {
        let c = lowered[i]
        if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') {
            if dash && builder.len(out) > 0 {
                builder.write_byte(mut out, '-')
            }
            dash = false
            builder.write_byte(mut out, c)
        } else {
            dash = true
        }
    }
    builder.to_str(out)
}

fn anchored_heading(r: markdown.Renderer, level: i64, raw: str, inner: str) -> str {
    "<h{level} id=\"{slug(raw)}\">{inner}</h{level}>\n"
}

fn labelled_code(r: markdown.Renderer, lang: str, code: str) -> str {
    let block = markdown.default_code_block(r, lang, code)
    if lang == "" { block } else { "<figure data-lang=\"{lang}\">{block}</figure>\n" }
}

fn drop_comments(r: markdown.Renderer, source: str) -> str {
    if text.starts_with(source, "<!--") { "" } else { markdown.default_html_block(r, source) }
}

/// Renders a document with custom hooks that add heading anchors, wrap code blocks in a labelled figure and drop HTML comments.
fn main() {
    let source = "# Getting started with `low`\n\n<!-- internal note\nspanning lines -->\n\n<aside>kept</aside>\n\n## Install & run\n\n```sh\nlow run main.low\n```\n\n    indented stays plain\n"
    let renderer = markdown.Renderer {
        heading: anchored_heading,
        code_block: labelled_code,
        html_block: drop_comments,
    }
    print(markdown.render(renderer, markdown.parse(source)))
}
