import std/unicode

struct Reference {
    href: str
    title: str
}

struct Scan {
    end: i64
    value: str
}

fn failed() -> Scan {
    Scan { end: -1, value: "" }
}

fn byte_at(s: str, at: i64) -> u8 {
    if at < 0 || at >= s.len { 0 } else { s[at] }
}

fn skip_newline_space(s: str, from: i64) -> i64 {
    var i = skip_spaces(s, from)
    if i < s.len && s[i] == '\n' {
        i = skip_spaces(s, i + 1)
    }
    i
}

fn label_end(s: str, at: i64) -> i64 {
    if byte_at(s, at) != '[' {
        return -1
    }
    var i = at + 1
    for i < s.len {
        let c = s[i]
        if c == '\\' && i + 1 < s.len && is_ascii_punct(s[i + 1]) {
            i += 2
            continue
        }
        if c == '[' {
            return -1
        }
        if c == ']' {
            if i - at > 1000 {
                return -1
            }
            return i + 1
        }
        i += 1
    }
    -1
}

fn normalize_label(label: str) -> str {
    var out: []u8 = []
    var pending = false
    for i in 0..label.len {
        let c = label[i]
        if is_line_space(c) {
            pending = out.len > 0
        } else {
            if pending {
                push(mut out, ' ')
                pending = false
            }
            push(mut out, c)
        }
    }
    unicode.casefold(str(out))
}

fn link_destination(s: str, at: i64) -> Scan {
    if byte_at(s, at) == '<' {
        var i = at + 1
        for i < s.len {
            let c = s[i]
            if c == '\\' && i + 1 < s.len && is_ascii_punct(s[i + 1]) {
                i += 2
                continue
            }
            if c == '>' {
                return Scan { end: i + 1, value: unescape_punct(s[at + 1..i]) }
            }
            if c == '<' || c == '\n' || c == 0 {
                return failed()
            }
            i += 1
        }
        return failed()
    }
    var i = at
    var depth = 0
    for i < s.len {
        let c = s[i]
        if c == '\\' && i + 1 < s.len && is_ascii_punct(s[i + 1]) {
            i += 2
        } else if c == '(' {
            depth += 1
            i += 1
        } else if c == ')' {
            if depth < 1 {
                break
            }
            depth -= 1
            i += 1
        } else if is_line_space(c) || c < 0x20 {
            break
        } else {
            i += 1
        }
    }
    if i == at && byte_at(s, i) != ')' {
        return failed()
    }
    if depth != 0 {
        return failed()
    }
    Scan { end: i, value: unescape_punct(s[at..i]) }
}

fn link_title(s: str, at: i64) -> Scan {
    let open = byte_at(s, at)
    var close = open
    if open == '(' {
        close = ')'
    } else if open != '"' && open != '\'' {
        return failed()
    }
    var i = at + 1
    for i < s.len {
        let c = s[i]
        if c == '\\' && i + 1 < s.len && is_ascii_punct(s[i + 1]) {
            i += 2
            continue
        }
        if c == close {
            return Scan { end: i + 1, value: unescape_punct(s[at + 1..i]) }
        }
        if open == '(' && c == '(' {
            return failed()
        }
        i += 1
    }
    failed()
}

fn at_line_end(s: str, from: i64) -> bool {
    let i = skip_spaces(s, from)
    i >= s.len || s[i] == '\n'
}

fn parse_reference(s: str, mut refs: [str: Reference]) -> i64 {
    let label_stop = label_end(s, 0)
    if label_stop < 0 || byte_at(s, label_stop) != ':' {
        return 0
    }
    let raw_label = s[..label_stop]
    var at = skip_newline_space(s, label_stop + 1)
    let destination = link_destination(s, at)
    if destination.end < 0 {
        return 0
    }
    let before_title = destination.end
    at = skip_newline_space(s, before_title)
    var title = ""
    var end = before_title
    if at != before_title {
        let candidate = link_title(s, at)
        if candidate.end >= 0 && at_line_end(s, candidate.end) {
            title = candidate.value
            end = candidate.end
        }
    }
    if !at_line_end(s, end) {
        return 0
    }
    let key = normalize_label(raw_label[1..raw_label.len - 1])
    if key == "" {
        return 0
    }
    if refs[key] == none {
        refs[key] = Reference { href: destination.value, title }
    }
    var stop = skip_spaces(s, end)
    if stop < s.len {
        stop += 1
    }
    stop
}
