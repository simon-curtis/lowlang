struct Autolinked {
    end: i64
    href: str
}

fn no_autolink() -> Autolinked {
    Autolinked { end: -1, href: "" }
}

fn is_domain_char(c: u8) -> bool {
    is_alnum(c) || c == '-'
}

fn is_email_run_char(c: u8) -> bool {
    is_alnum(c) || c == '.' || c == '_' || c == '+' || c == '-'
}

fn is_trailing_punct(c: u8) -> bool {
    c == '?' || c == '!' || c == '.' || c == ',' || c == ':' || c == ';' || c == '*' || c == '_' || c == '\'' || c == '"' || c == '~' || c == ')'
}

fn url_prefix_len(s: str, at: i64) -> i64 {
    if starts_with_fold_at(s, at, "https://") {
        return 8
    }
    if starts_with_fold_at(s, at, "http://") {
        return 7
    }
    if starts_with_fold_at(s, at, "ftp://") {
        return 6
    }
    if starts_with_fold_at(s, at, "www.") {
        return 4
    }
    0
}

fn url_end(s: str, at: i64, prefix: i64) -> i64 {
    var i = at + prefix
    let domain_start = i
    for i < s.len && (is_domain_char(s[i]) || s[i] == '.') {
        i += 1
    }
    if i == domain_start || !is_domain_char(s[domain_start]) {
        return -1
    }
    for i < s.len && !is_line_space(s[i]) && s[i] != '<' {
        i += 1
    }
    i
}

fn backpedal_end(s: str, at: i64, end: i64) -> i64 {
    var stop = end
    for {
        var i = at
        var last = at
        for i < stop {
            let c = s[i]
            if c == '(' {
                let close = find_byte_from(s[..stop], i + 1, ')')
                if close < 0 {
                    break
                }
                i = close + 1
                last = i
                continue
            }
            if c == '&' {
                var j = i + 1
                for j < stop && is_alnum(s[j]) {
                    j += 1
                }
                if j > i + 1 && j == stop - 1 && s[j] == ';' {
                    break
                }
                i += 1
                last = i
                continue
            }
            if is_trailing_punct(c) {
                var j = i
                for j < stop && is_trailing_punct(s[j]) {
                    j += 1
                }
                if j >= stop {
                    if j - i >= 2 {
                        last = j - 1
                    }
                    break
                }
                i = j
                last = i
                continue
            }
            i += 1
            last = i
        }
        if last == stop {
            return stop
        }
        stop = last
    }
    stop
}

fn bare_email_end(s: str, at: i64) -> i64 {
    var i = at
    for i < s.len && is_email_run_char(s[i]) {
        i += 1
    }
    if i == at || byte_at(s, i) != '@' {
        return -1
    }
    var j = i + 1
    for j < s.len && (is_alnum(s[j]) || s[j] == '-' || s[j] == '_') {
        j += 1
    }
    if j == i + 1 {
        return -1
    }
    var dots = 0
    for byte_at(s, j) == '.' {
        var k = j + 1
        for k < s.len && (is_alnum(s[k]) || s[k] == '-' || s[k] == '_') {
            k += 1
        }
        if k == j + 1 {
            break
        }
        var back = k
        for back > j + 1 && !is_alnum(s[back - 1]) {
            back -= 1
        }
        if back == j + 1 {
            break
        }
        j = back
        dots += 1
        if back != k {
            break
        }
    }
    if dots == 0 || byte_at(s, j) == '-' || byte_at(s, j) == '_' {
        return -1
    }
    j
}

fn www_may_start(s: str, at: i64, after_entity: bool) -> bool {
    if at == 0 {
        return !after_entity
    }
    let before = s[at - 1]
    is_line_space(before) || before == '*' || before == '_' || before == '~' || before == '('
}

fn autolink_at(s: str, at: i64, after_entity: bool) -> Autolinked {
    let prefix = url_prefix_len(s, at)
    if prefix > 0 && (prefix != 4 || www_may_start(s, at, after_entity)) {
        let raw_end = url_end(s, at, prefix)
        if raw_end >= 0 {
            let end = backpedal_end(s, at, raw_end)
            let label = s[at..end]
            return Autolinked { end, href: if prefix == 4 { "http://{label}" } else { label } }
        }
    }
    let starts_run = at == 0 || !is_email_run_char(s[at - 1])
    if starts_run && is_email_run_char(s[at]) {
        let end = bare_email_end(s, at)
        if end >= 0 {
            return Autolinked { end, href: "mailto:{s[at..end]}" }
        }
    }
    no_autolink()
}

fn link_text(out: []Inline, value: str, after_entity: bool) -> []Inline {
    var nodes = out
    var i = 0
    var last = 0
    for i < value.len {
        let found = autolink_at(value, i, after_entity)
        if found.end > i {
            if i > last {
                push(mut nodes, Inline.Text(value[last..i]))
            }
            push(mut nodes, Inline.Autolink(found.href, value[i..found.end]))
            i = found.end
            last = i
        } else {
            i += 1
        }
    }
    if last < value.len {
        push(mut nodes, Inline.Text(value[last..]))
    }
    nodes
}

fn is_anchor_open(html: str) -> bool {
    starts_with_fold_at(html, 0, "<a ")
}

fn is_anchor_close(html: str) -> bool {
    starts_with_fold_at(html, 0, "</a>")
}

fn link_autolinks(nodes: []Inline) -> []Inline {
    var out: []Inline = []
    var in_anchor = false
    var after_entity = false
    for node in nodes {
        match node {
            Text(value) => {
                if in_anchor {
                    push(mut out, node)
                } else {
                    out = link_text(out, value, after_entity)
                }
            }
            Emphasis(children) => push(mut out, Inline.Emphasis(link_autolinks(children)))
            Strong(children) => push(mut out, Inline.Strong(link_autolinks(children)))
            Strikethrough(children) => push(mut out, Inline.Strikethrough(link_autolinks(children)))
            Html(value) => {
                if !in_anchor && is_anchor_open(value) {
                    in_anchor = true
                } else if in_anchor && is_anchor_close(value) {
                    in_anchor = false
                }
                push(mut out, node)
            }
            _ => push(mut out, node)
        }
        after_entity = match node {
            Entity(_, _) => true
            _ => false
        }
    }
    out
}
