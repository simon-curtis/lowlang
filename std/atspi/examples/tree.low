import std/atspi
import std/dbus
import std/net

const guid = "0123456789abcdef0123456789abcdef"

fn accept(h: net.ConnHandle, ready: chan[*dbus.ConnectionHandle]) {
    ready <- dbus.accept_over_handle(h, dbus.ServerAuth { guid }) or panic("accept")
}

fn read_name(client: *dbus.ConnectionHandle, path: str) -> str ! dbus.Error {
    dbus.string_of(dbus.get_property_on(client, "", path, "org.a11y.atspi.Accessible", "Name")?)?
}

/// Exports a window with a heading and a button on a direct connection, reads the tree back the way a screen reader does, presses the button through its `Action` interface and takes the request the application's own thread would carry out.
fn main() ! dbus.Error {
    using var pair = net.socketpair() or panic("pair")
    let near = net.detach(mut pair.first)
    let far = net.detach(mut pair.second)
    let ready = chan[*dbus.ConnectionHandle](1)
    spawn accept(far, ready)
    let client = dbus.connect_over_handle(near, false)?
    let server = (<-ready) ?? panic("no peer")

    let bridge = atspi.serve(server, "notes", fn() {})?
    atspi.update(bridge, "Notes", true, [
        atspi.Node { key: "title", name: "Notes", role: atspi.Role.Heading, width: 120.0, height: 24.0, text: some("Notes") },
        atspi.Node { key: "save", name: "Save", role: atspi.Role.Button, y: 30.0, width: 60.0, height: 24.0, focusable: true, actionable: true },
    ])?

    print("window {read_name(client, atspi.window_path)?}")
    let reply = dbus.call_on(client, dbus.method_call("", atspi.window_path, "org.a11y.atspi.Accessible", "GetChildren", []))?
    for item in dbus.array_of(reply.body[0])? {
        let path = dbus.string_of(dbus.fields_of(item)?[1])?
        let role = dbus.call_on(client, dbus.method_call("", path, "org.a11y.atspi.Accessible", "GetRole", []))?
        print("{read_name(client, path)?} role {dbus.uint_of(role.body[0])?}")
    }
    let press = dbus.method_call("", atspi.element_path(bridge, "save"), "org.a11y.atspi.Action", "DoAction", [dbus.Value.Int32(0)])
    print("pressed {dbus.bool_of(dbus.call_on(client, press)?.body[0])?}")
    for request in atspi.take_actions(bridge) {
        match request {
            Click(key) => print("click {key}")
            Focus(key) => print("focus {key}")
        }
    }
    dbus.shutdown_on(client)
    dbus.shutdown_on(server)
}
