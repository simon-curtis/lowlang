import std/dbus
import std/sync
import std/text

const accessible = "org.a11y.atspi.Accessible"
const component = "org.a11y.atspi.Component"
const action = "org.a11y.atspi.Action"
const text_interface = "org.a11y.atspi.Text"
const application = "org.a11y.atspi.Application"
const invalid_args = "org.freedesktop.DBus.Error.InvalidArgs"
const layer_widget = 3

fn method(st: *State, t: Target, name: str, input: str, output: str, run: fn(View, dbus.Call) -> dbus.Value[] ! dbus.Error) -> dbus.MethodSpec {
    dbus.MethodSpec {
        name,
        in_signature: input,
        out_signature: output,
        handler: fn(c: dbus.Call) -> dbus.Value[] ! dbus.Error { run(view_of(st, t)?, c) },
    }
}

fn property(st: *State, t: Target, name: str, signature: str, read: fn(View) -> dbus.Value) -> dbus.PropertySpec {
    dbus.read_only_property(name, signature, fn() -> dbus.Value ! dbus.Error { read(view_of(st, t)?) })
}

fn int_arg(c: dbus.Call, at: i64) -> i64 ! dbus.Error {
    if at >= c.message.body.len {
        fail dbus.Error.Remote(invalid_args, "{c.message.member} needs argument {at}")
    }
    dbus.int_of(c.message.body[at])?
}

fn attributes(v: View) -> dbus.Value {
    var items: dbus.Value[] = [dbus.Value.DictEntry(new(dbus.Value.String("toolkit")), new(dbus.Value.String("low")))]
    match v.node {
        some(n) => items.push(dbus.Value.DictEntry(new(dbus.Value.String("id")), new(dbus.Value.String(n.key))))
        none => {}
    }
    dbus.Value.Array("{{ss}}", items)
}

fn accessible_spec(st: *State, t: Target) -> dbus.InterfaceSpec {
    dbus.InterfaceSpec {
        name: accessible,
        methods: [
            method(st, t, "GetChildAtIndex", "i", "(so)", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error {
                let i = int_arg(c, 0)?
                if i < 0 || i >= v.children.len {
                    fail dbus.Error.Remote(invalid_args, "no child {i}")
                }
                [v.children[i]]
            }),
            method(st, t, "GetChildren", "", "a(so)", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.Array("(so)", v.children)] }),
            method(st, t, "GetIndexInParent", "", "i", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.Int32(i32(v.index))] }),
            method(st, t, "GetRelationSet", "", "a(ua(so))", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.Array("(ua(so))", [])] }),
            method(st, t, "GetRole", "", "u", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.UInt32(u32(v.role.index))] }),
            method(st, t, "GetRoleName", "", "s", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.String(v.role_name)] }),
            method(st, t, "GetLocalizedRoleName", "", "s", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.String(v.role_name)] }),
            method(st, t, "GetState", "", "au", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [state_words(v.states)] }),
            method(st, t, "GetAttributes", "", "a{{ss}}", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [attributes(v)] }),
            method(st, t, "GetApplication", "", "(so)", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [reference(st, root_path)] }),
            method(st, t, "GetInterfaces", "", "as", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.strings(v.interfaces)] }),
        ],
        properties: [
            property(st, t, "Name", "s", fn(v: View) -> dbus.Value { dbus.Value.String(v.name) }),
            property(st, t, "Description", "s", fn(v: View) -> dbus.Value { dbus.Value.String("") }),
            property(st, t, "Parent", "(so)", fn(v: View) -> dbus.Value { v.parent }),
            property(st, t, "ChildCount", "i", fn(v: View) -> dbus.Value { dbus.Value.Int32(i32(v.children.len)) }),
            property(st, t, "Locale", "s", fn(v: View) -> dbus.Value { dbus.Value.String("") }),
            property(st, t, "AccessibleId", "s", fn(v: View) -> dbus.Value {
                match v.node {
                    some(n) => dbus.Value.String(n.key)
                    none => dbus.Value.String("")
                }
            }),
            property(st, t, "HelpText", "s", fn(v: View) -> dbus.Value { dbus.Value.String("") }),
        ],
    }
}

fn contains_point(v: View, x: i64, y: i64) -> bool {
    x >= v.x && y >= v.y && x < v.x + v.width && y < v.y + v.height
}

fn point_args(c: dbus.Call) -> Point ! dbus.Error {
    Point { x: int_arg(c, 0)?, y: int_arg(c, 1)? }
}

struct Point {
    x: i64
    y: i64
}

fn topmost_at(st: *State, p: Point) -> dbus.Value {
    sync.lock(st.lock)
    var found = null_reference()
    var i = st.nodes.len - 1
    for i >= 0 {
        let n = st.nodes[i]
        if n.visible && p.x >= floor_of(n.x) && p.y >= floor_of(n.y) && p.x < floor_of(n.x) + ceil_of(n.width) && p.y < floor_of(n.y) + ceil_of(n.height) {
            found = reference(st, path_of(st, n.key))
            break
        }
        i -= 1
    }
    sync.unlock(st.lock)
    found
}

fn component_spec(st: *State, t: Target) -> dbus.InterfaceSpec {
    dbus.InterfaceSpec {
        name: component,
        methods: [
            method(st, t, "Contains", "iiu", "b", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error {
                let p = point_args(c)?
                [dbus.Value.Boolean(contains_point(v, p.x, p.y))]
            }),
            method(st, t, "GetAccessibleAtPoint", "iiu", "(so)", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error {
                let p = point_args(c)?
                match t {
                    Window => [topmost_at(st, p)]
                    Element(key) => [if contains_point(v, p.x, p.y) { reference(st, path_of(st, key)) } else { null_reference() }]
                    Root => [null_reference()]
                }
            }),
            method(st, t, "GetExtents", "u", "(iiii)", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error {
                [dbus.Value.Struct([dbus.Value.Int32(i32(v.x)), dbus.Value.Int32(i32(v.y)), dbus.Value.Int32(i32(v.width)), dbus.Value.Int32(i32(v.height))])]
            }),
            method(st, t, "GetPosition", "u", "ii", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.Int32(i32(v.x)), dbus.Value.Int32(i32(v.y))] }),
            method(st, t, "GetSize", "", "ii", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.Int32(i32(v.width)), dbus.Value.Int32(i32(v.height))] }),
            method(st, t, "GetLayer", "", "u", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.UInt32(u32(layer_widget))] }),
            method(st, t, "GetMDIZOrder", "", "n", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.Int16(0)] }),
            method(st, t, "GrabFocus", "", "b", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error {
                match v.node {
                    some(n) => {
                        if !n.focusable {
                            return [dbus.Value.Boolean(false)]
                        }
                        queue(st, Action.Focus(n.key))
                        [dbus.Value.Boolean(true)]
                    }
                    none => [dbus.Value.Boolean(false)]
                }
            }),
            method(st, t, "GetAlpha", "", "d", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.Double(1.0)] }),
        ],
    }
}

fn action_spec(st: *State, t: Target) -> dbus.InterfaceSpec {
    dbus.InterfaceSpec {
        name: action,
        methods: [
            method(st, t, "GetDescription", "i", "s", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.String("")] }),
            method(st, t, "GetName", "i", "s", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.String("click")] }),
            method(st, t, "GetLocalizedName", "i", "s", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.String("click")] }),
            method(st, t, "GetKeyBinding", "i", "s", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.String("")] }),
            method(st, t, "GetActions", "", "a(sss)", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error {
                [dbus.Value.Array("(sss)", [dbus.Value.Struct([dbus.Value.String("click"), dbus.Value.String(""), dbus.Value.String("")])])]
            }),
            method(st, t, "DoAction", "i", "b", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error {
                let i = int_arg(c, 0)?
                match v.node {
                    some(n) => {
                        if i != 0 {
                            return [dbus.Value.Boolean(false)]
                        }
                        queue(st, Action.Click(n.key))
                        [dbus.Value.Boolean(true)]
                    }
                    none => [dbus.Value.Boolean(false)]
                }
            }),
        ],
        properties: [property(st, t, "NActions", "i", fn(v: View) -> dbus.Value { dbus.Value.Int32(1) })],
    }
}

fn text_of(v: View) -> str[] {
    match v.node {
        some(n) => text.chars(n.text ?? "")
        none => []
    }
}

fn slice_text(chars: str[], start: i64, end: i64) -> str ! dbus.Error {
    let last = if end < 0 { chars.len } else { end }
    if start < 0 || start > last || last > chars.len {
        fail dbus.Error.Remote(invalid_args, "the range {start} to {end} lies outside the {chars.len} characters")
    }
    text.join(chars[start..last], "")
}

fn granularity_span(chars: str[], offset: i64, granularity: i64) -> dbus.Value[] ! dbus.Error {
    if offset < 0 || offset >= chars.len {
        fail dbus.Error.Remote(invalid_args, "offset {offset} lies outside the {chars.len} characters")
    }
    let whole = granularity != 0
    let start = if whole { 0 } else { offset }
    let end = if whole { chars.len } else { offset + 1 }
    [dbus.Value.String(slice_text(chars, start, end)?), dbus.Value.Int32(i32(start)), dbus.Value.Int32(i32(end))]
}

fn text_spec(st: *State, t: Target) -> dbus.InterfaceSpec {
    dbus.InterfaceSpec {
        name: text_interface,
        methods: [
            method(st, t, "GetText", "ii", "s", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.String(slice_text(text_of(v), int_arg(c, 0)?, int_arg(c, 1)?)?)] }),
            method(st, t, "GetCharacterAtOffset", "i", "i", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error {
                let chars = text_of(v)
                let offset = int_arg(c, 0)?
                if offset < 0 || offset >= chars.len {
                    return [dbus.Value.Int32(0)]
                }
                var code = 0
                for _, r in chars[offset] {
                    code = i64(r)
                }
                [dbus.Value.Int32(i32(code))]
            }),
            method(st, t, "GetTextAtOffset", "iu", "(sii)", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error {
                [dbus.Value.Struct(granularity_span(text_of(v), int_arg(c, 0)?, 1)?)]
            }),
            method(st, t, "GetStringAtOffset", "iu", "(sii)", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error {
                [dbus.Value.Struct(granularity_span(text_of(v), int_arg(c, 0)?, i64(dbus.uint_of(c.message.body[1])?))?)]
            }),
            method(st, t, "GetNSelections", "", "i", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.Int32(0)] }),
            method(st, t, "SetCaretOffset", "i", "b", fn(v: View, c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.Boolean(false)] }),
        ],
        properties: [
            property(st, t, "CharacterCount", "i", fn(v: View) -> dbus.Value { dbus.Value.Int32(i32(text_of(v).len)) }),
            property(st, t, "CaretOffset", "i", fn(v: View) -> dbus.Value { dbus.Value.Int32(-1) }),
        ],
    }
}

fn application_spec(st: *State) -> dbus.InterfaceSpec {
    dbus.InterfaceSpec {
        name: application,
        methods: [
            dbus.MethodSpec { name: "GetLocale", in_signature: "u", out_signature: "s", handler: fn(c: dbus.Call) -> dbus.Value[] ! dbus.Error { [dbus.Value.String("")] } },
            dbus.MethodSpec { name: "RegisterEventListener", in_signature: "s", handler: fn(c: dbus.Call) -> dbus.Value[] ! dbus.Error { [] } },
            dbus.MethodSpec { name: "DeregisterEventListener", in_signature: "s", handler: fn(c: dbus.Call) -> dbus.Value[] ! dbus.Error { [] } },
        ],
        properties: [
            dbus.read_only_property("ToolkitName", "s", fn() -> dbus.Value ! dbus.Error { dbus.Value.String("low") }),
            dbus.read_only_property("Version", "s", fn() -> dbus.Value ! dbus.Error { dbus.Value.String("0") }),
            dbus.read_only_property("AtspiVersion", "s", fn() -> dbus.Value ! dbus.Error { dbus.Value.String("2.1") }),
            dbus.read_write_property("Id", "i", fn() -> dbus.Value ! dbus.Error { dbus.Value.Int32(i32(st.identifier)) }, fn(v: dbus.Value) ! dbus.Error { st.identifier = dbus.int_of(v)? }),
        ],
    }
}
