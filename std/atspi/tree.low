import std/dbus
import std/math
import std/sync

const state_active = 1
const state_checkable = 41
const state_editable = 7
const state_enabled = 8
const state_focusable = 11
const state_focused = 12
const state_sensitive = 24
const state_showing = 25
const state_single_line = 26
const state_visible = 30
const unknown_object = "org.freedesktop.DBus.Error.UnknownObject"

enum Target {
    Root
    Window
    Element(key: str)
}

struct View {
    name: str
    role: Role
    role_name: str
    parent: dbus.Value
    index: i64
    children: dbus.Value[]
    states: i64
    interfaces: str[]
    x: i64
    y: i64
    width: i64
    height: i64
    node: Node?
}

fn role_name(r: Role) -> str {
    match r {
        CheckBox => "check box"
        Dialog => "dialog"
        Frame => "frame"
        Image => "image"
        Label => "label"
        List => "list"
        ListItem => "list item"
        Menu => "menu"
        MenuItem => "menu item"
        PageTab => "page tab"
        Panel => "panel"
        Button => "push button"
        Entry => "text"
        Application => "application"
        Heading => "heading"
        Link => "link"
    }
}

fn state_bits(n: Node) -> i64 {
    var bits = 1 << state_enabled | 1 << state_sensitive
    if n.visible {
        bits |= 1 << state_visible | 1 << state_showing
    }
    if n.focusable {
        bits |= 1 << state_focusable
    }
    if n.focused {
        bits |= 1 << state_focused
    }
    if n.editable {
        bits |= 1 << state_editable | 1 << state_single_line
    }
    if n.role == Role.CheckBox {
        bits |= 1 << state_checkable
    }
    bits
}

fn path_of(st: *State, key: str) -> str {
    let n = st.numbers[key] ?? 0
    "{element_prefix}{n}"
}

fn element_interfaces(n: Node) -> str[] {
    var names = ["org.a11y.atspi.Accessible", "org.a11y.atspi.Component"]
    if n.actionable {
        names.push("org.a11y.atspi.Action")
    }
    if n.text != none {
        names.push("org.a11y.atspi.Text")
    }
    names
}

fn floor_of(v: f64) -> i64 {
    let whole = i64(math.trunc(v))
    if f64(whole) > v { whole - 1 } else { whole }
}

fn ceil_of(v: f64) -> i64 {
    i64(math.ceil(v))
}

fn window_view(st: *State) -> View {
    var children: dbus.Value[] = []
    var width = 0
    var height = 0
    for n in st.nodes {
        children.push(reference(st, path_of(st, n.key)))
        width = math.max(width, ceil_of(n.x + n.width))
        height = math.max(height, ceil_of(n.y + n.height))
    }
    var states = 1 << state_enabled | 1 << state_sensitive | 1 << state_visible | 1 << state_showing
    if st.active {
        states |= 1 << state_active
    }
    View {
        name: st.title,
        role: Role.Frame,
        role_name: role_name(Role.Frame),
        parent: reference(st, root_path),
        index: 0,
        children,
        states,
        interfaces: ["org.a11y.atspi.Accessible", "org.a11y.atspi.Component"],
        x: 0,
        y: 0,
        width,
        height,
        node: none,
    }
}

fn root_view(st: *State) -> View {
    let parent = if st.desktop_name.len > 0 {
        dbus.Value.Struct([dbus.Value.String(st.desktop_name), dbus.Value.ObjectPath(st.desktop_path)])
    } else {
        null_reference()
    }
    View {
        name: st.application,
        role: Role.Application,
        role_name: role_name(Role.Application),
        parent,
        index: 0,
        children: [reference(st, window_path)],
        states: 1 << state_enabled | 1 << state_sensitive | 1 << state_visible | 1 << state_showing,
        interfaces: ["org.a11y.atspi.Accessible", "org.a11y.atspi.Application"],
        x: 0,
        y: 0,
        width: 0,
        height: 0,
        node: none,
    }
}

fn element_view(st: *State, key: str) -> View ! dbus.Error {
    let i = index_of(st, key)
    if i < 0 {
        fail dbus.Error.Remote(unknown_object, "no element {key}")
    }
    let n = st.nodes[i]
    View {
        name: n.name,
        role: n.role,
        role_name: role_name(n.role),
        parent: reference(st, window_path),
        index: i,
        children: [],
        states: state_bits(n),
        interfaces: element_interfaces(n),
        x: floor_of(n.x),
        y: floor_of(n.y),
        width: ceil_of(n.width),
        height: ceil_of(n.height),
        node: some(n),
    }
}

fn view_of(st: *State, t: Target) -> View ! dbus.Error {
    sync.lock(st.lock)
    let v = match t {
        Root => root_view(st)
        Window => window_view(st)
        Element(key) => element_view(st, key) catch {
            e => {
                sync.unlock(st.lock)
                fail e
            }
        }
    }
    sync.unlock(st.lock)
    v
}

fn state_words(bits: i64) -> dbus.Value {
    dbus.Value.Array("u", [dbus.Value.UInt32(u32(bits & 0xFFFFFFFF)), dbus.Value.UInt32(u32(bits >> 32 & 0xFFFFFFFF))])
}
