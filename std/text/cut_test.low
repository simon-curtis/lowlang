import std/testing

struct CutCase {
    input: str
    sep: str
    before: str
    after: str
    found: bool
}

struct StripCase {
    input: str
    affix: str
    want: str?
}

fn cut_name(c: CutCase) -> str {
    "{quote(c.input)} at {quote(c.sep)}"
}

fn strip_name(c: StripCase) -> str {
    "{quote(c.input)} minus {quote(c.affix)}"
}

fn check_cut(t: *testing.T, got: Cut, c: CutCase) {
    t.equal(got.before, c.before)
    t.equal(got.after, c.after)
    t.equal(got.found, c.found)
}

fn test_cut(t: *testing.T) {
    let cases = [
        CutCase { input: "key=value", sep: "=", before: "key", after: "value", found: true }
        CutCase { input: "a=b=c", sep: "=", before: "a", after: "b=c", found: true }
        CutCase { input: "novalue", sep: "=", before: "novalue", after: "", found: false }
        CutCase { input: "", sep: "=", before: "", after: "", found: false }
        CutCase { input: "=", sep: "=", before: "", after: "", found: true }
        CutCase { input: "=x", sep: "=", before: "", after: "x", found: true }
        CutCase { input: "x=", sep: "=", before: "x", after: "", found: true }
        CutCase { input: "abc", sep: "", before: "", after: "abc", found: true }
        CutCase { input: "", sep: "", before: "", after: "", found: true }
        CutCase { input: "a::b::c", sep: "::", before: "a", after: "b::c", found: true }
        CutCase { input: "a:b", sep: "::", before: "a:b", after: "", found: false }
        CutCase { input: "héllo wörld", sep: " ", before: "héllo", after: "wörld", found: true }
    ]
    t.table_of(cases, cut_name, fn(st, c) {
        check_cut(st, cut(c.input, c.sep), c)
    })
}

fn test_last_cut(t: *testing.T) {
    let cases = [
        CutCase { input: "a=b=c", sep: "=", before: "a=b", after: "c", found: true }
        CutCase { input: "key=value", sep: "=", before: "key", after: "value", found: true }
        CutCase { input: "novalue", sep: "=", before: "novalue", after: "", found: false }
        CutCase { input: "", sep: "=", before: "", after: "", found: false }
        CutCase { input: "a.b.", sep: ".", before: "a.b", after: "", found: true }
        CutCase { input: ".a", sep: ".", before: "", after: "a", found: true }
        CutCase { input: "abc", sep: "", before: "abc", after: "", found: true }
        CutCase { input: "a::b::c", sep: "::", before: "a::b", after: "c", found: true }
        CutCase { input: "a:::b", sep: "::", before: "a:", after: "b", found: true }
    ]
    t.table_of(cases, cut_name, fn(st, c) {
        check_cut(st, last_cut(c.input, c.sep), c)
    })
}

fn test_strip_prefix(t: *testing.T) {
    let cases = [
        StripCase { input: "prefix-x", affix: "prefix-", want: "x" }
        StripCase { input: "x", affix: "prefix-", want: none }
        StripCase { input: "abc", affix: "", want: "abc" }
        StripCase { input: "abc", affix: "abc", want: "" }
        StripCase { input: "ab", affix: "abc", want: none }
        StripCase { input: "", affix: "", want: "" }
        StripCase { input: "", affix: "a", want: none }
        StripCase { input: "aab", affix: "a", want: "ab" }
        StripCase { input: "xab", affix: "ab", want: none }
    ]
    t.table_of(cases, strip_name, fn(st, c) {
        st.equal(strip_prefix(c.input, c.affix), c.want)
    })
}

fn test_strip_suffix(t: *testing.T) {
    let cases = [
        StripCase { input: "x.low", affix: ".low", want: "x" }
        StripCase { input: "x", affix: ".low", want: none }
        StripCase { input: "abc", affix: "", want: "abc" }
        StripCase { input: "abc", affix: "abc", want: "" }
        StripCase { input: "bc", affix: "abc", want: none }
        StripCase { input: "", affix: "", want: "" }
        StripCase { input: "", affix: "a", want: none }
        StripCase { input: "baa", affix: "a", want: "ba" }
        StripCase { input: "abx", affix: "ab", want: none }
    ]
    t.table_of(cases, strip_name, fn(st, c) {
        st.equal(strip_suffix(c.input, c.affix), c.want)
    })
}
