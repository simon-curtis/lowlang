import std/testing

fn raw(parts: []u8) -> str {
    str(parts)
}

fn test_chars_keeps_invalid_bytes_apart(t: *testing.T) {
    let pieces = chars(raw([0x61, 0xFF, 0x62]))
    t.equal(pieces.len, 3)
    t.equal(pieces[0], "a")
    t.equal(pieces[1].len, 1)
    t.equal(pieces[1][0], 0xFF)
    t.equal(pieces[2], "b")
}

fn test_chars_keeps_a_truncated_sequence_apart(t: *testing.T) {
    let pieces = chars(raw([0xE2, 0x82]))
    t.equal(pieces.len, 2)
    t.equal(pieces[0].len, 1)
    t.equal(pieces[1].len, 1)
}

fn test_char_count_counts_an_invalid_byte_once(t: *testing.T) {
    t.equal(char_count(raw([0x61, 0xFF, 0x62])), 3)
    t.equal(char_count(raw([0xFF, 0xFF])), 2)
}

fn test_is_ascii(t: *testing.T) {
    t.is_true(is_ascii(""))
    t.is_true(is_ascii("plain text 123"))
    t.is_true(is_ascii(raw([0x00, 0x7F])))
    t.is_false(is_ascii("é"))
    t.is_false(is_ascii("a😀"))
    t.is_false(is_ascii(raw([0x61, 0x80])))
}

fn test_reverse(t: *testing.T) {
    t.equal(reverse(""), "")
    t.equal(reverse("a"), "a")
    t.equal(reverse("abc"), "cba")
    t.equal(reverse("héy"), "yéh")
    t.equal(reverse("日本語"), "語本日")
    t.equal(reverse("a😀"), "😀a")
}

fn test_reverse_moves_an_invalid_byte_as_a_unit(t: *testing.T) {
    let reversed = reverse(raw([0x61, 0xFF, 0x62]))
    t.equal(reversed.len, 3)
    t.equal(reversed[0], 0x62)
    t.equal(reversed[1], 0xFF)
    t.equal(reversed[2], 0x61)
}
