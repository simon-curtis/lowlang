import std/testing

struct IndexCase {
    input: str
    sub: str
    first: i64
    last: i64
}

struct ByteIndexCase {
    input: str
    byte: u8
    first: i64
    last: i64
}

struct CountCase {
    input: str
    sub: str
    want: i64
}

struct ReplaceCase {
    input: str
    old: str
    new: str
    want: str
}

struct RepeatCase {
    input: str
    times: i64
    want: str
}

struct AffixCheck {
    input: str
    affix: str
    starts: bool
    ends: bool
}

fn index_name(c: IndexCase) -> str {
    "{quote(c.input)} find {quote(c.sub)}"
}

fn byte_index_name(c: ByteIndexCase) -> str {
    "{quote(c.input)} find {quote(from_char(u32(c.byte)))}"
}

fn count_name(c: CountCase) -> str {
    "{quote(c.input)} count {quote(c.sub)}"
}

fn replace_name(c: ReplaceCase) -> str {
    "{quote(c.input)} replace {quote(c.old)} with {quote(c.new)}"
}

fn repeat_name(c: RepeatCase) -> str {
    "{quote(c.input)} x{c.times}"
}

fn affix_check_name(c: AffixCheck) -> str {
    "{quote(c.input)} against {quote(c.affix)}"
}

fn test_index_and_last_index(t: *testing.T) {
    let cases = [
        IndexCase { input: "hello", sub: "l", first: 2, last: 3 }
        IndexCase { input: "hello", sub: "lo", first: 3, last: 3 }
        IndexCase { input: "hello", sub: "hello", first: 0, last: 0 }
        IndexCase { input: "hello", sub: "xyz", first: -1, last: -1 }
        IndexCase { input: "hello", sub: "hellox", first: -1, last: -1 }
        IndexCase { input: "hello", sub: "", first: 0, last: 5 }
        IndexCase { input: "", sub: "", first: 0, last: 0 }
        IndexCase { input: "", sub: "a", first: -1, last: -1 }
        IndexCase { input: "a", sub: "", first: 0, last: 1 }
        IndexCase { input: "aab", sub: "ab", first: 1, last: 1 }
        IndexCase { input: "aaab", sub: "aab", first: 1, last: 1 }
        IndexCase { input: "abcabc", sub: "abc", first: 0, last: 3 }
        IndexCase { input: "abcabc", sub: "c", first: 2, last: 5 }
        IndexCase { input: "aaaa", sub: "aa", first: 0, last: 2 }
        IndexCase { input: "héllo", sub: "llo", first: 3, last: 3 }
        IndexCase { input: "ab", sub: "abc", first: -1, last: -1 }
    ]
    t.table_of(cases, index_name, fn(st, c) {
        st.equal(index(c.input, c.sub), c.first)
        st.equal(last_index(c.input, c.sub), c.last)
    })
}

fn test_index_byte(t: *testing.T) {
    let cases = [
        ByteIndexCase { input: "abc", byte: 'c', first: 2, last: 2 }
        ByteIndexCase { input: "abc", byte: 'x', first: -1, last: -1 }
        ByteIndexCase { input: "", byte: 'a', first: -1, last: -1 }
        ByteIndexCase { input: "abca", byte: 'a', first: 0, last: 3 }
        ByteIndexCase { input: "a/b/c", byte: '/', first: 1, last: 3 }
        ByteIndexCase { input: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab", byte: 'b', first: 40, last: 40 }
    ]
    t.table_of(cases, byte_index_name, fn(st, c) {
        st.equal(index_byte(c.input, c.byte), c.first)
        st.equal(last_index_byte(c.input, c.byte), c.last)
    })
}

fn test_contains(t: *testing.T) {
    t.is_true(contains("hello", "ell"))
    t.is_true(contains("hello", ""))
    t.is_true(contains("", ""))
    t.is_true(contains("hello", "hello"))
    t.is_false(contains("hello", "hellos"))
    t.is_false(contains("", "a"))
    t.is_false(contains("Hello", "hello"))
}

fn test_count(t: *testing.T) {
    let cases = [
        CountCase { input: "aaa", sub: "aa", want: 1 }
        CountCase { input: "aaaa", sub: "a", want: 4 }
        CountCase { input: "abcabc", sub: "bc", want: 2 }
        CountCase { input: "abab", sub: "ab", want: 2 }
        CountCase { input: "abc", sub: "", want: 4 }
        CountCase { input: "héllo", sub: "", want: 6 }
        CountCase { input: "", sub: "", want: 1 }
        CountCase { input: "", sub: "a", want: 0 }
        CountCase { input: "abc", sub: "d", want: 0 }
        CountCase { input: "abc", sub: "abcd", want: 0 }
        CountCase { input: "aXbXc", sub: "X", want: 2 }
    ]
    t.table_of(cases, count_name, fn(st, c) {
        st.equal(count(c.input, c.sub), c.want)
    })
}

fn test_starts_with_and_ends_with(t: *testing.T) {
    let cases = [
        AffixCheck { input: "hello", affix: "he", starts: true, ends: false }
        AffixCheck { input: "hello", affix: "lo", starts: false, ends: true }
        AffixCheck { input: "hello", affix: "hello", starts: true, ends: true }
        AffixCheck { input: "hello", affix: "", starts: true, ends: true }
        AffixCheck { input: "hello", affix: "hello!", starts: false, ends: false }
        AffixCheck { input: "", affix: "", starts: true, ends: true }
        AffixCheck { input: "", affix: "a", starts: false, ends: false }
        AffixCheck { input: "hello", affix: "Hello", starts: false, ends: false }
    ]
    t.table_of(cases, affix_check_name, fn(st, c) {
        st.equal(starts_with(c.input, c.affix), c.starts)
        st.equal(ends_with(c.input, c.affix), c.ends)
    })
}

fn test_replace(t: *testing.T) {
    let cases = [
        ReplaceCase { input: "a-b-c", old: "-", new: "+", want: "a+b+c" }
        ReplaceCase { input: "aaa", old: "aa", new: "b", want: "ba" }
        ReplaceCase { input: "aaa", old: "a", new: "aa", want: "aaaaaa" }
        ReplaceCase { input: "abc", old: "", new: "x", want: "abc" }
        ReplaceCase { input: "abc", old: "d", new: "x", want: "abc" }
        ReplaceCase { input: "abc", old: "abc", new: "", want: "" }
        ReplaceCase { input: "", old: "a", new: "b", want: "" }
        ReplaceCase { input: "a.b", old: ".", new: "..", want: "a..b" }
        ReplaceCase { input: "héllo", old: "é", new: "e", want: "hello" }
        ReplaceCase { input: "abab", old: "ab", new: "ba", want: "baba" }
        ReplaceCase { input: "xx", old: "x", new: "", want: "" }
    ]
    t.table_of(cases, replace_name, fn(st, c) {
        st.equal(replace(c.input, c.old, c.new), c.want)
    })
}

fn test_repeat(t: *testing.T) {
    let cases = [
        RepeatCase { input: "ab", times: 3, want: "ababab" }
        RepeatCase { input: "ab", times: 1, want: "ab" }
        RepeatCase { input: "ab", times: 0, want: "" }
        RepeatCase { input: "ab", times: -1, want: "" }
        RepeatCase { input: "", times: 5, want: "" }
        RepeatCase { input: "é", times: 2, want: "éé" }
    ]
    t.table_of(cases, repeat_name, fn(st, c) {
        st.equal(repeat(c.input, c.times), c.want)
    })
}
