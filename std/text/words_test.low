import std/testing

struct TitleCase {
    input: str
    want: str
}

struct DistanceCase {
    a: str
    b: str
    want: i64
}

fn title_name(c: TitleCase) -> str {
    quote(c.input)
}

fn distance_name(c: DistanceCase) -> str {
    "{quote(c.a)} to {quote(c.b)}"
}

fn test_title(t: *testing.T) {
    let cases = [
        TitleCase { input: "", want: "" }
        TitleCase { input: "hello wORLD of low-lang's std", want: "Hello WORLD Of Low-Lang's Std" }
        TitleCase { input: "  ünï cöde 3rd", want: "  ünï Cöde 3rd" }
        TitleCase { input: "o'neil", want: "O'neil" }
        TitleCase { input: "a-b", want: "A-B" }
    ]
    t.table_of(cases, title_name, fn(st, c) {
        st.equal(title(c.input), c.want)
    })
}

fn test_edit_distance(t: *testing.T) {
    let cases = [
        DistanceCase { a: "kitten", b: "sitting", want: 3 }
        DistanceCase { a: "", b: "abc", want: 3 }
        DistanceCase { a: "abc", b: "", want: 3 }
        DistanceCase { a: "", b: "", want: 0 }
        DistanceCase { a: "same", b: "same", want: 0 }
        DistanceCase { a: "flaw", b: "lawn", want: 2 }
        DistanceCase { a: "héllo", b: "hello", want: 1 }
        DistanceCase { a: "日本語", b: "日本", want: 1 }
    ]
    t.table_of(cases, distance_name, fn(st, c) {
        st.equal(edit_distance(c.a, c.b), c.want)
    })
}
