import std/testing

struct QuoteCase {
    input: str
    want: str
}

struct UnquoteFailure {
    input: str
    error: QuoteError
}

fn quote_case_name(c: QuoteCase) -> str {
    quote_ascii(c.input)
}

fn unquote_failure_name(c: UnquoteFailure) -> str {
    quote_ascii(c.input)
}

fn unquote_failure(s: str) -> QuoteError? {
    let out = unquote(s) catch { e => return e }
    none
}

fn test_quote(t: *testing.T) {
    let cases = [
        QuoteCase { input: "", want: "\"\"" }
        QuoteCase { input: "abc", want: "\"abc\"" }
        QuoteCase { input: "a b", want: "\"a b\"" }
        QuoteCase { input: "a\"b", want: "\"a\\\"b\"" }
        QuoteCase { input: "a\\b", want: "\"a\\\\b\"" }
        QuoteCase { input: "a\nb", want: "\"a\\nb\"" }
        QuoteCase { input: "a\tb", want: "\"a\\tb\"" }
        QuoteCase { input: "a\rb", want: "\"a\\rb\"" }
        QuoteCase { input: raw([0x01]), want: "\"\\x01\"" }
        QuoteCase { input: raw([0x1F]), want: "\"\\x1f\"" }
        QuoteCase { input: raw([0x7F]), want: "\"\\x7f\"" }
        QuoteCase { input: "\0", want: "\"\\x00\"" }
        QuoteCase { input: "héllo", want: "\"héllo\"" }
        QuoteCase { input: "日本", want: "\"日本\"" }
        QuoteCase { input: "😀", want: "\"😀\"" }
        QuoteCase { input: raw([0x61, 0xFF, 0x62]), want: "\"a\\xffb\"" }
        QuoteCase { input: raw([0xE2, 0x82]), want: "\"\\xe2\\x82\"" }
        QuoteCase { input: "'", want: "\"'\"" }
    ]
    t.table_of(cases, quote_case_name, fn(st, c) {
        st.equal(quote(c.input), c.want)
    })
}

fn test_quote_ascii(t: *testing.T) {
    let cases = [
        QuoteCase { input: "", want: "\"\"" }
        QuoteCase { input: "abc", want: "\"abc\"" }
        QuoteCase { input: "a\"b", want: "\"a\\\"b\"" }
        QuoteCase { input: "a\\b", want: "\"a\\\\b\"" }
        QuoteCase { input: "a\nb", want: "\"a\\u000ab\"" }
        QuoteCase { input: raw([0x7F]), want: "\"\\u007f\"" }
        QuoteCase { input: " ~", want: "\" ~\"" }
        QuoteCase { input: "é", want: "\"\\u00e9\"" }
        QuoteCase { input: "日", want: "\"\\u65e5\"" }
        QuoteCase { input: "😀", want: "\"\\ud83d\\ude00\"" }
    ]
    t.table_of(cases, quote_case_name, fn(st, c) {
        st.equal(quote_ascii(c.input), c.want)
    })
}

fn test_unquote(t: *testing.T) {
    let cases = [
        QuoteCase { input: "\"\"", want: "" }
        QuoteCase { input: "\"abc\"", want: "abc" }
        QuoteCase { input: "\"a\\nb\"", want: "a\nb" }
        QuoteCase { input: "\"a\\tb\\rc\"", want: "a\tb\rc" }
        QuoteCase { input: "\"\\a\\b\\f\\v\"", want: raw([0x07, 0x08, 0x0C, 0x0B]) }
        QuoteCase { input: "\"\\\\\"", want: "\\" }
        QuoteCase { input: "\"\\\"\"", want: "\"" }
        QuoteCase { input: "\"\\'\"", want: "'" }
        QuoteCase { input: "\"\\x41\"", want: "A" }
        QuoteCase { input: "\"\\x4a\\x4A\"", want: "JJ" }
        QuoteCase { input: "\"\\u00e9\"", want: "é" }
        QuoteCase { input: "\"\\u65E5\"", want: "日" }
        QuoteCase { input: "\"\\U0001F600\"", want: "😀" }
        QuoteCase { input: "\"héllo\"", want: "héllo" }
        QuoteCase { input: "\"a b\"", want: "a b" }
    ]
    t.table_of(cases, quote_case_name, fn(st, c) {
        let got = unquote(c.input) catch { e => st.unexpected(e, "") }
        st.equal(got, c.want)
    })
}

fn test_unquote_failures(t: *testing.T) {
    let cases = [
        UnquoteFailure { input: "", error: QuoteError.NotQuoted }
        UnquoteFailure { input: "\"", error: QuoteError.NotQuoted }
        UnquoteFailure { input: "abc", error: QuoteError.NotQuoted }
        UnquoteFailure { input: "\"abc", error: QuoteError.NotQuoted }
        UnquoteFailure { input: "abc\"", error: QuoteError.NotQuoted }
        UnquoteFailure { input: "'abc'", error: QuoteError.NotQuoted }
        UnquoteFailure { input: "\"a\"b\"", error: QuoteError.NotQuoted }
        UnquoteFailure { input: "\"a\\q\"", error: QuoteError.BadEscape(2) }
        UnquoteFailure { input: "\"a\\\"", error: QuoteError.BadEscape(2) }
        UnquoteFailure { input: "\"\\xzz\"", error: QuoteError.BadEscape(3) }
        UnquoteFailure { input: "\"\\x4z\"", error: QuoteError.BadEscape(4) }
        UnquoteFailure { input: "\"\\uzzzz\"", error: QuoteError.BadEscape(3) }
        UnquoteFailure { input: "\"\\ud800\"", error: QuoteError.BadCodePoint(1) }
        UnquoteFailure { input: "\"\\udfff\"", error: QuoteError.BadCodePoint(1) }
        UnquoteFailure { input: "\"\\U00110000\"", error: QuoteError.BadCodePoint(1) }
    ]
    t.table_of(cases, unquote_failure_name, fn(st, c) {
        let want: QuoteError? = c.error
        st.equal(unquote_failure(c.input), want)
    })
}

fn test_unquote_restores_quote(t: *testing.T) {
    let inputs = ["", "plain", "a\"b\\c", "line\nbreak\ttab\r", raw([0x01, 0x7F]), "héllo 日本 😀", raw([0x61, 0xFF, 0x62])]
    for input in inputs {
        let back = unquote(quote(input)) catch { e => t.unexpected(e, "?") }
        t.equal(back, input)
    }
}

fn test_unquote_restores_quote_ascii(t: *testing.T) {
    let inputs = ["", "plain", "a\"b\\c", "line\nbreak\ttab\r", raw([0x01, 0x7F]), "héllo 日本"]
    for input in inputs {
        let back = unquote(quote_ascii(input)) catch { e => t.unexpected(e, "?") }
        t.equal(back, input)
    }
}
