import std/testing

struct IntCase {
    input: str
    base: i64
    want: i64
}

struct FailureCase {
    input: str
    base: i64
    error: ParseError
}

struct DigitCase {
    byte: u8
    base: i64
    want: i64
}

struct RadixCase {
    value: i64
    base: i64
    want: str
}

fn int_name(c: IntCase) -> str {
    "{quote(c.input)} base {c.base}"
}

fn failure_name(c: FailureCase) -> str {
    "{quote(c.input)} base {c.base}"
}

fn digit_name(c: DigitCase) -> str {
    "{quote(from_char(u32(c.byte)))} base {c.base}"
}

fn radix_name(c: RadixCase) -> str {
    "{c.value} base {c.base}"
}

fn radix_failure(s: str, base: i64) -> ParseError? {
    let n = parse_radix(s, base) catch { e => return e }
    none
}

fn uint_failure(s: str, base: i64) -> ParseError? {
    let n = parse_uint(s, base) catch { e => return e }
    none
}

fn u64_failure(s: str, base: i64) -> ParseError? {
    let n = parse_u64(s, base) catch { e => return e }
    none
}

fn hex_failure(s: str) -> ParseError? {
    let out = decode_hex(s) catch { e => return e }
    none
}

fn bool_failure(s: str) -> ParseError? {
    let b = parse_bool(s) catch { e => return e }
    none
}

fn test_parse_radix(t: *testing.T) {
    let cases = [
        IntCase { input: "0", base: 10, want: 0 }
        IntCase { input: "-0", base: 10, want: 0 }
        IntCase { input: "+0", base: 10, want: 0 }
        IntCase { input: "7", base: 10, want: 7 }
        IntCase { input: "+7", base: 10, want: 7 }
        IntCase { input: "-7", base: 10, want: -7 }
        IntCase { input: "007", base: 10, want: 7 }
        IntCase { input: "1234567890", base: 10, want: 1234567890 }
        IntCase { input: "9223372036854775807", base: 10, want: 9223372036854775807 }
        IntCase { input: "-9223372036854775807", base: 10, want: -9223372036854775807 }
        IntCase { input: "-9223372036854775808", base: 10, want: -9223372036854775807 - 1 }
        IntCase { input: "ff", base: 16, want: 255 }
        IntCase { input: "FF", base: 16, want: 255 }
        IntCase { input: "-ff", base: 16, want: -255 }
        IntCase { input: "7fffffffffffffff", base: 16, want: 9223372036854775807 }
        IntCase { input: "-8000000000000000", base: 16, want: -9223372036854775807 - 1 }
        IntCase { input: "1010", base: 2, want: 10 }
        IntCase { input: "777", base: 8, want: 511 }
        IntCase { input: "zz", base: 36, want: 1295 }
        IntCase { input: "ZZ", base: 36, want: 1295 }
    ]
    t.table_of(cases, int_name, fn(st, c) {
        let got = parse_radix(c.input, c.base) catch { e => st.unexpected(e, 0) }
        st.equal(got, c.want)
    })
}

fn test_parse_radix_failures(t: *testing.T) {
    let cases = [
        FailureCase { input: "", base: 10, error: ParseError.Empty }
        FailureCase { input: "-", base: 10, error: ParseError.BadDigit(1) }
        FailureCase { input: "+", base: 10, error: ParseError.BadDigit(1) }
        FailureCase { input: "a", base: 10, error: ParseError.BadDigit(0) }
        FailureCase { input: "1a", base: 10, error: ParseError.BadDigit(1) }
        FailureCase { input: " 1", base: 10, error: ParseError.BadDigit(0) }
        FailureCase { input: "1 ", base: 10, error: ParseError.BadDigit(1) }
        FailureCase { input: "--1", base: 10, error: ParseError.BadDigit(1) }
        FailureCase { input: "+-1", base: 10, error: ParseError.BadDigit(1) }
        FailureCase { input: "1_000", base: 10, error: ParseError.BadDigit(1) }
        FailureCase { input: "0x10", base: 10, error: ParseError.BadDigit(1) }
        FailureCase { input: "1.5", base: 10, error: ParseError.BadDigit(1) }
        FailureCase { input: "102", base: 2, error: ParseError.BadDigit(2) }
        FailureCase { input: "g", base: 16, error: ParseError.BadDigit(0) }
        FailureCase { input: "9223372036854775808", base: 10, error: ParseError.Overflow }
        FailureCase { input: "-9223372036854775809", base: 10, error: ParseError.Overflow }
        FailureCase { input: "99999999999999999999", base: 10, error: ParseError.Overflow }
        FailureCase { input: "8000000000000000", base: 16, error: ParseError.Overflow }
        FailureCase { input: "-8000000000000001", base: 16, error: ParseError.Overflow }
    ]
    t.table_of(cases, failure_name, fn(st, c) {
        st.equal(radix_failure(c.input, c.base), c.error)
    })
}

fn test_parse_int(t: *testing.T) {
    let cases = ["0", "-1", "+1", "42", "-9223372036854775807"]
    let wants = [0, -1, 1, 42, -9223372036854775807]
    for i, input in cases {
        let got = parse_int(input) catch { e => t.unexpected(e, 0) }
        t.equal(got, wants[i])
    }
    t.equal(parse_int("") catch { e => t.expect_error(e, ParseError.Empty, 0) }, 0)
    t.equal(parse_int("1x") catch { e => t.expect_error(e, ParseError.BadDigit(1), 0) }, 0)
}

fn test_parse_uint(t: *testing.T) {
    let good = IntCase { input: "9223372036854775807", base: 10, want: 9223372036854775807 }
    let big = parse_uint(good.input, good.base) catch { e => t.unexpected(e, 0) }
    t.equal(big, good.want)
    let hex = parse_uint("FfFf", 16) catch { e => t.unexpected(e, 0) }
    t.equal(hex, 65535)
    let zero = parse_uint("0", 10) catch { e => t.unexpected(e, -1) }
    t.equal(zero, 0)
    t.equal(uint_failure("", 10), ParseError.Empty)
    t.equal(uint_failure("-1", 10), ParseError.BadDigit(0))
    t.equal(uint_failure("+1", 10), ParseError.BadDigit(0))
    t.equal(uint_failure("1 ", 10), ParseError.BadDigit(1))
    t.equal(uint_failure("9223372036854775808", 10), ParseError.Overflow)
    t.equal(uint_failure("18446744073709551615", 10), ParseError.Overflow)
}

fn test_parse_u64(t: *testing.T) {
    let lowest: u64 = 0
    let highest: u64 = 0xFFFFFFFFFFFFFFFF
    let top = parse_u64("18446744073709551615", 10) catch { e => t.unexpected(e, lowest) }
    t.equal(top, highest)
    let hex = parse_u64("ffffffffffffffff", 16) catch { e => t.unexpected(e, lowest) }
    t.equal(hex, highest)
    let zero = parse_u64("0", 2) catch { e => t.unexpected(e, highest) }
    t.equal(zero, lowest)
    t.equal(u64_failure("", 10), ParseError.Empty)
    t.equal(u64_failure("18446744073709551616", 10), ParseError.Overflow)
    t.equal(u64_failure("100000000000000000", 16), ParseError.Overflow)
    t.equal(u64_failure("12x", 10), ParseError.BadDigit(2))
    t.equal(u64_failure("-1", 10), ParseError.BadDigit(0))
}

fn test_parse_bool(t: *testing.T) {
    let yes = parse_bool("true") catch { e => t.unexpected(e, false) }
    let no = parse_bool("false") catch { e => t.unexpected(e, true) }
    t.is_true(yes)
    t.is_false(no)
    t.equal(bool_failure(""), ParseError.Empty)
    t.equal(bool_failure("True"), ParseError.BadDigit(0))
    t.equal(bool_failure("1"), ParseError.BadDigit(0))
    t.equal(bool_failure("truee"), ParseError.BadDigit(0))
    t.equal(bool_failure(" true"), ParseError.BadDigit(0))
}

fn test_digit(t: *testing.T) {
    let cases = [
        DigitCase { byte: '0', base: 10, want: 0 }
        DigitCase { byte: '9', base: 10, want: 9 }
        DigitCase { byte: 'a', base: 10, want: -1 }
        DigitCase { byte: 'a', base: 16, want: 10 }
        DigitCase { byte: 'F', base: 16, want: 15 }
        DigitCase { byte: 'g', base: 16, want: -1 }
        DigitCase { byte: 'z', base: 36, want: 35 }
        DigitCase { byte: 'Z', base: 36, want: 35 }
        DigitCase { byte: '2', base: 2, want: -1 }
        DigitCase { byte: '1', base: 2, want: 1 }
        DigitCase { byte: '/', base: 36, want: -1 }
        DigitCase { byte: ':', base: 36, want: -1 }
        DigitCase { byte: '`', base: 36, want: -1 }
        DigitCase { byte: '{', base: 36, want: -1 }
        DigitCase { byte: 0x80, base: 36, want: -1 }
    ]
    t.table_of(cases, digit_name, fn(st, c) {
        st.equal(digit(c.byte, c.base), c.want)
    })
}

fn test_hex_digit(t: *testing.T) {
    t.equal(hex_digit('0'), 0)
    t.equal(hex_digit('9'), 9)
    t.equal(hex_digit('a'), 10)
    t.equal(hex_digit('F'), 15)
    t.equal(hex_digit('g'), -1)
    t.equal(hex_digit(' '), -1)
}

fn test_radix(t: *testing.T) {
    let cases = [
        RadixCase { value: 0, base: 10, want: "0" }
        RadixCase { value: 0, base: 2, want: "0" }
        RadixCase { value: 255, base: 16, want: "ff" }
        RadixCase { value: -255, base: 16, want: "-ff" }
        RadixCase { value: 5, base: 2, want: "101" }
        RadixCase { value: 35, base: 36, want: "z" }
        RadixCase { value: 36, base: 36, want: "10" }
        RadixCase { value: -1, base: 10, want: "-1" }
        RadixCase { value: 9223372036854775807, base: 10, want: "9223372036854775807" }
        RadixCase { value: -9223372036854775807 - 1, base: 10, want: "-9223372036854775808" }
        RadixCase { value: 9223372036854775807, base: 16, want: "7fffffffffffffff" }
        RadixCase { value: -9223372036854775807 - 1, base: 16, want: "-8000000000000000" }
    ]
    t.table_of(cases, radix_name, fn(st, c) {
        st.equal(radix(c.value, c.base), c.want)
    })
}

fn test_radix_round_trips_through_parse_radix(t: *testing.T) {
    let values = [0, 1, -1, 255, -256, 123456789, 9223372036854775807, -9223372036854775807 - 1]
    for value in values {
        for base in [2, 8, 10, 16, 36] {
            let written = radix(value, base)
            let back = parse_radix(written, base) catch { e => t.unexpected(e, 0) }
            t.equal(back, value)
        }
    }
}

fn test_hex(t: *testing.T) {
    t.equal(hex(0), "0")
    t.equal(hex(1), "1")
    t.equal(hex(16), "10")
    t.equal(hex(255), "ff")
    t.equal(hex(9223372036854775807), "7fffffffffffffff")
    t.equal(hex(-1), "ffffffffffffffff")
    t.equal(hex(-9223372036854775807 - 1), "8000000000000000")
}

fn test_hex_encoding_round_trips(t: *testing.T) {
    let data: []u8 = [0, 1, 0x7F, 0x80, 0xFF, 0xAB]
    let encoded = encode_hex(data)
    t.equal(encoded, "00017f80ffab")
    let missing: []u8 = [1]
    let decoded = decode_hex(encoded) catch { e => t.unexpected(e, missing) }
    t.equal_slice(decoded, data)
    let upper_decoded = decode_hex("00017F80FFAB") catch { e => t.unexpected(e, missing) }
    t.equal_slice(upper_decoded, data)
    let empty = decode_hex("") catch { e => t.unexpected(e, missing) }
    t.equal(empty.len, 0)
    let nothing: []u8 = []
    t.equal(encode_hex(nothing), "")
}

fn test_decode_hex_failures(t: *testing.T) {
    t.equal(hex_failure("abc"), ParseError.BadDigit(3))
    t.equal(hex_failure("00zz"), ParseError.BadDigit(2))
    t.equal(hex_failure("g0"), ParseError.BadDigit(0))
    t.equal(hex_failure("0g"), ParseError.BadDigit(0))
    t.equal(hex_failure("0"), ParseError.BadDigit(1))
}

fn test_parse_hex_at(t: *testing.T) {
    let inner = parse_hex_at("xx1fzz", 2, 2) catch { e => t.unexpected(e, -1) }
    t.equal(inner, 31)
    let upper = parse_hex_at("ABCD", 0, 4) catch { e => t.unexpected(e, -1) }
    t.equal(upper, 0xABCD)
    let short = parse_hex_at("abc", 1, 4) catch { e => t.expect_error(e, ParseError.BadDigit(3), -1) }
    t.equal(short, -1)
    let bad = parse_hex_at("a-c", 0, 3) catch { e => t.expect_error(e, ParseError.BadDigit(1), -1) }
    t.equal(bad, -1)
}

fn test_is_digits(t: *testing.T) {
    t.is_true(is_digits("0"))
    t.is_true(is_digits("0123456789"))
    t.is_false(is_digits(""))
    t.is_false(is_digits("12a"))
    t.is_false(is_digits("-1"))
    t.is_false(is_digits(" 1"))
}
