import std/text

struct Prefixed {
    text: str
    k: i64
}

fn clamp_places(digits: i64) -> i64 {
    if digits < 0 { 0 } else { digits }
}

/// Returns `n` in decimal with `sep` between each group of three digits, and a leading `-` when negative.
pub fn grouped(n: i64, sep: str) -> str {
    let digits = "{magnitude(n)}"
    var out: []u8 = []
    text.append(mut out, sign_of(n))
    for i in 0..digits.len {
        if i > 0 && (digits.len - i) % 3 == 0 {
            text.append(mut out, sep)
        }
        push(mut out, digits[i])
    }
    str(out)
}

fn ordinal_suffix(mag: u64) -> str {
    let tens = mag % 100
    if tens >= 11 && tens <= 13 {
        return "th"
    }
    let last = mag % 10
    match last {
        1 => "st"
        2 => "nd"
        3 => "rd"
        _ => "th"
    }
}

/// Returns `n` in decimal followed by its English ordinal suffix, such as `1st`, `22nd`, `103rd` and `11th`.
pub fn ordinal(n: i64) -> str {
    let suffix = ordinal_suffix(magnitude(n))
    "{n}{suffix}"
}

/// Returns `ratio` as a percentage with `digits` digits after the decimal point, so `percent(0.256, 1)` gives `25.6%`.
/// A negative `digits` is treated as `0`. Rounding is that of `text.fixed`.
pub fn percent(ratio: f64, digits: i64) -> str {
    let places = clamp_places(digits)
    let value = text.fixed(ratio * 100.0, places)
    "{value}%"
}

/// Returns `part` as a percentage of `whole` with `digits` digits after the decimal point.
/// A `whole` of `0` gives `NaN%` or `inf%`, as the division produces.
pub fn percent_of(part: i64, whole: i64, digits: i64) -> str {
    let ratio = f64(part) / f64(whole)
    percent(ratio, digits)
}

/// Returns `n` abbreviated with a suffix for thousands, such as `999`, `1.5K` or `12M`.
/// The suffixes are `K`, `M`, `B`, `T`, `Qa` and `Qi`, with no space before them. A value below 10 of its unit shows one decimal, dropped when it is `0`, and a larger value is rounded to an integer. A negative `n` has a leading `-`.
pub fn compact(n: i64) -> str {
    let suffixes = ["", "K", "M", "B", "T", "Qa", "Qi"]
    let scaled = scale(magnitude(n), 1000, 6)
    let sign = sign_of(n)
    let suffix = suffixes[scaled.unit]
    "{sign}{scaled.text}{suffix}"
}

fn floor_third(e: i64) -> i64 {
    if e >= 0 {
        return e / 3
    }
    0 - (0 - e + 2) / 3
}

fn clamp_prefix(k: i64) -> i64 {
    match k {
        < -8 => -8
        > 8 => 8
        _ => k
    }
}

fn integer_digits(point: i64) -> i64 {
    match point {
        >= 3 => 3
        2 => 2
        _ => 1
    }
}

fn prefixed(a: f64, digits: i64) -> Prefixed {
    let d = digits_of(a)
    var k = clamp_prefix(floor_third(d.point - 1))
    for {
        let shift = 3 * k
        let point = d.point - shift
        let keep = point + clamp_places(digits - integer_digits(point))
        let r = round_to(d, keep)
        let rounded_point = r.point - shift
        if r.digits.len > 0 && rounded_point > 3 && k < 8 {
            k += 1
        } else {
            return Prefixed { text: render(r, rounded_point), k }
        }
    }
}

fn si_prefix(k: i64) -> str {
    let names = ["y", "z", "a", "f", "p", "n", "µ", "m", "", "k", "M", "G", "T", "P", "E", "Z", "Y"]
    names[k + 8]
}

fn with_unit(number: str, prefix: str, unit: str) -> str {
    if prefix == "" && unit == "" {
        return number
    }
    "{number} {prefix}{unit}"
}

/// Returns `v` scaled to an SI prefix with `digits` significant digits, followed by `unit`, such as `1.5 kHz` or `47 µF`.
/// The prefix runs from `y` (10^-24) to `Y` (10^24), and a magnitude beyond that range keeps the nearest prefix and shows more integer digits. The number is rounded half to even from the exact value of `v` and trailing zeros are removed. The integer part is never cut, so a `digits` below the number of integer digits still shows all of them. A space separates the number from the prefix and unit, and is omitted when both are empty. A zero is shown as `0` with no prefix. `NaN`, `inf` and `-inf` are shown as such.
pub fn si_digits(v: f64, unit: str, digits: i64) -> str {
    if v != v {
        return with_unit("NaN", "", unit)
    }
    if v == 0.0 {
        return with_unit("0", "", unit)
    }
    var sign = ""
    var a = v
    if v < 0.0 {
        sign = "-"
        a = -v
    }
    if a > 1.7976931348623157e308 {
        return with_unit("{sign}inf", "", unit)
    }
    let p = prefixed(a, digits)
    with_unit("{sign}{p.text}", si_prefix(p.k), unit)
}

/// Returns `v` scaled to an SI prefix with three significant digits, followed by `unit`.
/// Behaves as `si_digits` with `digits` of `3`.
pub fn si(v: f64, unit: str) -> str {
    si_digits(v, unit, 3)
}
