import std/text

struct Digits {
    digits: []u8
    point: i64
}

const exact_places = 1100

fn trimmed(digits: []u8) -> []u8 {
    var end = digits.len
    for end > 0 && digits[end - 1] == 0 {
        end -= 1
    }
    digits[..end]
}

fn digits_of(a: f64) -> Digits {
    let s = text.fixed(a, exact_places)
    var point = text.index(s, ".")
    var digits: []u8 = []
    for i in 0..s.len {
        let c = s[i]
        if c != '.' {
            if digits.len == 0 && c == '0' {
                point -= 1
            } else {
                push(mut digits, c - '0')
            }
        }
    }
    Digits { digits: trimmed(digits), point }
}

fn zero_digits() -> Digits {
    let none: []u8 = []
    Digits { digits: none, point: 0 }
}

fn rounds_up(digits: []u8, keep: i64) -> bool {
    let next = digits[keep]
    if next != 5 {
        return next > 5
    }
    if keep + 1 < digits.len {
        return true
    }
    keep > 0 && digits[keep - 1] % 2 == 1
}

fn round_to(d: Digits, keep: i64) -> Digits {
    if keep >= d.digits.len {
        return d
    }
    if keep < 0 {
        return zero_digits()
    }
    var kept: []u8 = []
    for i in 0..keep {
        push(mut kept, d.digits[i])
    }
    if !rounds_up(d.digits, keep) {
        return Digits { digits: trimmed(kept), point: d.point }
    }
    var i = keep - 1
    for i >= 0 && kept[i] == 9 {
        kept[i] = 0
        i -= 1
    }
    if i < 0 {
        let one: []u8 = [1]
        return Digits { digits: one, point: d.point + 1 }
    }
    kept[i] += 1
    Digits { digits: trimmed(kept), point: d.point }
}

fn digit_char(digits: []u8, at: i64) -> u8 {
    if at < digits.len {
        return digits[at] + '0'
    }
    '0'
}

fn render(d: Digits, point: i64) -> str {
    if d.digits.len == 0 {
        return "0"
    }
    var out: []u8 = []
    if point <= 0 {
        push(mut out, '0')
    }
    for i in 0..point {
        push(mut out, digit_char(d.digits, i))
    }
    let first = if point > 0 { point } else { 0 }
    if d.digits.len > first {
        push(mut out, '.')
        for i in 0..(0 - point) {
            push(mut out, '0')
        }
        for i in first..d.digits.len {
            push(mut out, digit_char(d.digits, i))
        }
    }
    str(out)
}
