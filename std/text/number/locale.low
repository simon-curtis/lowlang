import std/locale
import std/locale/numfmt

fn fraction_options(digits: i64) -> numfmt.Options {
    var o = numfmt.options()
    let places = if digits < 0 { 0 } else { digits }
    o.minimum_fraction = places
    o.maximum_fraction = places
    o
}

/// Returns `n` with the digits, grouping and minus sign of `l`, such as `1,234,567` for `en`, `1.234.567` for `de` and `12,34,567` for `en-IN`.
pub fn grouped_in(l: locale.Locale, n: i64) -> str {
    numfmt.format_int(l, n, numfmt.options()) or "{n}"
}

/// Returns `ratio` as a percentage with `digits` digits after the decimal separator, in the pattern of `l`: `25.6%` for `en`, `25,6 %` for `fr`.
///
/// A negative `digits` is treated as `0`. A half rounds to the even digit.
pub fn percent_in(l: locale.Locale, ratio: f64, digits: i64) -> str {
    var o = fraction_options(digits)
    o.style = numfmt.Style.Percent
    numfmt.format_f64(l, ratio, o) or "{ratio}"
}

/// Returns `n` abbreviated as `l` abbreviates it, with `display` choosing `1.2K` or `1.2 thousand` for `en`.
pub fn compact_in(l: locale.Locale, n: i64, display: numfmt.CompactDisplay) -> str {
    var o = numfmt.options()
    o.notation = numfmt.Notation.Compact
    o.compact_display = display
    numfmt.format_int(l, n, o) or "{n}"
}

/// Returns `amount` of the currency `code` as `l` writes it, such as `$1,234.50` for `en` and `1.234,50 $` for `de`, with the digits and rounding of ISO 4217.
///
/// Fails with `UnknownCurrency` when `code` is not a currency of the data and with `MissingCurrency` when it is empty.
pub fn currency_in(l: locale.Locale, amount: f64, code: str) -> str ! numfmt.Error {
    var o = numfmt.options()
    o.style = numfmt.Style.Currency
    o.currency = code
    numfmt.format_f64(l, amount, o)?
}
