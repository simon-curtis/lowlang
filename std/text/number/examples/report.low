import std/text
import std/text/number

struct Service {
    name: str,
    requests: i64,
    failures: i64,
    memory: i64,
    latency: f64,
}

/// Formats service metrics for a status page with digit groups, abbreviations, percentages, binary sizes and SI units.
fn main() {
    let services = [
        Service { name: "gateway", requests: 12847391, failures: 3210, memory: 734003200, latency: 0.0042 },
        Service { name: "billing", requests: 98211, failures: 0, memory: 1610612736, latency: 0.215 },
        Service { name: "search", requests: 999, failures: 17, memory: 52428, latency: 0.00007 },
    ]

    for s in services {
        let name = text.pad_right(s.name, 8, ' ')
        let requests = text.pad_left(number.grouped(s.requests, ","), 11, ' ')
        let compact = text.pad_left(number.compact(s.requests), 6, ' ')
        let failed = text.pad_left(number.percent_of(s.failures, s.requests, 2), 7, ' ')
        let memory = text.pad_left(number.format_bytes(s.memory, true), 9, ' ')
        let decimal = text.pad_left(number.format_bytes(s.memory, false), 9, ' ')
        print("{name}{requests}{compact}{failed}{memory}{decimal}  {number.si(s.latency, "s")}")
    }

    print(number.si_digits(1500.0, "Hz", 2))
    print(number.si(0.000047, "F"))
    print("{number.ordinal(1)} {number.ordinal(22)} {number.ordinal(103)} {number.ordinal(111)}")
    print(number.words(-1204))
    print(number.percent(0.256, 1))
}
