import std/text/number

fn quota(input: str) -> str {
    let bytes = number.parse_bytes(input) catch {
        Empty => return "{input}: empty"
        Malformed(offset) => return "{input}: not a size at byte {offset}"
        UnknownUnit(unit) => return "{input}: unknown unit {unit}"
        TooPrecise => return "{input}: too precise"
        OutOfRange => return "{input}: out of range"
    }
    "{input} = {bytes} bytes, shown as {number.format_bytes(bytes, true)}"
}

fn edition(input: str) -> str {
    let value = number.parse_roman(input) catch {
        Empty => return "{input}: empty"
        Malformed(offset) => return "{input}: malformed at byte {offset}"
        _ => return "{input}: out of range"
    }
    "{input} = {value}, back to {number.roman(value) or "?"}"
}

/// Parses user-supplied sizes and Roman numerals, and reports each kind of failure.
fn main() {
    for input in ["512", "1.5 KiB", "10MB", "2 gib", "", "x12", "5 parsecs", "99999999 EB"] {
        print(quota(input))
    }
    for input in ["XLII", "mcmxciv", "IIII", "", "MMMM"] {
        print(edition(input))
    }
}
