import std/locale
import std/locale/numfmt
import std/text/number

fn show(tag: str) {
    let l = locale.parse(tag) or locale.root()
    let count = number.grouped_in(l, 1234567)
    let ratio = number.percent_in(l, 0.256, 1)
    let short = number.compact_in(l, 1500000, numfmt.CompactDisplay.Short)
    let long = number.compact_in(l, 1500000, numfmt.CompactDisplay.Long)
    let price = number.currency_in(l, 1234.5, "USD") or "?"
    print("{tag}: {count} | {ratio} | {short} | {long} | {price}")
}

fn main() {
    show("en")
    show("de")
    show("fr")
    show("en-IN")
    show("hi")
    show("ja")
}
