/// Why a number could not be parsed or converted.
pub enum NumberError {
    /// The input is empty or only whitespace.
    Empty
    /// The input is not shaped as a number. `offset` is the byte offset of the offending byte.
    Malformed(offset: i64)
    /// The unit suffix is not recognised. `unit` is the unit text, trimmed.
    UnknownUnit(unit: str)
    /// The fraction has more digits than the parser can hold exactly.
    TooPrecise
    /// The value is outside the range the conversion accepts.
    OutOfRange
}
