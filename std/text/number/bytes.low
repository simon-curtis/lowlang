import std/text

struct Fraction {
    value: u64
    places: i64
}

struct Quantity {
    negative: bool
    whole: u64
    fraction: Fraction
    unit: str
}

fn byte_base(binary: bool) -> u64 {
    if binary { 1024 } else { 1000 }
}

fn byte_unit(unit: i64, binary: bool) -> str {
    if binary {
        let names = ["B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB"]
        return names[unit]
    }
    let names = ["B", "kB", "MB", "GB", "TB", "PB", "EB"]
    names[unit]
}

/// Returns `n` as a human-readable byte size such as `1.5 KiB` or `999 B`.
/// `binary` selects the units: `true` uses powers of 1024 named `KiB` to `EiB`, `false` uses powers of 1000 named `kB` to `EB`. The unit is the largest that keeps the value at `1` or above. A value below 10 of its unit shows one decimal, dropped when it is `0`, and a larger value is rounded to an integer. A negative `n` has a leading `-`.
pub fn format_bytes(n: i64, binary: bool) -> str {
    let base = byte_base(binary)
    let scaled = scale(magnitude(n), base, 6)
    let unit = byte_unit(scaled.unit, binary)
    let sign = sign_of(n)
    "{sign}{scaled.text} {unit}"
}

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn skip_spaces(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len && text.space(s[i]) {
        i += 1
    }
    i
}

fn digits_end(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len && is_digit(s[i]) {
        i += 1
    }
    i
}

fn accumulate(acc: u64, digit: u8) -> u64? {
    let d = u64(digit - '0')
    acc * 10 + d when acc <= (0xFFFFFFFFFFFFFFFF - d) / 10
}

fn whole_part(s: str, from: i64, to: i64) -> u64 ! NumberError {
    var n: u64 = 0
    for i in from..to {
        n = accumulate(n, s[i]) ?? fail OutOfRange
    }
    n
}

fn fraction_part(s: str, from: i64, to: i64) -> Fraction ! NumberError {
    var end = to
    for end > from && s[end - 1] == '0' {
        end -= 1
    }
    if end - from > 18 {
        fail TooPrecise
    }
    var n: u64 = 0
    for i in from..end {
        n = n * 10 + u64(s[i] - '0')
    }
    Fraction { value: n, places: end - from }
}

fn parse_quantity(s: str) -> Quantity ! NumberError {
    var at = skip_spaces(s, 0)
    if at == s.len {
        fail Empty
    }
    var negative = false
    if s[at] == '-' || s[at] == '+' {
        negative = s[at] == '-'
        at += 1
    }
    let whole_end = digits_end(s, at)
    if whole_end == at {
        fail Malformed(at)
    }
    let whole = whole_part(s, at, whole_end)?
    var fraction = Fraction { value: 0, places: 0 }
    var unit_at = whole_end
    if whole_end < s.len && s[whole_end] == '.' {
        let fraction_end = digits_end(s, whole_end + 1)
        if fraction_end == whole_end + 1 {
            fail Malformed(whole_end + 1)
        }
        fraction = fraction_part(s, whole_end + 1, fraction_end)?
        unit_at = fraction_end
    }
    Quantity { negative, whole, fraction, unit: text.trim(s[unit_at..]) }
}

fn unit_factor(unit: str) -> u64? {
    let name = text.lower(unit)
    if name == "" || name == "b" {
        return 1
    }
    let index = text.index("kmgtpe", name[..1]) + 1
    if index == 0 {
        return none
    }
    let tail = name[1..]
    if tail == "" || tail == "b" {
        return power(1000, index)
    }
    if tail == "i" || tail == "ib" {
        return power(1024, index)
    }
    none
}

fn total_bytes(q: Quantity, factor: u64) -> u64 ! NumberError {
    if q.whole > 0xFFFFFFFFFFFFFFFF / factor {
        fail OutOfRange
    }
    let base = q.whole * factor
    let denominator = power(10, q.fraction.places)
    let extra = fraction_of(q.fraction.value, factor, denominator)
    if base > 0xFFFFFFFFFFFFFFFF - extra {
        fail OutOfRange
    }
    base + extra
}

fn signed(mag: u64, negative: bool) -> i64 ! NumberError {
    let limit: u64 = 1 << 63
    if negative {
        if mag > limit {
            fail OutOfRange
        }
        return i64(0 - mag)
    }
    if mag >= limit {
        fail OutOfRange
    }
    i64(mag)
}

/// Parses a byte size such as `1.5 KiB`, `10MB` or `512` and returns the number of bytes.
/// The text is an optional sign, digits with an optional `.` and fraction digits, optional whitespace and a unit. Leading and trailing whitespace is ignored. The unit is matched without regard to case and is empty or `B` for bytes, `K`, `M`, `G`, `T`, `P` or `E` optionally followed by `B` for powers of 1000, or followed by `i` or `iB` for powers of 1024. A fractional result is rounded to the nearest byte.
///
/// Fails with `Empty` for blank input, `Malformed` at the offset where digits were expected, `UnknownUnit` for any other unit, `TooPrecise` when the fraction has more than 18 digits after trailing zeros, and `OutOfRange` when the result does not fit in an `i64`.
pub fn parse_bytes(s: str) -> i64 ! NumberError {
    let q = parse_quantity(s)?
    let factor = unit_factor(q.unit) ?? fail UnknownUnit(q.unit)
    let mag = total_bytes(q, factor)?
    signed(mag, q.negative)
}
