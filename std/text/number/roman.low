import std/text

fn roman_values() -> []i64 {
    [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
}

fn roman_symbols() -> []str {
    ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
}

/// Returns `n` as an uppercase Roman numeral.
/// Fails with `OutOfRange` when `n` is outside 1 to 3999.
pub fn roman(n: i64) -> str ! NumberError {
    if n < 1 || n > 3999 {
        fail OutOfRange
    }
    let values = roman_values()
    let symbols = roman_symbols()
    var out: []u8 = []
    var rest = n
    for i in 0..values.len {
        for rest >= values[i] {
            text.append(mut out, symbols[i])
            rest -= values[i]
        }
    }
    str(out)
}

fn symbol_value(c: u8) -> i64 {
    match c {
        'I' => 1
        'V' => 5
        'X' => 10
        'L' => 50
        'C' => 100
        'D' => 500
        'M' => 1000
        _ => 0
    }
}

fn roman_total(s: str) -> i64 ! NumberError {
    var total = 0
    for i in 0..s.len {
        let v = symbol_value(s[i])
        if v == 0 {
            fail Malformed(i)
        }
        if i + 1 < s.len && v < symbol_value(s[i + 1]) {
            total -= v
        } else {
            total += v
        }
    }
    total
}

fn difference_at(a: str, b: str) -> i64 {
    var i = 0
    for i < a.len && i < b.len && a[i] == b[i] {
        i += 1
    }
    i
}

/// Parses a Roman numeral and returns its value.
/// Letters may be either case. Only the canonical form that `roman` produces is accepted, so `IV` parses and `IIII` and `IC` do not.
///
/// Fails with `Empty` for an empty string, with `Malformed` at the index of the first byte that is not a Roman letter or that departs from the canonical form, and with `OutOfRange` when the value exceeds 3999.
pub fn parse_roman(s: str) -> i64 ! NumberError {
    if s == "" {
        fail Empty
    }
    let upper = text.upper(s)
    let total = roman_total(upper)?
    if total > 3999 {
        fail OutOfRange
    }
    let canonical = roman(total) or fail Malformed(0)
    if canonical != upper {
        fail Malformed(difference_at(canonical, upper))
    }
    total
}
