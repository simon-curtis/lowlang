struct Scaled {
    unit: i64
    text: str
}

fn power(base: u64, n: i64) -> u64 {
    var out: u64 = 1
    for i in 0..n {
        out *= base
    }
    out
}

fn magnitude(n: i64) -> u64 {
    if n < 0 {
        return u64(-(n + 1)) + 1
    }
    u64(n)
}

fn sign_of(n: i64) -> str {
    if n < 0 { "-" } else { "" }
}

fn pick_unit(mag: u64, base: u64, top: i64) -> i64 {
    var unit = 0
    for unit < top && mag >= power(base, unit + 1) {
        unit += 1
    }
    unit
}

fn tenths_of(mag: u64, divisor: u64) -> u64 {
    let whole = mag / divisor
    let rest = mag % divisor
    whole * 10 + (rest * 10 + divisor / 2) / divisor
}

fn rounded_of(mag: u64, divisor: u64) -> u64 {
    (mag + divisor / 2) / divisor
}

fn tenths_text(t: u64) -> str {
    if t % 10 == 0 {
        return "{t / 10}"
    }
    "{t / 10}.{t % 10}"
}

fn scale(mag: u64, base: u64, top: i64) -> Scaled {
    var unit = pick_unit(mag, base, top)
    for {
        if unit == 0 {
            return Scaled { unit: 0, text: "{mag}" }
        }
        let divisor = power(base, unit)
        let t = tenths_of(mag, divisor)
        if t < 100 {
            return Scaled { unit, text: tenths_text(t) }
        }
        let v = rounded_of(mag, divisor)
        if v >= base && unit < top {
            unit += 1
        } else {
            return Scaled { unit, text: "{v}" }
        }
    }
}

fn div128(high: u64, low: u64, divisor: u64) -> u64 {
    var rest = high
    var quotient: u64 = 0
    for i in 0..64 {
        let carry = rest >> 63
        rest = (rest << 1) | ((low >> (63 - i)) & 1)
        quotient = quotient << 1
        if carry == 1 || rest >= divisor {
            rest -= divisor
            quotient |= 1
        }
    }
    quotient
}

fn fraction_of(numerator: u64, unit: u64, denominator: u64) -> u64 {
    let high = __mulhi(numerator, unit)
    let low = numerator * unit
    let sum = low + denominator / 2
    var carried = high
    if sum < low {
        carried += 1
    }
    div128(carried, sum, denominator)
}
