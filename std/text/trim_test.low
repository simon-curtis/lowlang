import std/testing

struct TrimCase {
    input: str
    want: str
}

struct AffixCase {
    input: str
    affix: str
    want: str
}

fn trim_name(c: TrimCase) -> str {
    quote(c.input)
}

fn affix_name(c: AffixCase) -> str {
    "{quote(c.input)} minus {quote(c.affix)}"
}

fn test_trim(t: *testing.T) {
    let cases = [
        TrimCase { input: "", want: "" }
        TrimCase { input: "   ", want: "" }
        TrimCase { input: "a", want: "a" }
        TrimCase { input: "  a", want: "a" }
        TrimCase { input: "a  ", want: "a" }
        TrimCase { input: "  a b  ", want: "a b" }
        TrimCase { input: " \t\r\n a \t\r\n ", want: "a" }
        TrimCase { input: raw([0x0B, 0x61, 0x0C]), want: raw([0x0B, 0x61, 0x0C]) }
        TrimCase { input: raw([0x20, 0x0B, 0x61, 0x20]), want: raw([0x0B, 0x61]) }
        TrimCase { input: "é ", want: "é" }
    ]
    t.table_of(cases, trim_name, fn(st, c) {
        st.equal(trim(c.input), c.want)
    })
}

fn test_trim_start(t: *testing.T) {
    let cases = [
        TrimCase { input: "", want: "" }
        TrimCase { input: "   ", want: "" }
        TrimCase { input: "a", want: "a" }
        TrimCase { input: "  a  ", want: "a  " }
        TrimCase { input: "\t\r\n a", want: "a" }
        TrimCase { input: "a  b", want: "a  b" }
    ]
    t.table_of(cases, trim_name, fn(st, c) {
        st.equal(trim_start(c.input), c.want)
    })
}

fn test_trim_end(t: *testing.T) {
    let cases = [
        TrimCase { input: "", want: "" }
        TrimCase { input: "   ", want: "" }
        TrimCase { input: "a", want: "a" }
        TrimCase { input: "  a  ", want: "  a" }
        TrimCase { input: "a \t\r\n", want: "a" }
        TrimCase { input: "a  b", want: "a  b" }
    ]
    t.table_of(cases, trim_name, fn(st, c) {
        st.equal(trim_end(c.input), c.want)
    })
}

fn test_trim_prefix(t: *testing.T) {
    let cases = [
        AffixCase { input: "prefix-x", affix: "prefix-", want: "x" }
        AffixCase { input: "x", affix: "prefix-", want: "x" }
        AffixCase { input: "aab", affix: "a", want: "ab" }
        AffixCase { input: "abc", affix: "", want: "abc" }
        AffixCase { input: "abc", affix: "abc", want: "" }
        AffixCase { input: "ab", affix: "abc", want: "ab" }
        AffixCase { input: "", affix: "a", want: "" }
        AffixCase { input: "", affix: "", want: "" }
        AffixCase { input: "xab", affix: "ab", want: "xab" }
    ]
    t.table_of(cases, affix_name, fn(st, c) {
        st.equal(trim_prefix(c.input, c.affix), c.want)
    })
}

fn test_trim_suffix(t: *testing.T) {
    let cases = [
        AffixCase { input: "x.low", affix: ".low", want: "x" }
        AffixCase { input: "x", affix: ".low", want: "x" }
        AffixCase { input: "baa", affix: "a", want: "ba" }
        AffixCase { input: "abc", affix: "", want: "abc" }
        AffixCase { input: "abc", affix: "abc", want: "" }
        AffixCase { input: "bc", affix: "abc", want: "bc" }
        AffixCase { input: "", affix: "a", want: "" }
        AffixCase { input: "", affix: "", want: "" }
        AffixCase { input: "abx", affix: "ab", want: "abx" }
    ]
    t.table_of(cases, affix_name, fn(st, c) {
        st.equal(trim_suffix(c.input, c.affix), c.want)
    })
}

fn test_space(t: *testing.T) {
    t.is_true(space(' '))
    t.is_true(space('\t'))
    t.is_true(space('\r'))
    t.is_true(space('\n'))
    t.is_false(space(0x0B))
    t.is_false(space(0x0C))
    t.is_false(space(0xA0))
    t.is_false(space('a'))
    t.is_false(space(0))
}
