import std/simd
import std/slices

/// Why parsing a number, boolean or hex string failed.
pub enum ParseError {
    /// The input is empty.
    Empty
    /// A byte is not a valid digit. `at` is its index in the input.
    BadDigit(at: i64)
    /// The value does not fit in the integer type being parsed.
    Overflow
}

/// Returns the value of the digit byte `c` in `base`, 2 to 36, where `0` to `9` then `a` to `z` and `A` to `Z` count from 0 and 10, or -1 when `c` is not a digit of `base`.
pub fn digit(c: u8, base: i64) -> i64 {
    var d = 99
    if c >= '0' && c <= '9' {
        d = i64(c - '0')
    } else if c >= 'a' && c <= 'z' {
        d = i64(c - 'a') + 10
    } else if c >= 'A' && c <= 'Z' {
        d = i64(c - 'A') + 10
    }
    if d < base { d } else { -1 }
}

/// Returns the value 0 to 15 of the hexadecimal digit byte `c`, accepting both cases, or -1 when `c` is not a hexadecimal digit.
pub fn hex_digit(c: u8) -> i64 {
    digit(c, 16)
}

/// Returns the lowercase digit byte for the value `d`, `0` to `9` and then `a` to `z`.
/// `d` must be 0 to 35.
pub fn digit_char(d: i64) -> u8 {
    let symbols = "0123456789abcdefghijklmnopqrstuvwxyz"
    symbols[d]
}

/// Appends the low `width` hexadecimal digits of `n` to `out`, padded with leading zeros.
/// `upper` selects `A` to `F` over `a` to `f`. `n` must not be negative.
pub fn append_hex(mut out: []u8, n: i64, width: i64, upper: bool) {
    for k in 0..width {
        let d = digit_char(n >> (4 * (width - 1 - k)) & 0xF)
        push(mut out, if upper { upper_byte(d) } else { d })
    }
}

/// Parses `width` hexadecimal digits of either case that start at index `at` of `s` and returns their value.
/// `width` is 1 to 15. Fails with `BadDigit` at the index of the first byte that is not a hexadecimal digit, or at `s.len` when the digits run past the end of `s`.
pub fn parse_hex_at(s: str, at: i64, width: i64) -> i64 ! ParseError {
    var n = 0
    for i in at..at + width {
        if i >= s.len {
            fail BadDigit(s.len)
        }
        let d = digit(s[i], 16)
        if d < 0 {
            fail BadDigit(i)
        }
        n = n << 4 | d
    }
    n
}

/// Returns whether `s` is not empty and holds only the ASCII digits `0` to `9`.
pub fn is_digits(s: str) -> bool {
    if s.len == 0 {
        return false
    }
    for i in 0..s.len {
        if s[i] < '0' || s[i] > '9' {
            return false
        }
    }
    true
}

/// Returns the number of backslashes that end `s`, as a line continuation counts them: an odd number escapes the line break.
pub fn trailing_backslashes(s: str) -> i64 {
    var n = 0
    for n < s.len && s[s.len - 1 - n] == '\\' {
        n += 1
    }
    n
}

/// Returns whether `c` is a Unicode scalar value: not a surrogate and not above `0x10FFFF`.
pub fn is_scalar(c: u32) -> bool {
    c < 0xD800 || c >= 0xE000 && c <= 0x10FFFF
}

/// Parses an unsigned integer written in `base` and returns it as a `u64`.
/// `base` is 2 to 36 and letters of either case give the digits from 10. No sign, prefix, underscore or whitespace is accepted.
///
/// Fails with `Empty` for an empty string, `BadDigit` at the first byte that is not a digit of `base`, and `Overflow` when the value exceeds the largest `u64`.
pub fn parse_u64(s: str, base: i64) -> u64 ! ParseError {
    if s.len == 0 {
        fail Empty
    }
    let radix = u64(base)
    var n: u64 = 0
    for i in 0..s.len {
        let d = digit(s[i], base)
        if d < 0 {
            fail BadDigit(i)
        }
        let value = u64(d)
        if n > (0xFFFFFFFFFFFFFFFF - value) / radix {
            fail Overflow
        }
        n = n * radix + value
    }
    n
}

/// Parses an unsigned integer written in `base` and returns it as an `i64`.
/// `base` is 2 to 36 and letters of either case give the digits from 10. No sign, prefix, underscore or whitespace is accepted.
///
/// Fails with `Empty` for an empty string, `BadDigit` at the first byte that is not a digit of `base`, and `Overflow` when the value exceeds the largest `i64`.
pub fn parse_uint(s: str, base: i64) -> i64 ! ParseError {
    let n = parse_u64(s, base)?
    if n > 0x7FFFFFFFFFFFFFFF {
        fail Overflow
    }
    i64(n)
}

/// Parses a signed integer written in `base`.
/// A single leading `-` or `+` is accepted and `base` is 2 to 36. The smallest `i64` parses. Fails with `Empty` for an empty string, with `BadDigit` at the first byte that is not a digit (a lone sign fails at index 1), and with `Overflow` when the value does not fit in an `i64`.
pub fn parse_radix(s: str, base: i64) -> i64 ! ParseError {
    if s.len == 0 {
        fail Empty
    }
    let negative = s[0] == '-'
    var start = 0
    if negative || s[0] == '+' {
        start = 1
    }
    if start == s.len {
        fail BadDigit(start)
    }
    let min = -9223372036854775807 - 1
    var n = 0
    for i in start..s.len {
        let d = digit(s[i], base)
        if d < 0 {
            fail BadDigit(i)
        }
        if n < (min + d) / base {
            fail Overflow
        }
        n = n * base - d
    }
    if negative {
        return n
    }
    if n == min {
        fail Overflow
    }
    -n
}

/// Parses a signed decimal integer.
/// Behaves as `parse_radix` with base 10.
pub fn parse_int(s: str) -> i64 ! ParseError {
    parse_radix(s, 10)?
}

/// Parses `true` or `false`.
/// Fails with `Empty` for an empty string and with `BadDigit` at index 0 for anything else, including `True` and `1`.
pub fn parse_bool(s: str) -> bool ! ParseError {
    match s {
        == "true" => true
        == "false" => false
        == "" => fail Empty
        _ => fail BadDigit(0)
    }
}

/// Returns `n` written in `base` using lowercase digits, with a leading `-` when negative.
/// `base` is 2 to 36. `0` gives `0`.
pub fn radix(n: i64, base: i64) -> str {
    if n == 0 {
        return "0"
    }
    var out: []u8 = []
    var rest = n
    for rest != 0 {
        var d = rest % base
        if d < 0 {
            d = -d
        }
        push(mut out, digit_char(d))
        rest /= base
    }
    if n < 0 {
        push(mut out, '-')
    }
    for i in 0..out.len / 2 {
        let j = out.len - 1 - i
        let swap = out[i]
        out[i] = out[j]
        out[j] = swap
    }
    __str_view(out)
}

/// Returns the lowercase hexadecimal form of the 64 bits of `n`, without prefix or leading zeros.
/// A negative `n` gives its sixteen-digit two's complement form. `0` gives `0`.
pub fn hex(n: i64) -> str {
    var out: []u8 = []
    var shift = 60
    var started = false
    for shift >= 0 {
        let d = n >> shift & 0xF
        if d != 0 || started || shift == 0 {
            push(mut out, digit_char(d))
            started = true
        }
        shift -= 4
    }
    __str_view(out)
}

/// Returns the ASCII lowercase form of `c`, or `c` when it is not `A` to `Z`.
pub fn lower_byte(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

/// Returns the ASCII uppercase form of `c`, or `c` when it is not `a` to `z`.
pub fn upper_byte(c: u8) -> u8 {
    if c >= 'a' && c <= 'z' { c - 32 } else { c }
}

fn first_in_range(s: str, low: u8, high: u8) -> i64 {
    for i in 0..s.len {
        if s[i] >= low && s[i] <= high {
            return i
        }
    }
    -1
}

/// Returns `s` with ASCII letters uppercased.
/// Other bytes, including non-ASCII UTF-8, are unchanged. Returns `s` itself when no byte changes. For full Unicode case mapping use `std/unicode`.
pub fn upper(s: str) -> str {
    let first = first_in_range(s, 'a', 'z')
    if first < 0 {
        return s
    }
    let out = bytes(s)
    for i in first..out.len {
        out[i] = upper_byte(out[i])
    }
    __str_view(out)
}

/// Returns `s` with ASCII letters lowercased.
/// Other bytes, including non-ASCII UTF-8, are unchanged. Returns `s` itself when no byte changes. For full Unicode case mapping use `std/unicode`.
pub fn lower(s: str) -> str {
    let first = first_in_range(s, 'A', 'Z')
    if first < 0 {
        return s
    }
    let out = bytes(s)
    for i in first..out.len {
        out[i] = lower_byte(out[i])
    }
    __str_view(out)
}

/// Returns whether `a` and `b` are equal when ASCII letters are compared without regard to case.
/// Other bytes must match exactly. Allocates nothing.
pub fn equal_fold(a: str, b: str) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if lower_byte(a[i]) != lower_byte(b[i]) {
            return false
        }
    }
    true
}

/// Returns whether `s` begins with `prefix`, comparing ASCII letters without regard to case.
/// Allocates nothing.
pub fn starts_with_fold(s: str, prefix: str) -> bool {
    s.len >= prefix.len && equal_fold(s[..prefix.len], prefix)
}

/// Returns whether `c` is ASCII whitespace: space, tab, carriage return or newline.
/// Vertical tab and form feed are not included.
pub fn space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

/// Returns `s` without leading and trailing ASCII whitespace, as defined by `space`.
pub fn trim(s: str) -> str {
    trim_end(trim_start(s))
}

/// Returns `s` without leading ASCII whitespace, as defined by `space`.
pub fn trim_start(s: str) -> str {
    var start = 0
    for start < s.len && space(s[start]) {
        start += 1
    }
    s[start..]
}

/// Returns `s` without trailing ASCII whitespace, as defined by `space`.
pub fn trim_end(s: str) -> str {
    var end = s.len
    for end > 0 && space(s[end - 1]) {
        end -= 1
    }
    s[..end]
}

/// Returns `s` without a leading `prefix`, or `s` unchanged when it does not begin with it.
/// Only one occurrence is removed.
pub fn trim_prefix(s: str, prefix: str) -> str {
    if starts_with(s, prefix) {
        return s[prefix.len..]
    }
    s
}

/// Returns `s` without a trailing `suffix`, or `s` unchanged when it does not end with it.
/// Only one occurrence is removed.
pub fn trim_suffix(s: str, suffix: str) -> str {
    if ends_with(s, suffix) {
        return s[..s.len - suffix.len]
    }
    s
}

/// Returns the index of the first byte `c` in `s`, or `-1` when it is absent.
pub fn index_byte(s: str, c: u8) -> i64 {
    simd.find_byte_str(s, 0, s.len, c)
}

/// Returns the index of the last byte `c` in `s`, or `-1` when it is absent.
pub fn last_index_byte(s: str, c: u8) -> i64 {
    var i = s.len - 1
    for i >= 0 {
        if s[i] == c {
            return i
        }
        i -= 1
    }
    -1
}

/// Returns the byte index of the first occurrence of `sub` in `s`, or `-1` when it is absent.
/// An empty `sub` is found at index `0`.
pub fn index(s: str, sub: str) -> i64 {
    if sub.len == 0 {
        return 0
    }
    var i = 0
    let last = s.len - sub.len + 1
    for i < last {
        let at = simd.find_byte_str(s, i, last, sub[0])
        if at < 0 {
            return -1
        }
        if s[at..at + sub.len] == sub {
            return at
        }
        i = at + 1
    }
    -1
}

/// Returns the byte index of the last occurrence of `sub` in `s`, or `-1` when it is absent.
/// An empty `sub` is found at index `s.len`.
pub fn last_index(s: str, sub: str) -> i64 {
    var i = s.len - sub.len
    for i >= 0 {
        if s[i..i + sub.len] == sub {
            return i
        }
        i -= 1
    }
    -1
}

/// Returns whether `sub` occurs in `s`. An empty `sub` always occurs.
pub fn contains(s: str, sub: str) -> bool {
    index(s, sub) >= 0
}

/// Returns the number of non-overlapping occurrences of `sub` in `s`.
/// An empty `sub` counts the positions between code points, which is `char_count(s) + 1`.
pub fn count(s: str, sub: str) -> i64 {
    if sub.len == 0 {
        return char_count(s) + 1
    }
    var n = 0
    var from = 0
    for {
        let at = index(s[from..], sub)
        if at < 0 {
            return n
        }
        n += 1
        from += at + sub.len
    }
}

/// Returns whether `s` begins with `prefix`. An empty `prefix` always matches.
pub fn starts_with(s: str, prefix: str) -> bool {
    s.len >= prefix.len && s[..prefix.len] == prefix
}

/// Returns whether `s` ends with `suffix`. An empty `suffix` always matches.
pub fn ends_with(s: str, suffix: str) -> bool {
    s.len >= suffix.len && s[s.len - suffix.len..] == suffix
}

/// Splits `s` at every byte equal to `sep` and returns the pieces.
/// Always returns at least one piece: an empty `s` gives one empty string, and adjacent separators give empty pieces. The separator is not included. The pieces are slices of `s`.
pub fn split(s: str, sep: u8) -> []str {
    var parts: []str = []
    var start = 0
    for i in 0..s.len {
        if s[i] == sep {
            push(mut parts, s[start..i])
            start = i + 1
        }
    }
    push(mut parts, s[start..])
    parts
}

/// Splits `s` at every non-overlapping occurrence of `sep` and returns the pieces.
/// Behaves as `split` for a string separator. An empty `sep` splits `s` into its code points, as `chars` does.
pub fn split_str(s: str, sep: str) -> []str {
    if sep.len == 0 {
        return chars(s)
    }
    var parts: []str = []
    var from = 0
    for {
        let at = index(s[from..], sep)
        if at < 0 {
            push(mut parts, s[from..])
            return parts
        }
        push(mut parts, s[from..from + at])
        from += at + sep.len
    }
}

/// Returns the code points of `s` as one-character strings.
/// A byte that is not part of a valid UTF-8 sequence becomes a piece of its own. The pieces are slices of `s`.
pub fn chars(s: str) -> []str {
    var starts: []i64 = []
    for i, c in s {
        push(mut starts, i)
    }
    var out: []str = []
    for k, start in starts {
        var end = s.len
        if k + 1 < starts.len {
            end = starts[k + 1]
        }
        push(mut out, s[start..end])
    }
    out
}

/// Splits `s` around runs of ASCII whitespace, as defined by `space`, and returns the non-empty pieces.
/// An empty or all-whitespace `s` gives an empty slice.
pub fn fields(s: str) -> []str {
    var out: []str = []
    var i = 0
    for i < s.len {
        for i < s.len && space(s[i]) {
            i += 1
        }
        let start = i
        for i < s.len && !space(s[i]) {
            i += 1
        }
        if i > start {
            push(mut out, s[start..i])
        }
    }
    out
}

/// Splits `s` into lines at `\n` and removes a `\r` before each `\n`.
/// A final line without a newline is included, but an empty piece after a trailing newline is not, so `a\n` gives one line. A `\r` that ends the last line is also removed. Empty lines in the middle are kept.
pub fn lines(s: str) -> []str {
    var out: []str = []
    var start = 0
    for i in 0..s.len {
        if s[i] == '\n' {
            push(mut out, trim_suffix(s[start..i], "\r"))
            start = i + 1
        }
    }
    if start < s.len {
        push(mut out, trim_suffix(s[start..], "\r"))
    }
    out
}

/// Returns `s` repeated `n` times. `n` of `0` or below gives an empty string.
pub fn repeat(s: str, n: i64) -> str {
    var out: []u8 = []
    for i in 0..n {
        append(mut out, s)
    }
    __str_view(out)
}

/// Returns `s` with every non-overlapping occurrence of `old` replaced by `new`.
/// Returns `s` unchanged when `old` is empty.
pub fn replace(s: str, old: str, new: str) -> str {
    if old.len == 0 {
        return s
    }
    split_str(s, old) |> join(new)
}

/// Returns the number of code points in `s`.
/// A byte that is not part of a valid UTF-8 sequence counts as one.
pub fn char_count(s: str) -> i64 {
    var n = 0
    for c in s {
        n += 1
    }
    n
}

/// Returns the UTF-8 encoding of the code point `c` as a string.
pub fn from_char(c: u32) -> str {
    var out: []u8 = []
    append_char(mut out, c)
    __str_view(out)
}

/// Returns `s` padded on the left with the code point `fill` until it is `width` code points wide.
/// Widths count code points, not bytes or display columns. A string already `width` or wider is returned as it is.
pub fn pad_left(s: str, width: i64, fill: u32) -> str {
    var out: []u8 = []
    for i in char_count(s)..width {
        append_char(mut out, fill)
    }
    append(mut out, s)
    __str_view(out)
}

/// Returns `s` padded on the right with the code point `fill` until it is `width` code points wide.
/// Widths count code points, not bytes or display columns. A string already `width` or wider is returned as it is.
pub fn pad_right(s: str, width: i64, fill: u32) -> str {
    var out: []u8 = []
    append(mut out, s)
    for i in char_count(s)..width {
        append_char(mut out, fill)
    }
    __str_view(out)
}

/// Returns the strings in `parts` joined with `sep` between them.
/// An empty `parts` gives an empty string.
pub fn join(parts: []str, sep: str) -> str {
    var out: []u8 = []
    for i, p in parts {
        if i > 0 {
            append(mut out, sep)
        }
        append(mut out, p)
    }
    __str_view(out)
}

/// A place in a text, counted from 1.
pub struct Position {
    /// The line, which a `\n` ends.
    pub line: i64
    /// The byte offset from the start of the line, plus 1.
    pub column: i64
}

/// Returns the line and column of the byte offset `at` in `s`.
/// An offset beyond the end of `s` is taken as the end.
pub fn position(s: str, at: i64) -> Position {
    let end = if at < s.len { at } else { s.len }
    var line = 1
    var start = 0
    for i in 0..end {
        if s[i] == '\n' {
            line += 1
            start = i + 1
        }
    }
    Position { line, column: at - start + 1 }
}

/// Appends the bytes of `s` to `out`.
pub fn append(mut out: []u8, s: str) {
    __extend(mut out, s)
}

/// Appends the UTF-8 encoding of the code point `c` to `out`.
/// The value is not validated: surrogates are encoded as they stand, and a value above `0x1FFFFF` gives a malformed sequence.
pub fn append_char(mut out: []u8, c: u32) {
    let at = out.len
    for _ in 0..char_len(c) {
        push(mut out, 0)
    }
    put_char(out, at, c)
}

/// Returns the length in bytes of the UTF-8 sequence that begins with the byte `lead`, from `1` to `4`.
/// An ASCII byte or a continuation byte gives `1`.
pub fn lead_len(lead: u8) -> i64 {
    match lead {
        >= 0xF0 => 4
        >= 0xE0 => 3
        >= 0xC0 => 2
        _ => 1
    }
}

/// Returns the number of bytes the UTF-8 encoding of `c` takes, from `1` to `4`.
/// The value is not validated: a surrogate takes `3` bytes and a value from `0x10000` up takes `4`.
pub fn char_len(c: u32) -> i64 {
    match c {
        < 0x80 => 1
        < 0x800 => 2
        < 0x10000 => 3
        _ => 4
    }
}

/// Writes the UTF-8 encoding of the code point `c` into `out` starting at index `at`.
/// `out` must hold `char_len(c)` bytes from `at`. The value is not validated, as for `append_char`.
pub fn put_char(out: []u8, at: i64, c: u32) {
    let size = char_len(c)
    if size == 1 {
        out[at] = u8(c)
        return
    }
    let lead: u32 = 0xFF00 >> size & 0xFF
    out[at] = u8(lead | (c >> (6 * (size - 1))))
    for k in 1..size {
        out[at + k] = u8(0x80 | ((c >> (6 * (size - 1 - k))) & 0x3F))
    }
}

/// Returns whether the comma-separated `list` contains `token`.
/// Each item is trimmed of ASCII whitespace and compared without regard to ASCII case, as for the value of an HTTP header such as `Connection`.
pub fn has_token(list: str, token: str) -> bool {
    split(list, ',').any(fn(part) equal_fold(trim(part), token))
}

/// Returns the bytes of `data` as lowercase hexadecimal, two digits per byte.
pub fn encode_hex(data: []u8) -> str {
    let out: []u8 = __make(2 * data.len)
    for i, b in data {
        out[2 * i] = digit_char(i64(b >> 4))
        out[2 * i + 1] = digit_char(i64(b & 0xF))
    }
    __str_view(out)
}

/// Decodes a hexadecimal string into bytes, accepting upper- and lowercase digits.
/// Fails with `BadDigit` at the index of the start of the first pair that holds a non-hex digit, and at `s.len` when the length is odd. An empty string gives empty data.
pub fn decode_hex(s: str) -> []u8 ! ParseError {
    if s.len % 2 != 0 {
        fail BadDigit(s.len)
    }
    let out: []u8 = __make(s.len / 2)
    for i in 0..out.len {
        let high = digit(s[2 * i], 16)
        let low = digit(s[2 * i + 1], 16)
        if high < 0 || low < 0 {
            fail BadDigit(2 * i)
        }
        out[i] = u8(high << 4 | low)
    }
    out
}
