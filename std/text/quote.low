/// Why unquoting a string failed.
pub enum QuoteError {
    /// The input does not start and end with a double quote, or has an unescaped double quote between them.
    NotQuoted
    /// An escape sequence is unknown, incomplete or has a non-hex digit. `at` is the index of the backslash, or of the bad digit.
    BadEscape(at: i64)
    /// A `\u` or `\U` escape names a surrogate or a value above `0x10FFFF`. `at` is the index of the backslash.
    BadCodePoint(at: i64)
}

fn append_escaped_byte(mut out: []u8, c: u8) {
    append(mut out, "\\x")
    append_hex(mut out, i64(c), 2, false)
}

fn append_quoted_byte(mut out: []u8, c: u8) {
    match c {
        == '"' => append(mut out, "\\\"")
        == '\\' => append(mut out, "\\\\")
        == '\n' => append(mut out, "\\n")
        == '\t' => append(mut out, "\\t")
        == '\r' => append(mut out, "\\r")
        < 0x20 => append_escaped_byte(mut out, c)
        == 0x7F => append_escaped_byte(mut out, c)
        _ => push(mut out, c)
    }
}

/// Returns `s` as a double-quoted literal.
/// `"` and `\` are backslash-escaped, newline, tab and carriage return become `\n`, `\t` and `\r`, and other control bytes below `0x20` and `0x7F` become `\xNN`. Valid multi-byte UTF-8 is kept as it is and a byte that is not part of a valid sequence becomes `\xNN`, so `unquote` restores the original bytes.
pub fn quote(s: str) -> str {
    var out: []u8 = []
    push(mut out, '"')
    for piece in chars(s) {
        if piece.len > 1 {
            append(mut out, piece)
        } else if piece[0] >= 0x80 {
            append_escaped_byte(mut out, piece[0])
        } else {
            append_quoted_byte(mut out, piece[0])
        }
    }
    push(mut out, '"')
    __str_view(out)
}

fn append_unit(mut out: []u8, unit: u32) {
    append(mut out, "\\u")
    append_hex(mut out, i64(unit), 4, false)
}

/// Returns `s` as a double-quoted literal that is printable ASCII.
/// `"` and `\` are backslash-escaped and every character outside `0x20` to `0x7E` is written as `\uXXXX` in lowercase hexadecimal, with a surrogate pair for a character above `U+FFFF`.
pub fn quote_ascii(s: str) -> str {
    var out: []u8 = []
    push(mut out, '"')
    for c in s {
        if c == '"' || c == '\\' {
            push(mut out, '\\')
            push(mut out, u8(c))
        } else if c >= 0x20 && c < 0x7F {
            push(mut out, u8(c))
        } else if c >= 0x10000 {
            let v = c - 0x10000
            append_unit(mut out, 0xD800 + (v >> 10))
            append_unit(mut out, 0xDC00 + (v & 0x3FF))
        } else {
            append_unit(mut out, c)
        }
    }
    push(mut out, '"')
    __str_view(out)
}

fn simple_escape(c: u8) -> i64 {
    match c {
        == 'n' => 10
        == 't' => 9
        == 'r' => 13
        == 'a' => 7
        == 'b' => 8
        == 'f' => 12
        == 'v' => 11
        == '\\' => 92
        == '"' => 34
        == '\'' => 39
        _ => -1
    }
}

fn hex_value(s: str, at: i64, width: i64) -> i64 ! QuoteError {
    if at + width > s.len {
        fail BadEscape(at)
    }
    parse_hex_at(s, at, width) catch {
        BadDigit(i) => fail BadEscape(i)
        _ => fail BadEscape(at)
    }
}

/// Parses a double-quoted literal and returns the string it denotes.
/// The escapes are `\n`, `\t`, `\r`, `\a`, `\b`, `\f`, `\v`, `\\`, `\"`, `\'`, `\xNN` for one byte, `\uNNNN` and `\UNNNNNNNN` for a code point. All other bytes are copied as they stand.
///
/// Fails with `NotQuoted` when the quotes are missing or a bare `"` occurs inside, with `BadEscape` for an unknown or truncated escape, and with `BadCodePoint` for a `\u` or `\U` escape that is a surrogate or above `0x10FFFF`.
pub fn unquote(s: str) -> str ! QuoteError {
    if s.len < 2 || s[0] != '"' || s[s.len - 1] != '"' {
        fail NotQuoted
    }
    let end = s.len - 1
    var out: []u8 = []
    var i = 1
    for i < end {
        let c = s[i]
        if c == '"' {
            fail NotQuoted
        }
        if c != '\\' {
            push(mut out, c)
            i += 1
            continue
        }
        if i + 1 >= end {
            fail BadEscape(i)
        }
        let kind = s[i + 1]
        let simple = simple_escape(kind)
        if simple >= 0 {
            push(mut out, u8(simple))
            i += 2
        } else if kind == 'x' {
            push(mut out, u8(hex_value(s[..end], i + 2, 2)?))
            i += 4
        } else if kind == 'u' || kind == 'U' {
            let width = if kind == 'u' { 4 } else { 8 }
            let code = hex_value(s[..end], i + 2, width)?
            if !is_scalar(u32(code)) {
                fail BadCodePoint(i)
            }
            append_char(mut out, u32(code))
            i += 2 + width
        } else {
            fail BadEscape(i)
        }
    }
    __str_view(out)
}
