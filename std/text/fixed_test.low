import std/math
import std/testing

struct FixedCase {
    value: f64
    places: i64
    want: str
}

struct DecimalCase {
    value: f64
    want: str
}

fn fixed_name(c: FixedCase) -> str {
    "{float_decimal(c.value)} to {c.places}"
}

fn decimal_name(c: DecimalCase) -> str {
    c.want
}

fn test_fixed(t: *testing.T) {
    let cases = [
        FixedCase { value: 1.0, places: 2, want: "1.00" }
        FixedCase { value: 0.0, places: 2, want: "0.00" }
        FixedCase { value: 0.0, places: 0, want: "0" }
        FixedCase { value: 3.14159, places: 3, want: "3.142" }
        FixedCase { value: 3.14159, places: 0, want: "3" }
        FixedCase { value: 123456.789, places: 1, want: "123456.8" }
        FixedCase { value: 99.999, places: 2, want: "100.00" }
        FixedCase { value: 9.995, places: 2, want: "9.99" }
        FixedCase { value: 0.5, places: 0, want: "0" }
        FixedCase { value: 1.5, places: 0, want: "2" }
        FixedCase { value: 2.5, places: 0, want: "2" }
        FixedCase { value: 3.5, places: 0, want: "4" }
        FixedCase { value: 0.125, places: 2, want: "0.12" }
        FixedCase { value: 0.375, places: 2, want: "0.38" }
        FixedCase { value: 0.1, places: 1, want: "0.1" }
        FixedCase { value: 0.1, places: 20, want: "0.10000000000000000555" }
        FixedCase { value: 1.0, places: 5, want: "1.00000" }
        FixedCase { value: 1e21, places: 0, want: "1000000000000000000000" }
        FixedCase { value: 12345.0, places: 3, want: "12345.000" }
        FixedCase { value: 5e-324, places: 3, want: "0.000" }
        FixedCase { value: 0.001, places: 2, want: "0.00" }
        FixedCase { value: 0.006, places: 2, want: "0.01" }
        FixedCase { value: -1.5, places: 1, want: "-1.5" }
        FixedCase { value: -1.5, places: 0, want: "-2" }
        FixedCase { value: -2.5, places: 0, want: "-2" }
        FixedCase { value: -0.001, places: 2, want: "-0.00" }
        FixedCase { value: -0.0, places: 2, want: "-0.00" }
        FixedCase { value: -123.456, places: 2, want: "-123.46" }
    ]
    t.table_of(cases, fixed_name, fn(st, c) {
        st.equal(fixed(c.value, c.places), c.want)
    })
}

fn test_fixed_non_finite(t: *testing.T) {
    t.equal(fixed(math.nan, 2), "NaN")
    t.equal(fixed(math.infinity, 2), "inf")
    t.equal(fixed(-math.infinity, 2), "-inf")
    t.equal(fixed(math.nan, 0), "NaN")
    t.equal(fixed(math.infinity, 0), "inf")
}

fn test_fixed_places_match_the_requested_width(t: *testing.T) {
    let values = [0.0, 0.5, 1.0, 12.3456, 1e10, 7.0 / 3.0]
    for value in values {
        for places in [1, 2, 5] {
            let written = fixed(value, places)
            let point = index_byte(written, '.')
            t.equal(written.len - point - 1, places)
        }
    }
}

fn test_float_decimal(t: *testing.T) {
    let cases = [
        DecimalCase { value: 2.0, want: "2.0" }
        DecimalCase { value: 0.0, want: "0.0" }
        DecimalCase { value: 0.5, want: "0.5" }
        DecimalCase { value: -3.0, want: "-3.0" }
        DecimalCase { value: 123.25, want: "123.25" }
        DecimalCase { value: 1e30, want: "1.0e+30" }
        DecimalCase { value: 1.5e30, want: "1.5e+30" }
    ]
    t.table_of(cases, decimal_name, fn(st, c) {
        st.equal(float_decimal(c.value), c.want)
    })
}

fn test_float_decimal_non_finite(t: *testing.T) {
    t.equal(float_decimal(math.infinity), "inf")
    t.equal(float_decimal(-math.infinity), "-inf")
    t.equal(float_decimal(math.nan), "NaN")
}

fn test_float_decimal_reads_back(t: *testing.T) {
    let values = [0.0, 1.0, -2.0, 0.1, 1e30, 1.5e-7, 123456789.0]
    for value in values {
        let written = float_decimal(value)
        let back = parse_float(written) catch { e => t.unexpected(e, 0.0) }
        t.equal(back, value)
    }
}
