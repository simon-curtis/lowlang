import std/text

fn column_block(rows: [][]str, widths: [][]i64, column: i64, from: i64, to: i64, gap: i64) {
    var line = from
    for line < to {
        if column >= rows[line].len - 1 {
            line += 1
            continue
        }
        let start = line
        var most = 0
        for line < to && column < rows[line].len - 1 {
            let w = width(rows[line][column]) + gap
            if w > most {
                most = w
            }
            line += 1
        }
        for i in start..line {
            widths[i][column] = most
        }
        column_block(rows, widths, column + 1, start, line, gap)
    }
}

fn zero_widths(rows: [][]str) -> [][]i64 {
    var out: [][]i64 = []
    for row in rows {
        let w: []i64 = __make(row.len)
        push(mut out, w)
    }
    out
}

/// Pads the cells of `rows` into columns and returns the lines joined with `\n`.
/// `gap` is the number of blank columns between a column and the next. A cell is padded to the width of the widest cell above or below it in the same column, measured by `cell.width`, so wide characters and ANSI escape sequences align. A block of consecutive rows share a column width only while each has another cell after it, and the last cell of a row is not padded, so lines carry no trailing blanks. Rows may have different numbers of cells.
pub fn align(rows: [][]str, gap: i64) -> str {
    let widths = zero_widths(rows)
    column_block(rows, widths, 0, 0, rows.len, gap)
    var out: []str = []
    for i, row in rows {
        var line: []u8 = []
        for k, cell in row {
            text.append(mut line, cell)
            if k < row.len - 1 {
                text.append(mut line, blanks(widths[i][k] - width(cell)))
            }
        }
        push(mut out, __str_view(line))
    }
    text.join(out, "\n")
}

/// Splits each line of `s` into cells at tabs and aligns them as `align` does with `gap`.
pub fn align_tabbed(s: str, gap: i64) -> str {
    var rows: [][]str = []
    for line in text.lines(s) {
        push(mut rows, text.split(line, '\t'))
    }
    align(rows, gap)
}
