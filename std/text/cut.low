/// The result of splitting a string once at a separator.
pub struct Cut {
    /// The text before the separator, or the whole input when the separator was not found.
    pub before: str
    /// The text after the separator, or an empty string when the separator was not found.
    pub after: str
    /// Whether the separator was found.
    pub found: bool
}

/// Splits `s` at the first occurrence of `sep`.
/// When `sep` is not found the result has `before` set to `s`, an empty `after` and `found` set to `false`. An empty `sep` is found at index `0`. Both parts are slices of `s`.
pub fn cut(s: str, sep: str) -> Cut {
    let at = index(s, sep)
    if at < 0 {
        return Cut { before: s, after: "", found: false }
    }
    Cut { before: s[..at], after: s[at + sep.len..], found: true }
}

/// Splits `s` at the last occurrence of `sep`.
/// When `sep` is not found the result has `before` set to `s`, an empty `after` and `found` set to `false`. An empty `sep` is found at the end of `s`. Both parts are slices of `s`.
pub fn last_cut(s: str, sep: str) -> Cut {
    let at = last_index(s, sep)
    if at < 0 {
        return Cut { before: s, after: "", found: false }
    }
    Cut { before: s[..at], after: s[at + sep.len..], found: true }
}

/// Returns `s` without its leading `prefix`, or `none` when `s` does not begin with it.
pub fn strip_prefix(s: str, prefix: str) -> str? {
    if starts_with(s, prefix) {
        return s[prefix.len..]
    }
    none
}

/// Returns `s` without its trailing `suffix`, or `none` when `s` does not end with it.
pub fn strip_suffix(s: str, suffix: str) -> str? {
    if ends_with(s, suffix) {
        return s[..s.len - suffix.len]
    }
    none
}

/// Splits `s` around `sep` into at most `n` pieces.
/// The last piece holds the unsplit rest of `s`. `n` of `0` gives an empty slice and a negative `n` splits at every occurrence. An empty `sep` splits into code points, with the last piece holding the rest.
pub fn split_n(s: str, sep: str, n: i64) -> []str {
    if n == 0 {
        return []
    }
    if sep.len == 0 {
        return split_chars_n(s, n)
    }
    var parts: []str = []
    var from = 0
    for n < 0 || parts.len < n - 1 {
        let at = index(s[from..], sep)
        if at < 0 {
            break
        }
        push(mut parts, s[from..from + at])
        from += at + sep.len
    }
    push(mut parts, s[from..])
    parts
}

fn split_chars_n(s: str, n: i64) -> []str {
    let all = chars(s)
    if n < 0 || all.len <= n {
        return all
    }
    var parts: []str = []
    var offset = 0
    for i in 0..n - 1 {
        push(mut parts, all[i])
        offset += all[i].len
    }
    push(mut parts, s[offset..])
    parts
}
