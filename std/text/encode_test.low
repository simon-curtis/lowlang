import std/testing

struct LengthCase {
    point: u32
    want: i64
}

fn length_name(c: LengthCase) -> str {
    "{c.point}"
}

fn test_char_len(t: *testing.T) {
    let cases = [
        LengthCase { point: 0x00, want: 1 }
        LengthCase { point: 0x7F, want: 1 }
        LengthCase { point: 0x80, want: 2 }
        LengthCase { point: 0x7FF, want: 2 }
        LengthCase { point: 0x800, want: 3 }
        LengthCase { point: 0xFFFF, want: 3 }
        LengthCase { point: 0x10000, want: 4 }
    ]
    t.table_of(cases, length_name, fn(st, c) {
        st.equal(char_len(c.point), c.want)
    })
}

fn test_append(t: *testing.T) {
    var out: u8[] = []
    append(mut out, "x = ")
    append_char(mut out, 'λ')
    t.equal(str(out), "x = λ")
}

fn test_append_char_encodes_each_length(t: *testing.T) {
    var out: u8[] = []
    let points: u32[] = [0x41, 0xE9, 0x20AC, 0x1F600]
    for c in points {
        append_char(mut out, c)
    }
    t.equal(encode_hex(out), "41c3a9e282acf09f9880")
}

fn test_from_char(t: *testing.T) {
    t.equal(from_char(0x1F600), "😀")
}
