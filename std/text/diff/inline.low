import std/text
import std/unicode

/// A run of text in an inline diff, all inserted, all deleted or unchanged.
pub struct Span {
    /// Whether the text is unchanged, deleted or inserted.
    pub op: Op
    /// The text of the run.
    pub text: str
}

fn word_code(c: u32) -> bool {
    unicode.is_alphanumeric(c) || unicode.is_mark(c) || c == '_'
}

fn class_of(c: u32) -> i64 {
    if word_code(c) {
        return 1
    }
    if unicode.is_space(c) {
        return 2
    }
    0
}

/// Splits `s` into the tokens that `inline` compares.
/// A token is a run of letters, digits, marks and `_`, a run of whitespace, or a single other character. Joining the tokens gives `s` back.
pub fn words(s: str) -> []str {
    var out: []str = []
    var start = 0
    var last = -1
    for i, c in s {
        let class = class_of(c)
        if i > 0 && (class == 0 || class != last) {
            push(mut out, s[start..i])
            start = i
        }
        last = class
    }
    if start < s.len {
        push(mut out, s[start..])
    }
    out
}

fn spans_of(before: []str, after: []str) -> []Span {
    let edits = diff_rows(before, after)
    var out: []Span = []
    for e in edits {
        let piece = if e.op == Insert { after[e.new_at] } else { before[e.old_at] }
        if out.len > 0 && out[out.len - 1].op == e.op {
            out[out.len - 1].text = "{out[out.len - 1].text}{piece}"
        } else {
            push(mut out, Span { op: e.op, text: piece })
        }
    }
    out
}

/// Returns a word-level diff of `before` and `after` as a list of spans.
/// Neighbouring tokens with the same operation, as split by `words`, are merged into one span. Unchanged and deleted text comes from `before` and inserted text from `after`.
pub fn inline(before: str, after: str) -> []Span {
    spans_of(words(before), words(after))
}

/// Returns a diff of `before` and `after` over grapheme clusters as a list of spans.
/// Spans are merged as for `inline`.
pub fn inline_chars(before: str, after: str) -> []Span {
    spans_of(unicode.graphemes(before), unicode.graphemes(after))
}

/// Renders `spans` as a single string, wrapping each deleted span in `delete_open` and `delete_close` and each inserted span in `insert_open` and `insert_close`.
/// Unchanged text is copied as it is.
pub fn inline_with(spans: []Span, delete_open: str, delete_close: str, insert_open: str, insert_close: str) -> str {
    var out: []u8 = []
    for span in spans {
        match span.op {
            Equal => text.append(mut out, span.text)
            Delete => {
                text.append(mut out, delete_open)
                text.append(mut out, span.text)
                text.append(mut out, delete_close)
            }
            Insert => {
                text.append(mut out, insert_open)
                text.append(mut out, span.text)
                text.append(mut out, insert_close)
            }
        }
    }
    __str_view(out)
}

/// Renders `spans` with deleted text as `[-deleted-]` and inserted text as `{+inserted+}`.
pub fn inline_markup(spans: []Span) -> str {
    inline_with(spans, "[-", "-]", "{{+", "+}}")
}
