import std/text/diff

/// Compares two versions of a configuration file as a unified diff, applies the diff back to the old version, and marks a word-level change in a sentence.
fn main() {
    let before = "name = low\nport = 8080\nhost = localhost\nlog = info\ntimeout = 30\nretries = 3\nregion = eu\n"
    let after = "name = low\nport = 9090\nhost = localhost\nlog = info\ntimeout = 30\nretries = 5\nregion = eu\ncache = on\n"

    let stats = diff.stats(before, after)
    print("added {stats.added}, removed {stats.removed}, unchanged {stats.unchanged}")
    print("similarity {diff.similarity(before, after):f2}")

    let patch = diff.unified(before, after, 1, "old.conf", "new.conf")
    print(patch)

    let rebuilt = diff.patch(before, patch) catch {
        Malformed(line) => "malformed at {line}"
        Mismatch(hunk) => "hunk {hunk} does not apply"
    }
    print("patch reproduces the new file: {rebuilt == after}")

    let stale = diff.patch("name = other\n", patch) catch {
        Malformed(line) => "malformed at {line}"
        Mismatch(hunk) => "hunk {hunk} does not apply"
    }
    print(stale)

    let spans = diff.inline("the quick brown fox", "the slow brown cat")
    print(diff.inline_markup(spans))
    print(diff.inline_with(spans, "<del>", "</del>", "<ins>", "</ins>"))
}
