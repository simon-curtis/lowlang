import std/maps
import std/text

struct Hit {
    method: str,
    path: str,
    status: i64,
    bytes: i64,
}

fn parse(line: str) -> Hit ! text.ParseError {
    let fields = text.fields(line)
    let target = text.cut(fields[1], "?")
    let status = text.parse_int(fields[2])?
    let size = if fields[3] == "-" { 0 } else { text.parse_int(fields[3])? }
    Hit { method: fields[0], path: target.before, status, bytes: size }
}

/// Parses access log lines into records, counts them by status class and prints an aligned report, naming the position of a malformed line.
fn main() {
    let log = "GET /index?ref=news 200 5120\nGET /about 200 2048\nPOST /api/items 201 310\nGET /missing 404 -\nGET /api/items 5x0 12\nGET /old 301 0\n"

    var classes: [str: i64] = [:]
    var total = 0
    for line in text.lines(log) {
        let hit = parse(line) catch {
            BadDigit(at) => {
                let p = text.position(log, text.index(log, line))
                print("line {p.line}: bad status digit at byte {at}")
                continue
            }
            e => {
                print("line skipped: {e}")
                continue
            }
        }
        let class = "{hit.status / 100}xx"
        classes[class] = (classes[class] ?? 0) + 1
        total += hit.bytes
        let verb = text.pad_right(hit.method, 5, ' ')
        let target = text.pad_right(hit.path, 12, '.')
        let size = text.pad_left("{hit.bytes}", 6, ' ')
        print("{verb}{target}{size}")
    }

    for class in maps.sorted_keys(classes) {
        print("{class}: {classes[class] ?? 0}")
    }
    print("transferred {total} bytes")
}
