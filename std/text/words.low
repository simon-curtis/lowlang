fn word_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '\'' || c >= 0x80
}

/// Returns `s` with the first letter of each word uppercased.
/// A word starts after any byte that is not an ASCII letter, a digit, `'` or part of a multi-byte character, so `o'neil` gives `O'neil` and `a-b` gives `A-B`. Only ASCII letters change, and the other letters of a word are left as they are, not lowercased.
pub fn title(s: str) -> str {
    var out: []u8 = []
    var inside = false
    for i in 0..s.len {
        let c = s[i]
        if inside {
            push(mut out, c)
        } else {
            push(mut out, upper_byte(c))
        }
        inside = word_byte(c)
    }
    __str_view(out)
}

fn wrap_line(line: str, width: i64) -> []str {
    var rows: []str = []
    var row: []u8 = []
    var row_width = 0
    for word in fields(line) {
        let w = char_count(word)
        if row.len > 0 && row_width + 1 + w > width {
            push(mut rows, __str_view(row))
            row = []
            row_width = 0
        }
        if row.len > 0 {
            push(mut row, ' ')
            row_width += 1
        }
        append(mut row, word)
        row_width += w
    }
    if row.len > 0 || rows.len == 0 {
        push(mut rows, __str_view(row))
    }
    rows
}

/// Wraps `s` so that no line is wider than `width` code points where possible.
/// Each line of `s` is wrapped on its own: words are separated by ASCII whitespace, runs of whitespace become a single space, and leading and trailing whitespace is dropped. A word wider than `width` stays whole on a line of its own. Empty lines are kept. The lines are joined with `\n` with no trailing newline.
pub fn wrap(s: str, width: i64) -> str {
    var rows: []str = []
    for line in lines(s) {
        for row in wrap_line(line, width) {
            push(mut rows, row)
        }
    }
    join(rows, "\n")
}

fn code_points(s: str) -> []u32 {
    var out: []u32 = []
    for c in s {
        push(mut out, c)
    }
    out
}

fn least(a: i64, b: i64, c: i64) -> i64 {
    var m = a
    if b < m {
        m = b
    }
    if c < m {
        m = c
    }
    m
}

/// Returns the Levenshtein distance between `a` and `b` over code points.
/// Insertion, deletion and substitution of one code point each cost `1`. Time is proportional to the product of the two lengths.
pub fn edit_distance(a: str, b: str) -> i64 {
    let x = code_points(a)
    let y = code_points(b)
    var previous: []i64 = []
    for j in 0..y.len + 1 {
        push(mut previous, j)
    }
    for i in 1..x.len + 1 {
        var current: []i64 = [i]
        for j in 1..y.len + 1 {
            var cost = 1
            if x[i - 1] == y[j - 1] {
                cost = 0
            }
            push(mut current, least(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + cost))
        }
        previous = current
    }
    previous[y.len]
}

/// Returns whether every byte of `s` is below `0x80`. An empty string is ASCII.
pub fn is_ascii(s: str) -> bool {
    for i in 0..s.len {
        if s[i] >= 0x80 {
            return false
        }
    }
    true
}

/// Returns `s` with its code points in reverse order.
/// Combining marks and other grapheme clusters are not kept together. A byte that is not part of a valid UTF-8 sequence is moved as a unit of its own.
pub fn reverse(s: str) -> str {
    let pieces = chars(s)
    var out: []u8 = []
    var i = pieces.len - 1
    for i >= 0 {
        append(mut out, pieces[i])
        i -= 1
    }
    __str_view(out)
}
