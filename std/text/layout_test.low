import std/testing

struct JoinCase {
    parts: []str
    sep: str
    want: str
}

struct PadCase {
    input: str
    width: i64
    left: str
    right: str
}

struct PositionCase {
    input: str
    at: i64
    line: i64
    column: i64
}

struct WrapCase {
    input: str
    width: i64
    want: str
}

fn join_name(c: JoinCase) -> str {
    "{quote(join(c.parts, "|"))} with {quote(c.sep)}"
}

fn pad_name(c: PadCase) -> str {
    "{quote(c.input)} to {c.width}"
}

fn position_name(c: PositionCase) -> str {
    "{quote(c.input)} at {c.at}"
}

fn wrap_name(c: WrapCase) -> str {
    "{quote(c.input)} in {c.width}"
}

fn test_join(t: *testing.T) {
    let cases = [
        JoinCase { parts: [], sep: ",", want: "" }
        JoinCase { parts: ["a"], sep: ",", want: "a" }
        JoinCase { parts: ["a", "b", "c"], sep: ",", want: "a,b,c" }
        JoinCase { parts: ["a", "b"], sep: "", want: "ab" }
        JoinCase { parts: ["", ""], sep: ",", want: "," }
        JoinCase { parts: ["a", "", "b"], sep: ", ", want: "a, , b" }
        JoinCase { parts: ["é", "ü"], sep: "→", want: "é→ü" }
    ]
    t.table_of(cases, join_name, fn(st, c) {
        st.equal(join(c.parts, c.sep), c.want)
    })
}

fn test_pad(t: *testing.T) {
    let cases = [
        PadCase { input: "7", width: 3, left: "007", right: "700" }
        PadCase { input: "", width: 2, left: "00", right: "00" }
        PadCase { input: "abc", width: 3, left: "abc", right: "abc" }
        PadCase { input: "abcd", width: 3, left: "abcd", right: "abcd" }
        PadCase { input: "a", width: 0, left: "a", right: "a" }
        PadCase { input: "a", width: -2, left: "a", right: "a" }
        PadCase { input: "é", width: 3, left: "00é", right: "é00" }
        PadCase { input: "日本", width: 4, left: "00日本", right: "日本00" }
    ]
    t.table_of(cases, pad_name, fn(st, c) {
        st.equal(pad_left(c.input, c.width, '0'), c.left)
        st.equal(pad_right(c.input, c.width, '0'), c.right)
    })
}

fn test_pad_with_a_wide_fill(t: *testing.T) {
    t.equal(pad_left("a", 3, 0x65E5), "日日a")
    t.equal(pad_right("a", 3, 0x65E5), "a日日")
    t.equal(pad_left("a", 2, 0x1F600), "😀a")
}

fn test_char_count(t: *testing.T) {
    t.equal(char_count(""), 0)
    t.equal(char_count("abc"), 3)
    t.equal(char_count("héllo"), 5)
    t.equal(char_count("日本語"), 3)
    t.equal(char_count("a😀"), 2)
}

fn test_position(t: *testing.T) {
    let cases = [
        PositionCase { input: "", at: 0, line: 1, column: 1 }
        PositionCase { input: "abc", at: 0, line: 1, column: 1 }
        PositionCase { input: "abc", at: 2, line: 1, column: 3 }
        PositionCase { input: "abc", at: 3, line: 1, column: 4 }
        PositionCase { input: "a\nbc", at: 1, line: 1, column: 2 }
        PositionCase { input: "a\nbc", at: 2, line: 2, column: 1 }
        PositionCase { input: "a\nbc", at: 3, line: 2, column: 2 }
        PositionCase { input: "a\nbc", at: 4, line: 2, column: 3 }
        PositionCase { input: "a\n", at: 2, line: 2, column: 1 }
        PositionCase { input: "\n\n\nx", at: 3, line: 4, column: 1 }
        PositionCase { input: "a\r\nb", at: 3, line: 2, column: 1 }
    ]
    t.table_of(cases, position_name, fn(st, c) {
        let got = position(c.input, c.at)
        st.equal(got.line, c.line)
        st.equal(got.column, c.column)
    })
}

fn test_wrap(t: *testing.T) {
    let cases = [
        WrapCase { input: "", width: 10, want: "" }
        WrapCase { input: "hello", width: 10, want: "hello" }
        WrapCase { input: "aaa bbb ccc", width: 7, want: "aaa bbb\nccc" }
        WrapCase { input: "aaa bbb ccc", width: 11, want: "aaa bbb ccc" }
        WrapCase { input: "aaa bbb ccc", width: 3, want: "aaa\nbbb\nccc" }
        WrapCase { input: "a   b\t c", width: 20, want: "a b c" }
        WrapCase { input: "  lead and trail  ", width: 20, want: "lead and trail" }
        WrapCase { input: "toolongword x", width: 4, want: "toolongword\nx" }
        WrapCase { input: "one\n\ntwo", width: 20, want: "one\n\ntwo" }
        WrapCase { input: "one two\nthree four", width: 7, want: "one two\nthree\nfour" }
        WrapCase { input: "ééé ééé", width: 3, want: "ééé\nééé" }
    ]
    t.table_of(cases, wrap_name, fn(st, c) {
        st.equal(wrap(c.input, c.width), c.want)
    })
}
