import std/testing

struct SplitByteCase {
    input: str
    sep: u8
    want: []str
}

struct SplitStrCase {
    input: str
    sep: str
    want: []str
}

struct SplitLimitCase {
    input: str
    sep: str
    limit: i64
    want: []str
}

struct PiecesCase {
    input: str
    want: []str
}

fn split_byte_name(c: SplitByteCase) -> str {
    "{quote(c.input)} on {quote(from_char(u32(c.sep)))}"
}

fn split_str_name(c: SplitStrCase) -> str {
    "{quote(c.input)} on {quote(c.sep)}"
}

fn split_limit_name(c: SplitLimitCase) -> str {
    "{quote(c.input)} on {quote(c.sep)} limit {c.limit}"
}

fn pieces_name(c: PiecesCase) -> str {
    quote(c.input)
}

fn test_split(t: *testing.T) {
    let cases = [
        SplitByteCase { input: "", sep: ',', want: [""] }
        SplitByteCase { input: "a", sep: ',', want: ["a"] }
        SplitByteCase { input: "a,b,c", sep: ',', want: ["a", "b", "c"] }
        SplitByteCase { input: ",", sep: ',', want: ["", ""] }
        SplitByteCase { input: "a,,b", sep: ',', want: ["a", "", "b"] }
        SplitByteCase { input: "a,", sep: ',', want: ["a", ""] }
        SplitByteCase { input: ",a", sep: ',', want: ["", "a"] }
        SplitByteCase { input: ",,,", sep: ',', want: ["", "", "", ""] }
        SplitByteCase { input: "a/b/c", sep: '/', want: ["a", "b", "c"] }
        SplitByteCase { input: "a,b", sep: ';', want: ["a,b"] }
        SplitByteCase { input: "é,ü", sep: ',', want: ["é", "ü"] }
    ]
    t.table_of(cases, split_byte_name, fn(st, c) {
        st.equal_slice(split(c.input, c.sep), c.want)
    })
}

fn test_split_str(t: *testing.T) {
    let cases = [
        SplitStrCase { input: "", sep: ",", want: [""] }
        SplitStrCase { input: "a, b, c", sep: ", ", want: ["a", "b", "c"] }
        SplitStrCase { input: "abc", sep: "", want: ["a", "b", "c"] }
        SplitStrCase { input: "", sep: "", want: [] }
        SplitStrCase { input: "héy", sep: "", want: ["h", "é", "y"] }
        SplitStrCase { input: "aaa", sep: "aa", want: ["", "a"] }
        SplitStrCase { input: "abc", sep: "abc", want: ["", ""] }
        SplitStrCase { input: "a--b-c", sep: "--", want: ["a", "b-c"] }
        SplitStrCase { input: "--", sep: "--", want: ["", ""] }
        SplitStrCase { input: "a,b", sep: ",,", want: ["a,b"] }
        SplitStrCase { input: "a,b", sep: ",", want: ["a", "b"] }
        SplitStrCase { input: "x", sep: "xyz", want: ["x"] }
    ]
    t.table_of(cases, split_str_name, fn(st, c) {
        st.equal_slice(split_str(c.input, c.sep), c.want)
    })
}

fn test_split_n(t: *testing.T) {
    let cases = [
        SplitLimitCase { input: "a,b,c,d", sep: ",", limit: 2, want: ["a", "b,c,d"] }
        SplitLimitCase { input: "a,b,c,d", sep: ",", limit: 1, want: ["a,b,c,d"] }
        SplitLimitCase { input: "a,b,c,d", sep: ",", limit: 0, want: [] }
        SplitLimitCase { input: "a,b,c,d", sep: ",", limit: -1, want: ["a", "b", "c", "d"] }
        SplitLimitCase { input: "a,b,c,d", sep: ",", limit: 4, want: ["a", "b", "c", "d"] }
        SplitLimitCase { input: "a,b,c,d", sep: ",", limit: 9, want: ["a", "b", "c", "d"] }
        SplitLimitCase { input: "a,b", sep: ",", limit: 3, want: ["a", "b"] }
        SplitLimitCase { input: "", sep: ",", limit: 3, want: [""] }
        SplitLimitCase { input: "a,,b", sep: ",", limit: 2, want: ["a", ",b"] }
        SplitLimitCase { input: "a::b::c", sep: "::", limit: 2, want: ["a", "b::c"] }
        SplitLimitCase { input: "abc", sep: "", limit: 2, want: ["a", "bc"] }
        SplitLimitCase { input: "abc", sep: "", limit: 1, want: ["abc"] }
        SplitLimitCase { input: "abc", sep: "", limit: -1, want: ["a", "b", "c"] }
        SplitLimitCase { input: "abc", sep: "", limit: 5, want: ["a", "b", "c"] }
        SplitLimitCase { input: "héy", sep: "", limit: 2, want: ["h", "éy"] }
        SplitLimitCase { input: "abc", sep: "", limit: 0, want: [] }
    ]
    t.table_of(cases, split_limit_name, fn(st, c) {
        st.equal_slice(split_n(c.input, c.sep, c.limit), c.want)
    })
}

fn test_chars(t: *testing.T) {
    let cases = [
        PiecesCase { input: "", want: [] }
        PiecesCase { input: "a", want: ["a"] }
        PiecesCase { input: "abc", want: ["a", "b", "c"] }
        PiecesCase { input: "héy", want: ["h", "é", "y"] }
        PiecesCase { input: "日本語", want: ["日", "本", "語"] }
        PiecesCase { input: "a😀b", want: ["a", "😀", "b"] }
    ]
    t.table_of(cases, pieces_name, fn(st, c) {
        st.equal_slice(chars(c.input), c.want)
    })
}

fn test_fields(t: *testing.T) {
    let cases = [
        PiecesCase { input: "", want: [] }
        PiecesCase { input: "   ", want: [] }
        PiecesCase { input: "a", want: ["a"] }
        PiecesCase { input: "a b", want: ["a", "b"] }
        PiecesCase { input: "  a  b  ", want: ["a", "b"] }
        PiecesCase { input: "a\tb\nc\rd", want: ["a", "b", "c", "d"] }
        PiecesCase { input: " \t\r\n a \t\r\n b \t\r\n ", want: ["a", "b"] }
        PiecesCase { input: "one two  three", want: ["one", "two", "three"] }
        PiecesCase { input: raw([0x61, 0x0B, 0x62]), want: [raw([0x61, 0x0B, 0x62])] }
        PiecesCase { input: raw([0x0C, 0x61]), want: [raw([0x0C, 0x61])] }
    ]
    t.table_of(cases, pieces_name, fn(st, c) {
        st.equal_slice(fields(c.input), c.want)
    })
}

fn test_lines(t: *testing.T) {
    let cases = [
        PiecesCase { input: "", want: [] }
        PiecesCase { input: "\n", want: [""] }
        PiecesCase { input: "a", want: ["a"] }
        PiecesCase { input: "a\n", want: ["a"] }
        PiecesCase { input: "a\nb", want: ["a", "b"] }
        PiecesCase { input: "a\nb\n", want: ["a", "b"] }
        PiecesCase { input: "a\r\nb\r\n", want: ["a", "b"] }
        PiecesCase { input: "a\n\nb", want: ["a", "", "b"] }
        PiecesCase { input: "a\n\n", want: ["a", ""] }
        PiecesCase { input: "\n\n", want: ["", ""] }
        PiecesCase { input: "a\r", want: ["a"] }
        PiecesCase { input: "\r\n", want: [""] }
        PiecesCase { input: "a\rb\n", want: ["a\rb"] }
        PiecesCase { input: "a\r\r\n", want: ["a\r"] }
    ]
    t.table_of(cases, pieces_name, fn(st, c) {
        st.equal_slice(lines(c.input), c.want)
    })
}

fn test_split_then_join_restores_the_input(t: *testing.T) {
    let inputs = ["", "a", "a,b", ",", "a,,b,", ",a"]
    for input in inputs {
        t.equal(join(split(input, ','), ","), input)
        t.equal(join(split_str(input, ","), ","), input)
        t.equal(join(split_n(input, ",", -1), ","), input)
    }
}
