import std/testing

struct TokenCase {
    list: str
    token: str
    want: bool
}

fn token_name(c: TokenCase) -> str {
    "{quote(c.list)} has {quote(c.token)}"
}

fn test_has_token(t: *testing.T) {
    let cases = [
        TokenCase { list: "keep-alive, Upgrade", token: "upgrade", want: true }
        TokenCase { list: "keep-alive, Upgrade", token: "keep-alive", want: true }
        TokenCase { list: "keep-alive, Upgrade", token: "close", want: false }
        TokenCase { list: "keep-alive", token: "keep", want: false }
        TokenCase { list: "", token: "close", want: false }
    ]
    t.table_of(cases, token_name, fn(st, c) {
        st.equal(has_token(c.list, c.token), c.want)
    })
}

fn test_lower_changes_only_ascii_letters(t: *testing.T) {
    t.equal(lower("MiXeD"), "mixed")
    t.equal(lower("ÀB"), "Àb")
}
