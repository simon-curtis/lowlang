import std/text
import std/unicode

/// Options for `slug_with`.
pub struct SlugOptions {
    /// The text placed between words. Defaults to `-`.
    pub separator: str = "-"
    /// The greatest length of the slug in bytes. `0`, the default, means no limit.
    /// Whole words are kept while they fit, and when the first word alone exceeds the limit it is cut at the limit.
    pub max_len: i64 = 0
}

fn expansion(c: u32) -> str {
    match c {
        == 0xDF => "ss"
        == 0xE6 => "ae"
        == 0xC6 => "ae"
        == 0x153 => "oe"
        == 0x152 => "oe"
        == 0xF8 => "o"
        == 0xD8 => "o"
        == 0x111 => "d"
        == 0x110 => "d"
        == 0xF0 => "d"
        == 0xD0 => "d"
        == 0x142 => "l"
        == 0x141 => "l"
        == 0xFE => "th"
        == 0xDE => "th"
        == 0x127 => "h"
        == 0x126 => "h"
        == 0x131 => "i"
        == 0x14B => "ng"
        == 0x14A => "ng"
        == 0x17F => "s"
        == 0x138 => "k"
        _ => ""
    }
}

fn ascii_alnum(c: u32) -> bool {
    (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn skipped(c: u32) -> bool {
    c == '\'' || c == 0x2018 || c == 0x2019 || unicode.is_mark(c)
}

fn slug_words(s: str) -> []str {
    var out: []str = []
    var word: []u8 = []
    for c in unicode.nfkd(s) {
        let extra = expansion(c)
        if skipped(c) {
            continue
        }
        if ascii_alnum(c) {
            text.append_char(mut word, unicode.to_lower(c))
        } else if extra.len > 0 {
            text.append(mut word, extra)
        } else if word.len > 0 {
            push(mut out, __str_view(word))
            word = []
        }
    }
    if word.len > 0 {
        push(mut out, __str_view(word))
    }
    out
}

fn limited(ws: []str, sep: str, max_len: i64) -> str {
    if max_len <= 0 {
        return text.join(ws, sep)
    }
    var kept: []str = []
    var used = 0
    for w in ws {
        let cost = if kept.len == 0 { w.len } else { sep.len + w.len }
        if used + cost > max_len {
            break
        }
        push(mut kept, w)
        used += cost
    }
    if kept.len == 0 && ws.len > 0 {
        return ws[0][..max_len]
    }
    text.join(kept, sep)
}

/// Returns `s` as a lowercase ASCII slug made of its words joined by `o.separator`.
/// The text is decomposed with NFKD and combining marks, apostrophes and quotes inside words are dropped, so `Café` gives `cafe`. Letters with no decomposition are spelled out where there is a convention, such as `ß` as `ss`, `æ` as `ae`, `ø` as `o`, `đ` as `d`, `þ` as `th` and `ŋ` as `ng`. Every other character, including letters of scripts that have no ASCII form, ends the current word, and runs of them do not repeat the separator. Returns an empty string when no ASCII letter or digit remains.
pub fn slug_with(s: str, o: SlugOptions) -> str {
    limited(slug_words(s), o.separator, o.max_len)
}

/// Returns `s` as a lowercase ASCII slug with words joined by `-` and no length limit.
/// Behaves as `slug_with` with default `SlugOptions`.
pub fn slug(s: str) -> str {
    slug_with(s, SlugOptions {})
}
