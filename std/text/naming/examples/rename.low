import std/text/naming

fn convert(name: str) {
    print("{name}: {naming.snake(name)} {naming.kebab(name)} {naming.camel(name)} {naming.pascal(name)} {naming.screaming_snake(name)}")
}

fn convention(name: str) -> str {
    if naming.is_snake(name) {
        return "snake_case"
    }
    if naming.is_camel(name) {
        return "camelCase"
    }
    if naming.is_pascal(name) {
        return "PascalCase"
    }
    if naming.is_screaming_snake(name) {
        return "SCREAMING_SNAKE_CASE"
    }
    if naming.is_kebab(name) {
        return "kebab-case"
    }
    "no convention"
}

/// Converts identifiers between naming conventions, checks which convention a name already follows, and builds URL slugs from titles.
fn main() {
    for name in ["parseHTTPResponse", "user_id", "HTMLParser", "request-timeout", "XMLHttpRequests"] {
        convert(name)
    }

    print(naming.parts("parseHTTPResponse2"))
    print(naming.words("Hello, Wörld! It's 2025"))
    print(naming.title("the_quick-brown fox"))
    print(naming.sentence("SERVER_STARTED_OK"))
    print(naming.dotted("maxOpenConnections"))

    for name in ["max_open", "maxOpen", "MaxOpen", "MAX_OPEN", "max-open", "max__open"] {
        print("{name}: {convention(name)}")
    }

    print(naming.slug("Crème Brûlée & Straße: 10 Tips!"))
    print(naming.slug_with("Release Notes for Version 2.4", naming.SlugOptions { separator: "_" }))
    print(naming.slug_with("A very long title that should be shortened for a URL", naming.SlugOptions { max_len: 20 }))
}
