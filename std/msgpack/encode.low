import std/io
import std/text

/// Encodes `v` as MessagePack.
///
/// Every integer, length and container uses its smallest format: `fixint` and the shortest signed or unsigned width for integers, `fixstr` below 32 bytes, `fixarray` and `fixmap` below 16 entries, and `fixext` for 1, 2, 4, 8 and 16 byte payloads. Binary data always uses a `bin` format. `Single` is written as `float 32` and `Double` as `float 64`; NaN keeps its bit pattern. Entries are written in the order given. It cannot fail.
pub fn encode(v: Value) -> u8[] {
    var out: u8[] = []
    write(mut out, v)
    out
}

fn write_unsigned(mut out: u8[], n: u64) {
    match n {
        < 128 => out.push(u8(n))
        <= 0xFF => {
            out.push(0xCC)
            io.put_be(mut out, i64(n), 1)
        }
        <= 0xFFFF => {
            out.push(0xCD)
            io.put_be(mut out, i64(n), 2)
        }
        <= 0xFFFFFFFF => {
            out.push(0xCE)
            io.put_be(mut out, i64(n), 4)
        }
        _ => {
            out.push(0xCF)
            io.put_be(mut out, i64(n), 8)
        }
    }
}

fn write_negative(mut out: u8[], n: i64) {
    match n {
        >= -32 => out.push(u8(n))
        >= -128 => {
            out.push(0xD0)
            io.put_be(mut out, n, 1)
        }
        >= -32768 => {
            out.push(0xD1)
            io.put_be(mut out, n, 2)
        }
        >= -2147483648 => {
            out.push(0xD2)
            io.put_be(mut out, n, 4)
        }
        _ => {
            out.push(0xD3)
            io.put_be(mut out, n, 8)
        }
    }
}

fn write_integer(mut out: u8[], n: i64) {
    if n < 0 {
        write_negative(mut out, n)
    } else {
        write_unsigned(mut out, u64(n))
    }
}

fn write_length(mut out: u8[], n: i64, fix: u8, limit: i64, first: u8) {
    match n {
        < limit => out.push(fix | u8(n))
        <= 0xFFFF => {
            out.push(first)
            io.put_be(mut out, n, 2)
        }
        _ => {
            out.push(first + 1)
            io.put_be(mut out, n, 4)
        }
    }
}

fn write_string(mut out: u8[], s: str) {
    match s.len {
        < 32 => out.push(0xA0 | u8(s.len))
        <= 0xFF => {
            out.push(0xD9)
            io.put_be(mut out, s.len, 1)
        }
        <= 0xFFFF => {
            out.push(0xDA)
            io.put_be(mut out, s.len, 2)
        }
        _ => {
            out.push(0xDB)
            io.put_be(mut out, s.len, 4)
        }
    }
    text.append(mut out, s)
}

fn write_binary(mut out: u8[], data: u8[]) {
    match data.len {
        <= 0xFF => {
            out.push(0xC4)
            io.put_be(mut out, data.len, 1)
        }
        <= 0xFFFF => {
            out.push(0xC5)
            io.put_be(mut out, data.len, 2)
        }
        _ => {
            out.push(0xC6)
            io.put_be(mut out, data.len, 4)
        }
    }
    io.append(mut out, data)
}

fn write_extension(mut out: u8[], kind: i64, data: u8[]) {
    let n = data.len
    if n == 1 || n == 2 || n == 4 || n == 8 || n == 16 {
        var shift = 0
        for i64(1) << shift < n {
            shift += 1
        }
        out.push(u8(0xD4 + shift))
    } else if n <= 0xFF {
        out.push(0xC7)
        io.put_be(mut out, n, 1)
    } else if n <= 0xFFFF {
        out.push(0xC8)
        io.put_be(mut out, n, 2)
    } else {
        out.push(0xC9)
        io.put_be(mut out, n, 4)
    }
    out.push(u8(kind))
    io.append(mut out, data)
}

fn write_timestamp(mut out: u8[], seconds: i64, nanoseconds: i64) {
    var s = seconds
    var n = nanoseconds
    if n < 0 || n > 999999999 {
        var carry = n / 1000000000
        n = n % 1000000000
        if n < 0 {
            n += 1000000000
            carry -= 1
        }
        s += carry
    }
    if n == 0 && s >= 0 && s <= 0xFFFFFFFF {
        out.push(0xD6)
        out.push(0xFF)
        io.put_be(mut out, s, 4)
    } else if s >= 0 && s < i64(1) << 34 {
        out.push(0xD7)
        out.push(0xFF)
        io.put_be(mut out, i64(u64(n) << 34 | u64(s)), 8)
    } else {
        out.push(0xC7)
        out.push(12)
        out.push(0xFF)
        io.put_be(mut out, n, 4)
        io.put_be(mut out, s, 8)
    }
}

fn write(mut out: u8[], v: Value) {
    match v {
        Nil => out.push(0xC0)
        Bool(b) => out.push(if b { 0xC3 } else { 0xC2 })
        Int(n) => write_integer(mut out, n)
        Uint(n) => write_unsigned(mut out, n)
        Single(x) => {
            out.push(0xCA)
            io.put_be(mut out, i64(text.float32_bits(x)), 4)
        }
        Double(x) => {
            out.push(0xCB)
            io.put_be(mut out, i64(text.float_bits(x)), 8)
        }
        Str(s) => write_string(mut out, s)
        Bin(data) => write_binary(mut out, data)
        Array(items) => {
            write_length(mut out, items.len, 0x90, 16, 0xDC)
            for item in items {
                write(mut out, item)
            }
        }
        Map(entries) => {
            write_length(mut out, entries.len, 0x80, 16, 0xDE)
            for e in entries {
                write(mut out, e.key)
                write(mut out, e.value)
            }
        }
        Ext(kind, data) => write_extension(mut out, kind, data)
        Timestamp(seconds, nanoseconds) => write_timestamp(mut out, seconds, nanoseconds)
    }
}
