import std/msgpack
import std/serde
import std/text

enum Event {
    Login(user: str)
    Move(x: i64, y: i64)
    Logout
}

struct Envelope {
    id: u64
    event: Event
    tags: []str
}

fn describe(e: serde.Error) -> str {
    match e {
        Syntax(at, message) => "syntax error at {at}: {message}"
        Mismatch(expected, at) => "expected {expected} at value {at}"
        Missing(field) => "missing field {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "number out of range at value {at}"
        TooDeep => "nested too deeply"
        TooLarge => "too large"
    }
}

fn describe_event(e: Event) -> str {
    match e {
        Login(user) => "login {user}"
        Move(x, y) => "move to {x},{y}"
        Logout => "logout"
    }
}

fn roundtrip(envelope: Envelope) {
    let value = msgpack.to_value(envelope)
    let data = msgpack.encode(value)
    let summary = msgpack.diagnostic(value)
    print(summary)
    print("{data.len} bytes: {text.encode_hex(data)}")

    let back = msgpack.deserialize[Envelope](data) catch {
        e => {
            print(describe(e))
            return
        }
    }
    print("{back.id}: {describe_event(back.event)} {back.tags}")
}

/// Serialises messages that carry an enum to MessagePack, reads them back, and decodes a map that names an unknown variant.
fn main() {
    roundtrip(Envelope { id: 1, event: Login("ada"), tags: ["web"] })
    roundtrip(Envelope { id: 300, event: Move(5, -12), tags: [] })
    roundtrip(Envelope { id: 18446744073709551615, event: Logout, tags: ["a", "b"] })

    let unknown = msgpack.Value.Map([
        msgpack.Entry { key: msgpack.Value.Str("id"), value: msgpack.Value.Int(2) },
        msgpack.Entry { key: msgpack.Value.Str("event"), value: msgpack.Value.Str("Teleport") },
        msgpack.Entry { key: msgpack.Value.Str("tags"), value: msgpack.Value.Array([]) },
    ])
    let data = msgpack.encode(unknown)
    let failed = msgpack.deserialize[Envelope](data) catch {
        e => {
            print(describe(e))
            return
        }
    }
    print(failed.id)
}
