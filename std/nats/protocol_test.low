import std/io
import std/json
import std/testing
import std/text

struct Drip {
    data: u8[]
    at: i64
}

fn dripping(data: str, size: i64) -> io.Stream {
    let state = new(Drip { data: bytes(data), at: 0 })
    io.Stream {
        read: fn(buf) {
            let left = state.data.len - state.at
            if left == 0 {
                return 0
            }
            let n = if left < size { left } else { size }
            let k = io.copy(buf[..n], state.data[state.at..state.at + n])
            state.at += k
            k
        }
        write: fn(data) { data.len }
        close: fn() {}
    }
}

fn error_name(e: Error) -> str {
    match e {
        Connect => "Connect"
        Closed => "Closed"
        Timeout => "Timeout"
        Protocol => "Protocol"
        TooLarge => "TooLarge"
        Tls => "Tls"
        Unsupported => "Unsupported"
        Auth(m) => "Auth({m})"
        Server(m) => "Server({m})"
        NoResponders => "NoResponders"
        BadSubject => "BadSubject"
        BadHeader => "BadHeader"
        MaxPayload => "MaxPayload"
        Draining => "Draining"
        Argument => "Argument"
        BadSeed => "BadSeed"
    }
}

fn headers_text(headers: Header[]) -> str {
    var parts: str[] = []
    for h in headers {
        parts.push("{h.name}={h.value}")
    }
    text.join(parts, ",")
}

fn describe(op: Op) -> str {
    match op {
        Info(i) => "info {i.server_id} max {i.max_payload} headers {i.headers} tls {i.tls_required} auth {i.auth_required} nonce {i.nonce}"
        Msg(sid, m, damaged) => "msg {sid} {m.subject} reply [{m.reply}] status {m.status} [{m.description}] headers [{headers_text(m.headers)}]{if damaged { " damaged" } else { "" }} body {text.quote(str(m.payload))}"
        Ping => "ping"
        Pong => "pong"
        Accepted => "ok"
        Rejected(t) => "err {t}"
    }
}

fn decoded(data: str, limits: Limits) -> str {
    let r = io.bytes_reader(bytes(data))
    let op = read_op(r, limits) catch {
        e => return "error {error_name(e)}"
    }
    describe(op)
}

fn read(data: str) -> str {
    decoded(data, Limits {})
}

fn dripped(data: str, size: i64) -> str {
    let r = io.reader(dripping(data, size))
    let op = read_op(r, Limits {}) catch {
        e => return "error {error_name(e)}"
    }
    describe(op)
}

fn test_encode_publish(t: *testing.T) {
    t.equal(text.quote(str(encode_pub("a.b", "", bytes("hi")))), text.quote("PUB a.b 2\r\nhi\r\n"))
    t.equal(text.quote(str(encode_pub("a.b", "r.1", bytes("hi")))), text.quote("PUB a.b r.1 2\r\nhi\r\n"))
    t.equal(text.quote(str(encode_pub("a", "", []))), text.quote("PUB a 0\r\n\r\n"))
    t.equal(text.quote(str(encode_pub("a", "", bytes("x\r\ny")))), text.quote("PUB a 4\r\nx\r\ny\r\n"))
}

fn test_encode_headers(t: *testing.T) {
    let headers = [Header { name: "A", value: "1" }, Header { name: "B", value: "x y" }, Header { name: "A", value: "2" }]
    let block = encode_headers(headers)
    t.equal(text.quote(str(block)), text.quote("NATS/1.0\r\nA: 1\r\nB: x y\r\nA: 2\r\n\r\n"))
    t.equal(text.quote(str(encode_hpub("s", "", encode_headers([Header { name: "A", value: "1" }]), bytes("hi")))), text.quote("HPUB s 18 20\r\nNATS/1.0\r\nA: 1\r\n\r\nhi\r\n"))
    t.equal(text.quote(str(encode_hpub("s", "r", encode_headers([Header { name: "A", value: "1" }]), []))), text.quote("HPUB s r 18 18\r\nNATS/1.0\r\nA: 1\r\n\r\n\r\n"))
}

fn test_encode_subscribe(t: *testing.T) {
    t.equal(str(encode_sub("a.>", "", 7)), "SUB a.> 7\r\n")
    t.equal(str(encode_sub("a.*", "workers", 8)), "SUB a.* workers 8\r\n")
    t.equal(str(encode_unsub(7, 0)), "UNSUB 7\r\n")
    t.equal(str(encode_unsub(7, 3)), "UNSUB 7 3\r\n")
}

fn connect_object(c: Connect) -> json.Value {
    let line = str(encode_connect(c))
    let after = text.cut(line, " ").after
    let body = text.cut(after, "\r\n").before
    json.parse(bytes(body)) catch {
        e => json.Value.Null
    }
}

fn flag(v: json.Value, name: str) -> str {
    match json.field(v, name) {
        Bool(b) => "{b}"
        _ => "absent"
    }
}

fn plain() -> Connect {
    Connect { name: "", token: "", user: "", password: "", nkey: "", signature: "", echo: true, headers: true, tls_required: false }
}

fn test_encode_connect(t: *testing.T) {
    let line = str(encode_connect(plain()))
    t.is_true(text.starts_with(line, "CONNECT {{"))
    t.is_true(text.ends_with(line, "}}\r\nPING\r\n"))
    let v = connect_object(plain())
    t.equal(flag(v, "verbose"), "false")
    t.equal(flag(v, "pedantic"), "false")
    t.equal(flag(v, "headers"), "true")
    t.equal(flag(v, "no_responders"), "true")
    t.equal(flag(v, "echo"), "true")
    t.equal(flag(v, "tls_required"), "false")
    t.equal(json.int_of(v, "protocol"), 1)
    t.equal(json.text_of(v, "lang"), "low")
    t.equal(json.text_of(v, "version"), client_version)
    t.is_none(json.field_text(v, "auth_token"))
    t.is_none(json.field_text(v, "user"))
    t.is_none(json.field_text(v, "nkey"))
}

fn test_encode_connect_credentials(t: *testing.T) {
    var c = plain()
    c.name = "worker \"one\""
    c.token = "s3cret"
    c.user = "alice"
    c.password = "p\\w"
    c.nkey = "UABC"
    c.signature = "sig"
    c.echo = false
    c.tls_required = true
    let v = connect_object(c)
    t.equal(json.text_of(v, "name"), "worker \"one\"")
    t.equal(json.text_of(v, "auth_token"), "s3cret")
    t.equal(json.text_of(v, "user"), "alice")
    t.equal(json.text_of(v, "pass"), "p\\w")
    t.equal(json.text_of(v, "nkey"), "UABC")
    t.equal(json.text_of(v, "sig"), "sig")
    t.equal(flag(v, "echo"), "false")
    t.equal(flag(v, "tls_required"), "true")
}

fn test_encode_connect_without_headers(t: *testing.T) {
    var c = plain()
    c.headers = false
    let v = connect_object(c)
    t.equal(flag(v, "headers"), "false")
    t.equal(flag(v, "no_responders"), "false")
}

fn test_read_info(t: *testing.T) {
    t.equal(read("INFO {{\"server_id\":\"S1\",\"max_payload\":2048,\"headers\":true,\"tls_required\":true,\"auth_required\":true,\"nonce\":\"abc\",\"extra\":[1,2]}}\r\n"), "info S1 max 2048 headers true tls true auth true nonce abc")
    t.equal(read("INFO {{\"server_id\":\"S2\"}}\r\n"), "info S2 max 1048576 headers false tls false auth false nonce ")
    t.equal(read("info {{\"server_id\":\"S3\"}}\r\n"), "info S3 max 1048576 headers false tls false auth false nonce ")
    t.equal(read("INFO not-json\r\n"), "error Protocol")
    t.equal(read("INFO\r\n"), "error Protocol")
    let long = text.repeat("x", 6000)
    t.equal(read("INFO {{\"server_id\":\"{long}\"}}\r\n").len > 6000, true)
}

fn test_read_msg(t: *testing.T) {
    t.equal(read("MSG a.b 5 2\r\nhi\r\n"), "msg 5 a.b reply [] status 0 [] headers [] body \"hi\"")
    t.equal(read("MSG a.b 5 r.1 2\r\nhi\r\n"), "msg 5 a.b reply [r.1] status 0 [] headers [] body \"hi\"")
    t.equal(read("MSG a 1 0\r\n\r\n"), "msg 1 a reply [] status 0 [] headers [] body \"\"")
    t.equal(read("MSG a 1 4\r\nx\r\ny\r\n"), "msg 1 a reply [] status 0 [] headers [] body \"x\\r\\ny\"")
    t.equal(read("msg a 1 1\r\nz\r\n"), "msg 1 a reply [] status 0 [] headers [] body \"z\"")
    t.equal(read("MSG a\t1\t1\r\nz\r\n"), "msg 1 a reply [] status 0 [] headers [] body \"z\"")
}

fn test_read_hmsg(t: *testing.T) {
    t.equal(read("HMSG a 3 18 20\r\nNATS/1.0\r\nK: v\r\n\r\nhi\r\n"), "msg 3 a reply [] status 0 [] headers [K=v] body \"hi\"")
    t.equal(read("HMSG a 3 r 18 20\r\nNATS/1.0\r\nK: v\r\n\r\nhi\r\n"), "msg 3 a reply [r] status 0 [] headers [K=v] body \"hi\"")
    t.equal(read("HMSG a 3 12 12\r\nNATS/1.0\r\n\r\n\r\n"), "msg 3 a reply [] status 0 [] headers [] body \"\"")
    t.equal(read("HMSG a 3 16 16\r\nNATS/1.0 503\r\n\r\n\r\n"), "msg 3 a reply [] status 503 [] headers [] body \"\"")
    t.equal(read("HMSG a 3 32 32\r\nNATS/1.0 408 Request Timeout\r\n\r\n\r\n"), "msg 3 a reply [] status 408 [Request Timeout] headers [] body \"\"")
    t.equal(read("HMSG a 3 31 31\r\nNATS/1.0 100 Idle\r\nK:  v w \r\n\r\n\r\n"), "msg 3 a reply [] status 100 [Idle] headers [K=v w] body \"\"")
    t.equal(read("HMSG a 3 30 30\r\nNATS/1.0\r\nA: 1\r\nB: 2\r\nA: 3\r\n\r\n\r\n"), "msg 3 a reply [] status 0 [] headers [A=1,B=2,A=3] body \"\"")
}

fn test_read_control(t: *testing.T) {
    t.equal(read("PING\r\n"), "ping")
    t.equal(read("PONG\r\n"), "pong")
    t.equal(read("ping\r\n"), "ping")
    t.equal(read("+OK\r\n"), "ok")
    t.equal(read("-ERR 'Authorization Violation'\r\n"), "err Authorization Violation")
    t.equal(read("-ERR 'Permissions Violation for Publish to \"x\"'\r\n"), "err Permissions Violation for Publish to \"x\"")
    t.equal(read("-ERR plain\r\n"), "err plain")
    t.equal(read("-ERR\r\n"), "err ")
}

fn test_read_rejects_malformed(t: *testing.T) {
    t.equal(read("BOGUS\r\n"), "error Protocol")
    t.equal(read("\r\n"), "error Protocol")
    t.equal(read(""), "error Closed")
    t.equal(read("PING"), "error Closed")
    t.equal(read("MSG a 1\r\n"), "error Protocol")
    t.equal(read("MSG a 1 r 2 3\r\n"), "error Protocol")
    t.equal(read("MSG a x 2\r\nhi\r\n"), "error Protocol")
    t.equal(read("MSG a 1 x\r\n"), "error Protocol")
    t.equal(read("MSG a 1 -1\r\n"), "error Protocol")
    t.equal(read("MSG a 1 3\r\nab\r\n"), "error Closed")
    t.equal(read("MSG a 1 2\r\nabcd"), "error Protocol")
    t.equal(read("MSG a 1 2\r\nab"), "error Closed")
    t.equal(read("HMSG a 1 4\r\n"), "error Protocol")
    t.equal(read("HMSG a 1 9 8\r\n"), "error Protocol")
    t.equal(read("HMSG a 1 -1 4\r\nxxxx\r\n"), "error Protocol")
}

fn test_read_delivers_bad_header_blocks_without_headers(t: *testing.T) {
    t.equal(read("HMSG a 1 6 6\r\nHTTP/1\r\n"), "msg 1 a reply [] status 0 [] headers [] damaged body \"\"")
    t.equal(read("HMSG a 1 17 17\r\nNATS/1.0\r\nbad\r\n\r\n\r\n"), "msg 1 a reply [] status 0 [] headers [] damaged body \"\"")
    t.equal(read("HMSG a 1 17 17\r\nNATS/1.0\r\n: v\r\n\r\n\r\n"), "msg 1 a reply [] status 0 [] headers [] damaged body \"\"")
    t.equal(read("HMSG a 1 15 15\r\nNATS/1.0 xx\r\n\r\n\r\n"), "msg 1 a reply [] status 0 [] headers [] damaged body \"\"")
    t.equal(read("HMSG a 1 10 10\r\nNATS/1.0\r\n\r\n"), "msg 1 a reply [] status 0 [] headers [] damaged body \"\"")
    t.equal(read("HMSG a 1 6 8\r\nHTTP/1hi\r\n"), "msg 1 a reply [] status 0 [] headers [] damaged body \"hi\"")
}

fn test_read_after_bad_header_block_keeps_framing(t: *testing.T) {
    let r = io.bytes_reader(bytes("HMSG a 1 6 8\r\nHTTP/1hi\r\nMSG b 2 2\r\nok\r\n"))
    var seen: str[] = []
    for _ in 0..2 {
        let op = read_op(r, Limits {}) catch {
            e => {
                seen.push("error {error_name(e)}")
                continue
            }
        }
        seen.push(describe(op))
    }
    t.equal(text.join(seen, " | "), "msg 1 a reply [] status 0 [] headers [] damaged body \"hi\" | msg 2 b reply [] status 0 [] headers [] body \"ok\"")
}

fn test_read_limits(t: *testing.T) {
    t.equal(decoded("MSG a 1 8\r\n12345678\r\n", Limits { payload: 8 }), "msg 1 a reply [] status 0 [] headers [] body \"12345678\"")
    t.equal(decoded("MSG a 1 9\r\n123456789\r\n", Limits { payload: 8 }), "error TooLarge")
    t.equal(decoded("HMSG a 1 4 9\r\n", Limits { payload: 8 }), "error TooLarge")
    t.equal(read("MSG a 1 1000000000000\r\n"), "error TooLarge")
    let subject = text.repeat("s", 100)
    t.equal(decoded("PING {subject}\r\n", Limits { control_line: 16 }), "error TooLarge")
    t.equal(decoded("PING\r\n", Limits { control_line: 16 }), "ping")
    t.equal(decoded("MSG {subject} 1 0\r\n\r\n", Limits { control_line: 16 }), "error TooLarge")
    t.equal(read("PING {text.repeat("x", 20000)}\r\n"), "error TooLarge")
}

fn test_read_in_pieces(t: *testing.T) {
    t.equal(dripped("MSG a.b 5 r.1 2\r\nhi\r\n", 1), "msg 5 a.b reply [r.1] status 0 [] headers [] body \"hi\"")
    t.equal(dripped("HMSG a 3 18 20\r\nNATS/1.0\r\nK: v\r\n\r\nhi\r\n", 3), "msg 3 a reply [] status 0 [] headers [K=v] body \"hi\"")
    t.equal(dripped("-ERR 'x'\r\n", 2), "err x")
}

fn test_read_large_body(t: *testing.T) {
    let body = text.repeat("y", 70000)
    let r = io.reader(dripping("MSG a 1 70000\r\n{body}\r\n", 1000))
    let op = read_op(r, Limits {}) catch {
        e => {
            t.is_true(false)
            return
        }
    }
    match op {
        Msg(sid, m, damaged) => {
            t.equal(m.payload.len, 70000)
            t.equal(m.payload[69999], 'y')
        }
        _ => {
            t.is_true(false)
        }
    }
}

fn test_read_in_sequence(t: *testing.T) {
    let r = io.bytes_reader(bytes("PING\r\nMSG a 1 2\r\nhi\r\n+OK\r\nPONG\r\n"))
    var seen: str[] = []
    for _ in 0..4 {
        let op = read_op(r, Limits {}) catch {
            e => {
                t.is_true(false)
                return
            }
        }
        seen.push(describe(op))
    }
    t.equal(text.join(seen, "|"), "ping|msg 1 a reply [] status 0 [] headers [] body \"hi\"|ok|pong")
}

fn test_header_lookup(t: *testing.T) {
    let m = Message {
        subject: "s"
        reply: ""
        headers: [Header { name: "Content-Type", value: "text/plain" }, Header { name: "X-Id", value: "1" }, Header { name: "x-id", value: "2" }]
        status: 0
        description: ""
        payload: []
    }
    t.equal(header(m, "content-type") ?? "", "text/plain")
    t.equal(header(m, "X-ID") ?? "", "1")
    t.is_none(header(m, "missing"))
}

struct SubjectCase {
    subject: str
    subscribe: bool
    publish: bool
}

fn test_subjects(t: *testing.T) {
    let cases = [
        SubjectCase { subject: "a", subscribe: true, publish: true }
        SubjectCase { subject: "a.b.c", subscribe: true, publish: true }
        SubjectCase { subject: "a.*", subscribe: true, publish: false }
        SubjectCase { subject: "*", subscribe: true, publish: false }
        SubjectCase { subject: "*.b.*", subscribe: true, publish: false }
        SubjectCase { subject: "a.>", subscribe: true, publish: false }
        SubjectCase { subject: ">", subscribe: true, publish: false }
        SubjectCase { subject: "a.>.b", subscribe: false, publish: false }
        SubjectCase { subject: "a.b>", subscribe: true, publish: true }
        SubjectCase { subject: "a*", subscribe: true, publish: true }
        SubjectCase { subject: "_INBOX.x.1", subscribe: true, publish: true }
        SubjectCase { subject: "", subscribe: false, publish: false }
        SubjectCase { subject: ".", subscribe: false, publish: false }
        SubjectCase { subject: "a.", subscribe: false, publish: false }
        SubjectCase { subject: ".a", subscribe: false, publish: false }
        SubjectCase { subject: "a..b", subscribe: false, publish: false }
        SubjectCase { subject: "a b", subscribe: false, publish: false }
        SubjectCase { subject: "a\tb", subscribe: false, publish: false }
        SubjectCase { subject: "a\r\nPING", subscribe: false, publish: false }
        SubjectCase { subject: "a\nb", subscribe: false, publish: false }
        SubjectCase { subject: " a", subscribe: false, publish: false }
        SubjectCase { subject: "a{text.from_char(0)}b", subscribe: false, publish: false }
    ]
    for c in cases {
        t.equal(valid_subject(c.subject), c.subscribe)
        t.equal(valid_literal_subject(c.subject), c.publish)
    }
}

fn test_names_and_headers(t: *testing.T) {
    t.is_true(valid_queue("workers"))
    t.is_true(valid_queue("w.1"))
    t.is_false(valid_queue(""))
    t.is_false(valid_queue("a b"))
    t.is_false(valid_queue("a\r\nb"))
    t.is_true(valid_header(Header { name: "X-Id", value: "a b: c" }))
    t.is_true(valid_header(Header { name: "X", value: "" }))
    t.is_false(valid_header(Header { name: "", value: "v" }))
    t.is_false(valid_header(Header { name: "a b", value: "v" }))
    t.is_false(valid_header(Header { name: "a:b", value: "v" }))
    t.is_false(valid_header(Header { name: "a\r\nb", value: "v" }))
    t.is_false(valid_header(Header { name: "a", value: "v\r\nPING" }))
    t.is_false(valid_header(Header { name: "a", value: "v\nx" }))
    t.is_true(headers_ok([]))
    t.is_false(headers_ok([Header { name: "a", value: "1" }, Header { name: "", value: "2" }]))
}

fn test_server_rejections(t: *testing.T) {
    t.equal(error_name(rejected("Authorization Violation")), "Auth(Authorization Violation)")
    t.equal(error_name(rejected("User Authentication Expired")), "Auth(User Authentication Expired)")
    t.equal(error_name(rejected("Maximum Payload Violation")), "Server(Maximum Payload Violation)")
    t.is_true(recoverable("Permissions Violation for Publish to \"x\""))
    t.is_true(recoverable("Invalid Subject"))
    t.is_false(recoverable("Authorization Violation"))
    t.is_false(recoverable("Stale Connection"))
}
