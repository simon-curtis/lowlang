import std/base32
import std/base64
import std/crypto/ed25519
import std/io
import std/text

struct Seed {
    kind: i64
    key: u8[]
}

fn seed_prefix() -> i64 {
    18 << 3
}

fn crc16(data: u8[]) -> i64 {
    var crc = 0
    for b in data {
        crc = crc ^ (i64(b) << 8)
        for _ in 0..8 {
            if (crc & 0x8000) != 0 {
                crc = (crc << 1) ^ 0x1021
            } else {
                crc = crc << 1
            }
            crc = crc & 0xFFFF
        }
    }
    crc
}

fn valid_kind(kind: i64) -> bool {
    kind == 0 || kind == 2 << 3 || kind == 13 << 3 || kind == 14 << 3 || kind == 20 << 3
}

fn encode_checked(raw: u8[]) -> str {
    var out = raw
    io.put_le16(mut out, crc16(raw))
    base32.encode_unpadded(out)
}

fn decode_seed(encoded: str) -> Seed ! Error {
    let raw = base32.decode(text.trim(encoded)) or fail BadSeed
    if raw.len != 36 {
        fail BadSeed
    }
    if crc16(raw[..34]) != io.le16(raw, 34) {
        fail BadSeed
    }
    let lead = i64(raw[0])
    if (lead & 248) != seed_prefix() {
        fail BadSeed
    }
    let kind = ((lead & 7) << 5) | ((i64(raw[1]) & 248) >> 3)
    if !valid_kind(kind) {
        fail BadSeed
    }
    Seed { kind, key: raw[2..34] }
}

/// Returns the public key encoded as an NKey for the NKey seed `seed`.
///
/// A seed is the base32 text that starts with `S` and is followed by the key type letter, such as `SU` for a user. The public key starts with the type letter, `U` for a user. Surrounding whitespace is ignored. Fails with `BadSeed` when the text is not base32, has the wrong length, fails its CRC-16 check or names an unknown key type.
pub fn public_nkey(seed: str) -> str ! Error {
    let s = decode_seed(seed)?
    var raw: u8[] = []
    raw.push(u8(s.kind))
    io.append(mut raw, ed25519.public_key(s.key))
    encode_checked(raw)
}

/// Returns the Ed25519 signature of `nonce` under the NKey seed `seed`, as unpadded URL-safe base64.
///
/// This is the `sig` value of the `CONNECT` line, where `nonce` is the string from the server's `INFO`. Fails as `public_nkey` does.
pub fn sign_nonce(seed: str, nonce: str) -> str ! Error {
    let s = decode_seed(seed)?
    base64.encode_url(ed25519.sign(s.key, bytes(nonce)))
}
