import std/io
import std/nats
import std/net
import std/text

struct Sub {
    sid: str
    subject: str
}

fn matches(pattern: str, subject: str) -> bool {
    let p = text.split(pattern, '.')
    let s = text.split(subject, '.')
    for i, token in p {
        if token == ">" {
            return s.len > i
        }
        if i >= s.len {
            return false
        }
        if token != "*" && token != s[i] {
            return false
        }
    }
    p.len == s.len
}

fn route(stream: io.Stream, subs: Sub[], subject: str, reply: str, payload: str) ! io.Error {
    var delivered = 0
    for sub in subs {
        if matches(sub.subject, subject) {
            let tail = if reply.len > 0 { "{reply} " } else { "" }
            io.write_str(stream, "MSG {subject} {sub.sid} {tail}{payload.len}\r\n{payload}\r\n")?
            delivered += 1
        }
    }
    if delivered == 0 && reply.len > 0 {
        for sub in subs {
            if matches(sub.subject, reply) {
                io.write_str(stream, "HMSG {reply} {sub.sid} 16 16\r\nNATS/1.0 503\r\n\r\n\r\n")?
            }
        }
    }
}

fn serve_session(c: net.Conn) ! io.Error {
    let stream = net.stream(c)
    let r = io.reader(stream)
    io.write_str(stream, "INFO {{\"server_id\":\"EXAMPLE\",\"version\":\"2.10.0\",\"headers\":true,\"max_payload\":1048576}}\r\n")?
    var subs: Sub[] = []
    for {
        let line = io.read_line(r)?
        let parts = text.fields(line)
        if parts.len == 0 {
            continue
        }
        if parts[0] == "PING" {
            io.write_str(stream, "PONG\r\n")?
        } else if parts[0] == "SUB" {
            subs.push(Sub { sid: parts[parts.len - 1], subject: parts[1] })
        } else if parts[0] == "PUB" {
            let size = text.parse_int(parts[parts.len - 1]) or 0
            let body = io.read_exact(r, size + 2)?
            let reply = if parts.len == 4 { parts[2] } else { "" }
            route(stream, subs, parts[1], reply, str(body[..size]))?
        }
    }
}

fn serve(l: net.ListenerHandle) {
    let h = net.accept_handle(l) or return
    using c = net.adopt(h)
    serve_session(c) or {}
}

fn double(h: *nats.ClientHandle, s: nats.Subscription) {
    for {
        let m = <-s.messages ?? break
        let n = text.parse_int(str(m.payload)) or 0
        nats.publish_on(h, m.reply, bytes("{n * 2}")) or break
    }
}

fn talk(port: i64) ! nats.Error {
    using client = nats.connect(nats.Options { port, name: "example", timeout: 5000 })?
    let info = client.server_info()
    print("connected to {info.server_id} {info.version}")

    let greetings = client.subscribe("greet.*")?
    client.publish("greet.world", bytes("hello"))?
    let greeting = <-greetings.messages ?? return
    print("{greeting.subject}: {str(greeting.payload)}")

    let doubler = client.subscribe("math.double")?
    spawn double(client.handle, doubler)
    for n in ["4", "21"] {
        let reply = client.request("math.double", bytes(n), 2000)?
        print("double {n} = {str(reply.payload)}")
    }

    let unanswered = client.request("math.none", bytes("1"), 2000) catch {
        NoResponders => {
            print("math.none: nobody is subscribed")
            return
        }
        e => fail e
    }
    print("unexpected reply {str(unanswered.payload)}")
}

/// Subscribes with a wildcard, publishes, and makes requests against a stub NATS server on loopback, where one request has a responder and one has none.
fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    spawn serve(l.handle)
    talk(l.handle.addr.port) or {
        print("example failed")
    }
}
