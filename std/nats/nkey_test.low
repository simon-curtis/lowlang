import std/base32
import std/base64
import std/crypto/ed25519
import std/io
import std/testing
import std/text

fn rfc_seed() -> u8[] {
    text.decode_hex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60") catch {
        e => []
    }
}

fn rfc_public() -> u8[] {
    text.decode_hex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a") catch {
        e => []
    }
}

fn encode_seed(kind: i64, key: u8[]) -> str {
    var raw: u8[] = []
    raw.push(u8(seed_prefix() | (kind >> 5)))
    raw.push(u8((kind & 31) << 3))
    io.append(mut raw, key)
    encode_checked(raw)
}

fn user_seed() -> str {
    encode_seed(20 << 3, rfc_seed())
}

fn seed_outcome(seed: str) -> str {
    let s = decode_seed(seed) catch {
        BadSeed => return "BadSeed"
        _ => return "other"
    }
    "kind {s.kind} key {text.encode_hex(s.key)}"
}

fn test_crc16_check_value(t: *testing.T) {
    t.equal(crc16(bytes("123456789")), 0x31C3)
    t.equal(crc16([]), 0)
}

fn test_seed_letters(t: *testing.T) {
    t.is_true(text.starts_with(encode_seed(20 << 3, rfc_seed()), "SU"))
    t.is_true(text.starts_with(encode_seed(0, rfc_seed()), "SA"))
    t.is_true(text.starts_with(encode_seed(14 << 3, rfc_seed()), "SO"))
    t.is_true(text.starts_with(encode_seed(13 << 3, rfc_seed()), "SN"))
    t.is_true(text.starts_with(encode_seed(2 << 3, rfc_seed()), "SC"))
    t.equal(user_seed().len, 58)
}

fn test_seed_round_trip(t: *testing.T) {
    let key = text.encode_hex(rfc_seed())
    t.equal(seed_outcome(user_seed()), "kind 160 key {key}")
    t.equal(seed_outcome(encode_seed(0, rfc_seed())), "kind 0 key {key}")
    t.equal(seed_outcome(encode_seed(14 << 3, rfc_seed())), "kind 112 key {key}")
    t.equal(seed_outcome("  {user_seed()}\n"), "kind 160 key {key}")
    t.equal(seed_outcome(text.lower(user_seed())), "kind 160 key {key}")
}

fn test_seed_rejections(t: *testing.T) {
    let good = user_seed()
    var flipped = bytes(good)
    flipped[30] = if flipped[30] == 'A' { 'B' } else { 'A' }
    t.equal(seed_outcome(str(flipped)), "BadSeed")
    t.equal(seed_outcome(good[..57]), "BadSeed")
    t.equal(seed_outcome("{good}A"), "BadSeed")
    t.equal(seed_outcome(""), "BadSeed")
    t.equal(seed_outcome("SU"), "BadSeed")
    t.equal(seed_outcome("{good[..10]}!{good[11..]}"), "BadSeed")
    t.equal(seed_outcome("{good[..10]}1{good[11..]}"), "BadSeed")
    let public = public_nkey(good) catch {
        e => ""
    }
    t.equal(seed_outcome(public), "BadSeed")
    t.equal(seed_outcome(encode_seed(23 << 3, rfc_seed())), "BadSeed")
    let short = encode_seed(20 << 3, rfc_seed()[..31])
    t.equal(seed_outcome(short), "BadSeed")
}

fn test_public_key(t: *testing.T) {
    let public = public_nkey(user_seed()) catch {
        e => ""
    }
    t.equal(public.len, 56)
    t.is_true(text.starts_with(public, "U"))
    let raw = base32.decode(public) catch {
        e => []
    }
    t.equal(raw.len, 35)
    t.equal(raw[0], 160)
    t.equal(text.encode_hex(raw[1..33]), text.encode_hex(rfc_public()))
    t.equal(crc16(raw[..33]), i64(raw[33]) | (i64(raw[34]) << 8))
}

fn test_public_key_of_other_kinds(t: *testing.T) {
    let account = public_nkey(encode_seed(0, rfc_seed())) catch {
        e => ""
    }
    t.is_true(text.starts_with(account, "A"))
    let operator = public_nkey(encode_seed(14 << 3, rfc_seed())) catch {
        e => ""
    }
    t.is_true(text.starts_with(operator, "O"))
}

fn test_nonce_signature(t: *testing.T) {
    let nonce = "Zm9vYmFyYmF6"
    let signature = sign_nonce(user_seed(), nonce) catch {
        e => ""
    }
    t.equal(signature.len, 86)
    t.is_false(text.contains(signature, "="))
    t.is_false(text.contains(signature, "+"))
    t.is_false(text.contains(signature, "/"))
    let raw = base64.decode_url(signature) catch {
        e => []
    }
    t.equal(raw.len, 64)
    t.is_true(ed25519.verify(rfc_public(), bytes(nonce), raw))
    t.is_false(ed25519.verify(rfc_public(), bytes("other"), raw))
    let again = sign_nonce(user_seed(), nonce) catch {
        e => ""
    }
    t.equal(again, signature)
}

const readme_seed: str = "SUAKYRHVIOREXV7EUZTBHUHL7NUMHPMAS7QMDU3GTIUWEI5LDNOXD43IZY"

const readme_public: str = "UD466L6EBCM3YY5HEGHJANNTN4LSKTSUXTH7RILHCKEQMQHTBNLHJJXT"

const rfc_empty_signature: str = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"

fn test_known_seed_and_public_key(t: *testing.T) {
    let public = public_nkey(readme_seed) catch {
        e => ""
    }
    t.equal(public, readme_public)
    let decoded = decode_seed(readme_seed) catch {
        e => Seed { kind: -1, key: [] }
    }
    t.equal(decoded.kind, 20 << 3)
    t.equal(decoded.key.len, 32)
    t.equal(encode_seed(decoded.kind, decoded.key), readme_seed)
}

fn test_known_signature(t: *testing.T) {
    let encoded = sign_nonce(user_seed(), "") catch {
        e => ""
    }
    let raw = base64.decode_url(encoded) catch {
        e => []
    }
    t.equal(text.encode_hex(raw), rfc_empty_signature)
}

fn test_signature_needs_a_valid_seed(t: *testing.T) {
    let outcome = sign_nonce("not a seed", "n") catch {
        BadSeed => "BadSeed"
        _ => "other"
    }
    t.equal(outcome, "BadSeed")
}
