import std/io
import std/os
import std/process

fn grandchild() {
    sleep(60000)
}

fn spawner() ! io.Error {
    let program = os.executable()?
    using held = process.start(process.command(program, ["grandchild"]))?
    print("started")
    sleep(60000)
}

/// Starts a program in its own group, lets it start a second program that holds the first one's output open, then kills the group and shows that both ended: the output reaches its end only when no process of the group is left to write to it.
fn main() ! io.Error {
    let args = os.args()
    if args.len > 1 {
        match args[1] {
            "spawner" => spawner()?
            _ => grandchild()
        }
        return
    }

    var command = process.command(os.executable()?, ["spawner"])
    command.stdout = process.Stdio.Piped
    command.group = true
    using child = process.start(command)?
    let output = io.reader(child.handle.stdout ?? fail Invalid)
    print("child says: {io.read_line(output)?}")

    process.kill(child, Kill)?
    let end = process.wait(child)?
    print("child ended: {!process.success(end)}")

    var more = 0
    for {
        io.read_byte(output) catch {
            Eof => break
            e => fail e
        }
        more += 1
    }
    print("output closed after {more} more bytes")
}
