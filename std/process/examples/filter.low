import std/io
import std/os
import std/process
import std/slices
import std/sys

const size = 1048576

fn echo() ! io.Error {
    let buf = io.buffer(65536)
    for {
        let n = sys.read(0, buf)?
        if n == 0 {
            break
        }
        sys.write_all(1, buf[..n])?
    }
}

fn message() -> []u8 {
    var out: []u8 = []
    for i in 0..size {
        push(mut out, u8(i * 7 % 251))
    }
    out
}

fn send(to: io.Stream, data: []u8, sent: chan[str]) {
    io.write_all(to, data) catch {
        e => {
            sent <- "{e}"
            return
        }
    }
    to.close()
    sent <- "sent {data.len} bytes"
}

/// Writes one mebibyte to the standard input of a child that echoes it back, from one green thread while another reads the child's standard output. The pipes park the green threads that wait on them, so neither side stalls the other while the pipe buffers are full.
fn main() ! io.Error {
    if os.args().len > 1 {
        echo()?
        return
    }

    var filter = process.command(os.executable()?, ["echo"])
    filter.stdin = process.Stdio.Piped
    filter.stdout = process.Stdio.Piped
    using child = process.start(filter)?
    let data = message()
    let sent = chan[str](1)
    spawn send(child.handle.stdin ?? fail Invalid, data, sent)
    let echoed = io.read_all(child.handle.stdout ?? fail Invalid)?
    print((<-sent) ?? "")
    print("received {echoed.len} bytes, intact: {slices.equal(echoed, data)}")
    print("child succeeded: {process.success(process.wait(child)?)}")
}
