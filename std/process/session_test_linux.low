import std/io
import std/os
import std/process
import std/sys
import std/term
import std/testing
import std/text

const namespace_variable = "LOW_TEST_IN_USER_NAMESPACE"

fn read_all(fd: i64) -> str {
    var out: u8[] = []
    let buf = io.buffer(4096)
    for {
        let n = sys.read(fd, buf) or 0
        if n == 0 {
            return str(out)
        }
        for b in buf[..n] {
            out.push(b)
        }
    }
}

fn test_terminal_session_owns_the_pty(t: *testing.T) {
    using pty = term.open_pty() or panic("pty")
    term.set_size(pty.handle.master, term.Size { columns: 91, rows: 33 }) or panic("size")
    let slave = process.Stdio.Descriptor(pty.handle.slave)
    let c = process.Command {
        program: "/bin/sh"
        args: ["-c", "echo $0; tty; stty size; test $$ -eq $(ps -o sid= -p $$) && echo leader"]
        arg0: "-sh"
        stdin: slave
        stdout: slave
        stderr: slave
        session: process.Session.Terminal
    }
    using child = process.start(c) or panic("start")
    let status = process.wait(child) or panic("wait")
    sys.close_fd(pty.handle.slave)
    let lines = text.lines(text.replace(read_all(pty.handle.master), "\r", ""))
    testing.fatal_if(t, !process.success(status), "the shell failed: {status}")
    testing.fatal_if(t, lines.len < 4, "short output {lines}")
    testing.error_if(t, lines[0] != "-sh", "argv[0] is {lines[0]}")
    testing.error_if(t, lines[1] != pty.handle.path, "the controlling terminal is {lines[1]}, not {pty.handle.path}")
    testing.error_if(t, lines[2] != "33 91", "the terminal size is {lines[2]}")
    testing.error_if(t, lines[3] != "leader", "the child does not lead its session")
}

fn test_identity_fails_closed_without_privilege(t: *testing.T) {
    if sys.euid() == 0 || os.env(namespace_variable) != none {
        testing.skip(t, "runs only without privilege")
    }
    let c = process.Command {
        program: "/bin/sh"
        args: ["-c", "echo ran"]
        stdout: process.Stdio.Piped
        credentials: process.Credentials { uid: sys.uid(), gid: sys.gid() }
    }
    using child = process.start(c) catch {
        e => {
            testing.error_if(t, e != io.Error.Denied, "failed with {e}, not Denied")
            return
        }
    }
    testing.error(t, "the child ran without the right to set its groups")
}

fn test_identity_helper(t: *testing.T) {
    if os.env(namespace_variable) == none {
        testing.skip(t, "runs only inside the user namespace test_identity_switches_user_and_groups makes")
    }
    print("inside the namespace")
    let c = process.Command {
        program: "/bin/sh"
        args: ["-c", "echo $(id -u) $(id -g) $(id -G)"]
        stdout: process.Stdio.Piped
        credentials: process.Credentials { uid: 1000, gid: 1001, groups: [1002, 1003] }
    }
    let out = process.run(c, []) or panic("run")
    print(str(out.stdout))
}

fn test_identity_switches_user_and_groups(t: *testing.T) {
    if sys.euid() == 0 {
        testing.skip(t, "the namespace maps the caller's own user as root")
    }
    let unshare = process.find("unshare") ?? ""
    if unshare.len == 0 {
        testing.skip(t, "unshare is not installed")
    }
    var env = os.environment()
    env[namespace_variable] = "1"
    let c = process.Command {
        program: unshare
        args: ["--map-auto", "--map-root-user", os.executable() or panic("executable"), "-one", "identity_helper", "-v"]
        env: some(env)
        stdout: process.Stdio.Piped
        stderr: process.Stdio.Piped
    }
    let out = process.run(c, []) or panic("run unshare")
    let found = text.contains(str(out.stdout), "1000 1001 1001 1002 1003")
    if !text.contains(str(out.stdout), "inside the namespace") {
        testing.skip(t, "this host gives the user no subordinate ids: {text.trim(str(out.stderr))}")
    }
    testing.error_if(t, !found, "the child did not run as 1000:1001 with 1002 and 1003: {str(out.stdout)}")
}
