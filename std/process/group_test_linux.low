import std/file
import std/os
import std/process
import signals = std/os/signal
import std/sys
import std/testing
import std/text
import std/time
import std/time/duration

const helper_variable = "LOW_TEST_GROUP_PARENT"

fn wait_until(ready: fn() -> bool) -> bool {
    for attempt in 0..250 {
        if ready() {
            return true
        }
        time.sleep_for(duration.milliseconds(20))
    }
    false
}

fn ended(pid: i64) -> bool {
    let status = file.read_text("/proc/{pid}/status") catch {
        e => return true
    }
    text.contains(status, "State:\tZ")
}

fn test_group_parent_helper(t: *testing.T) {
    let report = os.env(helper_variable) ?? ""
    if report.len == 0 {
        testing.skip(t, "runs only as the parent that test_grouped_child_ends_with_its_parent kills")
    }
    let sleeper = process.Command {
        program: "sleep"
        args: ["600"]
        stdin: process.Stdio.Null
        stdout: process.Stdio.Null
        stderr: process.Stdio.Null
        group: true
    }
    using child = process.start(sleeper) or panic("start sleep")
    file.write_text(report, "{child.handle.pid}") or panic("write pid")
    time.sleep_for(duration.seconds(600))
}

fn test_grouped_child_ends_with_its_parent(t: *testing.T) {
    if process.find("sleep") == none {
        testing.skip(t, "sleep is not installed")
    }
    let dir = file.temp_dir("group-test") or panic("temp dir")
    let report = "{dir}/pid"
    var env = os.environment()
    env[helper_variable] = report
    let parent = process.Command {
        program: os.executable() or panic("executable")
        args: ["-one", "group_parent_helper", "-timeout", "0"]
        env: some(env)
        stdin: process.Stdio.Null
        stdout: process.Stdio.Null
        stderr: process.Stdio.Null
    }
    using helper = process.start(parent) or panic("start parent")
    let started = wait_until(fn() file.exists(report))
    var pid = 0
    if started {
        pid = text.parse_int(text.trim(file.read_text(report) or "")) or 0
    }
    let before = pid > 0 && !ended(pid)
    process.kill(helper, signals.Signal.Kill) or {}
    let after = before && wait_until(fn() ended(pid))
    if pid > 0 {
        sys.kill(pid, 9) or {}
    }
    file.remove_all(dir) or {}
    testing.fatal_if(t, !before, "the parent did not start its grouped child")
    testing.error_if(t, !after, "the grouped child {pid} outlived its killed parent")
}
