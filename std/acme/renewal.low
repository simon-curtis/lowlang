import std/base64
import std/crypto/x509
import std/http
import std/json
import std/text
import std/time/duration
import std/time/timestamp

/// The renewal window the server suggests for a certificate (RFC 9773).
pub struct RenewalWindow {
    /// The start of the suggested window as Unix seconds.
    pub start: i64
    /// The end of the suggested window as Unix seconds.
    pub end: i64
    /// The `explanationURL` for a window that is not the default, or the empty string.
    pub explanation_url: str
    /// How long the server asks the client to wait before it asks again, from the `Retry-After` header, or `none`.
    pub retry_after: duration.Duration?
}

/// Returns the ARI certificate identifier (RFC 9773 section 4.1) for a certificate with the authority key identifier `authority_key` and the serial number `serial`.
///
/// It is the Base64url encoding of the key identifier, a dot, and the Base64url encoding of the content bytes of the serial number integer, both without padding. `Certificate.authority_key_id` and `Certificate.serial` have those bytes.
pub fn renewal_id_of(authority_key: []u8, serial: []u8) -> str {
    let key = base64.encode_url(authority_key)
    let number = base64.encode_url(serial)
    "{key}.{number}"
}

/// Returns the ARI certificate identifier of the DER certificate `certificate`.
///
/// Fails with `Crypto` when it does not parse and with `Unsupported` when it has no authority key identifier.
pub fn renewal_id(certificate: []u8) -> str ! Error {
    let parsed = x509.parse(certificate) catch { e => fail crypto_failure(e) }
    if parsed.authority_key_id.len == 0 {
        fail Unsupported("the certificate has no authority key identifier")
    }
    renewal_id_of(parsed.authority_key_id, parsed.serial)
}

fn rfc3339_seconds(v: json.Value, name: str) -> i64 ! Error {
    let value = json.text_of(v, name)
    let at = timestamp.parse(value) catch { _ => fail Protocol("the renewal window has no valid {name}") }
    timestamp.unix_seconds(at)
}

/// Asks the server for the renewal window of the DER certificate `certificate` (RFC 9773 section 4.2).
///
/// The request is a plain `GET` and needs no account. Fails with `Unsupported` when the directory has no `renewalInfo`, with `Server` when the server does not know the certificate, and with `Protocol` for a response without a valid window.
pub fn renewal_info(c: *Client, certificate: []u8) -> RenewalWindow ! Error {
    let base = c.directory.renewal_info
    if base.len == 0 {
        fail Unsupported("the server does not offer renewalInfo")
    }
    let id = renewal_id(certificate)?
    let url = if text.ends_with(base, "/") { "{base}{id}" } else { "{base}/{id}" }
    check_cancelled(c)?
    let resp = http.get(c.options.http, url) catch { e => fail http_failure(e) }
    if !is_success(resp.status) {
        fail Server(problem_from_response(resp.status, resp.body))
    }
    let parsed = json.parse(resp.body) catch { _ => fail Protocol("the renewal info is not JSON") }
    let window = json.field(parsed, "suggestedWindow")
    let start = rfc3339_seconds(window, "start")?
    let end = rfc3339_seconds(window, "end")?
    if end < start {
        fail Protocol("the renewal window ends before it starts")
    }
    RenewalWindow { start, end, explanation_url: json.text_of(parsed, "explanationURL"), retry_after: retry_after(c, resp.headers) }
}
