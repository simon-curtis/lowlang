import std/base64
import std/crypto/x509
import std/header
import std/http
import std/json
import std/net
import std/text
import std/time/duration

/// A name a certificate is issued for (RFC 8555 section 9.7.7, RFC 8738).
pub struct Identifier {
    /// The identifier type: `dns` or `ip`.
    pub kind: str
    /// The domain name, or the IP address in text form.
    pub value: str
}

/// Returns the identifier of `name`: an `ip` identifier when `name` is an IPv4 or IPv6 address in text form, a `dns` identifier otherwise.
pub fn identifier(name: str) -> Identifier {
    let parsed = net.parse_ip(name) catch { _ => return Identifier { kind: "dns", value: name } }
    Identifier { kind: "ip", value: net.format_ip(parsed) }
}

/// What `new_order` asks the server for.
pub struct OrderRequest {
    /// The identifiers the certificate covers.
    pub identifiers: []Identifier
    /// The requested `notBefore` as an RFC 3339 time, or the empty string to leave it to the server.
    pub not_before: str = ""
    /// The requested `notAfter` as an RFC 3339 time, or the empty string.
    pub not_after: str = ""
    /// The certificate profile (name from `Directory.profiles`), or the empty string.
    pub profile: str = ""
    /// The ARI certificate identifier of the certificate this order replaces (`renewal_id`, RFC 9773), or the empty string.
    pub replaces: str = ""
}

/// An order (RFC 8555 section 7.1.3) as the server last reported it.
pub struct Order {
    /// The order URL.
    pub url: str
    /// The status: `pending`, `ready`, `processing`, `valid` or `invalid`.
    pub status: str
    /// The `expires` time as the server wrote it, or the empty string.
    pub expires: str
    /// The identifiers of the order.
    pub identifiers: []Identifier
    /// The authorization URLs, one per identifier.
    pub authorizations: []str
    /// The URL a CSR is posted to.
    pub finalize: str
    /// The URL of the certificate once the order is `valid`, or the empty string.
    pub certificate: str
    /// The problem that made the order `invalid`, or `none`.
    pub error: Problem?
    /// The ARI certificate identifier the order replaces, or the empty string.
    pub replaces: str
}

/// One way to prove control of an identifier (RFC 8555 section 8).
pub struct Challenge {
    /// The challenge type, such as `http-01`, `dns-01` or `tls-alpn-01`.
    pub kind: str
    /// The URL a response is posted to.
    pub url: str
    /// The token the key authorization is built from.
    pub token: str
    /// The status: `pending`, `processing`, `valid` or `invalid`.
    pub status: str
    /// The problem that made the challenge `invalid`, or `none`.
    pub error: Problem?
}

/// An authorization (RFC 8555 section 7.1.4) as the server last reported it.
pub struct Authorization {
    /// The authorization URL.
    pub url: str
    /// The identifier it is for. A wildcard authorization names the base domain, without `*.`, and has `wildcard` set.
    pub identifier: Identifier
    /// The status: `pending`, `valid`, `invalid`, `deactivated`, `expired` or `revoked`.
    pub status: str
    /// Whether the order asked for a wildcard name; only `dns-01` can prove it.
    pub wildcard: bool
    /// The challenges the server offers.
    pub challenges: []Challenge
}

/// A certificate chain downloaded from an order.
pub struct Chain {
    /// The PEM text as the server sent it: the leaf first, then the issuing certificates.
    pub pem: str
    /// The DER certificates of `pem`, leaf first.
    pub certificates: [][]u8
    /// The URLs of the alternate chains the server offers (`Link` headers with `rel="alternate"`), each to give to `download_chain`.
    pub alternates: []str
}

fn identifier_of(v: json.Value) -> Identifier {
    Identifier { kind: json_text(v, "type"), value: json_text(v, "value") }
}

fn identifier_value(i: Identifier) -> json.Value {
    let members: []json.Member = [json.text_member("type", i.kind), json.text_member("value", i.value)]
    json.object_value(members)
}

fn identifiers_of(v: json.Value) -> []Identifier {
    var out: []Identifier = []
    match json.field(v, "identifiers") {
        Array(items) => {
            for item in items {
                push(mut out, identifier_of(item))
            }
        }
        _ => {}
    }
    out
}

fn problem_member(v: json.Value, name: str) -> Problem? {
    match json.field(v, name) {
        Object(members) => problem_of(json.Value.Object(members), 0)
        _ => none
    }
}

fn order_of(url: str, v: json.Value) -> Order {
    Order {
        url,
        status: json_text(v, "status"),
        expires: json_text(v, "expires"),
        identifiers: identifiers_of(v),
        authorizations: text_list(v, "authorizations"),
        finalize: json_text(v, "finalize"),
        certificate: json_text(v, "certificate"),
        error: problem_member(v, "error"),
        replaces: json_text(v, "replaces"),
    }
}

fn challenge_of(v: json.Value) -> Challenge {
    Challenge {
        kind: json_text(v, "type"),
        url: json_text(v, "url"),
        token: json_text(v, "token"),
        status: json_text(v, "status"),
        error: problem_member(v, "error"),
    }
}

fn authorization_of(url: str, v: json.Value) -> Authorization {
    var challenges: []Challenge = []
    match json.field(v, "challenges") {
        Array(items) => {
            for item in items {
                push(mut challenges, challenge_of(item))
            }
        }
        _ => {}
    }
    let wildcard = match json.field(v, "wildcard") {
        Bool(b) => b
        _ => false
    }
    Authorization { url, identifier: identifier_of(json.field(v, "identifier")), status: json_text(v, "status"), wildcard, challenges }
}

fn order_request_value(request: OrderRequest) -> json.Value {
    var names: []json.Value = []
    for i in request.identifiers {
        push(mut names, identifier_value(i))
    }
    var members: []json.Member = [json.array_member("identifiers", names)]
    if request.not_before.len > 0 {
        push(mut members, json.text_member("notBefore", request.not_before))
    }
    if request.not_after.len > 0 {
        push(mut members, json.text_member("notAfter", request.not_after))
    }
    if request.profile.len > 0 {
        push(mut members, json.text_member("profile", request.profile))
    }
    if request.replaces.len > 0 {
        push(mut members, json.text_member("replaces", request.replaces))
    }
    json.object_value(members)
}

/// Places an order for `request.identifiers` with account `a` and returns it.
///
/// The server answers with the authorizations to complete. A server that refuses a name fails with `Server` of kind `RejectedIdentifier` and a `compound` problem carries a `Subproblem` per name.
pub fn new_order(c: *Client, a: Account, request: OrderRequest) -> Order ! Error {
    if request.identifiers.len == 0 {
        fail Unsupported("an order needs at least one identifier")
    }
    let payload = order_request_value(request)
    let signer = account_signer(a)
    let reply = post_json(c, c.directory.new_order, signer, payload)?
    let url = location(reply)?
    let body = parse_body(reply)?
    order_of(url, body)
}

/// Fetches order `url` and returns it as the server reports it now.
pub fn get_order(c: *Client, a: Account, url: str) -> Order ! Error {
    let signer = account_signer(a)
    let reply = post_as_get(c, url, signer)?
    let body = parse_body(reply)?
    order_of(url, body)
}

/// Fetches authorization `url` and returns it as the server reports it now.
pub fn get_authorization(c: *Client, a: Account, url: str) -> Authorization ! Error {
    let signer = account_signer(a)
    let reply = post_as_get(c, url, signer)?
    let body = parse_body(reply)?
    authorization_of(url, body)
}

/// Tells the server that the response to `ch` is in place and returns the challenge as the server reports it.
///
/// The server then validates and the challenge moves to `processing`, then `valid` or `invalid`; follow it with `wait_authorization`.
pub fn respond(c: *Client, a: Account, ch: Challenge) -> Challenge ! Error {
    let signer = account_signer(a)
    let payload = json.object_value([])
    let reply = post_json(c, ch.url, signer, payload)?
    let body = parse_body(reply)?
    challenge_of(body)
}

fn rejection(authz: Authorization) -> Error {
    for ch in authz.challenges {
        if ch.status == "invalid" {
            match ch.error {
                some(problem) => return Error.Rejected(authz.identifier.value, problem)
                none => {}
            }
        }
    }
    let missing = Problem {
        kind: ProblemKind.Other, type_uri: "", detail: "authorization {authz.status}", status: 0, instance: "", subproblems: [],
    }
    Error.Rejected(authz.identifier.value, missing)
}

fn poll_delay(c: *Client, headers: []header.Header, started: duration.Duration) -> duration.Duration ! Error {
    let wait = poll_wait(c, headers)
    let spent = duration.minus(c.options.clock.monotonic(), started)
    let after = duration.plus(spent, wait)
    if duration.after(after, c.options.poll_timeout) {
        fail Timeout
    }
    wait
}

/// Polls authorization `url` until it is `valid` and returns it.
///
/// Between polls it waits for the server's `Retry-After` or `Options.poll_interval`, on `Options.clock`. Fails with `Rejected` when the authorization becomes `invalid`, `deactivated`, `expired` or `revoked`, naming the identifier and the problem of the failed challenge, with `Timeout` after `Options.poll_timeout`, and with `Cancelled` when the token is cancelled.
pub fn wait_authorization(c: *Client, a: Account, url: str) -> Authorization ! Error {
    let started = c.options.clock.monotonic()
    let signer = account_signer(a)
    for true {
        let reply = post_as_get(c, url, signer)?
        let body = parse_body(reply)?
        let authz = authorization_of(url, body)
        if authz.status == "valid" {
            return authz
        }
        if authz.status != "pending" && authz.status != "processing" {
            fail rejection(authz)
        }
        let wait = poll_delay(c, reply.headers, started)?
        pause(c, wait)?
    }
    fail Timeout
}

fn order_failure(order: Order) -> Error {
    match order.error {
        some(problem) => Error.OrderFailed(problem)
        none => Error.OrderFailed(Problem {
            kind: ProblemKind.Other, type_uri: "", detail: "order {order.status}", status: 0, instance: "", subproblems: [],
        })
    }
}

/// Polls order `url` until its status is `target`, or `valid` when `target` is `ready` and the order is already past it, and returns it.
///
/// Between polls it waits as `wait_authorization` does. Fails with `OrderFailed` when the order becomes `invalid`, with `Timeout` after `Options.poll_timeout` and with `Cancelled` when the token is cancelled. `target` is `ready` to wait for the authorizations, or `valid` to wait for issuance after `finalize`.
pub fn wait_order(c: *Client, a: Account, url: str, target: str) -> Order ! Error {
    let started = c.options.clock.monotonic()
    let signer = account_signer(a)
    for true {
        let reply = post_as_get(c, url, signer)?
        let body = parse_body(reply)?
        let order = order_of(url, body)
        if order.status == target || order.status == "valid" {
            return order
        }
        if order.status == "invalid" {
            fail order_failure(order)
        }
        let wait = poll_delay(c, reply.headers, started)?
        pause(c, wait)?
    }
    fail Timeout
}

/// Posts the DER certification request `csr` to the finalize URL of `order` and returns the order as the server reports it.
///
/// The order must be `ready`. Follow it with `wait_order` until `valid`. A rejected request fails with `Server`, for example of kind `BadCsr` or `OrderNotReady`.
pub fn finalize(c: *Client, a: Account, order: Order, csr: []u8) -> Order ! Error {
    let members: []json.Member = [json.text_member("csr", base64.encode_url(csr))]
    let payload = json.object_value(members)
    let signer = account_signer(a)
    let reply = post_json(c, order.finalize, signer, payload)?
    let body = parse_body(reply)?
    order_of(order.url, body)
}

fn alternate_links(links: []str) -> []str {
    var out: []str = []
    for link in links {
        for part in text.split(link, ',') {
            let piece = text.trim(part)
            let open = text.index_byte(piece, '<')
            let close = text.index_byte(piece, '>')
            if open != 0 || close < 0 || !text.contains(piece[close..], "alternate") {
                continue
            }
            push(mut out, piece[1..close])
        }
    }
    out
}

/// Downloads the certificate chain at `url`: the `certificate` URL of a `valid` order, or one of `Chain.alternates`.
///
/// The server sends `application/pem-certificate-chain`. Fails with `Protocol` when the body holds no certificate.
pub fn download_chain(c: *Client, a: Account, url: str) -> Chain ! Error {
    let signer = account_signer(a)
    let reply = post_accepting(c, url, signer, [], "application/pem-certificate-chain")?
    let pem = str(reply.body)
    let certificates = x509.pem_certificates(pem)
    if certificates.len == 0 {
        fail Protocol("the certificate response holds no certificate")
    }
    let links = header.values(reply.headers, "link")
    Chain { pem, certificates, alternates: alternate_links(links) }
}
