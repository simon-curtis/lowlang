import std/file
import std/io
import std/sync
import std/text

/// Where a renewal manager keeps its account key and certificates: two functions over named byte strings.
///
/// A name is a short file-like string such as `account.pem`. A store may be shared by several managers only if their names do not meet; none of the functions is called from two green threads at once for one manager.
pub struct Store {
    /// Returns the bytes saved under `name`, or an empty slice when nothing is saved. Fails with `io.Error` when the store cannot be read.
    pub read: fn(str) -> u8[] ! io.Error
    /// Saves `data` under `name`, replacing what was there, so that a reader sees either the old or the new bytes whole. Fails with `io.Error` when the store cannot be written.
    pub write: fn(str, u8[]) ! io.Error
}

struct MemoryStore {
    lock: sync.Mutex
    items: [str: u8[]]
}

/// Returns a store that keeps everything in memory and loses it when the process ends.
pub fn memory_store() -> Store {
    let state = new(MemoryStore { lock: sync.mutex(), items: [:] })
    Store {
        read: fn(name: str) -> u8[] ! io.Error {
            sync.lock(state.lock)
            let found = state.items[name] ?? []
            sync.unlock(state.lock)
            found
        },
        write: fn(name: str, data: u8[]) ! io.Error {
            let copy = io.buffer(data.len)
            io.copy(copy, data)
            sync.lock(state.lock)
            state.items[name] = copy
            sync.unlock(state.lock)
        },
    }
}

fn plain_name(name: str) -> bool {
    name.len > 0 && name != "." && name != ".." && !text.contains(name, "/") && !text.contains(name, "\\") && name[0] != '.'
}

fn stage(dir: str, name: str, data: u8[]) -> str ! io.Error {
    using var t = file.temp_file(dir, "{name}.*.tmp")?
    file.write_all(t.file, data)?
    file.sync(t.file)?
    file.keep(mut t)
}

/// Returns a store that keeps one file per name in the directory `dir`, which it creates with mode `0o700` when missing.
///
/// A write goes to a new file in `dir` with mode `0o600`, is flushed with `file.sync` and then moved onto the final name, so a reader and a crash see either the old or the new file whole; a failed write removes its temporary file. A name that is empty, starts with `.` or contains a path separator is refused with `Invalid`.
pub fn directory_store(dir: str) -> Store {
    Store {
        read: fn(name: str) -> u8[] ! io.Error {
            if !plain_name(name) {
                fail Invalid
            }
            let path = file.child_path(dir, name)
            if !file.exists(path) {
                return []
            }
            file.read_file(path)?
        },
        write: fn(name: str, data: u8[]) ! io.Error {
            if !plain_name(name) {
                fail Invalid
            }
            file.mkdir_all_mode(dir, 0o700)?
            let staged = stage(dir, name, data)?
            let path = file.child_path(dir, name)
            file.rename(staged, path) catch {
                e => {
                    file.remove(staged) or {}
                    fail e
                }
            }
        },
    }
}
