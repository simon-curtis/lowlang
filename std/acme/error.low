import std/http
import std/io
import std/json
import std/text

/// The kind of an ACME problem document (RFC 8555 section 6.7), taken from the last part of its `type` URN.
pub enum ProblemKind {
    /// `accountDoesNotExist`: no account exists for the key, as answered to a lookup with `onlyReturnExisting`.
    AccountDoesNotExist
    /// `alreadyReplaced`: the certificate named by `replaces` already has a replacement order (RFC 9773).
    AlreadyReplaced
    /// `alreadyRevoked`: the certificate is already revoked.
    AlreadyRevoked
    /// `badCSR`: the certification request is not acceptable.
    BadCsr
    /// `badNonce`: the nonce was not acceptable. The client retries with a fresh one before it reports this.
    BadNonce
    /// `badPublicKey`: the server does not accept the public key.
    BadPublicKey
    /// `badRevocationReason`: the revocation reason is not allowed.
    BadRevocationReason
    /// `badSignatureAlgorithm`: the signature algorithm of the request is not supported.
    BadSignatureAlgorithm
    /// `caa`: a CAA record forbids issuance.
    Caa
    /// `compound`: the problem has `subproblems`.
    Compound
    /// `connection`: the server could not connect to the validation target.
    Connection
    /// `dns`: a DNS lookup of the validation failed.
    Dns
    /// `externalAccountRequired`: the account needs an external account binding.
    ExternalAccountRequired
    /// `incorrectResponse`: the validation response did not match.
    IncorrectResponse
    /// `invalidContact`: a contact URL is invalid.
    InvalidContact
    /// `malformed`: the request was malformed.
    Malformed
    /// `orderNotReady`: the order is not ready for finalization.
    OrderNotReady
    /// `rateLimited`: a rate limit was exceeded.
    RateLimited
    /// `rejectedIdentifier`: the server will not issue for an identifier.
    RejectedIdentifier
    /// `serverInternal`: the server failed.
    ServerInternal
    /// `tls`: the server could not complete a TLS handshake with the validation target.
    Tls
    /// `unauthorized`: the client lacks authorization.
    Unauthorized
    /// `unsupportedContact`: a contact URL scheme is not supported.
    UnsupportedContact
    /// `unsupportedIdentifier`: an identifier type is not supported.
    UnsupportedIdentifier
    /// `userActionRequired`: a person must act, at the URL in `Problem.instance`.
    UserActionRequired
    /// A type that is none of the above; `Problem.type_uri` has it.
    Other
}

/// An error the server found in one identifier of a request, from a `compound` problem.
pub struct Subproblem {
    /// The kind of the subproblem.
    pub kind: ProblemKind
    /// The `type` URI of the subproblem.
    pub type_uri: str
    /// The human readable explanation, or the empty string.
    pub detail: str
    /// The identifier type, such as `dns`, or the empty string when the subproblem names none.
    pub identifier_type: str
    /// The identifier value, or the empty string.
    pub identifier: str
}

/// A problem document (RFC 7807 as profiled by RFC 8555 section 6.7).
pub struct Problem {
    /// The kind, taken from `type_uri`.
    pub kind: ProblemKind
    /// The `type` member in full, such as `urn:ietf:params:acme:error:badNonce`.
    pub type_uri: str
    /// The human readable explanation, or the empty string.
    pub detail: str
    /// The HTTP status of the response that carried the document, or `0` for a document nested in an object.
    pub status: i64
    /// The `instance` member, or the empty string.
    pub instance: str
    /// The `subproblems` of a `compound` problem, in order. Empty otherwise.
    pub subproblems: []Subproblem
}

/// What can go wrong in a call of `std/acme`.
pub enum Error {
    /// The HTTP request failed before the server answered, or the response was not valid HTTP.
    Http(cause: http.Error)
    /// The server answered with a problem document, or with an error status and a body that is not one (kind `Other`).
    Server(problem: Problem)
    /// The server's answer was not what the protocol allows: a missing header or member, an unusable value or an unexpected status. `message` says which.
    Protocol(message: str)
    /// A key, request, certificate or encoding the call needed was rejected locally. `cause` is `Invalid`, `Malformed` or `Unsupported`.
    Crypto(cause: io.Error)
    /// An authorization became `invalid`. `identifier` is its identifier and `problem` the error of the challenge that failed, or kind `Other` with no detail when the server gave none.
    Rejected(identifier: str, problem: Problem)
    /// The order became `invalid`. `problem` is its `error` member.
    OrderFailed(problem: Problem)
    /// Waiting for an authorization or order to leave `pending`, `ready` or `processing` took longer than `Options.poll_timeout`.
    Timeout
    /// The cancel token of the client was cancelled.
    Cancelled
    /// The call cannot proceed with what it was given: `message` says what is missing, such as a solver for any challenge the server offers.
    Unsupported(message: str)
    /// A function the caller supplied for a DNS-01 solver failed. `cause` is its error.
    Solver(cause: io.Error)
    /// The store of a renewal manager failed. `cause` is its error.
    Store(cause: io.Error)
}

fn problem_kind(suffix: str) -> ProblemKind {
    match suffix {
        "accountDoesNotExist" => ProblemKind.AccountDoesNotExist
        "alreadyReplaced" => ProblemKind.AlreadyReplaced
        "alreadyRevoked" => ProblemKind.AlreadyRevoked
        "badCSR" => ProblemKind.BadCsr
        "badNonce" => ProblemKind.BadNonce
        "badPublicKey" => ProblemKind.BadPublicKey
        "badRevocationReason" => ProblemKind.BadRevocationReason
        "badSignatureAlgorithm" => ProblemKind.BadSignatureAlgorithm
        "caa" => ProblemKind.Caa
        "compound" => ProblemKind.Compound
        "connection" => ProblemKind.Connection
        "dns" => ProblemKind.Dns
        "externalAccountRequired" => ProblemKind.ExternalAccountRequired
        "incorrectResponse" => ProblemKind.IncorrectResponse
        "invalidContact" => ProblemKind.InvalidContact
        "malformed" => ProblemKind.Malformed
        "orderNotReady" => ProblemKind.OrderNotReady
        "rateLimited" => ProblemKind.RateLimited
        "rejectedIdentifier" => ProblemKind.RejectedIdentifier
        "serverInternal" => ProblemKind.ServerInternal
        "tls" => ProblemKind.Tls
        "unauthorized" => ProblemKind.Unauthorized
        "unsupportedContact" => ProblemKind.UnsupportedContact
        "unsupportedIdentifier" => ProblemKind.UnsupportedIdentifier
        "userActionRequired" => ProblemKind.UserActionRequired
        _ => ProblemKind.Other
    }
}

fn kind_of(type_uri: str) -> ProblemKind {
    let prefix = "urn:ietf:params:acme:error:"
    if text.starts_with(type_uri, prefix) {
        return problem_kind(type_uri[prefix.len..])
    }
    ProblemKind.Other
}

fn subproblem_of(v: json.Value) -> Subproblem {
    let type_uri = json.text_of(v, "type")
    let identifier = json.field(v, "identifier")
    Subproblem {
        kind: kind_of(type_uri),
        type_uri,
        detail: json.text_of(v, "detail"),
        identifier_type: json.text_of(identifier, "type"),
        identifier: json.text_of(identifier, "value"),
    }
}

fn problem_of(v: json.Value, status: i64) -> Problem {
    let type_uri = json.text_of(v, "type")
    var subproblems: []Subproblem = []
    match json.field(v, "subproblems") {
        Array(items) => {
            for item in items {
                push(mut subproblems, subproblem_of(item))
            }
        }
        _ => {}
    }
    Problem {
        kind: kind_of(type_uri),
        type_uri,
        detail: json.text_of(v, "detail"),
        status,
        instance: json.text_of(v, "instance"),
        subproblems,
    }
}

fn problem_from_response(status: i64, body: []u8) -> Problem {
    let parsed = json.parse(body) catch {
        _ => return Problem { kind: ProblemKind.Other, type_uri: "", detail: str(body), status, instance: "", subproblems: [] }
    }
    problem_of(parsed, status)
}

fn problem_text(p: Problem) -> str {
    let name = if p.type_uri.len > 0 { p.type_uri } else { "no type" }
    if p.detail.len == 0 {
        return "{name} (status {p.status})"
    }
    "{name}: {p.detail} (status {p.status})"
}

/// Returns a one line description of `e` for a log or an error message.
pub fn describe(e: Error) -> str {
    match e {
        Http(_) => "http request failed"
        Server(problem) => "server problem {problem_text(problem)}"
        Protocol(message) => "unexpected response: {message}"
        Crypto(_) => "key or encoding rejected"
        Rejected(identifier, problem) => "authorization of {identifier} failed: {problem_text(problem)}"
        OrderFailed(problem) => "order failed: {problem_text(problem)}"
        Timeout => "timed out"
        Cancelled => "cancelled"
        Unsupported(message) => "unsupported: {message}"
        Solver(_) => "dns record function failed"
        Store(_) => "store failed"
    }
}
