import std/acme
import std/crypto/x509
import std/http
import std/io
import std/net
import std/text

fn account_key() -> x509.PrivateKey ! io.Error {
    let pem = text.join([
        "-----BEGIN PRIVATE KEY-----",
        "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgyzNatCiQLkYf5er1",
        "QdSFzno82KO6yDV7KbDdUsknkW6hRANCAARNRPNgAcXAMXmRO6/+LG1i7aN1dNgV",
        "zLOI0SwJYJv0Q0GMVGxB/KNbnmj+OAqdSFJvqafpWJd0JWO7uHxsoq2/",
        "-----END PRIVATE KEY-----",
        "",
    ], "\n")
    x509.pem_private_key(pem)?
}

fn serve(l: net.ListenerHandle, responses: acme.Challenges) {
    acme.serve_http01(l, responses) or {}
}

fn fetch(port: i64, path: str) -> str {
    let client = http.client().build()
    let resp = http.get(client, "http://127.0.0.1:{port}{path}") or return "request failed"
    "{resp.status} {str(resp.body)}"
}

/// Computes what each challenge type puts in place, serves an HTTP-01 response from a loopback listener and builds a certificate request, without contacting a server.
fn main() ! io.Error {
    let key = account_key()?
    let token = "evaGxfADs6pSRb2LAv9IZf17Dt3juxGJ-PCt92wr-oA"
    let challenge = acme.Challenge { kind: "http-01", url: "", token, status: "pending", error: none }
    let authorization = acme.key_authorization(challenge, key)
    print("key authorization: {authorization}")
    print("http-01 path: {acme.http01_path(token)}")
    print("dns-01 record: {acme.dns01_name("*.example.org")} TXT {acme.dns01_value(authorization)}")
    print("tls-alpn-01 name: {acme.tls_alpn_server_name(acme.identifier("192.0.2.7"))}")

    using l = net.listen("127.0.0.1", 0)?
    let responses = acme.challenges()
    spawn serve(l.handle, responses)
    let port = l.handle.addr.port
    print("before put_token: {fetch(port, acme.http01_path(token))}")
    acme.put_token(responses, token, authorization)
    print("after put_token: {fetch(port, acme.http01_path(token))}")
    acme.drop_token(responses, token)
    print("after drop_token: {fetch(port, acme.http01_path(token))}")

    let request = acme.OrderRequest { identifiers: [acme.identifier("example.org"), acme.identifier("www.example.org"), acme.identifier("192.0.2.7")] }
    let leaf_key = x509.generate_private_key(x509.KeyType.P256)?
    let csr = acme.csr_for(request, leaf_key) or {
        print("csr failed")
        return
    }
    let parsed = x509.parse_request(csr)?
    print("csr subject: {parsed.common_name}")
    print("csr names: {text.join(parsed.dns_names, ", ")} and {parsed.ip_addresses.len} address")
    print("csr signature: {x509.check_request_signature(parsed)}")
}
