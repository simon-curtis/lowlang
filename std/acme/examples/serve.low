import std/acme
import std/http
import std/io
import std/net
import std/os
import std/tls

fn app(req: http.Request) -> http.Response {
    http.response(200, "hello over a certificate that renews itself\n")
}

fn serve_plain(l: net.ListenerHandle, responses: acme.Challenges) {
    acme.serve_http01(l, responses) or {}
}

/// Serves HTTPS with a certificate from an ACME server and renews it before it expires: `serve <directory-url> <name> [listen-host]`.
///
/// The names must resolve to this host. Port 80 answers HTTP-01 validation from the same table the manager fills, and TLS-ALPN-01 is answered on the TLS listener, so either method works.
fn main() ! io.Error {
    let args = os.args()
    if args.len < 3 {
        print("usage: serve <directory-url> <name> [listen-host]")
        return
    }
    let host = if args.len > 3 { args[3] } else { "0.0.0.0" }
    let options = acme.Options { directory: args[1], http: http.client().build() }
    let client = acme.connect(options) catch {
        e => {
            print("directory: {acme.describe(e)}")
            return
        }
    }
    let responses = acme.challenges()
    let config = acme.ManagerConfig {
        client,
        store: acme.directory_store("acme-state"),
        names: [[args[2]]],
        solvers: acme.Solvers { challenges: some(responses) },
        terms_agreed: true,
        observer: some(fn(ev: acme.Event) {
            match ev {
                Obtained(names, reason) => print("certificate obtained ({reason})")
                Failed(names, error) => print("certificate failed: {acme.describe(error)}")
            }
        }),
    }
    let manager = acme.manager(config) catch {
        e => {
            print("account: {acme.describe(e)}")
            return
        }
    }
    acme.start(manager)

    using plain = net.listen(host, 80)?
    spawn serve_plain(plain.handle, responses)
    using secure = net.listen(host, 443)?
    http.serve_tls_on(secure.handle, tls.Config { credentials: some(acme.source(manager)) }, app)?
}
