import std/parallel

/// What kind of hardware a device is, as its driver reports it.
pub enum Kind {
    /// A graphics card with its own memory.
    Discrete
    /// A GPU that shares the processor's memory.
    Integrated
    /// A GPU a virtual machine presents.
    Virtual
    /// A driver that runs kernels on the CPU, such as lavapipe.
    Software
    /// Anything else.
    Other
}

/// One device `devices` found.
pub struct Info {
    /// The position to give `open_on`.
    pub index: i64
    /// The name the driver gives the device.
    pub name: str
    /// What kind of hardware the device is.
    pub kind: Kind
    /// Whether the device runs a kernel that uses `f64` or `exp`.
    pub float64: bool
}

/// Runs every invocation of `job` on the CPU and returns when all have returned.
///
/// `job` is what `launch` gives. The invocations run the kernel's CPU build on at most `parallel.cpus()` green threads, in no defined order, so a kernel that reads an element another invocation writes sees either value. An out-of-range access panics, as it does in any function.
pub fn run_on_cpu(job: launch) {
    parallel.each(job.count, job.run)
}
