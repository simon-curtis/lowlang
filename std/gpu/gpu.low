import std/parallel

/// Runs every invocation of `job` on the CPU and returns when all have returned.
///
/// `job` is what `launch` gives. The invocations run the kernel's CPU build on at most `parallel.cpus()` green threads, in no defined order, so a kernel that reads an element another invocation writes sees either value. An out-of-range access panics, as it does in any function.
pub fn run_on_cpu(job: *__Launch) {
    parallel.each(job.count, job.run)
}
