import std/gpu

kernel fn saxpy(id: u32, a: f32, x: f32[], mut y: f32[]) {
    y[id] = a * x[id] + y[id]
}

fn main() {
    let x: f32[] = [1.0, 2.0, 3.0, 4.0]
    var y: f32[] = [10.0, 20.0, 30.0, 40.0]
    gpu.run_on_cpu(launch(saxpy, 4, 2.0, x, mut y))
    for value in y {
        print(value)
    }
}
