import std/gpu

kernel fn soften(id: u32, width: u32, src: u32[], mut dst: u32[]) {
    let column = id % width
    let left = if column == 0 { id } else { id - 1 }
    let right = if column == width - 1 { id } else { id + 1 }
    dst[id] = (src[left] + 2 * src[id] + src[right] + 2) / 4
}

fn picture() -> u32[] {
    [0, 0, 100, 0, 0, 40, 40, 40]
}

fn show(values: u32[]) {
    for value in values {
        print(value)
    }
}

fn on_device(device: gpu.Device) ! gpu.Error {
    using src = gpu.buffer[u32](device, 8)?
    using dst = gpu.buffer[u32](device, 8)?
    let pixels = src.data
    for at, value in picture() {
        pixels[at] = value
    }
    var softened = dst.data
    gpu.run(device, launch(soften, 8, 4, pixels, mut softened))?
    show(softened)
}

fn on_cpu() {
    var softened: u32[] = [0, 0, 0, 0, 0, 0, 0, 0]
    gpu.run_on_cpu(launch(soften, 8, 4, picture(), mut softened))
    show(softened)
}

fn main() ! gpu.Error {
    using device = gpu.open() catch {
        NoDevice => {
            on_cpu()
            return
        }
        failure => fail failure
    }
    on_device(device)?
}
