import std/gpu

kernel fn soften(id: u32, width: u32, src: u32[], mut dst: u32[]) {
    let column = id % width
    let left = if column == 0 { id } else { id - 1 }
    let right = if column == width - 1 { id } else { id + 1 }
    dst[id] = (src[left] + 2 * src[id] + src[right] + 2) / 4
}

fn ran(job: launch) ! gpu.Error {
    using device = gpu.open() catch {
        NoDevice => {
            gpu.run_on_cpu(job)
            return
        }
        failure => fail failure
    }
    gpu.run(device, job)?
}

fn main() ! gpu.Error {
    let src: u32[] = [0, 0, 100, 0, 0, 40, 40, 40]
    var dst: u32[] = [0, 0, 0, 0, 0, 0, 0, 0]
    ran(launch(soften, 8, 4, src, mut dst))?
    for value in dst {
        print(value)
    }
}
