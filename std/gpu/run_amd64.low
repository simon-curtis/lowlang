import std/sync

const capability: u32 = 17
const capability_float64: u32 = 10
const flag_bytes = 16

struct Buffer {
    handle: VkBuffer = VkBuffer {}
    memory: VkDeviceMemory = VkDeviceMemory {}
    size: i64 = 0
    mapped: ptr = null
}

struct Pass {
    shader: VkShaderModule = VkShaderModule {}
    bindings: VkDescriptorSetLayout = VkDescriptorSetLayout {}
    layout: VkPipelineLayout = VkPipelineLayout {}
    pipeline: VkPipeline = VkPipeline {}
    sets: VkDescriptorPool = VkDescriptorPool {}
    buffers: Buffer[] = []
}

/// Runs every invocation of `job` on the device and returns when all have finished.
///
/// `job` is what `launch` gives. `run` copies each slice to the device, runs the kernel's device build once for each index below the job's count, in no defined order, and copies the `mut` slices back. An invocation that indexes outside a slice or divides by zero stops, and `run` fails with `Faulted` after the others have run. A job with a count of zero runs nothing.
pub fn run(d: Device, job: *__Launch) ! Error {
    let s = d.state
    sync.lock(s.running)
    defer sync.unlock(s.running)
    if s.handle.handle == null {
        fail NoDevice
    }
    if job.count == 0 {
        return
    }
    if uses_float64(job.module) && !s.float64 {
        fail NoFloat64(s.name)
    }
    let pass = new(Pass {})
    defer destroy_pass(s, pass)
    build_pass(s, pass, job)?
    upload(pass, job)
    dispatch(s, pass, job)?
    download(pass, job)
    fault(pass)?
}

fn word(module: u8[], at: i64) -> u32 {
    u32(module[at]) | u32(module[at + 1]) << 8 | u32(module[at + 2]) << 16 | u32(module[at + 3]) << 24
}

fn uses_float64(module: u8[]) -> bool {
    var at = 20
    for at + 8 <= module.len && word(module, at) & 0xFFFF == capability {
        if word(module, at + 4) == capability_float64 {
            return true
        }
        at += 8
    }
    false
}

fn mapped_type(s: *State, allowed: u32) -> u32 ! Error {
    let wanted = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT
    for i, kind in s.memory_types {
        let bit: u32 = 1 << i
        if allowed & bit != 0 && kind.propertyFlags & wanted == wanted {
            return u32(i)
        }
    }
    fail NoMemoryType(allowed)
}

fn add_buffer(s: *State, pass: *Pass, bytes: i64) ! Error {
    let size = if bytes < 4 { 4 } else { (bytes + 3) / 4 * 4 }
    pass.buffers.push(Buffer { size })
    let at = pass.buffers.len - 1
    var info = VkBufferCreateInfo { size, usage: VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, sharingMode: VK_SHARING_MODE_EXCLUSIVE }
    check(vkCreateBuffer(s.handle, mut info, null, mut pass.buffers[at].handle), "vkCreateBuffer")?
    var needs = VkMemoryRequirements {}
    vkGetBufferMemoryRequirements(s.handle, pass.buffers[at].handle, mut needs)
    var wanted = VkMemoryAllocateInfo { allocationSize: needs.size, memoryTypeIndex: mapped_type(s, needs.memoryTypeBits)? }
    check(vkAllocateMemory(s.handle, mut wanted, null, mut pass.buffers[at].memory), "vkAllocateMemory")?
    check(vkBindBufferMemory(s.handle, pass.buffers[at].handle, pass.buffers[at].memory, 0), "vkBindBufferMemory")?
    check(vkMapMemory(s.handle, pass.buffers[at].memory, 0, size, 0, mut pass.buffers[at].mapped), "vkMapMemory")?
}

fn contents(b: Buffer) -> u8[] {
    let at: ptr[u8] = b.mapped
    view(at, b.size)
}

fn held(o: __Operand) -> u8[] {
    let at: ptr[u8] = o.data
    view(at, o.bytes)
}

fn build_pass(s: *State, pass: *Pass, job: *__Launch) ! Error {
    using var pins = new_pins()
    let code: ptr = pins.hold_all(job.module)
    var shader = VkShaderModuleCreateInfo { codeSize: job.module.len, pCode: code }
    check(vkCreateShaderModule(s.handle, mut shader, null, mut pass.shader), "vkCreateShaderModule")?
    add_buffer(s, pass, flag_bytes)?
    for o in job.operands {
        add_buffer(s, pass, o.bytes)?
    }
    var slots: VkDescriptorSetLayoutBinding[] = []
    for i in 0..pass.buffers.len {
        slots.push(VkDescriptorSetLayoutBinding { binding: u32(i), descriptorType: VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, descriptorCount: 1, stageFlags: VK_SHADER_STAGE_COMPUTE_BIT })
    }
    var bindings = VkDescriptorSetLayoutCreateInfo { bindingCount: u32(slots.len), pBindings: pins.hold_all(slots) }
    check(vkCreateDescriptorSetLayout(s.handle, mut bindings, null, mut pass.bindings), "vkCreateDescriptorSetLayout")?
    let layouts = pins.hold_all([pass.bindings])
    let constants = pins.hold(VkPushConstantRange { stageFlags: VK_SHADER_STAGE_COMPUTE_BIT, size: u32(job.constants.len) })
    var layout = VkPipelineLayoutCreateInfo { setLayoutCount: 1, pSetLayouts: layouts, pushConstantRangeCount: 1, pPushConstantRanges: constants }
    check(vkCreatePipelineLayout(s.handle, mut layout, null, mut pass.layout), "vkCreatePipelineLayout")?
    let entry: ptr[u8] = pins.hold_all(bytes("main\0"))
    let stage = VkPipelineShaderStageCreateInfo { stage: VK_SHADER_STAGE_COMPUTE_BIT, module: pass.shader, pName: entry }
    let made: VkPipeline[] = [VkPipeline {}]
    let wanted = pins.hold_all([VkComputePipelineCreateInfo { stage, layout: pass.layout }])
    check(vkCreateComputePipelines(s.handle, VkPipelineCache {}, 1, wanted, null, pins.hold_all(made)), "vkCreateComputePipelines")?
    pass.pipeline = made[0]
    let sizes = pins.hold(VkDescriptorPoolSize { type: VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, descriptorCount: u32(pass.buffers.len) })
    var pool = VkDescriptorPoolCreateInfo { maxSets: 1, poolSizeCount: 1, pPoolSizes: sizes }
    check(vkCreateDescriptorPool(s.handle, mut pool, null, mut pass.sets), "vkCreateDescriptorPool")?
}

fn bound_set(s: *State, pass: *Pass, mut pins: Pins) -> ptr[VkDescriptorSet] ! Error {
    let sets: VkDescriptorSet[] = [VkDescriptorSet {}]
    let at = pins.hold_all(sets)
    var wanted = VkDescriptorSetAllocateInfo { descriptorPool: pass.sets, descriptorSetCount: 1, pSetLayouts: pins.hold_all([pass.bindings]) }
    check(vkAllocateDescriptorSets(s.handle, mut wanted, at), "vkAllocateDescriptorSets")?
    var writes: VkWriteDescriptorSet[] = []
    for i, b in pass.buffers {
        let whole = pins.hold(VkDescriptorBufferInfo { buffer: b.handle, range: b.size })
        writes.push(VkWriteDescriptorSet { dstSet: sets[0], dstBinding: u32(i), descriptorCount: 1, descriptorType: VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, pBufferInfo: whole })
    }
    vkUpdateDescriptorSets(s.handle, u32(writes.len), pins.hold_all(writes), 0, null)
    at
}

fn upload(pass: *Pass, job: *__Launch) {
    for i, b in pass.buffers {
        var staged = contents(b)
        for at in 0..staged.len {
            staged[at] = 0
        }
        if i > 0 && job.operands[i - 1].bytes > 0 {
            __memmove(staged[..job.operands[i - 1].bytes], held(job.operands[i - 1]))
        }
    }
}

fn dispatch(s: *State, pass: *Pass, job: *__Launch) ! Error {
    using var pins = new_pins()
    let set = bound_set(s, pass, mut pins)?
    var begin = VkCommandBufferBeginInfo {}
    check(vkBeginCommandBuffer(s.commands, mut begin), "vkBeginCommandBuffer")?
    vkCmdBindPipeline(s.commands, VK_PIPELINE_BIND_POINT_COMPUTE, pass.pipeline)
    vkCmdBindDescriptorSets(s.commands, VK_PIPELINE_BIND_POINT_COMPUTE, pass.layout, 0, 1, set, 0, null)
    let constants: ptr = pins.hold_all(job.constants)
    vkCmdPushConstants(s.commands, pass.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, u32(job.constants.len), constants)
    if job.count <= job.row {
        vkCmdDispatch(s.commands, u32((job.count + job.group - 1) / job.group), 1, 1)
    } else {
        vkCmdDispatch(s.commands, u32(job.row / job.group), u32((job.count + job.row - 1) / job.row), 1)
    }
    check(vkEndCommandBuffer(s.commands), "vkEndCommandBuffer")?
    let submit = pins.hold(VkSubmitInfo { commandBufferCount: 1, pCommandBuffers: pins.hold_all([s.commands]) })
    check(vkQueueSubmit(s.queue, 1, submit, VkFence {}), "vkQueueSubmit")?
    check(vkQueueWaitIdle(s.queue), "vkQueueWaitIdle")?
}

fn download(pass: *Pass, job: *__Launch) {
    for i, o in job.operands {
        if o.mutable && o.bytes > 0 {
            __memmove(held(o), contents(pass.buffers[i + 1])[..o.bytes])
        }
    }
}

fn fault(pass: *Pass) ! Error {
    match word(contents(pass.buffers[0]), 0) {
        0 => {}
        1 => fail Faulted(Fault.OutOfRange)
        2 => fail Faulted(Fault.DivideByZero)
        _ => fail Faulted(Fault.BadAddress)
    }
}

fn destroy_pass(s: *State, pass: *Pass) {
    let _ = vkQueueWaitIdle(s.queue)
    vkDestroyDescriptorPool(s.handle, pass.sets, null)
    vkDestroyPipeline(s.handle, pass.pipeline, null)
    vkDestroyPipelineLayout(s.handle, pass.layout, null)
    vkDestroyDescriptorSetLayout(s.handle, pass.bindings, null)
    vkDestroyShaderModule(s.handle, pass.shader, null)
    for b in pass.buffers {
        vkDestroyBuffer(s.handle, b.handle, null)
        vkFreeMemory(s.handle, b.memory, null)
    }
}
