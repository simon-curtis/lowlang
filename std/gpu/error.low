/// What stopped an invocation that ran on a device.
pub enum Fault {
    /// An index was outside its slice.
    OutOfRange
    /// An integer was divided by zero, or the lowest value of its type by -1.
    DivideByZero
    /// A value was read or written outside the memory of its invocation.
    BadAddress
}

/// The ways opening a device or running on it can fail.
pub enum Error {
    /// No Vulkan 1.2 device offers 64-bit integers in shaders and a compute queue, or the device was closed.
    NoDevice
    /// A Vulkan call returned a failing result. `call` names the function and `result` is its `VkResult`.
    Vulkan(call: str, result: i32)
    /// No memory type of the device can be mapped. `allowed` is the bit set of types the buffer accepts.
    NoMemoryType(allowed: u32)
    /// The kernel uses `f64` or `exp`, and `device` has no 64-bit floats in shaders.
    NoFloat64(device: str)
    /// An invocation stopped at `fault`. The other invocations ran, and the `mut` slices hold what they wrote.
    Faulted(fault: Fault)
}

/// Returns a one-line description of `e`, naming the Vulkan call and result when there is one.
pub fn describe(e: Error) -> str {
    match e {
        NoDevice => "no open Vulkan 1.2 device with 64-bit integers in shaders and a compute queue"
        Vulkan(call, result) => "{call} failed with VkResult {result}"
        NoMemoryType(allowed) => "no memory type in {allowed:x} can be mapped"
        NoFloat64(device) => "the kernel uses f64 or exp, and {device} has no 64-bit floats in shaders"
        Faulted(fault) => match fault {
            OutOfRange => "an invocation indexed outside a slice"
            DivideByZero => "an invocation divided by zero"
            BadAddress => "an invocation read or wrote outside its memory"
        }
    }
}
