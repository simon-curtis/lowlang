extern "vulkan" {
    fn vkCreateInstance(mut pCreateInfo: VkInstanceCreateInfo, pAllocator: ptr[VkAllocationCallbacks], mut pInstance: VkInstance) -> i32
    fn vkDestroyInstance(instance: VkInstance, pAllocator: ptr[VkAllocationCallbacks])
    fn vkEnumeratePhysicalDevices(instance: VkInstance, mut pPhysicalDeviceCount: u32, pPhysicalDevices: ptr[VkPhysicalDevice]) -> i32
    fn vkGetPhysicalDeviceProperties(physicalDevice: VkPhysicalDevice, mut pProperties: VkPhysicalDeviceProperties)
    fn vkGetPhysicalDeviceFeatures(physicalDevice: VkPhysicalDevice, mut pFeatures: VkPhysicalDeviceFeatures)
    fn vkGetPhysicalDeviceQueueFamilyProperties(physicalDevice: VkPhysicalDevice, mut pQueueFamilyPropertyCount: u32, pQueueFamilyProperties: ptr[VkQueueFamilyProperties])
    fn vkGetPhysicalDeviceMemoryProperties(physicalDevice: VkPhysicalDevice, mut pMemoryProperties: VkPhysicalDeviceMemoryProperties)
    fn vkCreateDevice(physicalDevice: VkPhysicalDevice, mut pCreateInfo: VkDeviceCreateInfo, pAllocator: ptr[VkAllocationCallbacks], mut pDevice: VkDevice) -> i32
    fn vkDestroyDevice(device: VkDevice, pAllocator: ptr[VkAllocationCallbacks])
    fn vkGetDeviceQueue(device: VkDevice, queueFamilyIndex: u32, queueIndex: u32, mut pQueue: VkQueue)
    fn vkQueueSubmit(queue: VkQueue, submitCount: u32, pSubmits: ptr[VkSubmitInfo], fence: VkFence) -> i32
    fn vkQueueWaitIdle(queue: VkQueue) -> i32
    fn vkCreateBuffer(device: VkDevice, mut pCreateInfo: VkBufferCreateInfo, pAllocator: ptr[VkAllocationCallbacks], mut pBuffer: VkBuffer) -> i32
    fn vkDestroyBuffer(device: VkDevice, buffer: VkBuffer, pAllocator: ptr[VkAllocationCallbacks])
    fn vkGetBufferMemoryRequirements(device: VkDevice, buffer: VkBuffer, mut pMemoryRequirements: VkMemoryRequirements)
    fn vkBindBufferMemory(device: VkDevice, buffer: VkBuffer, memory: VkDeviceMemory, memoryOffset: i64) -> i32
    fn vkAllocateMemory(device: VkDevice, mut pAllocateInfo: VkMemoryAllocateInfo, pAllocator: ptr[VkAllocationCallbacks], mut pMemory: VkDeviceMemory) -> i32
    fn vkFreeMemory(device: VkDevice, memory: VkDeviceMemory, pAllocator: ptr[VkAllocationCallbacks])
    fn vkMapMemory(device: VkDevice, memory: VkDeviceMemory, offset: i64, size: i64, flags: u32, mut ppData: ptr) -> i32
    fn vkCreateShaderModule(device: VkDevice, mut pCreateInfo: VkShaderModuleCreateInfo, pAllocator: ptr[VkAllocationCallbacks], mut pShaderModule: VkShaderModule) -> i32
    fn vkDestroyShaderModule(device: VkDevice, shaderModule: VkShaderModule, pAllocator: ptr[VkAllocationCallbacks])
    fn vkCreateDescriptorSetLayout(device: VkDevice, mut pCreateInfo: VkDescriptorSetLayoutCreateInfo, pAllocator: ptr[VkAllocationCallbacks], mut pSetLayout: VkDescriptorSetLayout) -> i32
    fn vkDestroyDescriptorSetLayout(device: VkDevice, descriptorSetLayout: VkDescriptorSetLayout, pAllocator: ptr[VkAllocationCallbacks])
    fn vkCreateDescriptorPool(device: VkDevice, mut pCreateInfo: VkDescriptorPoolCreateInfo, pAllocator: ptr[VkAllocationCallbacks], mut pDescriptorPool: VkDescriptorPool) -> i32
    fn vkDestroyDescriptorPool(device: VkDevice, descriptorPool: VkDescriptorPool, pAllocator: ptr[VkAllocationCallbacks])
    fn vkAllocateDescriptorSets(device: VkDevice, mut pAllocateInfo: VkDescriptorSetAllocateInfo, pDescriptorSets: ptr[VkDescriptorSet]) -> i32
    fn vkUpdateDescriptorSets(device: VkDevice, descriptorWriteCount: u32, pDescriptorWrites: ptr[VkWriteDescriptorSet], descriptorCopyCount: u32, pDescriptorCopies: ptr[VkCopyDescriptorSet])
    fn vkCreatePipelineLayout(device: VkDevice, mut pCreateInfo: VkPipelineLayoutCreateInfo, pAllocator: ptr[VkAllocationCallbacks], mut pPipelineLayout: VkPipelineLayout) -> i32
    fn vkDestroyPipelineLayout(device: VkDevice, pipelineLayout: VkPipelineLayout, pAllocator: ptr[VkAllocationCallbacks])
    fn vkCreateComputePipelines(device: VkDevice, pipelineCache: VkPipelineCache, createInfoCount: u32, pCreateInfos: ptr[VkComputePipelineCreateInfo], pAllocator: ptr[VkAllocationCallbacks], pPipelines: ptr[VkPipeline]) -> i32
    fn vkDestroyPipeline(device: VkDevice, pipeline: VkPipeline, pAllocator: ptr[VkAllocationCallbacks])
    fn vkCreateCommandPool(device: VkDevice, mut pCreateInfo: VkCommandPoolCreateInfo, pAllocator: ptr[VkAllocationCallbacks], mut pCommandPool: VkCommandPool) -> i32
    fn vkDestroyCommandPool(device: VkDevice, commandPool: VkCommandPool, pAllocator: ptr[VkAllocationCallbacks])
    fn vkAllocateCommandBuffers(device: VkDevice, mut pAllocateInfo: VkCommandBufferAllocateInfo, pCommandBuffers: ptr[VkCommandBuffer]) -> i32
    fn vkBeginCommandBuffer(commandBuffer: VkCommandBuffer, mut pBeginInfo: VkCommandBufferBeginInfo) -> i32
    fn vkEndCommandBuffer(commandBuffer: VkCommandBuffer) -> i32
    fn vkCmdBindPipeline(commandBuffer: VkCommandBuffer, pipelineBindPoint: i32, pipeline: VkPipeline)
    fn vkCmdBindDescriptorSets(commandBuffer: VkCommandBuffer, pipelineBindPoint: i32, layout: VkPipelineLayout, firstSet: u32, descriptorSetCount: u32, pDescriptorSets: ptr[VkDescriptorSet], dynamicOffsetCount: u32, pDynamicOffsets: ptr[u32])
    fn vkCmdPushConstants(commandBuffer: VkCommandBuffer, layout: VkPipelineLayout, stageFlags: u32, offset: u32, size: u32, pValues: ptr)
    fn vkCmdDispatch(commandBuffer: VkCommandBuffer, groupCountX: u32, groupCountY: u32, groupCountZ: u32)
}
