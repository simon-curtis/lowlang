import std/io
import std/slices
import std/sys

/// An address assigned to a network interface.
pub struct InterfaceAddr {
    /// The address bytes in network order: 4 for IPv4, 16 for IPv6, as `parse_ip` returns.
    pub ip: u8[]
    /// The number of leading bits of `ip` that name its network, from 0 to 32 for IPv4 and 0 to 128 for IPv6.
    pub prefix: i64
}

/// A network interface of this machine.
pub struct Interface {
    /// The name of the interface: `lo` or `eth0` on Linux, the adapter's friendly name on Windows. `interface_index` takes it.
    pub name: str
    /// The kernel index of the interface, the number `interface_index` returns for `name`.
    pub index: i64
    /// Whether the interface is administratively up on Linux and operationally up on Windows.
    pub up: bool
    /// Whether the interface is a loopback interface.
    pub loopback: bool
    /// Whether the interface can send and receive multicast.
    pub multicast: bool
    /// The IPv4 and IPv6 addresses assigned to the interface, in the order the system lists them.
    pub addresses: InterfaceAddr[]
}

fn interface_addr(a: sys.InterfaceAddress) -> InterfaceAddr {
    InterfaceAddr { ip: a.ip, prefix: a.prefix }
}

fn network_interface(i: sys.Interface) -> Interface {
    let addresses = i.addresses.map(interface_addr)
    Interface { name: i.name, index: i.index, up: i.up, loopback: i.loopback, multicast: i.multicast, addresses }
}

/// Returns the network interfaces of this machine with their addresses.
///
/// Each interface carries its IPv4 and IPv6 addresses with their prefix lengths, and whether it is up, a loopback and multicast capable. An interface with no address has an empty `addresses`. The order is the system's. On Linux the list comes from rtnetlink and on Windows from `GetAdaptersAddresses`. Blocks the OS thread while it reads the system's tables.
pub fn interfaces() -> Interface[] ! io.Error {
    let found = sys.interfaces()?
    found.map(network_interface)
}
