import std/io
import std/net
import std/net/dns

fn answer(server: net.SocketHandle) {
    let buf = io.buffer(512)
    let p = net.receive_from_on(server, buf) or return
    let query = dns.decode(buf[..p.size]) or return
    var reply = query
    reply.response = true
    reply.recursion_available = true
    reply.answers = [
        dns.Record { name: query.questions[0].name, class: dns.class_in, ttl: 60, data: dns.Data.MxData(dns.Mx { preference: 20, host: "backup.example.test" }) }
        dns.Record { name: query.questions[0].name, class: dns.class_in, ttl: 60, data: dns.Data.MxData(dns.Mx { preference: 10, host: "mail.example.test" }) }
    ]
    let wire = dns.encode(reply) or return
    net.send_to_on(server, wire, p.from) or 0
}

/// Parses a `resolv.conf` text, points the resolver at a DNS server running on a loopback port and looks up the `MX` records of a name through its search list.
fn main() ! io.Error {
    using server = net.bind_udp("127.0.0.1", 0)?
    spawn answer(server.handle)

    var config = net.parse_resolv_conf("nameserver 192.0.2.1\nsearch example.test\noptions ndots:2 attempts:1 timeout:2\n", "", "")
    print("search {config.search} ndots {config.ndots} timeout {config.timeout}")
    config.servers = [server.handle.addr]
    let resolver = net.resolver(config)
    let records = net.lookup_mx(resolver, "mail") catch {
        e => {
            print("lookup failed: {e}")
            return
        }
    }
    for mx in records {
        print("{mx.preference} {mx.host}")
    }
}
