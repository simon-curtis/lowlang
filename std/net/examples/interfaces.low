import std/io
import std/net

/// Lists the network interfaces and prints the IPv4 addresses of the loopback ones.
fn main() ! io.Error {
    let found = net.interfaces()?
    var any_up = false
    for i in found {
        any_up = any_up || i.up
        for a in i.addresses {
            if i.loopback && a.ip.len == 4 {
                print("loopback {net.format_ip(a.ip)}/{a.prefix}")
            }
        }
    }
    print("up {any_up}")
}
