import std/io
import std/net

fn reply_once(s: net.SocketHandle) {
    let buf = io.buffer(64)
    let p = net.receive_from_on(s, buf) or return
    net.send_to_on(s, bytes("ack {str(buf[..p.size])}"), p.from) or 0
}

/// Sends one UDP datagram to a socket on a loopback port and prints the reply.
fn main() ! io.Error {
    using server = net.bind_udp("127.0.0.1", 0)?
    spawn reply_once(server.handle)

    using client = net.bind_udp("127.0.0.1", 0)?
    net.set_receive_timeout(client, 5000)
    net.send_to(client, bytes("ping"), server.handle.addr)?

    let buf = io.buffer(64)
    let p = net.receive_from(client, buf)?
    print(str(buf[..p.size]))
    print(p.from.port == server.handle.addr.port)
    print(net.format_ip(p.from.ip))
    print(net.in_network(p.from.ip, "127.0.0.0/8"))
}
