import std/net/idna
import std/net/publicsuffix
import std/net/punycode

fn ascii(domain: str) -> str {
    idna.to_ascii(domain, idna.Options {}) catch {
        e => "rejected: {e}"
    }
}

fn site(domain: str) -> str {
    publicsuffix.registrable_domain(domain, publicsuffix.Rules.All) ?? "none"
}

/// Converts names between Unicode and ASCII, and finds the registrable domain of a host.
fn main() {
    let encoded = punycode.encode("münchen") catch {
        e => ""
    }
    print("punycode {encoded}")
    print("ascii {ascii("München.DE")}")
    print("ascii {ascii("faß.de")}")
    print("ascii {ascii("ab--c.example")}")
    print("ascii {ascii("-bad.example")}")

    let back = idna.to_unicode("www.xn--mnchen-3ya.de", idna.Options {})
    print("unicode {back.text}")

    print("site {site("www.example.co.uk")}")
    print("site {site("a.b.github.io")}")
    print("site {site("shop.食狮.公司.cn")}")
    print("site {site("co.uk")}")
    print("suffix {publicsuffix.is_public_suffix("com", publicsuffix.Rules.All)}")
}
