import std/io
import std/net/dns
import std/text

fn describe(r: dns.Record) -> str {
    match r.data {
        Cname(target) => "{r.name} CNAME {target}"
        A(ip) => "{r.name} A {ip[0]}.{ip[1]}.{ip[2]}.{ip[3]}"
        MxData(mx) => "{r.name} MX {mx.preference} {mx.host}"
        _ => "{r.name} other"
    }
}

/// Encodes a query, then builds a reply with a `CNAME` chain and an `MX` record, encodes it with name compression and decodes it again.
fn main() ! io.Error {
    let query = dns.query(0x1234, "www.example.com", dns.type_a, 1232)
    let wire = dns.encode(query)?
    print(text.encode_hex(wire))

    var reply = dns.query(0x1234, "www.example.com", dns.type_a, 1232)
    reply.response = true
    reply.answers = [
        dns.Record { name: "www.example.com", class: dns.class_in, ttl: 300, data: dns.Data.Cname("web.example.com") }
        dns.Record { name: "web.example.com", class: dns.class_in, ttl: 60, data: dns.Data.A([192, 0, 2, 1]) }
        dns.Record { name: "example.com", class: dns.class_in, ttl: 3600, data: dns.Data.MxData(dns.Mx { preference: 10, host: "mail.example.com" }) }
    ]
    let packed = dns.encode(reply)?
    print("{packed.len} bytes")

    let decoded = dns.decode(packed)?
    for r in decoded.answers {
        print(describe(r))
    }
    print(dns.reverse_name([192, 0, 2, 1])?)
}
