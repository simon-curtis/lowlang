import std/io
import std/text

struct Packer {
    out: u8[]
    table: [str: i64]
}

fn within(v: i64, max: i64) ! io.Error {
    if v < 0 || v > max {
        fail Invalid
    }
}

fn pack_name(p: *Packer, name: str, compress: bool) ! io.Error {
    let parts = labels(name)?
    var wire: u8[] = []
    var starts: i64[] = []
    for l in parts {
        starts.push(wire.len)
        wire.push(u8(l.len))
        for c in l {
            wire.push(text.lower_byte(c))
        }
    }
    wire.push(0)
    for i, l in parts {
        if compress {
            let key = str(wire[starts[i]..])
            match p.table[key] {
                some(offset) => {
                    io.put_be16(mut p.out, 0xC000 | offset)
                    return
                }
                none => {}
            }
            if p.out.len < 0x4000 {
                p.table[key] = p.out.len
            }
        }
        p.out.push(u8(l.len))
        io.append(mut p.out, l)
    }
    p.out.push(0)
}

fn pack_data(p: *Packer, d: Data) ! io.Error {
    match d {
        A(ip) => {
            if ip.len != 4 {
                fail Invalid
            }
            io.append(mut p.out, ip)
        }
        Aaaa(ip) => {
            if ip.len != 16 {
                fail Invalid
            }
            io.append(mut p.out, ip)
        }
        Cname(target) => pack_name(p, target, true)?
        Ns(host) => pack_name(p, host, true)?
        Ptr(host) => pack_name(p, host, true)?
        MxData(mx) => {
            within(mx.preference, 0xFFFF)?
            io.put_be16(mut p.out, mx.preference)
            pack_name(p, mx.host, true)?
        }
        Txt(strings) => {
            if strings.len == 0 {
                fail Invalid
            }
            for s in strings {
                within(s.len, 255)?
                p.out.push(u8(s.len))
                io.append(mut p.out, s)
            }
        }
        SrvData(srv) => {
            within(srv.priority, 0xFFFF)?
            within(srv.weight, 0xFFFF)?
            within(srv.port, 0xFFFF)?
            io.put_be16(mut p.out, srv.priority)
            io.put_be16(mut p.out, srv.weight)
            io.put_be16(mut p.out, srv.port)
            pack_name(p, srv.target, false)?
        }
        SoaData(soa) => {
            pack_name(p, soa.mname, true)?
            pack_name(p, soa.rname, true)?
            for v in [soa.serial, soa.refresh, soa.retry, soa.expire, soa.minimum] {
                within(v, 0xFFFFFFFF)?
                io.put_be32(mut p.out, v)
            }
        }
        CaaData(caa) => {
            within(caa.flags, 255)?
            if caa.tag.len == 0 || caa.tag.len > 15 {
                fail Invalid
            }
            p.out.push(u8(caa.flags))
            p.out.push(u8(caa.tag.len))
            text.append(mut p.out, caa.tag)
            io.append(mut p.out, caa.value)
        }
        Opt(options) => {
            for o in options {
                within(o.code, 0xFFFF)?
                within(o.data.len, 0xFFFF)?
                io.put_be16(mut p.out, o.code)
                io.put_be16(mut p.out, o.data.len)
                io.append(mut p.out, o.data)
            }
        }
        Raw(_, bytes) => io.append(mut p.out, bytes)
    }
}

fn pack_record(p: *Packer, r: Record, ext: i64) ! io.Error {
    pack_name(p, r.name, true)?
    within(r.class, 0xFFFF)?
    within(r.ttl, 0xFFFFFFFF)?
    let ttl = match r.data {
        Opt(_) => r.ttl & 0xFFFFFF | ext << 24
        _ => r.ttl
    }
    io.put_be16(mut p.out, kind(r.data))
    io.put_be16(mut p.out, r.class)
    io.put_be32(mut p.out, ttl)
    let at = p.out.len
    io.put_be16(mut p.out, 0)
    pack_data(p, r.data)?
    let size = p.out.len - at - 2
    if size > 0xFFFF {
        fail TooLarge
    }
    io.set_be16(p.out, at, size)
}

fn has_opt(m: Message) -> bool {
    for r in m.additional {
        match r.data {
            Opt(_) => return true
            _ => {}
        }
    }
    false
}

fn bit(on: bool, shift: i64) -> i64 {
    if on { 1 << shift } else { 0 }
}

/// Encodes `m` as a DNS message and returns its bytes.
///
/// A name is written compressed against the names already written, except the target of an `SRV` record, whose name RFC 2782 keeps uncompressed. The counts come from the lengths of the sections. The extended bits of `rcode` go into the OPT record of `additional`. Fails with `Invalid` for a name with an empty label, a label over 63 bytes or a name over 255 bytes in wire form, a value outside the range of its field, an address of the wrong length, an `rcode` over 15 without an OPT record, or a `Txt` record with no string or a string over 255 bytes, and with `TooLarge` for a section of more than 65535 entries, record data over 65535 bytes or a message over 65535 bytes.
pub fn encode(m: Message) -> u8[] ! io.Error {
    within(m.id, 0xFFFF)?
    within(m.opcode, 15)?
    within(m.rcode, 0xFFF)?
    for n in [m.questions.len, m.answers.len, m.authority.len, m.additional.len] {
        if n > 0xFFFF {
            fail TooLarge
        }
    }
    let ext = m.rcode >> 4
    if ext != 0 && !has_opt(m) {
        fail Invalid
    }
    let p = new(Packer { out: [], table: [:] })
    io.put_be16(mut p.out, m.id)
    let flags = bit(m.response, 15) | m.opcode << 11 | bit(m.authoritative, 10) | bit(m.truncated, 9) | bit(m.recursion_desired, 8) | bit(m.recursion_available, 7) | bit(m.authentic, 5) | bit(m.checking_disabled, 4) | m.rcode & 15
    io.put_be16(mut p.out, flags)
    io.put_be16(mut p.out, m.questions.len)
    io.put_be16(mut p.out, m.answers.len)
    io.put_be16(mut p.out, m.authority.len)
    io.put_be16(mut p.out, m.additional.len)
    for q in m.questions {
        within(q.kind, 0xFFFF)?
        within(q.class, 0xFFFF)?
        pack_name(p, q.name, true)?
        io.put_be16(mut p.out, q.kind)
        io.put_be16(mut p.out, q.class)
    }
    for section in [m.answers, m.authority, m.additional] {
        for r in section {
            pack_record(p, r, ext)?
        }
    }
    if p.out.len > 0xFFFF {
        fail TooLarge
    }
    p.out
}
