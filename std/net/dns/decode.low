import std/io

fn copy(msg: u8[], from: i64, to: i64) -> u8[] {
    var out: u8[] = []
    io.append(mut out, msg[from..to])
    out
}

fn read_question(msg: u8[], mut at: i64) -> Question ! io.Error {
    let name = read_name(msg, mut at)?
    if at + 4 > msg.len {
        fail Malformed
    }
    let kind = io.be16(msg, at)
    let class = io.be16(msg, at + 2)
    at += 4
    Question { name, kind, class }
}

fn read_target(msg: u8[], from: i64, end: i64) -> str ! io.Error {
    var at = from
    let name = read_name(msg, mut at)?
    if at != end {
        fail Malformed
    }
    name
}

fn read_texts(msg: u8[], from: i64, end: i64) -> u8[][] ! io.Error {
    var out: u8[][] = []
    var at = from
    for at < end {
        let n = i64(msg[at])
        at += 1
        if at + n > end {
            fail Malformed
        }
        out.push(copy(msg, at, at + n))
        at += n
    }
    if out.len == 0 {
        fail Malformed
    }
    out
}

fn read_options(msg: u8[], from: i64, end: i64) -> EdnsOption[] ! io.Error {
    var out: EdnsOption[] = []
    var at = from
    for at < end {
        if at + 4 > end {
            fail Malformed
        }
        let code = io.be16(msg, at)
        let n = io.be16(msg, at + 2)
        at += 4
        if at + n > end {
            fail Malformed
        }
        out.push(EdnsOption { code, data: copy(msg, at, at + n) })
        at += n
    }
    out
}

fn read_data(msg: u8[], kind: i64, from: i64, end: i64) -> Data ! io.Error {
    let size = end - from
    match kind {
        type_a => {
            if size != 4 {
                fail Malformed
            }
            Data.A(copy(msg, from, end))
        }
        type_aaaa => {
            if size != 16 {
                fail Malformed
            }
            Data.Aaaa(copy(msg, from, end))
        }
        type_cname => Data.Cname(read_target(msg, from, end)?)
        type_ns => Data.Ns(read_target(msg, from, end)?)
        type_ptr => Data.Ptr(read_target(msg, from, end)?)
        type_mx => {
            if size < 3 {
                fail Malformed
            }
            Data.MxData(Mx { preference: io.be16(msg, from), host: read_target(msg, from + 2, end)? })
        }
        type_txt => Data.Txt(read_texts(msg, from, end)?)
        type_srv => {
            if size < 7 {
                fail Malformed
            }
            Data.SrvData(Srv {
                priority: io.be16(msg, from)
                weight: io.be16(msg, from + 2)
                port: io.be16(msg, from + 4)
                target: read_target(msg, from + 6, end)?
            })
        }
        type_soa => {
            var at = from
            let mname = read_name(msg, mut at)?
            let rname = read_name(msg, mut at)?
            if at + 20 != end {
                fail Malformed
            }
            Data.SoaData(Soa {
                mname
                rname
                serial: io.be32(msg, at)
                refresh: io.be32(msg, at + 4)
                retry: io.be32(msg, at + 8)
                expire: io.be32(msg, at + 12)
                minimum: io.be32(msg, at + 16)
            })
        }
        type_caa => {
            if size < 2 {
                fail Malformed
            }
            let n = i64(msg[from + 1])
            if n == 0 || from + 2 + n > end {
                fail Malformed
            }
            Data.CaaData(Caa {
                flags: i64(msg[from])
                tag: str(copy(msg, from + 2, from + 2 + n))
                value: copy(msg, from + 2 + n, end)
            })
        }
        type_opt => Data.Opt(read_options(msg, from, end)?)
        _ => Data.Raw(kind, copy(msg, from, end))
    }
}

fn read_record(msg: u8[], mut at: i64) -> Record ! io.Error {
    let name = read_name(msg, mut at)?
    if at + 10 > msg.len {
        fail Malformed
    }
    let kind = io.be16(msg, at)
    let class = io.be16(msg, at + 2)
    let ttl = io.be32(msg, at + 4)
    let size = io.be16(msg, at + 8)
    at += 10
    let end = at + size
    if end > msg.len {
        fail Malformed
    }
    let data = read_data(msg, kind, at, end)?
    at = end
    Record { name, class, ttl, data }
}

fn read_records(msg: u8[], mut at: i64, count: i64) -> Record[] ! io.Error {
    var out: Record[] = []
    for _ in 0..count {
        out.push(read_record(msg, mut at)?)
    }
    out
}

fn flag(flags: i64, shift: i64) -> bool {
    flags >> shift & 1 == 1
}

fn read_head(msg: u8[], mut at: i64) -> Message ! io.Error {
    if msg.len < 12 {
        fail Malformed
    }
    let flags = io.be16(msg, 2)
    let questions = io.be16(msg, 4)
    if questions * 5 > msg.len - 12 {
        fail Malformed
    }
    at = 12
    var asked: Question[] = []
    for _ in 0..questions {
        asked.push(read_question(msg, mut at)?)
    }
    Message {
        id: io.be16(msg, 0)
        response: flag(flags, 15)
        opcode: flags >> 11 & 15
        authoritative: flag(flags, 10)
        truncated: flag(flags, 9)
        recursion_desired: flag(flags, 8)
        recursion_available: flag(flags, 7)
        authentic: flag(flags, 5)
        checking_disabled: flag(flags, 4)
        rcode: flags & 15
        questions: asked
        answers: []
        authority: []
        additional: []
    }
}

/// Decodes the header and the question section of `msg` and leaves the record sections empty.
///
/// The `rcode` holds only the 4 bits of the header, since the OPT record is not read. A resolver uses it to check the identifier, the question and the truncation flag of a reply before it decodes the records, which a truncated reply may cut in the middle. Fails with `Malformed` on the same grounds as `decode` for the parts it reads.
pub fn decode_head(msg: u8[]) -> Message ! io.Error {
    var at = 0
    read_head(msg, mut at)?
}

/// Decodes the DNS message `msg`.
///
/// Compression pointers must point at an earlier offset in the message and are followed at most 127 times per name. Fails with `Malformed` for a message shorter than the 12-byte header, a count that cannot fit in the remaining bytes, a section or record data that runs past the end, a label length with the reserved bits 01 or 10, a label over 63 bytes, a name over 255 bytes in wire form, a pointer that does not point backwards or a chain of more than 127, record data whose length does not match its type (including names that overrun or leave bytes over), a `TXT` record with no string, and a `CAA` record with an empty tag. Bytes after the last record are ignored. The extended response code of an OPT record is folded into `rcode`. Records of a type the module does not know decode to `Raw`. The result shares no memory with `msg`.
pub fn decode(msg: u8[]) -> Message ! io.Error {
    var at = 0
    var m = read_head(msg, mut at)?
    let counts = io.be16(msg, 6) + io.be16(msg, 8) + io.be16(msg, 10)
    if counts * 11 > msg.len - at {
        fail Malformed
    }
    m.answers = read_records(msg, mut at, io.be16(msg, 6))?
    m.authority = read_records(msg, mut at, io.be16(msg, 8))?
    m.additional = read_records(msg, mut at, io.be16(msg, 10))?
    for r in m.additional {
        match r.data {
            Opt(_) => {
                m.rcode |= (r.ttl >> 24 & 0xFF) << 4
            }
            _ => {}
        }
    }
    m
}
