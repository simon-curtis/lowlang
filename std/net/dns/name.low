import std/io
import std/text

const max_label = 63
const max_name = 255
const max_hops = 127

fn labels(name: str) -> u8[][] ! io.Error {
    var out: u8[][] = []
    if name.len == 0 || name == "." {
        return out
    }
    var label: u8[] = []
    var at = 0
    var ended = false
    for at < name.len {
        let c = name[at]
        ended = false
        if c == '.' {
            if label.len == 0 {
                fail Invalid
            }
            out.push(label)
            label = []
            ended = true
            at += 1
            continue
        }
        if c == '\\' {
            if at + 1 >= name.len {
                fail Invalid
            }
            let d = name[at + 1]
            if d >= '0' && d <= '9' {
                if at + 4 > name.len || !text.is_digits(name[at + 1..at + 4]) {
                    fail Invalid
                }
                let value = i64(d - '0') * 100 + i64(name[at + 2] - '0') * 10 + i64(name[at + 3] - '0')
                if value > 255 {
                    fail Invalid
                }
                label.push(u8(value))
                at += 4
            } else {
                label.push(d)
                at += 2
            }
            continue
        }
        label.push(c)
        at += 1
    }
    if !ended {
        out.push(label)
    }
    var wire = 1
    for l in out {
        if l.len > max_label {
            fail Invalid
        }
        wire += l.len + 1
    }
    if wire > max_name {
        fail Invalid
    }
    out
}

fn append_label(mut out: u8[], label: u8[]) {
    for c in label {
        if c == '.' || c == '\\' {
            out.push('\\')
            out.push(c)
        } else if c <= 0x20 || c >= 0x7F {
            out.push('\\')
            out.push(text.digit_char(i64(c) / 100))
            out.push(text.digit_char(i64(c) / 10 % 10))
            out.push(text.digit_char(i64(c) % 10))
        } else {
            out.push(c)
        }
    }
}

fn read_name(msg: u8[], mut at: i64) -> str ! io.Error {
    var out: u8[] = []
    var pos = at
    var jumped = false
    var hops = 0
    var wire = 1
    for {
        if pos >= msg.len {
            fail Malformed
        }
        let b = i64(msg[pos])
        if b & 0xC0 == 0xC0 {
            if pos + 1 >= msg.len {
                fail Malformed
            }
            let target = (b & 0x3F) << 8 | i64(msg[pos + 1])
            if target >= pos {
                fail Malformed
            }
            hops += 1
            if hops > max_hops {
                fail Malformed
            }
            if !jumped {
                at = pos + 2
                jumped = true
            }
            pos = target
            continue
        }
        if b & 0xC0 != 0 {
            fail Malformed
        }
        if b == 0 {
            if !jumped {
                at = pos + 1
            }
            break
        }
        if b > max_label || pos + 1 + b > msg.len {
            fail Malformed
        }
        wire += b + 1
        if wire > max_name {
            fail Malformed
        }
        if out.len > 0 {
            out.push('.')
        }
        append_label(mut out, msg[pos + 1..pos + 1 + b])
        pos += b + 1
    }
    if out.len == 0 {
        return "."
    }
    str(out)
}
