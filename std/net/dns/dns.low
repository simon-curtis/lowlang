import std/io
import std/slices
import std/text

/// The record type `A`, an IPv4 address.
pub const type_a = 1

/// The record type `NS`, an authoritative name server.
pub const type_ns = 2

/// The record type `CNAME`, a canonical name.
pub const type_cname = 5

/// The record type `SOA`, the start of a zone of authority.
pub const type_soa = 6

/// The record type `PTR`, a pointer to a name.
pub const type_ptr = 12

/// The record type `MX`, a mail exchange.
pub const type_mx = 15

/// The record type `TXT`, text strings.
pub const type_txt = 16

/// The record type `AAAA`, an IPv6 address.
pub const type_aaaa = 28

/// The record type `SRV`, a service location.
pub const type_srv = 33

/// The pseudo record type `OPT`, the EDNS(0) options of RFC 6891.
pub const type_opt = 41

/// The record type `CAA`, a certification authority authorisation.
pub const type_caa = 257

/// The query type `ANY`, every record of the name.
pub const type_any = 255

/// The class `IN`, the Internet.
pub const class_in = 1

/// The response code `NOERROR`.
pub const rcode_ok = 0

/// The response code `FORMERR`, the server could not parse the query.
pub const rcode_format = 1

/// The response code `SERVFAIL`, the server failed.
pub const rcode_server = 2

/// The response code `NXDOMAIN`, the name does not exist.
pub const rcode_name = 3

/// The response code `NOTIMP`, the server does not support the query.
pub const rcode_not_implemented = 4

/// The response code `REFUSED`, the server refused the query.
pub const rcode_refused = 5

/// The reason a lookup failed.
///
/// The server's answer maps onto `NoSuchName` (`NXDOMAIN`), `NoData` (`NOERROR` with no record of the type), `ServerFailure`, `FormatError`, `NotImplemented` and `Refused`. Anything else comes from the transport or the reply and is wrapped in `Io`.
pub enum Error {
    /// The name does not exist, `NXDOMAIN`.
    NoSuchName
    /// The name exists but has no record of the type asked for, or a `CNAME` chain ends without one.
    NoData
    /// The server reported `SERVFAIL`.
    ServerFailure
    /// The server reported `FORMERR`.
    FormatError
    /// The server reported `NOTIMP`.
    NotImplemented
    /// The server reported `REFUSED`.
    Refused
    /// The query did not complete: a timeout, a network failure, a malformed reply or a cancelled token.
    Io(cause: io.Error)
}

/// A question: a name, a record type and a class.
pub struct Question {
    /// The name asked about, in presentation form without a trailing dot.
    pub name: str
    /// The record type, such as `type_a`.
    pub kind: i64
    /// The class, `class_in` for the Internet.
    pub class: i64
}

/// One option of an OPT record.
pub struct EdnsOption {
    /// The option code.
    pub code: i64
    /// The option data.
    pub data: u8[]
}

/// The data of an `MX` record.
pub struct Mx {
    /// The preference; a lower value is tried first.
    pub preference: i64
    /// The name of the mail exchange.
    pub host: str
}

/// The data of an `SRV` record (RFC 2782).
pub struct Srv {
    /// The priority; a lower value is tried first.
    pub priority: i64
    /// The relative weight among records of one priority.
    pub weight: i64
    /// The port of the service.
    pub port: i64
    /// The name of the host that provides the service.
    pub target: str
}

/// The data of a `CAA` record (RFC 8659).
pub struct Caa {
    /// The flags; bit 7 is the issuer critical flag.
    pub flags: i64
    /// The property tag, such as `issue`.
    pub tag: str
    /// The property value.
    pub value: u8[]
}

/// The data of an `SOA` record.
pub struct Soa {
    /// The primary name server.
    pub mname: str
    /// The mailbox of the person responsible, as a name.
    pub rname: str
    /// The version of the zone.
    pub serial: i64
    /// Seconds before a secondary refreshes.
    pub refresh: i64
    /// Seconds before a failed refresh is retried.
    pub retry: i64
    /// Seconds before a secondary stops answering.
    pub expire: i64
    /// The negative caching time to live in seconds.
    pub minimum: i64
}

/// The typed data of a resource record.
///
/// Names are in presentation form, as `Question.name` is. A record of a type the module does not know keeps its bytes in `Raw` with the type number.
pub enum Data {
    /// An IPv4 address of 4 bytes.
    A(ip: u8[])
    /// An IPv6 address of 16 bytes.
    Aaaa(ip: u8[])
    /// A canonical name.
    Cname(target: str)
    /// A name server.
    Ns(host: str)
    /// A pointer to a name.
    Ptr(host: str)
    /// A mail exchange.
    MxData(mx: Mx)
    /// The character-strings of a `TXT` record, each of at most 255 bytes.
    Txt(strings: u8[][])
    /// A service location.
    SrvData(srv: Srv)
    /// A start of authority.
    SoaData(soa: Soa)
    /// A certification authority authorisation.
    CaaData(caa: Caa)
    /// The options of an OPT record.
    Opt(options: EdnsOption[])
    /// A record of another type with its data unparsed.
    Raw(kind: i64, bytes: u8[])
}

/// A resource record.
///
/// For an OPT record `class` is the requestor's UDP payload size and `ttl` holds the version and flags in its low 24 bits; the extended response code lives in `Message.rcode`.
pub struct Record {
    /// The owner name in presentation form.
    pub name: str
    /// The class, `class_in` for the Internet.
    pub class: i64
    /// The time to live in seconds.
    pub ttl: i64
    /// The typed data.
    pub data: Data
}

/// A DNS message (RFC 1035) with the EDNS(0) extended response code folded into `rcode`.
pub struct Message {
    /// The identifier that matches a reply to its query.
    pub id: i64
    /// True for a reply.
    pub response: bool
    /// The operation, 0 for a standard query.
    pub opcode: i64
    /// True when the server is authoritative for the name.
    pub authoritative: bool
    /// True when the message was cut to fit the transport.
    pub truncated: bool
    /// True when the sender wants the server to recurse.
    pub recursion_desired: bool
    /// True when the server offers recursion.
    pub recursion_available: bool
    /// True when the data is authenticated (RFC 4035).
    pub authentic: bool
    /// True when the sender wants unauthenticated data too.
    pub checking_disabled: bool
    /// The response code, 12 bits with the upper 8 coming from the OPT record.
    pub rcode: i64
    /// The questions.
    pub questions: Question[]
    /// The answer records.
    pub answers: Record[]
    /// The authority records.
    pub authority: Record[]
    /// The additional records, which carry the OPT record.
    pub additional: Record[]
}

/// Returns the record type number of `d`.
pub fn kind(d: Data) -> i64 {
    match d {
        A(_) => type_a
        Aaaa(_) => type_aaaa
        Cname(_) => type_cname
        Ns(_) => type_ns
        Ptr(_) => type_ptr
        MxData(_) => type_mx
        Txt(_) => type_txt
        SrvData(_) => type_srv
        SoaData(_) => type_soa
        CaaData(_) => type_caa
        Opt(_) => type_opt
        Raw(k, _) => k
    }
}

/// Returns a query for `name` and `kind` with the given `id`, recursion desired, and an OPT record when `payload` is positive.
///
/// `payload` is the UDP payload size advertised through EDNS(0).
pub fn query(id: i64, name: str, kind: i64, payload: i64) -> Message {
    var additional: Record[] = []
    if payload > 0 {
        additional.push(Record { name: ".", class: payload, ttl: 0, data: Data.Opt([]) })
    }
    Message {
        id
        response: false
        opcode: 0
        authoritative: false
        truncated: false
        recursion_desired: true
        recursion_available: false
        authentic: false
        checking_disabled: false
        rcode: 0
        questions: [Question { name, kind, class: class_in }]
        answers: []
        authority: []
        additional
    }
}

/// Returns the payload size of the OPT record of `m`, or 0 when it has none.
pub fn payload_size(m: Message) -> i64 {
    for r in m.additional {
        match r.data {
            Opt(_) => return r.class
            _ => {}
        }
    }
    0
}

/// Returns the reverse lookup name of the IPv4 or IPv6 address `ip`: `d.c.b.a.in-addr.arpa` or the 32 nibbles under `ip6.arpa`.
///
/// Fails with `Invalid` when `ip` is not 4 or 16 bytes.
pub fn reverse_name(ip: u8[]) -> str ! io.Error {
    var out: u8[] = []
    if ip.len == 4 {
        var i = 3
        for i >= 0 {
            text.append(mut out, "{ip[i]}.")
            i -= 1
        }
        text.append(mut out, "in-addr.arpa")
        return str(out)
    }
    if ip.len != 16 {
        fail Invalid
    }
    var i = 15
    for i >= 0 {
        out.push(text.digit_char(i64(ip[i]) & 15))
        out.push('.')
        out.push(text.digit_char(i64(ip[i]) >> 4))
        out.push('.')
        i -= 1
    }
    text.append(mut out, "ip6.arpa")
    str(out)
}

/// Reports whether the names `a` and `b` are the same name, ignoring ASCII case and one trailing dot.
pub fn same_name(a: str, b: str) -> bool {
    text.equal_fold(strip_root(a), strip_root(b))
}

fn strip_root(name: str) -> str {
    if name.len > 1 && name[name.len - 1] == '.' {
        return name[..name.len - 1]
    }
    name
}

/// Returns the records of `list` ordered for an `SRV` lookup by RFC 2782.
///
/// Records are grouped by ascending priority. Within a group the weight-0 records go first and then each next record is drawn with probability proportional to its weight: `pick(n)` must return a number from 0 to `n - 1`, and the draw is `pick(total + 1)` over the weights still left, as the RFC's running sum describes.
pub fn order_srv(list: Srv[], pick: fn(i64) -> i64) -> Srv[] {
    var sorted = slices.clone(list)
    slices.sort_stable_by(mut sorted, fn(a: Srv, b: Srv) -> bool { a.priority < b.priority })
    var out: Srv[] = []
    var start = 0
    for start < sorted.len {
        var end = start
        for end < sorted.len && sorted[end].priority == sorted[start].priority {
            end += 1
        }
        var group: Srv[] = []
        for s in sorted[start..end] {
            if s.weight == 0 {
                group.push(s)
            }
        }
        for s in sorted[start..end] {
            if s.weight != 0 {
                group.push(s)
            }
        }
        for group.len > 0 {
            var total = 0
            for s in group {
                total += s.weight
            }
            let target = pick(total + 1)
            var running = 0
            var chosen = group.len - 1
            for i, s in group {
                running += s.weight
                if running >= target {
                    chosen = i
                    break
                }
            }
            out.push(group[chosen])
            slices.remove(mut group, chosen)
        }
        start = end
    }
    out
}

/// Returns the records of `list` ordered by ascending preference, keeping the order of equal preferences.
pub fn order_mx(list: Mx[]) -> Mx[] {
    var sorted = slices.clone(list)
    slices.sort_stable_by(mut sorted, fn(a: Mx, b: Mx) -> bool { a.preference < b.preference })
    sorted
}
