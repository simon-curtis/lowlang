import std/io

extern "kernel32" {
    fn GetSystemDirectoryA(buf: ptr, size: u32) -> u32
}

extern "iphlpapi" {
    fn GetNetworkParams(info: ptr, mut size: u32) -> u32
}

fn hosts_path() -> str {
    let buf = io.buffer(520)
    let n = GetSystemDirectoryA(__slice_ptr(buf), u32(buf.len))
    if n == 0 || i64(n) >= buf.len {
        return "C:\\Windows\\System32\\drivers\\etc\\hosts"
    }
    "{str(buf[..i64(n)])}\\drivers\\etc\\hosts"
}

const domain_offset = 132
const domain_size = 132
const server_list_offset = 272

fn address_text(entry: u8[], at: i64) -> str {
    var end = at
    for end < at + 16 && entry[end] != 0 {
        end += 1
    }
    str(entry[at..end])
}

fn network_params() -> u8[] {
    var size: u32 = 0
    GetNetworkParams(null, mut size)
    if size == 0 {
        return []
    }
    let info = io.buffer(i64(size))
    if GetNetworkParams(__slice_ptr(info), mut size) != 0 {
        return []
    }
    info
}

fn configured_nameservers(info: u8[]) -> str[] {
    var servers: str[] = []
    let first = address_text(info, server_list_offset + 8)
    if first.len > 0 {
        servers.push(first)
    }
    var next = io.le64(info, server_list_offset)
    for next != 0 {
        let entry_bytes = bytes(__str_raw(next, 48))
        let server = address_text(entry_bytes, 8)
        if server.len > 0 {
            servers.push(server)
        }
        next = io.le64(entry_bytes, 0)
    }
    servers
}

fn domain_name(info: u8[]) -> str {
    var end = domain_offset
    for end < domain_offset + domain_size && info[end] != 0 {
        end += 1
    }
    str(info[domain_offset..end])
}

/// Returns the configuration of the system's DNS client.
///
/// On Linux it is `parse_resolv_conf` of `/etc/resolv.conf` with the `LOCALDOMAIN` and `RES_OPTIONS` environment variables, and the defaults of `resolver_config` when the file cannot be read. On Windows it is the defaults with the IPv4 DNS servers of the network adapters from `GetNetworkParams` as the servers and the adapters' domain name as the search list. Blocks the OS thread while it reads the file.
pub fn system_config() -> ResolverConfig {
    var c = resolver_config()
    let info = network_params()
    if info.len == 0 {
        return c
    }
    var servers: Addr[] = []
    for server in configured_nameservers(info) {
        let ip: u8[] = parse_ip(server) or []
        if ip.len > 0 && servers.len < 3 {
            servers.push(Addr { ip, port: 53 })
        }
    }
    if servers.len > 0 {
        c.servers = servers
    }
    let domain = domain_name(info)
    if domain.len > 0 {
        c.search = [domain]
    }
    c
}
