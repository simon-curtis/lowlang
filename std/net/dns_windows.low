import std/io

extern "kernel32" {
    fn GetSystemDirectoryA(buf: ptr, size: u32) -> u32
}

extern "iphlpapi" {
    fn GetNetworkParams(info: ptr, mut size: u32) -> u32
}

fn hosts_path() -> str {
    let buf = io.buffer(520)
    let n = GetSystemDirectoryA(__slice_ptr(buf), u32(buf.len))
    if n == 0 || i64(n) >= buf.len {
        return "C:\\Windows\\System32\\drivers\\etc\\hosts"
    }
    "{str(buf[..i64(n)])}\\drivers\\etc\\hosts"
}

const server_list_offset = 272

fn address_text(entry: []u8, at: i64) -> str {
    var end = at
    for end < at + 16 && entry[end] != 0 {
        end += 1
    }
    str(entry[at..end])
}

fn configured_nameservers() -> []str {
    var size: u32 = 0
    GetNetworkParams(null, mut size)
    if size == 0 {
        return []
    }
    let info = io.buffer(i64(size))
    if GetNetworkParams(__slice_ptr(info), mut size) != 0 {
        return []
    }
    var servers: []str = []
    let first = address_text(info, server_list_offset + 8)
    if first.len > 0 {
        push(mut servers, first)
    }
    var next = io.le64(info, server_list_offset)
    for next != 0 {
        let entry_bytes = bytes(__str_raw(next, 48))
        let server = address_text(entry_bytes, 8)
        if server.len > 0 {
            push(mut servers, server)
        }
        next = io.le64(entry_bytes, 0)
    }
    servers
}
