import std/net
import std/testing
import std/text

fn test_pause_doubles_to_the_longest_and_starts_over_once_settled(t: *testing.T) {
    let o = Options { first_pause: 100, longest_pause: 500, settled: 3000 }
    var waited = 0
    var pauses: i64[] = []
    for _ in 0..5 {
        waited = pause_after(o, waited, 20)
        pauses.push(waited)
    }
    testing.equal_slice(t, pauses, [100, 200, 400, 500, 500])
    testing.equal(t, pause_after(o, 500, 2999), 500)
    testing.equal(t, pause_after(o, 500, 3000), 100)
}

fn bound(ip: str, port: i64) -> net.Addr {
    net.Addr { ip: net.parse_ip(ip) or [], port }
}

fn public_and_admin() -> Passed[] {
    passed(text.join([
        described("tcp", 5, bound("0.0.0.0", 8080))
        described("tcp", 6, bound("127.0.0.1", 9090))
        described("tcp", 7, bound("127.0.0.1", 9091))
        described("unix", 8, net.Addr { ip: [], port: 0, path: "/run/admin, one.sock" })
        described("udp", 9, bound("127.0.0.1", 9090))
    ], ","))
}

fn picked(kind: str, name: str, port: i64) -> i64 {
    let found = chosen(public_and_admin(), kind, name, port) or return -1
    found.fd
}

fn test_a_socket_is_chosen_by_its_address_and_port(t: *testing.T) {
    testing.equal(t, picked("tcp", "127.0.0.1", 9090), 6)
    testing.equal(t, picked("tcp", "0.0.0.0", 0), 5)
}

fn test_no_socket_is_chosen_for_another_address_or_port(t: *testing.T) {
    testing.equal(t, picked("tcp", "127.0.0.1", 8080), -1)
    testing.equal(t, picked("tcp", "0.0.0.0", 9090), -1)
}

fn test_no_socket_is_chosen_between_two_on_one_address_without_a_port(t: *testing.T) {
    testing.equal(t, picked("tcp", "127.0.0.1", 0), -1)
}

fn test_a_socket_is_chosen_by_its_kind(t: *testing.T) {
    testing.equal(t, picked("udp", "127.0.0.1", 9090), 9)
    testing.equal(t, picked("udp", "0.0.0.0", 8080), -1)
}

fn test_a_unix_socket_is_chosen_by_its_path(t: *testing.T) {
    testing.equal(t, picked("unix", "/run/admin, one.sock", 0), 8)
    testing.equal(t, picked("unix", "/run/admin", 0), -1)
    testing.equal(t, picked("tcp", "/run/admin, one.sock", 0), -1)
}
