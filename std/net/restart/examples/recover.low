import std/io
import std/net
import std/net/restart
import std/os
import std/text

fn answer(h: net.ConnHandle) {
    using c = net.adopt(h)
    let line = io.read_line(io.reader(net.stream(c))) or return
    if line == "crash" {
        os.exit(3)
    }
    if line == "stop" {
        os.exit(0)
    }
    net.write_all(c, bytes("{text.upper(line)}\n")) or return
}

fn accept_loop(kept: restart.Kept) ! io.Error {
    for {
        spawn answer(net.accept_handle(kept.listeners[0])?)
    }
}

fn ask(a: net.Addr, line: str) -> str ! io.Error {
    using c = net.connect(a)?
    net.write_all(c, bytes("{line}\n"))?
    text.trim(str(io.read_all(net.stream(c))?))
}

fn talk(a: net.Addr, done: chan[bool]) {
    for line in ["hello", "crash", "hello again", "stop"] {
        let reply = ask(a, line) or ""
        if reply.len == 0 {
            print("{line}: connection closed")
        } else {
            print("{line}: {reply}")
        }
    }
    done <- true
}

/// Serves upper-cased lines from a server that is started again after it exits with status 3, and stops when the server exits with status 0.
fn main() ! io.Error {
    using l = restart.listen("127.0.0.1", 0)?
    let done = chan[bool](1)
    if !restart.worker() {
        spawn talk(l.handle.addr, done)
    }
    restart.serve(restart.Kept { listeners: [l.handle] }, accept_loop)?
    <-done
}
