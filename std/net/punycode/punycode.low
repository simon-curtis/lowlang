import std/text
import std/unicode

/// Why a Punycode conversion failed.
pub enum Error {
    /// A value computed during the conversion does not fit in 32 bits.
    Overflow
    /// The input to `encode` is not valid UTF-8.
    InvalidUtf8
    /// A byte of the input to `decode` is not ASCII, or a digit is not in the alphabet. `at` is its index in the input.
    BadDigit(at: i64)
    /// The input to `decode` ends inside a number.
    Truncated
    /// A decoded value is not a Unicode scalar value.
    InvalidCodePoint
}

const base = 36
const tmin = 1
const tmax = 26
const skew = 38
const damp = 700
const initial_bias = 72
const initial_n = 128
const delimiter: u8 = '-'
const max_int = 0xFFFFFFFF

fn adapt(delta: i64, count: i64, first: bool) -> i64 {
    var d = if first { delta / damp } else { delta / 2 }
    d += d / count
    var k = 0
    for d > (base - tmin) * tmax / 2 {
        d /= base - tmin
        k += base
    }
    k + (base - tmin + 1) * d / (d + skew)
}

fn threshold(k: i64, bias: i64) -> i64 {
    if k <= bias {
        return tmin
    }
    if k >= bias + tmax {
        return tmax
    }
    k - bias
}

fn digit_byte(d: i64) -> u8 {
    if d < 26 { u8(97 + d) } else { u8(22 + d) }
}

fn digit_value(c: u8) -> i64 {
    if c >= 'a' && c <= 'z' {
        return i64(c - 'a')
    }
    if c >= 'A' && c <= 'Z' {
        return i64(c - 'A')
    }
    if c >= '0' && c <= '9' {
        return i64(c - '0') + 26
    }
    -1
}

fn put_number(mut out: u8[], delta: i64, bias: i64) {
    var q = delta
    var k = base
    for {
        let t = threshold(k, bias)
        if q < t {
            break
        }
        out.push(digit_byte(t + (q - t) % (base - t)))
        q = (q - t) / (base - t)
        k += base
    }
    out.push(digit_byte(q))
}

/// Returns `s` encoded as Punycode, the ASCII form of RFC 3492, without the `xn--` prefix of a domain label.
///
/// The ASCII code points of `s` come first, unchanged and in their own case, then a `-` when there are any, then the other code points as base-36 digits in lowercase, so `abc` encodes to `abc-`. An empty string encodes to an empty string.
///
/// Fails with `InvalidUtf8` when `s` is not valid UTF-8, and with `Overflow` when a value of the algorithm exceeds 32 bits, which takes several thousand code points near `U+10FFFF`.
pub fn encode(s: str) -> str ! Error {
    if !unicode.utf8_valid(s) {
        fail InvalidUtf8
    }
    var points: u32[] = []
    var out: u8[] = []
    for c in s {
        points.push(c)
        if c < 0x80 {
            out.push(u8(c))
        }
    }
    let basic = out.len
    if basic > 0 {
        out.push(delimiter)
    }
    var n = initial_n
    var delta = 0
    var bias = initial_bias
    var handled = basic
    for handled < points.len {
        var m = max_int
        for c in points {
            if i64(c) >= n && i64(c) < m {
                m = i64(c)
            }
        }
        if m - n > (max_int - delta) / (handled + 1) {
            fail Overflow
        }
        delta += (m - n) * (handled + 1)
        n = m
        for c in points {
            if i64(c) < n {
                delta += 1
                if delta > max_int {
                    fail Overflow
                }
            }
            if i64(c) == n {
                put_number(mut out, delta, bias)
                bias = adapt(delta, handled + 1, handled == basic)
                delta = 0
                handled += 1
            }
        }
        delta += 1
        n += 1
    }
    __str_view(out)
}

/// Returns the text that the Punycode string `s` encodes, as UTF-8.
///
/// `s` is the part of a domain label after `xn--`. Digits may be in either case, and ASCII code points before the last `-` are copied unchanged. An empty string decodes to an empty string.
///
/// Fails with `BadDigit` at the first byte that is not ASCII, or not a digit where one is required, with `Truncated` when the input ends inside a number, with `Overflow` when a value exceeds 32 bits, and with `InvalidCodePoint` when a decoded value is a surrogate or above `U+10FFFF`.
pub fn decode(s: str) -> str ! Error {
    var last = 0
    for i in 0..s.len {
        if s[i] >= 0x80 {
            fail BadDigit(i)
        }
        if s[i] == delimiter {
            last = i
        }
    }
    var points: u32[] = []
    for i in 0..last {
        points.push(u32(s[i]))
    }
    var at = if last > 0 { last + 1 } else { 0 }
    var n = initial_n
    var i = 0
    var bias = initial_bias
    for at < s.len {
        let old = i
        var w = 1
        var k = base
        for {
            if at >= s.len {
                fail Truncated
            }
            let digit = digit_value(s[at])
            if digit < 0 {
                fail BadDigit(at)
            }
            at += 1
            if digit > (max_int - i) / w {
                fail Overflow
            }
            i += digit * w
            let t = threshold(k, bias)
            if digit < t {
                break
            }
            if w > max_int / (base - t) {
                fail Overflow
            }
            w *= base - t
            k += base
        }
        let count = points.len + 1
        bias = adapt(i - old, count, old == 0)
        if i / count > max_int - n {
            fail Overflow
        }
        n += i / count
        i %= count
        if !text.is_scalar(u32(n)) {
            fail InvalidCodePoint
        }
        points.push(0)
        for j in 0..points.len - 1 - i {
            points[points.len - 1 - j] = points[points.len - 2 - j]
        }
        points[i] = u32(n)
        i += 1
    }
    var out: u8[] = []
    for c in points {
        text.append_char(mut out, c)
    }
    __str_view(out)
}
