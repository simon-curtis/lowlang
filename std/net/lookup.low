import std/file
import std/io
import std/net/dns
import std/text

/// Returns the IP addresses of `host`.
///
/// Does what `resolve` does with `system_resolver`, so `host` is tried as an IP literal, in the hosts file, as `localhost` and then in DNS with the system's search list, nameservers and options. Fails with `NotFound` if the name does not exist, has no address or the servers answered with an error, and with the transport error otherwise. Parks the green thread during the network queries and blocks the OS thread while it reads the two files.
pub fn lookup(host: str) -> [][]u8 ! io.Error {
    resolve(system_resolver(), host) catch {
        Io(cause) => fail cause
        _ => fail NotFound
    }
}

fn fields(line: str) -> []str {
    var out: []str = []
    let hash = text.index_byte(line, '#')
    let content = if hash >= 0 { line[..hash] } else { line }
    for part in text.split(text.trim(content), ' ') {
        for piece in text.split(part, '\t') {
            if piece.len > 0 {
                push(mut out, piece)
            }
        }
    }
    out
}

fn from_hosts(hosts: str, host: str) -> [][]u8 {
    var found: [][]u8 = []
    for line in text.split(hosts, '\n') {
        let f = fields(line)
        if f.len < 2 {
            continue
        }
        for name in f[1..] {
            if text.equal_fold(name, host) {
                let ip: []u8 = parse_ip(f[0]) or []
                if ip.len > 0 {
                    push(mut found, ip)
                }
            }
        }
    }
    found
}

fn loopback_addresses() -> [][]u8 {
    var v6: []u8 = io.buffer(16)
    v6[15] = 1
    [[127, 0, 0, 1], v6]
}

fn read_hosts() -> str {
    file.read_text(hosts_path()) or ""
}
