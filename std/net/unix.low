import std/io
import std/sys

/// The identity of the process at the other end of a Unix socket.
pub struct Credentials {
    /// The process id.
    pub pid: i64
    /// The user id.
    pub uid: i64
    /// The group id.
    pub gid: i64
}

/// Two connected `Conn` values made by `socketpair`.
pub struct ConnPair {
    /// One end of the pair.
    pub first: Conn
    /// The other end of the pair. Data written to one end is read from the other.
    pub second: Conn
}

/// Bytes read from a Unix socket with the descriptors that arrived with them.
pub struct FdRead {
    /// The number of bytes written into the buffer, or `0` at end of input.
    pub size: i64
    /// The descriptors received, closed on `exec`. The caller owns them and closes each with `sys.close_fd`.
    pub fds: i64[]
}

/// Listens for stream connections on the Unix socket `path`.
///
/// `path` is validated as `unix_addr` does and can name an abstract socket. The backlog is 4096. Fails with `AddrInUse` if a file already exists at `path`. Closing the listener removes the socket file, except for an abstract name.
pub fn listen_unix(path: str) -> Listener ! io.Error {
    let a = unix_addr(path)?
    using var p = bound(a, sys.SocketKind.Streaming, ListenOptions { reuse_addr: false })?
    open_listener(mut p, 4096, a.path)?
}

/// Connects to the Unix stream socket at `path`.
///
/// Parks the green thread while the connection is in progress. Fails as `connect_unix_within` does, with the default wait.
pub fn connect_unix(path: str) -> Conn ! io.Error {
    connect(unix_addr(path)?)
}

/// Connects to the Unix stream socket at `path`, waiting at most `millis` milliseconds.
///
/// When the listener's backlog is full it retries every millisecond for up to `millis`, or 30 seconds when `millis` is 0 or less, and then fails with `TimedOut`. Fails with `Invalid` for a bad `path`, `NotFound` if there is no socket and `Refused` if nothing listens.
pub fn connect_unix_within(path: str, millis: i64) -> Conn ! io.Error {
    connect_within(unix_addr(path)?, millis)
}

/// Returns two connected, unnamed Unix stream sockets.
pub fn socketpair() -> ConnPair ! io.Error {
    let pair = sys.socketpair()?
    let unnamed = Addr { ip: [], port: 0 }
    let first_handle = conn(pair.first, unnamed) catch {
        e => {
            sys.close_fd(pair.second)
            fail e
        }
    }
    using var first = adopt(first_handle)
    let second_handle = conn(pair.second, unnamed)?
    ConnPair { first: adopt(detach(mut first)), second: adopt(second_handle) }
}

/// Returns the process id, user id and group id of the peer of `c`, as recorded when the connection was made.
///
/// Meaningful for Unix socket connections. Fails with `NotConnected` if `c` is closed.
pub fn peer_credentials(c: Conn) -> Credentials ! io.Error {
    peer_credentials_on(c.handle)
}

/// Returns the process id, user id and group id of the peer behind `h`.
///
/// Fails with `NotConnected` if the connection is closed.
pub fn peer_credentials_on(h: ConnHandle) -> Credentials ! io.Error {
    using lease = io.enter(h.guard)?
    let peer = sys.peer_credentials(h.fd)?
    Credentials { pid: peer.pid, uid: peer.uid, gid: peer.gid }
}

/// Reads up to `buf.len` bytes from `c` into `buf` together with the descriptors passed with them.
///
/// Does the same as `read_with_fds_on` on its handle.
pub fn read_with_fds(c: Conn, buf: u8[]) -> FdRead ! io.Error {
    read_with_fds_on(c.handle, buf)
}

/// Reads up to `buf.len` bytes from the Unix connection behind `h` into `buf` together with the descriptors the peer passed with them through `SCM_RIGHTS`.
///
/// Parks the green thread until data arrives. The count is `0` at end of input. The descriptors are the caller's to close with `sys.close_fd`. If the read timeout elapses first, the connection is shut down and the call fails with `TimedOut`. Fails with `NotConnected` after the connection is closed, including while the call is waiting, and with `Malformed` when the kernel dropped descriptors.
pub fn read_with_fds_on(h: ConnHandle, buf: u8[]) -> FdRead ! io.Error {
    using lease = io.enter(h.guard)?
    var fds: i64[] = []
    let size = retry(h.fd, false, h.timeouts.read, fn() { stop_guarded(h.guard, h.fd, h.out) }, fn() -> i64 ! io.Error {
        let received = sys.recv_with_fds(h.fd, buf)?
        fds = received.fds
        received.size
    })?
    FdRead { size, fds }
}

/// Writes a prefix of `data` to `c` with the descriptors `fds` attached and returns how many bytes were written.
///
/// Does the same as `write_with_fds_on` on its handle.
pub fn write_with_fds(c: Conn, data: u8[], fds: i64[]) -> i64 ! io.Error {
    write_with_fds_on(c.handle, data, fds)
}

/// Writes a prefix of `data` to the Unix connection behind `h` with the descriptors `fds` attached through `SCM_RIGHTS`, and returns how many bytes were written.
///
/// The peer receives the descriptors with the first byte written, so the caller passes `fds` to the first call only and writes the rest of `data` with `write_on`. `fds` is not closed. Parks the green thread while the send buffer is full. If the write timeout elapses first, the connection is shut down and the call fails with `TimedOut`. Fails with `NotConnected` after the connection is closed and with `Invalid` for more than 253 descriptors.
pub fn write_with_fds_on(h: ConnHandle, data: u8[], fds: i64[]) -> i64 ! io.Error {
    using lease = io.enter(h.guard)?
    retry(h.out, true, h.timeouts.write, fn() { stop_guarded(h.guard, h.fd, h.out) }, fn() -> i64 ! io.Error { sys.send_with_fds(h.out, data, fds)? })
}
