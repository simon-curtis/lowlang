import std/io
import std/net/idna
import std/text

/// Which sections of the Public Suffix List the rules come from.
pub enum Rules {
    /// The ICANN and the private sections.
    All
    /// The ICANN section only.
    Icann
}

/// The section of the list that holds a rule.
pub enum Section {
    /// The rule is in the ICANN section.
    Icann
    /// The rule is in the private section, such as `github.io`.
    Private
    /// No rule matched, so the suffix is the last label by the default rule `*`.
    Unlisted
}

/// A public suffix and the section of the rule that made it one.
pub struct Suffix {
    /// The suffix, in the form of the domain it came from.
    pub name: str
    /// The section of the prevailing rule.
    pub section: Section
}

struct Part {
    key: str
    shown: str
}

struct Node {
    label: str
    flags: i64
    first_child: i64
    child_count: i64
}

struct Prevailing {
    length: i64
    section: Section
}

fn node_at(index: i64) -> Node {
    let nodes = suffix_nodes_table()
    let at = index * node_size
    let label_at = i64(io.u32_le_str(nodes, at + node_label_offset))
    let label_length = i64(nodes[at + node_label_length_offset])
    Node {
        label: suffix_labels_table()[label_at..label_at + label_length]
        flags: i64(nodes[at + node_flags_offset])
        first_child: i64(io.u16_le_str(nodes, at + node_first_child_offset))
        child_count: i64(io.u16_le_str(nodes, at + node_child_count_offset))
    }
}

fn find_child(parent: Node, label: str) -> i64 {
    var low = parent.first_child
    var high = parent.first_child + parent.child_count
    for low < high {
        let middle = (low + high) / 2
        let child = node_at(middle)
        if child.label == label {
            return middle
        }
        if child.label < label {
            low = middle + 1
        } else {
            high = middle
        }
    }
    -1
}

fn applies(flags: i64, flag: i64, rules: Rules) -> bool {
    if flags & flag == 0 {
        return false
    }
    match rules {
        All => true
        Icann => flags >> private_shift & flag == 0
    }
}

fn section_of(flags: i64, flag: i64) -> Section {
    if flags >> private_shift & flag != 0 { Section.Private } else { Section.Icann }
}

fn lenient_options() -> idna.Options {
    idna.Options { check_hyphens: false, use_std3_ascii_rules: false, verify_dns_length: false }
}

fn part_of(label: str) -> Part? {
    let lower = text.lower(label)
    if lower == "" {
        return none
    }
    if text.is_ascii(lower) && !text.starts_with(lower, "xn--") {
        return Part { key: lower, shown: lower }
    }
    let converted = idna.to_unicode(lower, lenient_options())
    if converted.error != none || converted.text == "" || text.contains(converted.text, ".") {
        return none
    }
    Part { key: converted.text, shown: if text.is_ascii(lower) { lower } else { converted.text } }
}

fn separator_at(domain: str, i: i64) -> i64 {
    if domain[i] == '.' {
        return 1
    }
    for sep in ["。", "．", "｡"] {
        if text.starts_with(domain[i..], sep) {
            return sep.len
        }
    }
    0
}

fn parts_of(domain: str) -> Part[]? {
    var parts: Part[] = []
    var start = 0
    var i = 0
    for i <= domain.len {
        let width = if i < domain.len { separator_at(domain, i) } else { 1 }
        if width == 0 {
            i += 1
            continue
        }
        let part = part_of(domain[start..i]) ?? return none
        parts.push(part)
        i += width
        start = i
    }
    parts
}

fn prevailing(parts: Part[], rules: Rules) -> Prevailing {
    var best = Prevailing { length: 1, section: Section.Unlisted }
    var node = 0
    var depth = 0
    var i = parts.len
    for i > 0 {
        i -= 1
        depth += 1
        let parent = node_at(node)
        let child = find_child(parent, parts[i].key)
        let child_flags = if child >= 0 { node_at(child).flags } else { 0 }
        if applies(parent.flags, wildcard_flag, rules) && !applies(child_flags, exception_flag, rules) {
            best = Prevailing { length: depth, section: section_of(parent.flags, wildcard_flag) }
        }
        if child < 0 {
            break
        }
        if applies(child_flags, exception_flag, rules) {
            return Prevailing { length: depth - 1, section: section_of(child_flags, exception_flag) }
        }
        if applies(child_flags, rule_flag, rules) {
            best = Prevailing { length: depth, section: section_of(child_flags, rule_flag) }
        }
        node = child
    }
    best
}

fn tail(parts: Part[], count: i64) -> str {
    var shown: str[] = []
    for part in parts[parts.len - count..] {
        shown.push(part.shown)
    }
    text.join(shown, ".")
}

/// Returns the public suffix of `domain`, the part that a registrant cannot own alone, such as `com`, `co.uk` or `github.io`.
///
/// `domain` may be written in ASCII, in Unicode or with `xn--` labels, in any case, and may use `U+3002`, `U+FF0E` or `U+FF61` as a dot. Each label is matched through UTS #46 processing, so `食狮.中国` and `xn--85x722f.xn--fiqs8s` find the same rule. The suffix is returned in the form given: an ASCII or `xn--` label is lowercased, and any other label is mapped and normalised by UTS #46.
///
/// The prevailing rule is the longest match, an exception rule over any other, and `*` when no rule matches, which makes the last label a suffix with section `Unlisted`. Returns `none` for an empty name, an empty label, including one made by a leading or trailing dot, and a label that UTS #46 rejects. An ASCII label that does not begin with `xn--` is not checked, so `_dmarc` is accepted.
pub fn public_suffix(domain: str, rules: Rules) -> Suffix? {
    let parts = parts_of(domain) ?? return none
    let found = prevailing(parts, rules)
    Suffix { name: tail(parts, found.length), section: found.section }
}

/// Returns the registrable domain of `domain`, the public suffix and one label before it, such as `example.co.uk` for `www.example.co.uk`.
///
/// The form of the result and the rules are those of `public_suffix`. Returns `none` when `domain` is itself a public suffix, and whenever `public_suffix` returns `none`.
pub fn registrable_domain(domain: str, rules: Rules) -> str? {
    let parts = parts_of(domain) ?? return none
    let found = prevailing(parts, rules)
    if parts.len <= found.length {
        return none
    }
    tail(parts, found.length + 1)
}

/// Returns whether `domain` is a public suffix: it is valid, and the longest rule that matches it covers every label.
///
/// `com`, `co.uk` and `github.io` are; `example.com` is not. An unlisted single label such as `localhost` is, by the default rule `*`.
pub fn is_public_suffix(domain: str, rules: Rules) -> bool {
    let parts = parts_of(domain) ?? return false
    parts.len <= prevailing(parts, rules).length
}

/// Returns the `VERSION` line of the Public Suffix List the tables were generated from.
pub fn list_version() -> str {
    text.split(suffix_version_table(), '\n')[0]
}

/// Returns the `COMMIT` line of the Public Suffix List the tables were generated from: the hash of the commit in the list's repository.
pub fn list_commit() -> str {
    text.split(suffix_version_table(), '\n')[1]
}
