import std/file
import std/text

fn hosts_path() -> str {
    "/etc/hosts"
}

fn configured_nameservers() -> []str {
    var servers: []str = []
    let conf = file.read_text("/etc/resolv.conf") or ""
    for line in text.split(conf, '\n') {
        let f = fields(line)
        if f.len >= 2 && f[0] == "nameserver" {
            push(mut servers, f[1])
        }
    }
    servers
}
