import std/file
import std/os

fn hosts_path() -> str {
    "/etc/hosts"
}

/// Returns the configuration of the system's DNS client.
///
/// On Linux it is `parse_resolv_conf` of `/etc/resolv.conf` with the `LOCALDOMAIN` and `RES_OPTIONS` environment variables, and the defaults of `resolver_config` when the file cannot be read. On Windows it is the defaults with the IPv4 DNS servers of the network adapters from `GetNetworkParams` as the servers and the adapters' domain name as the search list. Blocks the OS thread while it reads the file.
pub fn system_config() -> ResolverConfig {
    let conf = file.read_text("/etc/resolv.conf") or ""
    let localdomain = os.env("LOCALDOMAIN") ?? ""
    let options = os.env("RES_OPTIONS") ?? ""
    parse_resolv_conf(conf, localdomain, options)
}
