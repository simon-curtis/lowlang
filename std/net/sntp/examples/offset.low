import std/io
import std/net
import std/net/sntp

struct Reads {
    count: i64
}

fn millis(nanos: i64) -> i64 {
    (nanos + 500000) / 1000000
}

fn serve(server: net.SocketHandle) {
    let buf = io.buffer(128)
    let p = net.receive_from_on(server, buf) or return
    let originate = sntp.Stamp { seconds: io.be32(buf, 40), fraction: io.be32(buf, 44) }
    let received = sntp.to_unix_nanos(originate) + 2750000000
    var reply = io.buffer(48)
    reply[0] = 0x24
    reply[1] = 2
    io.set_be32(reply, 24, originate.seconds)
    io.set_be32(reply, 28, originate.fraction)
    let t2 = sntp.to_stamp(received)
    let t3 = sntp.to_stamp(received + 250000000)
    io.set_be32(reply, 32, t2.seconds)
    io.set_be32(reply, 36, t2.fraction)
    io.set_be32(reply, 40, t3.seconds)
    io.set_be32(reply, 44, t3.fraction)
    net.send_to_on(server, reply, p.from) or 0
}

/// Asks a stand-in NTP server on a loopback port for the time, with a client clock that reads 1.25 s later on arrival, and prints the offset and delay.
fn main() ! io.Error {
    using server = net.bind_udp("127.0.0.1", 0)?
    spawn serve(server.handle)

    let start = 1700000000000000000
    let reads = new(Reads { count: 0 })
    let clock = fn() -> i64 {
        reads.count += 1
        if reads.count == 1 { start } else { start + 1250000000 }
    }
    let options = sntp.Options { port: server.handle.addr.port, timeout_ms: 2000, clock }
    let reply = sntp.query("127.0.0.1", options) catch {
        Io(cause) => {
            print("no reply: {cause}")
            return
        }
        _ => {
            print("rejected reply")
            return
        }
    }
    print("stratum {reply.stratum}")
    print("offset {millis(reply.offset)} ms")
    print("delay {millis(reply.delay)} ms")
}
