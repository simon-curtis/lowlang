import std/atomic
import std/math
import std/sync

struct Shelf {
    stock: i64
    shipped: i64
}

fn query(pool: sync.Semaphore, open: atomic.Int, peak: atomic.Int, group: sync.WaitGroup) {
    pool.acquire()
    let now = open.add_int(1)
    peak.update_int(fn(seen: i64) -> i64 { math.max(seen, now) })
    sleep(2)
    open.add_int(-1)
    pool.release()
    group.done()
}

fn load_shard(barrier: sync.Barrier, loaded: atomic.Int, ready_seen: atomic.Int, leaders: atomic.Int, group: sync.WaitGroup) {
    loaded.add_int(1)
    if barrier.wait_barrier() {
        leaders.add_int(1)
    }
    if loaded.load_int() == 4 {
        ready_seen.add_int(1)
    }
    group.done()
}

fn restock(m: sync.Mutex, c: sync.Cond, shelf: *Shelf, batch: i64) {
    m.lock()
    shelf.stock += batch
    m.unlock()
    c.broadcast()
}

fn ship(m: sync.Mutex, c: sync.Cond, shelf: *Shelf, wanted: i64, shipped: chan[i64]) {
    m.lock()
    for shelf.stock < wanted {
        c.wait_cond()
    }
    shelf.stock -= wanted
    shelf.shipped += wanted
    let left = shelf.stock
    m.unlock()
    shipped <- left
}

/// Limits database connections with a semaphore, lines shards up on a barrier and makes a shipper wait on a condition until the shelf is stocked.
fn main() {
    let pool = sync.semaphore(3)
    let open = atomic.int(0)
    let peak = atomic.int(0)
    let queries = sync.wait_group()
    for i in 0..9 {
        queries.add(1)
        spawn query(pool, open, peak, queries)
    }
    queries.wait()
    print("9 queries, at most 3 connections at once: {peak.load_int() <= 3}, free {pool.available()}, try: {pool.try_acquire()}")

    let barrier = sync.barrier(4)
    let loaded = atomic.int(0)
    let ready_seen = atomic.int(0)
    let leaders = atomic.int(0)
    let shards = sync.wait_group()
    for i in 0..4 {
        shards.add(1)
        spawn load_shard(barrier, loaded, ready_seen, leaders, shards)
    }
    shards.wait()
    print("shards ready when released: {ready_seen.load_int()} of 4, leaders {leaders.load_int()}")

    let m = sync.mutex()
    let c = sync.cond(m)
    let shelf = new(Shelf { stock: 0, shipped: 0 })
    let shipped = chan[i64]()
    spawn ship(m, c, shelf, 5, shipped)
    for batch in [2, 2, 3] {
        sleep(2)
        restock(m, c, shelf, batch)
        print("restocked {batch}")
    }
    let left = <-shipped ?? -1
    let total = m.locked(fn() -> i64 { shelf.shipped })
    print("shipped {total}, {left} left")
}
