import std/atomic
import std/sync

struct Settings {
    region: str
    replicas: i64
}

struct Registry {
    lock: sync.RwLock
    services: [str: i64]
}

fn read_settings(settings: sync.OnceValue[Settings], seen: atomic.Int, group: sync.WaitGroup) {
    let s = settings.get_once()
    seen.add_int(s.replicas)
    group.done()
}

fn register(r: *Registry, name: str, port: i64, group: sync.WaitGroup) {
    r.lock.writing(fn() -> i64 {
        r.services[name] = port
        0
    })
    group.done()
}

/// Loads settings once for eight readers and fills a registry from several writers behind a read-write lock.
fn main() {
    let loads = atomic.int(0)
    let settings = sync.once_value(fn() -> Settings {
        loads.add_int(1)
        sleep(2)
        Settings { region: "eu-west", replicas: 3 }
    })
    let seen = atomic.int(0)
    let group = sync.wait_group()
    for i in 0..8 {
        group.add(1)
        spawn read_settings(settings, seen, group)
    }
    group.wait()
    print("settings loaded {loads.load_int()} time, replicas seen by all readers: {seen.load_int()}")

    let announced = atomic.int(0)
    let announce = sync.once()
    for i in 0..5 {
        announce.run(fn() { announced.add_int(1) })
    }
    print("announced {announced.load_int()} time")

    let registry = new(Registry { lock: sync.rw_lock(), services: [:] })
    let writers = sync.wait_group()
    for i in 0..5 {
        writers.add(1)
        spawn register(registry, "service-{i}", 9000 + i, writers)
    }
    writers.wait()
    let count = registry.lock.reading(fn() -> i64 { registry.services.len })
    let port = registry.lock.reading(fn() -> i64 { registry.services["service-3"] ?? 0 })
    print("{count} services registered, service-3 listens on {port}")
    let reading = registry.lock.try_read_lock()
    let writing = registry.lock.try_write_lock()
    print("with a read lock held, another reader gets in: {reading}, a writer: {writing}")
    registry.lock.read_unlock()
}
