import std/atomic
import std/math
import std/sync

enum CheckError {
    Empty(name: str)
    TooLarge(name: str, bytes: i64)
}

struct Upload {
    name: str
    bytes: i64
}

fn describe(e: CheckError) -> str {
    match e {
        Empty(name) => "{name} is empty"
        TooLarge(name, bytes) => "{name} is too large at {bytes} bytes"
    }
}

/// Validates uploads on at most two green threads at a time, and returns the first error.
fn main() {
    let uploads = [
        Upload { name: "a.png", bytes: 1200 },
        Upload { name: "b.png", bytes: 880 },
        Upload { name: "c.png", bytes: 5000000 },
        Upload { name: "d.png", bytes: 40 },
        Upload { name: "e.png", bytes: 2500 },
        Upload { name: "f.png", bytes: 310 }
    ]
    let running = atomic.int(0)
    let peak = atomic.int(0)
    let checked = atomic.int(0)

    let g = sync.group[CheckError](2)
    for upload in uploads {
        g.go(fn() -> CheckError? {
            let now = running.add_int(1)
            peak.update_int(fn(seen: i64) -> i64 { math.max(seen, now) })
            sleep(2)
            running.add_int(-1)
            checked.add_int(1)
            if upload.bytes == 0 {
                return some(CheckError.Empty(upload.name))
            }
            if upload.bytes > 1000000 {
                return some(CheckError.TooLarge(upload.name, upload.bytes))
            }
            none
        })
    }
    match g.join() {
        some(e) => print("failed: {describe(e)}")
        none => print("all uploads valid")
    }
    print("checked {checked.load_int()} of {uploads.len}, at most 2 at once: {peak.load_int() <= 2}")

    let clean = sync.group[CheckError](4)
    clean.go(fn() -> CheckError? { none })
    clean.go(fn() -> CheckError? { none })
    print("clean group has an error: {clean.join() != none}")
}
