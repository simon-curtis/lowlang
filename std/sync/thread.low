/// Pins the calling green thread to the OS thread it is running on.
///
/// Until a matching `unlock_thread`, the green thread runs only on this OS thread, and the OS thread runs no other green thread: while the green thread waits, its OS thread sleeps and the scheduler starts another for the rest. Code that calls a C library whose state belongs to one OS thread, such as a Win32 window, locks first. Calls nest, and each `lock_thread` needs its own `unlock_thread`.
pub fn lock_thread() {
    __lock_thread()
}

/// Releases one `lock_thread` of the calling green thread.
///
/// Once every lock is released the green thread may move between OS threads again.
pub fn unlock_thread() {
    __unlock_thread()
}
