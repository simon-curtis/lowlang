struct OnceCell[T] {
    guard: Mutex
    compute: fn() -> T
    result: T?
}

/// A value computed by a function the first time it is requested and then reused.
///
/// Copies of an `OnceValue` share the cached value.
pub struct OnceValue[T] {
    cell: *OnceCell[T]
}

/// Returns an `OnceValue` that calls `compute` on the first `get_once`.
pub fn once_value[T](compute: fn() -> T) -> OnceValue[T] {
    OnceValue { cell: new(OnceCell { guard: mutex(), compute, result: none }) }
}

/// Returns the value of `o`, calling its function if this is the first request.
///
/// Callers that arrive while the function runs park until it finishes, so the function runs once and every caller receives the same result.
pub fn get_once[T](o: OnceValue[T]) -> T {
    let c = o.cell
    lock(c.guard)
    let held = c.result
    match held {
        some(v) => {
            unlock(c.guard)
            v
        }
        none => {
            let produce = c.compute
            let v = produce()
            c.result = some(v)
            unlock(c.guard)
            v
        }
    }
}

struct GroupState[E] {
    slots: Semaphore
    pending: WaitGroup
    guard: Mutex
    first: E?
}

/// A set of tasks that run concurrently on green threads, with a limit on how many run at once and a record of the first error.
///
/// Copies of an `ErrorGroup` share its state.
pub struct ErrorGroup[E] {
    state: *GroupState[E]
}

/// Returns an `ErrorGroup` that runs at most `limit` tasks at a time.
///
/// `limit` must be at least 1: with a smaller limit `go` parks forever.
pub fn group[E](limit: i64) -> ErrorGroup[E] {
    ErrorGroup { state: new(GroupState { slots: semaphore(limit), pending: wait_group(), guard: mutex(), first: none }) }
}

fn run_task[E](st: *GroupState[E], f: fn() -> E?) {
    let outcome = f()
    match outcome {
        some(e) => record(st, e)
        none => {}
    }
    release(st.slots)
    done(st.pending)
}

fn record[E](st: *GroupState[E], e: E) {
    lock(st.guard)
    let held = st.first
    match held {
        some(earlier) => {}
        none => { st.first = some(e) }
    }
    unlock(st.guard)
}

/// Runs `f` on a new green thread as a task of `g`.
///
/// Parks the green thread while `limit` tasks are already running. When `f` returns `some(e)`, `e` is recorded unless an earlier task has already recorded an error; the other tasks are not stopped.
pub fn go[E](g: ErrorGroup[E], f: fn() -> E?) {
    let st = g.state
    acquire(st.slots)
    add(st.pending, 1)
    spawn run_task(st, f)
}

/// Parks the green thread until every task started with `go` has finished, and returns the first recorded error, or `none` if no task failed.
pub fn join[E](g: ErrorGroup[E]) -> E? {
    let st = g.state
    wait(st.pending)
    lock(st.guard)
    let first = st.first
    unlock(st.guard)
    first
}
