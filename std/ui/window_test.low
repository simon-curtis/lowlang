import std/testing
import std/ui/platform

fn plain() -> Element {
    div().size(20.0, 20.0)
}

fn opened(cx: Context) -> Window {
    open_window(cx, WindowOptions {}, plain) catch {
        e => panic("cannot open a window")
    }
}

fn keyed_view(log: Signal[str], text: Signal[str]) -> Element {
    let field_view = field(get(text)).id("f").width(200.0).on_change(fn(s: str) { set(text, s) })
    div().size(300.0, 100.0).on_action("open", fn() { add_note(log, "open") }).child(field_view)
}

fn unsupported_detail(e: Error) -> str {
    match e {
        Platform(p) => match p {
            Unsupported(detail) => detail
            _ => ""
        }
        Gpu(g) => ""
    }
}

fn close_text(why: CloseReason) -> str {
    match why {
        Requested => "requested"
        Failed(e) => "failed"
    }
}

fn test_a_set_from_one_window_makes_the_other_due(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = window_context(opened(a))
    let count = signal(b, 0)
    frame(a, plain, window(), 1.0)
    frame(b, plain, window(), 1.0)
    testing.is_false(t, frame_due(a))
    testing.is_false(t, frame_due(b))
    set(count, 1)
    testing.is_true(t, frame_due(a))
    testing.is_true(t, frame_due(b))
    frame(a, plain, window(), 1.0)
    testing.is_false(t, frame_due(a))
    testing.is_true(t, frame_due(b))
}

fn test_separate_headless_calls_stay_isolated(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = headless(rgb(0xffffff))
    let count = signal(a, 0)
    frame(a, plain, window(), 1.0)
    frame(b, plain, window(), 1.0)
    set(count, 1)
    post(handle(a), fn() {})
    set_clipboard(a, "copied")
    bind_keys(a, [binding_of("ctrl-k ctrl-o", "open", "")])
    frame(a, plain, window(), 1.0)
    testing.is_false(t, frame_due(b))
    testing.is_true(t, clipboard(b) == none)
    testing.equal(t, bindings_for_action(b, "open").len, 0)
    testing.equal(t, bindings_for_action(a, "open").len, 1)
}

fn test_advance_clock_fires_the_timers_of_both_windows(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = window_context(opened(a))
    let log = signal(a, "")
    let text_a = signal(a, "")
    let text_b = signal(a, "")
    let view_a = fn() -> Element { keyed_view(log, text_a) }
    let view_b = fn() -> Element { keyed_view(log, text_b) }
    bind_keys(a, [binding_of("j k", "leave", "")])
    frame(a, view_a, window(), 1.0)
    frame(b, view_b, window(), 1.0)
    set_focus(a, "f")
    set_focus(b, "f")
    type_plain(a, "j")
    type_plain(b, "j")
    testing.equal(t, get(text_a), "")
    testing.equal(t, get(text_b), "")
    advance_clock(b, 999)
    testing.equal(t, get(text_a), "")
    testing.equal(t, get(text_b), "")
    advance_clock(b, 1)
    testing.equal(t, get(text_a), "j")
    testing.equal(t, get(text_b), "j")
}

fn test_a_chord_pending_in_one_window_does_not_complete_in_another(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = window_context(opened(a))
    let log = signal(a, "")
    let text = signal(a, "")
    let view = fn() -> Element { keyed_view(log, text) }
    bind_keys(a, [binding_of("ctrl-k ctrl-o", "open", "")])
    frame(a, view, window(), 1.0)
    frame(b, view, window(), 1.0)
    set_focus(a, "f")
    set_focus(b, "f")
    type_ctrl(a, "k")
    testing.equal(t, pending_text(a), "[ctrl-k]")
    testing.equal(t, pending_text(b), "")
    type_ctrl(b, "o")
    testing.equal(t, get(log), "")
    testing.equal(t, pending_text(a), "[ctrl-k]")
    type_ctrl(a, "o")
    testing.equal(t, get(log), "open")
    testing.equal(t, pending_text(a), "")
}

fn test_bind_keys_in_one_window_binds_in_another(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = window_context(opened(a))
    let log = signal(a, "")
    let text = signal(a, "")
    let view = fn() -> Element { keyed_view(log, text) }
    frame(b, view, window(), 1.0)
    set_focus(b, "f")
    type_ctrl(b, "o")
    testing.equal(t, get(log), "")
    bind_keys(a, [binding_of("ctrl-o", "open", "")])
    type_ctrl(b, "o")
    testing.equal(t, get(log), "open")
}

fn test_spawn_into_on_a_signal_made_in_a_closed_window_still_delivers(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let w = opened(a)
    let total = signal(window_context(w), 0)
    close_window(w)
    let gate = chan[i64]()
    let task = total.spawn_into(doubled_after(gate))
    frame(a, plain, window(), 1.0)
    testing.is_false(t, task.finished())
    gate <- 21
    testing.is_true(t, deliver_finished(a, task))
    testing.equal(t, get(total), 42)
    testing.is_true(t, frame_due(a))
}

fn test_close_window_runs_closed_and_leaves_the_context_usable(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let log = signal(a, "")
    let owner_closed = fn(why: CloseReason) { add_note(log, "owner {close_text(why)}") }
    let owned_closed = fn(why: CloseReason) { add_note(log, "owned {close_text(why)}") }
    let owner = open_window(a, WindowOptions { closed: owner_closed }, plain) catch {
        e => panic("cannot open a window")
    }
    let owned = open_window(a, WindowOptions { owner: some(owner), closed: owned_closed }, plain) catch {
        e => panic("cannot open a window")
    }
    let lone = opened(a)
    let lone_cx = window_context(lone)
    frame(lone_cx, plain, window(), 1.0)
    close_window(lone)
    testing.is_false(t, is_open(lone))
    testing.is_true(t, is_open(main_window(a)))
    frame(lone_cx, plain, window(), 1.0)
    testing.is_false(t, frame_due(lone_cx))
    dispatch(lone_cx, platform.Event.Resized(320.0, 240.0, 2.0))
    testing.is_true(t, frame_due(lone_cx))
    close_window(owner)
    testing.is_false(t, is_open(owned))
    testing.is_false(t, is_open(owner))
    close_window(owner)
    testing.equal(t, get(log), "owned requested owner requested")
}

fn test_open_window_from_inside_render_fails_as_unsupported(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let reason = signal(a, "")
    let view = fn() -> Element {
        let attempt: Window? = open_window(a, WindowOptions {}, plain) catch {
            e => {
                set(reason, unsupported_detail(e))
                none
            }
        }
        plain()
    }
    frame(a, view, window(), 1.0)
    testing.equal(t, get(reason), "open_window inside render")
    testing.is_true(t, is_open(opened(a)))
}

fn test_a_post_drained_by_one_window_makes_the_other_due(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = window_context(opened(a))
    frame(a, plain, window(), 1.0)
    frame(b, plain, window(), 1.0)
    post(handle(b), fn() {})
    testing.is_false(t, frame_due(a))
    frame(a, plain, window(), 1.0)
    testing.is_false(t, frame_due(a))
    testing.is_true(t, frame_due(b))
}

fn test_a_list_handle_made_in_one_window_makes_every_window_due(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = window_context(opened(a))
    let handle = uniform_list_scroll_handle(a)
    let items = list_state(a, 100, ListAlignment.Top, 0.0)
    frame(a, plain, window(), 1.0)
    frame(b, plain, window(), 1.0)
    scroll_to_item(handle, 3, ScrollStrategy.Top)
    testing.is_true(t, frame_due(b))
    frame(b, plain, window(), 1.0)
    testing.is_false(t, frame_due(b))
    list_scroll_by(items, 10.0)
    testing.is_true(t, frame_due(b))
}

fn test_the_context_of_a_closed_window_still_fires_its_timers(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let w = opened(a)
    let b = window_context(w)
    let log = signal(a, "")
    let text = signal(a, "")
    let view = fn() -> Element { keyed_view(log, text) }
    bind_keys(a, [binding_of("j k", "leave", "")])
    frame(b, view, window(), 1.0)
    set_focus(b, "f")
    type_plain(b, "j")
    close_window(w)
    advance_clock(b, 1000)
    testing.equal(t, get(text), "j")
    testing.equal(t, pending_text(b), "")
}

fn test_a_close_request_closes_a_tool_window_and_ends_only_the_main_one(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let log = signal(a, "")
    let on_closed = fn(why: CloseReason) { add_note(log, close_text(why)) }
    let w = open_window(a, WindowOptions { closed: on_closed }, plain) catch {
        e => panic("cannot open a window")
    }
    let b = window_context(w)
    dispatch(b, platform.Event.CloseRequested)
    testing.is_false(t, is_open(w))
    testing.equal(t, get(log), "requested")
    testing.is_false(t, closed(a))
    testing.is_true(t, closed(b))
    dispatch(b, platform.Event.CloseRequested)
    testing.equal(t, get(log), "requested")
    dispatch(a, platform.Event.CloseRequested)
    testing.is_true(t, closed(a))
    testing.is_true(t, is_open(main_window(a)))
}

fn test_activating_a_headless_or_closed_window_leaves_it_as_it_was(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let w = opened(a)
    activate_window(w)
    activate_window(main_window(a))
    testing.is_true(t, is_open(w))
    testing.is_false(t, closed(window_context(w)))
    close_window(w)
    activate_window(w)
    testing.is_false(t, is_open(w))
}

fn test_quit_from_one_window_ends_the_application_for_every_window(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = window_context(opened(a))
    testing.is_false(t, closed(a))
    quit(b)
    testing.is_true(t, closed(a))
    testing.is_true(t, closed(b))
}

fn test_an_owner_that_has_closed_or_belongs_elsewhere_fails_open_window(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let other = headless(rgb(0xffffff))
    let owner = opened(a)
    let reason = signal(a, "")
    let attempt = fn(cx: Context, who: Window) {
        let made: Window? = open_window(cx, WindowOptions { owner: some(who) }, plain) catch {
            e => {
                set(reason, unsupported_detail(e))
                none
            }
        }
    }
    attempt(a, main_window(other))
    testing.equal(t, get(reason), "open_window with an owner from another application")
    close_window(owner)
    attempt(a, owner)
    testing.equal(t, get(reason), "open_window with an owner that has closed")
    set(reason, "")
    attempt(a, main_window(a))
    testing.equal(t, get(reason), "")
}

fn test_advance_clock_skips_a_window_an_earlier_timer_closed(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let w = opened(a)
    let log = signal(a, "")
    schedule(a.state, 10, fn() { close_window(w) })
    schedule(window_context(w).state, 10, fn() { add_note(log, "late") })
    advance_clock(a, 10)
    testing.is_false(t, is_open(w))
    testing.equal(t, get(log), "")
}

fn test_a_window_opened_inside_a_frame_is_refused_and_a_nested_frame_keeps_the_guard(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = window_context(opened(a))
    let victim = opened(a)
    let reason = signal(a, "")
    let view = fn() -> Element {
        frame(b, plain, window(), 1.0)
        close_window(victim)
        let attempt: Window? = open_window(a, WindowOptions {}, plain) catch {
            e => {
                set(reason, unsupported_detail(e))
                none
            }
        }
        plain()
    }
    frame(a, view, window(), 1.0)
    testing.equal(t, get(reason), "open_window inside render")
    testing.is_true(t, is_open(victim))
    close_window(victim)
    testing.is_false(t, is_open(victim))
}

fn test_clearing_key_bindings_drops_the_chords_pending_in_every_window(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = window_context(opened(a))
    let log = signal(a, "")
    let text = signal(a, "")
    let view = fn() -> Element { keyed_view(log, text) }
    bind_keys(a, [binding_of("ctrl-k ctrl-o", "open", "")])
    frame(b, view, window(), 1.0)
    set_focus(b, "f")
    type_ctrl(b, "k")
    testing.equal(t, pending_text(b), "[ctrl-k]")
    clear_key_bindings(a)
    testing.equal(t, pending_text(b), "")
}

fn test_a_new_window_takes_the_rem_size_of_its_opener(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    set_rem_size(a, 20.0)
    let b = window_context(opened(a))
    testing.equal(t, rem_size(b), 20.0)
    set_rem_size(b, 12.0)
    testing.equal(t, rem_size(a), 20.0)
}

fn test_separate_headless_calls_keep_separate_timers_and_clocks(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = headless(rgb(0xffffff))
    let log = signal(a, "")
    schedule(a.state, 10, fn() { add_note(log, "a") })
    advance_clock(b, 10)
    testing.equal(t, get(log), "")
    testing.equal(t, now_ms(a.state), 0)
    testing.equal(t, now_ms(b.state), 10)
    advance_clock(a, 10)
    testing.equal(t, get(log), "a")
}

fn test_a_task_spawned_before_its_window_closes_still_delivers(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let w = opened(a)
    let total = signal(window_context(w), 0)
    let gate = chan[i64]()
    let task = total.spawn_into(doubled_after(gate))
    close_window(w)
    gate <- 21
    testing.is_true(t, deliver_finished(a, task))
    testing.equal(t, get(total), 42)
}

fn test_each_window_has_its_own_reveal_deadline(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let first = main_window(a)
    advance_clock(a, 200)
    let second = opened(a)
    testing.equal(t, first.slot.deadline, reveal_deadline_ms)
    testing.equal(t, second.slot.deadline, 200 + reveal_deadline_ms)
    let both = open_windows(a.state.shared)
    testing.equal(t, wait_for(both), reveal_deadline_ms - 200)
    first.slot.state.revealed = true
    testing.equal(t, wait_for(both), reveal_deadline_ms)
    second.slot.state.revealed = true
    testing.equal(t, wait_for(both), -1)
}

fn test_a_failed_tool_window_closes_alone_and_a_failed_main_window_returns_the_error(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let log = signal(a, "")
    let on_closed = fn(why: CloseReason) { add_note(log, close_text(why)) }
    let tool = open_window(a, WindowOptions { closed: on_closed }, plain) catch {
        e => panic("cannot open a window")
    }
    let reason = Error.Platform(platform.Error.Disconnected)
    fail_window(tool, reason) catch {
        e => t.error("a tool window's failure returned an error")
    }
    testing.is_false(t, is_open(tool))
    testing.is_true(t, is_open(main_window(a)))
    testing.equal(t, get(log), "failed")
    var returned = false
    fail_window(main_window(a), reason) catch {
        e => {
            returned = true
        }
    }
    testing.is_true(t, returned)
    testing.is_true(t, is_open(main_window(a)))
}

fn test_closing_every_window_closes_tools_before_the_main_window(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let log = signal(a, "")
    let tool_closed = fn(why: CloseReason) { add_note(log, "tool") }
    let owned_closed = fn(why: CloseReason) { add_note(log, "owned") }
    let tool = open_window(a, WindowOptions { closed: tool_closed }, plain) catch {
        e => panic("cannot open a window")
    }
    let owned = open_window(a, WindowOptions { owner: some(tool), closed: owned_closed }, plain) catch {
        e => panic("cannot open a window")
    }
    close_tools(a.state.shared)
    testing.equal(t, get(log), "owned tool")
    testing.is_true(t, is_open(main_window(a)))
    close_all(a.state.shared)
    testing.is_false(t, is_open(main_window(a)))
    testing.is_false(t, is_open(owned))
}

fn test_a_headless_window_takes_an_icon_and_does_nothing(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let frames = [IconFrame { size: 16, png: "not a PNG, and nothing looks at it here" }]
    set_window_icon(main_window(a), frames) catch {
        e => t.error("set_window_icon on a headless window returned an error")
    }
    set_window_icon(main_window(a), []) catch {
        e => t.error("clearing the icon of a headless window returned an error")
    }
}

fn test_a_headless_tool_window_opens_with_an_icon_option(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let frames = [IconFrame { size: 16, png: "not a PNG" }]
    let tool = open_window(a, WindowOptions { icon: some(frames) }, plain) catch {
        e => panic("cannot open a window")
    }
    testing.is_true(t, is_open(tool))
    set_window_icon(tool, frames) catch {
        e => t.error("set_window_icon on a headless tool window returned an error")
    }
}

fn test_a_window_keeps_the_title_it_opened_with_until_set_title_changes_it(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let tool = open_window(a, WindowOptions { title: "Tool" }, plain) catch {
        e => panic("cannot open a window")
    }
    let b = window_context(tool)
    testing.equal(t, window_title(a), "Low")
    testing.equal(t, window_title(b), "Tool")
    set_title(b, "Renamed")
    testing.equal(t, window_title(a), "Low")
    testing.equal(t, window_title(b), "Renamed")
}

fn test_a_headless_window_has_no_native_handles(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    testing.is_true(t, native_window(a) == none)
}

fn test_window_focus_follows_the_focus_events_of_its_own_window(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let b = window_context(opened(a))
    testing.is_false(t, window_focused(a))
    dispatch(a, platform.Event.FocusChanged(true))
    testing.is_true(t, window_focused(a))
    testing.is_false(t, window_focused(b))
    dispatch(a, platform.Event.FocusChanged(false))
    testing.is_false(t, window_focused(a))
}

fn test_on_focus_changed_runs_each_handler_once_per_change(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    let log = signal(a, "")
    on_focus_changed(a, fn(focused: bool) { add_note(log, if focused { "in" } else { "out" }) })
    on_focus_changed(a, fn(focused: bool) { add_note(log, "again") })
    frame(a, plain, window(), 1.0)
    dispatch(a, platform.Event.FocusChanged(true))
    dispatch(a, platform.Event.FocusChanged(true))
    testing.is_true(t, frame_due(a))
    dispatch(a, platform.Event.FocusChanged(false))
    testing.equal(t, get(log), "in again out again")
}
