import std/file
import std/os
import std/sys
import strs = std/text
import std/testing

fn debug_socket(name: str) -> str {
    let dir = os.env("TMPDIR") ?? "/tmp"
    "{dir}/low-ui-test-{sys.pid()}-{name}.sock"
}

fn test_the_default_path_names_the_process(t: *testing.T) {
    os.set_env("XDG_RUNTIME_DIR", "/run/user/1") or panic("set_env")
    testing.equal(t, debug_path(42), "/run/user/1/low-ui-42.sock")
    os.unset_env("XDG_RUNTIME_DIR") or panic("unset_env")
    testing.equal(t, debug_path(42), "/tmp/low-ui-{sys.uid()}-42.sock")
}

fn test_the_socket_is_readable_by_its_owner_only(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    using server = debug_serve(cx, "mode")
    let info = file.stat(server.path) or panic("stat")
    testing.equal(t, info.mode & 511, 384)
}

fn test_a_peer_of_another_user_is_dropped(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let path = debug_socket("stranger")
    let endpoint = listen_for(path, sys.uid() + 1) or panic("listen_for")
    using server = serve_endpoint(cx, endpoint, path, 1000)
    let seen = debug_wait(fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        let list = debug_elements(c) catch {
            e => return debug_failure(e)
        }
        debug_lines(list)
    })
    testing.is_true(t, strs.starts_with(seen, "io "))
}

fn test_a_socket_file_nothing_listens_on_is_replaced(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let path = debug_socket("stale")
    file.write_text(path, "") or panic("write_text")
    using server = serve_debug(cx, DebugOptions { path }) or panic("serve_debug")
    testing.equal(t, server.path, path)
}

fn test_a_socket_another_server_answers_on_is_not_taken(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let path = debug_socket("taken")
    using first = serve_debug(cx, DebugOptions { path }) or panic("serve_debug")
    testing.is_true(t, debug_is_taken(cx, path))
}

fn debug_is_taken(cx: Context, path: str) -> bool {
    let options = DebugOptions { path }
    using second = serve_debug(cx, options) catch {
        AddrInUse => return true
        e => return false
    }
    false
}
