import std/testing
import std/ui/platform

fn deliver_finished(cx: Context, task: Task) -> bool {
    for i in 0..5000 {
        if task.finished() {
            return true
        }
        sleep(1)
        dispatch(cx, platform.Event.Woken)
    }
    false
}

fn doubled_after(gate: chan[i64]) -> fn() -> i64 {
    fn() -> i64 { ((<-gate) ?? 0) * 2 }
}

fn test_spawn_into_sets_the_signal_once_the_work_returns(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let total = signal(cx, 0)
    let gate = chan[i64]()
    let task = total.spawn_into(doubled_after(gate))
    dispatch(cx, platform.Event.Woken)
    testing.is_false(t, task.finished())
    testing.equal(t, get(total), 0)

    gate <- 21
    testing.is_true(t, deliver_finished(cx, task))
    testing.equal(t, get(total), 42)
    testing.is_true(t, frame_due(cx))
}

fn test_background_spawn_runs_done_with_the_result(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let seen = signal(cx, "")
    let gate = chan[i64]()
    let done = fn(n: i64) { set(seen, "got {n}") }
    let task = background_spawn(cx, doubled_after(gate), done)
    gate <- 5
    testing.is_true(t, deliver_finished(cx, task))
    testing.equal(t, get(seen), "got 10")
}

fn test_a_cancelled_task_finishes_without_delivering(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let total = signal(cx, 1)
    let gate = chan[i64]()
    let task = total.spawn_into(doubled_after(gate))
    task.cancel()
    gate <- 21
    testing.is_true(t, deliver_finished(cx, task))
    testing.equal(t, get(total), 1)
}
