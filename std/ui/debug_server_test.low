import std/io
import strs = std/text
import std/testing
import std/ui/geometry
import std/ui/platform

fn debug_form(clicks: Signal[i64], name: Signal[str]) -> Element {
    div().column().size(200.0, 100.0).children() {
        div().id("save").size(80.0, 30.0).on_click(fn(e: ClickEvent) { set(clicks, get(clicks) + 1) }).child(text("Save")),
        field(get(name)).id("name").width(100.0).height(20.0).on_change(fn(s: str) { set(name, s) }),
        field("hunter2").id("secret").masked().width(100.0).height(20.0),
    }
}

fn debug_view(clicks: Signal[i64], name: Signal[str]) -> fn() -> Element {
    fn() -> Element { debug_form(clicks, name) }
}

fn debug_line(e: ElementInfo) -> str {
    "{e.key}|{e.id}|{e.label}|{e.role}|{e.text}|{e.bounds.x},{e.bounds.y},{e.bounds.width},{e.bounds.height}|{e.visible}|{e.focused}"
}

fn debug_lines(list: ElementInfo[]) -> str {
    var out: str[] = []
    for e in list {
        out.push(debug_line(e))
    }
    "{out}"
}

fn debug_report(client: fn() -> str, done: chan[str]) {
    done <- client()
}

fn debug_drive(cx: Context, view: fn() -> Element, client: fn() -> str) -> str {
    let done = chan[str](1)
    spawn debug_report(client, done)
    frame(cx, view, window(), 1.0)
    for {
        let finished: str? = select {
            r = <-done => r
            else => none
        }
        match finished {
            some(v) => return v
            none => {}
        }
        dispatch(cx, platform.Event.Woken)
        if frame_due(cx) {
            frame(cx, view, window(), 1.0)
        }
        sleep(1)
    }
}

fn debug_wait(client: fn() -> str) -> str {
    let done = chan[str](1)
    spawn debug_report(client, done)
    for {
        let finished: str? = select {
            r = <-done => r
            else => none
        }
        match finished {
            some(v) => return v
            none => sleep(1)
        }
    }
}

fn debug_failure(e: DebugError) -> str {
    match e {
        Io(cause) => "io {cause}"
        Remote(message) => "remote {message}"
        Protocol(message) => "protocol {message}"
    }
}

fn debug_serve(cx: Context, name: str) -> DebugServer {
    serve_debug(cx, DebugOptions { path: debug_socket(name) }) or panic("serve_debug")
}

fn test_a_client_lists_the_elements_a_frame_drew(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = debug_view(signal(cx, 0), signal(cx, "ab"))
    using server = debug_serve(cx, "list")
    let path = server.path
    let seen = debug_drive(cx, view, fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        let list = debug_elements(c) catch {
            e => return debug_failure(e)
        }
        debug_lines(list)
    })
    testing.equal(t, seen, debug_lines(elements(cx)))
    testing.is_true(t, elements(cx).len >= 4)
}

fn test_a_client_clicks_an_element_by_key(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = debug_view(clicks, signal(cx, "ab"))
    using server = debug_serve(cx, "click")
    let path = server.path
    let seen = debug_drive(cx, view, fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        let hit = debug_click(c, "save") catch {
            e => return debug_failure(e)
        }
        let miss = debug_click(c, "nothing") catch {
            e => return debug_failure(e)
        }
        "{hit} {miss}"
    })
    testing.equal(t, seen, "true false")
    testing.equal(t, get(clicks), 1)
}

fn test_a_client_types_into_a_field_and_reads_it_back(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let name = signal(cx, "ab")
    let view = debug_view(signal(cx, 0), name)
    using server = debug_serve(cx, "type")
    let path = server.path
    let seen = debug_drive(cx, view, fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        let first = debug_type_into(c, "name", "Z") catch {
            e => return debug_failure(e)
        }
        let second = debug_type(c, "Y") catch {
            e => return debug_failure(e)
        }
        let shown = debug_text(c, "name") catch {
            e => return debug_failure(e)
        }
        "{first} {second} {shown}"
    })
    testing.equal(t, get(name), "ZYab")
    testing.equal(t, seen, "true true ZYab")
}

fn test_typing_with_nothing_focused_or_into_a_missing_element_sends_nothing(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let name = signal(cx, "ab")
    let view = debug_view(signal(cx, 0), name)
    using server = debug_serve(cx, "nofocus")
    let path = server.path
    let seen = debug_drive(cx, view, fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        let unfocused = debug_type(c, "x") catch {
            e => return debug_failure(e)
        }
        let missing = debug_type_into(c, "nothing", "x") catch {
            e => return debug_failure(e)
        }
        "{unfocused} {missing}"
    })
    testing.equal(t, seen, "false false")
    testing.equal(t, get(name), "ab")
}

fn test_a_masked_field_reads_empty_over_the_wire(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = debug_view(signal(cx, 0), signal(cx, "ab"))
    using server = debug_serve(cx, "masked")
    let path = server.path
    let seen = debug_drive(cx, view, fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        let typed = debug_type_into(c, "secret", "more") catch {
            e => return debug_failure(e)
        }
        let shown = debug_text(c, "secret") catch {
            e => return debug_failure(e)
        }
        let list = debug_elements(c) catch {
            e => return debug_failure(e)
        }
        var leaked = false
        for e in list {
            if e.text == "hunter2" || e.text == "hunter2more" {
                leaked = true
            }
        }
        "{typed} [{shown}] {leaked}"
    })
    testing.equal(t, seen, "true [] false")
}

fn test_a_client_finds_the_topmost_element_at_a_point(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = debug_view(signal(cx, 0), signal(cx, "ab"))
    using server = debug_serve(cx, "at")
    let path = server.path
    let seen = debug_drive(cx, view, fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        let on_save = debug_element_at(c, geometry.point(10.0, 10.0)) catch {
            e => return debug_failure(e)
        }
        let nowhere = debug_element_at(c, geometry.point(190.0, 95.0)) catch {
            e => return debug_failure(e)
        }
        "{on_save ?? "none"} {nowhere ?? "none"}"
    })
    testing.equal(t, seen, "save none")
}

fn test_reading_the_text_of_a_missing_element_fails_with_the_servers_message(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = debug_view(signal(cx, 0), signal(cx, "ab"))
    using server = debug_serve(cx, "missing")
    let path = server.path
    let seen = debug_drive(cx, view, fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        let shown = debug_text(c, "nothing") catch {
            e => return debug_failure(e)
        }
        shown
    })
    testing.equal(t, seen, "remote the last frame drew no element with the key nothing")
}

fn debug_exchange(w: *Wire, line: str) -> str {
    write_message(w.stream, line) or return "write failed"
    let reply = read_message(w) or return "read failed"
    str(reply)
}

fn test_a_bad_request_is_answered_and_the_connection_stays_open(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = debug_view(clicks, signal(cx, "ab"))
    using server = debug_serve(cx, "bad")
    let path = server.path
    let seen = debug_drive(cx, view, fn() -> str {
        let stream = dial(path) or return "dial failed"
        defer stream.close()
        let w = new(Wire { stream })
        var replies: str[] = []
        replies.push(debug_exchange(w, "not json"))
        replies.push(debug_exchange(w, "{{\"id\": 3}}"))
        replies.push(debug_exchange(w, "{{\"id\": 7, \"method\": \"nope\"}}"))
        replies.push(debug_exchange(w, "{{\"id\": 8, \"method\": \"click\", \"params\": {{}}}}"))
        replies.push(debug_exchange(w, "{{\"id\": 9, \"method\": \"click\", \"params\": {{\"key\": \"save\"}}}}"))
        strs.join(replies, " ")
    })
    let wanted = "{{\"id\":null,\"error\":\"the request is not JSON\"}} {{\"id\":3,\"error\":\"the request has no method\"}} {{\"id\":7,\"error\":\"unknown method nope\"}} {{\"id\":8,\"error\":\"click needs the string key\"}} {{\"id\":9,\"result\":true}}"
    testing.equal(t, seen, wanted)
    testing.equal(t, get(clicks), 1)
}

fn test_a_reply_larger_than_a_line_buffer_arrives_whole(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        var rows: Element[] = []
        for i in 0..600 {
            rows.push(div().size(10.0, 10.0).label("row number {i}").role(Role.ListItem))
        }
        div().children(rows)
    }
    using server = debug_serve(cx, "large")
    let path = server.path
    let seen = debug_drive(cx, view, fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        let list = debug_elements(c) catch {
            e => return debug_failure(e)
        }
        debug_lines(list)
    })
    testing.is_true(t, seen.len > 16384)
    testing.equal(t, seen, debug_lines(elements(cx)))
}

fn test_a_request_is_answered_with_an_error_when_no_frame_is_drawn(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    using server = serve_debug(cx, DebugOptions { path: debug_socket("idle"), timeout_ms: 50 }) or panic("serve_debug")
    let path = server.path
    let seen = debug_wait(fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        let list = debug_elements(c) catch {
            e => return debug_failure(e)
        }
        debug_lines(list)
    })
    testing.equal(t, seen, "remote the window drew no frame in time")
}

fn test_a_released_server_accepts_no_connection(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    var path = ""
    {
        using server = debug_serve(cx, "released")
        path = server.path
    }
    let seen = debug_wait(fn() -> str {
        using c = debug_connect(path) catch {
            e => return debug_failure(e)
        }
        "connected"
    })
    testing.is_true(t, strs.starts_with(seen, "io "))
}
