import std/sync

const hwnd_message: i64 = -3

struct DisplayState {
    instance: ptr
    hwnd: ptr = null
    anchor: ptr = null
    waker: *WakerState
    windows: *WindowState[] = []
    wakes: i64 = 0
    ole: bool = false
    closed: bool = false
    reload_message: u32 = 0
}

fn display_closed(d: *DisplayState) -> bool {
    d.closed
}

fn display_waker(d: *DisplayState) -> *WakerState {
    d.waker
}

fn connect_display() -> *DisplayState ! Error {
    sync.lock_thread()
    let d = new(DisplayState {
        instance: GetModuleHandleW(null)
        waker: new(WakerState { hwnd: null })
        reload_message: reload_message_id()
    })
    build_display(d) catch {
        e => {
            close_display(d)
            fail e
        }
    }
    d
}

fn build_display(d: *DisplayState) ! Error {
    if GetProcessWindowStation() == null {
        fail NoDisplay("no window station")
    }
    SetProcessDpiAwarenessContext(dpi_awareness_per_monitor_v2)
    register_class(d.instance, display_class_name(), display_proc)?
    d.ole = OleInitialize(null) >= 0
    let slot: *DisplayState[] = [d]
    d.anchor = pin(slot)
    create_display_window(d)?
}

fn reload_message_id() -> u32 {
    let name = wide("LowHotReload")
    RegisterWindowMessageW(__slice_ptr(name))
}

fn display_class_name() -> u8[] {
    wide("LowDisplay")
}

fn register_class(instance: ptr, name: u8[], procedure: extern fn(ptr, u32, i64, i64) -> i64) ! Error {
    var class = WndClassEx {
        procedure
        instance
        cursor: LoadCursorW(null, idc_arrow)
        class_name: __slice_ptr(name)
    }
    if RegisterClassExW(mut class) == 0 {
        let code = GetLastError()
        if code != error_class_exists {
            fail creation_error("RegisterClassExW", code)
        }
    }
}

fn create_display_window(d: *DisplayState) ! Error {
    let name = display_class_name()
    let parent: ptr = ptr(hwnd_message)
    let hwnd = CreateWindowExW(0, __slice_ptr(name), null, 0, 0, 0, 0, 0, parent, null, d.instance, d.anchor)
    if hwnd == null {
        fail creation_error("CreateWindowExW", GetLastError())
    }
    d.hwnd = hwnd
    d.waker.hwnd = hwnd
}

fn display_proc(hwnd: ptr, msg: u32, wparam: i64, lparam: i64) -> i64 {
    if msg == wm_nccreate {
        return bind_state(hwnd, msg, wparam, lparam)
    }
    let anchor = GetWindowLongPtrW(hwnd, gwlp_userdata)
    if anchor == null {
        return DefWindowProcW(hwnd, msg, wparam, lparam)
    }
    let slot: ptr[*DisplayState] = anchor
    let d = load(slot)
    if msg == wm_ncdestroy {
        d.hwnd = null
        d.waker.hwnd = null
        SetWindowLongPtrW(hwnd, gwlp_userdata, null)
        return DefWindowProcW(hwnd, msg, wparam, lparam)
    }
    if msg == wm_app {
        d.wakes = d.wakes + 1
        return 0
    }
    DefWindowProcW(hwnd, msg, wparam, lparam)
}

fn close_display(d: *DisplayState) {
    if d.closed {
        return
    }
    d.closed = true
    let open = d.windows
    for w in open {
        close_window(w)
    }
    d.waker.hwnd = null
    var destroyed = true
    if d.hwnd != null {
        destroyed = DestroyWindow(d.hwnd) != 0
        d.hwnd = null
    }
    let window_class = class_name()
    UnregisterClassW(__slice_ptr(window_class), d.instance)
    let waker_class = display_class_name()
    UnregisterClassW(__slice_ptr(waker_class), d.instance)
    if destroyed && d.anchor != null {
        unpin(d.anchor)
        d.anchor = null
    }
    if d.ole {
        OleUninitialize()
        d.ole = false
    }
    sync.unlock_thread()
}

fn forget_window(d: *DisplayState, s: *WindowState) {
    var kept: *WindowState[] = []
    for w in d.windows {
        if w != s {
            kept.push(w)
        }
    }
    d.windows = kept
}

fn display_ready(d: *DisplayState) -> bool {
    if d.wakes > 0 {
        return true
    }
    for w in d.windows {
        if w.events.len > 0 || w.fault != none {
            return true
        }
    }
    false
}

fn wait_display(d: *DisplayState, timeout_ms: i64) ! Error {
    let started = GetTickCount64()
    pump(d)
    for !display_ready(d) {
        let remaining = remaining_ms(started, timeout_ms)
        if remaining == 0 {
            break
        }
        if wait_for_input(remaining)? {
            break
        }
        pump(d)
    }
    d.wakes = 0
}
