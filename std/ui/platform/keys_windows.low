const vk_shift: i32 = 0x10
const vk_control: i32 = 0x11
const vk_menu: i32 = 0x12
const vk_left_windows: i32 = 0x5B
const vk_right_windows: i32 = 0x5C

fn key_down(key: i32) -> bool {
    (GetKeyState(key) & 0x8000) != 0
}

fn held_modifiers() -> Modifiers {
    Modifiers {
        shift: key_down(vk_shift)
        control: key_down(vk_control)
        alt: key_down(vk_menu)
        super: key_down(vk_left_windows) || key_down(vk_right_windows)
    }
}

fn named_key(vk: i64) -> NamedKey? {
    if vk >= 0x70 && vk <= 0x7B {
        return NamedKey.Function(vk - 0x6F)
    }
    match vk {
        0x0D => NamedKey.Enter
        0x1B => NamedKey.Escape
        0x09 => NamedKey.Tab
        0x08 => NamedKey.Backspace
        0x2E => NamedKey.Delete
        0x25 => NamedKey.Left
        0x27 => NamedKey.Right
        0x26 => NamedKey.Up
        0x28 => NamedKey.Down
        0x24 => NamedKey.Home
        0x23 => NamedKey.End
        0x21 => NamedKey.PageUp
        0x22 => NamedKey.PageDown
        _ => none
    }
}

fn character_key(vk: i64, lparam: i64, shift: bool) -> Key? {
    var keyboard: []u8 = __make(256)
    if shift {
        keyboard[vk_shift] = 0x80
    }
    let units: []u16 = __make(8)
    let scan = (lparam >> 16) & 0xFF
    let n = ToUnicode(u32(vk), u32(scan), __slice_ptr(keyboard), __slice_ptr(units), 8, 4)
    if n == 0 {
        return none
    }
    var count = i64(n)
    if count < 0 {
        count = -count
    }
    Key.Character(narrow(units[..count]))
}

fn key_of(vk: i64, lparam: i64, shift: bool) -> Key? {
    let named = named_key(vk)
    match named {
        some(key) => Key.Named(key)
        none => character_key(vk, lparam, shift)
    }
}

fn key_changed(s: *WindowState, wparam: i64, lparam: i64, pressed: bool) {
    let modifiers = held_modifiers()
    let key = key_of(wparam & 0xFFFF, lparam, modifiers.shift)
    match key {
        some(k) => {
            let repeat = pressed && ((lparam >> 30) & 1) == 1
            s.events.push(Event.Key(KeyEvent { key: k, modifiers, pressed, repeat }))
            s.pending_key = -1
            if pressed {
                s.pending_key = s.events.len - 1
            }
        }
        none => {
            s.pending_key = -1
        }
    }
}

fn is_control(unit: i64) -> bool {
    unit < 0x20 || (unit >= 0x7F && unit <= 0x9F)
}

fn character_typed(s: *WindowState, wparam: i64) {
    let unit = wparam & 0xFFFF
    if unit >= 0xD800 && unit <= 0xDBFF {
        s.high_surrogate = unit
        return
    }
    var units: []u16 = [u16(unit)]
    if unit >= 0xDC00 && unit <= 0xDFFF {
        if s.high_surrogate == 0 {
            return
        }
        units = [u16(s.high_surrogate), u16(unit)]
    } else if is_control(unit) {
        s.high_surrogate = 0
        return
    }
    s.high_surrogate = 0
    append_text(s, narrow(units))
}

fn append_text(s: *WindowState, text: str) {
    let at = s.pending_key
    if at < 0 || at >= s.events.len {
        return
    }
    match s.events[at] {
        Key(e) => {
            s.events[at] = Event.Key(KeyEvent { key: e.key, text: "{e.text}{text}", modifiers: e.modifiers, pressed: e.pressed, repeat: e.repeat })
        }
        _ => {}
    }
}
