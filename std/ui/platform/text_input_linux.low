fn ensure_text_input(d: *DisplayState) {
    if d.text_input != null || d.text_manager == null || d.seat == null {
        return
    }
    d.text_input = zwp_text_input_manager_v3_get_text_input(d.ifs, d.text_manager, d.seat)
    let listener = ZwpTextInputV3Listener {
        enter: on_text_enter
        leave: on_text_leave
        preedit_string: on_preedit_string
        commit_string: on_commit_string
        done: on_text_done
    }
    zwp_text_input_v3_add_listener(d.ifs, d.text_input, listener, d.handle)
}

fn on_text_enter(data: ptr, text_input: ptr, surface: ptr) {
    let d = display_of(data)
    d.text_focus = window_at(d, surface)
    d.text_enabled = false
    apply_text_input(d)
}

fn on_text_leave(data: ptr, text_input: ptr, surface: ptr) {
    let d = display_of(data)
    d.text_enabled = false
    end_preedit(d)
    d.text_focus = none
}

fn end_preedit(d: *DisplayState) {
    d.pending_preedit = ""
    d.pending_cursor = none
    d.pending_commit = ""
    if d.preedit == "" {
        return
    }
    d.preedit = ""
    let s = d.text_focus ?? return
    s.events.push(Event.Preedit("", none))
}

fn on_preedit_string(data: ptr, text_input: ptr, text: ptr[u8], cursor_begin: i32, cursor_end: i32) {
    let d = display_of(data)
    d.pending_preedit = if text == null { "" } else { str(text) }
    d.pending_cursor = if cursor_begin < 0 || cursor_end < 0 { none } else { some(TextRange { start: i64(cursor_begin), end: i64(cursor_end) }) }
}

fn on_commit_string(data: ptr, text_input: ptr, text: ptr[u8]) {
    let d = display_of(data)
    d.pending_commit = if text == null { "" } else { str(text) }
}

fn on_text_done(data: ptr, text_input: ptr, serial: u32) {
    let d = display_of(data)
    if !d.text_enabled {
        end_preedit(d)
        return
    }
    let s = d.text_focus ?? return
    if d.pending_commit != "" {
        s.events.push(Event.Commit(d.pending_commit))
    }
    if d.pending_preedit != "" || d.preedit != "" {
        s.events.push(Event.Preedit(d.pending_preedit, d.pending_cursor))
    }
    d.preedit = d.pending_preedit
    d.pending_preedit = ""
    d.pending_cursor = none
    d.pending_commit = ""
}

fn set_window_text_input(s: *WindowState, caret: Caret?) {
    if s.caret == caret {
        return
    }
    s.caret = caret
    let d = s.display
    if is_window(d.text_focus, s) {
        apply_text_input(d)
    }
}

fn apply_text_input(d: *DisplayState) {
    if d.text_input == null {
        return
    }
    let s = d.text_focus ?? return
    match s.caret {
        some(c) => {
            if !d.text_enabled {
                zwp_text_input_v3_enable(d.text_input)
                zwp_text_input_v3_set_content_type(d.text_input, zwp_text_input_v3_content_hint_none, zwp_text_input_v3_content_purpose_normal)
                d.text_enabled = true
            }
            zwp_text_input_v3_set_cursor_rectangle(d.text_input, i32(c.x), i32(c.y), i32(c.width), i32(c.height))
            zwp_text_input_v3_commit(d.text_input)
        }
        none => disable_text_input(d)
    }
    wl_display_flush(d.display)
}

fn disable_text_input(d: *DisplayState) {
    if !d.text_enabled {
        return
    }
    zwp_text_input_v3_disable(d.text_input)
    zwp_text_input_v3_commit(d.text_input)
    d.text_enabled = false
    end_preedit(d)
}

fn release_text_input(d: *DisplayState) {
    if d.text_input != null {
        zwp_text_input_v3_destroy(d.text_input)
    }
    if d.text_manager != null {
        zwp_text_input_manager_v3_destroy(d.text_manager)
    }
    d.text_input = null
    d.text_manager = null
}
