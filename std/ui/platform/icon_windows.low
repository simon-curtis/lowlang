struct IconPicks {
    big: i64
    small: i64
}

fn icon_picks(frames: IconFrame[], dpi: u32) -> IconPicks {
    let at = if dpi == 0 { u32(96) } else { dpi }
    IconPicks {
        big: pick_icon_frame(frames, i64(GetSystemMetricsForDpi(sm_cxicon, at)))
        small: pick_icon_frame(frames, i64(GetSystemMetricsForDpi(sm_cxsmicon, at)))
    }
}

fn open_icon(s: *WindowState, frames: IconFrame[]) ! Error {
    check_icon(frames)?
    set_window_icon(s, frames)?
}

fn set_window_icon(s: *WindowState, frames: IconFrame[]) ! Error {
    if s.hwnd == null {
        return
    }
    install_icons(s, frames, GetDpiForWindow(s.hwnd))?
}

fn install_icons(s: *WindowState, frames: IconFrame[], dpi: u32) ! Error {
    if frames.len == 0 {
        swap_icons(s, null, null)
        s.icon_frames = frames
        s.big_frame = -1
        s.small_frame = -1
        return
    }
    let picks = icon_picks(frames, dpi)
    let big = make_icon(frames[picks.big], picks.big)?
    let small = make_icon(frames[picks.small], picks.small) catch {
        e => {
            DestroyIcon(big)
            fail e
        }
    }
    swap_icons(s, big, small)
    s.icon_frames = frames
    s.big_frame = picks.big
    s.small_frame = picks.small
}

fn make_icon(frame: IconFrame, index: i64) -> ptr ! Error {
    let size = i32(frame.size)
    let icon = CreateIconFromResourceEx(__slice_ptr(frame.png), u32(frame.png.len), 1, icon_resource_version, size, size, 0)
    if icon == null {
        fail BadIcon("icon frame {index}: the system could not make an icon from the PNG")
    }
    icon
}

fn swap_icons(s: *WindowState, big: ptr, small: ptr) {
    let old_big = s.big_icon
    let old_small = s.small_icon
    SendMessageW(s.hwnd, wm_seticon, icon_big, big)
    SendMessageW(s.hwnd, wm_seticon, icon_small, small)
    s.big_icon = big
    s.small_icon = small
    destroy_icon(old_big)
    destroy_icon(old_small)
}

fn destroy_icon(icon: ptr) {
    if icon != null {
        DestroyIcon(icon)
    }
}

fn refresh_icons(s: *WindowState, dpi: u32) {
    if s.icon_frames.len == 0 {
        return
    }
    let picks = icon_picks(s.icon_frames, dpi)
    if picks.big == s.big_frame && picks.small == s.small_frame {
        return
    }
    install_icons(s, s.icon_frames, dpi) or {}
}

fn release_icons(s: *WindowState) {
    destroy_icon(s.big_icon)
    destroy_icon(s.small_icon)
    s.big_icon = null
    s.small_icon = null
    s.icon_frames = []
    s.big_frame = -1
    s.small_frame = -1
}
