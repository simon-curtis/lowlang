extern "ole32" {
    fn OleInitialize(reserved: ptr) -> i32
    fn OleUninitialize()
    fn RegisterDragDrop(hwnd: ptr, target: ptr) -> i32
    fn RevokeDragDrop(hwnd: ptr) -> i32
    fn ReleaseStgMedium(medium: ptr)
    fn CoCreateInstance(clsid: ptr, outer: ptr, context: u32, iid: ptr, out: ptr) -> i32
}

extern "shell32" {
    fn DragQueryFileW(hdrop: ptr, index: u32, buffer: ptr, size: u32) -> u32
}

extern struct FormatEtc {
    format: u16 = 0
    device: ptr = null
    aspect: u32 = 0
    index: i32 = 0
    medium: u32 = 0
}

extern struct StgMedium {
    medium: u32 = 0
    global: ptr = null
    release: ptr = null
}

const cf_hdrop: u16 = 15
const dvaspect_content: u32 = 1
const tymed_hglobal: u32 = 1
const dropeffect_none: u32 = 0
const dropeffect_copy: u32 = 1
const dropeffect_move: u32 = 2
const dropeffect_link: u32 = 4
const e_nointerface: i32 = -2147467262
const e_pointer: i32 = -2147467261
const clsctx_inproc_server: u32 = 1
const iunknown_first_word: u32 = 0
const idroptarget_first_word: u32 = 0x122
const unknown_release = 2
const data_object_get_data = 3
const data_object_query_get_data = 5
const helper_drag_enter = 3
const helper_drag_leave = 4
const helper_drag_over = 5
const helper_drop = 6
const drop_table_slots = 7

fn com_method[T](object: ptr, index: i64) -> T {
    let header: ptr[ptr] = object
    let table: ptr = load(header)
    let at: ptr[T] = ptr(i64(table) + index * 8)
    load(at)
}

fn register_drops(s: *WindowState) {
    if !s.display.ole {
        return
    }
    var table: i64[] = []
    for i in 0..drop_table_slots {
        table.push(0)
    }
    let table_at: ptr = pin(table)
    fill_drop_table(table_at)
    let object: i64[] = [i64(table_at), i64(s.anchor)]
    let object_at: ptr = pin(object)
    if RegisterDragDrop(s.hwnd, object_at) < 0 {
        unpin(object_at)
        unpin(table_at)
        return
    }
    s.drop_table = table_at
    s.drop_object = object_at
    s.drop_helper = create_drop_helper()
}

fn drag_drop_helper_clsid() -> u8[] {
    [0x8A, 0x27, 0x57, 0x46, 0x1B, 0x41, 0xD2, 0x11, 0x83, 0x9A, 0x00, 0xC0, 0x4F, 0xD9, 0x18, 0xD0]
}

fn drop_target_helper_iid() -> u8[] {
    [0x8B, 0x27, 0x57, 0x46, 0x1B, 0x41, 0xD2, 0x11, 0x83, 0x9A, 0x00, 0xC0, 0x4F, 0xD9, 0x18, 0xD0]
}

fn create_drop_helper() -> ptr {
    let clsid = drag_drop_helper_clsid()
    let iid = drop_target_helper_iid()
    let made: i64[] = [0]
    let clsid_at: ptr = pin(clsid)
    let iid_at: ptr = pin(iid)
    let made_at: ptr = pin(made)
    var helper: ptr = null
    if CoCreateInstance(clsid_at, null, clsctx_inproc_server, iid_at, made_at) >= 0 {
        helper = ptr(made[0])
    }
    unpin(made_at)
    unpin(iid_at)
    unpin(clsid_at)
    helper
}

fn revoke_drops(s: *WindowState) {
    if s.drop_object != null {
        if s.hwnd != null {
            RevokeDragDrop(s.hwnd)
        }
        unpin(s.drop_object)
        unpin(s.drop_table)
        s.drop_object = null
        s.drop_table = null
    }
    if s.drop_helper != null {
        let release = com_method[extern fn(ptr) -> u32](s.drop_helper, unknown_release)
        release(s.drop_helper)
        s.drop_helper = null
    }
}

fn fill_drop_table(table: ptr) {
    let query: ptr[extern fn(ptr, ptr, ptr[ptr]) -> i32] = table_slot(table, 0)
    store(query, drop_query)
    let add_ref: ptr[extern fn(ptr) -> u32] = table_slot(table, 1)
    store(add_ref, drop_add_ref)
    let release_ref: ptr[extern fn(ptr) -> u32] = table_slot(table, 2)
    store(release_ref, drop_release)
    let enter: ptr[extern fn(ptr, ptr, u32, i64, ptr[u32]) -> i32] = table_slot(table, 3)
    store(enter, drop_enter)
    let over: ptr[extern fn(ptr, u32, i64, ptr[u32]) -> i32] = table_slot(table, 4)
    store(over, drop_over)
    let leave: ptr[extern fn(ptr) -> i32] = table_slot(table, 5)
    store(leave, drop_leave)
    let dropped: ptr[extern fn(ptr, ptr, u32, i64, ptr[u32]) -> i32] = table_slot(table, 6)
    store(dropped, drop_drop)
}

fn table_slot(base: ptr, index: i64) -> ptr {
    ptr(i64(base) + index * 8)
}

fn iid_word(first: u32, index: i64) -> u32 {
    match index {
        0 => first
        2 => 0xC0
        3 => 0x46000000
        _ => 0
    }
}

fn iid_is(iid: ptr, first: u32) -> bool {
    for i in 0..4 {
        let at: ptr[u32] = ptr(i64(iid) + i * 4)
        if load(at) != iid_word(first, i) {
            return false
        }
    }
    true
}

fn drop_query(this: ptr, iid: ptr, out: ptr[ptr]) -> i32 {
    if out == null {
        return e_pointer
    }
    if iid == null {
        store(out, null)
        return e_pointer
    }
    if iid_is(iid, iunknown_first_word) || iid_is(iid, idroptarget_first_word) {
        store(out, this)
        return 0
    }
    store(out, null)
    e_nointerface
}

fn accepted_effect(allowed: u32) -> u32 {
    if (allowed & dropeffect_copy) != 0 {
        return dropeffect_copy
    }
    if (allowed & dropeffect_move) != 0 {
        return dropeffect_move
    }
    if (allowed & dropeffect_link) != 0 {
        return dropeffect_link
    }
    dropeffect_none
}

fn answered_effect(effect: ptr[u32], wanted: bool) -> u32 {
    var answer = dropeffect_none
    if wanted && effect != null {
        answer = accepted_effect(load(effect))
    }
    if effect != null {
        store(effect, answer)
    }
    answer
}

fn helper_call_enter(s: *WindowState, data: ptr, pt: i64, effect: u32) {
    if s.drop_helper == null {
        return
    }
    let cell: i64[] = [pt]
    let at: ptr = pin(cell)
    let call = com_method[extern fn(ptr, ptr, ptr, ptr, u32) -> i32](s.drop_helper, helper_drag_enter)
    call(s.drop_helper, s.hwnd, data, at, effect)
    unpin(at)
}

fn helper_call_over(s: *WindowState, pt: i64, effect: u32) {
    if s.drop_helper == null {
        return
    }
    let cell: i64[] = [pt]
    let at: ptr = pin(cell)
    let call = com_method[extern fn(ptr, ptr, u32) -> i32](s.drop_helper, helper_drag_over)
    call(s.drop_helper, at, effect)
    unpin(at)
}

fn helper_call_leave(s: *WindowState) {
    if s.drop_helper == null {
        return
    }
    let call = com_method[extern fn(ptr) -> i32](s.drop_helper, helper_drag_leave)
    call(s.drop_helper)
}

fn helper_call_drop(s: *WindowState, data: ptr, pt: i64, effect: u32) {
    if s.drop_helper == null {
        return
    }
    let cell: i64[] = [pt]
    let at: ptr = pin(cell)
    let call = com_method[extern fn(ptr, ptr, ptr, u32) -> i32](s.drop_helper, helper_drop)
    call(s.drop_helper, data, at, effect)
    unpin(at)
}

fn drop_add_ref(this: ptr) -> u32 {
    1
}

fn drop_release(this: ptr) -> u32 {
    1
}

fn drop_state(this: ptr) -> *WindowState {
    let at: ptr[ptr] = ptr(i64(this) + 8)
    let anchor: ptr = load(at)
    let slot: ptr[*WindowState] = anchor
    load(slot)
}

fn signed_dword(value: i64) -> i64 {
    let dword = value & 0xFFFFFFFF
    if dword >= 0x80000000 {
        return dword - 0x100000000
    }
    dword
}

fn client_point(s: *WindowState, screen: i64) -> Point {
    var p = Point { x: i32(signed_dword(screen)), y: i32(signed_dword(screen >> 32)) }
    ScreenToClient(s.hwnd, mut p)
    p
}

fn drop_enter(this: ptr, data: ptr, keys: u32, pt: i64, effect: ptr[u32]) -> i32 {
    let s = drop_state(this)
    let paths = dropped_paths(data)
    s.files = paths.len > 0
    let answer = answered_effect(effect, s.files)
    helper_call_enter(s, data, pt, answer)
    if !s.files {
        return 0
    }
    let p = client_point(s, pt)
    s.events.push(FileDragEntered(logical(s, i64(p.x)), logical(s, i64(p.y)), paths))
    0
}

fn drop_over(this: ptr, keys: u32, pt: i64, effect: ptr[u32]) -> i32 {
    let s = drop_state(this)
    let answer = answered_effect(effect, s.files)
    helper_call_over(s, pt, answer)
    if !s.files {
        return 0
    }
    let p = client_point(s, pt)
    s.events.push(FileDragMoved(logical(s, i64(p.x)), logical(s, i64(p.y))))
    0
}

fn drop_leave(this: ptr) -> i32 {
    let s = drop_state(this)
    helper_call_leave(s)
    if s.files {
        s.files = false
        s.events.push(FileDragExited)
    }
    0
}

fn drop_drop(this: ptr, data: ptr, keys: u32, pt: i64, effect: ptr[u32]) -> i32 {
    let s = drop_state(this)
    let had_files = s.files
    s.files = false
    let answer = answered_effect(effect, had_files)
    helper_call_drop(s, data, pt, answer)
    if !had_files {
        return 0
    }
    let p = client_point(s, pt)
    s.events.push(FileDropped(logical(s, i64(p.x)), logical(s, i64(p.y))))
    0
}

fn dropped_paths(data: ptr) -> str[] {
    var paths: str[] = []
    if data == null {
        return paths
    }
    let formats = [FormatEtc { format: cf_hdrop, aspect: dvaspect_content, index: -1, medium: tymed_hglobal }]
    let format_at: ptr = pin(formats)
    let query = com_method[extern fn(ptr, ptr) -> i32](data, data_object_query_get_data)
    if query(data, format_at) != 0 {
        unpin(format_at)
        return paths
    }
    let media = [StgMedium {}]
    let medium_at: ptr = pin(media)
    let get = com_method[extern fn(ptr, ptr, ptr) -> i32](data, data_object_get_data)
    if get(data, format_at, medium_at) == 0 {
        paths = hdrop_paths(media[0].global)
        ReleaseStgMedium(medium_at)
    }
    unpin(medium_at)
    unpin(format_at)
    paths
}

fn hdrop_paths(hdrop: ptr) -> str[] {
    var paths: str[] = []
    if hdrop == null {
        return paths
    }
    let count = i64(DragQueryFileW(hdrop, 0xFFFFFFFF, null, 0))
    for i in 0..count {
        let length = i64(DragQueryFileW(hdrop, u32(i), null, 0))
        var buffer: u16[] = []
        for k in 0..length + 1 {
            buffer.push(0)
        }
        let at: ptr = pin(buffer)
        let got = i64(DragQueryFileW(hdrop, u32(i), at, u32(length + 1)))
        unpin(at)
        paths.push(narrow(buffer[0..got]))
    }
    paths
}
