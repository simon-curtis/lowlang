const cf_unicode_text: u32 = 13
const gmem_moveable: u32 = 2
const open_attempts: i64 = 20
const open_retry_ms: i64 = 5

fn open_clipboard(s: *WindowState) ! Error {
    if s.hwnd == null {
        fail Disconnected
    }
    var attempt = 0
    for {
        if OpenClipboard(s.hwnd) != 0 {
            return
        }
        let code = GetLastError()
        attempt = attempt + 1
        if attempt >= open_attempts {
            fail Failed("OpenClipboard", i64(code))
        }
        sleep(open_retry_ms)
    }
}

fn write_window_clipboard(s: *WindowState, text: str) ! Error {
    let units = wide(text)
    let memory = GlobalAlloc(gmem_moveable, i64(units.len))
    if memory == null {
        fail call_failed("GlobalAlloc")
    }
    let target = GlobalLock(memory)
    if target == null {
        let code = GetLastError()
        GlobalFree(memory)
        fail Failed("GlobalLock", i64(code))
    }
    RtlMoveMemory(target, __slice_ptr(units), i64(units.len))
    GlobalUnlock(memory)
    open_clipboard(s) catch {
        e => {
            GlobalFree(memory)
            fail e
        }
    }
    if EmptyClipboard() == 0 {
        let code = GetLastError()
        CloseClipboard()
        GlobalFree(memory)
        fail Failed("EmptyClipboard", i64(code))
    }
    let placed = SetClipboardData(cf_unicode_text, memory)
    let code = GetLastError()
    CloseClipboard()
    if placed == null {
        GlobalFree(memory)
        fail Failed("SetClipboardData", i64(code))
    }
}

fn read_window_clipboard(s: *WindowState) -> str? ! Error {
    open_clipboard(s)?
    let memory = GetClipboardData(cf_unicode_text)
    if memory == null {
        CloseClipboard()
        return none
    }
    let size = GlobalSize(memory)
    let source = GlobalLock(memory)
    if source == null {
        let code = GetLastError()
        CloseClipboard()
        fail Failed("GlobalLock", i64(code))
    }
    let units: u16[] = __make(size / 2)
    RtlMoveMemory(__slice_ptr(units), source, 2 * units.len)
    GlobalUnlock(memory)
    CloseClipboard()
    narrow(units[..terminated(units)])
}

fn terminated(units: u16[]) -> i64 {
    var n = 0
    for n < units.len && units[n] != 0 {
        n = n + 1
    }
    n
}
