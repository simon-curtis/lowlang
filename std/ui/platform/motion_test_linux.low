import std/dbus
import std/testing

fn reply_of(body: dbus.Value[]) -> dbus.Message {
    dbus.Message { kind: dbus.MessageType.MethodReturn, body }
}

fn nested(v: dbus.Value) -> dbus.Value {
    dbus.variant(dbus.variant(v))
}

fn test_the_portal_nests_the_setting_in_two_variants(t: *testing.T) {
    let on = animations_in(reply_of([nested(dbus.Value.Boolean(true))])) or panic("on")
    let off = animations_in(reply_of([nested(dbus.Value.Boolean(false))])) or panic("off")
    testing.is_true(t, on)
    testing.is_false(t, off)
}

fn test_one_variant_is_enough(t: *testing.T) {
    let on = animations_in(reply_of([dbus.variant(dbus.Value.Boolean(true))])) or panic("on")
    testing.is_true(t, on)
}

fn rejected(reply: dbus.Message) -> bool {
    let read = animations_in(reply) catch {
        e => return true
    }
    false
}

fn test_a_reply_that_is_not_a_boolean_fails(t: *testing.T) {
    testing.is_true(t, rejected(reply_of([nested(dbus.Value.String("yes"))])))
}

fn test_a_reply_with_no_value_fails(t: *testing.T) {
    testing.is_true(t, rejected(reply_of([])))
}
