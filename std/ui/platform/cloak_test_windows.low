import std/testing

fn test_a_colorref_holds_blue_in_the_high_byte_and_red_in_the_low(t: *testing.T) {
    t.equal(colorref_of(0x112233), 0x332211)
}

fn test_a_colorref_of_one_channel_moves_only_that_byte(t: *testing.T) {
    t.equal(colorref_of(0xff0000), 0x0000ff)
    t.equal(colorref_of(0x00ff00), 0x00ff00)
    t.equal(colorref_of(0x0000ff), 0xff0000)
}

fn test_a_colorref_of_a_grey_is_that_grey(t: *testing.T) {
    t.equal(colorref_of(0x444444), 0x444444)
}

fn test_a_colorref_drops_bits_above_the_blue_byte(t: *testing.T) {
    t.equal(colorref_of(0xff112233), 0x332211)
}
