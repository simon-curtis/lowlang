fn owner_handle(d: *DisplayState, o: Options) -> ptr ! Error {
    var hwnd: ptr = null
    match o.owner {
        some(owner) => {
            let s = owner.state
            if s.display != d {
                fail Unsupported("the owner window belongs to another display")
            }
            if s.released || s.hwnd == null {
                fail Unsupported("the owner window has closed")
            }
            hwnd = s.hwnd
        }
        none => {}
    }
    hwnd
}

fn ex_style_of(o: Options, owned: bool) -> u32 {
    if owned {
        if o.taskbar {
            return ws_ex_appwindow
        }
        return 0
    }
    if o.taskbar {
        return 0
    }
    ws_ex_toolwindow
}

fn reference_window(d: *DisplayState, placement: Placement, owner: ptr) -> ptr {
    match placement {
        System => null
        CentreOnOwner => {
            if owner != null {
                return owner
            }
            main_window_of(d)
        }
        CentreOnScreen => main_window_of(d)
    }
}

fn main_window_of(d: *DisplayState) -> ptr {
    for w in d.windows {
        if w.hwnd != null {
            return w.hwnd
        }
    }
    null
}

fn monitor_of(reference: ptr) -> ptr {
    if reference != null {
        return MonitorFromWindow(reference, monitor_defaulttonearest)
    }
    MonitorFromPoint(0, monitor_defaulttoprimary)
}

fn work_area_of(reference: ptr) -> MonitorInfo? {
    let monitor = monitor_of(reference)
    var info = MonitorInfo {}
    if monitor == null || GetMonitorInfoW(monitor, mut info) == 0 {
        return none
    }
    info
}

fn monitor_dpi(reference: ptr) -> u32 {
    let monitor = monitor_of(reference)
    if monitor == null {
        return 0
    }
    var dpis: []u32 = [0, 0]
    let x: ptr[u32] = pin(dpis)
    let y: ptr[u32] = ptr(i64(x) + 4)
    var dpi: u32 = 0
    if GetDpiForMonitor(monitor, mdt_effective_dpi, x, y) >= 0 {
        dpi = dpis[0]
    }
    unpin(x)
    dpi
}

fn content_size(o: Options) -> Point {
    Point { x: i32(max_of(o.width, o.min_width)), y: i32(max_of(o.height, o.min_height)) }
}

fn planned_rect(s: *WindowState, o: Options, reference: ptr) -> Rect? {
    if o.placement == Placement.System {
        return none
    }
    let dpi = monitor_dpi(reference)
    if dpi == 0 {
        return none
    }
    let content = content_size(o)
    let outer = outer_rect(s, i64(content.x), i64(content.y), dpi) catch {
        e => return none
    }
    let width = outer.right - outer.left
    let height = outer.bottom - outer.top
    let at = centred_at(o.placement, reference, i64(width), i64(height)) ?? return none
    Rect { left: at.x, top: at.y, right: at.x + width, bottom: at.y + height }
}

fn centred_at(placement: Placement, reference: ptr, width: i64, height: i64) -> Point? {
    if placement == Placement.System {
        return none
    }
    let work = work_area_of(reference) ?? return none
    var around = Rect { left: work.work_left, top: work.work_top, right: work.work_right, bottom: work.work_bottom }
    if placement == Placement.CentreOnOwner && reference != null && IsIconic(reference) == 0 {
        if GetWindowRect(reference, mut around) == 0 {
            return none
        }
    }
    let x = clamp_to(i64(around.left + around.right) / 2 - width / 2, width, i64(work.work_left), i64(work.work_right))
    let y = clamp_to(i64(around.top + around.bottom) / 2 - height / 2, height, i64(work.work_top), i64(work.work_bottom))
    Point { x: i32(x), y: i32(y) }
}

fn clamp_to(at: i64, size: i64, low: i64, high: i64) -> i64 {
    var out = at
    if out + size > high {
        out = high - size
    }
    if out < low {
        out = low
    }
    out
}

fn max_of(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    b
}

fn minimum_track(s: *WindowState, hwnd: ptr, wparam: i64, lparam: i64) -> i64 {
    if s.min_width <= 0 && s.min_height <= 0 {
        return DefWindowProcW(hwnd, wm_getminmaxinfo, wparam, lparam)
    }
    let dpi = u32(floor(s.scale * 96.0 + 0.5))
    let outer = outer_rect(s, s.min_width, s.min_height, dpi) catch {
        e => return DefWindowProcW(hwnd, wm_getminmaxinfo, wparam, lparam)
    }
    let at: ptr[MinMaxInfo] = ptr(lparam)
    var info = load(at)
    if s.min_width > 0 {
        info.min_track_x = outer.right - outer.left
    }
    if s.min_height > 0 {
        info.min_track_y = outer.bottom - outer.top
    }
    store(at, info)
    0
}

fn set_window_title(s: *WindowState, title: str) {
    if s.hwnd == null {
        return
    }
    let text = wide(title)
    if SetWindowTextW(s.hwnd, __slice_ptr(text)) == 0 {
        record_fault(s, "SetWindowTextW")
    }
}
