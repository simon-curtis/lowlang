import std/ui/platform

fn wake_after(k: platform.Waker, ms: i64) {
    sleep(ms)
    platform.wake(k)
}

fn serve() -> bool ! platform.Error {
    using display = platform.open_display()?
    using editor = platform.open_in(display, platform.Options { title: "Editor", hidden: true })?
    using preview = platform.open_in(display, platform.Options { title: "Preview", hidden: true })?
    spawn wake_after(platform.waker_of(display), 50)
    platform.wait(display, 5000)?
    platform.next(editor, 0)?
    platform.next(preview, 0)?
    true
}

/// Opens two windows in one display and waits on both at once, until another green thread wakes the display. Where no window can be opened the example prints the same line.
fn main() {
    let served = serve() catch {
        e => true
    }
    print("one wait served both windows {served}")
}
