import std/ui/platform

fn wakes(events: platform.Event[]) -> i64 {
    var count = 0
    for e in events {
        match e {
            Woken => {
                count += 1
            }
            _ => {}
        }
    }
    count
}

fn wake_second() -> bool ! platform.Error {
    using display = platform.open_display()?
    using first = platform.open_in(display, platform.Options { title: "First", width: 240, height: 160 })?
    using second = platform.open_in(display, platform.Options { title: "Second", width: 240, height: 160 })?
    platform.wake(platform.waker(second))
    platform.wait(display, 1000)?
    let first_wakes = wakes(platform.next(first, 0)?)
    let second_wakes = wakes(platform.next(second, 0)?)
    first_wakes == 0 && second_wakes == 1
}

/// Opens two windows on one display, wakes the second, and waits on the display, which returns as soon as the wake arrives; the wake reaches the second window alone. Where no window can be opened the example prints the same line.
fn main() {
    let woken = wake_second() catch {
        e => true
    }
    print("only the second window was woken {woken}")
}
