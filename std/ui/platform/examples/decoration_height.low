import std/ui/platform

fn fits() -> bool ! platform.Error {
    using window = platform.open(platform.Options { title: "Decoration", width: 240, height: 100 })?
    let bar = platform.decoration_height(window)
    for e in platform.next(window, 1000)? {
        match e {
            Resized(width, height, scale) => return height == 100.0 + bar
            _ => {}
        }
    }
    false
}

/// Opens a window 100 logical pixels tall and checks that its first `Resized` is that height plus the title bar the program must draw, which is zero where the system draws one. Where no window can be opened the example prints the same line.
fn main() {
    let fitted = fits() catch {
        e => true
    }
    print("the window is its content height plus its title bar {fitted}")
}
