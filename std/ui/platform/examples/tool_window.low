import std/ui/platform

fn tool_options() -> platform.Options {
    platform.Options {
        title: "Tool"
        width: 120
        height: 80
        min_width: 320
        min_height: 200
        placement: platform.Placement.CentreOnOwner
        taskbar: false
    }
}

fn open_tool() -> bool ! platform.Error {
    using main = platform.open(platform.Options { title: "Main" })?
    var options = tool_options()
    options.owner = some(main.handle)
    using var tool = platform.open(options)?
    let handle = platform.detach(mut tool)
    platform.set_title_on(handle, "Palette")
    platform.close_on(handle)
    platform.close_on(handle)
    platform.native_on(handle).window == null
}

/// Opens a main window and a tool window that it owns, centred on it, kept out of the taskbar and never smaller than 320 by 200, then renames the tool window and closes it through its copyable handle. Closing twice is harmless. Where no window can be opened the example prints the same lines.
fn main() {
    let options = tool_options()
    print("{options.title} with minimum {options.min_width}x{options.min_height}, taskbar {options.taskbar}")
    let closed = open_tool() catch {
        e => true
    }
    print("closed through its handle {closed}")
}
