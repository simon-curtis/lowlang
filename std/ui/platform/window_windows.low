import std/sync

struct WakerState {
    hwnd: ptr
}

struct WindowState {
    instance: ptr
    waker: *WakerState
    hwnd: ptr = null
    anchor: ptr = null
    events: []Event = []
    fault: Error? = none
    width: i64 = 0
    height: i64 = 0
    scale: i64 = 1
    reported_scale: i64 = 0
    tracking: bool = false
    buttons: i64 = 0
    pending_key: i64 = -1
    high_surrogate: i64 = 0
}

fn open_window(o: Options) -> *WindowState ! Error {
    sync.lock_thread()
    let s = new(WindowState { instance: GetModuleHandleW(null), waker: new(WakerState { hwnd: null }) })
    build_window(s, o) catch {
        e => {
            close_window(s)
            fail e
        }
    }
    s
}

fn build_window(s: *WindowState, o: Options) ! Error {
    if GetProcessWindowStation() == null {
        fail NoDisplay("no window station")
    }
    SetProcessDpiAwarenessContext(dpi_awareness_per_monitor_v2)
    register_class(s)?
    let slot: []*WindowState = [s]
    s.anchor = pin(slot)
    create_window(s, o)?
    fit_window(s, o)?
    truncate(mut s.events, 0)
    s.width = 0
    s.height = 0
    s.reported_scale = 0
    report_size(s, s.hwnd)
    ShowWindow(s.hwnd, sw_show)
    pending_fault(s)?
}

fn register_class(s: *WindowState) ! Error {
    let name = class_name()
    var class = WndClassEx {
        procedure: window_proc
        instance: s.instance
        cursor: LoadCursorW(null, idc_arrow)
        class_name: __slice_ptr(name)
    }
    if RegisterClassExW(mut class) == 0 {
        let code = GetLastError()
        if code != error_class_exists {
            fail creation_error("RegisterClassExW", code)
        }
    }
}

fn create_window(s: *WindowState, o: Options) ! Error {
    let name = class_name()
    let title = wide(o.title)
    let use = cw_usedefault
    let hwnd = CreateWindowExW(0, __slice_ptr(name), __slice_ptr(title), ws_overlappedwindow, use, use, use, use, null, null, s.instance, s.anchor)
    if hwnd == null {
        fail creation_error("CreateWindowExW", GetLastError())
    }
    s.hwnd = hwnd
    s.waker.hwnd = hwnd
}

fn fit_window(s: *WindowState, o: Options) ! Error {
    let dpi = GetDpiForWindow(s.hwnd)
    if dpi == 0 {
        fail call_failed("GetDpiForWindow")
    }
    s.scale = scale_of(i64(dpi))
    var outer = Rect { right: i32(o.width * s.scale), bottom: i32(o.height * s.scale) }
    if AdjustWindowRectExForDpi(mut outer, ws_overlappedwindow, 0, 0, dpi) == 0 {
        fail call_failed("AdjustWindowRectExForDpi")
    }
    let flags = swp_nomove | swp_nozorder | swp_noactivate
    if SetWindowPos(s.hwnd, null, 0, 0, outer.right - outer.left, outer.bottom - outer.top, flags) == 0 {
        fail call_failed("SetWindowPos")
    }
}

fn scale_of(dpi: i64) -> i64 {
    let scale = (dpi + 48) / 96
    if scale < 1 {
        return 1
    }
    scale
}

fn next_events(s: *WindowState, timeout_ms: i64) -> []Event ! Error {
    let started = GetTickCount64()
    pump(s)?
    for s.events.len == 0 {
        let remaining = remaining_ms(started, timeout_ms)
        if remaining == 0 {
            break
        }
        if wait_for_input(remaining)? {
            break
        }
        pump(s)?
    }
    let out = s.events
    s.events = []
    out
}

fn remaining_ms(started: i64, timeout_ms: i64) -> i64 {
    if timeout_ms < 0 {
        return -1
    }
    let left = timeout_ms - (GetTickCount64() - started)
    if left < 0 {
        return 0
    }
    left
}

fn wait_for_input(remaining: i64) -> bool ! Error {
    var timeout = infinite
    if remaining >= 0 {
        timeout = u32(min_of(remaining, 0xFFFFFFFE))
    }
    let result = MsgWaitForMultipleObjectsEx(0, null, timeout, qs_allinput, mwmo_inputavailable)
    if result == wait_failed {
        fail call_failed("MsgWaitForMultipleObjectsEx")
    }
    result == wait_timeout
}

fn min_of(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    b
}

fn pump(s: *WindowState) ! Error {
    var msg = Msg {}
    for PeekMessageW(mut msg, null, 0, 0, pm_remove) != 0 {
        TranslateMessage(mut msg)
        DispatchMessageW(mut msg)
    }
    s.pending_key = -1
    pending_fault(s)?
}

fn pending_fault(s: *WindowState) ! Error {
    match s.fault {
        some(e) => {
            s.fault = none
            fail e
        }
        none => {}
    }
}

fn record_fault(s: *WindowState, call: str) {
    if s.fault == none {
        s.fault = call_failed(call)
    }
}

fn window_waker(s: *WindowState) -> *WakerState {
    s.waker
}

fn wake_window(k: *WakerState) {
    if k.hwnd != null {
        PostMessageW(k.hwnd, wm_app, 0, 0)
    }
}

fn window_native(s: *WindowState) -> Native {
    Native { display: s.instance, window: s.hwnd }
}

fn close_window(s: *WindowState) {
    s.waker.hwnd = null
    var destroyed = true
    if s.hwnd != null {
        destroyed = DestroyWindow(s.hwnd) != 0
        s.hwnd = null
    }
    let name = class_name()
    UnregisterClassW(__slice_ptr(name), s.instance)
    if destroyed && s.anchor != null {
        unpin(s.anchor)
        s.anchor = null
    }
    sync.unlock_thread()
}
