struct WakerState {
    hwnd: ptr
}

struct WindowState {
    instance: ptr
    display: *DisplayState
    owns_display: bool = false
    waker: *WakerState
    hwnd: ptr = null
    anchor: ptr = null
    events: Event[] = []
    fault: Error? = none
    width: f32 = 0.0
    height: f32 = 0.0
    scale: f32 = 1.0
    reported_scale: f32 = 0.0
    tracking: bool = false
    buttons: i64 = 0
    pending_key: i64 = -1
    high_surrogate: i64 = 0
    cursor: Cursor = Cursor.Arrow
    text_input: bool = false
    caret: Caret = Caret {}
    preedit: str = ""
    bare: bool = false
    maximized: bool = false
    nc_pressed: i64 = 0
    area_hit: i64 = 0
    win11: bool = false
    hit_test: fn(f32, f32) -> i64
    clicks: *ClickCount = new(ClickCount {})
    drop_table: ptr = null
    drop_object: ptr = null
    drop_helper: ptr = null
    files: bool = false
    cloaked: bool = false
    withheld: bool = false
    ex_style: u32 = 0
    min_width: i64 = 0
    min_height: i64 = 0
    show_command: i32 = sw_show
    released: bool = false
    icon_frames: IconFrame[] = []
    big_icon: ptr = null
    small_icon: ptr = null
    big_frame: i64 = -1
    small_frame: i64 = -1
}

fn open_window(o: Options) -> *WindowState ! Error {
    let d = connect_display()?
    let s = open_window_in(d, o) catch {
        e => {
            close_display(d)
            fail e
        }
    }
    s.owns_display = true
    s
}

fn open_window_in(d: *DisplayState, o: Options) -> *WindowState ! Error {
    let owner = owner_handle(d, o)?
    let reference = reference_window(d, o.placement, owner)
    let s = new(WindowState {
        instance: d.instance
        display: d
        waker: new(WakerState { hwnd: null })
        bare: o.titlebar.appears_transparent
        win11: windows_build() >= win11_build
        hit_test: no_control
        ex_style: ex_style_of(o, owner != null)
        min_width: o.min_width
        min_height: o.min_height
        show_command: show_command_of(o)
    })
    d.windows.push(s)
    build_window(s, o, owner, reference) catch {
        e => {
            close_window(s)
            fail e
        }
    }
    s
}

fn build_window(s: *WindowState, o: Options, owner: ptr, reference: ptr) ! Error {
    let slot: *WindowState[] = [s]
    s.anchor = pin(slot)
    create_window(s, o, owner, reference)?
    register_drops(s)
    fit_window(s, o, reference)?
    s.events.truncate(0)
    s.width = 0.0
    s.height = 0.0
    s.reported_scale = 0.0
    report_size(s, s.hwnd)
    present_window(s, o.hidden)
    pending_fault(s)?
}

fn create_window(s: *WindowState, o: Options, owner: ptr, reference: ptr) ! Error {
    let name = class_name()
    register_class(s.instance, name, window_proc)?
    let title = wide(o.title)
    var x = cw_usedefault
    var y = cw_usedefault
    var width = cw_usedefault
    var height = cw_usedefault
    match planned_rect(s, o, reference) {
        some(r) => {
            x = r.left
            y = r.top
            width = r.right - r.left
            height = r.bottom - r.top
        }
        none => {}
    }
    let hwnd = CreateWindowExW(s.ex_style, __slice_ptr(name), __slice_ptr(title), ws_overlappedwindow, x, y, width, height, owner, null, s.instance, s.anchor)
    if hwnd == null {
        fail creation_error("CreateWindowExW", GetLastError())
    }
    s.hwnd = hwnd
    s.waker.hwnd = hwnd
    match o.border {
        some(rgb) => {
            set_border_color(hwnd, rgb)
        }
        none => {}
    }
    match o.icon {
        some(frames) => {
            open_icon(s, frames) or {}
        }
        none => {}
    }
    ImmAssociateContextEx(hwnd, null, 0)
}

fn fit_window(s: *WindowState, o: Options, reference: ptr) ! Error {
    let dpi = GetDpiForWindow(s.hwnd)
    if dpi == 0 {
        fail call_failed("GetDpiForWindow")
    }
    s.scale = scale_of(i64(dpi))
    let content = content_size(o)
    let outer = outer_rect(s, i64(content.x), i64(content.y), dpi)?
    let width = outer.right - outer.left
    let height = outer.bottom - outer.top
    var flags = swp_nozorder | swp_noactivate
    if s.bare {
        flags = flags | swp_framechanged
    }
    var left: i32 = 0
    var top: i32 = 0
    match centred_at(o.placement, reference, i64(width), i64(height)) {
        some(at) => {
            left = at.x
            top = at.y
        }
        none => {
            flags = flags | swp_nomove
        }
    }
    if SetWindowPos(s.hwnd, null, left, top, width, height, flags) == 0 {
        fail call_failed("SetWindowPos")
    }
}

fn outer_rect(s: *WindowState, width: i64, height: i64, dpi: u32) -> Rect ! Error {
    let scale = scale_of(i64(dpi))
    var outer = Rect { right: i32(floor(f32(width) * scale + 0.5)), bottom: i32(floor(f32(height) * scale + 0.5)) }
    if s.bare {
        let insets = frame_insets_at(s.win11, dpi, false)
        outer.right = outer.right + insets.left + insets.right
        outer.bottom = outer.bottom + insets.top + insets.bottom
    } else if AdjustWindowRectExForDpi(mut outer, ws_overlappedwindow, 0, s.ex_style, dpi) == 0 {
        fail call_failed("AdjustWindowRectExForDpi")
    }
    outer
}


fn scale_of(dpi: i64) -> f32 {
    if dpi <= 0 {
        return 1.0
    }
    f32(dpi) / 96.0
}

fn next_events(s: *WindowState, timeout_ms: i64) -> Event[] ! Error {
    let started = GetTickCount64()
    pump_for(s)?
    for s.events.len == 0 {
        if s.hwnd == null {
            fail Unsupported("the window has closed")
        }
        let remaining = remaining_ms(started, timeout_ms)
        if remaining == 0 {
            break
        }
        if wait_for_input(remaining)? {
            break
        }
        pump_for(s)?
    }
    let out = s.events
    s.events = []
    out
}

fn remaining_ms(started: i64, timeout_ms: i64) -> i64 {
    if timeout_ms < 0 {
        return -1
    }
    let left = timeout_ms - (GetTickCount64() - started)
    if left < 0 {
        return 0
    }
    left
}

fn wait_for_input(remaining: i64) -> bool ! Error {
    var timeout = infinite
    if remaining >= 0 {
        timeout = u32(min_of(remaining, 0xFFFFFFFE))
    }
    let result = MsgWaitForMultipleObjectsEx(0, null, timeout, qs_allinput, mwmo_inputavailable)
    if result == wait_failed {
        fail call_failed("MsgWaitForMultipleObjectsEx")
    }
    result == wait_timeout
}

fn min_of(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    b
}

fn pump(d: *DisplayState) {
    var msg = Msg {}
    for PeekMessageW(mut msg, null, 0, 0, pm_remove) != 0 {
        TranslateMessage(mut msg)
        DispatchMessageW(mut msg)
    }
    for w in d.windows {
        w.pending_key = -1
    }
}

fn pump_for(s: *WindowState) ! Error {
    pump(s.display)
    pending_fault(s)?
}

fn pending_fault(s: *WindowState) ! Error {
    match s.fault {
        some(e) => {
            s.fault = none
            fail e
        }
        none => {}
    }
}

fn record_fault(s: *WindowState, call: str) {
    if s.fault == none {
        s.fault = call_failed(call)
    }
}

fn window_waker(s: *WindowState) -> *WakerState {
    s.waker
}

fn wake_window(k: *WakerState) {
    if k.hwnd != null {
        PostMessageW(k.hwnd, wm_app, 0, 0)
    }
}

fn window_native(s: *WindowState) -> Native {
    Native { display: s.instance, window: s.hwnd }
}

fn window_closed(s: *WindowState) -> bool {
    s.released
}

fn window_destroyed(s: *WindowState) {
    revoke_drops(s)
    if !s.released {
        s.events.push(CloseRequested)
    }
}

fn close_window(s: *WindowState) {
    if s.released {
        return
    }
    s.released = true
    s.waker.hwnd = null
    revoke_drops(s)
    var destroyed = true
    if s.hwnd != null {
        destroyed = DestroyWindow(s.hwnd) != 0
        s.hwnd = null
    }
    if destroyed {
        release_icons(s)
    }
    if destroyed && s.anchor != null {
        unpin(s.anchor)
        s.anchor = null
    }
    forget_window(s.display, s)
    if s.owns_display {
        close_display(s.display)
    }
}

fn no_control(x: f32, y: f32) -> i64 {
    0
}
