extern "dwmapi" {
    fn DwmSetWindowAttribute(hwnd: ptr, attribute: u32, mut value: i32, size: u32) -> i32
}

const dwmwa_cloak: u32 = 13
const dwm_attribute_bytes: u32 = 4

fn set_cloak(hwnd: ptr, cloaked: bool) -> i32 {
    var value: i32 = if cloaked { 1 } else { 0 }
    DwmSetWindowAttribute(hwnd, dwmwa_cloak, mut value, dwm_attribute_bytes)
}

fn present_window(s: *WindowState, hidden: bool) {
    if !hidden {
        ShowWindow(s.hwnd, sw_show)
        return
    }
    if set_cloak(s.hwnd, true) >= 0 {
        s.cloaked = true
        ShowWindow(s.hwnd, sw_show)
    } else {
        s.withheld = true
    }
}

fn show_window(s: *WindowState) {
    if s.hwnd == null {
        return
    }
    if s.cloaked {
        let result = set_cloak(s.hwnd, false)
        if result >= 0 {
            s.cloaked = false
        } else if s.fault == none {
            s.fault = Failed("DwmSetWindowAttribute", i64(result))
        }
    }
    if s.withheld {
        s.withheld = false
        ShowWindow(s.hwnd, sw_show)
    }
}
