extern struct WlArray {
    size: i64
    alloc: i64
    data: ptr
}

struct Handle {
    state: *WindowState
}

struct WindowState {
    display: *DisplayState
    owns_display: bool = false
    waker: *WakerState
    handle: ptr = null
    surface: ptr = null
    xdg_surface: ptr = null
    toplevel: ptr = null
    caret: Caret? = none
    cursor: Cursor = Cursor.Arrow
    events: Event[] = []
    requested_width: i64 = 0
    requested_height: i64 = 0
    pending_width: i64 = 0
    pending_height: i64 = 0
    width: i64 = 0
    height: i64 = 0
    scale_120: i64 = 120
    viewport: ptr = null
    fractional: ptr = null
    decoration: ptr = null
    server_side: bool = false
    own_titlebar: bool = false
    bar: i64 = 0
    edge: u32 = 0
    armed_area: i64 = 0
    hit_test: fn(f32, f32) -> i64 = no_control
    configured: bool = false
    maximized: bool = false
    pending_maximized: bool = false
    closed: bool = false
}

const configure_timeout_ms = 5000

fn open_window(o: Options) -> *WindowState ! Error {
    let d = connect_display()?
    let s = open_window_in(d, o) catch {
        e => {
            close_display(d)
            fail e
        }
    }
    s.owns_display = true
    s
}

fn open_window_in(d: *DisplayState, o: Options) -> *WindowState ! Error {
    let s = new(WindowState {
        display: d
        waker: new(WakerState { signal: chan[bool](1), bell: d.bell })
        requested_width: o.width
        requested_height: o.height
        width: o.width
        height: o.height
    })
    s.handle = pin(new(Handle { state: s }))
    d.windows.push(s)
    create_toplevel(s, o)
    await_configure(s) catch {
        e => {
            close_window(s)
            fail e
        }
    }
    s
}

fn window_of(data: ptr) -> *WindowState {
    let at: ptr[Handle] = data
    load(at).state
}

fn show_window(s: *WindowState) {}

fn set_window_title(s: *WindowState, title: str) {
    xdg_toplevel_set_title(s.toplevel, cstr(title))
    wl_display_flush(s.display.display)
}

fn set_window_icon(s: *WindowState, frames: IconFrame[]) ! Error {}

fn create_toplevel(s: *WindowState, o: Options) {
    let d = s.display
    s.surface = wl_compositor_create_surface(d.ifs, d.compositor)
    let _ = wl_surface_add_listener(d.ifs, s.surface, WlSurfaceListener { preferred_buffer_scale: on_scale }, s.handle)
    s.xdg_surface = xdg_wm_base_get_xdg_surface(d.ifs, d.wm_base, s.surface)
    let _ = xdg_surface_add_listener(d.ifs, s.xdg_surface, XdgSurfaceListener { configure: on_surface_configure }, s.handle)
    s.toplevel = xdg_surface_get_toplevel(d.ifs, s.xdg_surface)
    let _ = xdg_toplevel_add_listener(d.ifs, s.toplevel, XdgToplevelListener { configure: on_toplevel_configure, close_: on_toplevel_close }, s.handle)
    xdg_toplevel_set_title(s.toplevel, cstr(o.title))
    attach_scale(s)
    attach_decoration(s, o)
    wl_surface_commit(s.surface)
}

fn await_configure(s: *WindowState) ! Error {
    let d = s.display
    let deadline = now_ms() + configure_timeout_ms
    for {
        dispatch(d)?
        if s.configured {
            return
        }
        let remaining = deadline - now_ms()
        if remaining <= 0 {
            fail Unsupported("the compositor did not configure the window")
        }
        wait_input(d, remaining)?
    }
}

fn next_events(s: *WindowState, timeout_ms: i64) -> Event[] ! Error {
    let d = s.display
    let deadline = now_ms() + timeout_ms
    for {
        service(d)?
        if s.events.len > 0 {
            return take_events(s)
        }
        let limit = if timeout_ms < 0 { idle_wait_ms } else { deadline - now_ms() }
        let woke = wait_input(d, repeat_wait(d, limit))?
        if woke == Woke.Idle && timeout_ms >= 0 && now_ms() >= deadline {
            return take_events(s)
        }
    }
}

fn take_events(s: *WindowState) -> Event[] {
    let out = s.events
    s.events = []
    out
}

fn window_waker(s: *WindowState) -> *WakerState {
    s.waker
}

fn window_native(s: *WindowState) -> Native {
    Native { display: s.display.display, window: s.surface }
}

fn window_closed(s: *WindowState) -> bool {
    s.closed
}

fn close_window(s: *WindowState) {
    if s.closed {
        return
    }
    s.closed = true
    let d = s.display
    release_focus(d, s)
    detach_decoration(s)
    detach_scale(s)
    if s.toplevel != null {
        xdg_toplevel_destroy(s.toplevel)
    }
    if s.xdg_surface != null {
        xdg_surface_destroy(s.xdg_surface)
    }
    if s.surface != null {
        wl_surface_destroy(s.surface)
    }
    forget_window(d, s)
    unpin(s.handle)
    s.toplevel = null
    s.xdg_surface = null
    s.surface = null
    s.handle = null
    if s.owns_display {
        close_display(d)
        return
    }
    if !d.closed {
        wl_display_flush(d.display)
    }
}

fn release_focus(d: *DisplayState, s: *WindowState) {
    if is_window(d.pointer_focus, s) {
        d.pointer_focus = none
    }
    if is_window(d.keyboard_focus, s) {
        d.keyboard_focus = none
        d.repeat.active = false
    }
    if is_window(d.text_focus, s) {
        disable_text_input(d)
        d.text_focus = none
    }
}

fn window_maximized(s: *WindowState) -> bool {
    s.maximized
}

fn minimize_window(s: *WindowState) {
    xdg_toplevel_set_minimized(s.toplevel)
    wl_display_flush(s.display.display)
}

fn raise_window(s: *WindowState) {}

fn zoom_window(s: *WindowState) {
    if s.maximized {
        xdg_toplevel_unset_maximized(s.toplevel)
    } else {
        xdg_toplevel_set_maximized(s.toplevel)
    }
    wl_display_flush(s.display.display)
}

fn set_window_cursor(s: *WindowState, c: Cursor) {
    if c == s.cursor {
        return
    }
    s.cursor = c
    let d = s.display
    if is_window(d.pointer_focus, s) && show_cursor(d) {
        wl_display_flush(d.display)
    }
}

fn show_cursor(d: *DisplayState) -> bool {
    let s = d.pointer_focus ?? return false
    if d.pointer == null {
        return false
    }
    let shown = shown_cursor(s)
    if shown == Cursor.Hidden {
        wl_pointer_set_cursor(d.pointer, d.enter_serial, null, 0, 0)
        return true
    }
    if d.cursor_device == null && d.cursor_manager != null {
        d.cursor_device = wp_cursor_shape_manager_v1_get_pointer(d.ifs, d.cursor_manager, d.pointer)
    }
    if d.cursor_device == null {
        return false
    }
    wp_cursor_shape_device_v1_set_shape(d.cursor_device, d.enter_serial, cursor_shape(shown))
    true
}

fn cursor_shape(c: Cursor) -> u32 {
    match c {
        Arrow => wp_cursor_shape_device_v1_shape_default
        Text => wp_cursor_shape_device_v1_shape_text
        Pointer => wp_cursor_shape_device_v1_shape_pointer
        Crosshair => wp_cursor_shape_device_v1_shape_crosshair
        Grab => wp_cursor_shape_device_v1_shape_grab
        Grabbing => wp_cursor_shape_device_v1_shape_grabbing
        NotAllowed => wp_cursor_shape_device_v1_shape_not_allowed
        Move => wp_cursor_shape_device_v1_shape_move
        Wait => wp_cursor_shape_device_v1_shape_wait
        Progress => wp_cursor_shape_device_v1_shape_progress
        Help => wp_cursor_shape_device_v1_shape_help
        ResizeLeftRight => wp_cursor_shape_device_v1_shape_ew_resize
        ResizeUpDown => wp_cursor_shape_device_v1_shape_ns_resize
        ResizeUpLeftDownRight => wp_cursor_shape_device_v1_shape_nwse_resize
        ResizeUpRightDownLeft => wp_cursor_shape_device_v1_shape_nesw_resize
        Hidden => wp_cursor_shape_device_v1_shape_default
    }
}
