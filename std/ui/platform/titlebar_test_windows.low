import std/testing

fn test_a_restored_windows_11_frame_keeps_one_device_pixel_on_top_at_every_scale(t: *testing.T) {
    for dpi in [u32(96), u32(144), u32(192), u32(216)] {
        t.equal(frame_insets_at(true, dpi, false).top, 1)
    }
}

fn test_a_restored_windows_10_frame_keeps_nothing_on_top(t: *testing.T) {
    t.equal(frame_insets_at(false, 144, false).top, 0)
}
