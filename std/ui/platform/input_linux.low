import std/sys

fn at_most(version: u32, limit: u32) -> u32 {
    if version < limit {
        return version
    }
    limit
}

fn fixed_to_f32(value: i32) -> f32 {
    f32(value) / 256.0
}

fn on_global(data: ptr, registry: ptr, name: u32, interface: ptr[u8], version: u32) {
    let d = display_of(data)
    let kind = str(interface)
    if kind == "wl_compositor" {
        d.compositor = wl_registry_bind(registry, name, d.ifs.wl_compositor, at_most(version, 6))
    } else if kind == "xdg_wm_base" {
        d.wm_base = wl_registry_bind(registry, name, d.ifs.xdg_wm_base, at_most(version, 6))
        xdg_wm_base_add_listener(d.ifs, d.wm_base, XdgWmBaseListener { ping: on_ping }, data)
    } else if kind == "wl_seat" && d.seat == null {
        d.seat = wl_registry_bind(registry, name, d.ifs.wl_seat, at_most(version, 9))
        let _ = wl_seat_add_listener(d.ifs, d.seat, WlSeatListener { capabilities: on_capabilities }, data)
        ensure_data_device(d)
        ensure_text_input(d)
    } else if kind == "wl_data_device_manager" {
        d.data_manager = wl_registry_bind(registry, name, d.ifs.wl_data_device_manager, at_most(version, 3))
        ensure_data_device(d)
    } else if kind == "wp_cursor_shape_manager_v1" {
        d.cursor_manager = wl_registry_bind(registry, name, d.ifs.wp_cursor_shape_manager_v1, 1)
    } else if kind == "wp_viewporter" {
        d.viewporter = wl_registry_bind(registry, name, d.ifs.wp_viewporter, 1)
    } else if kind == "wp_fractional_scale_manager_v1" {
        d.fractional_manager = wl_registry_bind(registry, name, d.ifs.wp_fractional_scale_manager_v1, 1)
    } else if kind == "zxdg_decoration_manager_v1" {
        d.decoration_manager = wl_registry_bind(registry, name, d.ifs.zxdg_decoration_manager_v1, 1)
    } else if kind == "zwp_text_input_manager_v3" {
        d.text_manager = wl_registry_bind(registry, name, d.ifs.zwp_text_input_manager_v3, 1)
        ensure_text_input(d)
    }
}

fn on_ping(data: ptr, wm_base: ptr, serial: u32) {
    let d = display_of(data)
    xdg_wm_base_pong(wm_base, serial)
    wl_display_flush(d.display)
}

fn on_capabilities(data: ptr, seat: ptr, capabilities: u32) {
    let d = display_of(data)
    let has_pointer = capabilities & wl_seat_capability_pointer != 0
    let has_keyboard = capabilities & wl_seat_capability_keyboard != 0
    if has_pointer && d.pointer == null {
        d.pointer = wl_seat_get_pointer(d.ifs, seat)
        let listener = WlPointerListener {
            enter: on_pointer_enter
            leave: on_pointer_leave
            motion: on_pointer_motion
            button: on_pointer_button
            axis: on_pointer_axis
        }
        wl_pointer_add_listener(d.ifs, d.pointer, listener, data)
    }
    if !has_pointer && d.pointer != null {
        if d.cursor_device != null {
            wp_cursor_shape_device_v1_destroy(d.cursor_device)
            d.cursor_device = null
        }
        release_pointer(d.pointer)
        d.pointer = null
        d.pointer_focus = none
    }
    if has_keyboard && d.keyboard == null {
        d.keyboard = wl_seat_get_keyboard(d.ifs, seat)
        let listener = WlKeyboardListener {
            keymap: on_keymap
            enter: on_keyboard_enter
            leave: on_keyboard_leave
            key: on_key
            modifiers: on_modifiers
            repeat_info: on_repeat_info
        }
        wl_keyboard_add_listener(d.ifs, d.keyboard, listener, data)
    }
    if !has_keyboard && d.keyboard != null {
        release_keyboard(d.keyboard)
        d.keyboard = null
        d.keyboard_focus = none
        d.repeat.active = false
    }
}

fn release_pointer(pointer: ptr) {
    if wl_proxy_get_version(pointer) >= 3 {
        wl_pointer_release(pointer)
    } else {
        wl_pointer_destroy(pointer)
    }
}

fn release_keyboard(keyboard: ptr) {
    if wl_proxy_get_version(keyboard) >= 3 {
        wl_keyboard_release(keyboard)
    } else {
        wl_keyboard_destroy(keyboard)
    }
}

fn release_seat(seat: ptr) {
    if wl_proxy_get_version(seat) >= 5 {
        wl_seat_release(seat)
    } else {
        wl_seat_destroy(seat)
    }
}

fn on_toplevel_configure(data: ptr, toplevel: ptr, width: i32, height: i32, states: ptr) {
    let s = window_of(data)
    s.pending_width = i64(width)
    s.pending_height = i64(height)
    s.pending_maximized = states_hold_maximized(states)
}

fn states_hold_maximized(states: ptr) -> bool {
    if states == null {
        return false
    }
    let array: ptr[WlArray] = states
    let header = load(array)
    let data: ptr[u32] = header.data
    if data == null {
        return false
    }
    let items: u32[] = view(data, header.size / 4)
    for item in items {
        if item == xdg_toplevel_state_maximized {
            return true
        }
    }
    false
}

fn on_toplevel_close(data: ptr, toplevel: ptr) {
    let s = window_of(data)
    s.events.push(Event.CloseRequested)
}

fn on_surface_configure(data: ptr, xdg_surface: ptr, serial: u32) {
    let s = window_of(data)
    xdg_surface_ack_configure(xdg_surface, serial)
    apply_configure(s)
}

fn apply_configure(s: *WindowState) {
    let bar = bar_height(s)
    let width = if s.pending_width > 0 { s.pending_width } else { s.width }
    let height = if s.pending_height > 0 { s.pending_height } else { s.height + bar - s.bar }
    let changed = !s.configured || width != s.width || height != s.height || bar != s.bar
    s.width = width
    s.height = height
    s.bar = bar
    s.configured = true
    place_viewport(s)
    if s.pending_maximized != s.maximized {
        s.maximized = s.pending_maximized
        s.events.push(Event.Maximized(s.maximized))
    }
    if changed {
        s.events.push(Event.Resized(f32(width), f32(height), window_scale(s)))
    }
}

fn on_pointer_enter(data: ptr, pointer: ptr, serial: u32, surface: ptr, x: i32, y: i32) {
    let d = display_of(data)
    d.enter_serial = serial
    d.pointer_focus = window_at(d, surface)
    let s = d.pointer_focus ?? return
    d.pointer_x = fixed_to_f32(x)
    d.pointer_y = fixed_to_f32(y)
    s.edge = resize_edge(s, d.pointer_x, d.pointer_y)
    let _ = show_cursor(d)
    s.events.push(Event.PointerMoved(d.pointer_x, d.pointer_y))
}

fn on_pointer_leave(data: ptr, pointer: ptr, serial: u32, surface: ptr) {
    let d = display_of(data)
    let s = d.pointer_focus ?? return
    d.pointer_focus = none
    s.edge = xdg_toplevel_resize_edge_none
    s.armed_area = area_none
    s.events.push(Event.PointerLeft)
}

fn on_pointer_motion(data: ptr, pointer: ptr, time: u32, x: i32, y: i32) {
    let d = display_of(data)
    let s = d.pointer_focus ?? return
    d.pointer_x = fixed_to_f32(x)
    d.pointer_y = fixed_to_f32(y)
    track_edge(d, s)
    s.events.push(Event.PointerMoved(d.pointer_x, d.pointer_y))
}

fn on_pointer_button(data: ptr, pointer: ptr, serial: u32, time: u32, button: u32, state: u32) {
    let d = display_of(data)
    d.input_serial = serial
    let s = d.pointer_focus ?? return
    let which = pointer_button(button)
    let pressed = state == wl_pointer_button_state_pressed
    if which == Button.Left {
        let handled = if pressed { begin_frame_press(d, s, serial, time) } else { end_frame_press(d, s) }
        if handled {
            return
        }
    }
    var event = ButtonEvent { button: which, x: d.pointer_x, y: d.pointer_y, modifiers: d.modifiers }
    if pressed {
        event.clicks = count_press(d.clicks, wayland_click_rule(), which, i64(time), d.pointer_x, d.pointer_y)
        s.events.push(Event.PointerDown(event))
    } else {
        event.clicks = d.clicks.count
        s.events.push(Event.PointerUp(event))
    }
}

fn wayland_click_rule() -> ClickRule {
    ClickRule { interval: 400, width: 5.0, height: 5.0 }
}

fn pointer_button(code: u32) -> Button {
    match code {
        0x110 => Button.Left
        0x111 => Button.Right
        0x112 => Button.Middle
        0x113 => Button.Navigate(NavigationDirection.Back)
        0x114 => Button.Navigate(NavigationDirection.Forward)
        _ => Button.Other(i64(code))
    }
}

fn on_pointer_axis(data: ptr, pointer: ptr, time: u32, axis: u32, value: i32) {
    let d = display_of(data)
    let s = d.pointer_focus ?? return
    let amount = fixed_to_f32(value)
    if axis == wl_pointer_axis_horizontal_scroll {
        s.events.push(Event.Scrolled(amount, 0.0, d.modifiers))
    } else {
        s.events.push(Event.Scrolled(0.0, amount, d.modifiers))
    }
}

fn on_keymap(data: ptr, keyboard: ptr, format: u32, fd: i32, size: u32) {
    let d = display_of(data)
    if format != wl_keyboard_keymap_format_xkb_v1 {
        sys.close_fd(i64(fd))
        d.fault = Error.Unsupported("the compositor sent a keymap that is not xkb_v1")
        return
    }
    load_keymap(d, i64(fd), i64(size))
}

fn on_keyboard_enter(data: ptr, keyboard: ptr, serial: u32, surface: ptr, keys: ptr) {
    let d = display_of(data)
    d.input_serial = serial
    d.keyboard_focus = window_at(d, surface)
    let s = d.keyboard_focus ?? return
    s.events.push(Event.FocusChanged(true))
}

fn on_keyboard_leave(data: ptr, keyboard: ptr, serial: u32, surface: ptr) {
    let d = display_of(data)
    d.repeat.active = false
    let s = d.keyboard_focus ?? return
    d.keyboard_focus = none
    s.events.push(Event.FocusChanged(false))
}

fn on_key(data: ptr, keyboard: ptr, serial: u32, time: u32, key: u32, state: u32) {
    let d = display_of(data)
    d.input_serial = serial
    let s = d.keyboard_focus ?? return
    let pressed = state != wl_keyboard_key_state_released
    let translated = translate_key(d, key, pressed) ?? return
    track_repeat(d, key, translated)
    s.events.push(Event.Key(translated))
}

fn on_modifiers(data: ptr, keyboard: ptr, serial: u32, depressed: u32, latched: u32, locked: u32, group: u32) {
    let d = display_of(data)
    update_modifiers(d, depressed, latched, locked, group)
}

fn on_repeat_info(data: ptr, keyboard: ptr, rate: i32, delay: i32) {
    let d = display_of(data)
    d.repeat.delay = i64(delay)
    d.repeat.interval = if rate > 0 { 1000 / i64(rate) } else { 0 }
    if d.repeat.interval == 0 {
        d.repeat.active = false
    }
}
