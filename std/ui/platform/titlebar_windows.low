const wm_nccalcsize: u32 = 0x83
const wm_nchittest: u32 = 0x84
const wm_ncmousemove: u32 = 0xA0
const wm_nclbuttondown: u32 = 0xA1
const wm_nclbuttonup: u32 = 0xA2
const wm_nclbuttondblclk: u32 = 0xA3
const wm_ncmouseleave: u32 = 0x2A2
const ht_nowhere: i64 = 0
const ht_caption: i64 = 2
const ht_minbutton: i64 = 8
const ht_maxbutton: i64 = 9
const ht_left: i64 = 10
const ht_right: i64 = 11
const ht_top: i64 = 12
const ht_topleft: i64 = 13
const ht_topright: i64 = 14
const ht_bottom: i64 = 15
const ht_bottomleft: i64 = 16
const ht_bottomright: i64 = 17
const ht_close: i64 = 20
const sm_cxsizeframe: i32 = 32
const sm_cysizeframe: i32 = 33
const sm_cxpaddedborder: i32 = 92
const sw_minimize: i32 = 6
const sw_maximize: i32 = 3
const sw_restore: i32 = 9
const swp_framechanged: u32 = 0x20
const tme_nonclient: u32 = 0x10
const size_minimized: i64 = 1
const win11_build: u32 = 22000
const version_info_words: i64 = 69
const version_info_bytes: u32 = 276
const version_build_word: i64 = 3

fn windows_build() -> u32 {
    var info: []u32 = []
    for i in 0..version_info_words {
        info.push(0)
    }
    info[0] = version_info_bytes
    let at: ptr[u32] = pin(info)
    RtlGetVersion(at)
    unpin(at)
    info[version_build_word]
}

fn frame_insets(s: *WindowState, hwnd: ptr, zoomed: bool) -> Rect {
    frame_insets_at(s.win11, GetDpiForWindow(hwnd), zoomed)
}

fn frame_insets_at(win11: bool, dpi: u32, zoomed: bool) -> Rect {
    let padding = GetSystemMetricsForDpi(sm_cxpaddedborder, dpi)
    let side = GetSystemMetricsForDpi(sm_cxsizeframe, dpi) + padding
    let base = GetSystemMetricsForDpi(sm_cysizeframe, dpi) + padding
    var top: i32 = 0
    if zoomed {
        top = base
    } else if win11 {
        top = i32(floor(f32(dpi) / 96.0 + 0.5))
    }
    Rect { left: side, top, right: side, bottom: base }
}

fn calc_client(s: *WindowState, hwnd: ptr, wparam: i64, lparam: i64) -> i64 {
    if !s.bare || wparam == 0 {
        return DefWindowProcW(hwnd, wm_nccalcsize, wparam, lparam)
    }
    let target: ptr[Rect] = ptr(lparam)
    let rect = load(target)
    let insets = frame_insets(s, hwnd, IsZoomed(hwnd) != 0)
    let inner = Rect { left: rect.left + insets.left, top: rect.top + insets.top, right: rect.right - insets.right, bottom: rect.bottom - insets.bottom }
    store(target, inner)
    0
}

fn message_client_point(hwnd: ptr, lparam: i64) -> Point {
    var at = Point { x: i32(signed_word(lparam)), y: i32(signed_word(lparam >> 16)) }
    ScreenToClient(hwnd, mut at)
    at
}

fn is_frame_hit(code: i64) -> bool {
    code == ht_nowhere || code == ht_left || code == ht_right || code == ht_top || code == ht_topleft || code == ht_topright || code == ht_bottom || code == ht_bottomleft || code == ht_bottomright
}

fn area_hit(code: i64) -> i64 {
    match code {
        area_drag => ht_caption
        area_close => ht_close
        area_max => ht_maxbutton
        area_min => ht_minbutton
        _ => ht_client
    }
}

fn caption_hit(s: *WindowState, hwnd: ptr, wparam: i64, lparam: i64) -> i64 {
    let at = message_client_point(hwnd, lparam)
    s.area_hit = 0
    let area = s.hit_test(logical(s, i64(at.x)), logical(s, i64(at.y)))
    if area != area_none {
        let code = area_hit(area)
        s.area_hit = code
        return code
    }
    let hit = DefWindowProcW(hwnd, wm_nchittest, wparam, lparam)
    if !s.bare || is_frame_hit(hit) {
        return hit
    }
    if IsZoomed(hwnd) == 0 && at.y >= 0 {
        let dpi = GetDpiForWindow(hwnd)
        let frame = GetSystemMetricsForDpi(sm_cysizeframe, dpi)
        if at.y <= frame {
            return ht_top
        }
    }
    ht_client
}

fn is_control_button(code: i64) -> bool {
    code == ht_close || code == ht_maxbutton || code == ht_minbutton
}

fn owns_button(s: *WindowState, code: i64) -> bool {
    is_control_button(code) && (s.bare || s.area_hit == code)
}

fn caption_pressed(s: *WindowState, hwnd: ptr, msg: u32, wparam: i64, lparam: i64) -> i64 {
    if !owns_button(s, wparam) {
        s.nc_pressed = 0
        return DefWindowProcW(hwnd, msg, wparam, lparam)
    }
    s.nc_pressed = wparam
    0
}

fn caption_released(s: *WindowState, hwnd: ptr, wparam: i64, lparam: i64) -> i64 {
    let pressed = s.nc_pressed
    s.nc_pressed = 0
    if !owns_button(s, wparam) {
        return DefWindowProcW(hwnd, wm_nclbuttonup, wparam, lparam)
    }
    if pressed != wparam {
        return 0
    }
    if pressed == ht_close {
        PostMessageW(hwnd, wm_close, 0, 0)
    } else if pressed == ht_minbutton {
        ShowWindowAsync(hwnd, sw_minimize)
    } else {
        toggle_zoom(hwnd)
    }
    0
}

fn caption_moved(s: *WindowState, hwnd: ptr, lparam: i64) {
    if s.bare {
        let at = message_client_point(hwnd, lparam)
        pointer_moved(s, hwnd, (i64(at.y) << 16) | (i64(at.x) & 0xFFFF), tme_leave | tme_nonclient)
    }
}

fn caption_left(s: *WindowState, hwnd: ptr, wparam: i64, lparam: i64) -> i64 {
    s.nc_pressed = 0
    pointer_left(s)
    if s.bare {
        return 0
    }
    DefWindowProcW(hwnd, wm_ncmouseleave, wparam, lparam)
}

fn toggle_zoom(hwnd: ptr) {
    if IsZoomed(hwnd) != 0 {
        ShowWindowAsync(hwnd, sw_restore)
    } else {
        ShowWindowAsync(hwnd, sw_maximize)
    }
}

fn track_maximized(s: *WindowState, hwnd: ptr) {
    let now = IsZoomed(hwnd) != 0
    if now != s.maximized {
        s.maximized = now
        s.events.push(Maximized(now))
    }
}

fn set_window_hit_test(s: *WindowState, f: fn(f32, f32) -> i64) {
    s.hit_test = f
}

fn window_maximized(s: *WindowState) -> bool {
    s.hwnd != null && IsZoomed(s.hwnd) != 0
}

fn minimize_window(s: *WindowState) {
    if s.hwnd != null {
        ShowWindowAsync(s.hwnd, sw_minimize)
    }
}

fn zoom_window(s: *WindowState) {
    if s.hwnd != null {
        toggle_zoom(s.hwnd)
    }
}
