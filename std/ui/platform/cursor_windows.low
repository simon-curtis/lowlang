const wm_setcursor: u32 = 0x20
const ht_client: i64 = 1

const idc_ibeam: i64 = 32513
const idc_wait: i64 = 32514
const idc_cross: i64 = 32515
const idc_sizenwse: i64 = 32642
const idc_sizenesw: i64 = 32643
const idc_sizewe: i64 = 32644
const idc_sizens: i64 = 32645
const idc_sizeall: i64 = 32646
const idc_no: i64 = 32648
const idc_hand: i64 = 32649
const idc_appstarting: i64 = 32650
const idc_help: i64 = 32651

fn set_window_cursor(s: *WindowState, c: Cursor) {
    if c == s.cursor {
        return
    }
    s.cursor = c
    if s.tracking {
        show_cursor(c)
    }
}

fn show_cursor(c: Cursor) {
    let resource = cursor_resource(c)
    if resource == 0 {
        SetCursor(null)
        return
    }
    SetCursor(LoadCursorW(null, resource))
}

fn cursor_resource(c: Cursor) -> i64 {
    match c {
        Arrow => idc_arrow
        Text => idc_ibeam
        Pointer => idc_hand
        Crosshair => idc_cross
        Grab => idc_hand
        Grabbing => idc_hand
        NotAllowed => idc_no
        Move => idc_sizeall
        Wait => idc_wait
        Progress => idc_appstarting
        Help => idc_help
        ResizeLeftRight => idc_sizewe
        ResizeUpDown => idc_sizens
        ResizeUpLeftDownRight => idc_sizenwse
        ResizeUpRightDownLeft => idc_sizenesw
        Hidden => 0
    }
}
