const pixels_per_notch: f32 = 48.0
const wheel_notch: f32 = 120.0

fn window_proc(hwnd: ptr, msg: u32, wparam: i64, lparam: i64) -> i64 {
    if msg == wm_nccreate {
        return adopt(hwnd, msg, wparam, lparam)
    }
    let anchor = GetWindowLongPtrW(hwnd, gwlp_userdata)
    if anchor == null {
        return DefWindowProcW(hwnd, msg, wparam, lparam)
    }
    let slot: ptr[*WindowState] = anchor
    let s = load(slot)
    if msg == wm_ncdestroy {
        SetWindowLongPtrW(hwnd, gwlp_userdata, null)
        return DefWindowProcW(hwnd, msg, wparam, lparam)
    }
    handle(s, hwnd, msg, wparam, lparam)
}

fn adopt(hwnd: ptr, msg: u32, wparam: i64, lparam: i64) -> i64 {
    let create: ptr[CreateStruct] = ptr(lparam)
    SetLastError(0)
    let previous = SetWindowLongPtrW(hwnd, gwlp_userdata, load(create).params)
    if previous == null && GetLastError() != 0 {
        return 0
    }
    DefWindowProcW(hwnd, msg, wparam, lparam)
}

fn handle(s: *WindowState, hwnd: ptr, msg: u32, wparam: i64, lparam: i64) -> i64 {
    match msg {
        wm_size => {
            resized(s, lparam & 0xFFFF, (lparam >> 16) & 0xFFFF)
            0
        }
        wm_dpichanged => {
            dpi_changed(s, hwnd, wparam, lparam)
            0
        }
        wm_close => {
            s.events.push(CloseRequested)
            0
        }
        wm_setfocus => {
            s.events.push(FocusChanged(true))
            0
        }
        wm_killfocus => {
            s.events.push(FocusChanged(false))
            0
        }
        wm_app => {
            s.events.push(Woken)
            0
        }
        wm_mousemove => {
            pointer_moved(s, hwnd, lparam)
            0
        }
        wm_mouseleave => {
            pointer_left(s)
            0
        }
        wm_capturechanged => {
            s.buttons = 0
            0
        }
        wm_lbuttondown => button_changed(s, hwnd, Button.Left, true, lparam)
        wm_lbuttonup => button_changed(s, hwnd, Button.Left, false, lparam)
        wm_rbuttondown => button_changed(s, hwnd, Button.Right, true, lparam)
        wm_rbuttonup => button_changed(s, hwnd, Button.Right, false, lparam)
        wm_mbuttondown => button_changed(s, hwnd, Button.Middle, true, lparam)
        wm_mbuttonup => button_changed(s, hwnd, Button.Middle, false, lparam)
        wm_xbuttondown => {
            button_changed(s, hwnd, extra_button(wparam), true, lparam)
            1
        }
        wm_xbuttonup => {
            button_changed(s, hwnd, extra_button(wparam), false, lparam)
            1
        }
        wm_mousewheel => {
            s.events.push(Scrolled(0.0, -wheel_notches(wparam) * pixels_per_notch))
            0
        }
        wm_mousehwheel => {
            s.events.push(Scrolled(wheel_notches(wparam) * pixels_per_notch, 0.0))
            0
        }
        wm_keydown => {
            key_changed(s, wparam, lparam, true)
            0
        }
        wm_keyup => {
            key_changed(s, wparam, lparam, false)
            0
        }
        wm_syskeydown => {
            key_changed(s, wparam, lparam, true)
            DefWindowProcW(hwnd, msg, wparam, lparam)
        }
        wm_syskeyup => {
            key_changed(s, wparam, lparam, false)
            DefWindowProcW(hwnd, msg, wparam, lparam)
        }
        wm_char => {
            character_typed(s, wparam)
            0
        }
        wm_syschar => {
            character_typed(s, wparam)
            if wparam == 0x20 {
                return DefWindowProcW(hwnd, msg, wparam, lparam)
            }
            0
        }
        _ => DefWindowProcW(hwnd, msg, wparam, lparam)
    }
}

fn signed_word(value: i64) -> i64 {
    let word = value & 0xFFFF
    if word >= 0x8000 {
        return word - 0x10000
    }
    word
}

fn resized(s: *WindowState, pixel_width: i64, pixel_height: i64) {
    if pixel_width <= 0 || pixel_height <= 0 {
        return
    }
    let width = pixel_width / s.scale
    let height = pixel_height / s.scale
    if width == s.width && height == s.height && s.scale == s.reported_scale {
        return
    }
    s.width = width
    s.height = height
    s.reported_scale = s.scale
    s.events.push(Resized(width, height, s.scale))
}

fn report_size(s: *WindowState, hwnd: ptr) {
    var client = Rect {}
    if GetClientRect(hwnd, mut client) == 0 {
        record_fault(s, "GetClientRect")
        return
    }
    resized(s, i64(client.right - client.left), i64(client.bottom - client.top))
}

fn dpi_changed(s: *WindowState, hwnd: ptr, wparam: i64, lparam: i64) {
    s.scale = scale_of(wparam & 0xFFFF)
    let suggested: ptr[Rect] = ptr(lparam)
    let target = load(suggested)
    let flags = swp_nozorder | swp_noactivate
    if SetWindowPos(hwnd, null, target.left, target.top, target.right - target.left, target.bottom - target.top, flags) == 0 {
        record_fault(s, "SetWindowPos")
    }
    report_size(s, hwnd)
}

fn logical(s: *WindowState, pixels: i64) -> f32 {
    f32(pixels) / f32(s.scale)
}

fn pointer_moved(s: *WindowState, hwnd: ptr, lparam: i64) {
    if !s.tracking {
        var track = TrackMouse { flags: tme_leave, hwnd }
        if TrackMouseEvent(mut track) == 0 {
            record_fault(s, "TrackMouseEvent")
        } else {
            s.tracking = true
        }
    }
    s.events.push(PointerMoved(logical(s, signed_word(lparam)), logical(s, signed_word(lparam >> 16))))
}

fn pointer_left(s: *WindowState) {
    if s.tracking {
        s.tracking = false
        s.events.push(PointerLeft)
    }
}

fn extra_button(wparam: i64) -> Button {
    Button.Other(((wparam >> 16) & 0xFFFF) + 3)
}

fn button_bit(button: Button) -> i64 {
    match button {
        Left => 1
        Right => 2
        Middle => 4
        Other(code) => 1 << code
    }
}

fn button_changed(s: *WindowState, hwnd: ptr, button: Button, pressed: bool, lparam: i64) -> i64 {
    let x = logical(s, signed_word(lparam))
    let y = logical(s, signed_word(lparam >> 16))
    let bit = button_bit(button)
    if pressed {
        if s.buttons == 0 {
            SetCapture(hwnd)
        }
        s.buttons = s.buttons | bit
        s.events.push(PointerDown(button, x, y))
        return 0
    }
    let held = s.buttons != 0
    s.buttons = s.buttons & ~bit
    s.events.push(PointerUp(button, x, y))
    if held && s.buttons == 0 && ReleaseCapture() == 0 {
        record_fault(s, "ReleaseCapture")
    }
    0
}

fn wheel_notches(wparam: i64) -> f32 {
    f32(signed_word(wparam >> 16)) / wheel_notch
}
