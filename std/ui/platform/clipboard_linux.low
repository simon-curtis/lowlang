import std/io
import std/sys

const clipboard_read_ms = 1000
const clipboard_chunk = 4096

fn text_types() -> str[] {
    ["text/plain;charset=utf-8", "text/plain"]
}

fn text_rank(mime: str) -> i64 {
    for i, t in text_types() {
        if t == mime {
            return i
        }
    }
    -1
}

fn ensure_data_device(d: *DisplayState) {
    if d.data_device != null || d.data_manager == null || d.seat == null {
        return
    }
    d.data_device = wl_data_device_manager_get_data_device(d.ifs, d.data_manager, d.seat)
    wl_data_device_add_listener(d.ifs, d.data_device, WlDataDeviceListener { data_offer: on_data_offer, selection: on_selection }, d.handle)
}

fn on_data_offer(data: ptr, device: ptr, offer: ptr) {
    let d = display_of(data)
    forget_incoming(d)
    d.incoming = offer
    d.incoming_type = ""
    wl_data_offer_add_listener(d.ifs, offer, WlDataOfferListener { offer: on_offer_type }, data)
}

fn on_offer_type(data: ptr, offer: ptr, mime: ptr[u8]) {
    let d = display_of(data)
    if offer != d.incoming {
        return
    }
    let rank = text_rank(str(mime))
    if rank >= 0 && (d.incoming_type == "" || rank < text_rank(d.incoming_type)) {
        d.incoming_type = str(mime)
    }
}

fn on_selection(data: ptr, device: ptr, offer: ptr) {
    let d = display_of(data)
    if d.selection != null && d.selection != offer {
        wl_data_offer_destroy(d.selection)
    }
    d.selection = offer
    d.selection_type = ""
    if offer != null && offer == d.incoming {
        d.selection_type = d.incoming_type
        d.incoming = null
    }
}

fn forget_incoming(d: *DisplayState) {
    if d.incoming != null && d.incoming != d.selection {
        wl_data_offer_destroy(d.incoming)
    }
    d.incoming = null
}

fn on_source_send(data: ptr, source: ptr, mime: ptr[u8], fd: i32) {
    let d = display_of(data)
    if source == d.source && text_rank(str(mime)) >= 0 {
        sys.write_all(i64(fd), bytes(d.source_text)) or {}
    }
    sys.close_fd(i64(fd))
}

fn on_source_cancelled(data: ptr, source: ptr) {
    let d = display_of(data)
    wl_data_source_destroy(source)
    if source == d.source {
        d.source = null
        d.source_text = ""
    }
}

fn write_window_clipboard(s: *WindowState, text: str) ! Error {
    let d = s.display
    if d.display == null {
        fail Error.Disconnected
    }
    ensure_data_device(d)
    if d.data_device == null {
        fail Unsupported("the compositor offers no wl_data_device_manager or wl_seat")
    }
    let source = wl_data_device_manager_create_data_source(d.ifs, d.data_manager)
    for t in text_types() {
        wl_data_source_offer(source, cstr(t))
    }
    wl_data_source_add_listener(d.ifs, source, WlDataSourceListener { send: on_source_send, cancelled: on_source_cancelled }, d.handle)
    wl_data_device_set_selection(d.data_device, source, d.input_serial)
    if d.source != null {
        wl_data_source_destroy(d.source)
    }
    d.source = source
    d.source_text = text
    flush(d)?
}

fn read_window_clipboard(s: *WindowState) -> str? ! Error {
    let d = s.display
    if d.display == null {
        fail Error.Disconnected
    }
    if d.source != null {
        return d.source_text
    }
    if d.selection == null || d.selection_type == "" {
        return none
    }
    let ends = sys.pipe(false) catch {
        e => fail Failed("pipe", 0)
    }
    sys.set_nonblocking(ends.first) catch {
        e => {
            sys.close_fd(ends.first)
            sys.close_fd(ends.second)
            fail Failed("fcntl", 0)
        }
    }
    wl_data_offer_receive(d.selection, cstr(d.selection_type), i32(ends.second))
    sys.close_fd(ends.second)
    flush(d) catch {
        e => {
            sys.close_fd(ends.first)
            fail e
        }
    }
    let got = drain_pipe(ends.first)
    sys.close_fd(ends.first)
    if got == "" {
        return none
    }
    got
}

fn drain_pipe(fd: i64) -> str {
    var deadline = now_ms() + clipboard_read_ms
    var out: u8[] = []
    let buf = io.buffer(clipboard_chunk)
    for now_ms() < deadline {
        let n = sys.try_read(fd, buf) catch {
            WouldBlock => -1
            e => return str(out)
        }
        if n == 0 {
            return str(out)
        }
        if n < 0 {
            sleep(1)
            continue
        }
        io.append(mut out, buf[..n])
        deadline = now_ms() + clipboard_read_ms
    }
    str(out)
}

fn release_clipboard(d: *DisplayState) {
    forget_incoming(d)
    if d.selection != null {
        wl_data_offer_destroy(d.selection)
    }
    if d.source != null {
        wl_data_source_destroy(d.source)
    }
    if d.data_device != null {
        if wl_proxy_get_version(d.data_device) >= 2 {
            wl_data_device_release(d.data_device)
        } else {
            wl_data_device_destroy(d.data_device)
        }
    }
    if d.data_manager != null {
        wl_data_device_manager_destroy(d.data_manager)
    }
    d.selection = null
    d.source = null
    d.data_device = null
    d.data_manager = null
}
