/// What `open` needs to make a window.
pub struct Options {
    /// The window title.
    pub title: str = "Low"
    /// The width of the window's content in logical pixels.
    pub width: i64 = 800
    /// The height of the window's content in logical pixels.
    pub height: i64 = 600
}

/// Why a window could not be opened or serviced.
pub enum Error {
    /// The windowing system could not be reached: no Wayland compositor, or no desktop on Windows.
    NoDisplay(detail: str)
    /// The windowing system lacks something the window needs, such as a global it did not advertise.
    Unsupported(detail: str)
    /// A call into the windowing system failed with the code it returned.
    Failed(call: str, code: i64)
    /// The connection to the windowing system was lost.
    Disconnected
}

/// A pointer button.
pub enum Button {
    /// The primary button.
    Left
    /// The secondary button.
    Right
    /// The wheel button.
    Middle
    /// Any other button, numbered as the windowing system numbers it.
    Other(code: i64)
}

/// A key that does not produce text.
pub enum NamedKey {
    /// Enter or Return.
    Enter
    /// Escape.
    Escape
    /// Tab.
    Tab
    /// Backspace.
    Backspace
    /// Delete, forward.
    Delete
    /// The left arrow.
    Left
    /// The right arrow.
    Right
    /// The up arrow.
    Up
    /// The down arrow.
    Down
    /// Home.
    Home
    /// End.
    End
    /// Page Up.
    PageUp
    /// Page Down.
    PageDown
    /// A function key, `Function(1)` for F1 up to `Function(12)` for F12.
    Function(number: i64)
}

/// The identity of a pressed key.
pub enum Key {
    /// A key that does not produce text.
    Named(key: NamedKey)
    /// A key that produces text, named by the text it produces without modifiers other than Shift, such as `"a"`, `"A"` or `" "`.
    Character(text: str)
}

/// The modifier keys held during an event.
pub struct Modifiers {
    /// Either Shift key.
    pub shift: bool = false
    /// Either Control key.
    pub control: bool = false
    /// Either Alt key.
    pub alt: bool = false
    /// The Super, Windows or Command key.
    pub super: bool = false
}

/// A key press or release.
pub struct KeyEvent {
    /// The key.
    pub key: Key
    /// The text the key produces with the modifiers held, empty for a release and for keys that produce none.
    pub text: str = ""
    /// The modifiers held.
    pub modifiers: Modifiers = Modifiers {}
    /// `true` for a press, `false` for a release.
    pub pressed: bool = true
    /// `true` for a press repeated because the key is held.
    pub repeat: bool = false
}

/// Something that happened to a window.
///
/// Sizes and positions are logical pixels; multiplying by the scale gives device pixels.
pub enum Event {
    /// The content area is now `width` by `height` logical pixels at `scale` device pixels per logical pixel. The first `next` after `open` returns one.
    Resized(width: i64, height: i64, scale: i64)
    /// The user asked to close the window.
    CloseRequested
    /// The pointer moved to `x`, `y` from the top left of the content area.
    PointerMoved(x: f32, y: f32)
    /// The pointer left the content area.
    PointerLeft
    /// A button was pressed with the pointer at `x`, `y`.
    PointerDown(button: Button, x: f32, y: f32)
    /// A button was released with the pointer at `x`, `y`.
    PointerUp(button: Button, x: f32, y: f32)
    /// The wheel or touchpad scrolled by `dx`, `dy` logical pixels, positive to the right and down.
    Scrolled(dx: f32, dy: f32)
    /// A key was pressed or released while the window had keyboard focus.
    Key(event: KeyEvent)
    /// The window gained keyboard focus, `true`, or lost it, `false`.
    FocusChanged(focused: bool)
    /// A `Waker` of the window fired.
    Woken
}

/// The handles a renderer needs to make a surface for a window.
///
/// On Linux `display` is the `wl_display` and `window` the `wl_surface`. On Windows `display` is the `HINSTANCE` and `window` the `HWND`.
pub struct Native {
    /// The connection or module handle.
    pub display: ptr
    /// The window's surface or handle.
    pub window: ptr
}

/// An open window. Releasing it destroys the window and closes the connection to the windowing system.
///
/// A window belongs to the green thread that opened it: `next` must be called from that green thread.
pub struct Window {
    state: *WindowState
    drop close_window(state)
}

/// A copyable handle that ends a window's `next` early from any green thread.
pub struct Waker {
    state: *WakerState
}

/// Opens a window with the title and logical content size of `o`, and returns once it can be drawn into.
pub fn open(o: Options) -> Window ! Error {
    let state = open_window(o)?
    Window { state }
}

/// Returns the events that arrived for `w`, waiting until at least one arrives, a `Waker` fires or `timeout_ms` milliseconds pass. A negative timeout waits without limit.
pub fn next(w: Window, timeout_ms: i64) -> []Event ! Error {
    next_events(w.state, timeout_ms)?
}

/// Returns a `Waker` for `w`.
pub fn waker(w: Window) -> Waker {
    Waker { state: window_waker(w.state) }
}

/// Makes the `next` call waiting on the waker's window return with a `Woken` event, or the next one when none is waiting.
pub fn wake(k: Waker) {
    wake_window(k.state)
}

/// Returns the handles a renderer needs to draw into `w`.
pub fn native(w: Window) -> Native {
    window_native(w.state)
}
