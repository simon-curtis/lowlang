/// What `open` needs to make a window.
pub struct Options {
    /// The window title.
    pub title: str = "Low"
    /// The width of the window's content in logical pixels.
    pub width: i64 = 800
    /// The height of the window's content in logical pixels.
    pub height: i64 = 600
    /// What the system draws above the content.
    pub titlebar: TitlebarOptions = TitlebarOptions {}
    /// `true` opens the window created and sized as any other but invisible, until `show` is called, so a program can draw its first frame before anyone sees the window. On Windows the window is cloaked through DWM, which keeps its surface composed so a renderer can present into it, and `show` uncloaks it; where cloaking fails, the window is not shown at all until `show`. A Wayland surface is not mapped before its first buffer commit, so the option changes nothing there.
    pub hidden: bool = false
}

/// What the system draws above a window's content.
///
/// On Windows a window whose `appears_transparent` is `true` has its content reach the top of the window, inside the invisible resize frame at its other edges, with the resize borders, snap layouts and the maximised frame still the system's, and draws no caption buttons; the program draws its own and marks them with `WindowControlArea`. The Wayland backend asks for no server-side decorations, so it draws every pixel of the window already and ignores the option.
pub struct TitlebarOptions {
    /// `true` hides the system title bar so the program draws its own.
    pub appears_transparent: bool = false
}

/// A part of a window that the system treats as a caption control.
pub enum WindowControlArea {
    /// A part that drags the window and, when double-clicked, maximises or restores it.
    Drag
    /// A part that closes the window when clicked.
    Close
    /// A part that maximises or restores the window when clicked, and over which Windows 11 offers its snap layouts.
    Max
    /// A part that minimises the window when clicked.
    Min
}

/// Why a window could not be opened or serviced.
pub enum Error {
    /// The windowing system could not be reached: no Wayland compositor, or no desktop on Windows.
    NoDisplay(detail: str)
    /// The windowing system lacks something the window needs, such as a global it did not advertise.
    Unsupported(detail: str)
    /// A call into the windowing system failed with the code it returned.
    Failed(call: str, code: i64)
    /// The connection to the windowing system was lost.
    Disconnected
}

/// A pointer button.
pub enum Button {
    /// The primary button.
    Left
    /// The secondary button.
    Right
    /// The wheel button.
    Middle
    /// A side button that moves back or forward, as in a browser.
    Navigate(direction: NavigationDirection)
    /// Any other button, numbered as the windowing system numbers it.
    Other(code: i64)
}

/// Which way a navigation button moves.
pub enum NavigationDirection {
    /// Back, the first side button.
    Back
    /// Forward, the second side button.
    Forward
}

/// A key that does not produce text.
pub enum NamedKey {
    /// Enter or Return.
    Enter
    /// Escape.
    Escape
    /// Tab.
    Tab
    /// Backspace.
    Backspace
    /// Delete, forward.
    Delete
    /// The left arrow.
    Left
    /// The right arrow.
    Right
    /// The up arrow.
    Up
    /// The down arrow.
    Down
    /// Home.
    Home
    /// End.
    End
    /// Page Up.
    PageUp
    /// Page Down.
    PageDown
    /// Insert.
    Insert
    /// Pause.
    Pause
    /// Break, which Control with Pause produces.
    Break
    /// Menu, the context-menu key of a PC keyboard.
    Menu
    /// A function key, `Function(1)` for F1 up to `Function(12)` for F12.
    Function(number: i64)
}

/// The pointer's image over a window.
pub enum Cursor {
    /// The usual arrow.
    Arrow
    /// A text caret, for selecting text.
    Text
    /// A pointing hand, for links and other things that act when clicked.
    Pointer
    /// A crosshair.
    Crosshair
    /// An open hand, for something that can be dragged.
    Grab
    /// A closed hand, for something being dragged.
    Grabbing
    /// A sign that the action under the pointer is not allowed.
    NotAllowed
    /// Arrows in four directions, for something that moves.
    Move
    /// A sign that the program is busy.
    Wait
    /// A sign that the program is busy but still responds.
    Progress
    /// A sign that help is available.
    Help
    /// Resizing left or right.
    ResizeLeftRight
    /// Resizing up or down.
    ResizeUpDown
    /// Resizing along the diagonal from the top left to the bottom right.
    ResizeUpLeftDownRight
    /// Resizing along the diagonal from the top right to the bottom left.
    ResizeUpRightDownLeft
    /// No image.
    Hidden
}

/// The identity of a pressed key.
pub enum Key {
    /// A key that does not produce text.
    Named(key: NamedKey)
    /// A key that produces text, named by the text it produces without modifiers other than Shift, such as `"a"`, `"A"` or `" "`.
    Character(text: str)
}

/// The modifier keys held during an event.
pub struct Modifiers {
    /// Either Shift key.
    pub shift: bool = false
    /// Either Control key.
    pub control: bool = false
    /// Either Alt key.
    pub alt: bool = false
    /// The Super, Windows or Command key.
    pub super: bool = false
}

/// A range of a string's bytes, from `start` up to `end`.
pub struct TextRange {
    /// The offset of the first byte.
    pub start: i64
    /// The offset after the last byte.
    pub end: i64
}

/// The caret of the text being edited, in logical pixels from the top left of the content area. The input method places its candidate window beside it.
pub struct Caret {
    /// The left edge.
    pub x: i64 = 0
    /// The top edge.
    pub y: i64 = 0
    /// The width, zero for a thin caret.
    pub width: i64 = 0
    /// The height.
    pub height: i64 = 0
}

/// A press or release of a pointer button.
pub struct ButtonEvent {
    /// The button.
    pub button: Button = Button.Left
    /// The pointer's distance from the left of the content area.
    pub x: f32 = 0.0
    /// The pointer's distance from the top of the content area.
    pub y: f32 = 0.0
    /// How many presses of this button in a row, each within the system's double-click time and distance of the last, this press makes: `1` for a single press, `2` for the second of a double click. A release carries the count of the press it ends.
    pub clicks: i64 = 1
    /// The modifiers held.
    pub modifiers: Modifiers = Modifiers {}
}

/// A key press or release.
pub struct KeyEvent {
    /// The key.
    pub key: Key
    /// The text the key produces with the modifiers held, empty for a release and for keys that produce none.
    pub text: str = ""
    /// The modifiers held.
    pub modifiers: Modifiers = Modifiers {}
    /// `true` for a press, `false` for a release.
    pub pressed: bool = true
    /// `true` for a press repeated because the key is held.
    pub repeat: bool = false
}

/// Something that happened to a window.
///
/// Sizes and positions are logical pixels; multiplying by the scale gives device pixels.
pub enum Event {
    /// The content area is now `width` by `height` logical pixels at `scale` device pixels per logical pixel. The first `next` after `open` returns one.
    ///
    /// On Windows the scale is the window's dots per inch over 96, so 1.25 at 125 percent, and the size is the content area in device pixels divided by the scale, which is not a whole number where the scale is not a divisor of the pixel size.
    Resized(width: f32, height: f32, scale: f32)
    /// The user asked to close the window.
    CloseRequested
    /// The pointer moved to `x`, `y` from the top left of the content area.
    PointerMoved(x: f32, y: f32)
    /// The pointer left the content area.
    PointerLeft
    /// A button was pressed.
    ///
    /// On Windows the click count follows `GetDoubleClickTime` and `SM_CXDOUBLECLK` and `SM_CYDOUBLECLK`, as gpui's `ClickState` does; on Wayland a press within 400 milliseconds and 5 logical pixels of the last press of the same button counts on.
    PointerDown(event: ButtonEvent)
    /// A button was released.
    PointerUp(event: ButtonEvent)
    /// The wheel or touchpad scrolled by `dx`, `dy` logical pixels, positive to the right and down.
    Scrolled(dx: f32, dy: f32)
    /// A key was pressed or released while the window had keyboard focus.
    Key(event: KeyEvent)
    /// The input method's composition changed to `text`, with its cursor over `cursor`, byte offsets into `text`, or hidden. Empty text ends the composition. Only arrives while text input is on.
    Preedit(text: str, cursor: TextRange?)
    /// The input method entered `text`, which replaces the composition. Only arrives while text input is on.
    Commit(text: str)
    /// The window was maximised, `true`, or restored from it, `false`. Only a window whose maximised state changes sends one.
    Maximized(maximized: bool)
    /// The window gained keyboard focus, `true`, or lost it, `false`.
    FocusChanged(focused: bool)
    /// A `Waker` of the window fired.
    Woken
    /// Files were dragged from another program into the content area, as gpui's `FileDropEvent::Entered`: `paths` are their full paths and `x`, `y` the pointer's position. Only a Windows window delivers file drags; it follows with `FileDragMoved` while they stay over the window and ends with `FileDropped` or `FileDragExited`.
    FileDragEntered(x: f32, y: f32, paths: str[])
    /// The dragged files moved to `x`, `y`, as gpui's `FileDropEvent::Pending`.
    FileDragMoved(x: f32, y: f32)
    /// The dragged files were released at `x`, `y`, as gpui's `FileDropEvent::Submit`.
    FileDropped(x: f32, y: f32)
    /// The dragged files left the content area without being released, as gpui's `FileDropEvent::Exited`.
    FileDragExited
}

/// The handles a renderer needs to make a surface for a window.
///
/// On Linux `display` is the `wl_display` and `window` the `wl_surface`. On Windows `display` is the `HINSTANCE` and `window` the `HWND`.
pub struct Native {
    /// The connection or module handle.
    pub display: ptr
    /// The window's surface or handle.
    pub window: ptr
}

/// An open window. Releasing it destroys the window and closes the connection to the windowing system.
///
/// A window belongs to the green thread that opened it: `next` must be called from that green thread.
pub struct Window {
    state: *WindowState
    drop close_window(state)
}

/// A copyable handle to the system clipboard through a window, for code that does not own the window.
pub struct Clipboard {
    state: *WindowState
}

/// A copyable handle to a window's maximise and minimise commands, for code that does not own the window.
pub struct Controls {
    state: *WindowState
}

/// A copyable handle that ends a window's `next` early from any green thread.
pub struct Waker {
    state: *WakerState
}

/// Opens a window with the title and logical content size of `o`, and returns once it can be drawn into. A window opened with `hidden` stays invisible until `show`.
pub fn open(o: Options) -> Window ! Error {
    let state = open_window(o)?
    Window { state }
}

/// Makes a window that was opened with `hidden` visible. A window that is already visible stays as it is. On Wayland the surface is mapped by the first buffer a renderer commits, so the call does nothing there. If uncloaking fails on Windows, the failure is returned by the next `next`.
pub fn show(w: Window) {
    show_window(w.state)
}

/// Returns the events that arrived for `w`, waiting until at least one arrives, a `Waker` fires or `timeout_ms` milliseconds pass. A negative timeout waits without limit.
pub fn next(w: Window, timeout_ms: i64) -> Event[] ! Error {
    next_events(w.state, timeout_ms)?
}

/// Returns a `Waker` for `w`.
pub fn waker(w: Window) -> Waker {
    Waker { state: window_waker(w.state) }
}

/// Makes the `next` call waiting on the waker's window return with a `Woken` event, or the next one when none is waiting.
pub fn wake(k: Waker) {
    wake_window(k.state)
}

/// Returns a `Clipboard` that reaches the system clipboard through `w`.
pub fn clipboard(w: Window) -> Clipboard {
    Clipboard { state: w.state }
}

/// Puts `text` on the system clipboard, where other programs can paste it.
pub fn write_clipboard(c: Clipboard, text: str) ! Error {
    write_window_clipboard(c.state, text)?
}

/// Returns the text on the system clipboard, or `none` when it holds no text.
pub fn read_clipboard(c: Clipboard) -> str? ! Error {
    read_window_clipboard(c.state)?
}

/// Turns text input through the system's input method on, with the caret at `caret`, or off for `none`. Text input starts off; while it is on, an input method can turn keys into `Preedit` and `Commit` events instead of `Key` events. Setting it again moves the caret.
pub fn set_text_input(w: Window, caret: Caret?) {
    set_window_text_input(w.state, caret)
}

/// Shows `c` while the pointer is over `w`'s content.
pub fn set_cursor(w: Window, c: Cursor) {
    set_window_cursor(w.state, c)
}

/// Sets `f`, which the window asks which `WindowControlArea` lies at a point, `x` and `y` logical pixels from the top left of the content, or `none` for plain content. On Windows the answer to each `WM_NCHITTEST` comes from it; the Wayland backend never asks.
///
/// With the system title bar hidden, `f` is asked first and its `Close`, `Max` and `Min` answer their buttons and `Drag` the caption. Elsewhere the resize borders in the invisible frame around the content answer, then the top edge of the content of a restored window, and the rest is content. A click on a `Close`, `Max` or `Min` area closes, toggles the maximised state of or minimises the window when the press and the release both land on it, with no pointer event sent for either.
pub fn set_hit_test(w: Window, f: fn(f32, f32) -> WindowControlArea?) {
    let coded = fn(x: f32, y: f32) -> i64 { area_code(f(x, y)) }
    set_window_hit_test(w.state, coded)
}

const area_none: i64 = 0
const area_drag: i64 = 1
const area_close: i64 = 2
const area_max: i64 = 3
const area_min: i64 = 4

fn area_code(found: WindowControlArea?) -> i64 {
    match found {
        some(area) => match area {
            Drag => area_drag
            Close => area_close
            Max => area_max
            Min => area_min
        }
        none => area_none
    }
}

/// Returns a `Controls` that reaches `w`'s maximise and minimise commands.
pub fn controls(w: Window) -> Controls {
    Controls { state: w.state }
}

/// Returns `true` while the window is maximised.
pub fn is_maximized(c: Controls) -> bool {
    window_maximized(c.state)
}

/// Minimises the window.
pub fn minimize(c: Controls) {
    minimize_window(c.state)
}

/// Maximises the window, or restores it when it is maximised. A `Maximized` event follows.
pub fn toggle_maximize(c: Controls) {
    zoom_window(c.state)
}

/// Returns the handles a renderer needs to draw into `w`.
pub fn native(w: Window) -> Native {
    window_native(w.state)
}

struct ClickCount {
    button: Button? = none
    time: i64 = 0
    x: f32 = 0.0
    y: f32 = 0.0
    count: i64 = 0
}

struct ClickRule {
    interval: i64
    width: f32
    height: f32
}

fn count_press(c: *ClickCount, rule: ClickRule, button: Button, time: i64, x: f32, y: f32) -> i64 {
    let near = apart(x, c.x) <= rule.width && apart(y, c.y) <= rule.height
    let soon = time - c.time < rule.interval
    let same = match c.button {
        some(b) => b == button
        none => false
    }
    c.count = if same && soon && near { c.count + 1 } else { 1 }
    c.button = button
    c.time = time
    c.x = x
    c.y = y
    c.count
}

fn apart(a: f32, b: f32) -> f32 {
    if a > b { a - b } else { b - a }
}
