import std/dbus

const portal_name = "org.freedesktop.portal.Desktop"
const portal_path = "/org/freedesktop/portal/desktop"
const settings_interface = "org.freedesktop.portal.Settings"
const gnome_interface = "org.gnome.desktop.interface"
const call_timeout_ms = 200

fn system_prefers_reduced_motion() -> bool {
    let enabled = animations_enabled() catch {
        e => return false
    }
    !enabled
}

fn animations_enabled() -> bool ! dbus.Error {
    using bus = dbus.connect_session()?
    let ask = dbus.method_call(portal_name, portal_path, settings_interface, "Read", [dbus.Value.String(gnome_interface), dbus.Value.String("enable-animations")])
    let reply = dbus.call_with(bus, ask, dbus.CallOptions { timeout: call_timeout_ms })?
    animations_in(reply)?
}

fn animations_in(reply: dbus.Message) -> bool ! dbus.Error {
    if reply.body.len != 1 {
        fail dbus.Error.Marshal("the settings portal answered with {reply.body.len} values")
    }
    var v = reply.body[0]
    for {
        match v {
            Variant(inner) => { v = *inner }
            _ => break
        }
    }
    dbus.bool_of(v)?
}
