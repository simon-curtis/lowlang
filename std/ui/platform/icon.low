const png_header_bytes: i64 = 24
const ihdr_type: i64 = 12

fn png_signature() -> u8[] {
    [137, 80, 78, 71, 13, 10, 26, 10]
}

fn ihdr_name() -> u8[] {
    [73, 72, 68, 82]
}

fn check_icon(frames: IconFrame[]) ! Error {
    for i, frame in frames {
        match icon_fault(frame) {
            some(reason) => fail BadIcon("icon frame {i}: {reason}")
            none => {}
        }
    }
}

fn icon_fault(frame: IconFrame) -> str? {
    if frame.size <= 0 {
        return some("the size {frame.size} is not positive")
    }
    let data = frame.png
    if data.len < png_header_bytes {
        return some("the PNG is {data.len} bytes, shorter than its header")
    }
    let signature = png_signature()
    for i, expected in signature {
        if data[i] != expected {
            return some("the bytes do not start with the PNG signature")
        }
    }
    let name = ihdr_name()
    for i, expected in name {
        if data[ihdr_type + i] != expected {
            return some("the first PNG chunk is not IHDR")
        }
    }
    let width = png_word(data, 16)
    let height = png_word(data, 20)
    if width != frame.size || height != frame.size {
        return some("the PNG is {width} by {height} pixels, not {frame.size} by {frame.size}")
    }
    none
}

fn png_word(data: str, at: i64) -> i64 {
    (i64(data[at]) << 24) | (i64(data[at + 1]) << 16) | (i64(data[at + 2]) << 8) | i64(data[at + 3])
}

fn pick_icon_frame(frames: IconFrame[], wanted: i64) -> i64 {
    var covering = -1
    var largest = 0
    for i, frame in frames {
        if frame.size > frames[largest].size {
            largest = i
        }
        if frame.size >= wanted && (covering < 0 || frame.size < frames[covering].size) {
            covering = i
        }
    }
    if covering >= 0 {
        return covering
    }
    largest
}
