const scale_unit: i64 = 120
const titlebar_height: i64 = 32
const resize_border: f32 = 5.0

fn attach_scale(s: *WindowState) {
    let d = s.display
    if d.viewporter == null || d.fractional_manager == null {
        return
    }
    s.viewport = wp_viewporter_get_viewport(d.ifs, d.viewporter, s.surface)
    s.fractional = wp_fractional_scale_manager_v1_get_fractional_scale(d.ifs, d.fractional_manager, s.surface)
    wp_fractional_scale_v1_add_listener(d.ifs, s.fractional, WpFractionalScaleV1Listener { preferred_scale: on_fractional_scale }, s.handle)
}

fn detach_scale(s: *WindowState) {
    if s.fractional != null {
        wp_fractional_scale_v1_destroy(s.fractional)
        s.fractional = null
    }
    if s.viewport != null {
        wp_viewport_destroy(s.viewport)
        s.viewport = null
    }
}

fn on_scale(data: ptr, surface: ptr, factor: i32) {
    let s = window_of(data)
    if s.fractional != null {
        return
    }
    let whole = if factor >= 1 { i64(factor) } else { 1 }
    if apply_scale(s, whole * scale_unit) {
        wl_surface_set_buffer_scale(s.surface, i32(whole))
    }
}

fn on_fractional_scale(data: ptr, fractional: ptr, scale: u32) {
    let s = window_of(data)
    apply_scale(s, i64(scale))
}

fn apply_scale(s: *WindowState, scale_120: i64) -> bool {
    let scale = if scale_120 >= 1 { scale_120 } else { scale_unit }
    if scale == s.scale_120 {
        return false
    }
    s.scale_120 = scale
    if s.configured {
        s.events.push(Event.Resized(f32(s.width), f32(s.height), window_scale(s)))
    }
    true
}

fn window_scale(s: *WindowState) -> f32 {
    f32(s.scale_120) / f32(scale_unit)
}

fn place_viewport(s: *WindowState) {
    if s.viewport != null {
        wp_viewport_set_destination(s.viewport, i32(s.width), i32(s.height))
    }
}

fn attach_decoration(s: *WindowState, o: Options) {
    let d = s.display
    s.own_titlebar = o.titlebar.appears_transparent
    if d.decoration_manager == null {
        return
    }
    s.decoration = zxdg_decoration_manager_v1_get_toplevel_decoration(d.ifs, d.decoration_manager, s.toplevel)
    let _ = zxdg_toplevel_decoration_v1_add_listener(d.ifs, s.decoration, ZxdgToplevelDecorationV1Listener { configure: on_decoration_mode }, s.handle)
    let wanted = if s.own_titlebar { zxdg_toplevel_decoration_v1_mode_client_side } else { zxdg_toplevel_decoration_v1_mode_server_side }
    zxdg_toplevel_decoration_v1_set_mode(s.decoration, wanted)
}

fn detach_decoration(s: *WindowState) {
    if s.decoration != null {
        zxdg_toplevel_decoration_v1_destroy(s.decoration)
        s.decoration = null
    }
}

fn on_decoration_mode(data: ptr, decoration: ptr, mode: u32) {
    let s = window_of(data)
    s.server_side = mode == zxdg_toplevel_decoration_v1_mode_server_side
}

fn client_drawn(s: *WindowState) -> bool {
    !s.server_side
}

fn bar_height(s: *WindowState) -> i64 {
    if client_drawn(s) && !s.own_titlebar {
        return titlebar_height
    }
    0
}

fn window_decoration_height(s: *WindowState) -> f32 {
    f32(s.bar)
}

fn resize_edge(s: *WindowState, x: f32, y: f32) -> u32 {
    if !client_drawn(s) || s.maximized {
        return xdg_toplevel_resize_edge_none
    }
    var edge = xdg_toplevel_resize_edge_none
    if x < resize_border {
        edge |= xdg_toplevel_resize_edge_left
    } else if x >= f32(s.width) - resize_border {
        edge |= xdg_toplevel_resize_edge_right
    }
    if y < resize_border {
        edge |= xdg_toplevel_resize_edge_top
    } else if y >= f32(s.height) - resize_border {
        edge |= xdg_toplevel_resize_edge_bottom
    }
    edge
}

fn edge_cursor(edge: u32) -> Cursor? {
    match edge {
        xdg_toplevel_resize_edge_left => some(Cursor.ResizeLeftRight)
        xdg_toplevel_resize_edge_right => some(Cursor.ResizeLeftRight)
        xdg_toplevel_resize_edge_top => some(Cursor.ResizeUpDown)
        xdg_toplevel_resize_edge_bottom => some(Cursor.ResizeUpDown)
        xdg_toplevel_resize_edge_top_left => some(Cursor.ResizeUpLeftDownRight)
        xdg_toplevel_resize_edge_bottom_right => some(Cursor.ResizeUpLeftDownRight)
        xdg_toplevel_resize_edge_top_right => some(Cursor.ResizeUpRightDownLeft)
        xdg_toplevel_resize_edge_bottom_left => some(Cursor.ResizeUpRightDownLeft)
        _ => none
    }
}

fn shown_cursor(s: *WindowState) -> Cursor {
    edge_cursor(s.edge) ?? s.cursor
}

fn track_edge(d: *DisplayState, s: *WindowState) {
    let edge = resize_edge(s, d.pointer_x, d.pointer_y)
    if edge == s.edge {
        return
    }
    s.edge = edge
    if show_cursor(d) {
        wl_display_flush(d.display)
    }
}

fn set_window_hit_test(s: *WindowState, f: fn(f32, f32) -> i64) {
    s.hit_test = f
}

fn no_control(x: f32, y: f32) -> i64 {
    area_none
}

fn begin_frame_press(d: *DisplayState, s: *WindowState, serial: u32, time: u32) -> bool {
    if s.edge != xdg_toplevel_resize_edge_none {
        xdg_toplevel_resize(s.toplevel, d.seat, serial, s.edge)
        let _ = wl_display_flush(d.display)
        return true
    }
    let area = s.hit_test(d.pointer_x, d.pointer_y)
    if area == area_none {
        return false
    }
    if area != area_drag {
        s.armed_area = area
        return true
    }
    let clicks = count_press(d.clicks, wayland_click_rule(), Button.Left, i64(time), d.pointer_x, d.pointer_y)
    if clicks == 2 {
        zoom_window(s)
    } else {
        xdg_toplevel_move(s.toplevel, d.seat, serial)
        wl_display_flush(d.display)
    }
    true
}

fn end_frame_press(d: *DisplayState, s: *WindowState) -> bool {
    let armed = s.armed_area
    if armed == area_none {
        return false
    }
    s.armed_area = area_none
    if s.hit_test(d.pointer_x, d.pointer_y) != armed {
        return true
    }
    match armed {
        area_close => s.events.push(Event.CloseRequested)
        area_max => zoom_window(s)
        area_min => minimize_window(s)
        _ => {}
    }
    true
}
