import std/image
import std/testing

fn frame_of(size: i64) -> IconFrame {
    let picture = image.create(size, size, image.Format.Rgba8)
    IconFrame { size, png: str(image.encode_png(picture)) }
}

fn frames_of(sizes: i64[]) -> IconFrame[] {
    var frames: IconFrame[] = []
    for size in sizes {
        frames.push(frame_of(size))
    }
    frames
}

fn failure_of(frames: IconFrame[]) -> str {
    check_icon(frames) catch {
        BadIcon(detail) => return detail
        e => return "{e}"
    }
    ""
}

fn test_the_smallest_frame_that_covers_the_size_is_picked(t: *testing.T) {
    let frames = frames_of([16, 32, 48, 256])
    t.equal(pick_icon_frame(frames, 16), 0)
    t.equal(pick_icon_frame(frames, 17), 1)
    t.equal(pick_icon_frame(frames, 32), 1)
    t.equal(pick_icon_frame(frames, 40), 2)
    t.equal(pick_icon_frame(frames, 64), 3)
}

fn test_the_biggest_frame_is_picked_when_none_covers_the_size(t: *testing.T) {
    let frames = frames_of([16, 48, 32])
    t.equal(pick_icon_frame(frames, 64), 1)
}

fn test_frames_in_any_order_pick_the_same_size(t: *testing.T) {
    let frames = frames_of([256, 16, 48, 32])
    t.equal(frames[pick_icon_frame(frames, 20)].size, 32)
    t.equal(frames[pick_icon_frame(frames, 33)].size, 48)
    t.equal(frames[pick_icon_frame(frames, 300)].size, 256)
}

fn test_a_single_frame_is_picked_at_every_size(t: *testing.T) {
    let frames = frames_of([32])
    t.equal(pick_icon_frame(frames, 16), 0)
    t.equal(pick_icon_frame(frames, 256), 0)
}

fn test_the_first_of_two_frames_of_one_size_is_picked(t: *testing.T) {
    let frames = frames_of([32, 32])
    t.equal(pick_icon_frame(frames, 24), 0)
    t.equal(pick_icon_frame(frames, 64), 0)
}

fn test_frames_that_state_their_size_are_accepted(t: *testing.T) {
    t.equal(failure_of(frames_of([16, 32, 256])), "")
}

fn test_no_frames_are_accepted(t: *testing.T) {
    t.equal(failure_of([]), "")
}

fn test_bytes_that_are_not_a_png_are_refused(t: *testing.T) {
    let frame = IconFrame { size: 32, png: "this is not a picture at all, it is text" }
    t.equal(failure_of([frame]), "icon frame 0: the bytes do not start with the PNG signature")
}

fn test_a_png_cut_short_of_its_header_is_refused(t: *testing.T) {
    let whole = frame_of(32)
    let cut = IconFrame { size: 32, png: whole.png[0..20] }
    t.equal(failure_of([cut]), "icon frame 0: the PNG is 20 bytes, shorter than its header")
}

fn test_empty_bytes_are_refused(t: *testing.T) {
    t.equal(failure_of([IconFrame { size: 16, png: "" }]), "icon frame 0: the PNG is 0 bytes, shorter than its header")
}

fn test_a_png_of_another_size_than_stated_is_refused(t: *testing.T) {
    let frame = IconFrame { size: 32, png: frame_of(16).png }
    t.equal(failure_of([frame]), "icon frame 0: the PNG is 16 by 16 pixels, not 32 by 32")
}

fn test_a_png_that_is_not_square_is_refused(t: *testing.T) {
    let wide = image.create(32, 16, image.Format.Rgba8)
    let frame = IconFrame { size: 32, png: str(image.encode_png(wide)) }
    t.equal(failure_of([frame]), "icon frame 0: the PNG is 32 by 16 pixels, not 32 by 32")
}

fn test_a_size_that_is_not_positive_is_refused(t: *testing.T) {
    let frame = IconFrame { size: 0, png: frame_of(16).png }
    t.equal(failure_of([frame]), "icon frame 0: the size 0 is not positive")
}

fn test_the_failure_names_the_first_bad_frame(t: *testing.T) {
    let bad = IconFrame { size: 32, png: "not a png, but long enough to hold a header" }
    t.equal(failure_of([frame_of(16), bad, frame_of(48)]), "icon frame 1: the bytes do not start with the PNG signature")
}

fn test_a_signature_without_a_header_chunk_is_refused(t: *testing.T) {
    let whole = frame_of(16).png
    let broken = "{whole[0..12]}JUNK{whole[16..whole.len]}"
    t.equal(failure_of([IconFrame { size: 16, png: broken }]), "icon frame 0: the first PNG chunk is not IHDR")
}
