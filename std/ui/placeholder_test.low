import std/testing
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn hinted(value: Signal[str], tint: geometry.Color?) -> fn() -> Element {
    fn() -> Element {
        let base = field(get(value)).id("name").width(150.0).height(30.0).placeholder("Type here").on_change(fn(s: str) { set(value, s) })
        match tint {
            some(c) => column(div()).children() { base.placeholder_color(c), div().height(40.0) }
            none => column(div()).children() { base, div().height(40.0) }
        }
    }
}

fn focus_hinted(cx: Context, view: fn() -> Element) {
    shot(cx, view)
    click(cx, 149.0, 5.0)
}

fn ink_is(s: scene.Sprite, expected: geometry.Color) -> bool {
    gap_between(s.color.r, expected.r) < 0.001 && gap_between(s.color.g, expected.g) < 0.001 && gap_between(s.color.b, expected.b) < 0.001 && gap_between(s.color.a, expected.a) < 0.001
}

fn all_ink(sprites: scene.Sprite[], expected: geometry.Color) -> bool {
    for s in sprites {
        if !ink_is(s, expected) {
            return false
        }
    }
    true
}

fn dim() -> geometry.Color {
    geometry.rgba(0x00000033)
}

fn hint_type(cx: Context, s: str) {
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn test_an_empty_unfocused_field_paints_its_placeholder_in_the_default_colour(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "")
    let s = shot(cx, hinted(value, none))
    testing.is_true(t, s.sprites.len > 0)
    testing.is_true(t, all_ink(s.sprites, dim()))
    testing.equal(t, s.quads.len, 0)
}

fn tallest(sprites: scene.Sprite[]) -> f32 {
    var high: f32 = 0.0
    for s in sprites {
        if s.bounds.height > high {
            high = s.bounds.height
        }
    }
    high
}

fn test_the_placeholder_takes_the_field_text_size(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let small = fn() -> Element { field("").width(300.0).height(60.0).placeholder("Type here") }
    let large = fn() -> Element { field("").width(300.0).height(60.0).text_size(32.0).placeholder("Type here") }
    let low = tallest(shot(cx, small).sprites)
    let high = tallest(shot(cx, large).sprites)
    testing.is_true(t, low > 0.0)
    testing.is_true(t, high > low * 1.5)
}

fn test_the_text_color_leaves_the_placeholder_colour_alone(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { field("").width(150.0).height(30.0).text_color(rgb(0xffffff)).placeholder("Type here") }
    let s = shot(cx, view)
    testing.is_true(t, s.sprites.len > 0)
    testing.is_true(t, all_ink(s.sprites, dim()))
}

fn test_a_field_holding_only_a_space_shows_no_placeholder(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { field(" ").width(150.0).height(30.0).placeholder("Type here") }
    testing.equal(t, shot(cx, view).sprites.len, 0)
}

fn test_a_placeholder_drops_control_characters_as_field_text_does(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let plain = fn() -> Element { field("").width(300.0).height(30.0).placeholder("ab") }
    let tabbed = fn() -> Element { field("").width(300.0).height(30.0).placeholder("a\tb") }
    let a = shot(cx, plain).sprites
    let b = shot(cx, tabbed).sprites
    testing.equal(t, b.len, a.len)
    testing.equal(t, b[b.len - 1].bounds.x, a[a.len - 1].bounds.x)
}

fn test_a_field_without_a_placeholder_paints_nothing_when_empty(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { field("").width(150.0).height(30.0) }
    testing.equal(t, shot(cx, view).sprites.len, 0)
}

fn test_typing_replaces_the_placeholder_with_the_text_colour(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "")
    let view = hinted(value, none)
    let before = shot(cx, view)
    click(cx, 149.0, 5.0)
    hint_type(cx, "a")
    let after = shot(cx, view)
    testing.equal(t, get(value), "a")
    testing.equal(t, after.sprites.len, 1)
    testing.is_true(t, all_ink(after.sprites, geometry.rgba(0x000000ff)))
    testing.is_true(t, before.sprites.len > after.sprites.len)
}

fn test_deleting_the_text_brings_the_placeholder_back(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "")
    let view = hinted(value, none)
    focus_hinted(cx, view)
    hint_type(cx, "a")
    shot(cx, view)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Backspace) }))
    let after = shot(cx, view)
    testing.equal(t, get(value), "")
    testing.is_true(t, after.sprites.len > 1)
    testing.is_true(t, all_ink(after.sprites, dim()))
}

fn test_a_composition_hides_the_placeholder(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "")
    let view = hinted(value, none)
    focus_hinted(cx, view)
    let empty = shot(cx, view)
    testing.is_true(t, all_ink(empty.sprites, dim()))
    dispatch(cx, platform.Event.Preedit("ni", platform.TextRange { start: 0, end: 2 }))
    let composing = shot(cx, view)
    testing.equal(t, composing.sprites.len, 2)
    testing.is_true(t, all_ink(composing.sprites, geometry.rgba(0x000000ff)))
    dispatch(cx, platform.Event.Preedit("", none))
    testing.is_true(t, all_ink(shot(cx, view).sprites, dim()))
    testing.equal(t, get(value), "")
}

fn test_placeholder_color_overrides_the_default(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "")
    let tint = geometry.rgba(0xff8000b3)
    let s = shot(cx, hinted(value, tint))
    testing.is_true(t, s.sprites.len > 0)
    testing.is_true(t, all_ink(s.sprites, tint))
}

fn test_element_opacity_multiplies_the_placeholder_alpha(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { field("").width(150.0).height(30.0).placeholder("Type here").opacity(0.5) }
    let s = shot(cx, view)
    testing.is_true(t, s.sprites.len > 0)
    testing.is_true(t, all_ink(s.sprites, geometry.Color { a: dim().a * 0.5 }))
    let tinted = fn() -> Element { field("").width(150.0).height(30.0).placeholder("Type here").placeholder_color(geometry.rgba(0x000000ff)).opacity(0.25) }
    testing.is_true(t, all_ink(shot(cx, tinted).sprites, geometry.Color { a: 0.25 }))
}

fn test_the_caret_of_a_focused_empty_field_is_at_the_content_origin(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "")
    let view = hinted(value, none)
    focus_hinted(cx, view)
    let s = shot(cx, view)
    testing.equal(t, s.quads.len, 1)
    testing.equal(t, s.quads[0].bounds.x, 0.0)
    testing.equal(t, s.quads[0].bounds.width, 1.0)
    testing.equal(t, (text_input(cx) ?? platform.Caret {}).x, 0)
    testing.is_true(t, s.sprites.len > 0)
    testing.is_true(t, all_ink(s.sprites, dim()))
}

fn test_the_placeholder_starts_at_the_padded_content_origin_and_is_clipped(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let narrow = fn() -> Element { field("").width(40.0).height(30.0).padding(10.0).placeholder("A placeholder far wider than the box") }
    let s = shot(cx, narrow)
    testing.is_true(t, s.sprites.len > 0)
    testing.is_true(t, s.sprites[0].bounds.x >= 10.0)
    testing.is_true(t, s.sprites[0].bounds.x < 14.0)
    for sprite in s.sprites {
        testing.equal(t, sprite.clip.x, 10.0)
        testing.equal(t, sprite.clip.width, 20.0)
    }
}

fn test_the_placeholder_does_not_change_the_text_or_the_layout(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "")
    let calls = signal(cx, 0)
    let marker = geometry.rgba(0xff0000ff)
    let plain = fn() -> Element {
        column(div()).children() { field("").id("p").text_size(30.0), div().height(10.0).background(marker) }
    }
    let hinted_view = fn() -> Element {
        column(div()).children() {
            field("").id("p").text_size(30.0).placeholder("A placeholder much longer than the field").on_change(fn(s: str) { set(calls, get(calls) + 1) }),
            div().height(10.0).background(marker),
        }
    }
    let bare = shot(cx, plain).quads[0].bounds
    let boxed = shot(cx, hinted_view).quads[0].bounds
    testing.equal(t, boxed.y, bare.y)
    testing.equal(t, boxed.height, bare.height)
    testing.equal(t, get(calls), 0)
    let editable = hinted(value, none)
    shot(cx, editable)
    click(cx, 120.0, 5.0)
    hint_type(cx, "x")
    testing.equal(t, get(value), "x")
}
