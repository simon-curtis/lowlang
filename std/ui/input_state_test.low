import std/testing
import std/ui/platform

fn name_field(value: Signal[str]) -> fn() -> Element {
    fn() -> Element {
        column(div()).children() {
            field_signal(value).id("name").width(150.0).height(30.0),
            div().height(40.0),
        }
    }
}

fn enter_text(cx: Context, s: str) {
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn press_arrow(cx: Context, n: platform.NamedKey) {
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(n) }))
}

fn focused_name(cx: Context, initial: str) -> Signal[str] {
    let value = signal(cx, initial)
    shot(cx, name_field(value))
    click(cx, 149.0, 5.0)
    value
}

fn test_field_signal_keeps_the_text_in_the_signal(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_name(cx, "ab")
    enter_text(cx, "c")
    testing.equal(t, get(value), "abc")
    set(value, "xy")
    shot(cx, name_field(value))
    var shown = ""
    for info in elements(cx) {
        if info.id == "name" {
            shown = info.text
        }
    }
    testing.equal(t, shown, "xy")
}

fn test_an_effect_reading_the_field_selection_runs_when_the_caret_moves(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_name(cx, "abc")
    let runs = signal(cx, 0)
    let watch = effect(cx, fn() {
        field_selection(cx, "name")
        set(runs, untracked(cx, fn() -> i64 { get(runs) }) + 1)
    })
    let first = get(runs)
    press_arrow(cx, platform.NamedKey.Left)
    testing.equal(t, get(runs), first + 1)
    press_arrow(cx, platform.NamedKey.Right)
    testing.equal(t, get(runs), first + 2)
    dispatch(cx, platform.Event.PointerMoved(300.0, 90.0))
    testing.equal(t, get(runs), first + 2)
    set_field_selection(cx, "name", 0, 1)
    testing.equal(t, get(runs), first + 3)
    dispose(watch)
    press_arrow(cx, platform.NamedKey.Right)
    testing.equal(t, get(runs), first + 3)
    testing.equal(t, get(value), "abc")
}

fn test_an_effect_reading_the_field_selection_runs_when_a_composition_starts(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    focused_name(cx, "abc")
    let runs = signal(cx, 0)
    effect(cx, fn() {
        field_selection(cx, "name")
        set(runs, untracked(cx, fn() -> i64 { get(runs) }) + 1)
    })
    let first = get(runs)
    dispatch(cx, platform.Event.Preedit("に", none))
    testing.equal(t, get(runs), first + 1)
    dispatch(cx, platform.Event.Preedit("に", none))
    testing.equal(t, get(runs), first + 1)
}

fn test_a_memo_over_the_field_selection_cuts_off_an_unchanged_caret(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    focused_name(cx, "abc")
    let at_end = memo(cx, fn() -> bool { field_selection(cx, "name").caret == 3 })
    let runs = signal(cx, 0)
    effect(cx, fn() {
        read(at_end)
        set(runs, untracked(cx, fn() -> i64 { get(runs) }) + 1)
    })
    let first = get(runs)
    caret_left(cx)
    testing.equal(t, get(runs), first + 1)
    caret_left(cx)
    testing.equal(t, get(runs), first + 1)
}

fn caret_left(cx: Context) {
    press_arrow(cx, platform.NamedKey.Left)
}

fn test_an_effect_reading_a_text_area_selection_runs_when_it_changes(t: *testing.T) {
    let r = ta_open("one\ntwo")
    let runs = signal(r.cx, 0)
    effect(r.cx, fn() {
        text_area_selections(r.cx, "area")
        set(runs, untracked(r.cx, fn() -> i64 { get(runs) }) + 1)
    })
    let first = get(runs)
    ta_press(r, platform.NamedKey.Right)
    testing.equal(t, get(runs), first + 1)
    ta_press(r, platform.NamedKey.Right)
    testing.equal(t, get(runs), first + 2)
    ta_frame(r)
    testing.equal(t, get(runs), first + 2)
    ta_type(r, "x")
    testing.equal(t, get(runs), first + 3)
}
