import strs = std/text
import std/ui/geometry
import std/ui/platform

/// What an element is for, as a script or an assistive technology names it.
pub enum Role {
    /// An element with no other role.
    Generic
    /// Something that is pressed to act.
    Button
    /// Something that is pressed to go elsewhere.
    Link
    /// A title that heads a part of the interface.
    Heading
    /// A run of text.
    Text
    /// A `field` or a `text_area`.
    TextInput
    /// A picture or an icon.
    Image
    /// A box that is ticked or not.
    Checkbox
    /// A `uniform_list` or a `list`.
    List
    /// One item of a list.
    ListItem
    /// One of a set of tabs.
    Tab
    /// A menu of commands.
    Menu
    /// One command of a menu.
    MenuItem
    /// A window drawn inside the window.
    Dialog
}

/// One element that the last frame drew.
pub struct ElementInfo {
    /// The element's key, its id or its position in the tree such as `"0/1"`, which `bounds_of`, `focused`, `set_focus` and `click_element` take.
    pub key: str = ""
    /// The element's `id`, or empty.
    pub id: str = ""
    /// The name `label` gave the element. Without one, the text of a text run, and for an element with a click handler or focus the text of the text runs inside it, joined by spaces. Otherwise empty.
    pub label: str = ""
    /// The role `role` gave the element, or the one its kind implies: `Text`, `TextInput`, `Image` for a picture, an icon or a `canvas`, or `List`, `Button` for an element with a click handler, else `Generic`.
    pub role: Role = Role.Generic
    /// The text a text run or a `field` shows, which is empty for a `masked` field, a `text_area` and every other element.
    pub text: str = ""
    /// The element's border box in logical pixels from the top left of the window, before any clipping.
    pub bounds: geometry.Rect = geometry.Rect {}
    /// `false` when the element or one it sits in is `invisible`, when it is clipped away entirely, or when an element drawn after it that is not inside it takes the pointer at the centre of its visible part, as an overlay does.
    pub visible: bool = true
    /// `true` for the element that `focused` names.
    pub focused: bool = false
}

struct Drawn {
    key: str
    id: str
    label: str
    role: Role
    text: str
    bounds: geometry.Rect
    clip: geometry.Rect
    hidden: bool
    anchor: i64
    later: i64
}

/// Returns `e` named `name` for scripts and assistive technology, which find it by `ElementInfo.label`. It is recorded for `elements` and `bounds_of` even with no id or handler.
pub fn label(e: Element, name: str) -> Element {
    var extras = extras_of(e)
    extras.label = name
    var out = e
    out.extras = new(extras)
    out
}

/// Returns `e` with the role `r`, which `ElementInfo.role` reports in place of the one its kind implies. It is recorded for `elements` and `bounds_of` even with no id or handler.
pub fn role(e: Element, r: Role) -> Element {
    var extras = extras_of(e)
    extras.role = some(r)
    var out = e
    out.extras = new(extras)
    out
}

/// Returns every element the last frame drew that has an id, a handler, a label or a role, and every text run, field, text area, picture, icon, canvas and list, in paint order. A tree being built reads the frame before.
pub fn elements(cx: Context) -> ElementInfo[] {
    let st = cx.state
    var out: ElementInfo[] = []
    for d in st.drawn {
        out.push(info_of(st, d))
    }
    out
}

/// Returns the key of the topmost element at `at`, logical pixels from the top left of the window, that a click there would reach, or `none` when it reaches none. Only elements with a handler, focus, an id on a scrolling element or another hitbox take the pointer, so a text run answers with the element that holds it.
pub fn element_at(cx: Context, at: geometry.Point) -> str? {
    let st = cx.state
    let i = topmost_at(st, at)
    if i < 0 {
        return none
    }
    some(st.hitboxes[i].key)
}

/// Moves the pointer to the centre of the visible part of the element whose key is `key`, and presses and releases the left button there, as `dispatch` would for a user's click. Returns `false` without sending anything when the last frame drew no such element or none of it is in view.
pub fn click_element(cx: Context, key: str) -> bool {
    let st = cx.state
    for d in st.drawn {
        if d.key == key {
            let seen = geometry.intersect(d.bounds, d.clip)
            if geometry.is_empty(seen) {
                return false
            }
            let x = seen.x + seen.width / 2.0
            let y = seen.y + seen.height / 2.0
            let press = platform.ButtonEvent { button: platform.Button.Left, x, y }
            dispatch(cx, platform.Event.PointerMoved(x, y))
            dispatch(cx, platform.Event.PointerDown(press))
            dispatch(cx, platform.Event.PointerUp(press))
            return true
        }
    }
    false
}

fn annotated(e: Element) -> bool {
    let extras = extras_of(e)
    extras.label != "" || extras.role != none
}

fn lists_itself(e: Element) -> bool {
    annotated(e) || e.id != "" || interactive(e) || is_text(e) || is_field(e) || is_text_area(e) || is_picture(e) || is_icon(e) || is_canvas(e) || is_virtual(e)
}

fn is_canvas(e: Element) -> bool {
    extras_of(e).drawing != none
}

fn text_of(e: Element) -> str {
    if is_text(e) || (is_field(e) && !e.masked) {
        return e.content
    }
    ""
}

fn has_click(e: Element) -> bool {
    for l in e.listeners {
        match l {
            Click(_) => return true
            _ => {}
        }
    }
    false
}

fn role_of(e: Element) -> Role {
    match extras_of(e).role {
        some(r) => return r
        none => {}
    }
    if is_text(e) {
        return Role.Text
    }
    if is_field(e) || is_text_area(e) {
        return Role.TextInput
    }
    if is_picture(e) || is_icon(e) || is_canvas(e) {
        return Role.Image
    }
    if is_virtual(e) {
        return Role.List
    }
    if has_click(e) {
        return Role.Button
    }
    Role.Generic
}

fn text_inside(e: Element, mut out: str[]) {
    if is_text(e) {
        out.push(e.content)
        return
    }
    for c in e.children {
        text_inside(c, mut out)
    }
}

fn label_of(e: Element) -> str {
    let name = extras_of(e).label
    if name != "" {
        return name
    }
    if is_text(e) {
        return e.content
    }
    if !has_click(e) && !e.focusable {
        return ""
    }
    var parts: str[] = []
    text_inside(e, mut parts)
    strs.join(parts, " ")
}

fn record_drawn(st: *State, e: Element, key: str, rect: geometry.Rect, w: Walk, hitbox: i64) {
    if !lists_itself(e) {
        return
    }
    let anchor = if hitbox >= 0 { hitbox } else { w.parent }
    st.drawn.push(Drawn {
        key
        id: e.id
        label: label_of(e)
        role: role_of(e)
        text: text_of(e)
        bounds: rect
        clip: w.clip
        hidden: w.hidden || !e.visual.visible
        anchor
        later: st.hitboxes.len
    })
}

fn info_of(st: *State, d: Drawn) -> ElementInfo {
    ElementInfo {
        key: d.key
        id: d.id
        label: d.label
        role: d.role
        text: d.text
        bounds: d.bounds
        visible: drawn_visible(st, d)
        focused: st.focus != "" && d.key == st.focus
    }
}

fn drawn_visible(st: *State, d: Drawn) -> bool {
    if d.hidden || (d.anchor >= 0 && st.hitboxes[d.anchor].hidden) {
        return false
    }
    let seen = geometry.intersect(d.bounds, d.clip)
    if geometry.is_empty(seen) {
        return false
    }
    let top = topmost_at(st, geometry.point(seen.x + seen.width / 2.0, seen.y + seen.height / 2.0))
    top < d.later || inside_hitbox(st, top, d.anchor)
}

fn inside_hitbox(st: *State, at: i64, outer: i64) -> bool {
    var i = at
    for i >= 0 {
        if i == outer {
            return true
        }
        i = st.hitboxes[i].parent
    }
    false
}

fn topmost_at(st: *State, at: geometry.Point) -> i64 {
    var i = st.hitboxes.len - 1
    for i >= 0 && (st.hitboxes[i].hidden || !geometry.contains(st.hitboxes[i].bounds, at)) {
        i -= 1
    }
    i
}
