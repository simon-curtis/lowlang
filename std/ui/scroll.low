import std/math
import std/ui/geometry
import std/ui/scene

/// How large a scrolling element's viewport and content were in the last frame, in logical pixels.
pub struct ScrollMetrics {
    /// The size of the viewport: the element's box inside its border and padding.
    pub viewport: geometry.Size = geometry.Size {}
    /// The size of everything the element contains, which is the viewport on an axis where nothing overflows. The farthest `scroll_offset` on an axis is `content` less `viewport` there.
    pub content: geometry.Size = geometry.Size {}
}

/// How `scrollbar` draws a bar.
pub struct ScrollbarOptions {
    /// The thickness of the bar, in logical pixels.
    pub width: f32 = 10.0
    /// The shortest the thumb gets, however much the element holds, in logical pixels.
    pub min_thumb: f32 = 24.0
    /// The colour of the groove the thumb moves in.
    pub track: geometry.Color = geometry.Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
    /// The colour of the thumb.
    pub thumb: geometry.Color = geometry.rgba(0x00000066)
    /// The colour of the thumb while the pointer is over it or it is being dragged.
    pub hot: geometry.Color = geometry.rgba(0x00000099)
    /// `true` draws the bar only while the pointer is over the element or the thumb is being dragged.
    pub autohide: bool = false
}

struct BarDrag {
    key: str
    vertical: bool
    grab: f32
}

struct Bar {
    vertical: bool
    track: geometry.Rect
    thumb: geometry.Rect
    free: f32
    reach: f32
}

/// Returns the metrics of the scrolling element whose key is `key`, its id or its position in the tree such as `"0/1"`, as of the last frame, or `none` when the last frame drew no scrolling element under that key. A `uniform_list` and a `list` report like any scrolling element. Called while a tree is being built it describes the frame before.
pub fn scroll_metrics(cx: Context, key: str) -> ScrollMetrics? {
    cx.state.extents[key]
}

/// Returns `e` drawing a bar along each edge on which it scrolls and overflows: a groove and a thumb whose length is the share of the content the viewport shows and whose place follows `scroll_offset`. Pressing the thumb drags it, pressing the groove moves the content by one viewport toward the press, and the wheel scrolls as on any scrolling element. The bar sits over the element's padding box, so it covers content unless the element pads its scrolling edge by `o.width`. An element that does not scroll, and a bar on an axis with nothing to scroll, draw nothing.
pub fn scrollbar(e: Element, o: ScrollbarOptions) -> Element {
    var out = e
    out.scrollbar = some(o)
    out
}

fn record_scroll_metrics(st: *State, key: str, viewport: geometry.Size, range: geometry.Point) {
    let content = geometry.size(viewport.width + range.x, viewport.height + range.y)
    st.extents[key] = ScrollMetrics { viewport, content }
}

fn viewport_of(h: Hitbox) -> geometry.Size {
    let s = h.element.style
    let width = h.rect.width - geometry.horizontal(s.border) - geometry.horizontal(s.padding)
    let height = h.rect.height - geometry.vertical(s.border) - geometry.vertical(s.padding)
    geometry.size(larger(width, 0.0), larger(height, 0.0))
}

fn bar_axis(track: geometry.Rect, vertical: bool, viewport: f32, range: f32, offset: f32, o: ScrollbarOptions) -> Bar {
    let length = if vertical { track.height } else { track.width }
    let share = viewport / (viewport + range)
    let thumb = math.clamp(length * share, math.min(o.min_thumb, length), length)
    let free = length - thumb
    let along = if range > 0.0 { math.clamp(offset / range, 0.0, 1.0) * free } else { 0.0 }
    let rect = if vertical {
        geometry.rect(track.x, track.y + along, track.width, thumb)
    } else {
        geometry.rect(track.x + along, track.y, thumb, track.height)
    }
    Bar { vertical, track, thumb: rect, free, reach: range }
}

fn bars_of(h: Hitbox, o: ScrollbarOptions) -> Bar[] {
    var bars: Bar[] = []
    let s = h.element.style
    let padding_box = geometry.inset(h.rect, s.border)
    let view = viewport_of(h)
    let down = s.overflow_y == Scroll && h.scroll_max.y > 0.0
    let across = s.overflow_x == Scroll && h.scroll_max.x > 0.0
    let corner = if down && across { o.width } else { 0.0 }
    if down {
        let track = geometry.rect(padding_box.x + padding_box.width - o.width, padding_box.y, o.width, padding_box.height - corner)
        bars.push(bar_axis(track, true, view.height, h.scroll_max.y, h.offset.y, o))
    }
    if across {
        let track = geometry.rect(padding_box.x, padding_box.y + padding_box.height - o.width, padding_box.width - corner, o.width)
        bars.push(bar_axis(track, false, view.width, h.scroll_max.x, h.offset.x, o))
    }
    bars
}

fn bars_shown(st: *State, at: i64) -> Bar[] {
    let h = st.hitboxes[at]
    let o = h.element.scrollbar ?? return []
    if o.autohide && !st.hits[at] && !bar_dragging(st, h.key) {
        return []
    }
    bars_of(h, o)
}

fn bar_dragging(st: *State, key: str) -> bool {
    match st.bar_drag {
        some(d) => d.key == key
        none => false
    }
}

fn pointer_on(st: *State, r: geometry.Rect) -> bool {
    st.pointer_inside && geometry.contains(r, st.pointer)
}

fn paint_bars(st: *State, mut sc: scene.Scene, at: i64, opacity: f32, scale: f32) {
    let o = st.hitboxes[at].element.scrollbar ?? return
    for b in bars_shown(st, at) {
        paint_bar_part(mut sc, b.track, o.track, opacity, scale)
        let held = match st.bar_drag {
            some(d) => d.key == st.hitboxes[at].key && d.vertical == b.vertical
            none => false
        }
        let colour = if held || pointer_on(st, b.thumb) { o.hot } else { o.thumb }
        paint_bar_part(mut sc, b.thumb, colour, opacity, scale)
    }
}

fn paint_bar_part(mut sc: scene.Scene, r: geometry.Rect, colour: geometry.Color, opacity: f32, scale: f32) {
    if colour.a <= 0.0 || r.width <= 0.0 || r.height <= 0.0 {
        return
    }
    let radius = math.min(r.width, r.height) / 2.0
    scene.push_quad(mut sc, scene.Quad {
        bounds: geometry.snap(r, scale)
        background: faded(colour, opacity)
        border_color: geometry.Color { r: colour.r, g: colour.g, b: colour.b, a: 0.0 }
        corner_radii: geometry.scale_corners(geometry.corners(radius), scale)
    })
}

fn bar_press(st: *State) -> bool {
    var i = topmost(st)
    for i >= 0 {
        for b in bars_shown(st, i) {
            if pointer_on(st, b.track) {
                press_bar(st, i, b)
                return true
            }
        }
        i = ancestor_hit(st, st.hitboxes[i].parent)
    }
    false
}

fn press_bar(st: *State, at: i64, b: Bar) {
    let key = st.hitboxes[at].key
    let from = if b.vertical { b.thumb.y } else { b.thumb.x }
    let pointer = if b.vertical { st.pointer.y } else { st.pointer.x }
    if pointer_on(st, b.thumb) {
        st.bar_drag = some(BarDrag { key, vertical: b.vertical, grab: pointer - from })
        st.dirty = true
        return
    }
    let view = viewport_of(st.hitboxes[at])
    let page = if b.vertical { view.height } else { view.width }
    let h = st.hitboxes[at]
    let current = if b.vertical { h.offset.y } else { h.offset.x }
    let step = if pointer < from { -page } else { page }
    move_scroll(st, at, b.vertical, current + step)
}

fn bar_drag_move(st: *State) {
    let d = st.bar_drag ?? return
    let at = find(st, d.key)
    if at < 0 {
        return
    }
    let h = st.hitboxes[at]
    let o = h.element.scrollbar ?? return
    for b in bars_of(h, o) {
        if b.vertical == d.vertical && b.free > 0.0 {
            let track_start = if b.vertical { b.track.y } else { b.track.x }
            let pointer = if b.vertical { st.pointer.y } else { st.pointer.x }
            let share = (pointer - d.grab - track_start) / b.free
            move_scroll(st, at, b.vertical, math.clamp(share, 0.0, 1.0) * b.reach)
        }
    }
}

fn move_scroll(st: *State, at: i64, vertical: bool, wanted: f32) {
    let h = st.hitboxes[at]
    let limit = if vertical { h.scroll_max.y } else { h.scroll_max.x }
    let target = math.clamp(wanted, 0.0, limit)
    let moved = if vertical { geometry.point(h.offset.x, target) } else { geometry.point(target, h.offset.y) }
    if moved.x == h.offset.x && moved.y == h.offset.y {
        return
    }
    match variable_list(h.element) {
        some(state) => list_scroll_by(state, moved.y - h.offset.y)
        none => {
            st.scroll[h.key] = moved
        }
    }
    st.hitboxes[at].offset = moved
    st.dirty = true
}
