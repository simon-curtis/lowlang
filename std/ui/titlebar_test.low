import std/testing
import std/ui/platform

fn area_name(cx: Context, x: f32, y: f32) -> str {
    let found = window_control_area_at(cx, x, y)
    match found {
        some(area) => match area {
            Drag => "drag"
            Close => "close"
            Max => "max"
            Min => "min"
        }
        none => "none"
    }
}

fn caption(area: platform.WindowControlArea) -> Element {
    div().width(20.0).height(30.0).window_control_area(area)
}

fn title_bar() -> Element {
    div().column().children() {
        div().row().height(30.0).window_control_area(platform.WindowControlArea.Drag).children() {
            div().width(100.0).height(30.0),
            caption(platform.WindowControlArea.Min),
            caption(platform.WindowControlArea.Max),
            caption(platform.WindowControlArea.Close),
        },
        div().height(70.0),
    }
}

fn test_the_area_under_a_point_is_the_innermost_one(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, title_bar)
    testing.equal(t, area_name(cx, 10.0, 10.0), "drag")
    testing.equal(t, area_name(cx, 110.0, 10.0), "min")
    testing.equal(t, area_name(cx, 130.0, 10.0), "max")
    testing.equal(t, area_name(cx, 150.0, 10.0), "close")
    testing.equal(t, area_name(cx, 190.0, 29.0), "drag")
    testing.equal(t, area_name(cx, 10.0, 31.0), "none")
    testing.equal(t, area_name(cx, 150.0, 60.0), "none")
    testing.equal(t, area_name(cx, -1.0, 10.0), "none")
}

fn test_a_frame_that_has_not_drawn_has_no_areas(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    testing.equal(t, area_name(cx, 10.0, 10.0), "none")
}

fn test_a_child_with_a_handler_inside_a_drag_area_is_plain_content(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = fn() -> Element {
        div().column().children() {
            div().row().height(30.0).window_control_area(platform.WindowControlArea.Drag).children() {
                div().width(40.0).height(30.0).on_click(count_up(clicks)),
                div().width(40.0).height(30.0).focusable(),
                div().width(40.0).height(30.0).hover(fn(v: Visual) -> Visual { v.with_background(rgb(0xff0000)) }),
                div().width(40.0).height(30.0).on_click(count_up(clicks)).window_control_area(platform.WindowControlArea.Close),
            },
        }
    }
    shot(cx, view)
    testing.equal(t, area_name(cx, 20.0, 10.0), "none")
    testing.equal(t, area_name(cx, 60.0, 10.0), "none")
    testing.equal(t, area_name(cx, 100.0, 10.0), "drag")
    testing.equal(t, area_name(cx, 140.0, 10.0), "close")
    testing.equal(t, area_name(cx, 190.0, 10.0), "drag")
    click(cx, 20.0, 10.0)
    testing.equal(t, get(clicks), 1)
}

fn test_a_field_inside_a_drag_area_is_plain_content(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().height(30.0).window_control_area(platform.WindowControlArea.Drag).child(field("x"))
    }
    shot(cx, view)
    testing.equal(t, area_name(cx, 10.0, 10.0), "none")
    testing.equal(t, area_name(cx, 150.0, 10.0), "none")
}

fn test_a_clipped_area_is_not_under_the_points_it_is_clipped_from(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(100.0, 20.0).overflow_hidden().child(div().size(200.0, 20.0).window_control_area(platform.WindowControlArea.Drag))
    }
    shot(cx, view)
    testing.equal(t, area_name(cx, 50.0, 10.0), "drag")
    testing.equal(t, area_name(cx, 150.0, 10.0), "none")
    testing.equal(t, area_name(cx, 50.0, 30.0), "none")
}

fn test_the_later_sibling_wins_where_areas_overlap(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().children() {
            div().absolute().size(60.0, 20.0).window_control_area(platform.WindowControlArea.Drag),
            div().absolute().size(30.0, 20.0).window_control_area(platform.WindowControlArea.Max),
        }
    }
    shot(cx, view)
    testing.equal(t, area_name(cx, 10.0, 10.0), "max")
    testing.equal(t, area_name(cx, 45.0, 10.0), "drag")
}

fn test_the_maximised_state_follows_the_window_and_asks_for_a_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, title_bar)
    testing.is_false(t, is_maximized(cx))
    testing.is_false(t, frame_due(cx))
    dispatch(cx, platform.Event.Maximized(true))
    testing.is_true(t, is_maximized(cx))
    testing.is_true(t, frame_due(cx))
    shot(cx, title_bar)
    dispatch(cx, platform.Event.Maximized(true))
    testing.is_false(t, frame_due(cx))
    dispatch(cx, platform.Event.Maximized(false))
    testing.is_false(t, is_maximized(cx))
    testing.is_true(t, frame_due(cx))
}

fn test_a_context_with_no_window_toggles_its_own_maximised_state(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, title_bar)
    toggle_maximize(cx)
    testing.is_true(t, is_maximized(cx))
    testing.is_true(t, frame_due(cx))
    shot(cx, title_bar)
    toggle_maximize(cx)
    testing.is_false(t, is_maximized(cx))
}

fn test_minimize_runs_the_windows_command(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let minimised = signal(cx, 0)
    cx.state.minimize = count_up(minimised)
    minimize(cx)
    minimize(cx)
    testing.equal(t, get(minimised), 2)
    testing.is_false(t, is_maximized(cx))
}

fn test_the_maximised_state_can_restyle_the_tree_on_the_next_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        let shade: u32 = if is_maximized(cx) { 0x00ff00 } else { 0xff0000 }
        div().size(20.0, 20.0).background(rgb(shade))
    }
    testing.equal(t, shot(cx, view).quads[0].background.r, 1.0)
    dispatch(cx, platform.Event.Maximized(true))
    testing.equal(t, shot(cx, view).quads[0].background.g, 1.0)
}
