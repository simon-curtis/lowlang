import std/text
import std/ui
import std/ui/geometry
import std/ui/platform
import std/unicode

/// The default width of a picker, in pixels.
pub const picker_width: f32 = 320.0
/// The default height in pixels of a picker row with a detail line, and of every row of a windowed picker.
pub const picker_row_height: f32 = control_height + 12.0
/// The default height in pixels of a picker row without a detail line.
pub const picker_line_height: f32 = control_height + 2.0
/// The default number of rows a picker list shows before it scrolls.
pub const picker_visible_rows: i64 = 10
const picker_bar_height: f32 = control_height + 8.0

/// The colour a picker row draws its icon in.
pub enum PickerTone {
    /// The muted colour.
    Plain
    /// The ok colour.
    Ok
    /// The danger colour.
    Danger
}

/// One row of a picker.
pub struct PickerChoice {
    /// The caller's identifier for the choice, which the picker does not interpret.
    pub key: str
    /// The text of the row's first line.
    pub name: str
    /// The text of a second, fainter line under the name. Defaults to empty, for none.
    pub detail: str = ""
    /// A prefix drawn in the faint colour before the name, followed by a colon. Defaults to empty, for none.
    pub area: str = ""
    /// The key combination drawn at the end of the row. Defaults to empty, for none.
    pub chord: str = ""
    /// The name of the icon drawn before the label. Defaults to empty, for none.
    pub glyph: str = ""
    /// The colour of the icon. Defaults to `PickerTone.Plain`.
    pub tone: PickerTone = PickerTone.Plain
    /// Whether the name is set in the code font at the small size. Defaults to `false`.
    pub code: bool = false
    /// Whether this is the current choice, which draws a check at the end of the row and is selected when no valid index is. Defaults to `false`.
    pub current: bool = false
    /// The lower-case text a query is matched against, which `picker_choice` fills in. Defaults to empty, which only an empty query matches.
    pub terms: str = ""
}

/// The identity, texts and sizes of a picker.
pub struct PickerView {
    /// The element id of the picker, from which the ids of its field and list are made.
    pub id: str
    /// The text shown in the query field while it is empty.
    pub placeholder: str
    /// The text shown when no choice matches the query.
    pub empty: str
    /// A message shown in place of the rows, or `none` to show the rows. Defaults to `none`.
    pub status: str? = none
    /// The name of the icon drawn before the query field. Defaults to `"search"`.
    pub glyph: str = "search"
    /// The width of the picker in pixels. Defaults to `picker_width`.
    pub width: f32 = picker_width
    /// The height in pixels of a row with a detail line, and of every row of a windowed picker. Defaults to `picker_row_height`.
    pub row_height: f32 = picker_row_height
    /// The height in pixels of a row without a detail line. Defaults to `picker_line_height`.
    pub line_height: f32 = picker_line_height
    /// The number of rows the list shows before it scrolls. Defaults to `picker_visible_rows`.
    pub visible_rows: i64 = picker_visible_rows
    /// Whether a detail line too long to fit is cut at its start rather than its end. Defaults to `false`.
    pub path_details: bool = false
    /// The id of the element the picker is opened from, a press on which does not dismiss the picker. Defaults to empty, for none.
    pub owner: str = ""
    /// Whether the rows are built only as they come into view, each `row_height` high. Defaults to `false`.
    pub windowed: bool = false
}

/// The callbacks a picker calls.
pub struct PickerHandlers {
    /// The function called with the query text each time it changes, after the list has scrolled to the top.
    pub typed: fn(str)
    /// The function called with the new selected index when Up, Down, Page Up or Page Down moves the selection.
    pub moved: fn(i64)
    /// The function called with the index of the chosen row when a row is clicked or Enter is pressed over matches.
    pub chosen: fn(i64)
    /// The function called with the query text when Enter is pressed and no choice matches.
    pub submitted: fn(str)
    /// The function called when Escape is pressed or a press lands outside the picker and its owner.
    pub dismissed: fn()
}

/// Returns a choice with `key`, `name` and `detail` whose `terms` are the lower-cased name, detail and `keywords`.
pub fn picker_choice(key: str, name: str, detail: str, keywords: str) -> PickerChoice {
    let terms = unicode.lower("{name} {detail} {keywords}")
    PickerChoice { key, name, detail, terms }
}

fn picker_words(query: str) -> str[] {
    var words: str[] = []
    for word in text.fields(unicode.lower(query)) {
        words.push(word)
    }
    words
}

fn picker_has_all(choice: PickerChoice, words: str[]) -> bool {
    for word in words {
        if !text.contains(choice.terms, word) {
            return false
        }
    }
    true
}

/// Returns the `choices` whose terms contain every word of `query`, in their order and ignoring case. A blank query returns them all.
pub fn picker_filtered(choices: PickerChoice[], query: str) -> PickerChoice[] {
    let words = picker_words(query)
    var shown: PickerChoice[] = []
    for choice in choices {
        if picker_has_all(choice, words) {
            shown.push(choice)
        }
    }
    shown
}

/// Returns the index to select among `shown` for `raw`: `raw` when it is in range, otherwise the index of the first current choice, otherwise 0.
pub fn picker_selected(shown: PickerChoice[], raw: i64) -> i64 {
    if raw >= 0 && raw < shown.len {
        return raw
    }
    for index, choice in shown {
        if choice.current {
            return index
        }
    }
    0
}

/// Returns the element id of the query field of the picker with the id `id`.
pub fn picker_field_of(id: str) -> str {
    "{id}-query"
}

fn picker_field_id(view: PickerView) -> str {
    picker_field_of(view.id)
}

fn picker_list_id(view: PickerView) -> str {
    "{view.id}-list"
}

fn picker_extent(view: PickerView, choice: PickerChoice) -> f32 {
    if view.windowed || choice.detail != "" {
        view.row_height
    } else {
        view.line_height
    }
}

fn picker_list_edge() -> f32 {
    step(1.0)
}

fn picker_list_limit(view: PickerView) -> f32 {
    view.row_height * f32(view.visible_rows) + 2.0 * picker_list_edge()
}

fn picker_centred(cx: ui.Context, view: PickerView, index: i64) {
    let key = picker_list_id(view)
    let top = picker_list_edge() + view.row_height * f32(index)
    let offset = ui.scroll_offset(cx, key).y
    let viewport = picker_list_limit(view)
    if top - picker_list_edge() >= offset && top + view.row_height + picker_list_edge() <= offset + viewport {
        return
    }
    let middle = top + view.row_height / 2.0 - viewport / 2.0
    let target = if middle < 0.0 { 0.0 } else { middle }
    ui.scroll_to(cx, key, geometry.point(0.0, target))
}

fn picker_scrolled(cx: ui.Context, view: PickerView, shown: PickerChoice[], index: i64) {
    if index < 0 || index >= shown.len {
        return
    }
    if view.windowed {
        picker_centred(cx, view, index)
        return
    }
    var above = picker_list_edge()
    for before in 0..index {
        above += picker_extent(view, shown[before])
    }
    let below = above + picker_extent(view, shown[index])
    let key = picker_list_id(view)
    let offset = ui.scroll_offset(cx, key).y
    let viewport = picker_list_limit(view)
    if above - picker_list_edge() < offset {
        ui.scroll_to(cx, key, geometry.point(0.0, above - picker_list_edge()))
    } else if below + picker_list_edge() > offset + viewport {
        ui.scroll_to(cx, key, geometry.point(0.0, below + picker_list_edge() - viewport))
    }
}

fn picker_text_line(content: str, code: bool) -> ui.Element {
    let line = ui.row(ui.div()).min_width(0.0).overflow_hidden().child(ui.text(content).nowrap().ellipsis())
    if code {
        return line.font_family(code_font).text_size(small_size)
    }
    line
}

fn picker_detail_line(t: Theme, view: PickerView, content: str) -> ui.Element {
    let line = if view.path_details { ui.text(content).nowrap().ellipsis_start() } else { ui.text(content).nowrap().ellipsis() }
    ui.row(ui.div()).min_width(0.0).overflow_hidden().text_size(caption_size).text_color(t.faint).child(line)
}

fn picker_name_line(t: Theme, choice: PickerChoice) -> ui.Element {
    if choice.area == "" {
        return picker_text_line(choice.name, choice.code)
    }
    let area = ui.text("{choice.area}:").nowrap().text_color(t.faint)
    let name = picker_text_line(choice.name, choice.code)
    ui.row(ui.div()).min_width(0.0).overflow_hidden().gap(step(1.0)).child(ui.row(ui.div()).shrink(0.0).child(area)).child(name)
}

fn picker_label(t: Theme, view: PickerView, choice: PickerChoice) -> ui.Element {
    var lines: ui.Element[] = [picker_name_line(t, choice)]
    if choice.detail != "" {
        lines.push(picker_detail_line(t, view, choice.detail))
    }
    ui.column(ui.div()).flex_1().min_width(0.0).children(lines)
}

fn picker_glyph_colour(t: Theme, tone: PickerTone) -> geometry.Color {
    match tone {
        Plain => t.muted
        Ok => t.ok
        Danger => t.danger
    }
}

fn picker_row(t: Theme, view: PickerView, choice: PickerChoice, index: i64, selected: bool, handlers: PickerHandlers) -> ui.Element {
    var parts: ui.Element[] = []
    if choice.glyph != "" {
        parts.push(small_icon_in(choice.glyph, picker_glyph_colour(t, choice.tone)))
    }
    parts.push(picker_label(t, view, choice))
    if choice.chord != "" {
        parts.push(keys(t, choice.chord))
    }
    if choice.current {
        parts.push(small_icon_in("check", t.accent))
    }
    let chosen = handlers.chosen
    row(t, "{view.id}-{index}", selected, fn() { chosen(index) }).height(picker_extent(view, choice)).children(parts)
}

fn picker_typed(cx: ui.Context, view: PickerView, handlers: PickerHandlers) -> fn(str) {
    let typed = handlers.typed
    fn(v: str) {
        ui.scroll_to(cx, picker_list_id(view), geometry.point(0.0, 0.0))
        typed(v)
    }
}

fn picker_bar(t: Theme, cx: ui.Context, view: PickerView, query: str, handlers: PickerHandlers) -> ui.Element {
    let entry = ui.field(query).id(picker_field_id(view)).grow(1.0).text_size(body_size).placeholder(view.placeholder).placeholder_color(t.faint).on_change(picker_typed(cx, view, handlers))
    let field = ui.row(ui.div()).grow(1.0).items_center().child(entry)
    ui.row(ui.div()).height(picker_bar_height).shrink(0.0).items_center().gap(step(2.0)).padding_xy(step(2.5), 0.0).child(small_icon_in(view.glyph, t.faint)).child(field)
}

fn picker_windowed_rows(t: Theme, view: PickerView, shown: PickerChoice[], selected: i64, handlers: PickerHandlers) -> fn(i64, i64) -> ui.Element[] {
    fn(first: i64, end: i64) -> ui.Element[] {
        var rows: ui.Element[] = []
        for index in first..end {
            rows.push(picker_row(t, view, shown[index], index, index == selected, handlers))
        }
        rows
    }
}

fn picker_windowed_list(t: Theme, view: PickerView, shown: PickerChoice[], selected: i64, handlers: PickerHandlers) -> ui.Element {
    let visible = if shown.len < view.visible_rows { shown.len } else { view.visible_rows }
    let height = view.row_height * f32(visible) + 2.0 * picker_list_edge()
    ui.uniform_list(picker_list_id(view), shown.len, picker_windowed_rows(t, view, shown, selected, handlers)).height(height).shrink(0.0).padding(picker_list_edge()).scrollbar(hover_scrollbars(t))
}

fn picker_list(t: Theme, view: PickerView, shown: PickerChoice[], selected: i64, handlers: PickerHandlers) -> ui.Element {
    if view.windowed && view.status == none && shown.len > 0 {
        return picker_windowed_list(t, view, shown, selected, handlers)
    }
    var rows: ui.Element[] = []
    match view.status {
        some(status) => rows.push(empty(t, status))
        none => {
            if shown.len == 0 {
                rows.push(empty(t, view.empty))
            }
            for index, choice in shown {
                rows.push(picker_row(t, view, choice, index, index == selected, handlers))
            }
        }
    }
    ui.column(ui.div()).id(picker_list_id(view)).max_height(picker_list_limit(view)).overflow_y_scroll().padding(picker_list_edge()).children(rows).scrollbar(hover_scrollbars(t))
}

fn picker_moved(cx: ui.Context, view: PickerView, shown: PickerChoice[], handlers: PickerHandlers, to: i64) {
    picker_scrolled(cx, view, shown, to)
    let moved = handlers.moved
    moved(to)
}

fn picker_paged(selected: i64, count: i64, step: i64) -> i64 {
    let to = selected + step
    match to {
        < 0 => 0
        >= count => count - 1
        _ => to
    }
}

fn picker_key(cx: ui.Context, view: PickerView, query: str, shown: PickerChoice[], selected: i64, handlers: PickerHandlers) -> fn(platform.KeyEvent) -> bool {
    fn(k: platform.KeyEvent) -> bool {
        if !k.pressed {
            return false
        }
        let count = if shown.len > 0 { shown.len } else { 1 }
        match k.key {
            Named(named) => {
                match named {
                    Down => picker_moved(cx, view, shown, handlers, (selected + 1) % count)
                    Up => picker_moved(cx, view, shown, handlers, (selected + count - 1) % count)
                    PageDown => picker_moved(cx, view, shown, handlers, picker_paged(selected, count, picker_visible_rows))
                    PageUp => picker_moved(cx, view, shown, handlers, picker_paged(selected, count, -picker_visible_rows))
                    Enter => {
                        let chosen = handlers.chosen
                        let submitted = handlers.submitted
                        if shown.len > 0 {
                            chosen(selected)
                        } else {
                            submitted(query)
                        }
                    }
                    Escape => {
                        let dismissed = handlers.dismissed
                        dismissed()
                    }
                    _ => return false
                }
            }
            Character(_) => return false
        }
        true
    }
}

fn picker_over_owner(cx: ui.Context, view: PickerView, position: geometry.Point) -> bool {
    if view.owner == "" {
        return false
    }
    let bounds = ui.bounds_of(cx, view.owner) ?? return false
    geometry.contains(bounds, position)
}

fn picker_pressed_outside(cx: ui.Context, view: PickerView, handlers: PickerHandlers) -> fn(ui.MouseDownEvent) {
    let dismissed = handlers.dismissed
    fn(e: ui.MouseDownEvent) {
        if !picker_over_owner(cx, view, e.position) {
            dismissed()
        }
    }
}

/// Draws a picker: a query field over a list of `shown` rows with `selected` highlighted. Up, Down, Page Up and Page Down move the selection, Enter chooses the selected row or submits the query when nothing matches, and Escape or a press outside dismisses it, each through `handlers`.
pub fn picker_element(t: Theme, cx: ui.Context, view: PickerView, query: str, selected: i64, shown: PickerChoice[], handlers: PickerHandlers) -> ui.Element {
    let bar = picker_bar(t, cx, view, query, handlers)
    let list = picker_list(t, view, shown, selected, handlers)
    ui.column(popover(t)).id(view.id).occlude().width(view.width).on_key(picker_key(cx, view, query, shown, selected, handlers)).on_mouse_down_out(picker_pressed_outside(cx, view, handlers)).child(bar).child(line(t)).child(list)
}
