import std/ui
import std/ui/geometry
import std/ui/platform

const menu_bar_height: f32 = 28.0
const menu_label_letter: f32 = 7.5
const menu_label_padding: f32 = 24.0

/// One drop-down of a menu bar: the label on the bar and the rows under it.
pub struct BarMenu {
    /// The text of the label on the bar.
    pub label: str
    /// The rows of the drop-down, in order.
    pub items: MenuItem[]
}

/// The state of a row of drop-down menus, of which at most one is open.
pub struct MenuBar {
    /// The element id the labels and menus of the bar are named from.
    pub id: str
    cx: ui.Context
    restore: ui.Signal[str]
    menus: OpenMenu[]
}

fn bar_label_id(id: str, index: i64) -> str {
    "{id}-label-{index}"
}

fn bar_menu_id(id: str, index: i64) -> str {
    "{id}-menu-{index}"
}

fn bar_menu_open_at(bar: MenuBar) -> i64 {
    for index, m in bar.menus {
        if menu_is_open(m) {
            return index
        }
    }
    -1
}

fn bar_shown(bar: MenuBar, index: i64) {
    for other, m in bar.menus {
        if other != index {
            dismiss_menu(m)
        }
    }
    show_menu_from(bar.menus[index], geometry.Point {}, ui.get(bar.restore))
}

fn bar_beside(bar: MenuBar, from: i64, step: i64) {
    let count = bar.menus.len
    bar_shown(bar, (from + step + count) % count)
}

/// Creates a bar of `count` menus, none open.
pub fn menu_bar_new(cx: ui.Context, id: str, count: i64) -> MenuBar {
    var menus: OpenMenu[] = []
    for index in 0..count {
        menus.push(open_menu_below(cx, bar_menu_id(id, index), bar_label_id(id, index)))
    }
    let restore = ui.signal(cx, "")
    let plain = MenuBar { id, cx, restore, menus }
    var linked: OpenMenu[] = []
    for index, m in menus {
        var next = m
        next.sideways = fn(step: i64) { bar_beside(plain, index, step) }
        linked.push(next)
    }
    MenuBar { id, cx, restore, menus: linked }
}

/// Returns the width a bar of these labels is given: 7.5 px a letter and 24 px a label.
pub fn menu_bar_width(labels: str[]) -> f32 {
    var width: f32 = 0.0
    for label in labels {
        width += f32(label.len) * menu_label_letter + menu_label_padding
    }
    width
}

/// Returns the key of the element that had focus before the bar's menus were opened, which closing one hands focus back to.
pub fn menu_bar_restore(bar: MenuBar) -> str {
    ui.get(bar.restore)
}

/// Returns whether one of the bar's menus is open.
pub fn menu_bar_is_open(bar: MenuBar) -> bool {
    bar_menu_open_at(bar) >= 0
}

fn bar_label_pressed(bar: MenuBar, index: i64) -> fn(ui.MouseDownEvent) {
    fn(e: ui.MouseDownEvent) {
        if menu_is_open(bar.menus[index]) {
            dismiss_menu(bar.menus[index])
            return
        }
        bar_shown(bar, index)
    }
}

fn bar_label_hovered(bar: MenuBar, index: i64) -> fn(ui.MouseMoveEvent) {
    fn(e: ui.MouseMoveEvent) {
        let open = bar_menu_open_at(bar)
        if open < 0 {
            ui.set(bar.restore, ui.focused(bar.cx))
            return
        }
        if open != index {
            bar_shown(bar, index)
        }
    }
}

fn bar_label(t: Theme, bar: MenuBar, index: i64, label: str) -> ui.Element {
    let base = menu_item(t, bar_label_id(bar.id, index), label).on_mouse_down(platform.Button.Left, bar_label_pressed(bar, index)).on_mouse_move(bar_label_hovered(bar, index))
    if menu_is_open(bar.menus[index]) {
        return base.background(t.hover)
    }
    base
}

/// Draws the bar's labels in a row of the fitted width, and the open menu under its label. Moving along the bar while one menu is open opens the menu under the pointer, and Left and Right in an open menu open its neighbour.
pub fn menu_bar_element(t: Theme, bar: MenuBar, menus: BarMenu[]) -> ui.Element {
    var labels: ui.Element[] = []
    var names: str[] = []
    for index, shown in menus {
        names.push(shown.label)
        labels.push(bar_label(t, bar, index, shown.label))
        labels.push(menu_element(t, bar.menus[index], shown.items))
    }
    ui.row(ui.div()).width(menu_bar_width(names)).height(menu_bar_height).shrink(0.0).items_center().gap(step(0.5)).children(labels)
}
