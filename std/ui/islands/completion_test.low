import std/testing
import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

struct CompletionRig {
    cx: ui.Context
    look: Theme
    view: CompletionView
    selected: ui.Signal[i64]
    log: ui.Signal[str[]]
    paint: fn() -> ui.Element
}

fn completion_sample_rows(count: i64) -> CompletionRow[] {
    var rows: CompletionRow[] = []
    for index in 0..count {
        var row = CompletionRow { label: "Item{index}", glyph: "table" }
        if index % 2 == 0 {
            row.detail = "dbo"
        }
        rows.push(row)
    }
    rows
}

fn completion_rig_of(rows: CompletionRow[]) -> CompletionRig {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let view = CompletionView { id: "comp", focus: "comp-field" }
    let selected = ui.signal(cx, 0)
    let log = new_log(cx)
    let query = ui.signal(cx, "")
    let chosen = fn(index: i64) { note(log, "chosen {index}") }
    let paint = fn() -> ui.Element {
        let box = ui.field(ui.get(query)).id("comp-field").width(200.0).height(28.0)
        let row_at = fn(index: i64) -> CompletionRow { rows[index] }
        let list = completion_element(cx, look, view, rows.len, row_at, ui.get(selected), geometry.point(40.0, 60.0), chosen)
        ui.div().size(700.0, 700.0).child(box).child(list)
    }
    CompletionRig { cx, look, view, selected, log, paint }
}

fn completion_shot(r: CompletionRig) -> scene.Scene {
    ui.frame(r.cx, r.paint, geometry.size(700.0, 700.0), 1.0)
}

fn completion_row_count(r: CompletionRig, limit: i64) -> i64 {
    var found = 0
    for index in 0..limit {
        if ui.bounds_of(r.cx, "comp-{index}") != none {
            found += 1
        }
    }
    found
}

fn completion_row_ink(r: CompletionRig, sc: scene.Scene, index: i64) -> f32 {
    let row = bounds_for(r.cx, "comp-{index}")
    var ink: f32 = 0.0
    for sprite in sc.sprites {
        if sprite.bounds.y >= row.y && sprite.bounds.y + sprite.bounds.height <= row.y + row.height {
            ink += sprite.bounds.width
        }
    }
    ink
}

fn test_the_list_draws_icon_label_and_detail_for_the_rows_in_view(t: *testing.T) {
    let r = completion_rig_of(completion_sample_rows(30))
    let sc = completion_shot(r)
    t.equal(completion_row_count(r, 30), completion_visible_rows)
    let panel = bounds_for(r.cx, "comp")
    same_number(t, panel.width, completion_width)
    let first = bounds_for(r.cx, "comp-0")
    same_number(t, first.height, completion_row_height)
    same_number(t, first.x, panel.x + 1.0 + floor(step(1.0)))
    t.is_true(ui.bounds_of(r.cx, "icon-table") != none)
    let with_detail = completion_row_ink(r, sc, 0)
    let without = completion_row_ink(r, sc, 1)
    t.is_true(without > 0.0)
    t.is_true(with_detail > without)
    t.equal(sc.shadows.len, 1)
    same_colour(t, filled(sc)[0].background, r.look.raised)
}

fn test_only_the_rows_in_view_are_asked_for(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let log = new_log(cx)
    let view = CompletionView { id: "comp" }
    let row_at = fn(index: i64) -> CompletionRow {
        note(log, "{index}")
        CompletionRow { label: "Item{index}" }
    }
    let paint = fn() -> ui.Element {
        let list = completion_element(cx, look, view, 100000, row_at, 0, geometry.point(40.0, 60.0), fn(index: i64) {})
        ui.div().size(700.0, 700.0).child(list)
    }
    ui.frame(cx, paint, geometry.size(700.0, 700.0), 1.0)
    let asked = ui.get(log).len
    t.is_true(asked >= completion_visible_rows)
    t.is_true(asked <= completion_visible_rows + 4)
}

fn test_the_selected_row_alone_is_filled(t: *testing.T) {
    let r = completion_rig_of(completion_sample_rows(5))
    ui.set(r.selected, 3)
    let sc = completion_shot(r)
    var fills: scene.Quad[] = []
    for q in sc.quads {
        if q.background.a > 0.0 && near(q.background.r, r.look.selected.r) && near(q.background.g, r.look.selected.g) && near(q.background.b, r.look.selected.b) {
            fills.push(q)
        }
    }
    t.equal(fills.len, 1)
    let row = bounds_for(r.cx, "comp-3")
    same_number(t, fills[0].bounds.y, row.y)
    same_number(t, fills[0].bounds.height, completion_row_height)
}

fn test_an_empty_list_says_no_suggestions(t: *testing.T) {
    let r = completion_rig_of([])
    let sc = completion_shot(r)
    t.equal(completion_row_count(r, 5), 0)
    t.is_true(ui.bounds_of(r.cx, completion_list_id(r.view)) == none)
    t.equal(r.view.empty, "No suggestions")
    var faint = 0
    for sprite in sc.sprites {
        if near(sprite.color.r, r.look.faint.r) && near(sprite.color.g, r.look.faint.g) && near(sprite.color.b, r.look.faint.b) {
            faint += 1
        }
    }
    t.is_true(faint > 0)
}

fn completion_offset(r: CompletionRig) -> f32 {
    ui.scroll_offset(r.cx, completion_list_id(r.view)).y
}

fn completion_scrolled_to(r: CompletionRig, count: i64, index: i64) {
    completion_scrolled(r.cx, r.view, count, index)
    completion_shot(r)
}

fn test_scrolling_to_a_row_moves_the_list_the_least(t: *testing.T) {
    let r = completion_rig_of(completion_sample_rows(30))
    completion_shot(r)
    completion_scrolled_to(r, 30, 5)
    same_number(t, completion_offset(r), 0.0)
    completion_scrolled_to(r, 30, 12)
    same_number(t, completion_offset(r), 13.0 * completion_row_height - 10.0 * completion_row_height)
    completion_scrolled_to(r, 30, 11)
    same_number(t, completion_offset(r), 3.0 * completion_row_height)
    completion_scrolled_to(r, 30, 2)
    same_number(t, completion_offset(r), 2.0 * completion_row_height)
    completion_scrolled_to(r, 30, 99)
    same_number(t, completion_offset(r), 2.0 * completion_row_height)
}

fn hint_shot(at: geometry.Point) -> geometry.Rect {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let paint = fn() -> ui.Element {
        let hint = key_hint_element(look, "hint", "Tab", "Expand to the columns of a, b", at)
        ui.div().size(700.0, 700.0).child(hint)
    }
    ui.frame(cx, paint, geometry.size(700.0, 700.0), 1.0)
    bounds_for(cx, "hint")
}

fn test_a_key_hint_sits_at_its_corner_when_there_is_room(t: *testing.T) {
    let panel = hint_shot(geometry.point(40.0, 60.0))
    same_number(t, panel.x, 40.0)
    same_number(t, panel.y, 60.0)
    t.is_true(panel.width > 100.0)
}

fn test_a_key_hint_stays_eight_pixels_inside_the_window(t: *testing.T) {
    let panel = hint_shot(geometry.point(690.0, 695.0))
    same_number(t, panel.x + panel.width, 692.0)
    same_number(t, panel.y + panel.height, 692.0)
    let corner = hint_shot(geometry.point(-30.0, -30.0))
    same_number(t, corner.x, 8.0)
    same_number(t, corner.y, 8.0)
}

fn test_pressing_a_row_chooses_it_and_focus_stays_put(t: *testing.T) {
    let r = completion_rig_of(completion_sample_rows(5))
    completion_shot(r)
    ui.set_focus(r.cx, "comp-field")
    completion_shot(r)
    t.equal(ui.focused(r.cx), "comp-field")
    let row = bounds_for(r.cx, "comp-2")
    let x = row.x + 20.0
    let y = row.y + row.height / 2.0
    ui.dispatch(r.cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: x, y: y }))
    ui.dispatch(r.cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: x, y: y }))
    completion_shot(r)
    t.equal_slice(ui.get(r.log), ["chosen 2"])
    t.equal(ui.focused(r.cx), "comp-field")
}
