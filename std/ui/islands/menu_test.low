import std/testing
import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn note(log: ui.Signal[str[]], entry: str) {
    ui.update(log, fn(entries: str[]) -> str[] {
        var out = entries[0..]
        out.push(entry)
        out
    })
}

fn new_log(cx: ui.Context) -> ui.Signal[str[]] {
    let entries: str[] = []
    ui.signal(cx, entries)
}

fn noting(log: ui.Signal[str[]], entry: str) -> fn() {
    fn() { note(log, entry) }
}

fn right_press(cx: ui.Context, x: f32, y: f32) {
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Right, x: x, y: y }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Right, x: x, y: y }))
}

fn key_down(cx: ui.Context, named: platform.NamedKey) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(named) }))
}

fn key_up(cx: ui.Context, named: platform.NamedKey) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(named), pressed: false }))
}

fn type_text(cx: ui.Context, text: str) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(text), text: text }))
}

fn centre_of(cx: ui.Context, key: str) -> geometry.Point {
    let r = ui.bounds_of(cx, key) ?? geometry.Rect {}
    geometry.point(r.x + r.width / 2.0, r.y + r.height / 2.0)
}

fn click_key(cx: ui.Context, key: str) {
    let p = centre_of(cx, key)
    move_to(cx, p.x, p.y)
    click_at(cx, p.x, p.y)
}

fn bounds_for(cx: ui.Context, key: str) -> geometry.Rect {
    ui.bounds_of(cx, key) ?? geometry.Rect {}
}

fn tinted(sc: scene.Scene, colour: geometry.Color) -> i64 {
    var found = 0
    for sprite in sc.sprites {
        if near(sprite.color.r, colour.r) && near(sprite.color.g, colour.g) && near(sprite.color.b, colour.b) {
            found += 1
        }
    }
    found
}

fn selected_row(cx: ui.Context, sc: scene.Scene, look: Theme, id: str, count: i64) -> i64 {
    for q in sc.quads {
        if near(q.background.a, look.selected.a) && near(q.background.r, look.selected.r) {
            for i in 0..count {
                if near(bounds_for(cx, "{id}-{i}").y, q.bounds.y) {
                    return i
                }
            }
        }
    }
    -1
}

fn menu_items(log: ui.Signal[str[]]) -> MenuItem[] {
    let copy = plain("Copy", "copy", noting(log, "copy")).hint("Ctrl+C")
    let rename = plain("Rename", "pencil", noting(log, "rename"))
    let delete = plain("Delete", "trash", noting(log, "delete")).separated().danger(true)
    [copy, rename, delete]
}

fn context_view(look: Theme, m: OpenMenu, items: MenuItem[], log: ui.Signal[str[]]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        let area = ui.div().id("area").size(400.0, 300.0).focusable().on_click(fn(e: ui.ClickEvent) { note(log, "area") })
        ui.div().size(400.0, 300.0).child(context_trigger(area, m)).child(menu_element(look, m, items))
    }
}

fn dropdown_view(look: Theme, m: OpenMenu, items: MenuItem[], log: ui.Signal[str[]]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        let owner = ui.div().id("owner").size(100.0, 28.0).background(look.control)
        let area = ui.div().id("area").size(400.0, 300.0).on_click(fn(e: ui.ClickEvent) { note(log, "area") })
        ui.div().size(400.0, 300.0).child(area).child(ui.div().absolute().top(10.0).left(20.0).child(dropdown_trigger(owner, m))).child(menu_element(look, m, items))
    }
}

fn opened(look: Theme) -> OpenMenuCase {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let m = open_menu(cx, "context-menu")
    let items = menu_items(log)
    OpenMenuCase { cx, log, m, items, view: context_view(look, m, items, log) }
}

struct OpenMenuCase {
    cx: ui.Context
    log: ui.Signal[str[]]
    m: OpenMenu
    items: MenuItem[]
    view: fn() -> ui.Element
}

fn test_a_closed_menu_draws_nothing(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    let sc = shot(c.cx, c.view)
    t.equal(sc.quads.len, 0)
    t.equal(sc.shadows.len, 0)
    t.is_false(menu_is_open(c.m))
}

fn test_a_right_press_opens_the_menu_at_the_pointer_and_takes_focus(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    ui.set_focus(c.cx, "area")
    right_press(c.cx, 40.0, 50.0)
    t.is_true(menu_is_open(c.m))
    t.equal(ui.focused(c.cx), "context-menu")
    shot(c.cx, c.view)
    t.equal(ui.focused(c.cx), "context-menu")
    let panel = bounds_for(c.cx, "context-menu")
    same_number(t, panel.x, 40.0)
    same_number(t, panel.y, 50.0)
    t.is_true(panel.width >= menu_min_width)
    same_number(t, panel.width, menu_min_width)
    same_number(t, panel.height, 99.0)
}

fn test_a_menu_is_a_raised_bordered_popover_with_a_shadow(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    let sc = shot(c.cx, c.view)
    let fill = filled(sc)[0]
    same_colour(t, fill.background, look.raised)
    t.equal(fill.corner_radii.top_left, 10.0)
    same_number(t, fill.bounds.width, menu_min_width)
    let ring = outlined(sc)
    same_colour(t, ring.border_color, look.border)
    t.equal(ring.border_widths.top, 1.0)
    t.equal(sc.shadows.len, 1)
}

fn test_a_menu_row_is_a_twenty_eight_high_row_inside_three_and_a_quarter_of_padding(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    let panel = bounds_for(c.cx, "context-menu")
    let first = bounds_for(c.cx, "context-menu-0")
    let second = bounds_for(c.cx, "context-menu-1")
    same_number(t, first.height, 28.0)
    same_number(t, first.x, panel.x + 1.0 + floor(step(1.0)))
    same_number(t, first.y, panel.y + 1.0 + floor(step(1.0)))
    same_number(t, first.width, panel.width - 2.0 - 2.0 * floor(step(1.0)))
    same_number(t, second.y, first.y + 28.0)
}

fn test_a_row_shows_its_icon_label_and_hint(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    let sc = shot(c.cx, c.view)
    let first = bounds_for(c.cx, "context-menu-0")
    var icon = sc.sprites[0]
    var last = sc.sprites[0]
    for sprite in sc.sprites {
        if sprite.bounds.y >= first.y && sprite.bounds.y < first.y + first.height {
            if sprite.bounds.x < icon.bounds.x || icon.bounds.y < first.y {
                icon = sprite
            }
            if sprite.bounds.x > last.bounds.x {
                last = sprite
            }
        }
    }
    same_colour(t, icon.color, look.muted)
    same_number(t, icon.bounds.width, 14.0)
    same_number(t, icon.bounds.x, first.x + floor(step(2.0)))
    same_colour(t, last.color, look.faint)
    t.is_true(last.bounds.x + last.bounds.width <= first.x + first.width - step(2.0) + 0.5)
    t.is_true(last.bounds.x + last.bounds.width >= first.x + first.width - step(2.0) - 2.0)
}

fn test_a_danger_item_draws_its_icon_and_label_in_the_danger_colour(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    let sc = shot(c.cx, c.view)
    t.is_true(tinted(sc, look.danger) > 1)
    t.is_true(tinted(sc, look.muted) >= 2)
    let calm = [plain("Copy", "copy", nothing), plain("Delete", "trash", nothing).danger(false)]
    let log = new_log(c.cx)
    let other = open_menu(c.cx, "calm-menu")
    let calm_view = context_view(look, other, calm, log)
    shot(c.cx, calm_view)
    right_press(c.cx, 40.0, 50.0)
    t.equal(tinted(shot(c.cx, calm_view), look.danger), 0)
}

fn test_a_separator_sits_between_groups_and_never_before_the_first_item(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    let sc = shot(c.cx, c.view)
    var lines = 0
    for q in sc.quads {
        if near(q.bounds.height, 1.0) && near(q.background.r, look.border.r) && near(q.background.a, look.border.a) {
            lines += 1
            same_number(t, q.bounds.y, bounds_for(c.cx, "context-menu-1").y + 28.0 + floor(step(1.0)))
            same_number(t, q.bounds.x, bounds_for(c.cx, "context-menu").x + 1.0 + 2.0 * floor(step(1.0)))
        }
    }
    t.equal(lines, 1)
    let log = new_log(c.cx)
    let other = open_menu(c.cx, "first-menu")
    let leading = [plain("Copy", "copy", nothing).separated(), plain("Paste", "file", nothing)]
    let leading_view = context_view(look, other, leading, log)
    shot(c.cx, leading_view)
    right_press(c.cx, 40.0, 50.0)
    let leading_sc = shot(c.cx, leading_view)
    var leading_lines = 0
    for q in leading_sc.quads {
        if near(q.bounds.height, 1.0) && near(q.background.r, look.border.r) && near(q.background.a, look.border.a) {
            leading_lines += 1
        }
    }
    t.equal(leading_lines, 0)
}

fn test_choosing_an_item_closes_the_menu_before_it_runs(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let m = open_menu(cx, "context-menu")
    let watching = fn() {
        note(log, if menu_is_open(m) { "ran while open" } else { "ran closed" })
    }
    let items = [plain("Copy", "copy", watching), plain("Rename", "pencil", noting(log, "rename"))]
    let view = context_view(look, m, items, log)
    shot(cx, view)
    ui.set_focus(cx, "area")
    right_press(cx, 40.0, 50.0)
    shot(cx, view)
    click_key(cx, "context-menu-0")
    t.equal_slice(ui.get(log), ["ran closed"])
    t.is_false(menu_is_open(m))
    t.equal(ui.focused(cx), "area")
    t.equal(shot(cx, view).quads.len, 0)
}

fn test_a_press_outside_closes_the_menu_and_still_reaches_what_is_under_it(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    move_to(c.cx, 300.0, 250.0)
    click_at(c.cx, 300.0, 250.0)
    t.is_false(menu_is_open(c.m))
    t.equal_slice(ui.get(c.log), ["area"])
    t.equal(ui.focused(c.cx), "area")
}

fn test_a_press_inside_the_menu_beside_its_rows_keeps_it_open(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    let panel = bounds_for(c.cx, "context-menu")
    move_to(c.cx, panel.x + 1.5, panel.y + 40.0)
    click_at(c.cx, panel.x + 1.5, panel.y + 40.0)
    t.is_true(menu_is_open(c.m))
    t.equal(ui.get(c.log).len, 0)
}

fn test_escape_closes_the_menu_and_gives_focus_back(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    ui.set_focus(c.cx, "area")
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    t.equal(ui.focused(c.cx), "context-menu")
    key_down(c.cx, platform.NamedKey.Escape)
    t.is_false(menu_is_open(c.m))
    t.equal(ui.focused(c.cx), "area")
    t.equal(ui.get(c.log).len, 0)
}

fn test_a_key_the_menu_does_not_bind_leaves_it_open(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    type_text(c.cx, "a")
    t.is_true(menu_is_open(c.m))
    key_down(c.cx, platform.NamedKey.Left)
    t.is_true(menu_is_open(c.m))
    key_down(c.cx, platform.NamedKey.Tab)
    t.is_true(menu_is_open(c.m))
    ui.dispatch(c.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(""), modifiers: platform.Modifiers { shift: true } }))
    t.is_true(menu_is_open(c.m))
}

fn test_down_and_up_move_the_highlight_through_the_rows_and_wrap(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    t.equal(selected_row(c.cx, shot(c.cx, c.view), look, "context-menu", 3), -1)
    key_down(c.cx, platform.NamedKey.Down)
    t.equal(selected_row(c.cx, shot(c.cx, c.view), look, "context-menu", 3), 0)
    key_down(c.cx, platform.NamedKey.Down)
    key_down(c.cx, platform.NamedKey.Down)
    t.equal(selected_row(c.cx, shot(c.cx, c.view), look, "context-menu", 3), 2)
    key_down(c.cx, platform.NamedKey.Down)
    t.equal(selected_row(c.cx, shot(c.cx, c.view), look, "context-menu", 3), 0)
    key_down(c.cx, platform.NamedKey.Up)
    t.equal(selected_row(c.cx, shot(c.cx, c.view), look, "context-menu", 3), 2)
    t.is_true(menu_is_open(c.m))
}

fn test_up_from_no_highlight_goes_to_the_last_row(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    key_down(c.cx, platform.NamedKey.Up)
    t.equal(selected_row(c.cx, shot(c.cx, c.view), look, "context-menu", 3), 2)
}

fn test_enter_chooses_the_highlighted_row_after_a_single_frame(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    key_down(c.cx, platform.NamedKey.Down)
    key_down(c.cx, platform.NamedKey.Down)
    key_down(c.cx, platform.NamedKey.Enter)
    t.equal_slice(ui.get(c.log), ["rename"])
    t.is_false(menu_is_open(c.m))
}

fn test_enter_with_nothing_highlighted_does_nothing(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    key_down(c.cx, platform.NamedKey.Enter)
    t.is_true(menu_is_open(c.m))
