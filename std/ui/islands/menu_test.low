fn test_a_key_release_does_not_move_the_highlight(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    key_down(c.cx, platform.NamedKey.Down)
    key_up(c.cx, platform.NamedKey.Down)
    key_up(c.cx, platform.NamedKey.Escape)
    t.is_true(menu_is_open(c.m))
    t.equal(selected_row(c.cx, shot(c.cx, c.view), look, "context-menu", 3), 0)
}

fn test_a_menu_near_the_corner_stays_inside_the_window(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 390.0, 290.0)
    shot(c.cx, c.view)
    let panel = bounds_for(c.cx, "context-menu")
    t.is_true(panel.x >= 0.0)
    t.is_true(panel.y >= 0.0)
    t.is_true(panel.x + panel.width <= 400.0)
    t.is_true(panel.y + panel.height <= 300.0)
    same_number(t, panel.x + panel.width, 390.0)
    same_number(t, panel.y + panel.height, 290.0)
}

fn test_a_second_right_press_moves_the_open_menu_to_the_new_pointer(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    right_press(c.cx, 100.0, 200.0)
    t.is_true(menu_is_open(c.m))
    shot(c.cx, c.view)
    let panel = bounds_for(c.cx, "context-menu")
    same_number(t, panel.x, 100.0)
    same_number(t, panel.y, 200.0)
}

fn test_a_menu_draws_over_what_is_beside_it_and_takes_the_pointer(t: *testing.T) {
    let look = default_theme()
    let c = opened(look)
    shot(c.cx, c.view)
    right_press(c.cx, 40.0, 50.0)
    shot(c.cx, c.view)
    click_key(c.cx, "context-menu-1")
    t.equal_slice(ui.get(c.log), ["rename"])
}

fn dropdown_case(look: Theme) -> OpenMenuCase {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let m = open_menu_below(cx, "dropdown-menu", "owner")
    let items = menu_items(log)
    OpenMenuCase { cx, log, m, items, view: dropdown_view(look, m, items, log) }
}

fn test_a_click_opens_a_dropdown_under_its_owner_and_a_second_click_closes_it(t: *testing.T) {
    let look = default_theme()
    let c = dropdown_case(look)
    shot(c.cx, c.view)
    click_key(c.cx, "owner")
    t.is_true(menu_is_open(c.m))
    shot(c.cx, c.view)
    let owner = bounds_for(c.cx, "owner")
    let panel = bounds_for(c.cx, "dropdown-menu")
    same_number(t, panel.x, owner.x)
    same_number(t, panel.y, owner.y + owner.height)
    click_key(c.cx, "owner")
    t.is_false(menu_is_open(c.m))
    t.equal(shot(c.cx, c.view).shadows.len, 0)
    click_key(c.cx, "owner")
    t.is_true(menu_is_open(c.m))
}

fn test_a_dropdown_closes_on_a_press_outside_and_on_escape(t: *testing.T) {
    let look = default_theme()
    let c = dropdown_case(look)
    shot(c.cx, c.view)
    click_key(c.cx, "owner")
    shot(c.cx, c.view)
    move_to(c.cx, 300.0, 250.0)
    click_at(c.cx, 300.0, 250.0)
    t.is_false(menu_is_open(c.m))
    t.equal_slice(ui.get(c.log), ["area"])
    shot(c.cx, c.view)
    click_key(c.cx, "owner")
    shot(c.cx, c.view)
    t.equal(ui.focused(c.cx), "dropdown-menu")
    key_down(c.cx, platform.NamedKey.Escape)
    t.is_false(menu_is_open(c.m))
}

fn test_choosing_in_a_dropdown_runs_the_item_and_closes_it(t: *testing.T) {
    let look = default_theme()
    let c = dropdown_case(look)
    shot(c.cx, c.view)
    click_key(c.cx, "owner")
    shot(c.cx, c.view)
    click_key(c.cx, "dropdown-menu-2")
    t.equal_slice(ui.get(c.log), ["delete"])
    t.is_false(menu_is_open(c.m))
}

fn nested_view(look: Theme, m: OpenMenu, items: MenuItem[], log: ui.Signal[str[]]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        let host = ui.div().id("host").size(400.0, 300.0).focusable().on_click(fn(e: ui.ClickEvent) { note(log, "host") }).child(menu_element(look, m, items))
        context_trigger(host, m)
    }
}

fn test_a_menu_inside_its_own_trigger_ignores_presses_on_itself(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let m = open_menu(cx, "nested-menu")
    let view = nested_view(look, m, menu_items(log), log)
    shot(cx, view)
    right_press(cx, 40.0, 50.0)
    shot(cx, view)
    let before = bounds_for(cx, "nested-menu")
    let row = centre_of(cx, "nested-menu-1")
    move_to(cx, row.x, row.y)
    right_press(cx, row.x, row.y)
    shot(cx, view)
    t.is_true(menu_is_open(m))
    same_number(t, bounds_for(cx, "nested-menu").x, before.x)
    same_number(t, bounds_for(cx, "nested-menu").y, before.y)
    let padding = geometry.point(before.x + 2.0, before.y + 2.0)
    move_to(cx, padding.x, padding.y)
    click_at(cx, padding.x, padding.y)
    shot(cx, view)
    t.is_true(menu_is_open(m))
    t.equal(ui.get(log).len, 0)
}
