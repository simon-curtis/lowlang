import std/testing
import std/ui
import std/ui/platform

struct MenuBarCase {
    cx: ui.Context
    log: ui.Signal[str[]]
    bar: MenuBar
    view: fn() -> ui.Element
}

fn menu_bar_menus(log: ui.Signal[str[]]) -> BarMenu[] {
    let file = BarMenu { label: "File", items: [plain("New", "", noting(log, "new")), plain("Open", "", noting(log, "open")).hint("Ctrl+O")] }
    let edit = BarMenu { label: "Edit", items: [plain("Undo", "", noting(log, "undo"))] }
    let help = BarMenu { label: "Help", items: [plain("About", "", noting(log, "about"))] }
    [file, edit, help]
}

fn menu_bar_view(look: Theme, bar: MenuBar, menus: BarMenu[]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        ui.div().size(400.0, 300.0).child(menu_bar_element(look, bar, menus))
    }
}

fn menu_bar_case() -> MenuBarCase {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let bar = menu_bar_new(cx, "bar", 3)
    MenuBarCase { cx, log, bar, view: menu_bar_view(look, bar, menu_bar_menus(log)) }
}

fn menu_bar_label_of(index: i64) -> str {
    "bar-label-{index}"
}

fn menu_bar_row_of(menu: i64, index: i64) -> str {
    "bar-menu-{menu}-{index}"
}

fn menu_bar_shows(c: MenuBarCase, index: i64) -> bool {
    shot(c.cx, c.view)
    ui.bounds_of(c.cx, "bar-menu-{index}") != none
}

fn menu_bar_clicked(c: MenuBarCase, id: str) {
    shot(c.cx, c.view)
    click_key(c.cx, id)
}

fn test_the_bar_is_seven_and_a_half_pixels_a_letter_and_twenty_four_a_label_wide(t: *testing.T) {
    same_number(t, menu_bar_width(["File", "Edit", "Help"]), 3.0 * 24.0 + 12.0 * 7.5)
    same_number(t, menu_bar_width([]), 0.0)
}

fn test_a_click_on_a_label_opens_its_menu_and_a_second_click_closes_it(t: *testing.T) {
    let c = menu_bar_case()
    t.is_false(menu_bar_is_open(c.bar))
    menu_bar_clicked(c, menu_bar_label_of(1))
    t.is_true(menu_bar_shows(c, 1))
    t.is_true(menu_bar_is_open(c.bar))
    menu_bar_clicked(c, menu_bar_label_of(1))
    t.is_false(menu_bar_shows(c, 1))
    t.is_false(menu_bar_is_open(c.bar))
}

fn test_moving_over_another_label_while_a_menu_is_open_swaps_the_open_menu(t: *testing.T) {
    let c = menu_bar_case()
    move_to(c.cx, 1.0, 1.0)
    shot(c.cx, c.view)
    let over = centre_of(c.cx, menu_bar_label_of(2))
    move_to(c.cx, over.x, over.y)
    t.is_false(menu_bar_shows(c, 2))
    menu_bar_clicked(c, menu_bar_label_of(0))
    t.is_true(menu_bar_shows(c, 0))
    let next = centre_of(c.cx, menu_bar_label_of(2))
    move_to(c.cx, next.x, next.y)
    t.is_true(menu_bar_shows(c, 2))
    t.is_false(menu_bar_shows(c, 0))
}

fn test_left_and_right_in_an_open_menu_open_the_neighbour_and_wrap(t: *testing.T) {
    let c = menu_bar_case()
    menu_bar_clicked(c, menu_bar_label_of(0))
    shot(c.cx, c.view)
    key_down(c.cx, platform.NamedKey.Left)
    t.is_true(menu_bar_shows(c, 2))
    key_down(c.cx, platform.NamedKey.Right)
    t.is_true(menu_bar_shows(c, 0))
    key_down(c.cx, platform.NamedKey.Right)
    t.is_true(menu_bar_shows(c, 1))
    t.is_false(menu_bar_shows(c, 0))
}

fn test_choosing_a_row_closes_the_menu_and_runs_it(t: *testing.T) {
    let c = menu_bar_case()
    menu_bar_clicked(c, menu_bar_label_of(0))
    menu_bar_clicked(c, menu_bar_row_of(0, 1))
    t.is_false(menu_bar_shows(c, 0))
    t.equal_slice(ui.get(c.log), ["open"])
}

fn menu_bar_focused_view(look: Theme, bar: MenuBar, menus: BarMenu[]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        let field = ui.div().id("field").size(100.0, 40.0).focusable()
        ui.div().size(400.0, 300.0).child(menu_bar_element(look, bar, menus)).child(ui.div().absolute().top(100.0).child(field))
    }
}

fn test_closing_the_bar_returns_focus_to_what_had_it_before_the_press_took_it(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let bar = menu_bar_new(cx, "bar", 3)
    let view = menu_bar_focused_view(look, bar, menu_bar_menus(log))
    shot(cx, view)
    ui.set_focus(cx, "field")
    let over = centre_of(cx, menu_bar_label_of(1))
    move_to(cx, over.x, over.y)
    click_at(cx, over.x, over.y)
    shot(cx, view)
    t.is_true(menu_bar_is_open(bar))
    key_down(cx, platform.NamedKey.Escape)
    t.is_false(menu_bar_is_open(bar))
    t.equal(ui.focused(cx), "field")
}

fn test_a_press_opens_the_menu_before_the_button_is_released(t: *testing.T) {
    let c = menu_bar_case()
    shot(c.cx, c.view)
    let over = centre_of(c.cx, menu_bar_label_of(0))
    move_to(c.cx, over.x, over.y)
    ui.dispatch(c.cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: over.x, y: over.y }))
    t.is_true(menu_bar_is_open(c.bar))
}

