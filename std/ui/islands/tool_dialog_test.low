import std/testing
import std/ui
import std/ui/scene

fn tool_dialog_view(look: Theme, cx: ui.Context) -> fn() -> ui.Element {
    let d = ToolDialog { id: "tool", title: "Settings", width: 300.0, height: 200.0 }
    fn() -> ui.Element {
        let content = ui.div().grow(1.0)
        ui.row(ui.div()).relative().size(400.0, 300.0).child(tool_dialog(cx, look, Art {}, "default", d, ui.div(), content))
    }
}

fn close_lit(sc: scene.Scene) -> scene.Quad[] {
    let red = ui.rgb(caption_close_hover)
    var out: scene.Quad[] = []
    for q in filled(sc) {
        if near(q.background.r, red.r) && near(q.background.g, red.g) && near(q.background.b, red.b) {
            out.push(q)
        }
    }
    out
}

fn test_the_lit_close_button_rounds_its_top_right_corner_inside_the_window_border(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = tool_dialog_view(look, cx)
    shot(cx, view)
    t.equal(close_lit(shot(cx, view)).len, 0)
    let close = centre_of(cx, "tool-close")
    move_to(cx, close.x, close.y)
    let lit = close_lit(shot(cx, view))
    t.equal(lit.len, 1)
    let frame = bounds_for(cx, "tool-window")
    same_number(t, lit[0].bounds.x + lit[0].bounds.width, frame.x + frame.width - 1.0)
    same_number(t, lit[0].bounds.y, frame.y + 1.0)
    same_number(t, lit[0].corner_radii.top_right, radius_large - 1.0)
    same_number(t, lit[0].corner_radii.top_left, 0.0)
    same_number(t, lit[0].corner_radii.bottom_right, 0.0)
    same_number(t, lit[0].corner_radii.bottom_left, 0.0)
}
