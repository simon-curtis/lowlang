import std/ui
import std/ui/geometry
import std/ui/platform

/// The style of a `button`: `Primary` is filled with the accent, `Secondary` is outlined and `Unavailable` is flat and ignores clicks.
pub enum ButtonKind {
    /// A button filled with the accent colour.
    Primary
    /// A button outlined with the border colour.
    Secondary
    /// A flat, faint button with an arrow cursor that does not call its handler.
    Unavailable
}

/// The font weight of medium text, `500`.
pub const medium: i64 = 500
/// The font weight of semibold text, `600`.
pub const semibold: i64 = 600
/// The family name of the font that interface text is set in.
pub const ui_font: str = "Segoe UI Variable Text"
/// The family name of the monospace font that code is set in.
pub const code_font: str = "Cascadia Mono"

fn hovered(background: geometry.Color) -> fn(ui.Visual) -> ui.Visual {
    fn(v: ui.Visual) -> ui.Visual { v.with_background(background) }
}

fn hovered_text(colour: geometry.Color) -> fn(ui.Visual) -> ui.Visual {
    fn(v: ui.Visual) -> ui.Visual { v.with_text_color(colour) }
}

fn hovered_both(background: geometry.Color, colour: geometry.Color) -> fn(ui.Visual) -> ui.Visual {
    fn(v: ui.Visual) -> ui.Visual { v.with_background(background).with_text_color(colour) }
}

/// Returns a square, `control_height` wide holder for `glyph` drawn in the muted colour, with no click handling.
pub fn icon_slot(t: Theme, glyph: str) -> ui.Element {
    ui.row(ui.div()).size(control_height, control_height).shrink(0.0).items_center().justify_center().child(icon_in(glyph, tool_icon_size, t.muted))
}

/// A square icon button whose click handler is given the click, for a button that opens something at the pointer.
pub fn icon_button_at(t: Theme, name: str, glyph: str, clicked: fn(ui.ClickEvent)) -> ui.Element {
    ui.row(ui.div()).id(name).size(control_height, control_height).shrink(0.0).items_center().justify_center().rounded(radius).cursor(platform.Cursor.Pointer).hover(hovered(t.hover)).on_click(clicked).child(icon_in(glyph, tool_icon_size, t.muted))
}

/// Returns a square icon button named `name` showing `glyph`, which calls `clicked` when clicked.
pub fn icon_button(t: Theme, name: str, glyph: str, clicked: fn()) -> ui.Element {
    icon_button_at(t, name, glyph, click(clicked))
}

/// Returns a square icon button like `icon_button` whose icon is drawn in `colour` in place of the muted colour.
pub fn tool_icon(t: Theme, name: str, glyph: str, colour: geometry.Color, clicked: fn()) -> ui.Element {
    ui.row(ui.div()).id(name).size(control_height, control_height).shrink(0.0).items_center().justify_center().rounded(radius).cursor(platform.Cursor.Pointer).hover(hovered(t.hover)).on_click(click(clicked)).child(icon_in(glyph, tool_icon_size, colour))
}

/// A square icon button, `size` wide, that is lit with the accent's soft tint while `on` and bare until hovered otherwise. Its icon stays muted either way.
pub fn toggle_button(t: Theme, name: str, glyph: str, on: bool, size: f32, clicked: fn()) -> ui.Element {
    let base = ui.row(ui.div()).id(name).size(size, size).shrink(0.0).items_center().justify_center().rounded(radius).cursor(platform.Cursor.Pointer).on_click(click(clicked)).child(icon_in(glyph, tool_icon_size, t.muted))
    if on {
        base.background(t.accent_soft)
    } else {
        base.hover(hovered(t.hover))
    }
}

/// Returns a square, larger icon button for the side rail, named `name`, which calls `clicked` when clicked. It is lit while `on` and drawn at half opacity while `dimmed`.
pub fn rail_button(t: Theme, name: str, glyph: str, on: bool, dimmed: bool, clicked: fn()) -> ui.Element {
    let colour = if on { t.text } else { t.muted }
    let base = ui.row(ui.div()).id(name).size(rail_button_size, rail_button_size).shrink(0.0).items_center().justify_center().rounded(radius_large).cursor(platform.Cursor.Pointer).on_click(click(clicked)).child(icon_in(glyph, rail_icon_size, colour))
    let shown = if on { base.background(t.rail_selected) } else { base.hover(hovered(t.hover)) }
    if dimmed {
        shown.opacity(0.5)
    } else {
        shown
    }
}

/// Returns a button named `name` labelled `label` and styled by `kind`, which calls `clicked` when clicked. An `Unavailable` button never calls it.
pub fn button(t: Theme, name: str, label: str, kind: ButtonKind, clicked: fn()) -> ui.Element {
    let base = ui.row(ui.div()).id(name).height(control_height).shrink(0.0).items_center().justify_center().gap(step(2.0)).padding_xy(12.0, 0.0).rounded(radius).text_size(body_size).font_weight(medium).child(ui.text(label))
    match kind {
        Primary => base.cursor(platform.Cursor.Pointer).on_click(click(clicked)).background(t.accent).text_color(t.on_accent).hover(hovered(geometry.with_alpha(t.accent, 0.9)))
        Secondary => base.cursor(platform.Cursor.Pointer).on_click(click(clicked)).border(1.0, t.border).text_color(t.text).hover(hovered(t.hover))
        Unavailable => base.cursor(platform.Cursor.Arrow).background(t.control).text_color(t.faint)
    }
}

fn tool(name: str, glyph: str, colour: geometry.Color, label: str) -> ui.Element {
    ui.row(ui.div()).id(name).height(control_height).shrink(0.0).items_center().gap(step(1.5)).padding_xy(step(2.0), 0.0).rounded(radius).cursor(platform.Cursor.Pointer).text_size(small_size).child(small_icon_in(glyph, colour)).child(ui.text(label).shrink(0.0))
}

/// Returns a toolbar button named `name` showing a small icon in `colour` beside `label`, which calls `clicked` when clicked.
pub fn tool_button(t: Theme, name: str, glyph: str, colour: geometry.Color, label: str, clicked: fn()) -> ui.Element {
    tool(name, glyph, colour, label).text_color(t.text).hover(hovered(t.hover)).on_click(click(clicked))
}

fn menu_item(t: Theme, name: str, label: str) -> ui.Element {
    ui.row(ui.div()).id(name).height(control_height).shrink(0.0).items_center().padding_xy(step(2.0), 0.0).rounded(radius).cursor(platform.Cursor.Pointer).text_size(body_size).text_color(t.text).hover(hovered(t.hover)).child(ui.text(label).shrink(0.0))
}

/// Returns a closed drop-down field named `name` showing `glyph` and `label`, which calls `clicked` when clicked. A `label` of `none` shows `placeholder` in the faint colour, and the field is between 150 and 260 px wide.
pub fn dropdown(t: Theme, name: str, glyph: str, label: str?, placeholder: str, clicked: fn()) -> ui.Element {
    let chosen = label != none
    let shown = label ?? placeholder
    let colour = if chosen { t.text } else { t.faint }
    let text = ui.row(ui.div()).grow(1.0).min_width(0.0).overflow_hidden().child(ui.text(shown).text_color(colour).ellipsis())
    ui.row(ui.div()).id(name).height(control_height).min_width(150.0).max_width(260.0).shrink(1.0).items_center().gap(step(2.0)).padding_left(step(2.0)).padding_right(step(1.5)).rounded(radius).background(t.control).border(1.0, t.border).cursor(platform.Cursor.Pointer).text_size(small_size).hover(hovered(t.selected)).on_click(click(clicked)).child(small_icon_in(glyph, t.muted)).child(text).child(small_icon_in("chevrons-up-down", t.faint))
}

/// Returns a selectable list row named `name`, which calls `clicked` when clicked. A `selected` row is filled and the others are muted until hovered.
pub fn row(t: Theme, name: str, selected: bool, clicked: fn()) -> ui.Element {
    row_with_clicks(t, name, selected, click(clicked))
}

/// Returns a `row` whose handler is given the click, for a row that acts on the pointer position.
pub fn row_with_clicks(t: Theme, name: str, selected: bool, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let base = ui.row(ui.div()).id(name).height(control_height).shrink(0.0).items_center().gap(step(2.0)).padding_xy(step(2.0), 0.0).rounded(radius).cursor(platform.Cursor.Pointer).text_size(body_size).overflow_hidden().on_click(clicked)
    if selected {
        base.background(t.selected).text_color(t.text)
    } else {
        base.text_color(t.muted).hover(hovered_both(t.hover, t.text))
    }
}

fn ringed(colour: geometry.Color) -> fn(ui.Visual) -> ui.Visual {
    fn(v: ui.Visual) -> ui.Visual { v.with_border_color(colour) }
}

/// The element with a one-pixel ring in the accent colour while it holds keyboard focus, and a transparent one that keeps its size the rest of the time.
pub fn focus_ring(t: Theme, e: ui.Element) -> ui.Element {
    ui.focus(e.border(1.0, geometry.with_alpha(t.accent, 0.0)).rounded(radius), ringed(t.accent))
}

/// Returns a rounded track holding `items`, which are `segment`s, in a row.
pub fn segmented(t: Theme, items: ui.Element[]) -> ui.Element {
    ui.row(ui.div()).shrink(0.0).gap(2.0).padding(2.0).rounded(radius).background(t.control).children(items)
}

/// Returns one choice of a `segmented` track, named `name` and labelled `label`, which calls `clicked` when clicked. The `selected` segment is raised with a border and drawn in medium weight.
pub fn segment(t: Theme, name: str, label: str, selected: bool, clicked: fn()) -> ui.Element {
    let base = ui.row(ui.div()).id(name).height(control_height - 4.0).items_center().justify_center().padding_xy(10.0, 0.0).rounded(radius).cursor(platform.Cursor.Pointer).text_size(small_size).on_click(click(clicked)).child(ui.text(label))
    if selected {
        base.background(t.rail_selected).border(1.0, t.border).text_color(t.text).font_weight(medium)
    } else {
        base.border(1.0, geometry.Color {}).text_color(t.muted).hover(hovered_text(t.text))
    }
}

/// Returns a row of `items`, which are `tab`s, at least `tab_height` high.
pub fn tabs(items: ui.Element[]) -> ui.Element {
    ui.row(ui.div()).shrink(0.0).gap(step(4.0)).min_height(tab_height).children(items)
}

/// Returns a text tab named `name` and labelled `label`, which calls `clicked` when clicked. A `selected` tab has an accent underline and the others are muted until hovered.
pub fn tab(t: Theme, name: str, label: str, selected: bool, clicked: fn()) -> ui.Element {
    let underline = if selected { t.accent } else { geometry.Color {} }
    let label_row = ui.row(ui.div()).grow(1.0).items_center().child(ui.text(label).shrink(0.0))
    let base = ui.column(ui.div()).id(name).shrink(0.0).padding_xy(2.0, 0.0).cursor(platform.Cursor.Pointer).text_size(small_size).on_click(click(clicked)).child(label_row).child(ui.div().height(2.0).shrink(0.0).background(underline))
    if selected {
        base.text_color(t.text).font_weight(medium)
    } else {
        base.text_color(t.muted).hover(hovered_text(t.text))
    }
}

/// Returns a 15 px box named `name` with `label` beside it, which calls `clicked` when clicked. The box is filled with the accent and ticked while `on`.
pub fn checkbox(t: Theme, name: str, label: str, on: bool, clicked: fn()) -> ui.Element {
    let box = ui.row(ui.div()).size(15.0, 15.0).shrink(0.0).items_center().justify_center().rounded(4.0)
    let mark = if on {
        box.background(t.accent).border(1.0, t.accent).child(icon_in("check", check_icon_size, t.on_accent))
    } else {
        box.background(t.control).border(1.0, t.faint)
    }
    ui.row(ui.div()).id(name).height(24.0).items_center().gap(6.0).cursor(platform.Cursor.Pointer).text_size(small_size).on_click(click(clicked)).child(mark).child(ui.text(label))
}

/// The space in pixels between tab chips and between a chip and the edges of the header band.
pub const tab_chip_spacing: f32 = 6.0
const tab_chip_height: f32 = header_height - 1.0 - tab_chip_spacing * 2.0
const tab_chip_widest: f32 = 340.0

const unsaved_dot: f32 = 6.0

fn opaque(v: ui.Visual) -> ui.Visual {
    v.with_opacity(1.0)
}

fn transparent(v: ui.Visual) -> ui.Visual {
    v.with_opacity(0.0)
}

fn close_slot(t: Theme, name: str, dirty: bool, closed: fn()) -> ui.Element {
    let close = tooltip(t, icon_button(t, "{name}-close", "x", closed), "Close")
    if !dirty {
        return close
    }
    let dot = ui.div().size(unsaved_dot, unsaved_dot).rounded(unsaved_dot / 2.0).background(t.muted)
    let mark = ui.row(ui.div()).absolute().inset(0.0).items_center().justify_center().group_hover("{name}-group", transparent).child(dot)
    ui.div().relative().shrink(0.0).child(mark).child(close.opacity(0.0).group_hover("{name}-group", opaque))
}

/// Returns a tab chip for a document named `name` with `label` and a close button, which calls `clicked` when the chip is clicked and `closed` when the close button is. `place` is drawn after the label in the faint colour when it is not `none`, a plug icon marks a chip that is not `connected`, and a dot stands in for the close button on a `dirty` chip until the pointer is over it.
pub fn tab_chip(t: Theme, name: str, label: str, place: str?, connected: bool, dirty: bool, selected: bool, clicked: fn(), closed: fn()) -> ui.Element {
    var parts: ui.Element[] = []
    if !connected {
        parts.push(small_icon_in("unplug", t.faint))
    }
    parts.push(ui.text(label).text_size(small_size).shrink(0.0))
    match place {
        some(shown) => parts.push(ui.row(ui.div()).min_width(0.0).overflow_hidden().text_size(caption_size).text_color(t.faint).child(ui.text(shown).ellipsis_start()))
        none => {}
    }
    parts.push(close_slot(t, name, dirty, closed))
    let base = ui.row(ui.div()).id(name).group("{name}-group").height(tab_chip_height).max_width(tab_chip_widest).shrink(0.0).items_center().gap(step(2.0)).padding_left(step(3.0)).padding_right(step(1.0)).overflow_hidden().rounded(radius).cursor(platform.Cursor.Pointer).on_click(click(clicked)).children(parts)
    if selected {
        base.background(t.rail_selected).text_color(t.text)
    } else {
        base.text_color(t.muted).hover(hovered(t.hover))
    }
}

/// A tab for a comparison rather than a file: a compare icon, the title, and a close button, with no unsaved mark.
pub fn compare_chip(t: Theme, name: str, label: str, selected: bool, clicked: fn(), closed: fn()) -> ui.Element {
    let title = ui.row(ui.div()).min_width(0.0).overflow_hidden().text_size(small_size).child(ui.text(label).nowrap().ellipsis())
    let base = ui.row(ui.div()).id(name).height(tab_chip_height).max_width(tab_chip_widest).shrink(0.0).items_center().gap(step(2.0)).padding_left(step(3.0)).padding_right(step(1.0)).overflow_hidden().rounded(radius).cursor(platform.Cursor.Pointer).on_click(click(clicked)).child(small_icon_in("git-compare-arrows", t.muted)).child(title).child(close_slot(t, name, false, closed))
    let chip = if selected {
        base.background(t.rail_selected).text_color(t.text)
    } else {
        base.text_color(t.muted).hover(hovered(t.hover))
    }
    tooltip(t, chip, label)
}

/// Returns a colour choice named `name`: a dot of `accent` over `label`, ringed while `selected`, which calls `clicked` when clicked.
pub fn swatch(t: Theme, name: str, accent: u32, label: str, selected: bool, clicked: fn()) -> ui.Element {
    let ring = if selected { ui.rgb(accent) } else { geometry.Color {} }
    let dot = ui.div().size(18.0, 18.0).shrink(0.0).rounded(9.0).background(ui.rgb(accent))
    let frame = ui.row(ui.div()).size(26.0, 26.0).shrink(0.0).items_center().justify_center().rounded(13.0).border(2.0, ring).child(dot)
    let caption = ui.text(label).text_size(caption_size).text_color(if selected { t.text } else { t.muted })
    ui.column(ui.div()).id(name).width(56.0).shrink(0.0).items_center().gap(step(1.5)).padding_xy(0.0, 4.0).rounded(radius).cursor(platform.Cursor.Pointer).hover(hovered(t.hover)).on_click(click(clicked)).child(frame).child(caption)
}

/// Returns a click handler that calls `f` and ignores the click, for a callback that takes no arguments where a handler is given the `ui.ClickEvent`.
pub fn click(f: fn()) -> fn(ui.ClickEvent) {
    fn(e: ui.ClickEvent) { f() }
}

/// A fold's header band: a chevron and caption named `name` that open and shut the section under it when clicked, then `trailing`.
pub fn section_header(t: Theme, name: str, caption: str, open: bool, toggled: fn(), trailing: ui.Element[]) -> ui.Element {
    let glyph = if open { "chevron-down" } else { "chevron-right" }
    let title = ui.row(ui.div()).id(name).shrink(0.0).items_center().gap(step(1.0)).cursor(platform.Cursor.Pointer).on_click(click(toggled)).child(small_icon(glyph)).child(field_label(t, caption))
    ui.row(ui.div()).height(control_height).shrink(0.0).items_center().gap(step(1.5)).padding_xy(step(2.0), 0.0).child(title).children(trailing)
}
