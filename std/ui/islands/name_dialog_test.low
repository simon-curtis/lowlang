import std/testing
import std/ui
import std/ui/platform

const name_dialog_id: str = "name-dialog"
const name_dialog_taken: str = "taken"

struct NameCase {
    cx: ui.Context
    look: Theme
    log: ui.Signal[str[]]
    view: fn() -> ui.Element
}

fn name_dialog_view() -> ui.Element {
    ui.div().size(400.0, 300.0)
}

fn name_dialog_answer(log: ui.Signal[str[]]) -> fn(str) -> str? {
    fn(entered: str) -> str? {
        note(log, entered)
        if entered == name_dialog_taken {
            return "{entered} already exists."
        }
        none
    }
}

fn name_dialog_opened(prefilled: str, selected: i64?) -> NameCase {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let log = new_log(cx)
    let view = name_dialog_view
    shot(cx, view)
    let card = NameCard { id: name_dialog_id, title: "Rename report", verb: "Rename", name: prefilled, selected }
    open_name_dialog(cx, look, card, name_dialog_answer(log))
    shot(cx, view)
    NameCase { cx, look, log, view }
}

fn name_dialog_typed(c: NameCase, entered: str) {
    type_text(c.cx, entered)
    shot(c.cx, c.view)
}

fn name_dialog_failure_shown(c: NameCase) -> bool {
    tinted(shot(c.cx, c.view), c.look.danger) > 0
}

fn test_a_name_dialog_opens_over_the_window_with_its_entry_focused_and_the_given_part_selected(t: *testing.T) {
    let c = name_dialog_opened("report.txt", some(6))
    t.is_true(ui.overlay_open(c.cx, name_dialog_id))
    t.equal(ui.focused(c.cx), name_dialog_entry(name_dialog_id))
    let selection = ui.field_selection(c.cx, name_dialog_entry(name_dialog_id))
    t.equal(selection.anchor, 0)
    t.equal(selection.caret, 6)
}

fn test_a_name_with_no_selection_given_is_selected_whole(t: *testing.T) {
    let c = name_dialog_opened("Release 7.9.0", none)
    let selection = ui.field_selection(c.cx, name_dialog_entry(name_dialog_id))
    t.equal(selection.anchor, 0)
    t.equal(selection.caret, 13)
}

fn test_a_name_dialog_card_is_three_sixty_wide_with_a_heading_and_a_primary_verb(t: *testing.T) {
    let c = name_dialog_opened("report.txt", some(6))
    let card = bounds_for(c.cx, "{name_dialog_id}-card")
    same_number(t, card.width, name_dialog_width)
    let confirm = bounds_for(c.cx, "dialog-confirm")
    let sc = shot(c.cx, c.view)
    var accent_fills = 0
    for q in filled(sc) {
        if near(q.bounds.x, confirm.x) && near(q.bounds.y, confirm.y) {
            accent_fills += 1
            same_colour(t, q.background, c.look.accent)
        }
    }
    t.equal(accent_fills, 1)
}

fn test_typing_replaces_the_selected_stem_and_the_verb_button_submits_the_trimmed_name(t: *testing.T) {
    let c = name_dialog_opened("report.txt", some(6))
    name_dialog_typed(c, "  notes")
    click_key(c.cx, "dialog-confirm")
    t.equal_slice(ui.get(c.log), ["notes.txt"])
    t.is_false(ui.overlay_open(c.cx, name_dialog_id))
}

fn test_enter_submits_the_name(t: *testing.T) {
    let c = name_dialog_opened("report.txt", some(6))
    name_dialog_typed(c, "notes")
    key_down(c.cx, platform.NamedKey.Enter)
    t.equal_slice(ui.get(c.log), ["notes.txt"])
    t.is_false(ui.overlay_open(c.cx, name_dialog_id))
}

fn test_a_name_the_caller_refuses_shows_its_message_and_editing_clears_it(t: *testing.T) {
    let c = name_dialog_opened(name_dialog_taken, none)
    t.is_false(name_dialog_failure_shown(c))
    click_key(c.cx, "dialog-confirm")
    t.equal_slice(ui.get(c.log), [name_dialog_taken])
    t.is_true(ui.overlay_open(c.cx, name_dialog_id))
    t.is_true(name_dialog_failure_shown(c))
    name_dialog_typed(c, "a")
    t.is_false(name_dialog_failure_shown(c))
    t.is_true(ui.overlay_open(c.cx, name_dialog_id))
}

fn test_cancel_and_escape_close_the_dialog_without_submitting(t: *testing.T) {
    let c = name_dialog_opened("report.txt", some(6))
    click_key(c.cx, "dialog-cancel")
    t.is_false(ui.overlay_open(c.cx, name_dialog_id))
    t.equal(ui.get(c.log).len, 0)
    let d = name_dialog_opened("report.txt", some(6))
    key_down(d.cx, platform.NamedKey.Escape)
    t.is_false(ui.overlay_open(d.cx, name_dialog_id))
    t.equal(ui.get(d.log).len, 0)
}
