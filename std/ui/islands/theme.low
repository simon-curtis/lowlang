import std/ui
import std/ui/geometry

/// The pixel size of one rem, 13.0. Sizes given in rem, such as the tooltip text, are multiples of it.
pub const rem_px: f32 = 13.0
/// The spacing unit in pixels, 3.25, that `step` multiplies.
pub const unit: f32 = 3.25

/// The height in pixels of a standard control, 28.0, and the edge of a square icon button.
pub const control_height: f32 = 28.0
/// The corner radius in pixels of controls and tooltips, 6.0.
pub const radius: f32 = 6.0
/// The corner radius in pixels of islands, cards, popovers and rail buttons, 10.0.
pub const radius_large: f32 = 10.0
/// The font size in pixels of body text, 13.0.
pub const body_size: f32 = 13.0
/// The font size in pixels of secondary text such as panel titles and the status strip, 12.0.
pub const small_size: f32 = 12.0
/// The font size in pixels of captions such as field labels, pills and key caps, 11.0.
pub const caption_size: f32 = 11.0
/// The font size in pixels of titles, 14.0.
pub const title_size: f32 = 14.0
/// The font size in pixels of dialog headings, 16.0.
pub const heading_size: f32 = 16.0

/// The height in pixels of the window title bar, 40.0, and of each caption button in it.
pub const title_height: f32 = 40.0
/// The height in pixels of a bar laid over content, such as a find bar, 40.0.
pub const bar_height: f32 = 40.0
/// The height in pixels of a header band including its one-pixel bottom line, 41.0.
pub const header_height: f32 = 41.0
/// The height in pixels of an information row at the head of a pane, 38.0.
pub const info_height: f32 = 38.0
/// The distance in pixels a floating element keeps from the edges of what it floats over, 12.0.
pub const float_inset: f32 = 12.0
/// The height in pixels of the status strip including its top line, 28.0.
pub const status_height: f32 = 28.0
/// The minimum height in pixels of a row of tabs, 30.0.
pub const tab_height: f32 = 30.0
/// The width in pixels of the side rail, 41.0.
pub const rail_width: f32 = 41.0
/// The edge in pixels of a square rail button, 30.0.
pub const rail_button_size: f32 = 30.0
/// The edge in pixels of the brand mark, 24.0.
pub const mark_size: f32 = 24.0

/// Returns `n` spacing units as pixels, that is `n` times `unit`.
pub fn step(n: f32) -> f32 {
    n * unit
}

/// The colours of one colour scheme, with each token named for what it paints.
pub struct Theme {
    /// The scheme the colours were built from.
    pub scheme: Scheme
    /// The colour behind every island, which is the window background.
    pub canvas: geometry.Color
    /// The fill of islands and cards.
    pub surface: geometry.Color
    /// The fill of elements raised above a surface, such as popovers, tooltips and sheet headers.
    pub raised: geometry.Color
    /// The translucent fill of a control under the pointer.
    pub hover: geometry.Color
    /// The colour of the one-pixel borders and rules inside islands.
    pub border: geometry.Color
    /// The colour of an island border.
    pub island_border: geometry.Color
    /// The colour of the window border.
    pub window_border: geometry.Color
    /// The colour of primary text.
    pub text: geometry.Color
    /// The colour of secondary text and icons.
    pub muted: geometry.Color
    /// The colour of the least prominent text, such as empty messages and unavailable controls.
    pub faint: geometry.Color
    /// The colour of lines that join items in a diagram, which is `muted` at 0.7 alpha.
    pub connector: geometry.Color
    /// The accent colour of the scheme, for primary buttons, checked marks and highlights.
    pub accent: geometry.Color
    /// The translucent fill of the selected rail button and the selected tab chip.
    pub rail_selected: geometry.Color
    /// The colour of text and icons drawn on an `accent` fill.
    pub on_accent: geometry.Color
    /// The accent at low alpha, for a softly highlighted row or button.
    pub accent_soft: geometry.Color
    /// The accent at medium alpha, for the fill of selected cells.
    pub selection: geometry.Color
    /// The translucent fill behind a search match.
    pub find_match: geometry.Color
    /// The translucent fill behind the current search match, stronger than `find_match`.
    pub find_current: geometry.Color
    /// The colour for errors and destructive actions.
    pub danger: geometry.Color
    /// The colour for success.
    pub ok: geometry.Color
    /// The colour for warnings.
    pub warn: geometry.Color
    /// The `danger` colour at low alpha, for the fill behind a line that carries an error.
    pub danger_soft: geometry.Color
    /// The translucent fill of a control at rest and of an unavailable button.
    pub control: geometry.Color
    /// The translucent fill of a selected row.
    pub selected: geometry.Color
    /// The translucent black laid over the window behind a dialog.
    pub scrim: geometry.Color
    /// The faint fill behind the line or row that holds the caret.
    pub current_line: geometry.Color
    /// The accent at medium alpha that flashes behind a line when it is jumped to.
    pub line_flash: geometry.Color
    /// The colour of whitespace marks in text.
    pub whitespace: geometry.Color
    /// The colour of a scrollbar thumb.
    pub scrollbar: geometry.Color
    /// The colour of a scrollbar thumb while it is hovered or held.
    pub scrollbar_hot: geometry.Color
    /// The colour of identifiers and other plain text in highlighted code.
    pub syntax_plain: geometry.Color
    /// The colour of comments in highlighted code.
    pub syntax_comment: geometry.Color
    /// The colour of keywords in highlighted code, which is the accent blended 30 per cent toward white.
    pub syntax_keyword: geometry.Color
    /// The colour of string literals in highlighted code.
    pub syntax_string: geometry.Color
    /// The colour of number literals in highlighted code.
    pub syntax_number: geometry.Color
    /// The colour of variables in highlighted code.
    pub syntax_variable: geometry.Color
}

fn blend_channel(from: u32, toward: u32, amount: f32, shift: u32) -> u32 {
    let start = f32((from >> shift) & 0xff)
    let end = f32((toward >> shift) & 0xff)
    let mixed = floor(start + (end - start) * amount + 0.5)
    u32(mixed) << shift
}

fn blend(colour: u32, toward: u32, amount: f32) -> u32 {
    blend_channel(colour, toward, amount, 16) | blend_channel(colour, toward, amount, 8) | blend_channel(colour, toward, amount, 0)
}

fn tint(colour: u32, alpha: u32) -> geometry.Color {
    ui.rgba((colour << 8) | alpha)
}

/// Returns the dark theme whose accent, soft accent, selection, line flash and keyword colours come from `scheme`, so an app can theme itself with a scheme of its own.
pub fn theme_of(scheme: Scheme) -> Theme {
    let muted = ui.rgb(0xa9a9b2)
    Theme {
        scheme: scheme
        canvas: ui.rgb(0x0b0b0e)
        surface: ui.rgb(0x131316)
        raised: ui.rgb(0x1c1c21)
        hover: ui.rgba(0xffffff0b)
        border: ui.rgb(0x26262b)
        island_border: ui.rgb(0x29292d)
        window_border: ui.rgb(0x444444)
        text: ui.rgb(0xe7e7ea)
        muted: muted
        faint: ui.rgb(0x8a8a94)
        connector: geometry.with_alpha(muted, 0.7)
        accent: ui.rgb(scheme.accent)
        rail_selected: ui.rgba(0xffffff24)
        on_accent: ui.rgb(0x16161a)
        accent_soft: tint(scheme.accent, 0x24)
        selection: tint(scheme.accent, 0x40)
        find_match: ui.rgba(0xf5c45140)
        find_current: ui.rgba(0xf5c45199)
        danger: ui.rgb(0xef5f67)
        ok: ui.rgb(0x4cc38a)
        warn: ui.rgb(0xf2b35b)
        danger_soft: ui.rgba(0xef5f6726)
        control: ui.rgba(0xffffff0f)
        selected: ui.rgba(0xffffff14)
        scrim: ui.rgba(0x000000a6)
        current_line: ui.rgba(0xffffff08)
        line_flash: tint(scheme.accent, 0x38)
        whitespace: ui.rgba(0xffffff2e)
        scrollbar: ui.rgb(0x3b3c3c)
        scrollbar_hot: ui.rgb(0xc0c0c1)
        syntax_plain: ui.rgb(0xe7e7ea)
        syntax_comment: ui.rgb(0x8a8a94)
        syntax_keyword: ui.rgb(blend(scheme.accent, 0xffffff, 0.3))
        syntax_string: ui.rgb(0xa5d6a7)
        syntax_number: ui.rgb(0xf2b880)
        syntax_variable: ui.rgb(0xe6cf8a)
    }
}

/// Returns the `Theme` of the scheme called `name`, or of the default scheme when no scheme has that name.
pub fn theme(name: str) -> Theme {
    theme_of(scheme_named(name))
}

/// Returns the `Theme` of the scheme called `default_scheme_name`.
pub fn default_theme() -> Theme {
    theme(default_scheme_name)
}

/// Returns the drop shadow of a popover: black at about 45 per cent alpha, 12 pixels down, blurred by 32 pixels and drawn 8 pixels inside the box edge.
pub fn popover_shadow() -> ui.BoxShadow {
    ui.BoxShadow { color: ui.rgba(0x00000073), x: 0.0, y: 12.0, blur: 32.0, spread: -8.0 }
}
