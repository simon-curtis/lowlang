import std/ui
import std/ui/geometry
import std/ui/platform

const completion_width: f32 = 380.0
const completion_row_height: f32 = 24.0
const completion_visible_rows: i64 = 10
/// The number of rows a page step moves through a completion list.
pub const completion_page: i64 = 10

/// One row of a completion list: what it names, a faint detail beside it and the icon of its kind.
pub struct CompletionRow {
    /// The text the row names.
    pub label: str
    /// A faint note beside the label; empty for none.
    pub detail: str = ""
    /// The name of the icon of the row's kind; empty for none.
    pub glyph: str = ""
}

/// How a completion list is drawn: the id it can be found by, the text shown when it holds no rows, the font family of its text, the key of the field a press on a row hands focus back to, its width and the size of its rows.
pub struct CompletionView {
    /// The element id of the list; its scrolling rows are found by the id followed by `-list`.
    pub id: str
    /// The text shown when the list holds no rows; `No suggestions` by default.
    pub empty: str = "No suggestions"
    /// The font family of the list's text; `code_font` by default.
    pub family: str = code_font
    /// The key of the field a press on a row hands focus back to; empty for none, the default.
    pub focus: str = ""
    /// The width of the list in pixels; `completion_width` by default.
    pub width: f32 = completion_width
    /// The height of each row in pixels; `completion_row_height` by default.
    pub row_height: f32 = completion_row_height
    /// The most rows shown before the list scrolls; `completion_visible_rows` by default.
    pub visible_rows: i64 = completion_visible_rows
}

fn completion_list_id(view: CompletionView) -> str {
    "{view.id}-list"
}

fn completion_edge() -> f32 {
    step(1.0)
}

fn completion_visible(view: CompletionView, count: i64) -> i64 {
    if count < view.visible_rows { count } else { view.visible_rows }
}

fn completion_viewport(view: CompletionView, count: i64) -> f32 {
    view.row_height * f32(completion_visible(view, count))
}

/// Scrolls the list the least that shows row `index`.
pub fn completion_scrolled(cx: ui.Context, view: CompletionView, count: i64, index: i64) {
    if index < 0 || index >= count {
        return
    }
    let key = completion_list_id(view)
    let top = view.row_height * f32(index)
    let bottom = top + view.row_height
    let offset = ui.scroll_offset(cx, key).y
    let viewport = completion_viewport(view, count)
    if top < offset {
        ui.scroll_to(cx, key, geometry.point(0.0, top))
    } else if bottom > offset + viewport {
        ui.scroll_to(cx, key, geometry.point(0.0, bottom - viewport))
    }
}

fn completion_pressed(cx: ui.Context, view: CompletionView, chosen: fn(i64), index: i64) {
    ui.stop_propagation(cx)
    chosen(index)
    if view.focus.len > 0 {
        ui.set_focus(cx, view.focus)
    }
}

fn completion_row(cx: ui.Context, t: Theme, view: CompletionView, row: CompletionRow, index: i64, selected: bool, chosen: fn(i64)) -> ui.Element {
    var parts: ui.Element[] = []
    parts.push(small_icon_in(row.glyph, t.muted))
    parts.push(ui.row(ui.div()).shrink(0.0).child(ui.text(row.label).nowrap()))
    parts.push(ui.row(ui.div()).flex_1().min_width(0.0).overflow_hidden().text_size(small_size).text_color(t.faint).child(ui.text(row.detail).nowrap().ellipsis()))
    let base = ui.row(ui.div()).id("{view.id}-{index}").height(view.row_height).shrink(0.0).items_center().gap(step(2.0)).padding_xy(step(2.0), 0.0).rounded(radius).on_mouse_down(platform.Button.Left, fn(e: ui.MouseDownEvent) { completion_pressed(cx, view, chosen, index) }).children(parts)
    if selected {
        return base.background(t.selected)
    }
    base
}

fn completion_rows(cx: ui.Context, t: Theme, view: CompletionView, row_at: fn(i64) -> CompletionRow, selected: i64, chosen: fn(i64)) -> fn(i64, i64) -> ui.Element[] {
    fn(first: i64, end: i64) -> ui.Element[] {
        var shown: ui.Element[] = []
        for index in first..end {
            shown.push(completion_row(cx, t, view, row_at(index), index, index == selected, chosen))
        }
        shown
    }
}

/// A list of suggestions for the text being typed, windowed so only the rows in view are asked for, drawn over the window with the corner of its first row at `at`. It never takes focus: rows act on a press, and the press hands focus back to the field the text is typed in, which keeps its caret.
pub fn completion_element(cx: ui.Context, t: Theme, view: CompletionView, count: i64, row_at: fn(i64) -> CompletionRow, selected: i64, at: geometry.Point, chosen: fn(i64)) -> ui.Element {
    var body = empty(t, view.empty)
    if count > 0 {
        let height = completion_viewport(view, count)
        body = ui.uniform_list(completion_list_id(view), count, completion_rows(cx, t, view, row_at, selected, chosen)).height(height).shrink(0.0).scrollbar(hover_scrollbars(t))
    }
    let panel = ui.column(popover(t)).id(view.id).occlude().width(view.width).padding(completion_edge()).text_size(body_size).font_family(view.family).child(body)
    ui.deferred(ui.anchored().position(at).child(panel)).priority(1)
}

/// A one-line hint that Tab does something, drawn over the window with its corner at `at` and kept 8 pixels inside the window's edges.
pub fn key_hint_element(t: Theme, id: str, chord: str, label: str, at: geometry.Point) -> ui.Element {
    let hint = ui.row(popover(t)).id(id).items_center().gap(step(2.0)).padding_xy(step(2.0), step(1.0)).text_size(small_size).text_color(t.muted).child(kbd(t, chord)).child(ui.text(label).nowrap())
    ui.deferred(ui.anchored().position(at).snap_to_window_with_margin(geometry.edges(8.0)).child(hint)).priority(1)
}
