import std/ui
import std/ui/geometry
import std/ui/platform

const sheet_value_width: f32 = 640.0
const sheet_value_height: f32 = 420.0
const sheet_overscan: i64 = 1
const sheet_line_height: f32 = 20.0
const sheet_grid_line: u32 = 0xffffff0c
const sheet_stripe: u32 = 0xffffff05
const sheet_changed: u32 = 0x4cc38a2e
const sheet_fresh: u32 = 0x4cc38a14
const sheet_entry_least_width: f32 = 160.0
const sheet_entry_extra: f32 = 6.0

struct SheetDraw {
    look: Theme
    source: SheetSource
    layout: SheetLayout
    state: SheetState
    page: SheetPage
    first_row: i64
    first_column: i64
    end_column: i64
    block: SheetBlock?
    range: SheetBlock?
}

fn sheet_layer(left: f32, top: f32, width: f32, height: f32) -> ui.Element {
    ui.div().absolute().left(left).top(top).width(width).height(height).overflow_hidden()
}

fn sheet_fits(draw: SheetDraw, column: i64) -> i64 {
    let room = draw.layout.widths[column] - sheet_cell_padding * 2.0
    let fits = i64(floor(room / draw.layout.char_width))
    if fits > 1 { fits } else { 1 }
}

fn sheet_numeric(draw: SheetDraw, column: i64) -> bool {
    column < draw.source.numeric.len && draw.source.numeric[column]
}

fn sheet_cell_box(width: f32, height: f32, content: str, colour: geometry.Color, right: bool) -> ui.Element {
    let lift = floor((height - sheet_line_height) / 2.0)
    let base = ui.text(content).nowrap().width(width).height(height).shrink(0.0).padding_xy(sheet_cell_padding, lift).overflow_hidden().text_color(colour)
    if right { base.text_right() } else { base }
}

fn sheet_row_top(draw: SheetDraw, row: i64) -> f32 {
    f32(f64(row) * f64(sheet_row_height) - draw.state.top)
}

fn sheet_column_left(draw: SheetDraw, column: i64) -> f32 {
    draw.layout.offsets[column] - draw.state.left
}

fn sheet_row_mark(draw: SheetDraw, row: i64) -> SheetRowMark {
    let marks = draw.source.marks ?? return SheetRowMark.Plain
    marks.row(row)
}

fn sheet_cell_content(draw: SheetDraw, row: i64, column: i64) -> ui.Element {
    let width = draw.layout.widths[column]
    let line = row - draw.page.first
    let slot = column - draw.page.first_column
    var cell: str? = none
    if line >= 0 && line < draw.page.rows.len && slot >= 0 && slot < draw.page.rows[line].len {
        cell = draw.page.rows[line][slot]
    }
    match cell {
        some(value) => {
            let colour = if sheet_row_mark(draw, row) == SheetRowMark.Removed { draw.look.faint } else { draw.look.text }
            sheet_cell_box(width, sheet_row_height, sheet_clip(value, sheet_fits(draw, column)), colour, sheet_numeric(draw, column))
        }
        none => sheet_cell_box(width, sheet_row_height, sheet_null_text, draw.look.faint, false)
    }
}

fn sheet_cell_row(draw: SheetDraw, row: i64) -> ui.Element {
    var cells: ui.Element[] = []
    for column in draw.first_column..draw.end_column {
        cells.push(sheet_cell_content(draw, row, column))
    }
    ui.row(ui.div()).absolute().left(sheet_column_left(draw, draw.first_column)).top(sheet_row_top(draw, row)).height(sheet_row_height).children(cells)
}

fn sheet_last_row(draw: SheetDraw) -> i64 {
    draw.first_row + draw.page.rows.len
}

fn sheet_cells_layer(draw: SheetDraw) -> ui.Element {
    var rows: ui.Element[] = []
    for row in draw.first_row..sheet_last_row(draw) {
        rows.push(sheet_cell_row(draw, row))
    }
    sheet_layer(draw.layout.gutter, sheet_header_height, draw.layout.view_width, draw.layout.view_height).children(rows)
}

fn sheet_stripe_layer(draw: SheetDraw) -> ui.Element {
    var rows: ui.Element[] = []
    let current = draw.state.cell
    for row in draw.first_row..sheet_last_row(draw) {
        let top = sheet_row_top(draw, row)
        let reach = draw.layout.gutter + draw.layout.view_width
        match sheet_row_mark(draw, row) {
            Removed => rows.push(ui.div().absolute().left(0.0).top(top).width(reach).height(sheet_row_height).background(draw.look.danger_soft))
            Added => rows.push(ui.div().absolute().left(0.0).top(top).width(reach).height(sheet_row_height).background(ui.rgba(sheet_fresh)))
            Plain => {
                if row % 2 == 1 {
                    rows.push(ui.div().absolute().left(0.0).top(top).width(reach).height(sheet_row_height).background(ui.rgba(sheet_stripe)))
                }
            }
        }
        match current {
            some(at) => {
                if at.row == row {
                    rows.push(ui.div().absolute().left(0.0).top(top).width(draw.layout.gutter + draw.layout.view_width).height(sheet_row_height).background(draw.look.current_line))
                }
            }
            none => {}
        }
    }
    sheet_layer(0.0, sheet_header_height, draw.layout.gutter + draw.layout.view_width, draw.layout.view_height).children(rows)
}

fn sheet_fill(draw: SheetDraw, x: f32, y: f32, width: f32, height: f32, colour: geometry.Color) -> ui.Element {
    let left = if x > 0.0 { x } else { 0.0 }
    let top = if y > 0.0 { y } else { 0.0 }
    let right_edge = x + width
    let bottom_edge = y + height
    let right = if right_edge < draw.layout.view_width { right_edge } else { draw.layout.view_width }
    let bottom = if bottom_edge < draw.layout.view_height { bottom_edge } else { draw.layout.view_height }
    if right <= left || bottom <= top {
        return ui.div().absolute()
    }
    ui.div().absolute().left(left).top(top).width(right - left).height(bottom - top).background(colour)
}

fn sheet_block_fill(draw: SheetDraw, block: SheetBlock, colour: geometry.Color) -> ui.Element {
    let last = block.end_column - 1
    if block.first_column >= draw.layout.widths.len || last >= draw.layout.widths.len {
        return ui.div().absolute()
    }
    let x = draw.layout.offsets[block.first_column] - draw.state.left
    let width = draw.layout.offsets[last] + draw.layout.widths[last] - draw.layout.offsets[block.first_column]
    let y = f32(f64(block.first_row) * f64(sheet_row_height) - draw.state.top)
    let height = f32(f64(sheet_block_rows(block)) * f64(sheet_row_height))
    sheet_fill(draw, x, y, width, height, colour)
}

fn sheet_changed_fills(draw: SheetDraw) -> ui.Element[] {
    var fills: ui.Element[] = []
    let marks = draw.source.marks ?? return fills
    for row in draw.first_row..sheet_last_row(draw) {
        for column in draw.first_column..draw.end_column {
            if marks.changed(row, column) {
                fills.push(sheet_block_fill(draw, SheetBlock { first_row: row, end_row: row + 1, first_column: column, end_column: column + 1 }, ui.rgba(sheet_changed)))
            }
        }
    }
    fills
}

fn sheet_selection_layer(draw: SheetDraw) -> ui.Element {
    var fills: ui.Element[] = sheet_changed_fills(draw)
    match draw.range {
        some(range) => fills.push(sheet_block_fill(draw, range, draw.look.accent_soft))
        none => {}
    }
    match draw.state.cell {
        some(at) => fills.push(sheet_block_fill(draw, SheetBlock { first_row: at.row, end_row: at.row + 1, first_column: at.column, end_column: at.column + 1 }, draw.look.selection))
        none => {}
    }
    sheet_layer(draw.layout.gutter, sheet_header_height, draw.layout.view_width, draw.layout.view_height).children(fills)
}

fn sheet_row_chosen(draw: SheetDraw, row: i64) -> bool {
    match draw.range {
        some(block) => sheet_block_has_row(block, row)
        none => false
    }
}

fn sheet_gutter_layer(draw: SheetDraw) -> ui.Element {
    var numbers: ui.Element[] = []
    for row in draw.first_row..sheet_last_row(draw) {
        let colour = if sheet_row_chosen(draw, row) { draw.look.text } else { draw.look.faint }
        let number = sheet_cell_box(draw.layout.gutter, sheet_row_height, "{row + 1}", colour, true)
        numbers.push(number.absolute().left(0.0).top(sheet_row_top(draw, row)))
    }
    sheet_layer(0.0, sheet_header_height, draw.layout.gutter, draw.layout.view_height).children(numbers)
}

fn sheet_column_chosen(draw: SheetDraw, column: i64) -> bool {
    match draw.range {
        some(block) => sheet_block_has_column(block, column)
        none => false
    }
}

fn sheet_header_label(draw: SheetDraw, column: i64) -> str {
    let fits = sheet_fits(draw, column)
    let name = draw.source.columns[column]
    match draw.state.sort {
        some(sorted) => {
            if sorted.column == column {
                let room = if fits > 3 { fits - 2 } else { 1 }
                let mark = if sorted.descending { "↓" } else { "↑" }
                return "{sheet_clip(name, room)} {mark}"
            }
            sheet_clip(name, fits)
        }
        none => sheet_clip(name, fits)
    }
}

fn sheet_header_cell(draw: SheetDraw, column: i64) -> ui.Element {
    let colour = if sheet_column_chosen(draw, column) { draw.look.text } else { draw.look.muted }
    sheet_cell_box(draw.layout.widths[column], sheet_header_height - 1.0, sheet_header_label(draw, column), colour, sheet_numeric(draw, column)).font_weight(semibold)
}

fn sheet_header_layer(draw: SheetDraw) -> ui.Element {
    var cells: ui.Element[] = []
    for column in draw.first_column..draw.end_column {
        cells.push(sheet_header_cell(draw, column))
    }
    let strip = ui.row(ui.div()).absolute().left(sheet_column_left(draw, draw.first_column)).top(0.0).height(sheet_header_height - 1.0).children(cells)
    sheet_layer(draw.layout.gutter, 0.0, draw.layout.view_width, sheet_header_height).child(strip)
}

fn sheet_divider_colour(draw: SheetDraw, column: i64) -> geometry.Color {
    match draw.state.resize {
        some(resize) => {
            if resize.column == column {
                return draw.look.accent
            }
            ui.rgba(sheet_grid_line)
        }
        none => ui.rgba(sheet_grid_line)
    }
}

fn sheet_lines_layer(draw: SheetDraw) -> ui.Element {
    var lines: ui.Element[] = []
    for column in draw.first_column..draw.end_column {
        let x = draw.layout.gutter + sheet_column_left(draw, column) + draw.layout.widths[column] - 1.0
        if x >= draw.layout.gutter && x < draw.layout.gutter + draw.layout.view_width {
            lines.push(ui.div().absolute().left(x).top(0.0).width(1.0).height(sheet_header_height + draw.layout.view_height).background(sheet_divider_colour(draw, column)))
            lines.push(ui.div().absolute().left(x - sheet_edge_reach).top(0.0).width(sheet_edge_reach * 2.0 + 1.0).height(sheet_header_height).cursor(platform.Cursor.ResizeLeftRight))
        }
    }
    lines.push(ui.div().absolute().left(0.0).top(sheet_header_height - 1.0).width(draw.layout.gutter + draw.layout.view_width).height(1.0).background(draw.look.border))
    lines.push(ui.div().absolute().left(draw.layout.gutter - 1.0).top(0.0).width(1.0).height(sheet_header_height + draw.layout.view_height).background(draw.look.border))
    sheet_layer(0.0, 0.0, draw.layout.width, sheet_header_height + draw.layout.view_height).children(lines)
}

fn sheet_value_card(look: Theme, frame: SheetFrame, value: SheetValue) -> ui.Element {
    let title = ui.div().grow(1.0).min_width(0.0).overflow_hidden().text_size(small_size).text_color(look.muted).child(ui.text(value.title).nowrap().ellipsis())
    let head = ui.row(ui.div()).items_center().gap(step(2.0)).padding_xy(step(3.0), 0.0).height(control_height + 8.0).border_bottom(1.0).border_color(look.border).child(title).child(icon_button(look, "value-copy", "copy", fn() { sheet_value_copied(frame, value.text) })).child(icon_button(look, "value-close", "x", fn() { sheet_value_closed(frame) }))
    let room = sheet_room(frame.host).width - 16.0
    let width = if room < sheet_value_width { room } else { sheet_value_width }
    let body = ui.div().id("value-text").max_height(sheet_value_height).overflow_scroll().padding(step(3.0)).font_family(code_font).text_size(small_size).wrapping().child(ui.text(value.shown)).scrollbar(scrollbars(look))
    let card = ui.column(popover(look)).id("value-view").occlude().width(width).on_mouse_down_out(fn(e: ui.MouseDownEvent) { sheet_value_closed(frame) }).child(head).child(body)
    ui.deferred(ui.anchored().position(value.at).snap_to_window_with_margin(geometry.edges(8.0)).child(card)).priority(1)
}

fn sheet_entry_layer(frame: SheetFrame, draw: SheetDraw) -> ui.Element {
    let open = draw.state.entry ?? return ui.div().absolute()
    if open.column < 0 || open.column >= draw.layout.widths.len {
        return ui.div().absolute()
    }
    let look = draw.look
    let width = if draw.layout.widths[open.column] > sheet_entry_least_width { draw.layout.widths[open.column] } else { sheet_entry_least_width }
    let field = ui.field(open.text).id(sheet_entry_id(frame.host)).placeholder(sheet_null_text).placeholder_color(look.faint).grow(1.0).min_width(0.0).font_family(code_font).text_size(small_size).on_change(sheet_entry_typed_in(frame)).on_key(sheet_entry_key(frame))
    let box = ui.row(ui.div()).id("{frame.host.id}-entry-box").absolute().left(sheet_column_left(draw, open.column)).top(sheet_row_top(draw, open.row)).width(width).height(sheet_row_height + sheet_entry_extra).items_center().padding_xy(step(2.0), 0.0).rounded(radius).background(look.control).border(1.0, look.accent).text_color(look.text).on_mouse_down(platform.Button.Left, fn(e: ui.MouseDownEvent) { ui.stop_propagation(frame.host.cx) }).child(field)
    sheet_layer(draw.layout.gutter, sheet_header_height, draw.layout.view_width, draw.layout.view_height).child(box)
}

fn sheet_overlays(look: Theme, frame: SheetFrame, state: SheetState) -> ui.Element[] {
    var layers: ui.Element[] = []
    var items: MenuItem[] = []
    if menu_is_open(frame.host.menu) {
        items = sheet_menu_items(frame, state)
    }
    layers.push(menu_element(look, frame.host.menu, items))
    match state.value {
        some(value) => layers.push(sheet_value_card(look, frame, value))
        none => {}
    }
    layers
}

fn sheet_draw_of(look: Theme, frame: SheetFrame, state: SheetState, room: geometry.Size) -> SheetDraw {
    let layout = sheet_layout(state, frame.source, frame.char_width, room)
    let at = sheet_clamped(state, layout)
    let first_row = sheet_first_row(at)
    let wanted = sheet_rows_shown(layout) + sheet_overscan
    let count = if first_row + wanted < layout.total { wanted } else { layout.total - first_row }
    let first_column = sheet_first_column(at, layout)
    let end_column = sheet_end_column(at, layout, first_column)
    var page = SheetPage { first: first_row, first_column, rows: [] }
    if count > 0 && end_column > first_column {
        page = frame.source.read(first_row, first_row + count, first_column, end_column)
    }
    SheetDraw { look, source: frame.source, layout, state: at, page, first_row, first_column, end_column, block: sheet_block(at), range: sheet_range(at) }
}

fn sheet_lit(colour: geometry.Color) -> fn(ui.Visual) -> ui.Visual {
    fn(v: ui.Visual) -> ui.Visual { v.with_background(colour) }
}

fn sheet_held(draw: SheetDraw, axis: SheetAxis) -> bool {
    match draw.state.grab {
        some(grab) => grab.axis == axis
        none => false
    }
}

fn sheet_thumb_element(draw: SheetDraw, axis: SheetAxis) -> ui.Element {
    let bar = sheet_thumb(draw.state, draw.layout, axis) ?? return ui.div().absolute()
    let inset: f32 = 2.0
    let rest = if sheet_held(draw, axis) { draw.look.scrollbar_hot } else { draw.look.scrollbar }
    let moving = ui.div().absolute().background(rest).rounded(sheet_bar_width / 2.0).hover(sheet_lit(draw.look.scrollbar_hot))
    match axis {
        Vertical => moving.left(bar.thumb.x + inset).top(bar.thumb.y).width(bar.thumb.width - inset * 2.0).height(bar.thumb.height)
        Horizontal => moving.left(bar.thumb.x).top(bar.thumb.y + inset).width(bar.thumb.width).height(bar.thumb.height - inset * 2.0)
    }
}

fn sheet_bars_layer(draw: SheetDraw) -> ui.Element {
    let layout = draw.layout
    let right = ui.div().absolute().left(layout.width - sheet_bar_width).top(0.0).width(sheet_bar_width).height(layout.height).background(draw.look.surface)
    let bottom = ui.div().absolute().left(0.0).top(layout.height - sheet_bar_width).width(layout.width).height(sheet_bar_width).background(draw.look.surface)
    sheet_layer(0.0, 0.0, layout.width, layout.height).child(right).child(bottom).child(sheet_thumb_element(draw, SheetAxis.Vertical)).child(sheet_thumb_element(draw, SheetAxis.Horizontal))
}

fn sheet_failure_text(look: Theme, draw: SheetDraw) -> ui.Element {
    match draw.page.failure {
        some(reason) => ui.div().absolute().left(draw.layout.gutter + step(3.0)).top(sheet_header_height + step(2.0)).text_size(small_size).text_color(look.danger).child(ui.text(reason))
        none => ui.div().absolute()
    }
}

/// The sheet: a header band and a row-number gutter drawn from the same scroll offsets as the cells, so both stay in place while the cells scroll in either direction, over a source of any number of rows and columns.
pub fn sheet_view(look: Theme, ruler: Ruler, host: SheetHost, source: SheetSource, state: SheetState) -> ui.Element {
    let char_width = ruler_width(ruler, "0", sheet_text_size)
    let frame = SheetFrame { host, source, char_width }
    if ui.bounds_of(host.cx, host.id) == none {
        ui.post(ui.handle(host.cx), fn() {})
    }
    let draw = sheet_draw_of(look, frame, state, sheet_room(host))
    var layers: ui.Element[] = [
        ui.div().absolute().left(0.0).top(0.0).width(draw.layout.gutter + draw.layout.view_width).height(sheet_header_height).background(look.raised)
        sheet_stripe_layer(draw)
        sheet_selection_layer(draw)
        sheet_cells_layer(draw)
        sheet_gutter_layer(draw)
        sheet_header_layer(draw)
        sheet_lines_layer(draw)
        sheet_bars_layer(draw)
        sheet_failure_text(look, draw)
        sheet_entry_layer(frame, draw)
    ]
    for overlay in sheet_overlays(look, frame, state) {
        layers.push(overlay)
    }
    let root = ui.div().id(host.id).relative().grow(1.0).min_width(0.0).min_height(0.0).overflow_hidden().background(look.surface).text_size(sheet_text_size).focusable()
    let keyed = if state.entry == none { root.key_context(sheet_context) } else { root }
    let handled = keyed.on_key(sheet_key(frame)).on_scroll_wheel(fn(e: ui.ScrollEvent) { sheet_wheeled_by(frame, e) }).on_mouse_down(platform.Button.Left, fn(e: ui.MouseDownEvent) { sheet_pressed(frame, e) }).on_mouse_down(platform.Button.Right, fn(e: ui.MouseDownEvent) { sheet_context_opened(frame, e.position) }).on_mouse_up(platform.Button.Left, fn(e: ui.MouseUpEvent) { sheet_let_go(frame, e) }).on_mouse_up_out(platform.Button.Left, fn(e: ui.MouseUpEvent) { sheet_let_go(frame, e) }).on_drag("sheet-grab", host.id, fn(grabbed: str) -> ui.Element { ui.div() }).on_drag_move("sheet-grab", fn(e: ui.DragMoveEvent) { sheet_dragged(frame, e) })
    sheet_actions(frame, handled.children(layers))
}
