import std/testing
import std/ui
import std/ui/geometry
import std/ui/scene

fn code_block_of(lines: str[], room: geometry.Size) -> CodeBlock {
    let count = fn() -> i64 { lines.len }
    let line = fn(i: i64) -> str { lines[i] }
    let source = ui.line_source(count, line, fn(e: ui.TextEdit) {})
    CodeBlock { id: "block", source, room, total: lines.len, first: 0, family: code_font, size: small_size }
}

fn test_a_code_blocks_text_begins_where_its_gutter_ends(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let block = code_block_of(["SELECT 1", "FROM a", "WHERE b"], geometry.size(300.0, 100.0))
    let paint = fn() -> ui.Element { ui.div().size(400.0, 200.0).child(code_block(look, block)) }
    shot(cx, paint)
    let area = bounds_for(cx, "block")
    same_number(t, area.x, code_gutter)
    same_number(t, area.width, 300.0 - code_gutter)
    same_number(t, area.height, 100.0)
}

fn test_a_gutter_numbers_only_the_lines_a_window_can_show_and_never_past_the_last(t: *testing.T) {
    t.equal(gutter_end(0, 100.0, code_row, 3), 3)
    t.equal(gutter_end(5, 180.0, code_row, 1000), 5 + 10 + 2)
    t.equal(gutter_end(998, 180.0, code_row, 1000), 1000)
}

fn test_a_gutter_is_as_wide_as_its_widest_number_plus_the_padding_either_side(t: *testing.T) {
    let r = ruler()
    let narrow = gutter_width(r, 9, 13.0)
    let wide = gutter_width(r, 1000, 13.0)
    t.is_true(wide > narrow)
    same_number(t, narrow, ruler_width(r, "9", 13.0) + gutter_padding * 2.0)
}

const marked_row: f32 = 18.0

fn marked_view(look: Theme, marks: GutterMark[], current: i64) -> fn() -> ui.Element {
    let g = Gutter { width: 50.0, row: marked_row, left: 0.0, gap: 10.0, current, marks }
    fn() -> ui.Element {
        let column = gutter_column(look, g, 0, 6)
        ui.div().size(400.0, 300.0).text_size(small_size).child(column)
    }
}

fn sprites_coloured(sc: scene.Scene, colour: geometry.Color) -> i64 {
    var found = 0
    for sprite in sc.sprites {
        if near(sprite.color.r, colour.r) && near(sprite.color.g, colour.g) && near(sprite.color.b, colour.b) && near(sprite.color.a, colour.a) {
            found += 1
        }
    }
    found
}

fn visible_chars(lines: str[]) -> i64 {
    var count = 0
    for line in lines {
        for c in line {
            if c != ' ' {
                count += 1
            }
        }
    }
    count
}

fn test_a_marked_lines_number_draws_in_the_danger_colour_and_the_rest_do_not(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let flagged = [GutterMark { line: 1, notes: ["a"] }, GutterMark { line: 3, notes: ["b"] }]
    let view = marked_view(look, flagged, -1)
    let sc = shot(cx, view)
    t.equal(sprites_coloured(sc, look.danger), 2)
    t.equal(sprites_coloured(sc, look.faint), 4)
}

fn test_a_marked_line_keeps_the_danger_colour_when_the_caret_is_on_it(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let flagged = [GutterMark { line: 2, notes: ["a"] }]
    let view = marked_view(look, flagged, 2)
    let sc = shot(cx, view)
    t.equal(sprites_coloured(sc, look.danger), 1)
    t.equal(sprites_coloured(sc, look.text), 0)
}

fn test_a_gutter_with_no_marks_draws_every_number_as_before(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let view = marked_view(look, [], 2)
    let sc = shot(cx, view)
    t.equal(sprites_coloured(sc, look.danger), 0)
    t.equal(sprites_coloured(sc, look.text), 1)
    t.equal(sprites_coloured(sc, look.faint), 5)
}

fn test_hovering_a_marked_number_lists_each_note_on_its_own_row(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let notes = ["Unclosed (", "Expected an expression"]
    let flagged = [GutterMark { line: 1, notes }]
    let view = marked_view(look, flagged, -1)
    shot(cx, view)
    move_to(cx, 10.0, marked_row * 1.5)
    ui.advance_clock(cx, 500)
    let sc = shot(cx, view)
    t.equal(sprites_coloured(sc, look.text), visible_chars(notes))
    let card = tooltip_card_of(sc, look) ?? scene.Quad { bounds: geometry.Rect {} }
    let single = [GutterMark { line: 1, notes: ["Unclosed ("] }]
    let one_view = marked_view(look, single, -1)
    let other = ui.headless(ui.rgb(0x0b0b0e))
    shot(other, one_view)
    move_to(other, 10.0, marked_row * 1.5)
    ui.advance_clock(other, 500)
    let one_scene = shot(other, one_view)
    let one_card = tooltip_card_of(one_scene, look) ?? scene.Quad { bounds: geometry.Rect {} }
    t.is_true(card.bounds.height > one_card.bounds.height + 8.0)
}

fn test_an_unmarked_number_shows_no_tooltip(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let flagged = [GutterMark { line: 1, notes: ["a"] }]
    let view = marked_view(look, flagged, -1)
    shot(cx, view)
    move_to(cx, 10.0, marked_row * 3.5)
    ui.advance_clock(cx, 500)
    let sc = shot(cx, view)
    t.is_true(tooltip_card_of(sc, look) == none)
}

fn test_a_marked_row_is_as_high_as_an_unmarked_one(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let flagged = [GutterMark { line: 1, notes: ["a"] }]
    let view = marked_view(look, flagged, -1)
    let plain = marked_view(look, [], -1)
    let flagged_scene = shot(cx, view)
    let other = ui.headless(ui.rgb(0x0b0b0e))
    let plain_scene = shot(other, plain)
    t.equal(flagged_scene.sprites.len, plain_scene.sprites.len)
    for i, sprite in flagged_scene.sprites {
        same_number(t, sprite.bounds.y, plain_scene.sprites[i].bounds.y)
        same_number(t, sprite.bounds.x, plain_scene.sprites[i].bounds.x)
    }
}

fn test_a_line_with_the_caret_and_a_problem_is_tinted_apart_from_either_alone(t: *testing.T) {
    let look = default_theme()
    let caret = line_fill(look, true, false, 0.0) ?? geometry.rgb(0)
    let problem = line_fill(look, false, true, 0.0) ?? geometry.rgb(0)
    let both = line_fill(look, true, true, 0.0) ?? geometry.rgb(0)
    same_colour(t, caret, look.current_line)
    same_colour(t, problem, look.danger_soft)
    t.is_true(both.a > problem.a)
    same_number(t, both.r, look.danger_soft.r)
    t.is_true(line_fill(look, false, false, 0.0) == none)
}

fn test_a_flash_shows_over_a_line_until_it_fades_below_the_fill_under_it(t: *testing.T) {
    let look = default_theme()
    same_colour(t, line_fill(look, true, false, 1.0) ?? geometry.rgb(0), look.line_flash)
    same_colour(t, line_fill(look, false, true, 1.0) ?? geometry.rgb(0), look.line_flash)
    let faint = line_fill(look, false, false, 0.5) ?? geometry.rgb(0)
    same_number(t, faint.r, look.line_flash.r)
    t.is_true(faint.a < look.line_flash.a)
    same_colour(t, line_fill(look, true, false, 0.01) ?? geometry.rgb(0), look.current_line)
}

fn test_a_flash_holds_then_fades_or_holds_and_stops_with_reduced_motion(t: *testing.T) {
    let end = flash_hold_ms + flash_fade_ms
    same_number(t, flash_strength(0, false), 1.0)
    same_number(t, flash_strength(flash_hold_ms - 1, false), 1.0)
    let middle = flash_strength(flash_hold_ms + flash_fade_ms / 2, false)
    t.is_true(middle > 0.0 && middle < 1.0)
    same_number(t, flash_strength(end, false), 0.0)
    same_number(t, flash_strength(end - 1, true), 1.0)
    same_number(t, flash_strength(end, true), 0.0)
}
