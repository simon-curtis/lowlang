import std/ui

const scrollbar_thumb: f32 = 5.0
const scrollbar_gap: f32 = 2.0
const scrollbar_min_thumb: f32 = 24.0

/// The bars a scrolling element or a text area draws in theme `t`, passed to `ui.scrollbar`.
pub fn scrollbars(t: Theme) -> ui.ScrollbarOptions {
    ui.ScrollbarOptions { width: scrollbar_thumb + scrollbar_gap * 2.0, min_thumb: scrollbar_min_thumb, thumb: t.scrollbar, hot: t.scrollbar_hot, inset: scrollbar_gap, hot_inset: scrollbar_gap, margin: scrollbar_gap }
}

/// The bars of `scrollbars` drawn only while the pointer is over the element or its thumb is dragged.
pub fn hover_scrollbars(t: Theme) -> ui.ScrollbarOptions {
    var o = scrollbars(t)
    o.autohide = true
    o
}
