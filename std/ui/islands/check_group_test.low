import std/testing
import std/ui

fn grouped(look: Theme, cx: ui.Context, log: ui.Signal[i64[]]) -> ui.Element {
    let pressed = fn(at: i64) { ui.update(log, fn(seen: i64[]) -> i64[] { [at] }) }
    let group = check_group(look, "grant", ["SELECT", "INSERT", "UPDATE", "DELETE", "TRUNCATE", "REFERENCES", "TRIGGER"], [true, false, false, true], pressed)
    ui.div().size(220.0, 200.0).child(group)
}

fn test_a_check_group_wraps_onto_a_second_line_and_reports_the_position_pressed(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = ui.signal(cx, [-1])
    let view = fn() -> ui.Element { grouped(look, cx, log) }
    shot(cx, view)
    let first = bounds_for(cx, "grant-0")
    let last = bounds_for(cx, "grant-6")
    t.is_true(last.y > first.y)
    click_key(cx, "grant-5")
    t.equal_slice(ui.get(log), [5])
}
