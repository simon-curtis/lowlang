import std/ui/geometry

/// The height of a row of cells, in pixels.
pub const sheet_row_height: f32 = 22.0
/// The height of the header band that holds the column names, in pixels.
pub const sheet_header_height: f32 = 26.0
/// The size of the text in cells and headers, in pixels.
pub const sheet_text_size: f32 = 12.0
/// The space between a cell's edge and its text on each side, in pixels.
pub const sheet_cell_padding: f32 = 8.0
const sheet_narrowest_width: f32 = 36.0
const sheet_widest_width: f32 = 2000.0
const sheet_edge_reach: f32 = 4.0
/// The thickness of the scrollbars at the right and bottom of the sheet, in pixels.
pub const sheet_bar_width: f32 = 10.0
const sheet_far: i64 = 1152921504606846976
const sheet_unmeasured: f32 = 1440.0
const sheet_edge_step: f32 = 40.0

/// A page of rows from a `SheetSource`: the rows from `first`, each holding the cells from `first_column`, or the reason they could not be read.
pub struct SheetPage {
    /// The index of the first row in `rows`.
    pub first: i64
    /// The index of the column that the first cell of each row belongs to.
    pub first_column: i64
    /// The rows read, each holding its cells in column order, with `none` for a cell that has no value.
    pub rows: str?[][]
    /// The reason the rows could not be read, or `none` when they were read.
    pub failure: str? = none
}

/// How a row stands out from the rest of the sheet: not at all, struck out as removed, or shaded as added.
pub enum SheetRowMark {
    /// A row drawn as the rest are.
    Plain
    /// A row drawn struck out.
    Removed
    /// A row drawn shaded.
    Added
}

/// What a source asks a sheet to mark: how each row stands out, and whether a cell's value differs from the one it was read with, which shades the cell.
pub struct SheetMarks {
    /// The function that returns how the row at an index stands out.
    pub row: fn(i64) -> SheetRowMark
    /// The function that returns whether the cell at a row and column differs from the value it was read with.
    pub changed: fn(i64, i64) -> bool
}

/// The rows a source holds before anything is laid over them, which are what a copy takes: how many there are, and a reader for any range of them.
pub struct SheetStored {
    /// The number of stored rows.
    pub total: i64
    /// The function that reads a range of stored rows, taking the same arguments as `SheetSource.read`.
    pub read: fn(i64, i64, i64, i64) -> SheetPage
}

/// What a sheet draws: column names, widths in characters, which columns hold numbers, the row count, a reader for any range of rows and columns, the marks to draw over them when there are any, and the rows a copy takes when they are not the ones drawn.
pub struct SheetSource {
    /// The column names, in order.
    pub columns: str[]
    /// The width of each column in characters, by column index.
    pub widths: i64[]
    /// Whether each column holds numbers, by column index.
    pub numeric: bool[]
    /// The number of rows.
    pub total: i64
    /// The function that reads a range of rows. It receives the first row, the end row, the first column and the end column, each end excluded, and returns a `SheetPage`.
    pub read: fn(i64, i64, i64, i64) -> SheetPage
    /// The marks to draw over the rows, or `none` for no marks.
    pub marks: SheetMarks? = none
    /// The rows a copy takes when they are not the ones drawn, or `none` when a copy takes what is drawn.
    pub stored: SheetStored? = none
}

/// The cell a sheet is taking text for in place, and the text typed so far.
pub struct SheetEntry {
    /// The index of the row of the cell.
    pub row: i64
    /// The index of the column of the cell.
    pub column: i64
    /// The text typed so far.
    pub text: str
}

/// A position in the sheet: the row and column of one cell.
pub struct SheetAt {
    /// The index of the row, from 0.
    pub row: i64
    /// The index of the column, from 0.
    pub column: i64
}

/// A rectangle of cells, from a first row and column up to but not including an end row and column.
pub struct SheetBlock {
    /// The index of the first row in the block.
    pub first_row: i64
    /// The index one past the last row in the block.
    pub end_row: i64
    /// The index of the first column in the block.
    pub first_column: i64
    /// The index one past the last column in the block.
    pub end_column: i64
}

/// How a sweep of the pointer selects: cells, whole rows or whole columns.
pub enum SheetSweep {
    /// A sweep that selects the cells between its two ends.
    Cells
    /// A sweep that selects whole rows.
    Rows
    /// A sweep that selects whole columns.
    Columns
}

/// The column a sheet is sorted by and the direction.
pub struct SheetSort {
    /// The index of the sorted column.
    pub column: i64
    /// Whether the order runs from highest to lowest, rather than lowest to highest.
    pub descending: bool
}

/// A column resize in progress: the column, where the pointer began and the width the column had then.
pub struct SheetResize {
    /// The index of the column being resized.
    pub column: i64
    /// The horizontal position of the pointer when the resize began, in pixels.
    pub from: f32
    /// The width of the column when the resize began, in pixels.
    pub width: f32
}

/// What a sheet menu is opened on.
pub enum SheetMenuKind {
    /// A column header.
    Header
    /// A cell, or the row number beside it.
    Cell
    /// The sheet as a whole, away from any cell or header.
    Table
}

/// An open sheet menu: what it is opened on, the row and column it concerns and the window position it opens at.
pub struct SheetMenu {
    /// What the menu is opened on.
    pub kind: SheetMenuKind
    /// The index of the row the menu concerns, or 0 when it concerns no row.
    pub row: i64 = 0
    /// The index of the column the menu concerns, or 0 when it concerns no column.
    pub column: i64 = 0
    /// The window position the menu opens at.
    pub at: geometry.Point = geometry.Point {}
}

/// The value card for one cell: its title, its text, the part of the text drawn and the window position it opens at.
pub struct SheetValue {
    /// The heading of the card: the column name, the row number, the kind of content and its length.
    pub title: str
    /// The text of the cell, laid out for reading.
    pub text: str
    /// The part of `text` the card draws, cut short with a note when `text` is long.
    pub shown: str
    /// The window position the card opens at.
    pub at: geometry.Point
}

/// Everything a sheet remembers between frames: scroll, selection, widths, sort and the open value view. The host keeps one per table and hands it back to `sheet_view`.
pub struct SheetState {
    /// The distance scrolled down, in pixels.
    pub top: f64 = 0.0
    /// The distance scrolled right, in pixels.
    pub left: f32 = 0.0
    /// The current cell, or `none` when nothing is selected.
    pub cell: SheetAt? = none
    /// The cell the selection began at, or `none` when nothing is selected.
    pub anchor: SheetAt? = none
    /// Whether the selection reaches every row, as when whole columns are selected.
    pub every_row: bool = false
    every_column: bool = false
    sweep: SheetSweep? = none
    pointer: geometry.Point = geometry.Point {}
    autoscrolling: bool = false
    /// The widths set by dragging, in pixels, by column index. A width of 0 or a missing entry leaves the column at its default width.
    pub sized: f32[] = []
    /// The sort in force, or `none` when the rows are in their own order.
    pub sort: SheetSort? = none
    /// The column resize in progress, or `none`.
    pub resize: SheetResize? = none
    pressed_header: i64 = -1
    /// The open value card, or `none`.
    pub value: SheetValue? = none
    viewing: i64 = 0
    /// The open menu, or `none`.
    pub menu: SheetMenu? = none
    grab: SheetGrab? = none
    /// The cell taken for typing in place, or `none`.
    pub entry: SheetEntry? = none
}

/// What lies under a point of the sheet.
pub enum SheetHit {
    /// Nothing: the point lies outside the cells, the headers and the gutter, or below the last row.
    Nothing
    /// The corner where the header band meets the gutter.
    Corner
    /// The header of the column at `index`.
    Column(index: i64)
    /// The right edge of the header of the column at `index`, where it is resized.
    Edge(index: i64)
    /// The row number in the gutter of the row at `index`.
    Row(index: i64)
    /// The cell at `row` and `column`.
    Cell(row: i64, column: i64)
}

/// The geometry of one frame: column widths and offsets, the gutter, and the cells' viewport. `sheet_layout` computes it from the state, the source and the sheet's size.
pub struct SheetLayout {
    /// The width of each column, in pixels.
    pub widths: f32[]
    offsets: f32[]
    /// The width of all the columns together, in pixels.
    pub content: f32
    gutter: f32
    /// The width of the whole sheet, in pixels.
    pub width: f32
    /// The height of the whole sheet, in pixels.
    pub height: f32
    view_width: f32
    view_height: f32
    /// The number of rows.
    pub total: i64
    /// The width of one character of text, in pixels.
    pub char_width: f32
}

/// The state with an entry open on a cell, starting from `text`.
pub fn sheet_entry_opened(state: SheetState, row: i64, column: i64, text: str) -> SheetState {
    var next = state
    next.entry = SheetEntry { row, column, text }
    next
}

/// The state with the entry's text set to what was typed.
pub fn sheet_entry_typed(state: SheetState, text: str) -> SheetState {
    let open = state.entry ?? return state
    sheet_entry_opened(state, open.row, open.column, text)
}

/// The state with the entry closed.
pub fn sheet_entry_closed(state: SheetState) -> SheetState {
    var next = state
    next.entry = none
    next
}

/// Returns a state with nothing scrolled, selected, sized, sorted or open.
pub fn sheet_state() -> SheetState {
    SheetState {}
}

fn sheet_least(a: f32, b: f32) -> f32 {
    if a < b { a } else { b }
}

fn sheet_most(a: f32, b: f32) -> f32 {
    if a > b { a } else { b }
}

fn sheet_least_row(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn sheet_most_row(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn sheet_clamp(value: f32, low: f32, high: f32) -> f32 {
    sheet_least(sheet_most(value, low), high)
}

fn sheet_clamp_index(value: i64, low: i64, high: i64) -> i64 {
    sheet_least_row(sheet_most_row(value, low), high)
}

fn sheet_clamp_top(value: f64, high: f64) -> f64 {
    if value > high {
        return high
    }
    if value < 0.0 {
        return 0.0
    }
    value
}

/// Returns how many rows the block spans.
pub fn sheet_block_rows(block: SheetBlock) -> i64 {
    block.end_row - block.first_row
}

/// Returns how many columns the block spans.
pub fn sheet_block_columns(block: SheetBlock) -> i64 {
    block.end_column - block.first_column
}

fn sheet_block_cells(block: SheetBlock) -> i64 {
    sheet_block_rows(block) * sheet_block_columns(block)
}

fn sheet_block_contains(block: SheetBlock, row: i64, column: i64) -> bool {
    row >= block.first_row && row < block.end_row && column >= block.first_column && column < block.end_column
}

fn sheet_block_has_row(block: SheetBlock, row: i64) -> bool {
    row >= block.first_row && row < block.end_row
}

fn sheet_block_has_column(block: SheetBlock, column: i64) -> bool {
    column >= block.first_column && column < block.end_column
}

/// The block cut down to the first `rows` rows.
pub fn sheet_block_within(block: SheetBlock, rows: i64) -> SheetBlock {
    var next = block
    next.first_row = if block.first_row < rows { block.first_row } else { rows }
    next.end_row = if block.end_row < rows { block.end_row } else { rows }
    next
}

/// The source a copy reads: the stored rows when the source has them apart from what is drawn over them, or the source itself.
pub fn sheet_copied_source(source: SheetSource) -> SheetSource {
    let stored = source.stored ?? return source
    var next = source
    next.total = stored.total
    next.read = stored.read
    next
}

/// Returns the block of `rows` rows and `columns` columns starting at the first row and column.
pub fn sheet_whole(rows: i64, columns: i64) -> SheetBlock {
    SheetBlock { first_row: 0, end_row: rows, first_column: 0, end_column: columns }
}

/// The rectangle between the anchor and the current cell, or `none` when nothing is selected.
pub fn sheet_block(state: SheetState) -> SheetBlock? {
    let cell = state.cell ?? return none
    let anchor = state.anchor ?? cell
    SheetBlock {
        first_row: sheet_least_row(anchor.row, cell.row)
        end_row: sheet_most_row(anchor.row, cell.row) + 1
        first_column: sheet_least_row(anchor.column, cell.column)
        end_column: sheet_most_row(anchor.column, cell.column) + 1
    }
}

/// The selection when it spans more than one cell, as the shading and the exports use it.
pub fn sheet_range(state: SheetState) -> SheetBlock? {
    let block = sheet_block(state) ?? return none
    if sheet_block_cells(block) > 1 {
        return block
    }
    none
}

fn sheet_column_width(state: SheetState, source: SheetSource, column: i64, char_width: f32) -> f32 {
    if column < state.sized.len && state.sized[column] > 0.0 {
        return state.sized[column]
    }
    let characters = if column < source.widths.len { source.widths[column] } else { 4 }
    char_width * f32(characters) + sheet_cell_padding * 2.0
}

fn sheet_digits(total: i64) -> i64 {
    var digits: i64 = 1
    var rest = total
    for rest >= 10 {
        rest = rest / 10
        digits += 1
    }
    digits
}

/// Lays the sheet out in `size`, the whole of the sheet: header band, gutter and cells.
pub fn sheet_layout(state: SheetState, source: SheetSource, char_width: f32, size: geometry.Size) -> SheetLayout {
    var widths: f32[] = []
    var offsets: f32[] = []
    var content: f32 = 0.0
    for column in 0..source.columns.len {
        let width = sheet_column_width(state, source, column, char_width)
        widths.push(width)
        offsets.push(content)
        content += width
    }
    let gutter = char_width * f32(sheet_digits(source.total)) + sheet_cell_padding * 2.0
    SheetLayout {
        widths
        offsets
        content
        gutter
        width: size.width
        height: size.height
        view_width: sheet_most(size.width - gutter - sheet_bar_width, 0.0)
        view_height: sheet_most(size.height - sheet_header_height - sheet_bar_width, 0.0)
        total: source.total
        char_width
    }
}

/// How many rows the cells' viewport shows, a partly shown row counting whole.
pub fn sheet_rows_shown(layout: SheetLayout) -> i64 {
    let rows = i64(-floor(-(layout.view_height / sheet_row_height)))
    sheet_most_row(rows, 1)
}

/// How far a page key moves: the rows shown less one.
pub fn sheet_page(layout: SheetLayout) -> i64 {
    sheet_most_row(sheet_rows_shown(layout) - 1, 1)
}

fn sheet_max_top(layout: SheetLayout) -> f64 {
    let most = f64(layout.total) * f64(sheet_row_height) - f64(layout.view_height)
    if most > 0.0 { most } else { 0.0 }
}

fn sheet_max_left(layout: SheetLayout) -> f32 {
    sheet_most(layout.content - layout.view_width, 0.0)
}

/// The state with its scroll brought back inside the content.
pub fn sheet_clamped(state: SheetState, layout: SheetLayout) -> SheetState {
    var next = state
    next.top = sheet_clamp_top(state.top, sheet_max_top(layout))
    next.left = sheet_clamp(state.left, 0.0, sheet_max_left(layout))
    next
}

/// Returns the index of the first row that reaches into the viewport.
pub fn sheet_first_row(state: SheetState) -> i64 {
    i64(floor(state.top / f64(sheet_row_height)))
}

fn sheet_row_shift(state: SheetState) -> f32 {
    f32(state.top - f64(sheet_first_row(state)) * f64(sheet_row_height))
}

/// The first column that reaches into the viewport.
pub fn sheet_first_column(state: SheetState, layout: SheetLayout) -> i64 {
    for column in 0..layout.widths.len {
        if layout.offsets[column] + layout.widths[column] > state.left {
            return column
        }
    }
    layout.widths.len
}

/// One past the last column that starts inside the viewport.
pub fn sheet_end_column(state: SheetState, layout: SheetLayout, first: i64) -> i64 {
    let edge = state.left + layout.view_width
    var column = first
    for column < layout.widths.len && layout.offsets[column] < edge {
        column += 1
    }
    column
}

fn sheet_wheeled(state: SheetState, layout: SheetLayout, dx: f32, dy: f32) -> SheetState {
    var next = state
    next.top = state.top + f64(dy)
    next.left = state.left + dx
    sheet_clamped(next, layout)
}

fn sheet_scrolled_to_row(state: SheetState, layout: SheetLayout, row: i64) -> SheetState {
    var next = state
    next.top = f64(row) * f64(sheet_row_height)
    sheet_clamped(next, layout)
}

fn sheet_scrolled_to_left(state: SheetState, layout: SheetLayout, left: f32) -> SheetState {
    var next = state
    next.left = left
    sheet_clamped(next, layout)
}

/// The state scrolled just far enough for the current cell to be in view.
pub fn sheet_revealed(state: SheetState, layout: SheetLayout) -> SheetState {
    let cell = state.cell ?? return state
    var next = state
    let top = f64(cell.row) * f64(sheet_row_height)
    let height = f64(layout.view_height)
    if top < state.top {
        next.top = top
    } else if top + f64(sheet_row_height) > state.top + height {
        next.top = top + f64(sheet_row_height) - height
    }
    if cell.column >= 0 && cell.column < layout.widths.len {
        let offset = layout.offsets[cell.column]
        let width = layout.widths[cell.column]
        if offset < state.left {
            next.left = offset
        } else if offset + width > state.left + layout.view_width {
            next.left = offset + width - layout.view_width
        }
    }
    sheet_clamped(next, layout)
}

fn sheet_row_at(state: SheetState, layout: SheetLayout, y: f32) -> i64 {
    let row = floor((f64(y) - f64(sheet_header_height) + state.top) / f64(sheet_row_height))
    sheet_most_row(i64(row), 0)
}

fn sheet_column_at(state: SheetState, layout: SheetLayout, x: f32) -> i64 {
    let inside = x - layout.gutter + state.left
    for column in 0..layout.widths.len {
        if inside >= layout.offsets[column] && inside < layout.offsets[column] + layout.widths[column] {
            return column
        }
    }
    -1
}

fn sheet_edge_of(state: SheetState, layout: SheetLayout, x: f32) -> i64 {
    var column = sheet_first_column(state, layout)
    for column < layout.widths.len {
        let edge = layout.gutter + layout.offsets[column] + layout.widths[column] - 1.0 - state.left
        if edge > layout.gutter + layout.view_width + sheet_edge_reach {
            return -1
        }
        if edge >= layout.gutter && x >= edge - sheet_edge_reach && x < edge + sheet_edge_reach + 1.0 {
            return column
        }
        column += 1
    }
    -1
}

/// What lies under the point `x`, `y`, measured from the sheet's top left corner.
pub fn sheet_hit(state: SheetState, layout: SheetLayout, x: f32, y: f32) -> SheetHit {
    if x < 0.0 || x >= layout.width || y < 0.0 || y >= layout.height {
        return SheetHit.Nothing
    }
    if x >= layout.gutter + layout.view_width || y >= sheet_header_height + layout.view_height {
        return SheetHit.Nothing
    }
    let in_header = y < sheet_header_height
    let in_gutter = x < layout.gutter
    if in_header {
        let edge = sheet_edge_of(state, layout, x)
        if edge >= 0 {
            return SheetHit.Edge(edge)
        }
        if in_gutter {
            return SheetHit.Corner
        }
        let column = sheet_column_at(state, layout, x)
        if column < 0 {
            return SheetHit.Nothing
        }
        return SheetHit.Column(column)
    }
    let row = sheet_row_at(state, layout, y)
    if row >= layout.total {
        return SheetHit.Nothing
    }
    if in_gutter {
        return SheetHit.Row(row)
    }
    let column = sheet_column_at(state, layout, x)
    if column < 0 {
        return SheetHit.Nothing
    }
    SheetHit.Cell(row, column)
}

/// The cell nearest a point, which may lie outside the cells: a drag that leaves the sheet still has a cell it reaches.
pub fn sheet_nearest(state: SheetState, layout: SheetLayout, x: f32, y: f32) -> SheetAt? {
    if layout.total == 0 || layout.widths.len == 0 {
        return none
    }
    let cx = sheet_clamp(x, layout.gutter, layout.gutter + layout.view_width - 1.0)
    let cy = sheet_clamp(y, sheet_header_height, sheet_header_height + layout.view_height - 1.0)
    var column = sheet_column_at(state, layout, cx)
    if column < 0 {
        column = layout.widths.len - 1
    }
    SheetAt { row: sheet_least_row(sheet_row_at(state, layout, cy), layout.total - 1), column }
}

/// How far a sweep held past the cells' edge scrolls on each tick.
pub fn sheet_edge_shift(layout: SheetLayout, x: f32, y: f32) -> geometry.Point {
    var dx: f32 = 0.0
    var dy: f32 = 0.0
    if x < layout.gutter {
        dx = -sheet_edge_step
    } else if x > layout.gutter + layout.view_width {
        dx = sheet_edge_step
    }
    if y < sheet_header_height {
        dy = -sheet_row_height
    } else if y > sheet_header_height + layout.view_height {
        dy = sheet_row_height
    }
    geometry.point(dx, dy)
}

fn sheet_has_selection(state: SheetState) -> bool {
    state.cell != none
}

/// Returns the state with nothing selected.
pub fn sheet_cleared(state: SheetState) -> SheetState {
    var next = state
    next.cell = none
    next.anchor = none
    next.every_row = false
    next.every_column = false
    next
}

/// Returns the state with `cell` as the current cell and `anchor` as where the selection began, no longer whole rows or whole columns.
pub fn sheet_selected(state: SheetState, anchor: SheetAt, cell: SheetAt) -> SheetState {
    var next = state
    next.anchor = anchor
    next.cell = cell
    next.every_row = false
    next.every_column = false
    next
}

/// Moves the current cell by `rows` and `columns`, extending the selection from where it started when `extend`; the far values `-sheet_far` and `sheet_far` reach the first and last.
pub fn sheet_moved(state: SheetState, rows: i64, columns: i64, total_rows: i64, total_columns: i64, extend: bool) -> SheetState {
    if total_rows == 0 || total_columns == 0 {
        return state
    }
    let current = state.cell ?? SheetAt { row: 0, column: 0 }
    let row = sheet_clamp_index(current.row + rows, 0, total_rows - 1)
    let column = sheet_clamp_index(current.column + columns, 0, total_columns - 1)
    let moved = SheetAt { row, column }
    let anchor = if extend { state.anchor ?? current } else { moved }
    sheet_selected(state, anchor, moved)
}

fn sheet_selected_all(state: SheetState, total_rows: i64, total_columns: i64) -> SheetState {
    if total_rows == 0 || total_columns == 0 {
        return state
    }
    var next = sheet_selected(state, SheetAt { row: 0, column: 0 }, SheetAt { row: total_rows - 1, column: total_columns - 1 })
    next.every_row = true
    next.every_column = true
    next
}

/// Keeps a whole-row or whole-column selection reaching every row and column as rows arrive.
pub fn sheet_stretched(state: SheetState, rows: i64, columns: i64) -> SheetState {
    if (state.every_row && rows == 0) || (state.every_column && columns == 0) {
        return sheet_cleared(state)
    }
    let anchor = state.anchor ?? return state
    let cell = state.cell ?? return state
    var next = state
    var from = anchor
    var to = cell
    if state.every_row && rows > 0 {
        if anchor.row <= cell.row {
            from.row = 0
            to.row = rows - 1
        } else {
            from.row = rows - 1
            to.row = 0
        }
    }
    if state.every_column && columns > 0 {
        if anchor.column <= cell.column {
            from.column = 0
            to.column = columns - 1
        } else {
            from.column = columns - 1
            to.column = 0
        }
    }
    next.anchor = from
    next.cell = to
    next
}

/// Selects from the anchor, or from `cell` when not extending, to `cell`: a block of cells, whole rows or whole columns.
pub fn sheet_swept(state: SheetState, cell: SheetAt, sweep: SheetSweep, extend: bool, total_rows: i64, total_columns: i64) -> SheetState {
    let last_row = sheet_most_row(total_rows - 1, 0)
    let last_column = sheet_most_row(total_columns - 1, 0)
    var anchor = cell
    if extend {
        anchor = state.anchor ?? cell
    }
    var from = anchor
    var to = cell
    var every_row = false
    var every_column = false
    match sweep {
        Cells => {}
        Rows => {
            from = SheetAt { row: anchor.row, column: 0 }
            to = SheetAt { row: cell.row, column: last_column }
            every_column = true
        }
        Columns => {
            from = SheetAt { row: 0, column: anchor.column }
            to = SheetAt { row: last_row, column: cell.column }
            every_row = true
        }
    }
    var next = sheet_selected(state, from, to)
    next.every_row = every_row
    next.every_column = every_column
    next
}

fn sheet_sweep_started(state: SheetState, cell: SheetAt, sweep: SheetSweep, extend: bool, total_rows: i64, total_columns: i64) -> SheetState {
    var next = sheet_swept(state, cell, sweep, extend, total_rows, total_columns)
    next.sweep = sweep
    next
}

/// One autoscroll tick of a sweep held past an edge: scrolls, then extends the selection to the cell under the pointer.
pub fn sheet_swept_on(state: SheetState, layout: SheetLayout) -> SheetState {
    let sweep = state.sweep ?? return state
    let nearest = sheet_nearest(state, layout, state.pointer.x, state.pointer.y) ?? return state
    let shift = sheet_edge_shift(layout, state.pointer.x, state.pointer.y)
    var next = state
    next.top = state.top + f64(shift.y)
    next.left = state.left + shift.x
    next = sheet_clamped(next, layout)
    sheet_swept(next, nearest, sweep, true, layout.total, layout.widths.len)
}

fn sheet_sweep_moving(state: SheetState, layout: SheetLayout) -> bool {
    if state.sweep == none {
        return false
    }
    let shift = sheet_edge_shift(layout, state.pointer.x, state.pointer.y)
    shift.x != 0.0 || shift.y != 0.0
}

fn sheet_released(state: SheetState) -> SheetState {
    var next = state
    next.sweep = none
    next.resize = none
    next.grab = none
    next.pressed_header = -1
    next
}

fn sheet_sized(state: SheetState, column: i64, width: f32) -> SheetState {
    var next = state
    var sized = state.sized[0..]
    for sized.len <= column {
        sized.push(0.0)
    }
    sized[column] = sheet_clamp(width, sheet_narrowest_width, sheet_widest_width)
    next.sized = sized
    next
}

fn sheet_unsized(state: SheetState, column: i64) -> SheetState {
    var next = state
    if column < state.sized.len {
        var sized = state.sized[0..]
        sized[column] = 0.0
        next.sized = sized
    }
    next
}

fn sheet_is_sized(state: SheetState, column: i64) -> bool {
    column < state.sized.len && state.sized[column] > 0.0
}

fn sheet_resize_started(state: SheetState, layout: SheetLayout, column: i64, from: f32) -> SheetState {
    var next = state
    if column < layout.widths.len {
        next.resize = SheetResize { column, from, width: layout.widths[column] }
    }
    next
}

fn sheet_resize_dragged(state: SheetState, x: f32) -> SheetState {
    let resize = state.resize ?? return state
    sheet_sized(state, resize.column, resize.width + x - resize.from)
}

fn sheet_sort_cycled(state: SheetState, column: i64) -> SheetState {
    var next = state
    match state.sort {
        some(sorted) => {
            if sorted.column == column && !sorted.descending {
                next.sort = SheetSort { column, descending: true }
            } else if sorted.column == column {
                next.sort = none
            } else {
                next.sort = SheetSort { column, descending: false }
            }
        }
        none => {
            next.sort = SheetSort { column, descending: false }
        }
    }
    next
}

fn sheet_sorted_by(state: SheetState, sort: SheetSort?) -> SheetState {
    var next = state
    next.sort = sort
    next
}

/// The window position just under the current cell, where a value view opens when the keyboard asks for it.
pub fn sheet_cursor_point(state: SheetState, layout: SheetLayout, origin: geometry.Point) -> geometry.Point? {
    let cell = state.cell ?? return none
    if cell.column < 0 || cell.column >= layout.widths.len {
        return none
    }
    let left = origin.x + layout.gutter + layout.offsets[cell.column] - state.left
    let top = f64(origin.y) + f64(sheet_header_height) + f64(cell.row) * f64(sheet_row_height) - state.top
    geometry.point(left + 12.0, f32(top) + sheet_row_height + 4.0)
}
