fn test_a_segmented_control_wraps_its_segments_with_two_pixels(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let one = segment(look, "one", "Tables", true, nothing)
    let two = segment(look, "two", "Views", false, nothing)
    let sc = shot(cx, corner(segmented(look, [one, two])))
    let fills = filled(sc)
    t.equal(fills.len, 2)
    same_colour(t, fills[0].background, look.control)
    same_number(t, fills[0].bounds.height, 28.0)
    same_colour(t, fills[1].background, look.rail_selected)
    same_colour(t, outlined(sc).border_color, look.border)
    same_number(t, fills[1].bounds.x, 2.0)
    same_number(t, fills[1].bounds.y, 2.0)
    same_number(t, fills[1].bounds.height, 24.0)
    same_number(t, outlined(sc).bounds.height, 24.0)
}

fn test_clicking_a_segment_selects_it(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let chosen = ui.signal(cx, 0)
    let view = fn() -> ui.Element {
        let one = segment(look, "one", "A", ui.get(chosen) == 0, fn() { ui.set(chosen, 0) })
        let two = segment(look, "two", "B", ui.get(chosen) == 1, fn() { ui.set(chosen, 1) })
        ui.row(ui.div()).items_start().child(segmented(look, [one, two]))
    }
    let sc = shot(cx, view)
    let second = sc.quads[0].bounds.x + sc.quads[0].bounds.width - 6.0
    click_at(cx, second, 14.0)
    t.equal(ui.get(chosen), 1)
}

fn test_a_selected_tab_has_an_accent_underline_and_a_bare_one_has_none(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let band_view = fn() -> ui.Element {
        let first = tab(look, "t1", "Query", true, nothing)
        ui.row(ui.div()).height(30.0).child(tabs([first]))
    }
    let sc = shot(cx, band_view)
    t.equal(sc.quads.len, 1)
    same_colour(t, sc.quads[0].background, look.accent)
    same_number(t, sc.quads[0].bounds.height, 2.0)
    same_number(t, sc.quads[0].bounds.y + sc.quads[0].bounds.height, 30.0)
    same_colour(t, sc.sprites[0].color, look.text)
    let bare_view = fn() -> ui.Element {
        let first = tab(look, "t1", "Query", false, nothing)
        ui.row(ui.div()).height(30.0).child(tabs([first]))
    }
    let bare = shot(cx, bare_view)
    t.equal(bare.quads.len, 0)
    same_colour(t, bare.sprites[0].color, look.muted)
}

fn test_clicking_a_tab_runs_its_handler(t: *testing.T) {
