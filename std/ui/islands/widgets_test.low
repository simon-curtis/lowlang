fn test_a_selected_rail_button_is_filled_and_an_unselected_one_is_bare(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let selected = shot(cx, corner(rail_button(look, "rail-servers", "server", true, false, nothing)))
    t.equal(selected.quads.len, 1)
    same_colour(t, selected.quads[0].background, look.rail_selected)
    same_number(t, selected.quads[0].bounds.width, 30.0)
    same_number(t, selected.quads[0].bounds.height, 30.0)
    t.equal(selected.quads[0].corner_radii.top_left, 10.0)
    let bare = shot(cx, corner(rail_button(look, "rail-servers", "server", false, false, nothing)))
    t.equal(bare.quads.len, 0)
}

fn test_an_unselected_rail_button_lights_on_hover(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let view = corner(rail_button(look, "rail-files", "files", false, false, nothing))
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    let over = shot(cx, view)
    t.equal(over.quads.len, 1)
    same_colour(t, over.quads[0].background, look.hover)
    move_to(cx, 200.0, 200.0)
    t.equal(shot(cx, view).quads.len, 0)
}

fn test_a_dimmed_rail_button_halves_its_fills(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let lit = shot(cx, corner(rail_button(look, "inspect", "code", true, false, nothing)))
    let dim = shot(cx, corner(rail_button(look, "inspect", "code", true, true, nothing)))
    same_number(t, dim.quads[0].background.a, lit.quads[0].background.a * 0.5)
}

fn test_a_rail_button_runs_its_handler_on_click(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let clicks = ui.signal(cx, 0)
    let view = corner(rail_button(look, "rail-search", "search", false, false, counting(clicks)))
    shot(cx, view)
    click_at(cx, 10.0, 10.0)
    t.equal(ui.get(clicks), 1)
    click_at(cx, 300.0, 200.0)
    t.equal(ui.get(clicks), 1)
}

fn test_a_rail_is_forty_one_wide_and_centres_its_buttons(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let first = rail_button(look, "a", "server", true, false, nothing)
    let second = rail_button(look, "b", "files", true, false, nothing)
    let strip = rail([first, second])
    let sc = shot(cx, beside(strip))
    t.equal(sc.quads.len, 3)
    same_number(t, sc.quads[0].bounds.x, 5.0)
    same_number(t, sc.quads[0].bounds.y, 3.0)
    same_number(t, sc.quads[1].bounds.y, 39.0)
    same_number(t, sc.quads[2].bounds.x, 41.0)
}

fn test_a_rail_spacer_pushes_the_foot_buttons_down(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let head = rail_button(look, "a", "server", true, false, nothing)
    let foot = rail_button(look, "b", "settings", true, false, nothing)
    let strip = rail([head, ui.div().grow(1.0), foot])
    let view = fn() -> ui.Element { ui.row(ui.div()).child(strip) }
    let sc = shot(cx, view)
    same_number(t, sc.quads[1].bounds.y + sc.quads[1].bounds.height, 300.0)
}

