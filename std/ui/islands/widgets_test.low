    let clicks = ui.signal(cx, 0)
    let view = fn() -> ui.Element {
        ui.row(ui.div()).height(30.0).child(tabs([tab(look, "t1", "Query", false, counting(clicks))]))
    }
    shot(cx, view)
    click_at(cx, 3.0, 10.0)
    t.equal(ui.get(clicks), 1)
}

fn test_a_checkbox_toggles_through_a_headless_click(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let on = ui.signal(cx, false)
    let view = fn() -> ui.Element {
        ui.row(ui.div()).items_start().child(checkbox(look, "case", "Match case", ui.get(on), fn() { ui.set(on, !ui.get(on)) }))
    }
    let off = shot(cx, view)
    t.equal(filled(off).len, 1)
    same_colour(t, filled(off)[0].background, look.control)
    same_colour(t, outlined(off).border_color, look.faint)
    same_number(t, outlined(off).bounds.width, 15.0)
    same_number(t, outlined(off).bounds.height, 15.0)
    t.equal(outlined(off).corner_radii.top_left, 4.0)

    click_at(cx, 7.0, 12.0)
    t.is_true(ui.get(on))
    let checked = shot(cx, view)
    same_colour(t, filled(checked)[0].background, look.accent)
    same_colour(t, outlined(checked).border_color, look.accent)

    click_at(cx, 7.0, 12.0)
    t.is_false(ui.get(on))
    same_colour(t, filled(shot(cx, view))[0].background, look.control)
}

fn test_clicking_a_checkbox_label_toggles_it_too(t: *testing.T) {
