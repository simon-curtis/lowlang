fn test_a_chord_draws_one_cap_per_key_across_its_steps(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    t.equal(filled(shot(cx, corner(keys(look, "Ctrl+N")))).len, 2)
    t.equal(filled(shot(cx, corner(keys(look, "Ctrl+K Ctrl+O")))).len, 4)
    t.equal(filled(shot(cx, corner(keys(look, "Ctrl+Shift+P")))).len, 3)
    t.equal(filled(shot(cx, corner(keys(look, "Ctrl+,")))).len, 2)
}

fn test_a_chord_with_two_steps_says_then_between_them(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let single = shot(cx, corner(keys(look, "Ctrl+K")))
    let chord = shot(cx, corner(keys(look, "Ctrl+K Ctrl+O")))
    t.is_true(chord.sprites.len > single.sprites.len)
    var faint_sprites = 0
    for sprite in chord.sprites {
        if sprite.color.r == look.faint.r && sprite.color.g == look.faint.g && sprite.color.b == look.faint.b {
            faint_sprites += 1
        }
    }
    t.equal(faint_sprites, 4)
}

fn test_an_empty_state_stacks_a_forty_eight_badge_over_title_and_body(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let view = fn() -> ui.Element {
        ui.column(ui.div()).child(empty_state(look, "database", "No file open", "Open a folder from the side panel, or start a new file."))
    }
    let sc = shot(cx, view)
    t.equal(sc.quads.len, 1)
    same_colour(t, sc.quads[0].background, look.control)
    same_number(t, sc.quads[0].bounds.width, 48.0)
    same_number(t, sc.quads[0].bounds.height, 48.0)
    t.equal(sc.quads[0].corner_radii.top_left, 24.0)
    same_number(t, sc.quads[0].bounds.x + 24.0, 200.0)
}

fn test_an_empty_state_fills_the_height_it_is_given(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let view = fn() -> ui.Element {
        ui.column(ui.div()).child(empty_state(look, "database", "T", "B"))
    }
    let sc = shot(cx, view)
    let centre = sc.quads[0].bounds.y + 24.0
    t.is_true(centre > 100.0 && centre < 200.0)
}

fn test_an_empty_line_is_faint_text_with_padding(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let sc = shot(cx, stacked(empty(look, "No connections")))
    same_colour(t, sc.sprites[0].color, look.faint)
    same_number(t, sc.quads[0].bounds.x, 0.0)
    t.is_true(sc.quads[0].bounds.y >= 2.0 * 4.875)
}

fn test_a_field_label_is_muted_caption_text(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let sc = shot(cx, corner(field_label(look, "Shortcuts")))
    same_colour(t, sc.sprites[0].color, look.muted)
}

fn test_a_margin_spacer_covers_the_margin_beyond_the_gap(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let spacing: f32 = 6.5
    let view = fn() -> ui.Element {
        let first = ui.div().width(10.0).height(10.0).background(ui.rgb(0x00ff00))
        let second = ui.div().width(10.0).height(10.0).background(ui.rgb(0xff0000))
        ui.column(ui.div()).items_start().gap(spacing).child(first).child(margin_spacer(13.0, spacing)).child(second)
    }
    let sc = shot(cx, view)
    same_number(t, sc.quads[1].bounds.y, 28.0)
}

fn test_a_toggle_button_is_square_to_its_size_and_lit_with_the_accent_while_on(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let off = shot(cx, beside(toggle_button(look, "opt", "regex", false, 22.0, nothing)))
    t.equal(off.quads.len, 1)
    let on = shot(cx, beside(toggle_button(look, "opt", "regex", true, 22.0, nothing)))
    t.equal(on.quads.len, 2)
    same_number(t, on.quads[1].bounds.x, 22.0)
    same_colour(t, on.quads[0].background, look.accent_soft)
}

fn test_a_toggle_button_reports_a_click(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let clicks = ui.signal(cx, 0)
    shot(cx, corner(toggle_button(look, "opt", "regex", false, 22.0, counting(clicks))))
    click_at(cx, 11.0, 11.0)
    t.equal(ui.get(clicks), 1)
}

fn test_a_selected_tab_chip_is_filled_and_an_unselected_one_is_bare_until_hovered(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let selected = shot(cx, corner(tab_chip(look, "a", "Query", none, true, false, true, nothing, nothing)))
    t.equal(selected.quads.len, 1)
    same_colour(t, selected.quads[0].background, look.rail_selected)
    same_number(t, selected.quads[0].bounds.height, tab_chip_height)
    let bare = shot(cx, corner(tab_chip(look, "a", "Query", none, true, false, false, nothing, nothing)))
    t.equal(bare.quads.len, 0)
    move_to(cx, 5.0, 5.0)
    let lit = shot(cx, corner(tab_chip(look, "a", "Query", none, true, false, false, nothing, nothing)))
    same_colour(t, lit.quads[0].background, look.hover)
}

fn test_a_tab_chip_selects_on_its_label_and_closes_on_its_glyph(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let selects = ui.signal(cx, 0)
    let closes = ui.signal(cx, 0)
    let view = corner(tab_chip(look, "a", "Query", none, true, false, false, counting(selects), counting(closes)))
    let sc = shot(cx, view)
    click_at(cx, 12.0, tab_chip_height / 2.0)
    t.equal(ui.get(selects), 1)
    t.equal(ui.get(closes), 0)
    var glyph = sc.sprites[0]
    for sprite in sc.sprites {
        if sprite.bounds.x > glyph.bounds.x {
            glyph = sprite
        }
    }
    click_at(cx, glyph.bounds.x + glyph.bounds.width / 2.0, tab_chip_height / 2.0)
    t.equal(ui.get(selects), 1)
    t.equal(ui.get(closes), 1)
}

fn test_a_tab_chip_shows_its_place_after_the_label(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let plain = shot(cx, corner(tab_chip(look, "a", "Query", none, true, false, false, nothing, nothing)))
    let placed = shot(cx, corner(tab_chip(look, "a", "Query", "work", true, false, false, nothing, nothing)))
    t.is_true(placed.sprites.len > plain.sprites.len)
    same_colour(t, placed.sprites[plain.sprites.len - 1].color, look.faint)
}

fn test_the_ruler_measures_text_as_the_layout_does(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let ruler_of = ruler()
    for sample in ["select", "AVA To", "0123456789", "Wo.f"] {
        let view = corner(ui.div().background(ui.rgb(0xff0000)).text_size(small_size).child(ui.text(sample)))
        let sc = shot(cx, view)
        same_number(t, ceiling(ruler_width(ruler_of, sample, small_size)), sc.quads[0].bounds.width)
    }
}

fn test_the_ruler_counts_the_blanks_the_layout_drops_from_the_end(t: *testing.T) {
    let ruler_of = ruler()
    t.is_true(ruler_width(ruler_of, "a  ", body_size) > ruler_width(ruler_of, "a", body_size))
    same_number(t, ruler_width(ruler_of, "", body_size), 0.0)
}

fn ring_of(sc: scene.Scene) -> geometry.Color? {
    for q in sc.quads {
        if near(q.bounds.width, 26.0) {
            return q.border_color
        }
    }
    none
}

fn test_a_swatch_shows_its_accent_and_rings_it_only_when_selected(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let bare = shot(cx, corner(swatch(look, "s", 0xe874d9, "Pink", false, nothing)))
    let ringed = shot(cx, corner(swatch(look, "s", 0xe874d9, "Pink", true, nothing)))
    var dots = 0
    for q in ringed.quads {
        if near(q.bounds.width, 18.0) {
            same_colour(t, q.background, ui.rgb(0xe874d9))
            dots += 1
        }
    }
    t.equal(dots, 1)
    t.is_none(ring_of(bare))
    same_colour(t, ring_of(ringed) ?? geometry.Color {}, ui.rgb(0xe874d9))
}

fn test_a_swatch_chooses_on_its_dot_and_on_its_caption(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let chosen = ui.signal(cx, 0)
    let view = corner(swatch(look, "s", 0xe874d9, "Pink", false, counting(chosen)))
    shot(cx, view)
    click_at(cx, 28.0, 17.0)
    t.equal(ui.get(chosen), 1)
    click_at(cx, 28.0, 41.0)
    t.equal(ui.get(chosen), 2)
}

fn test_a_resize_strip_is_eight_wide_along_the_edge_and_shows_the_column_cursor(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let frame = ui.div().relative().size(200.0, 120.0).child(resize_strip("strip").right(0.0))
    shot(cx, corner(frame))
    let bounds = ui.bounds_of(cx, "strip") ?? panic("no strip")
    same_number(t, bounds.width, 8.0)
    same_number(t, bounds.height, 120.0)
    same_number(t, bounds.x, 192.0)
    t.equal(ui.pointer_cursor(cx), platform.Cursor.Arrow)
    move_to(cx, 196.0, 60.0)
    shot(cx, corner(frame))
    t.equal(ui.pointer_cursor(cx), platform.Cursor.ResizeLeftRight)
}

fn test_a_resize_divider_reaches_three_above_its_pane_and_fills_on_hover(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let pane = ui.div().relative().margin_top(20.0).size(200.0, 100.0).child(resize_divider(look, "divider"))
    shot(cx, corner(pane))
    let bounds = ui.bounds_of(cx, "divider") ?? panic("no divider")
    same_number(t, bounds.y, 17.0)
    same_number(t, bounds.height, 5.0)
    same_number(t, bounds.width, 200.0)
    t.equal(filled(shot(cx, corner(pane))).len, 0)
    move_to(cx, 100.0, 19.0)
    let over = shot(cx, corner(pane))
    t.equal(ui.pointer_cursor(cx), platform.Cursor.ResizeUpDown)
    t.equal(filled(over).len, 1)
    same_colour(t, filled(over)[0].background, look.border)
    same_number(t, filled(over)[0].bounds.height, 5.0)
}
