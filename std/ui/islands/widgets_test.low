import std/testing
import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn near(got: f32, want: f32) -> bool {
    got > want - 0.01 && got < want + 0.01
}

fn same_number(t: *testing.T, got: f32, want: f32) {
    if !near(got, want) {
        t.error("got {got}, want {want}")
    }
}

fn same_colour(t: *testing.T, got: geometry.Color, want: geometry.Color) {
    same_number(t, got.r, want.r)
    same_number(t, got.g, want.g)
    same_number(t, got.b, want.b)
    same_number(t, got.a, want.a)
}

fn filled(sc: scene.Scene) -> scene.Quad[] {
    var out: scene.Quad[] = []
    for q in sc.quads {
        if q.background.a > 0.0 {
            out.push(q)
        }
    }
    out
}

fn outline(sc: scene.Scene) -> scene.Quad? {
    for q in sc.quads {
        if q.border_color.a > 0.0 {
            return q
        }
    }
    none
}

fn outlined(sc: scene.Scene) -> scene.Quad {
    outline(sc) ?? scene.Quad { bounds: geometry.Rect {} }
}

fn ceiling(v: f32) -> f32 {
    -floor(-v)
}

fn nothing() {}

fn counting(n: ui.Signal[i64]) -> fn() {
    fn() { ui.set(n, ui.get(n) + 1) }
}

fn window() -> geometry.Size {
    geometry.size(400.0, 300.0)
}

fn shot(cx: ui.Context, view: fn() -> ui.Element) -> scene.Scene {
    ui.frame(cx, view, window(), 1.0)
}

fn corner(subject: ui.Element) -> fn() -> ui.Element {
    fn() -> ui.Element { ui.row(ui.div()).items_start().child(subject) }
}

fn stacked(top: ui.Element) -> fn() -> ui.Element {
    let marker = ui.div().width(5.0).height(5.0).background(ui.rgb(0xff0000))
    fn() -> ui.Element { ui.column(ui.div()).items_start().child(top).child(marker) }
}

fn beside(left: ui.Element) -> fn() -> ui.Element {
    let marker = ui.div().width(5.0).height(5.0).background(ui.rgb(0xff0000))
    fn() -> ui.Element { ui.row(ui.div()).items_start().child(left).child(marker) }
}

fn move_to(cx: ui.Context, x: f32, y: f32) {
    ui.dispatch(cx, platform.Event.PointerMoved(x, y))
}

fn click_at(cx: ui.Context, x: f32, y: f32) {
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: x, y: y }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: x, y: y }))
}

fn test_a_card_is_a_bordered_surface_with_large_corners(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let sc = shot(cx, corner(card(look).size(100.0, 60.0)))
    let fills = filled(sc)
    t.equal(fills.len, 1)
    same_colour(t, fills[0].background, look.surface)
    t.equal(fills[0].corner_radii.top_left, 10.0)
    let ring = outlined(sc)
    same_colour(t, ring.border_color, look.border)
    t.equal(ring.border_widths.top, 1.0)
    t.equal(ring.corner_radii.top_left, 10.0)
    same_number(t, ring.bounds.width, 100.0)
    same_number(t, ring.bounds.height, 60.0)
}

fn test_an_island_is_a_surface_ringed_in_the_island_border_with_large_corners(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let sc = shot(cx, corner(island(look).size(100.0, 60.0)))
    let fills = filled(sc)
    t.equal(fills.len, 1)
    same_colour(t, fills[0].background, look.surface)
    t.equal(fills[0].corner_radii.top_left, 10.0)
    let ring = outlined(sc)
    same_colour(t, ring.border_color, ui.rgb(0x29292d))
    t.equal(ring.border_widths.top, 1.0)
}

fn test_an_icon_reserves_its_box_and_draws_in_the_colour_it_is_given(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let boxed = ui.div().background(ui.rgb(0x00ff00)).child(icon_in("server", 16.0, look.accent))
    let sc = shot(cx, corner(boxed))
    t.equal(sc.quads.len, 1)
    same_number(t, sc.quads[0].bounds.width, 16.0)
    same_number(t, sc.quads[0].bounds.height, 16.0)
    t.is_true(sc.sprites.len > 0)
    same_colour(t, sc.sprites[0].color, look.accent)
}

