fn test_a_kbd_is_a_twenty_pixel_outlined_cap(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let sc = shot(cx, corner(kbd(look, "Ctrl")))
    t.equal(filled(sc).len, 1)
    same_colour(t, filled(sc)[0].background, look.control)
    same_colour(t, outlined(sc).border_color, look.border)
    same_number(t, filled(sc)[0].bounds.height, 20.0)
    same_number(t, outlined(sc).bounds.height, 20.0)
    t.equal(filled(sc)[0].corner_radii.top_left, 4.0)
