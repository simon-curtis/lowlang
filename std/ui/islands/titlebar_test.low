import std/testing
import std/ui
import std/ui/platform

fn bar_view(look: Theme, cx: ui.Context) -> fn() -> ui.Element {
    fn() -> ui.Element {
        ui.row(ui.div()).size(400.0, title_height).child(ui.div().width(100.0)).child(drag_area()).child(caption_controls(look, cx))
    }
}

fn area_name(cx: ui.Context, x: f32, y: f32) -> str {
    let found = ui.window_control_area_at(cx, x, y)
    match found {
        some(area) => match area {
            Drag => "drag"
            Close => "close"
            Max => "max"
            Min => "min"
        }
        none => "none"
    }
}

fn area_at_centre(cx: ui.Context, key: str) -> str {
    let p = centre_of(cx, key)
    area_name(cx, p.x, p.y)
}

fn test_each_caption_button_is_forty_six_wide_and_as_high_as_the_bar(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    shot(cx, bar_view(look, cx))
    for key in ["caption-min", "caption-max", "caption-close"] {
        let b = bounds_for(cx, key)
        same_number(t, b.width, caption_width)
        same_number(t, b.height, title_height)
    }
    let close = bounds_for(cx, "caption-close")
    same_number(t, close.x + close.width, 400.0)
    same_number(t, bounds_for(cx, "caption-max").x + caption_width, close.x)
    same_number(t, bounds_for(cx, "caption-min").x + caption_width, bounds_for(cx, "caption-max").x)
}

fn test_the_window_control_area_at_each_button_centre_is_its_own(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    shot(cx, bar_view(look, cx))
    t.equal(area_at_centre(cx, "caption-min"), "min")
    t.equal(area_at_centre(cx, "caption-max"), "max")
    t.equal(area_at_centre(cx, "caption-close"), "close")
}

fn test_the_drag_area_fills_the_bar_between_the_content_and_the_buttons(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    shot(cx, bar_view(look, cx))
    t.equal(area_name(cx, 150.0, 20.0), "drag")
    t.equal(area_name(cx, bounds_for(cx, "caption-min").x - 1.0, 20.0), "drag")
    t.equal(area_name(cx, 50.0, 20.0), "none")
    t.equal(area_name(cx, 150.0, title_height + 5.0), "none")
}

fn test_a_caption_icon_is_a_muted_fourteen_pixel_glyph_centred_in_its_button(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let sc = shot(cx, bar_view(look, cx))
    t.equal(sc.sprites.len, 3)
    var index = 0
    for key in ["caption-min", "caption-max", "caption-close"] {
        let b = bounds_for(cx, key)
        let glyph = sc.sprites[index]
        same_colour(t, glyph.color, look.muted)
        same_number(t, glyph.bounds.width, 14.0)
        same_number(t, glyph.bounds.height, 14.0)
        same_number(t, glyph.bounds.x + glyph.bounds.width / 2.0, b.x + b.width / 2.0)
        same_number(t, glyph.bounds.y + glyph.bounds.height / 2.0, b.y + b.height / 2.0)
        index += 1
    }
}

fn test_the_close_button_lights_red_and_the_others_light_with_the_hover_colour(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = bar_view(look, cx)
    shot(cx, view)
    t.equal(filled(shot(cx, view)).len, 0)
    let close = centre_of(cx, "caption-close")
    move_to(cx, close.x, close.y)
    let red = filled(shot(cx, view))
    t.equal(red.len, 1)
    same_colour(t, red[0].background, ui.rgb(caption_close_hover))
    same_number(t, red[0].bounds.width, caption_width)
    let min = centre_of(cx, "caption-min")
    move_to(cx, min.x, min.y)
    let grey = filled(shot(cx, view))
    t.equal(grey.len, 1)
    same_colour(t, grey[0].background, look.hover)
    let max = centre_of(cx, "caption-max")
    move_to(cx, max.x, max.y)
    same_colour(t, filled(shot(cx, view))[0].background, look.hover)
}

fn test_the_maximise_button_shows_restore_while_the_window_is_maximised(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = bar_view(look, cx)
    let normal = shot(cx, view)
    ui.dispatch(cx, platform.Event.Maximized(true))
    t.is_true(ui.frame_due(cx))
    let zoomed = shot(cx, view)
    t.equal(zoomed.sprites.len, normal.sprites.len)
    t.is_true(zoomed.sprites[0].tile.x == normal.sprites[0].tile.x && zoomed.sprites[0].tile.y == normal.sprites[0].tile.y)
    t.is_true(zoomed.sprites[1].tile.x != normal.sprites[1].tile.x || zoomed.sprites[1].tile.y != normal.sprites[1].tile.y)
    t.is_true(zoomed.sprites[2].tile.x == normal.sprites[2].tile.x && zoomed.sprites[2].tile.y == normal.sprites[2].tile.y)
    ui.dispatch(cx, platform.Event.Maximized(false))
    let restored = shot(cx, view)
    t.is_true(restored.sprites[1].tile.x == normal.sprites[1].tile.x && restored.sprites[1].tile.y == normal.sprites[1].tile.y)
}

fn test_the_caption_buttons_keep_the_bar_height_under_a_centred_bar(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = fn() -> ui.Element {
        ui.row(ui.div()).size(400.0, title_height).items_center().child(ui.div().width(100.0)).child(drag_area()).child(caption_controls(look, cx))
    }
    shot(cx, view)
    for key in ["caption-min", "caption-max", "caption-close"] {
        same_number(t, bounds_for(cx, key).height, title_height)
    }
    t.equal(area_name(cx, 150.0, 20.0), "drag")
}

fn test_a_button_with_a_handler_inside_the_drag_area_stays_a_button(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let clicks = ui.signal(cx, 0)
    let view = fn() -> ui.Element {
        let menu = icon_button(look, "bar-menu", "settings", counting(clicks))
        ui.row(ui.div()).size(400.0, title_height).child(menu).child(drag_area()).child(caption_controls(look, cx))
    }
    shot(cx, view)
    t.equal(area_at_centre(cx, "bar-menu"), "none")
    click_key(cx, "bar-menu")
    t.equal(ui.get(clicks), 1)
    t.equal(area_name(cx, 200.0, 20.0), "drag")
}
