import std/testing
import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

struct PickerRig {
    cx: ui.Context
    look: Theme
    view: PickerView
    query: ui.Signal[str]
    selected: ui.Signal[i64]
    log: ui.Signal[str[]]
    paint: fn() -> ui.Element
}

fn picker_sample_choices(count: i64) -> PickerChoice[] {
    var out: PickerChoice[] = []
    for index in 0..count {
        let name = "Item {index}"
        out.push(picker_choice("key-{index}", name, "Detail {index}", "extra"))
    }
    out
}

fn picker_plain_choices() -> PickerChoice[] {
    let alpha = picker_choice("a", "Alpha", "", "first letter")
    let beta = picker_choice("b", "Beta", "", "second")
    var gamma = picker_choice("g", "Gamma", "", "third")
    gamma.current = true
    [alpha, beta, gamma]
}

fn picker_rig_of(choices: PickerChoice[], view: PickerView) -> PickerRig {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let query = ui.signal(cx, "")
    let selected = ui.signal(cx, -1)
    let log = new_log(cx)
    let handlers = PickerHandlers {
        typed: fn(v: str) {
            ui.set(query, v)
            ui.set(selected, -1)
        }
        moved: fn(i: i64) { ui.set(selected, i) }
        chosen: fn(i: i64) { note(log, "chosen {i}") }
        submitted: fn(v: str) { note(log, "submitted {v}") }
        dismissed: fn() { note(log, "dismissed") }
    }
    let paint = fn() -> ui.Element {
        let typed = ui.get(query)
        let shown = picker_filtered(choices, typed)
        let at = picker_selected(shown, ui.get(selected))
        ui.div().size(700.0, 700.0).child(picker_element(look, cx, view, typed, at, shown, handlers))
    }
    PickerRig { cx, look, view, query, selected, log, paint }
}

fn picker_open(choices: PickerChoice[]) -> PickerRig {
    let view = PickerView { id: "pick", placeholder: "Search", empty: "Nothing here" }
    let r = picker_rig_of(choices, view)
    picker_shot(r)
    ui.set_focus(r.cx, picker_field_id(r.view))
    r
}

fn picker_shot(r: PickerRig) -> scene.Scene {
    ui.frame(r.cx, r.paint, geometry.size(700.0, 700.0), 1.0)
}

fn picker_logged(r: PickerRig) -> str[] {
    ui.get(r.log)
}

fn picker_row_count(r: PickerRig, limit: i64) -> i64 {
    var found = 0
    for index in 0..limit {
        if ui.bounds_of(r.cx, "pick-{index}") != none {
            found += 1
        }
    }
    found
}

fn test_a_picker_is_a_raised_bordered_popover_with_a_shadow_at_the_set_width(t: *testing.T) {
    let r = picker_open(picker_sample_choices(3))
    let sc = picker_shot(r)
    let panel = bounds_for(r.cx, "pick")
    same_number(t, panel.width, picker_width)
    let fill = filled(sc)[0]
    same_colour(t, fill.background, r.look.raised)
    t.equal(fill.corner_radii.top_left, 10.0)
    let ring = outlined(sc)
    same_colour(t, ring.border_color, r.look.border)
    t.equal(sc.shadows.len, 1)
}

fn test_a_picker_view_sets_its_width(t: *testing.T) {
    let view = PickerView { id: "pick", placeholder: "Search", empty: "Nothing here", width: 600.0 }
    let r = picker_rig_of(picker_sample_choices(2), view)
    picker_shot(r)
    same_number(t, bounds_for(r.cx, "pick").width, 600.0)
}

fn test_the_query_bar_is_thirty_six_high_above_a_hairline(t: *testing.T) {
    let r = picker_open(picker_sample_choices(3))
    picker_shot(r)
    let panel = bounds_for(r.cx, "pick")
    let field = bounds_for(r.cx, picker_field_id(r.view))
    t.is_true(field.y >= panel.y + 1.0)
    t.is_true(field.y + field.height <= panel.y + 1.0 + picker_bar_height)
    let first = bounds_for(r.cx, "pick-0")
    same_number(t, first.y, panel.y + 1.0 + picker_bar_height + 1.0 + floor(step(1.0)))
}

fn test_a_row_with_a_detail_is_forty_high_and_one_without_is_thirty(t: *testing.T) {
    let r = picker_open(picker_sample_choices(2))
    picker_shot(r)
    same_number(t, bounds_for(r.cx, "pick-0").height, 40.0)
    let plain = picker_rig_of(picker_plain_choices(), PickerView { id: "pick", placeholder: "Search", empty: "Nothing here" })
    picker_shot(plain)
    same_number(t, bounds_for(plain.cx, "pick-0").height, 30.0)
    same_number(t, bounds_for(plain.cx, "pick-1").y, bounds_for(plain.cx, "pick-0").y + 30.0)
}

fn test_the_first_row_is_selected_until_the_arrow_keys_move_it(t: *testing.T) {
    let r = picker_open(picker_sample_choices(4))
    let sc = picker_shot(r)
    t.equal(selected_row(r.cx, sc, r.look, "pick", 4), 0)
    key_down(r.cx, platform.NamedKey.Down)
    let moved = picker_shot(r)
    t.equal(selected_row(r.cx, moved, r.look, "pick", 4), 1)
    key_down(r.cx, platform.NamedKey.Up)
    picker_shot(r)
    key_down(r.cx, platform.NamedKey.Up)
    let wrapped = picker_shot(r)
    t.equal(selected_row(r.cx, wrapped, r.look, "pick", 4), 3)
    key_down(r.cx, platform.NamedKey.Down)
    let around = picker_shot(r)
    t.equal(selected_row(r.cx, around, r.look, "pick", 4), 0)
}

fn test_page_down_and_page_up_move_the_selection_a_screen_and_stop_at_the_ends(t: *testing.T) {
    let r = picker_open(picker_sample_choices(25))
    picker_shot(r)
    key_down(r.cx, platform.NamedKey.PageDown)
    let first = picker_shot(r)
    t.equal(selected_row(r.cx, first, r.look, "pick", 25), picker_visible_rows)
    key_down(r.cx, platform.NamedKey.PageDown)
    picker_shot(r)
    key_down(r.cx, platform.NamedKey.PageDown)
    let last = picker_shot(r)
    t.equal(selected_row(r.cx, last, r.look, "pick", 25), 24)
    key_down(r.cx, platform.NamedKey.PageUp)
    let back = picker_shot(r)
    t.equal(selected_row(r.cx, back, r.look, "pick", 25), 14)
    key_down(r.cx, platform.NamedKey.PageUp)
    picker_shot(r)
    key_down(r.cx, platform.NamedKey.PageUp)
    let top = picker_shot(r)
    t.equal(selected_row(r.cx, top, r.look, "pick", 25), 0)
}

fn test_enter_chooses_the_selected_row(t: *testing.T) {
    let r = picker_open(picker_sample_choices(4))
    picker_shot(r)
    key_down(r.cx, platform.NamedKey.Down)
    picker_shot(r)
    key_down(r.cx, platform.NamedKey.Down)
    picker_shot(r)
    key_down(r.cx, platform.NamedKey.Enter)
    t.equal(picker_logged(r).len, 1)
    t.equal(picker_logged(r)[0], "chosen 2")
}

fn test_escape_dismisses_the_picker(t: *testing.T) {
    let r = picker_open(picker_sample_choices(2))
    key_down(r.cx, platform.NamedKey.Escape)
    t.equal(picker_logged(r)[0], "dismissed")
}

fn test_clicking_a_row_chooses_it(t: *testing.T) {
    let r = picker_open(picker_sample_choices(4))
    picker_shot(r)
    click_key(r.cx, "pick-2")
    t.equal(picker_logged(r).len, 1)
    t.equal(picker_logged(r)[0], "chosen 2")
}

fn test_pressing_outside_the_picker_dismisses_it(t: *testing.T) {
    let r = picker_open(picker_sample_choices(2))
    picker_shot(r)
    click_at(r.cx, 390.0, 690.0)
    t.equal(picker_logged(r).len, 1)
    t.equal(picker_logged(r)[0], "dismissed")
}

fn test_pressing_inside_the_picker_does_not_dismiss_it(t: *testing.T) {
    let r = picker_open(picker_sample_choices(4))
    picker_shot(r)
    let bar = bounds_for(r.cx, picker_field_id(r.view))
    click_at(r.cx, bar.x + 4.0, bar.y + 4.0)
    t.equal(picker_logged(r).len, 0)
}

fn test_a_press_on_the_element_that_owns_the_picker_leaves_the_dismissing_to_that_element(t: *testing.T) {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let log = new_log(cx)
    let view = PickerView { id: "pick", placeholder: "Search", empty: "Nothing here", owner: "trigger" }
    let handlers = PickerHandlers {
        typed: fn(v: str) {}
        moved: fn(i: i64) {}
        chosen: fn(i: i64) {}
        submitted: fn(v: str) {}
        dismissed: fn() { note(log, "dismissed") }
    }
    let paint = fn() -> ui.Element {
        let trigger = ui.div().id("trigger").size(60.0, 28.0)
        let card = ui.div().absolute().left(200.0).top(100.0).child(picker_element(look, cx, view, "", -1, [], handlers))
        ui.div().size(700.0, 700.0).relative().child(trigger).child(card)
    }
    shot(cx, paint)
    let owner = centre_of(cx, "trigger")
    click_at(cx, owner.x, owner.y)
    t.equal(ui.get(log).len, 0)
    click_at(cx, 690.0, 690.0)
    t.equal(ui.get(log).len, 1)
}

fn test_typed_text_reaches_the_field_and_filters_every_word_in_any_order(t: *testing.T) {
    let r = picker_open(picker_plain_choices())
    type_text(r.cx, "e")
    picker_shot(r)
    t.equal(ui.get(r.query), "e")
    t.equal(picker_row_count(r, 3), 2)
    type_text(r.cx, "r")
    picker_shot(r)
    t.equal(ui.get(r.query), "er")
    t.equal(picker_row_count(r, 3), 1)
    t.equal(ui.get(r.selected), -1)
}

fn test_the_filter_reads_the_name_the_detail_and_the_keywords(t: *testing.T) {
    let choices = [picker_choice("one", "Orders", "dbo.orders", "table"), picker_choice("two", "Customers", "dbo.customers", "view")]
    t.equal(picker_filtered(choices, "dbo").len, 2)
    t.equal(picker_filtered(choices, "VIEW").len, 1)
    t.equal(picker_filtered(choices, "cust  dbo").len, 1)
    t.equal(picker_filtered(choices, "nothing").len, 0)
    t.equal(picker_filtered(choices, "  ").len, 2)
}

fn test_enter_with_no_rows_submits_the_typed_text_and_chooses_nothing(t: *testing.T) {
    let r = picker_open(picker_plain_choices())
    type_text(r.cx, "z")
    picker_shot(r)
    type_text(r.cx, "z")
    picker_shot(r)
    t.equal(picker_row_count(r, 3), 0)
    key_down(r.cx, platform.NamedKey.Enter)
    t.equal(picker_logged(r).len, 1)
    t.equal(picker_logged(r)[0], "submitted zz")
}

fn test_a_status_replaces_the_rows(t: *testing.T) {
    let view = PickerView { id: "pick", placeholder: "Search", empty: "Nothing here", status: "Loading" }
    let r = picker_rig_of(picker_plain_choices(), view)
    picker_shot(r)
    t.equal(picker_row_count(r, 3), 0)
}

fn test_the_current_choice_starts_selected_and_wears_a_check(t: *testing.T) {
    let r = picker_open(picker_plain_choices())
    let sc = picker_shot(r)
    t.equal(selected_row(r.cx, sc, r.look, "pick", 3), 2)
    t.is_true(tinted(sc, r.look.accent) > 0)
}

fn test_the_selection_scrolls_into_view_past_the_last_visible_row(t: *testing.T) {
    let r = picker_open(picker_sample_choices(25))
    picker_shot(r)
    let list = bounds_for(r.cx, picker_list_id(r.view))
    t.is_true(list.height > 405.0 && list.height < 407.0)
    for _ in 0..14 {
        key_down(r.cx, platform.NamedKey.Down)
        picker_shot(r)
    }
    t.is_true(ui.scroll_offset(r.cx, picker_list_id(r.view)).y > 0.0)
    let row = bounds_for(r.cx, "pick-14")
    t.is_true(row.y >= list.y)
    t.is_true(row.y + row.height <= list.y + list.height)
    for _ in 0..14 {
        key_down(r.cx, platform.NamedKey.Up)
        picker_shot(r)
    }
    same_number(t, ui.scroll_offset(r.cx, picker_list_id(r.view)).y, 0.0)
}

fn test_arrow_keys_inside_the_field_are_left_to_the_field(t: *testing.T) {
    let r = picker_open(picker_plain_choices())
    type_text(r.cx, "a")
    picker_shot(r)
    key_down(r.cx, platform.NamedKey.Left)
    picker_shot(r)
    type_text(r.cx, "b")
    picker_shot(r)
    t.equal(ui.get(r.query), "ba")
}

fn test_a_windowed_picker_draws_only_the_rows_in_view_and_scrolls_to_the_selection(t: *testing.T) {
    let view = PickerView { id: "pick", placeholder: "Search", empty: "Nothing here", windowed: true }
    let r = picker_rig_of(picker_sample_choices(2000), view)
    picker_shot(r)
    ui.set_focus(r.cx, picker_field_id(r.view))
    picker_shot(r)
    t.is_true(picker_row_count(r, 40) <= picker_visible_rows + 1)
    t.is_true(ui.bounds_of(r.cx, "pick-20") == none)
    for _ in 0..20 {
        key_down(r.cx, platform.NamedKey.Down)
        picker_shot(r)
    }
    let list = bounds_for(r.cx, picker_list_id(r.view))
    let row = bounds_for(r.cx, "pick-20")
    t.is_true(ui.scroll_offset(r.cx, picker_list_id(r.view)).y > 0.0)
    t.is_true(row.y >= list.y)
    t.is_true(row.y + row.height <= list.y + list.height)
}

fn test_a_choice_tone_colours_its_glyph(t: *testing.T) {
    let plain = PickerChoice { key: "a", name: "Alpha", glyph: "check" }
    let failed = PickerChoice { key: "b", name: "Beta", glyph: "check", tone: PickerTone.Danger }
    let rest = picker_rig_of([plain], PickerView { id: "pick", placeholder: "Search", empty: "Nothing here" })
    let toned = picker_rig_of([failed], PickerView { id: "pick", placeholder: "Search", empty: "Nothing here" })
    t.equal(tinted(picker_shot(rest), rest.look.danger), 0)
    t.is_true(tinted(picker_shot(toned), toned.look.danger) > 0)
}

fn picker_selected_index(r: PickerRig) -> i64 {
    picker_selected(picker_filtered(picker_sample_choices(2000), ui.get(r.query)), ui.get(r.selected))
}

fn picker_presses(r: PickerRig, named: platform.NamedKey, count: i64) {
    for _ in 0..count {
        key_down(r.cx, named)
        picker_shot(r)
    }
}

fn picker_row_gap(r: PickerRig) -> f32 {
    let list = bounds_for(r.cx, picker_list_id(r.view))
    let row = bounds_for(r.cx, "pick-{picker_selected_index(r)}")
    (row.y + row.height / 2.0) - (list.y + list.height / 2.0)
}

fn test_a_windowed_picker_centres_the_selection_when_arrow_keys_leave_the_view(t: *testing.T) {
    let view = PickerView { id: "pick", placeholder: "Search", empty: "Nothing here", windowed: true }
    let r = picker_rig_of(picker_sample_choices(2000), view)
    picker_shot(r)
    ui.set_focus(r.cx, picker_field_id(r.view))
    picker_shot(r)
    picker_presses(r, platform.NamedKey.Down, 5)
    t.equal(ui.scroll_offset(r.cx, picker_list_id(r.view)).y, 0.0)
    picker_presses(r, platform.NamedKey.Down, 20)
    t.is_true(picker_selected_index(r) >= 20)
    t.is_true(picker_row_gap(r) > -1.5 && picker_row_gap(r) < 1.5)
    picker_presses(r, platform.NamedKey.Up, 15)
    t.is_true(picker_row_gap(r) > -1.5 && picker_row_gap(r) < 1.5)
}

fn test_a_picker_choice_keeps_its_code_face_beside_an_area(t: *testing.T) {
    let plain = PickerChoice { key: "a", name: "select 1", area: "Query" }
    var code = plain
    code.code = true
    let view = PickerView { id: "pick", placeholder: "Search", empty: "Nothing here" }
    let rest = picker_rig_of([plain], view)
    let coded = picker_rig_of([code], view)
    let before = picker_row_ink(rest, picker_shot(rest))
    let after = picker_row_ink(coded, picker_shot(coded))
    t.is_true(before > 0.0)
    t.is_true(after != before)
}

fn picker_row_ink(r: PickerRig, sc: scene.Scene) -> f32 {
    let row = bounds_for(r.cx, "pick-0")
    var ink: f32 = 0.0
    for sprite in sc.sprites {
        if sprite.bounds.y >= row.y && sprite.bounds.y + sprite.bounds.height <= row.y + row.height {
            ink += sprite.bounds.width
        }
    }
    ink
}
