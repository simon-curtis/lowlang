import std/ui

const path_browser_width: f32 = 560.0
const path_browser_height: f32 = 480.0

/// One row of a path browser: a folder, a drive or a file.
pub struct PathEntry {
    /// The name of the folder, drive or file, as the row shows it.
    pub name: str
    /// Whether the row is a folder or a drive, which draws a folder glyph; `false` draws a file glyph.
    pub directory: bool
}

/// What a path browser shows: its name, the place it lists, the rows of that place, whether a listing is under way, the reason the last one failed, the file name being typed when a file is chosen, and the label of the button that chooses.
pub struct PathBrowser {
    /// The name of the browser, which its element ids, such as `{id}-card` and `{id}-list`, are built from.
    pub id: str
    /// The heading of the card.
    pub title: str
    /// The place being listed, shown in the code font. Empty shows `Drives on the server`.
    pub place: str
    /// The rows of the place, in the order they are drawn.
    pub entries: PathEntry[]
    /// Whether a listing is under way, which shows `Listing…` in place of the rows.
    pub loading: bool
    /// The reason the last listing failed, drawn under the rows. Defaults to `none`.
    pub status: str? = none
    /// The file name being typed when a file is chosen, in a field under the rows. Defaults to `none`, which draws no field.
    pub file: str? = none
    /// The label of the button that chooses.
    pub verb: str
}

/// What the browser's controls do: climb a level, show the drives, open the row at an index, edit the file name, choose and dismiss.
pub struct PathBrowserHandlers {
    /// Called when Up is pressed.
    pub up: fn()
    /// Called when Drives is pressed.
    pub drives: fn()
    /// Called with the index into `entries` of a row that is clicked.
    pub opened: fn(i64)
    /// Called with the whole file name each time the file name field changes.
    pub named: fn(str)
    /// Called when the button that chooses is pressed.
    pub chosen: fn()
    /// Called when Cancel is pressed.
    pub dismissed: fn()
}

/// The id of the row of a path browser called `id` at `index`.
pub fn path_browser_row_id(id: str, index: i64) -> str {
    "{id}-row-{index}"
}

/// The id of the list of rows of a path browser called `id`.
pub fn path_browser_list_id(id: str) -> str {
    "{id}-list"
}

fn path_browser_row(t: Theme, view: PathBrowser, index: i64, entry: PathEntry, opened: fn(i64)) -> ui.Element {
    let glyph = if entry.directory { "folder" } else { "file" }
    let label = ui.div().min_width(0.0).overflow_hidden().child(ui.text(entry.name).nowrap().ellipsis())
    row(t, path_browser_row_id(view.id, index), false, fn() { opened(index) }).child(small_icon_in(glyph, t.muted)).child(label)
}

fn path_browser_listing(t: Theme, view: PathBrowser, opened: fn(i64)) -> ui.Element {
    if view.loading {
        return empty(t, "Listing…")
    }
    if view.entries.len == 0 {
        return empty(t, "Nothing here")
    }
    var rows: ui.Element[] = []
    for index, entry in view.entries {
        rows.push(path_browser_row(t, view, index, entry, opened))
    }
    ui.column(ui.div()).children(rows)
}

fn path_browser_place(t: Theme, view: PathBrowser) -> ui.Element {
    let shown = if view.place == "" { "Drives on the server" } else { view.place }
    ui.div().grow(1.0).min_width(0.0).overflow_hidden().font_family(code_font).child(ui.text(shown).nowrap().ellipsis())
}

fn path_browser_bar(t: Theme, view: PathBrowser, handlers: PathBrowserHandlers) -> ui.Element {
    let up = tooltip(t, icon_button(t, "{view.id}-up", "arrow-up", handlers.up), "Up one folder")
    let drives = tooltip(t, icon_button(t, "{view.id}-drives", "hard-drive", handlers.drives), "Drives")
    ui.row(ui.div()).items_center().gap(step(2.0)).child(up).child(drives).child(path_browser_place(t, view))
}

/// A popover card that browses a tree of folders, such as the drives and folders of another machine: its title, a bar with Up, Drives and the place being listed, the rows of that place, a field for the file name when a file is chosen, the reason a listing failed, and Cancel beside the button that chooses. Opening a row, Up and Drives are `handlers`' to answer; the card closes nothing itself.
pub fn path_browser(t: Theme, view: PathBrowser, handlers: PathBrowserHandlers) -> ui.Element {
    let heading = ui.text(view.title).text_size(heading_size).font_weight(semibold)
    let list = ui.column(ui.div()).id(path_browser_list_id(view.id)).grow(1.0).min_height(0.0).overflow_y_scroll().border(1.0, t.border).rounded(radius).padding(step(1.0)).child(path_browser_listing(t, view, handlers.opened)).scrollbar(scrollbars(t))
    var parts: ui.Element[] = [heading, path_browser_bar(t, view, handlers), list]
    match view.file {
        some(name) => parts.push(form_input(t, "{view.id}-file", name, "File name", handlers.named))
        none => {}
    }
    match view.status {
        some(reason) => parts.push(form_failure(t, reason))
        none => {}
    }
    let actions = ui.row(ui.div()).justify_end().gap(step(2.0)).child(button(t, "{view.id}-cancel", "Cancel", Secondary, handlers.dismissed)).child(button(t, "{view.id}-choose", view.verb, Primary, handlers.chosen))
    parts.push(actions)
    ui.column(popover(t)).id("{view.id}-card").width(path_browser_width).height(path_browser_height).shrink(0.0).padding(step(3.0)).gap(step(2.0)).text_color(t.text).text_size(small_size).font_family(ui_font).children(parts)
}
