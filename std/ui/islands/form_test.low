import std/testing
import std/ui
import std/ui/platform

const form_dialog: str = "form-dialog"

fn form_key(text: str) -> platform.KeyEvent {
    platform.KeyEvent { key: platform.Key.Character(text), text: text }
}

fn form_named(named: platform.NamedKey) -> platform.KeyEvent {
    platform.KeyEvent { key: platform.Key.Named(named) }
}

fn form_chord(letter: str) -> platform.KeyEvent {
    platform.KeyEvent { key: platform.Key.Character(letter), text: letter, modifiers: platform.Modifiers { control: true } }
}

fn test_typing_appends_to_a_secret(t: *testing.T) {
    t.equal(form_secret_edited("ab", form_key("c"), none) ?? "", "abc")
    t.equal(form_secret_edited("", form_key("é"), none) ?? "", "é")
}

fn test_backspace_removes_the_last_character_and_control_backspace_clears(t: *testing.T) {
    t.equal(form_secret_edited("abc", form_named(platform.NamedKey.Backspace), none) ?? "x", "ab")
    t.equal(form_secret_edited("é", form_named(platform.NamedKey.Backspace), none) ?? "x", "")
    t.equal(form_secret_edited("", form_named(platform.NamedKey.Backspace), none) ?? "x", "")
    let cleared = platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Backspace), modifiers: platform.Modifiers { control: true } }
    t.equal(form_secret_edited("abc", cleared, none) ?? "x", "")
}

fn test_control_v_pastes_one_line_of_the_clipboard(t: *testing.T) {
    t.equal(form_secret_edited("ab", form_chord("v"), "cd\nef") ?? "x", "abcdef")
    t.is_none(form_secret_edited("ab", form_chord("v"), none))
}

fn test_a_secret_leaves_enter_tab_escape_releases_and_other_chords_alone(t: *testing.T) {
    t.is_none(form_secret_edited("ab", form_named(platform.NamedKey.Enter), none))
    t.is_none(form_secret_edited("ab", form_named(platform.NamedKey.Tab), none))
    t.is_none(form_secret_edited("ab", form_named(platform.NamedKey.Escape), none))
    t.is_none(form_secret_edited("ab", form_chord("a"), none))
    let released = platform.KeyEvent { key: platform.Key.Character("c"), text: "c", pressed: false }
    t.is_none(form_secret_edited("ab", released, none))
}

fn test_a_text_area_edit_splices_lines(t: *testing.T) {
    let insert = ui.TextEdit { start: ui.TextPosition { line: 0, column: 3 }, end: ui.TextPosition { line: 0, column: 3 }, text: "X" }
    t.equal(form_area_edited("abc\ndef", insert), "abcX\ndef")
    let split = ui.TextEdit { start: ui.TextPosition { line: 0, column: 1 }, end: ui.TextPosition { line: 0, column: 1 }, text: "\n" }
    t.equal(form_area_edited("abc", split), "a\nbc")
    let spanning = ui.TextEdit { start: ui.TextPosition { line: 0, column: 2 }, end: ui.TextPosition { line: 2, column: 1 }, text: "" }
    t.equal(form_area_edited("abc\ndef\nghi", spanning), "abhi")
    let tail = ui.TextEdit { start: ui.TextPosition { line: 1, column: 0 }, end: ui.TextPosition { line: 1, column: 3 }, text: "" }
    t.equal(form_area_edited("abc\ndef\nghi", tail), "abc\n\nghi")
}

fn test_an_edit_replaces_a_range_across_the_lines_of_a_list(t: *testing.T) {
    let lines = ["abc", "def", "ghi", "jkl"]
    let across = ui.TextEdit { start: ui.TextPosition { line: 0, column: 3 }, end: ui.TextPosition { line: 2, column: 1 }, text: "-\n-" }
    t.equal_slice(form_lines_edited(lines, across), ["abc-", "-hi", "jkl"])
    let blank = ui.TextEdit { start: ui.TextPosition {}, end: ui.TextPosition {}, text: "x" }
    t.equal_slice(form_lines_edited([""], blank), ["x"])
}

fn test_a_text_area_grows_between_three_and_six_rows(t: *testing.T) {
    t.equal(form_area_rows("", 3, 6), 3)
    t.equal(form_area_rows("a\nb\nc\nd", 3, 6), 4)
    t.equal(form_area_rows("a\nb\nc\nd\ne\nf\ng\nh", 3, 6), 6)
}

struct FormCase {
    cx: ui.Context
    secret: ui.Signal[str]
    name: ui.Signal[str]
    saved: ui.Signal[i64]
    view: fn() -> ui.Element
}

fn secret_form_card(cx: ui.Context, look: Theme, secret: ui.Signal[str], name: ui.Signal[str], saved: ui.Signal[i64]) -> ui.Element {
    let save = fn() { ui.update(saved, fn(n: i64) -> i64 { n + 1 }) }
    let enter = fn(k: platform.KeyEvent) -> bool {
        if !k.pressed {
            return false
        }
        match k.key {
            Named(named) => {
                match named {
                    Enter => {
                        save()
                        true
                    }
                    _ => false
                }
            }
            Character(letter) => false
        }
    }
    let nameless = form_field(look, "form-name", "Name", ui.get(name), "Name", fn(v: str) { ui.set(name, v) })
    let hidden = form_secret(look, cx, "form-secret", "Password", "Password", fn() -> str { ui.get(secret) }, fn(v: str) { ui.set(secret, v) })
    ui.column(popover(look)).id("form-card").width(400.0).padding(step(5.0)).gap(step(3.0)).on_key(enter).child(nameless).child(hidden)
}

fn form_opened() -> FormCase {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let secret = ui.signal(cx, "")
    let name = ui.signal(cx, "")
    let saved = ui.signal(cx, 0)
    let view = fn() -> ui.Element { ui.div().size(600.0, 500.0) }
    shot(cx, view)
    ui.open_dialog(cx, form_dialog, fn() -> ui.Element { secret_form_card(cx, look, secret, name, saved) })
    shot(cx, view)
    FormCase { cx, secret, name, saved, view }
}

fn test_a_secret_in_a_dialog_takes_focus_by_tab_and_hides_what_is_typed(t: *testing.T) {
    let c = form_opened()
    t.equal(ui.focused(c.cx), "form-name-entry")
    key_down(c.cx, platform.NamedKey.Tab)
    shot(c.cx, c.view)
    t.equal(ui.focused(c.cx), "form-secret")
    type_text(c.cx, "p")
    type_text(c.cx, "w")
    shot(c.cx, c.view)
    t.equal(ui.get(c.secret), "pw")
    t.equal(ui.get(c.name), "")
    key_down(c.cx, platform.NamedKey.Backspace)
    t.equal(ui.get(c.secret), "p")
}

fn test_a_click_on_a_secret_focuses_it_and_enter_saves_without_a_click_saving(t: *testing.T) {
    let c = form_opened()
    click_key(c.cx, "form-secret")
    shot(c.cx, c.view)
    t.equal(ui.focused(c.cx), "form-secret")
    click_key(c.cx, "form-name-entry")
    t.equal(ui.get(c.saved), 0)
    type_text(c.cx, "a")
    key_down(c.cx, platform.NamedKey.Enter)
    t.equal(ui.get(c.saved), 1)
    t.equal(ui.get(c.name), "a")
}

fn test_a_dot_takes_its_colour_from_a_hex_and_a_blank_takes_the_control_colour(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let sc = shot(cx, fn() -> ui.Element { ui.row(ui.div()).child(form_dot(look, "dot-red", "#e5484d", false, fn() {})).child(form_dot(look, "dot-none", "", true, fn() {})) })
    var reds = 0
    for q in filled(sc) {
        if near(q.background.r, 229.0 / 255.0) && near(q.background.g, 72.0 / 255.0) {
            reds += 1
        }
    }
    t.equal(reds, 1)
}
