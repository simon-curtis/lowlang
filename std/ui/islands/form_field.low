import std/builder
import std/text
import std/ui
import std/ui/geometry
import std/ui/platform
import std/unicode

const form_dot_size: f32 = 20.0
const form_label_gap: f32 = 6.0
const form_mask: str = "*"
const form_caret_width: f32 = 1.0
const form_caret_height: f32 = 14.0

/// Returns `content` in small text in the muted colour.
pub fn form_caption(t: Theme, content: str) -> ui.Element {
    ui.text(content).text_size(small_size).text_color(t.muted)
}

/// Returns `content` in small, wrapping text in the faint colour.
pub fn form_note(t: Theme, content: str) -> ui.Element {
    ui.text(content).text_size(small_size).text_color(t.faint).wrapping()
}

/// Returns `content` in small, wrapping text in the danger colour.
pub fn form_failure(t: Theme, content: str) -> ui.Element {
    ui.text(content).text_size(small_size).text_color(t.danger).wrapping()
}

fn form_box(t: Theme, id: str) -> ui.Element {
    ui.row(ui.div()).id(id).height(control_height).items_center().padding_xy(step(2.0), 0.0).rounded(radius).background(t.control).border(1.0, t.border).text_size(body_size)
}

fn form_labelled(t: Theme, label: str, box: ui.Element) -> ui.Element {
    ui.column(ui.div()).gap(form_label_gap).child(field_label(t, label)).child(box)
}

/// A single-line input in a bordered control-coloured box of the control height, its field named `{id}-entry`.
pub fn form_input(t: Theme, id: str, value: str, hint: str, edited: fn(str)) -> ui.Element {
    let entry = ui.field(value).id("{id}-entry").placeholder(hint).placeholder_color(t.faint).grow(1.0).shrink(1.0).min_width(0.0).on_change(edited)
    form_box(t, id).child(entry)
}

/// Returns a `form_input` under `label`, with `hint` shown while it is empty. `edited` is called with the whole text at each change.
pub fn form_field(t: Theme, id: str, label: str, value: str, hint: str, edited: fn(str)) -> ui.Element {
    form_labelled(t, label, form_input(t, id, value, hint, edited))
}

fn form_single_line(content: str) -> str {
    var kept = builder.builder()
    for c in content {
        if c >= 32 && c != 127 {
            builder.write_char(mut kept, c)
        }
    }
    builder.to_str(kept)
}

fn form_without_last(value: str) -> str {
    var start = 0
    for start < value.len {
        let stop = unicode.grapheme_end(value, start)
        if stop >= value.len {
            return value[..start]
        }
        start = stop
    }
    ""
}

fn form_masked(value: str) -> str {
    var shown = builder.builder()
    for _ in value {
        builder.write(mut shown, form_mask)
    }
    builder.to_str(shown)
}

fn form_secret_edited(value: str, k: platform.KeyEvent, pasted: str?) -> str? {
    if !k.pressed {
        return none
    }
    let shortcut = (k.modifiers.control || k.modifiers.super) && !k.modifiers.alt
    match k.key {
        Named(named) => {
            match named {
                Backspace => {
                    if k.modifiers.control {
                        return ""
                    }
                    form_without_last(value)
                }
                _ => none
            }
        }
        Character(letter) => {
            if shortcut {
                if text.lower(letter) == "v" {
                    let clip = pasted ?? return none
                    return "{value}{form_single_line(clip)}"
                }
                return none
            }
            let typed = form_single_line(k.text)
            if typed.len == 0 {
                return none
            }
            "{value}{typed}"
        }
    }
}

fn form_secret_key(cx: ui.Context, current: fn() -> str, edited: fn(str)) -> fn(platform.KeyEvent) -> bool {
    fn(k: platform.KeyEvent) -> bool {
        let next = form_secret_edited(current(), k, ui.clipboard(cx)) ?? return false
        edited(next)
        true
    }
}

/// Returns a labelled box called `id` that takes typed text and draws each character as `*`, with `hint` while it is empty and a caret while it has the focus. `current` returns the text and `edited` receives it with each key applied: typing and pasting add to the end as one line, Backspace removes the last character and Ctrl and Backspace clear it.
pub fn form_secret(t: Theme, cx: ui.Context, id: str, label: str, hint: str, current: fn() -> str, edited: fn(str)) -> ui.Element {
    let value = current()
    var parts: ui.Element[] = []
    if value.len == 0 {
        parts.push(ui.text(hint).text_color(t.faint).nowrap())
    } else {
        parts.push(ui.text(form_masked(value)).text_color(t.text).nowrap())
    }
    if ui.focused(cx) == id {
        parts.push(ui.div().size(form_caret_width, form_caret_height).shrink(0.0).background(t.text))
    }
    let box = form_box(t, id).focusable().cursor(platform.Cursor.Text).on_key(form_secret_key(cx, current, edited)).children(parts)
    form_labelled(t, label, box)
}

/// Returns `lines` with the range `edit` names replaced by its text.
pub fn form_lines_edited(lines: str[], edit: ui.TextEdit) -> str[] {
    let head = lines[edit.start.line][..edit.start.column]
    let tail = lines[edit.end.line][edit.end.column..]
    var kept: str[] = []
    for i in 0..edit.start.line {
        kept.push(lines[i])
    }
    for part in text.split_str("{head}{edit.text}{tail}", "\n") {
        kept.push(part)
    }
    for i in edit.end.line + 1..lines.len {
        kept.push(lines[i])
    }
    kept
}

fn form_area_edited(value: str, edit: ui.TextEdit) -> str {
    text.join(form_lines_edited(text.split_str(value, "\n"), edit), "\n")
}

/// Returns the text area source over the lines `current` returns, which `edited` receives with each edit applied.
pub fn form_lines_source(current: fn() -> str[], edited: fn(str[])) -> ui.LineSource {
    let count = fn() -> i64 { current().len }
    let line = fn(i: i64) -> str {
        let lines = current()
        if i < 0 || i >= lines.len {
            return ""
        }
        lines[i]
    }
    let apply = fn(e: ui.TextEdit) { edited(form_lines_edited(current(), e)) }
    ui.line_source(count, line, apply)
}

/// Returns the text area source over the text `current` returns, which `edited` receives with each edit applied.
pub fn form_area_source(current: fn() -> str, edited: fn(str)) -> ui.LineSource {
    let lines = fn() -> str[] { text.split_str(current(), "\n") }
    let apply = fn(joined: str[]) { edited(text.join(joined, "\n")) }
    form_lines_source(lines, apply)
}

fn form_area_rows(value: str, fewest: i64, most: i64) -> i64 {
    let lines = text.split_str(value, "\n").len
    match lines {
        < fewest => fewest
        > most => most
        _ => lines
    }
}

/// Returns a labelled box called `id` holding a text area in the code font, with `hint` while it is empty, over the text `current` returns, which `edited` receives with each edit applied. The box is as tall as the text, from 3 to 6 lines, and the text scrolls beyond that.
pub fn form_area(t: Theme, id: str, label: str, hint: str, current: fn() -> str, edited: fn(str)) -> ui.Element {
    let value = current()
    let rows = form_area_rows(value, 3, 6)
    let line = form_area_line_height
    let height = f32(rows) * line + step(2.0)
    let area = ui.text_area(form_area_source(current, edited)).id("{id}-entry").grow(1.0).shrink(0.0).text_size(body_size).font_family(code_font).line_height(line).text_color(t.text).height(f32(rows) * line).scrollbar(scrollbars(t))
    var layers: ui.Element[] = []
    if value.len == 0 {
        layers.push(form_area_hint(t, hint, line, body_size, step(1.0), step(2.0)))
    }
    layers.push(area)
    let box = ui.row(ui.div()).id(id).relative().height(height).items_center().padding_xy(step(2.0), 0.0).rounded(radius).background(t.control).border(1.0, t.border).children(layers)
    form_labelled(t, label, box)
}

const form_area_line_height: f32 = 18.0

fn form_area_hint(t: Theme, hint: str, line: f32, size: f32, top: f32, left: f32) -> ui.Element {
    ui.text(hint).absolute().top(top).left(left).line_height(line).text_color(t.faint).text_size(size).nowrap()
}

fn form_lines_blank(lines: str[]) -> bool {
    lines.len == 0 || (lines.len == 1 && lines[0].len == 0)
}

/// A text area without a box that fills its parent and shows `hint` while it holds nothing, over the lines `current` returns.
pub fn form_notes(t: Theme, id: str, hint: str, size: f32, line: f32, family: str, current: fn() -> str[], edited: fn(str[])) -> ui.Element {
    var layers: ui.Element[] = []
    if form_lines_blank(current()) {
        layers.push(form_area_hint(t, hint, line, size, 0.0, 0.0))
    }
    layers.push(ui.text_area(form_lines_source(current, edited)).id(id).grow(1.0).min_width(0.0).height(0.0).text_size(size).font_family(family).line_height(line).text_color(t.text).scrollbar(scrollbars(t)))
    ui.column(ui.div()).grow(1.0).min_height(0.0).relative().children(layers)
}

fn form_hex(hex: str) -> u32? {
    if hex.len != 7 || hex[0..1] != "#" {
        return none
    }
    let parsed = text.parse_u64(hex[1..], 16) catch {
        e => return none
    }
    u32(parsed)
}

/// The colour a `#rrggbb` text names, or `fallback` for any other text.
pub fn colour_named(hex: str, fallback: geometry.Color) -> geometry.Color {
    match form_hex(hex) {
        some(rgb) => ui.rgb(rgb)
        none => fallback
    }
}

/// Returns a round swatch called `name`, 20 pixels across, filled with the colour `hex` names, or the control colour when it names none. A selected swatch has a ring in the text colour and the others in the border colour. `clicked` is called when it is clicked.
pub fn form_dot(t: Theme, name: str, hex: str, selected: bool, clicked: fn()) -> ui.Element {
    let fill = colour_named(hex, t.control)
    let ring = if selected { t.text } else { t.border }
    ui.div().id(name).size(form_dot_size, form_dot_size).shrink(0.0).rounded(form_dot_size / 2.0).background(fill).border(2.0, ring).cursor(platform.Cursor.Pointer).hover(form_dot_hovered(t)).on_click(click(clicked))
}

fn form_dot_hovered(t: Theme) -> fn(ui.Visual) -> ui.Visual {
    fn(v: ui.Visual) -> ui.Visual { v.with_border_color(t.muted) }
}
