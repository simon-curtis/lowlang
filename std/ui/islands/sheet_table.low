import std/math
import std/slices
import std/text

const sheet_sample_rows: i64 = 200
const sheet_widest_column: i64 = 60
const sheet_narrowest_column: i64 = 4

/// A table held in memory for a sheet: column names, which columns hold numbers, and the rows.
pub struct SheetTable {
    /// The column names.
    pub columns: str[]
    /// Whether each column holds numbers, which sort by value and draw right aligned; a column past the end holds text.
    pub numeric: bool[]
    /// The rows, each a list of cells with `none` for a missing value.
    pub rows: str?[][]
}

struct SheetKey {
    kind: i64
    number: f64
    text: str
}

fn sheet_sort_key(cell: str?, numeric: bool) -> SheetKey {
    match cell {
        some(value) => {
            if numeric {
                let parsed = text.parse_float(text.trim(value)) catch {
                    e => math.nan
                }
                return SheetKey { kind: 1, number: parsed, text: "" }
            }
            SheetKey { kind: 2, number: 0.0, text: text.lower(value) }
        }
        none => SheetKey { kind: 0, number: 0.0, text: "" }
    }
}

fn sheet_compare_numbers(a: f64, b: f64) -> i64 {
    let a_nan = math.is_nan(a)
    let b_nan = math.is_nan(b)
    if a_nan && b_nan {
        return 0
    }
    if a_nan {
        return 1
    }
    if b_nan {
        return -1
    }
    match a {
        < b => -1
        > b => 1
        _ => 0
    }
}

fn sheet_compare_keys(a: SheetKey, b: SheetKey, descending: bool) -> i64 {
    if a.kind == 0 && b.kind == 0 {
        return 0
    }
    if a.kind == 0 {
        return 1
    }
    if b.kind == 0 {
        return -1
    }
    var ordering: i64 = 0
    if a.kind == 1 && b.kind == 1 {
        ordering = sheet_compare_numbers(a.number, b.number)
    } else if a.kind == 2 && b.kind == 2 {
        ordering = math.compare(a.text, b.text)
    } else if a.kind == 1 {
        ordering = -1
    } else {
        ordering = 1
    }
    if descending { -ordering } else { ordering }
}

/// The stored row to show at each position: stored order with no sort, or sorted by the column, a missing value last and ties in stored order.
pub fn sheet_table_order(table: SheetTable, sort: SheetSort?) -> i64[] {
    var order: i64[] = []
    for index in 0..table.rows.len {
        order.push(index)
    }
    let by = sort ?? return order
    if by.column < 0 || by.column >= table.columns.len {
        return order
    }
    let numeric = by.column < table.numeric.len && table.numeric[by.column]
    var keys: SheetKey[] = []
    for row in table.rows {
        var cell: str? = none
        if by.column < row.len {
            cell = row[by.column]
        }
        keys.push(sheet_sort_key(cell, numeric))
    }
    let descending = by.descending
    slices.sort_stable_by(mut order, fn(a: i64, b: i64) -> bool { sheet_compare_keys(keys[a], keys[b], descending) < 0 })
    order
}

fn sheet_table_widths(table: SheetTable) -> i64[] {
    var widths: i64[] = []
    for name in table.columns {
        let header = text.char_count(name)
        widths.push(if header < sheet_widest_column { header } else { sheet_widest_column })
    }
    let sampled = if table.rows.len < sheet_sample_rows { table.rows.len } else { sheet_sample_rows }
    for index in 0..sampled {
        let row = table.rows[index]
        for column in 0..widths.len {
            var length = sheet_narrowest_column
            if column < row.len {
                match row[column] {
                    some(value) => {
                        length = text.char_count(value)
                    }
                    none => {}
                }
            }
            let capped = if length < sheet_widest_column { length } else { sheet_widest_column }
            if capped > widths[column] {
                widths[column] = capped
            }
        }
    }
    for column in 0..widths.len {
        if widths[column] < sheet_narrowest_column {
            widths[column] = sheet_narrowest_column
        }
    }
    widths
}

/// The table as a sheet source, its rows in `order`.
pub fn sheet_table_source(table: SheetTable, order: i64[]) -> SheetSource {
    var numeric: bool[] = []
    for column in 0..table.columns.len {
        numeric.push(column < table.numeric.len && table.numeric[column])
    }
    SheetSource {
        columns: table.columns
        widths: sheet_table_widths(table)
        numeric
        total: order.len
        read: fn(first: i64, end: i64, first_column: i64, end_column: i64) -> SheetPage {
            var rows: str?[][] = []
            let stop = if end < order.len { end } else { order.len }
            for position in first..stop {
                let row = table.rows[order[position]]
                var cells: str?[] = []
                for column in first_column..end_column {
                    if column < row.len {
                        cells.push(row[column])
                    } else {
                        cells.push(none)
                    }
                }
                rows.push(cells)
            }
            SheetPage { first, first_column, rows }
        }
    }
}
