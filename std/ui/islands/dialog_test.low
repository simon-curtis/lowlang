import std/testing
import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

struct DialogCase {
    cx: ui.Context
    log: ui.Signal[str[]]
    view: fn() -> ui.Element
}

fn dialog_background() -> ui.Element {
    ui.div().size(400.0, 300.0)
}

fn opened_dialog(look: Theme, detail: str) -> DialogCase {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let view = fn() -> ui.Element { dialog_background() }
    shot(cx, view)
    open_confirm_dialog(cx, look, "confirm", "Drop the table?", detail, "Drop", noting(log, "confirmed"), noting(log, "dismissed"))
    shot(cx, view)
    DialogCase { cx, log, view }
}

fn test_a_confirm_dialog_opens_over_the_window_and_focuses_its_card(t: *testing.T) {
    let look = default_theme()
    let c = opened_dialog(look, "DROP TABLE orders;")
    t.is_true(ui.overlay_open(c.cx, "confirm"))
    t.equal(ui.focused(c.cx), "confirm-card")
}

fn test_a_confirm_card_is_a_four_eighty_wide_popover_with_five_steps_of_padding(t: *testing.T) {
    let look = default_theme()
    let c = opened_dialog(look, "DROP TABLE orders;")
    let card = bounds_for(c.cx, "confirm-card")
    same_number(t, card.width, confirm_width)
    let sc = shot(c.cx, c.view)
    var found = false
    for q in filled(sc) {
        if near(q.bounds.width, confirm_width) && near(q.background.r, look.raised.r) {
            found = true
            t.equal(q.corner_radii.top_left, 10.0)
        }
    }
    t.is_true(found)
    let cancel = bounds_for(c.cx, "dialog-cancel")
    let confirm = bounds_for(c.cx, "dialog-confirm")
    same_number(t, confirm.x + confirm.width, card.x + card.width - 1.0 - floor(step(5.0)))
    same_number(t, confirm.x, cancel.x + cancel.width + floor(step(2.0)))
    same_number(t, confirm.height, control_height)
}

fn test_the_confirm_button_is_the_accent_primary_and_cancel_is_outlined(t: *testing.T) {
    let look = default_theme()
    let c = opened_dialog(look, "DROP TABLE orders;")
    let sc = shot(c.cx, c.view)
    let confirm = bounds_for(c.cx, "dialog-confirm")
    var accent_fills = 0
    for q in filled(sc) {
        if near(q.bounds.x, confirm.x) && near(q.bounds.y, confirm.y) {
            accent_fills += 1
            same_colour(t, q.background, look.accent)
        }
    }
    t.equal(accent_fills, 1)
    var outlines = 0
    let cancel = bounds_for(c.cx, "dialog-cancel")
    for q in sc.quads {
        if q.border_color.a > 0.0 && near(q.bounds.x, cancel.x) && near(q.bounds.y, cancel.y) {
            outlines += 1
        }
    }
    t.is_true(outlines > 0)
}

fn test_the_detail_sits_in_a_control_coloured_box_of_at_most_two_forty(t: *testing.T) {
    let look = default_theme()
    var lines = ""
    for i in 0..60 {
        lines = "{lines}SELECT {i};\n"
    }
    let c = opened_dialog(look, lines)
    let sc = shot(c.cx, c.view)
    var boxed = 0
    for q in filled(sc) {
        if near(q.background.a, look.control.a) && near(q.background.r, look.control.r) && q.corner_radii.top_left == 6.0 && q.bounds.width > 100.0 {
            boxed += 1
            t.is_true(q.bounds.height <= 240.0)
        }
    }
    t.equal(boxed, 1)
}

fn test_the_confirm_button_closes_the_dialog_and_confirms(t: *testing.T) {
    let look = default_theme()
    let c = opened_dialog(look, "DROP TABLE orders;")
    click_key(c.cx, "dialog-confirm")
    t.equal_slice(ui.get(c.log), ["confirmed"])
    t.is_false(ui.overlay_open(c.cx, "confirm"))
}

fn test_the_cancel_button_closes_the_dialog_and_dismisses(t: *testing.T) {
    let look = default_theme()
    let c = opened_dialog(look, "DROP TABLE orders;")
    click_key(c.cx, "dialog-cancel")
    t.equal_slice(ui.get(c.log), ["dismissed"])
    t.is_false(ui.overlay_open(c.cx, "confirm"))
}

fn test_enter_confirms_the_dialog(t: *testing.T) {
    let look = default_theme()
    let c = opened_dialog(look, "DROP TABLE orders;")
    key_down(c.cx, platform.NamedKey.Enter)
    t.equal_slice(ui.get(c.log), ["confirmed"])
    t.is_false(ui.overlay_open(c.cx, "confirm"))
}

fn test_escape_closes_the_dialog_without_confirming(t: *testing.T) {
    let look = default_theme()
    let c = opened_dialog(look, "DROP TABLE orders;")
    key_down(c.cx, platform.NamedKey.Escape)
    t.is_false(ui.overlay_open(c.cx, "confirm"))
    t.equal(ui.get(c.log).len, 0)
}

fn test_a_press_outside_the_card_leaves_the_dialog_open(t: *testing.T) {
    let look = default_theme()
    let c = opened_dialog(look, "DROP TABLE orders;")
    move_to(c.cx, 5.0, 5.0)
    click_at(c.cx, 5.0, 5.0)
    t.is_true(ui.overlay_open(c.cx, "confirm"))
    t.equal(ui.get(c.log).len, 0)
}

fn test_a_dialog_gives_focus_back_when_it_closes(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let view = fn() -> ui.Element { dialog_background().id("page").focusable() }
    shot(cx, view)
    ui.set_focus(cx, "page")
    open_confirm_dialog(cx, look, "confirm", "Drop?", "x", "Drop", noting(log, "confirmed"), noting(log, "dismissed"))
    shot(cx, view)
    t.equal(ui.focused(cx), "confirm-card")
    click_key(cx, "dialog-cancel")
    t.equal(ui.focused(cx), "page")
}

fn opened_form(ready: bool, failure: str?) -> DialogCase {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let view = fn() -> ui.Element { ui.div().size(800.0, 700.0) }
    shot(cx, view)
    let card = FormCard { id: "form", title: "New role", verb: "Create", verb_id: "form-run", ready, preview: "CREATE ROLE reader;", failure }
    let fields = [form_field(look, "form-name", "Name", "reader", "Name", fn(v: str) {})]
    ui.open_dialog(cx, "form", fn() -> ui.Element { form_card(cx, look, card, fields, noting(log, "confirmed"), noting(log, "dismissed")) })
    shot(cx, view)
    DialogCase { cx, log, view }
}

fn test_running_a_form_leaves_it_open_for_the_caller_to_close(t: *testing.T) {
    let c = opened_form(true, none)
    click_key(c.cx, "form-run")
    t.equal_slice(ui.get(c.log), ["confirmed"])
    t.is_true(ui.overlay_open(c.cx, "form"))
    key_down(c.cx, platform.NamedKey.Enter)
    t.equal_slice(ui.get(c.log), ["confirmed", "confirmed"])
}

fn test_a_form_that_is_not_ready_ignores_its_button_and_enter(t: *testing.T) {
    let c = opened_form(false, none)
    click_key(c.cx, "form-run")
    key_down(c.cx, platform.NamedKey.Enter)
    t.equal(ui.get(c.log).len, 0)
    t.is_true(ui.overlay_open(c.cx, "form"))
}

fn test_a_form_that_is_not_ready_tells_the_caller_that_enter_was_pressed_and_runs_nothing(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let view = fn() -> ui.Element { ui.div().size(800.0, 700.0) }
    shot(cx, view)
    let card = FormCard { id: "form", title: "New role", verb: "Create", verb_id: "form-run", ready: false, refused: some(noting(log, "refused")) }
    let fields = [form_field(look, "form-name", "Name", "", "Name", fn(v: str) {})]
    ui.open_dialog(cx, "form", fn() -> ui.Element { form_card(cx, look, card, fields, noting(log, "confirmed"), noting(log, "dismissed")) })
    shot(cx, view)
    click_key(cx, "form-run")
    t.equal(ui.get(log).len, 0)
    key_down(cx, platform.NamedKey.Enter)
    t.equal_slice(ui.get(log), ["refused"])
}

fn test_cancel_closes_a_form_and_dismisses(t: *testing.T) {
    let c = opened_form(true, some("permission denied"))
    click_key(c.cx, "dialog-cancel")
    t.equal_slice(ui.get(c.log), ["dismissed"])
    t.is_false(ui.overlay_open(c.cx, "form"))
}

fn danger_glyphs(c: DialogCase) -> i64 {
    let danger = default_theme().danger
    let sc = shot(c.cx, c.view)
    var found = 0
    for sprite in sc.sprites {
        if near(sprite.color.r, danger.r) && near(sprite.color.g, danger.g) && near(sprite.color.b, danger.b) {
            found += 1
        }
    }
    found
}

fn roomy(cx: ui.Context, view: fn() -> ui.Element) -> scene.Scene {
    ui.frame(cx, view, geometry.size(900.0, 700.0), 1.0)
}

fn wide_form(card: FormCard) -> DialogCase {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    let view = fn() -> ui.Element { ui.div().size(900.0, 700.0) }
    roomy(cx, view)
    let fields = [form_field(look, "form-name", "Name", "reader", "Name", fn(v: str) {})]
    ui.open_dialog(cx, "form", fn() -> ui.Element { form_card(cx, look, card, fields, noting(log, "confirmed"), noting(log, "dismissed")) })
    roomy(cx, view)
    DialogCase { cx, log, view }
}

fn test_a_form_card_takes_the_width_it_is_given_and_defaults_to_five_sixty(t: *testing.T) {
    let wide = wide_form(FormCard { id: "form", title: "New view", width: 640.0, verb: "Create", verb_id: "form-run" })
    same_number(t, bounds_for(wide.cx, "form-card").width, 640.0)
    let plain = wide_form(FormCard { id: "form", title: "New view", verb: "Create", verb_id: "form-run" })
    same_number(t, bounds_for(plain.cx, "form-card").width, form_card_width)
}

fn test_a_form_note_stands_in_the_faint_colour_until_a_failure_takes_its_place(t: *testing.T) {
    let look = default_theme()
    let noted = wide_form(FormCard { id: "form", title: "New view", verb: "Create", verb_id: "form-run", note: some("A name is needed") })
    t.is_true(tinted(roomy(noted.cx, noted.view), look.faint) > 0)
    let failed = wide_form(FormCard { id: "form", title: "New view", verb: "Create", verb_id: "form-run", note: some("A name is needed"), failure: some("permission denied") })
    t.is_true(tinted(roomy(failed.cx, failed.view), look.danger) > 0)
    t.equal(tinted(roomy(failed.cx, failed.view), look.faint), 0)
}

fn test_a_draft_preview_is_drawn_in_the_faint_colour_and_a_ready_one_in_the_text_colour(t: *testing.T) {
    let look = default_theme()
    let draft = wide_form(FormCard { id: "form", title: "New view", verb: "Create", verb_id: "form-run", preview: "CREATE VIEW x;", draft: true })
    let drafted = tinted(roomy(draft.cx, draft.view), look.faint)
    let ready = wide_form(FormCard { id: "form", title: "New view", verb: "Create", verb_id: "form-run", preview: "CREATE VIEW x;" })
    t.is_true(drafted > tinted(roomy(ready.cx, ready.view), look.faint))
}

fn test_a_form_draws_why_it_last_failed_in_the_danger_colour(t: *testing.T) {
    t.is_true(danger_glyphs(opened_form(true, some("permission denied"))) > 0)
    t.equal(danger_glyphs(opened_form(true, none)), 0)
}

struct AreaCase {
    cx: ui.Context
    log: ui.Signal[str[]]
    body: ui.Signal[str]
    view: fn() -> ui.Element
}

fn opened_area_form() -> AreaCase {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let log = new_log(cx)
    ui.bind_keys(cx, ui.text_area_bindings())
    let body = ui.signal(cx, "")
    let view = fn() -> ui.Element { ui.div().size(800.0, 700.0) }
    shot(cx, view)
    let card = FormCard { id: "form", title: "New function", verb: "Create", verb_id: "form-run", ready: true, preview: "" }
    ui.open_dialog(cx, "form", fn() -> ui.Element {
        let area = form_area(look, "form-body", "Body", "", fn() -> str { ui.get(body) }, fn(v: str) { ui.set(body, v) })
        let name = form_field(look, "form-name", "Name", "", "Name", fn(v: str) {})
        form_card(cx, look, card, [name, area], noting(log, "confirmed"), noting(log, "dismissed"))
    })
    shot(cx, view)
    AreaCase { cx, log, body, view }
}

fn test_enter_in_a_text_area_of_a_form_makes_a_new_line_and_does_not_run_it(t: *testing.T) {
    let c = opened_area_form()
    click_key(c.cx, "form-body-entry")
    shot(c.cx, c.view)
    type_text(c.cx, "a")
    key_down(c.cx, platform.NamedKey.Enter)
    type_text(c.cx, "b")
    shot(c.cx, c.view)
    t.equal(ui.get(c.body), "a\nb")
    t.equal(ui.get(c.log).len, 0)
    t.is_true(ui.overlay_open(c.cx, "form"))
}

fn test_ctrl_enter_in_a_text_area_of_a_form_runs_it_and_leaves_the_text_as_it_was(t: *testing.T) {
    let c = opened_area_form()
    click_key(c.cx, "form-body-entry")
    shot(c.cx, c.view)
    type_text(c.cx, "a")
    ui.dispatch(c.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Enter), modifiers: platform.Modifiers { control: true } }))
    shot(c.cx, c.view)
    t.equal(ui.get(c.body), "a")
    t.equal_slice(ui.get(c.log), ["confirmed"])
}
