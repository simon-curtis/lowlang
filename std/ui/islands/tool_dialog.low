import std/ui
import std/ui/geometry

const tool_dialog_gap: f32 = 24.0
const tool_dialog_border: f32 = 1.0

/// What a tool dialog is called, what its title bar says and how large it is.
pub struct ToolDialog {
    /// The name of the dialog, which its close button closes. Its window is `{id}-window` and the button `{id}-close`.
    pub id: str
    /// The title shown in the centre of the title bar.
    pub title: str
    /// The width of the dialog, in pixels. It shrinks to fit a narrower window.
    pub width: f32
    /// The height of the dialog, in pixels. It shrinks to fit a shorter window.
    pub height: f32
}

fn tool_dialog_close_hovered(v: ui.Visual) -> ui.Visual {
    var lit = v.with_background(ui.rgb(caption_close_hover))
    lit.corners = geometry.Corners { top_right: radius_large - tool_dialog_border }
    lit
}

fn tool_dialog_close(t: Theme, cx: ui.Context, id: str) -> ui.Element {
    let closed = fn() { ui.close_overlay(cx, id) }
    ui.row(ui.div()).id("{id}-close").size(caption_width, title_height).shrink(0.0).items_center().justify_center().hover(tool_dialog_close_hovered).on_click(click(closed)).child(icon_in("window-close", caption_icon_size, t.muted))
}

/// Returns a layer over the whole window that draws `content` in an island as a window of its own, centred and kept 24 pixels from the window's edges. Its title bar holds `d.title` in the centre, `brand` and a close button that closes the dialog called `d.id`. The window is drawn on the canvas colour, with the glow of `art` for `scheme` and its grain.
pub fn tool_dialog(cx: ui.Context, t: Theme, art: Art, scheme: str, d: ToolDialog, brand: ui.Element, content: ui.Element) -> ui.Element {
    let bar = ui.row(ui.div()).relative().shrink(0.0).height(title_height).items_center().gap(step(2.0)).child(tool_window_title(t, d.title)).child(brand).child(ui.div().grow(1.0)).child(tool_dialog_close(t, cx, d.id))
    let frame = ui.column(ui.div()).relative().grow(1.0).min_height(0.0).child(bar).child(tool_window_body(t, content))
    let window = ui.column(ui.div()).id("{d.id}-window").relative().height(d.height).shrink(1.0).min_height(0.0).overflow_hidden().rounded(radius_large).border(tool_dialog_border, t.border).shadow(popover_shadow()).background(t.canvas).text_color(t.text).text_size(body_size).font_family(ui_font).child(glow(art, scheme)).child(frame).child(grain(art))
    let column = ui.column(ui.div()).width(d.width).shrink(1.0).min_width(0.0).justify_center().child(window)
    ui.row(ui.div()).absolute().inset(tool_dialog_gap).justify_center().child(column)
}
