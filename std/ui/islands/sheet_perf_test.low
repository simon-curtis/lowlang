import std/os
import std/slices
import std/testing
import std/time
import std/ui
import std/ui/geometry
import std/ui/platform

const perf_variable: str = "ISLANDS_PERF_GRID"
const perf_rows: i64 = 1000000
const perf_columns: i64 = 200
const perf_steps: i64 = 400

fn perf_window() -> geometry.Size {
    geometry.size(1280.0, 480.0)
}

fn perf_rig() -> SheetRig {
    let r = sheet_rig(SheetMode.Results, perf_rows, perf_columns)
    let host = r.frame.host
    let source = r.frame.source
    let look = r.look
    let state = r.state
    let view = fn() -> ui.Element {
        ui.column(ui.div()).size(1280.0, 480.0).child(sheet_view(look, ruler(), host, source, ui.get(state)))
    }
    SheetRig { cx: r.cx, look, state, notes: r.notes, menu: r.menu, frame: r.frame, view }
}

fn perf_millis(nanos: i64) -> str {
    let whole = nanos / 1000000
    let tenths = (nanos / 100000) % 10
    "{whole}.{tenths}"
}

fn perf_report(t: *testing.T, label: str, samples: i64[]) {
    var ordered = samples[0..]
    slices.sort(mut ordered)
    let p50 = ordered[ordered.len / 2]
    let p99 = ordered[(ordered.len * 99) / 100]
    t.log("{label}: {ordered.len} frames, p50 {perf_millis(p50)} ms, p99 {perf_millis(p99)} ms, max {perf_millis(ordered[ordered.len - 1])} ms")
}

fn perf_frame(r: SheetRig) -> i64 {
    let begun = time.monotonic()
    ui.frame(r.cx, r.view, perf_window(), 1.0)
    time.monotonic() - begun
}

fn perf_step(r: SheetRig, event: platform.Event) -> i64 {
    let begun = time.monotonic()
    ui.dispatch(r.cx, event)
    ui.frame(r.cx, r.view, perf_window(), 1.0)
    time.monotonic() - begun
}

fn perf_key(r: SheetRig, named: platform.NamedKey) -> i64 {
    perf_step(r, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(named) }))
}

fn test_frame_times_at_a_million_rows_and_two_hundred_columns(t: *testing.T) {
    if (os.env(perf_variable) ?? "") == "" {
        t.skip("needs {perf_variable}")
    }
    let r = perf_rig()
    perf_frame(r)
    perf_frame(r)
    ui.dispatch(r.cx, platform.Event.PointerMoved(640.0, 240.0))
    var wheel: i64[] = []
    for step in 0..perf_steps {
        wheel.push(perf_step(r, platform.Event.Scrolled(0.0, 66.0, platform.Modifiers {})))
    }
    perf_report(t, "wheel down, 3 rows a notch", wheel)
    var drag: i64[] = []
    for step in 0..perf_steps {
        let jump = f32(1000000 - 13) * 22.0 / f32(perf_steps)
        drag.push(perf_step(r, platform.Event.Scrolled(0.0, jump * f32(if step % 2 == 0 { 1 } else { -1 }), platform.Modifiers {})))
    }
    perf_report(t, "scrollbar-sized jumps across the million rows", drag)
    var sideways: i64[] = []
    for step in 0..perf_steps {
        sideways.push(perf_step(r, platform.Event.Scrolled(80.0, 0.0, platform.Modifiers {})))
    }
    perf_report(t, "wheel sideways across 200 columns", sideways)
    let at = geometry.point(sheet_cell_x(r, 0), sheet_row_y(r, 0))
    perf_step(r, platform.Event.PointerMoved(at.x, at.y))
    perf_step(r, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: at.x, y: at.y, clicks: 1 }))
    perf_step(r, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: at.x, y: at.y, clicks: 1 }))
    var keys: i64[] = []
    for step in 0..perf_steps {
        keys.push(perf_key(r, platform.NamedKey.Down))
    }
    perf_report(t, "cell moves with the arrow key", keys)
    var idle: i64[] = []
    for step in 0..perf_steps {
        idle.push(perf_frame(r))
    }
    perf_report(t, "frames with nothing changed", idle)
}
