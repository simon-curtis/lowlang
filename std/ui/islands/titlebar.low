import std/ui
import std/ui/geometry
import std/ui/platform

const caption_width: f32 = 46.0
const caption_close_hover: u32 = 0xc42b1c

/// Returns a flexible area `title_height` tall that drags the window.
pub fn drag_area() -> ui.Element {
    ui.div().flex_1().height(title_height).window_control_area(platform.WindowControlArea.Drag)
}

/// Returns the minimise, maximise and close buttons of the window. The maximise button shows the restore icon while the window is maximised, and the close button turns red under the pointer.
pub fn caption_controls(t: Theme, cx: ui.Context) -> ui.Element {
    let maximize = if ui.is_maximized(cx) { "window-restore" } else { "window-maximize" }
    let minimize = caption(t, "caption-min", "window-minimize", platform.WindowControlArea.Min, t.hover)
    let zoom = caption(t, "caption-max", maximize, platform.WindowControlArea.Max, t.hover)
    let close = caption(t, "caption-close", "window-close", platform.WindowControlArea.Close, ui.rgb(caption_close_hover))
    ui.row(ui.div()).shrink(0.0).child(minimize).child(zoom).child(close)
}

fn caption(t: Theme, name: str, glyph: str, area: platform.WindowControlArea, hover: geometry.Color) -> ui.Element {
    ui.row(ui.div()).id(name).size(caption_width, title_height).items_center().justify_center().window_control_area(area).hover(hovered(hover)).child(icon_in(glyph, caption_icon_size, t.muted))
}
