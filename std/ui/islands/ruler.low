import std/ui/font

/// A text measure that sizes strings with the advances and kerning of the fallback font.
pub struct Ruler {
    face: font.Font
}

/// Returns a `Ruler` using the fallback font.
pub fn ruler() -> Ruler {
    Ruler { face: font.fallback() }
}

/// Returns the width in pixels of `content` set at `size` pixels: the glyph advances plus the kerning between neighbouring glyphs.
pub fn ruler_width(r: Ruler, content: str, size: f32) -> f32 {
    let k = font.scale(r.face, size)
    var pen: f32 = 0.0
    var last = -1
    for c in content {
        let glyph = font.glyph_index(r.face, c)
        if last >= 0 {
            pen += f32(font.kern(r.face, last, glyph)) * k
        }
        pen += f32(font.advance(r.face, glyph)) * k
        last = glyph
    }
    pen
}
