import std/ui
import std/ui/geometry

/// The edge of a small icon, in pixels.
pub const small_icon_size: f32 = 14.0
/// The edge of the icon of a tool button, in pixels.
pub const tool_icon_size: f32 = 16.0
const rail_icon_size: f32 = 16.0
const empty_icon_size: f32 = 22.0
const check_icon_size: f32 = 11.0
const caption_icon_size: f32 = 14.0

/// Returns the Lucide icon `name`, `edge` pixels square, with the element id `icon-{name}`. A name the kit does not hold draws nothing. The icon takes its colour from the text colour it inherits.
pub fn icon(name: str, edge: f32) -> ui.Element {
    ui.icon(icon_source(name)).id("icon-{name}").size(edge, edge).shrink(0.0)
}

/// Returns whether the kit holds an icon called `name`.
pub fn icon_known(name: str) -> bool {
    icon_source(name).len > 0
}

/// Returns the icon `name`, `edge` pixels square, drawn in `colour`.
pub fn icon_in(name: str, edge: f32, colour: geometry.Color) -> ui.Element {
    icon(name, edge).text_color(colour)
}

/// Returns the icon `name` at `small_icon_size`.
pub fn small_icon(name: str) -> ui.Element {
    icon(name, small_icon_size)
}

/// Returns the icon `name` at `small_icon_size`, drawn in `colour`.
pub fn small_icon_in(name: str, colour: geometry.Color) -> ui.Element {
    icon_in(name, small_icon_size, colour)
}
