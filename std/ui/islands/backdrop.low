import std/image
import std/math
import std/ui
import uitext = std/ui/text

const glow_height: f32 = 420.0
const glow_width: f32 = 1920.0
const grain_tile: f32 = 256.0
const grain_columns: i64 = 12
const grain_rows: i64 = 5

const glow_width_pixels: i64 = i64(glow_width)
const glow_height_pixels: i64 = i64(glow_height)
const grain_pixels: i64 = 256

/// The images the backdrop draws, each made on first use and kept by name.
pub struct Art {
    /// The film-grain tile, or `none` until it is made.
    pub grain: uitext.Image? = none
    /// The glow images, keyed by scheme name.
    pub glows: [str: uitext.Image] = [:]
    /// The mark images, keyed by the name they were added under.
    pub marks: [str: uitext.Image] = [:]
    /// The marble images, keyed by seed, colour and size.
    pub marbles: [str: uitext.Image] = [:]
    /// The pictures made by `art_with_picture`, keyed by a hash of their bytes and their size in pixels.
    pub pictures: [str: uitext.Image] = [:]
    /// The device pixels per logical pixel that marbles and pictures are made at. Defaults to `1.0`; set it from `ui.scale` so they stay sharp on a scaled display.
    pub scale: f32 = 1.0
}

struct Placement {
    x: f32
    y: f32
    radius: f32
    strength: f32
}

struct Noise {
    state: u64
}

struct Glow {
    red: f32
    green: f32
    blue: f32
    alpha: f32
}

fn placements() -> Placement[] {
    [
        Placement { x: 0.30, y: -0.25, radius: 0.34, strength: 0.40 },
        Placement { x: 0.74, y: -0.15, radius: 0.30, strength: 0.34 },
        Placement { x: 0.52, y: -0.45, radius: 0.22, strength: 0.20 },
        Placement { x: 0.95, y: -0.35, radius: 0.16, strength: 0.16 },
    ]
}

fn noise_next(n: *Noise) -> f32 {
    n.state = n.state ^ (n.state << 13)
    n.state = n.state ^ (n.state >> 7)
    n.state = n.state ^ (n.state << 17)
    f32(n.state >> 40) / 16777216.0
}

fn channel_byte(value: f32) -> u8 {
    var clamped = value
    if clamped < 0.0 {
        clamped = 0.0
    }
    if clamped > 255.0 {
        clamped = 255.0
    }
    u8(i64(clamped))
}

fn glow_at(glows: u32[], places: Placement[], u: f32, v: f32, falloff: f32) -> Glow {
    let aspect = f32(glow_width_pixels) / f32(glow_height_pixels)
    var weight: f32 = 0.0
    var red: f32 = 0.0
    var green: f32 = 0.0
    var blue: f32 = 0.0
    for index in 0..places.len {
        let place = places[index]
        let dx = u - place.x
        let dy = (v - place.y) / aspect
        let distance = sqrt(dx * dx + dy * dy) / place.radius
        let intensity = place.strength * exp(-distance * distance * 1.6)
        let colour = glows[index]
        weight += intensity
        red += f32((colour >> 16) & 0xff) * intensity
        green += f32((colour >> 8) & 0xff) * intensity
        blue += f32(colour & 0xff) * intensity
    }
    var level = weight
    if level > 0.24 {
        level = 0.24
    }
    if weight <= 0.0 {
        return Glow { red: 0.0, green: 0.0, blue: 0.0, alpha: 0.0 }
    }
    let red_mean = red / weight
    let green_mean = green / weight
    let blue_mean = blue / weight
    Glow { red: red_mean + (128.0 - red_mean) * 0.3, green: green_mean + (128.0 - green_mean) * 0.3, blue: blue_mean + (128.0 - blue_mean) * 0.3, alpha: level * falloff }
}

fn glow_pixels(glows: u32[]) -> u8[] {
    let noise = new(Noise { state: 0x9e3779b97f4a7c15 })
    let places = placements()
    var pixels: u8[] = []
    for y in 0..glow_height_pixels {
        let v = f32(y) / f32(glow_height_pixels)
        let fade = f64(1.0 - v)
        let falloff = f32(math.pow(fade, 2.6))
        let grain_scale = 0.035 * f32(math.pow(fade, 1.3))
        for x in 0..glow_width_pixels {
            let glow = glow_at(glows, places, f32(x) / f32(glow_width_pixels), v, falloff)
            var alpha = glow.alpha + (noise_next(noise) - 0.5) * grain_scale
            if alpha < 0.0 {
                alpha = 0.0
            }
            if alpha > 1.0 {
                alpha = 1.0
            }
            let red = glow.red + (noise_next(noise) - 0.5) * 8.0
            let green = glow.green + (noise_next(noise) - 0.5) * 8.0
            let blue = glow.blue + (noise_next(noise) - 0.5) * 8.0
            pixels.push(channel_byte(red))
            pixels.push(channel_byte(green))
            pixels.push(channel_byte(blue))
            pixels.push(channel_byte(floor(alpha * 255.0 + 0.5)))
        }
    }
    pixels
}

fn grain_bytes() -> u8[] {
    let noise = new(Noise { state: 0x2545f4914f6cdd1d })
    var pixels: u8[] = []
    for _ in 0..grain_pixels * grain_pixels {
        let deviation = noise_next(noise) + noise_next(noise) + noise_next(noise) - 1.5
        if deviation > 0.0 {
            let alpha = floor(deviation * 3.0 + 0.5)
            pixels.push(255)
            pixels.push(255)
            pixels.push(255)
            pixels.push(channel_byte(alpha))
        } else {
            pixels.push(0)
            pixels.push(0)
            pixels.push(0)
            pixels.push(channel_byte(floor(-deviation * 8.0 + 0.5)))
        }
    }
    pixels
}

fn art_with_grain(cx: ui.Context, art: Art) -> Art {
    if art.grain != none {
        return art
    }
    var next = art
    next.grain = ui.add_image(cx, grain_pixels, grain_pixels, grain_bytes())
    next
}

fn art_with_glow(cx: ui.Context, art: Art, name: str) -> Art {
    if art.glows[name] != none {
        return art
    }
    let scheme = scheme_named(name)
    var next = art
    let placed = ui.add_image(cx, glow_width_pixels, glow_height_pixels, glow_pixels(scheme.glows))
    match placed {
        some(picture) => {
            next.glows[name] = picture
        }
        none => {}
    }
    next
}

fn decoded_mark(encoded: str) -> image.Image? {
    let decoded = image.decode(bytes(encoded)) catch {
        e => return none
    }
    image.convert(decoded, image.Format.Rgba8)
}

/// Returns `art` with the image decoded from `encoded` stored in `marks` under `name`. `art` comes back unchanged when `name` already has an image, when `encoded` does not decode or when the image cannot be added.
pub fn art_with_mark(cx: ui.Context, art: Art, name: str, encoded: str) -> Art {
    if art.marks[name] != none {
        return art
    }
    var next = art
    match decoded_mark(encoded) {
        some(mark) => {
            match ui.add_image(cx, mark.width, mark.height, mark.pixels) {
                some(picture) => {
                    next.marks[name] = picture
                }
                none => {}
            }
        }
        none => {}
    }
    next
}

/// Returns `art` with the grain and the glow of the scheme called `name`, each made when it is missing.
pub fn art_for(cx: ui.Context, art: Art, name: str) -> Art {
    art_with_glow(cx, art_with_grain(cx, art), name)
}

fn glow_layer(art: Art, name: str) -> ui.Element {
    match art.glows[name] {
        some(picture) => {
            let sheet = ui.image(picture).object_fit(uitext.Fit.Fill).grow(1.0).min_width(glow_width).height(glow_height).shrink(0.0)
            ui.row(ui.div()).absolute().top(0.0).left(0.0).right(0.0).height(glow_height).overflow_hidden().justify_center().child(sheet)
        }
        none => ui.div()
    }
}

fn grain_layer(art: Art) -> ui.Element {
    match art.grain {
        some(picture) => {
            var rows: ui.Element[] = []
            for _ in 0..grain_rows {
                var tiles: ui.Element[] = []
                for _ in 0..grain_columns {
                    tiles.push(ui.image(picture).size(grain_tile, grain_tile).shrink(0.0))
                }
                rows.push(ui.row(ui.div()).shrink(0.0).children(tiles))
            }
            ui.column(ui.div()).absolute().top(0.0).left(0.0).right(0.0).bottom(0.0).overflow_hidden().children(rows)
        }
        none => ui.div()
    }
}

/// Returns the glow layer of the scheme called `name`: a band `glow_height` pixels tall across the top of its parent. It is an empty div until the glow has been made.
pub fn glow(art: Art, name: str) -> ui.Element {
    glow_layer(art, name)
}

/// Returns the grain layer: tiles of the grain image that cover its parent. It is an empty div until the grain has been made.
pub fn grain(art: Art) -> ui.Element {
    grain_layer(art)
}

/// Returns the mark called `name` as a square `edge` pixels wide, or an empty square of that size when `name` has no image.
pub fn mark(art: Art, name: str, edge: f32) -> ui.Element {
    match art.marks[name] {
        some(picture) => ui.image(picture).size(edge, edge).shrink(0.0)
        none => ui.div().size(edge, edge).shrink(0.0)
    }
}
