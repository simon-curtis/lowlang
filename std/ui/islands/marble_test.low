import std/slices
import std/testing

fn alpha_at(pixels: u8[], edge: i64, x: i64, y: i64) -> u8 {
    pixels[(y * edge + x) * 4 + 3]
}

fn test_a_device_draws_the_same_round_marble_every_time_and_another_device_a_different_one(t: *testing.T) {
    let mine = marble_pixels("0123456789abcdef0123456789abcdef", 0x0090ff, 48)
    t.is_true(slices.equal(mine, marble_pixels("0123456789abcdef0123456789abcdef", 0x0090ff, 48)))
    t.is_false(slices.equal(mine, marble_pixels("fedcba9876543210fedcba9876543210", 0x0090ff, 48)))
    t.equal(alpha_at(mine, 48, 0, 0), 0)
    t.equal(alpha_at(mine, 48, 47, 47), 0)
    t.equal(alpha_at(mine, 48, 24, 24), 255)
}
