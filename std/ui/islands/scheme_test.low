import std/testing

fn test_there_are_twelve_schemes_with_unique_names(t: *testing.T) {
    let all = schemes()
    t.equal(all.len, 12)
    for i, a in all {
        for j, b in all {
            if i != j {
                t.is_true(a.name != b.name)
            }
        }
        t.equal(a.glows.len, 4)
    }
}

fn test_a_scheme_is_found_by_name(t: *testing.T) {
    let teal = scheme_named("teal")
    t.equal(teal.label, "Teal")
    t.equal(teal.accent, 0x34c6a8)
    t.equal(scheme_named("slate").glows[3], 0x334155)
}

fn test_an_unknown_name_falls_back_to_pink(t: *testing.T) {
    let unknown = scheme_named("chartreuse")
    t.equal(unknown.name, "pink")
    t.equal(unknown.accent, 0xe874d9)
    t.equal(scheme_named(default_scheme_name).name, "pink")
}

fn test_pink_keeps_its_glows(t: *testing.T) {
    let pink = scheme_named("pink")
    t.equal(pink.glows[0], 0xec4899)
    t.equal(pink.glows[1], 0xa855f7)
    t.equal(pink.glows[2], 0xf472b6)
    t.equal(pink.glows[3], 0x6366f1)
}
