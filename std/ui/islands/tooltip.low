import std/ui

const tooltip_text_size: f32 = 0.875 * rem_px

fn tooltip_shadow() -> ui.BoxShadow {
    ui.BoxShadow { color: ui.rgba(0x0000001a), x: 0.0, y: 4.0, blur: 6.0, spread: -1.0 }
}

fn tooltip_shadow_close() -> ui.BoxShadow {
    ui.BoxShadow { color: ui.rgba(0x0000001a), x: 0.0, y: 2.0, blur: 4.0, spread: -2.0 }
}

fn tooltip_card(t: Theme, content: str) -> ui.Element {
    tooltip_card_lines(t, [content])
}

/// A tooltip card with one row of text for each of `lines`.
pub fn tooltip_card_lines(t: Theme, lines: str[]) -> ui.Element {
    var rows: ui.Element[] = []
    for line in lines {
        rows.push(ui.text(line))
    }
    let text = ui.column(ui.div()).min_width(0.0).overflow_hidden().children(rows)
    let card = ui.row(ui.div()).margin(step(3.0)).items_center().justify_between().gap(step(3.0)).padding_xy(step(2.0), step(0.5)).background(t.raised).border(1.0, t.border).rounded(radius).shadow(tooltip_shadow()).shadow(tooltip_shadow_close()).text_color(t.text).text_size(tooltip_text_size).font_family(ui_font).child(text)
    ui.div().child(card)
}

/// Returns `owner` with a tooltip card that shows `content`.
pub fn tooltip(t: Theme, owner: ui.Element, content: str) -> ui.Element {
    ui.tooltip(owner, fn() -> ui.Element { tooltip_card(t, content) })
}

/// A tooltip over `owner` that lists `lines`, one to a row.
pub fn tooltip_lines(t: Theme, owner: ui.Element, lines: str[]) -> ui.Element {
    ui.tooltip(owner, fn() -> ui.Element { tooltip_card_lines(t, lines) })
}
