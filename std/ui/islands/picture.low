import std/hash
import std/image
import std/math
import std/ui
import uitext = std/ui/text

fn art_pixels(art: Art, edge: f32) -> i64 {
    i64(floor(edge * art.scale + 0.5))
}

fn picture_key(data: u8[], pixels: i64) -> str {
    "{hash.fnv1a_64(data)}|{pixels}"
}

/// Returns `art` holding the encoded image in `data` as a picture `edge` logical pixels square, resampled with Lanczos3 to `edge` times `art.scale` pixels, for `picture` to draw. An image that is not square is stretched to fit. Returns `art` unchanged when `data` is empty or cannot be decoded, when that picture is already made, or when the context cannot keep it.
pub fn art_with_picture(cx: ui.Context, art: Art, data: u8[], edge: f32) -> Art {
    if data.len == 0 {
        return art
    }
    let pixels = art_pixels(art, edge)
    let key = picture_key(data, pixels)
    if art.pictures[key] != none {
        return art
    }
    let decoded = image.decode(data) or return art
    let sized = image.resize(image.convert(decoded, image.Format.Rgba8), pixels, pixels, image.Filter.Lanczos3)
    let ready = image.premultiply(sized)
    var next = art
    match ui.add_image(cx, ready.width, ready.height, ready.pixels) {
        some(made) => {
            next.pictures[key] = made
        }
        none => {}
    }
    next
}

/// Returns the picture of `data` that `art_with_picture` made at `edge`, drawn as a disc `edge` pixels across, or `none` when `data` is empty or that picture is not made yet.
pub fn picture(art: Art, data: u8[], edge: f32) -> ui.Element? {
    if data.len == 0 {
        return none
    }
    let made = art.pictures[picture_key(data, art_pixels(art, edge))] ?? return none
    some(ui.image(made).object_fit(uitext.Fit.Fill).size(edge, edge).shrink(0.0).rounded(edge / 2.0))
}
