import std/ui
import std/ui/platform

/// The width of the strip that resizes an island from the canvas gap beside it.
pub const resize_strip_width: f32 = 8.0
/// The height of the strip that resizes a pane from the line between it and its neighbour.
pub const resize_divider_height: f32 = 5.0
const resize_divider_reach: f32 = 3.0

/// An absolute strip along an island's edge showing the column resize cursor; the caller places it with `left` or `right` and gives it an `on_drag`.
pub fn resize_strip(name: str) -> ui.Element {
    ui.div().id(name).absolute().top(0.0).bottom(0.0).width(resize_strip_width).cursor(platform.Cursor.ResizeLeftRight)
}

/// An absolute strip across the top of a pane, reaching over the line above it, showing the row resize cursor and the border colour on hover; the caller gives it an `on_drag`.
pub fn resize_divider(t: Theme, name: str) -> ui.Element {
    ui.div().id(name).absolute().left(0.0).right(0.0).top(-resize_divider_reach).height(resize_divider_height).cursor(platform.Cursor.ResizeUpDown).hover(hovered(t.border))
}

/// The preview a resize drag draws: nothing.
pub fn resize_ghost(value: str) -> ui.Element {
    ui.div()
}
