/// A named colour scheme: an accent colour and the colours of the glows behind the window.
pub struct Scheme {
    /// The identifier the scheme is looked up by, such as `violet`.
    pub name: str
    /// The display name of the scheme.
    pub label: str
    /// The accent colour as `0xrrggbb`.
    pub accent: u32
    /// The four `0xrrggbb` colours of the glows drawn behind the window, in the order the glows are placed.
    pub glows: u32[]
}

/// The name of the scheme used when a name matches no scheme, `pink`.
pub const default_scheme_name: str = "pink"

/// Returns all twelve schemes, from violet to slate, in display order.
pub fn schemes() -> Scheme[] {
    [
        Scheme { name: "violet", label: "Violet", accent: 0x9d8cf6, glows: [0x7c5cff, 0x4863eb, 0xc456d6, 0x38bdf8] },
        Scheme { name: "indigo", label: "Indigo", accent: 0x8392ff, glows: [0x4f5bff, 0x3b82f6, 0x8b5cf6, 0x22d3ee] },
        Scheme { name: "blue", label: "Blue", accent: 0x5ea4ff, glows: [0x2f6fff, 0x1fb6ff, 0x6366f1, 0x2dd4bf] },
        Scheme { name: "cyan", label: "Cyan", accent: 0x41c9e6, glows: [0x06b6d4, 0x3b82f6, 0x14b8a6, 0x818cf8] },
        Scheme { name: "teal", label: "Teal", accent: 0x34c6a8, glows: [0x14b8a6, 0x0ea5e9, 0x10b981, 0x6366f1] },
        Scheme { name: "green", label: "Green", accent: 0x52c98e, glows: [0x22c55e, 0x14b8a6, 0x84cc16, 0x0ea5e9] },
        Scheme { name: "lime", label: "Lime", accent: 0xa6d44a, glows: [0x84cc16, 0x22c55e, 0xeab308, 0x14b8a6] },
        Scheme { name: "amber", label: "Amber", accent: 0xf5b84f, glows: [0xf59e0b, 0xf97316, 0xeab308, 0xef4444] },
        Scheme { name: "orange", label: "Orange", accent: 0xf68d52, glows: [0xf97316, 0xef4444, 0xf59e0b, 0xec4899] },
        Scheme { name: "rose", label: "Rose", accent: 0xf2687f, glows: [0xf43f5e, 0xd946ef, 0xfb7185, 0xf97316] },
        Scheme { name: "pink", label: "Pink", accent: 0xe874d9, glows: [0xec4899, 0xa855f7, 0xf472b6, 0x6366f1] },
        Scheme { name: "slate", label: "Slate", accent: 0xaab3c5, glows: [0x64748b, 0x475569, 0x94a3b8, 0x334155] },
    ]
}

/// Returns the scheme called `name`, or the default scheme when none has that name.
pub fn scheme_named(name: str) -> Scheme {
    let all = schemes()
    for s in all {
        if s.name == name {
            return s
        }
    }
    for s in all {
        if s.name == default_scheme_name {
            return s
        }
    }
    all[0]
}
