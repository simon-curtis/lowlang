import std/ui
import std/ui/geometry

/// The space in pixels either side of the numbers in a gutter measured by `gutter_width`.
pub const gutter_padding: f32 = 14.0
/// The height in pixels of a line of a `CodeBlock`.
pub const code_row: f32 = 18.0
/// The width in pixels of the gutter of a `CodeBlock`.
pub const code_gutter: f32 = 50.0
const code_gap: f32 = 18.0
/// The opacity, from 0 to 1, of the line numbers of a `CodeBlock`.
pub const code_number_opacity: f32 = 0.7
const line_fill_caret_boost: f32 = 1.6
/// How long a flash shows fully, in milliseconds.
pub const flash_hold_ms: i64 = 150
/// How long a flash takes to fade once it has been held, in milliseconds.
pub const flash_fade_ms: i64 = 650

/// A line the gutter flags: its number draws in the danger colour and hovering it lists `notes`, one to a row.
pub struct GutterMark {
    /// The line flagged, counting from zero.
    pub line: i64
    /// The notes the tooltip lists, one to a row.
    pub notes: str[]
}

/// A column of line numbers: `width` wide, `row` high a line, with `gap` between the numbers and what follows. `marks` holds the flagged lines in ascending order.
pub struct Gutter {
    /// The width of the column in pixels.
    pub width: f32
    /// The height of each line in pixels.
    pub row: f32
    /// The space in pixels before the numbers.
    pub left: f32
    /// The space in pixels after the numbers.
    pub gap: f32
    /// The line the caret is on, counting from zero, drawn in the text colour; `-1` for none, the default.
    pub current: i64 = -1
    /// The opacity, from 0 to 1, of the numbers of lines that are neither flagged nor current; 1 by default.
    pub opacity: f32 = 1.0
    /// The flagged lines in ascending order; none by default.
    pub marks: GutterMark[] = []
}

/// The fill behind a line the caret is on, a line holding a problem, or both, under a flash of `flash` strength from 0 to 1; none for any other line. A line with both is tinted more strongly than either alone, and the flash shows while it is stronger than the fill under it.
pub fn line_fill(t: Theme, caret: bool, marked: bool, flash: f32) -> geometry.Color? {
    let under = steady_fill(t, caret, marked)
    if flash <= 0.0 {
        return under
    }
    let flashed = geometry.with_alpha(t.line_flash, t.line_flash.a * flash)
    match under {
        some(fill) => if fill.a >= flashed.a { under } else { some(flashed) }
        none => some(flashed)
    }
}

fn steady_fill(t: Theme, caret: bool, marked: bool) -> geometry.Color? {
    if marked && caret {
        let boosted = geometry.with_alpha(t.danger_soft, t.danger_soft.a * line_fill_caret_boost)
        return some(boosted)
    }
    if marked {
        return some(t.danger_soft)
    }
    if caret {
        return some(t.current_line)
    }
    none
}

/// How strongly a flash shows `elapsed` milliseconds after it starts: fully for `flash_hold_ms`, then fading to nothing over `flash_fade_ms`. With `reduced` motion it shows fully for the whole time and then stops.
pub fn flash_strength(elapsed: i64, reduced: bool) -> f32 {
    if elapsed < 0 || elapsed >= flash_hold_ms + flash_fade_ms {
        return 0.0
    }
    if reduced || elapsed < flash_hold_ms {
        return 1.0
    }
    let left = 1.0 - f32(elapsed - flash_hold_ms) / f32(flash_fade_ms)
    left * left
}

/// Returns the width in pixels of a gutter for `lines` lines, measured with `r` at font `size`: the width of the number `lines` plus `gutter_padding` either side.
pub fn gutter_width(r: Ruler, lines: i64, size: f32) -> f32 {
    ruler_width(r, "{lines}", size) + gutter_padding * 2.0
}

/// The line after the last one a window of `height` shows from `first`.
pub fn gutter_end(first: i64, height: f32, row: f32, total: i64) -> i64 {
    let shown = i64(floor(height / row)) + 2
    if first + shown < total { first + shown } else { total }
}

fn gutter_colour(t: Theme, g: Gutter, line: i64, marked: bool) -> geometry.Color {
    if marked {
        return t.danger
    }
    if line == g.current {
        return t.text
    }
    if g.opacity < 1.0 {
        return geometry.with_alpha(t.faint, g.opacity)
    }
    t.faint
}

fn gutter_row(g: Gutter, line: i64, colour: geometry.Color) -> ui.Element {
    let number = ui.text("{line + 1}").text_color(colour)
    ui.row(ui.div()).height(g.row).shrink(0.0).items_center().justify_end().padding_left(g.left).padding_right(g.gap).child(number)
}

fn gutter_number(t: Theme, g: Gutter, line: i64, mark: GutterMark?) -> ui.Element {
    match mark {
        some(flagged) => {
            let flagged_colour = gutter_colour(t, g, line, true)
            let flagged_row = gutter_row(g, line, flagged_colour)
            tooltip_lines(t, flagged_row, flagged.notes)
        }
        none => {
            let plain_colour = gutter_colour(t, g, line, false)
            gutter_row(g, line, plain_colour)
        }
    }
}

fn gutter_mark_at(g: Gutter, next: i64, line: i64) -> GutterMark? {
    if next < g.marks.len && g.marks[next].line == line {
        return some(g.marks[next])
    }
    none
}

/// The numbers of lines `first` up to but not including `last`, one to a row.
pub fn gutter_column(t: Theme, g: Gutter, first: i64, last: i64) -> ui.Element {
    var numbers: ui.Element[] = []
    var next = 0
    for line in first..last {
        for next < g.marks.len && g.marks[next].line < line {
            next += 1
        }
        numbers.push(gutter_number(t, g, line, gutter_mark_at(g, next, line)))
    }
    ui.column(ui.div()).width(g.width).shrink(0.0).overflow_hidden().children(numbers)
}

/// A row of a gutter whose rows carry their own labels: its text, empty for a row with no number, the colour behind the row and the colour of a bar down its left edge.
pub struct GutterLabel {
    /// The label of the row; empty for a row with no number.
    pub text: str
    /// The colour behind the row, or `none` for no fill.
    pub fill: geometry.Color? = none
    /// The colour of the bar down the left edge of the row, or `none` for no bar.
    pub edge: geometry.Color? = none
}

const gutter_edge: f32 = 2.0

fn gutter_label(g: Gutter, label: GutterLabel, colour: geometry.Color) -> ui.Element {
    var edge = ui.div().width(gutter_edge).height(g.row).shrink(0.0)
    var row = ui.row(ui.div()).height(g.row).shrink(0.0)
    match label.edge {
        some(chosen) => {
            edge = edge.background(chosen)
        }
        none => {}
    }
    match label.fill {
        some(chosen) => {
            row = row.background(chosen)
        }
        none => {}
    }
    let number = ui.row(ui.div()).grow(1.0).min_width(0.0).height(g.row).items_center().justify_end().padding_right(g.gap).child(ui.text(label.text).nowrap().text_color(colour))
    row.child(edge).child(number)
}

/// A column of `labels`, one to a row, drawn `shift` pixels higher so it follows a text area scrolled part way into its first line.
pub fn gutter_labels(t: Theme, g: Gutter, labels: GutterLabel[], shift: f32) -> ui.Element {
    let colour = geometry.with_alpha(t.faint, g.opacity)
    var rows: ui.Element[] = []
    for label in labels {
        rows.push(gutter_label(g, label, colour))
    }
    let shifted = ui.column(ui.div()).shrink(0.0).margin_top(0.0 - shift).children(rows)
    ui.column(ui.div()).width(g.width).shrink(0.0).overflow_hidden().child(shifted)
}

/// A read-only block of code: a gutter of line numbers beside a text area that starts where the gutter ends.
pub struct CodeBlock {
    /// The element id of the text area.
    pub id: str
    /// The lines of code.
    pub source: ui.LineSource
    /// The size in pixels the block fills.
    pub room: geometry.Size
    /// The number of lines.
    pub total: i64
    /// The first line in view, counting from zero.
    pub first: i64
    /// The font family of the code.
    pub family: str
    /// The font size of the code in pixels.
    pub size: f32
}

/// Returns a read-only block of code filling `b.room`, with a `code_gutter` wide gutter of numbers for the lines in view from `b.first`, each `code_row` high, beside the text area.
pub fn code_block(t: Theme, b: CodeBlock) -> ui.Element {
    let g = Gutter { width: code_gutter, row: code_row, left: 0.0, gap: code_gap, opacity: code_number_opacity }
    let last = gutter_end(b.first, b.room.height, code_row, b.total)
    let across = if b.room.width - code_gutter < 1.0 { 1.0 } else { b.room.width - code_gutter }
    let area = ui.text_area(b.source).id(b.id).size(across, b.room.height).shrink(0.0).line_height(code_row).scrollbar(scrollbars(t))
    ui.row(ui.div()).size(b.room.width, b.room.height).shrink(0.0).overflow_hidden().font_family(b.family).text_size(b.size).text_color(t.syntax_plain).child(gutter_column(t, g, b.first, last)).child(area)
}
