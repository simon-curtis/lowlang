import std/testing
import std/text
import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

struct SheetRig {
    cx: ui.Context
    look: Theme
    state: ui.Signal[SheetState]
    notes: ui.Signal[str[]]
    menu: OpenMenu
    frame: SheetFrame
    view: fn() -> ui.Element
}

fn sheet_numbers(rows: i64, columns: i64) -> SheetSource {
    var names: str[] = []
    var widths: i64[] = []
    var numeric: bool[] = []
    for column in 0..columns {
        names.push("col{column}")
        widths.push(8)
        numeric.push(false)
    }
    SheetSource {
        columns: names
        widths
        numeric
        total: rows
        read: fn(first: i64, end: i64, first_column: i64, end_column: i64) -> SheetPage {
            var out: str?[][] = []
            for row in first..end {
                var cells: str?[] = []
                for column in first_column..end_column {
                    cells.push("{row + 1}:{column}")
                }
                out.push(cells)
            }
            SheetPage { first, first_column, rows: out }
        }
    }
}

fn sheet_probe_exports(notes: ui.Signal[str[]]) -> SheetExport[] {
    var exports: SheetExport[] = []
    for name in ["CSV", "JSON"] {
        exports.push(SheetExport {
            label: "Export to {name}"
            selection_label: "Export selection to {name}"
            glyph: "file-text"
            run: fn(selected: SheetBlock?) {
                match selected {
                    some(block) => note(notes, "{name} rows {block.first_row}-{block.end_row} columns {block.first_column}-{block.end_column}")
                    none => note(notes, "{name} everything")
                }
            }
        })
    }
    exports
}

fn sheet_rig_of(mode: SheetMode, source: SheetSource) -> SheetRig {
    sheet_rig_with(mode, source, false)
}

fn sheet_rig_with(mode: SheetMode, source: SheetSource, exported: bool) -> SheetRig {
    sheet_rig_made(mode, source, exported, false, none)
}

fn sheet_rig_editing(mode: SheetMode, source: SheetSource, start: str?) -> SheetRig {
    sheet_rig_made(mode, source, false, true, start)
}

fn sheet_rig_made(mode: SheetMode, source: SheetSource, exported: bool, editing: bool, start: str?) -> SheetRig {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    ui.bind_keys(cx, sheet_bindings())
    let look = default_theme()
    let rule = ruler()
    let state = ui.signal(cx, sheet_state())
    let notes = new_log(cx)
    let menu = open_menu(cx, "sheet-menu")
    var host = SheetHost {
        id: "sheet"
        cx
        menu
        mode
        read: fn() -> SheetState { ui.get(state) }
        edit: fn(change: fn(SheetState) -> SheetState) { ui.update(state, change) }
        notice: fn(message: str) { note(notes, message) }
        exports: if exported { sheet_probe_exports(notes) } else { [] }
    }
    if editing {
        host.begin_edit = fn(row: i64, column: i64) -> str? {
            note(notes, "begin {row}:{column}")
            start
        }
        host.commit_edit = fn(row: i64, column: i64, typed: str) { note(notes, "commit {row}:{column}={typed}") }
    }
    let frame = SheetFrame { host, source, char_width: ruler_width(rule, "0", sheet_text_size) }
    let view = fn() -> ui.Element {
        ui.column(ui.div()).size(400.0, 300.0).child(sheet_view(look, rule, host, source, ui.get(state)))
    }
    SheetRig { cx, look, state, notes, menu, frame, view }
}

fn sheet_rig(mode: SheetMode, rows: i64, columns: i64) -> SheetRig {
    sheet_rig_of(mode, sheet_numbers(rows, columns))
}

fn sheet_shot(r: SheetRig) -> scene.Scene {
    ui.frame(r.cx, r.view, window(), 1.0)
    ui.frame(r.cx, r.view, window(), 1.0)
}

fn sheet_nothing() -> SheetBlock {
    SheetBlock { first_row: -1, end_row: -1, first_column: -1, end_column: -1 }
}

fn sheet_no_value() -> SheetValue {
    SheetValue { title: "", text: "", shown: "", at: geometry.point(0.0, 0.0) }
}

fn sheet_now(r: SheetRig) -> SheetState {
    ui.get(r.state)
}

fn sheet_laid(r: SheetRig) -> SheetLayout {
    sheet_layout_in(r.frame, sheet_now(r))
}

fn sheet_cell_x(r: SheetRig, column: i64) -> f32 {
    let layout = sheet_laid(r)
    layout.gutter + layout.offsets[column] - sheet_now(r).left + 6.0
}

fn sheet_row_y(r: SheetRig, row: i64) -> f32 {
    f32(f64(sheet_header_height) + f64(row) * f64(sheet_row_height) - sheet_now(r).top + 8.0)
}

fn sheet_press(r: SheetRig, x: f32, y: f32, modifiers: platform.Modifiers) {
    sheet_shot(r)
    ui.dispatch(r.cx, platform.Event.PointerMoved(x, y))
    ui.dispatch(r.cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x, y, clicks: 1, modifiers }))
}

fn sheet_release(r: SheetRig, x: f32, y: f32) {
    ui.dispatch(r.cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x, y, clicks: 1 }))
    sheet_shot(r)
}

fn sheet_click(r: SheetRig, x: f32, y: f32) {
    sheet_press(r, x, y, platform.Modifiers {})
    sheet_release(r, x, y)
}

fn sheet_modified_click(r: SheetRig, x: f32, y: f32, modifiers: platform.Modifiers) {
    sheet_press(r, x, y, modifiers)
    sheet_release(r, x, y)
}

fn sheet_double_click(r: SheetRig, x: f32, y: f32) {
    sheet_shot(r)
    ui.dispatch(r.cx, platform.Event.PointerMoved(x, y))
    ui.dispatch(r.cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x, y, clicks: 1 }))
    ui.dispatch(r.cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x, y, clicks: 1 }))
    ui.dispatch(r.cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x, y, clicks: 2 }))
    ui.dispatch(r.cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x, y, clicks: 2 }))
    sheet_shot(r)
}

fn sheet_drag(r: SheetRig, from_x: f32, from_y: f32, to_x: f32, to_y: f32) {
    sheet_press(r, from_x, from_y, platform.Modifiers {})
    for step in 1..5 {
        let share = f32(step) / 4.0
        ui.dispatch(r.cx, platform.Event.PointerMoved(from_x + (to_x - from_x) * share, from_y + (to_y - from_y) * share))
        sheet_shot(r)
    }
    sheet_release(r, to_x, to_y)
}

fn sheet_wheel(r: SheetRig, dx: f32, dy: f32) {
    sheet_shot(r)
    ui.dispatch(r.cx, platform.Event.PointerMoved(200.0, 150.0))
    ui.dispatch(r.cx, platform.Event.Scrolled(dx, dy, platform.Modifiers {}))
    sheet_shot(r)
}

fn sheet_key_with(r: SheetRig, named: platform.NamedKey, modifiers: platform.Modifiers) {
    ui.dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(named), modifiers }))
    sheet_shot(r)
}

fn sheet_key_plain(r: SheetRig, named: platform.NamedKey) {
    sheet_key_with(r, named, platform.Modifiers {})
}

fn sheet_chord(r: SheetRig, letter: str, modifiers: platform.Modifiers) {
    ui.dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(letter), modifiers }))
    sheet_shot(r)
}

fn sheet_right_click(r: SheetRig, x: f32, y: f32) {
    sheet_shot(r)
    ui.dispatch(r.cx, platform.Event.PointerMoved(x, y))
    ui.dispatch(r.cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Right, x, y }))
    ui.dispatch(r.cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Right, x, y }))
    sheet_shot(r)
}

fn sheet_waited(r: SheetRig, ready: fn() -> bool) -> bool {
    for _ in 0..400 {
        sheet_shot(r)
        if ready() {
            return true
        }
        sleep(5)
    }
    false
}

fn sheet_noted(r: SheetRig) -> str[] {
    ui.get(r.notes)
}

fn sheet_glyphs(sc: scene.Scene, colour: geometry.Color) -> scene.Sprite[] {
    var found: scene.Sprite[] = []
    for sprite in sc.sprites {
        if near(sprite.color.r, colour.r) && near(sprite.color.g, colour.g) && near(sprite.color.b, colour.b) && near(sprite.color.a, colour.a) {
            found.push(sprite)
        }
    }
    found
}

fn sheet_dividers(sc: scene.Scene) -> f32[] {
    let line = ui.rgba(0xffffff0c)
    var found: f32[] = []
    for q in sc.quads {
        if near(q.background.a, line.a) && near(q.background.r, line.r) && near(q.bounds.width, 1.0) && q.bounds.height > 100.0 {
            found.push(q.bounds.x)
        }
    }
    found
}

fn sheet_band(sc: scene.Scene, look: Theme) -> scene.Quad? {
    for q in sc.quads {
        if near(q.background.r, look.raised.r) && near(q.background.g, look.raised.g) && near(q.bounds.height, sheet_header_height) {
            return q
        }
    }
    none
}

fn sheet_top_y(sprites: scene.Sprite[]) -> f32 {
    var top: f32 = 100000.0
    for sprite in sprites {
        if sprite.bounds.y < top {
            top = sprite.bounds.y
        }
    }
    top
}

fn sheet_right_edge(sprites: scene.Sprite[]) -> f32 {
    var edge: f32 = -1000.0
    for sprite in sprites {
        let right = sprite.bounds.x + sprite.bounds.width
        if right > edge {
            edge = right
        }
    }
    edge
}

fn sheet_in_header(sprites: scene.Sprite[]) -> scene.Sprite[] {
    var found: scene.Sprite[] = []
    for sprite in sprites {
        if sprite.bounds.y < sheet_header_height {
            found.push(sprite)
        }
    }
    found
}

fn sheet_right_of(sprites: scene.Sprite[], x: f32) -> scene.Sprite[] {
    var found: scene.Sprite[] = []
    for sprite in sprites {
        if sprite.bounds.x >= x {
            found.push(sprite)
        }
    }
    found
}

fn sheet_left_of(sprites: scene.Sprite[], x: f32) -> scene.Sprite[] {
    var found: scene.Sprite[] = []
    for sprite in sprites {
        if sprite.bounds.x < x {
            found.push(sprite)
        }
    }
    found
}

fn sheet_near_pixel(got: f32, want: f32) -> bool {
    got > want - 1.0 && got < want + 1.0
}

fn sheet_expect_frozen(t: *testing.T, r: SheetRig, label: str, header_y: f32, row_offset: f32) {
    let sc = sheet_shot(r)
    let layout = sheet_laid(r)
    let state = sheet_now(r)
    match sheet_band(sc, r.look) {
        some(q) => {
            if !near(q.bounds.y, 0.0) {
                t.error("{label}: the header band is at {q.bounds.y}")
            }
        }
        none => t.error("{label}: no header band")
    }
    let head = sheet_in_header(sheet_glyphs(sc, r.look.muted))
    if head.len == 0 {
        t.error("{label}: no header text")
    } else if !sheet_near_pixel(sheet_top_y(head), header_y) {
        t.error("{label}: header text at {sheet_top_y(head)}, want {header_y}")
    }
    let gutter = sheet_left_of(sheet_glyphs(sc, r.look.faint), layout.gutter)
    if gutter.len == 0 {
        t.error("{label}: no row numbers")
        return
    }
    let edge = sheet_right_edge(gutter)
    if edge > layout.gutter - sheet_cell_padding + 1.0 || edge < layout.gutter - sheet_cell_padding - 6.0 {
        t.error("{label}: row numbers end at {edge}, gutter is {layout.gutter}")
    }
    let cells = sheet_right_of(sheet_glyphs(sc, r.look.text), layout.gutter)
    if cells.len == 0 {
        t.error("{label}: no cells")
        return
    }
    if !sheet_near_pixel(sheet_top_y(cells), sheet_top_y(gutter)) {
        t.error("{label}: cells start at y {sheet_top_y(cells)}, row numbers at y {sheet_top_y(gutter)}")
    }
    let shift = f32(f64(sheet_first_row(state)) * f64(sheet_row_height) - state.top)
    let wanted = sheet_header_height + shift + row_offset
    if !sheet_near_pixel(sheet_top_y(gutter), wanted) {
        t.error("{label}: row numbers start at y {sheet_top_y(gutter)}, the scroll puts them at {wanted}")
    }
    let lines = sheet_dividers(sc)
    for column in 0..layout.widths.len {
        let x = layout.gutter + layout.offsets[column] - state.left + layout.widths[column] - 1.0
        if x < layout.gutter || x >= layout.width {
            continue
        }
        var found = false
        for line in lines {
            if sheet_near_pixel(line, x) {
                found = true
            }
        }
        if !found {
            t.error("{label}: no divider near {x} for column {column}")
        }
    }
    if sc.quads.len > 400 {
        t.error("{label}: {sc.quads.len} quads drawn")
    }
    if sc.sprites.len > 2000 {
        t.error("{label}: {sc.sprites.len} glyphs drawn")
    }
}

fn sheet_row_offset(r: SheetRig) -> f32 {
    let sc = sheet_shot(r)
    sheet_top_y(sheet_left_of(sheet_glyphs(sc, r.look.faint), sheet_laid(r).gutter)) - sheet_header_height
}

fn test_the_sheet_keeps_header_and_gutter_in_place_while_a_million_rows_scroll(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000000, 200)
    let sc = sheet_shot(r)
    let header_y = sheet_top_y(sheet_in_header(sheet_glyphs(sc, r.look.muted)))
    let offset = sheet_row_offset(r)
    t.is_true(header_y >= 0.0 && header_y < sheet_header_height)
    t.is_true(offset >= 0.0 && offset < sheet_row_height)
    sheet_expect_frozen(t, r, "top", header_y, offset)
    sheet_wheel(r, 0.0, 22.0 * 500000.0 + 7.0)
    t.equal(sheet_now(r).top, 22.0 * 500000.0 + 7.0)
    sheet_expect_frozen(t, r, "half way and 7 px", header_y, offset)
    sheet_wheel(r, 0.0, 999999999999.0)
    t.equal(sheet_now(r).top, sheet_max_top(sheet_laid(r)))
    sheet_expect_frozen(t, r, "last row", header_y, offset)
    sheet_wheel(r, 300.0, 0.0)
    sheet_expect_frozen(t, r, "sideways", header_y, offset)
    sheet_wheel(r, 300.0, -22.0 * 3.0)
    sheet_expect_frozen(t, r, "sideways again", header_y, offset)
}

fn test_a_row_scrolled_by_a_part_of_its_height_draws_where_the_scroll_puts_it(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000000, 4)
    let at_rest = sheet_row_offset(r)
    sheet_wheel(r, 0.0, 7.0)
    same_number(t, at_rest - sheet_row_offset(r), 7.0)
}

fn test_the_scroll_is_clamped_to_the_rows_and_the_columns(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 3)
    sheet_wheel(r, 0.0, -500.0)
    t.equal(sheet_now(r).top, 0.0)
    sheet_wheel(r, -500.0, 0.0)
    t.equal(sheet_now(r).left, 0.0)
    sheet_wheel(r, 900.0, 0.0)
    t.equal(sheet_now(r).left, 0.0)
    sheet_wheel(r, 0.0, 99999999.0)
    t.equal(sheet_now(r).top, sheet_max_top(sheet_laid(r)))
}

fn test_a_click_selects_a_cell_and_takes_focus(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    t.equal(ui.focused(r.cx), "sheet")
    let cell = sheet_now(r).cell ?? SheetAt { row: -1, column: -1 }
    t.equal(cell.row, 2)
    t.equal(cell.column, 1)
    t.is_none(sheet_range(sheet_now(r)))
}

fn test_a_selected_cell_is_drawn_in_the_selection_colour_over_its_row(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    let sc = sheet_shot(r)
    let layout = sheet_laid(r)
    var found = false
    for q in sc.quads {
        if near(q.background.a, r.look.selection.a) && near(q.background.r, r.look.selection.r) && near(q.background.g, r.look.selection.g) {
            found = true
            t.is_true(sheet_near_pixel(q.bounds.x, layout.gutter + layout.offsets[1]))
            t.is_true(sheet_near_pixel(q.bounds.y, sheet_header_height + 2.0 * sheet_row_height))
            t.is_true(sheet_near_pixel(q.bounds.width, layout.widths[1]))
            t.is_true(sheet_near_pixel(q.bounds.height, sheet_row_height))
        }
    }
    t.is_true(found)
}

fn test_the_arrow_keys_move_the_cell_and_scroll_it_into_view(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 0), sheet_row_y(r, 0))
    sheet_key_plain(r, platform.NamedKey.Down)
    sheet_key_plain(r, platform.NamedKey.Down)
    sheet_key_plain(r, platform.NamedKey.Right)
    var cell = sheet_now(r).cell ?? SheetAt { row: -1, column: -1 }
    t.equal(cell.row, 2)
    t.equal(cell.column, 1)
    for _ in 0..20 {
        sheet_key_plain(r, platform.NamedKey.Down)
    }
    cell = sheet_now(r).cell ?? SheetAt { row: -1, column: -1 }
    t.equal(cell.row, 22)
    t.is_true(sheet_now(r).top > 0.0)
    let layout = sheet_laid(r)
    let bottom = f64(cell.row + 1) * f64(sheet_row_height) - sheet_now(r).top
    t.is_true(bottom <= f64(layout.view_height) + 0.01)
    sheet_key_plain(r, platform.NamedKey.Up)
    cell = sheet_now(r).cell ?? SheetAt { row: -1, column: -1 }
    t.equal(cell.row, 21)
}

fn test_the_page_keys_move_by_the_rows_shown_less_one(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 100000, 3)
    sheet_click(r, sheet_cell_x(r, 0), sheet_row_y(r, 0))
    let page = sheet_page(sheet_laid(r))
    sheet_key_plain(r, platform.NamedKey.PageDown)
    t.equal((sheet_now(r).cell ?? SheetAt { row: -1, column: 0 }).row, page)
    sheet_key_plain(r, platform.NamedKey.PageUp)
    t.equal((sheet_now(r).cell ?? SheetAt { row: -1, column: 0 }).row, 0)
}

fn test_control_home_and_end_reach_the_corners_of_a_million_rows(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000000, 200)
    let header_y = sheet_top_y(sheet_in_header(sheet_glyphs(sheet_shot(r), r.look.muted)))
    let offset = sheet_row_offset(r)
    sheet_click(r, sheet_cell_x(r, 0), sheet_row_y(r, 0))
    sheet_key_with(r, platform.NamedKey.End, platform.Modifiers { control: true })
    var cell = sheet_now(r).cell ?? SheetAt { row: -1, column: -1 }
    t.equal(cell.row, 999999)
    t.equal(cell.column, 199)
    t.equal(sheet_now(r).top, sheet_max_top(sheet_laid(r)))
    t.is_true(sheet_now(r).left > 0.0)
    sheet_expect_frozen(t, r, "after control end", header_y, offset)
    sheet_key_with(r, platform.NamedKey.Home, platform.Modifiers { control: true })
    cell = sheet_now(r).cell ?? SheetAt { row: -1, column: -1 }
    t.equal(cell.row, 0)
    t.equal(cell.column, 0)
    t.equal(sheet_now(r).top, 0.0)
    t.equal(sheet_now(r).left, 0.0)
}

fn test_home_and_end_move_along_the_row(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 12)
    sheet_click(r, sheet_cell_x(r, 2), sheet_row_y(r, 4))
    sheet_key_plain(r, platform.NamedKey.End)
    var cell = sheet_now(r).cell ?? SheetAt { row: -1, column: -1 }
    t.equal(cell.row, 4)
    t.equal(cell.column, 11)
    sheet_key_plain(r, platform.NamedKey.Home)
    cell = sheet_now(r).cell ?? SheetAt { row: -1, column: -1 }
    t.equal(cell.row, 4)
    t.equal(cell.column, 0)
}

fn test_shift_with_an_arrow_extends_a_range_from_the_anchor(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 1))
    sheet_key_with(r, platform.NamedKey.Down, platform.Modifiers { shift: true })
    sheet_key_with(r, platform.NamedKey.Down, platform.Modifiers { shift: true })
    sheet_key_with(r, platform.NamedKey.Right, platform.Modifiers { shift: true })
    let block = sheet_block(sheet_now(r)) ?? sheet_nothing()
    t.equal(block.first_row, 1)
    t.equal(block.end_row, 4)
    t.equal(block.first_column, 1)
    t.equal(block.end_column, 3)
}

fn test_control_a_selects_every_cell(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 1))
    sheet_chord(r, "a", platform.Modifiers { control: true })
    let block = sheet_block(sheet_now(r)) ?? sheet_nothing()
    t.equal(block.first_row, 0)
    t.equal(block.end_row, 1000)
    t.equal(block.first_column, 0)
    t.equal(block.end_column, 6)
}

fn test_a_shift_click_extends_from_the_anchor(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 1))
    sheet_modified_click(r, sheet_cell_x(r, 3), sheet_row_y(r, 4), platform.Modifiers { shift: true })
    let block = sheet_block(sheet_now(r)) ?? sheet_nothing()
    t.equal(block.first_row, 1)
    t.equal(block.end_row, 5)
    t.equal(block.first_column, 1)
    t.equal(block.end_column, 4)
}

fn test_dragging_across_cells_selects_a_range(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_drag(r, sheet_cell_x(r, 0), sheet_row_y(r, 1), sheet_cell_x(r, 2), sheet_row_y(r, 3))
    let block = sheet_block(sheet_now(r)) ?? sheet_nothing()
    t.equal(block.first_row, 1)
    t.equal(block.end_row, 4)
    t.equal(block.first_column, 0)
    t.equal(block.end_column, 3)
    t.is_none(sheet_now(r).sweep)
}

fn test_a_drag_that_leaves_the_sheet_still_reaches_the_cell_nearest(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_press(r, sheet_cell_x(r, 0), sheet_row_y(r, 1), platform.Modifiers {})
    ui.dispatch(r.cx, platform.Event.PointerMoved(200.0, 450.0))
    sheet_shot(r)
    ui.dispatch(r.cx, platform.Event.PointerMoved(200.0, 600.0))
    sheet_shot(r)
    let block = sheet_block(sheet_now(r)) ?? sheet_nothing()
    t.equal(block.first_row, 1)
    t.is_true(block.end_row > 10)
    sheet_release(r, 200.0, 600.0)
}

fn test_a_drag_below_the_last_row_scrolls_until_the_pointer_comes_back(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_press(r, sheet_cell_x(r, 0), sheet_row_y(r, 1), platform.Modifiers {})
    ui.dispatch(r.cx, platform.Event.PointerMoved(200.0, 280.0))
    sheet_shot(r)
    ui.dispatch(r.cx, platform.Event.PointerMoved(200.0, 400.0))
    sheet_shot(r)
    t.is_true(sheet_waited(r, fn() -> bool { sheet_now(r).top > 100.0 }))
    t.is_true(sheet_now(r).autoscrolling)
    ui.dispatch(r.cx, platform.Event.PointerMoved(200.0, 150.0))
    sheet_shot(r)
    t.is_true(sheet_waited(r, fn() -> bool { !sheet_now(r).autoscrolling }))
    sheet_release(r, 200.0, 150.0)
}

fn test_a_click_on_a_row_number_selects_the_row(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, 6.0, sheet_row_y(r, 3))
    let block = sheet_block(sheet_now(r)) ?? sheet_nothing()
    t.equal(block.first_row, 3)
    t.equal(block.end_row, 4)
    t.equal(block.first_column, 0)
    t.equal(block.end_column, 6)
    t.is_true(sheet_now(r).every_column)
}

fn test_a_click_on_a_results_header_selects_the_column_and_does_not_sort(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 2), 12.0)
    let block = sheet_block(sheet_now(r)) ?? sheet_nothing()
    t.equal(block.first_column, 2)
    t.equal(block.end_column, 3)
    t.equal(block.first_row, 0)
    t.equal(block.end_row, 1000)
    t.is_none(sheet_now(r).sort)
}

fn test_the_corner_selects_everything(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, 6.0, 12.0)
    let block = sheet_block(sheet_now(r)) ?? sheet_nothing()
    t.equal(block.end_row, 1000)
    t.equal(block.end_column, 6)
}

fn test_dragging_a_column_edge_resizes_that_column(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    let layout = sheet_laid(r)
    let edge = layout.gutter + layout.offsets[1] + layout.widths[1] - 1.0
    sheet_press(r, edge, 12.0, platform.Modifiers {})
    ui.dispatch(r.cx, platform.Event.PointerMoved(edge + 30.0, 12.0))
    sheet_shot(r)
    ui.dispatch(r.cx, platform.Event.PointerMoved(edge + 60.0, 12.0))
    sheet_shot(r)
    sheet_release(r, edge + 60.0, 12.0)
    let after = sheet_laid(r)
    same_number(t, after.widths[1], layout.widths[1] + 60.0)
    same_number(t, after.widths[0], layout.widths[0])
    t.is_true(sheet_is_sized(sheet_now(r), 1))
    t.is_none(sheet_now(r).resize)
}

fn test_a_column_cannot_be_dragged_narrower_than_the_least_width(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    let layout = sheet_laid(r)
    let edge = layout.gutter + layout.offsets[1] + layout.widths[1] - 1.0
    sheet_press(r, edge, 12.0, platform.Modifiers {})
    ui.dispatch(r.cx, platform.Event.PointerMoved(edge - 20.0, 12.0))
    sheet_shot(r)
    ui.dispatch(r.cx, platform.Event.PointerMoved(edge - 500.0, 12.0))
    sheet_shot(r)
    sheet_release(r, edge - 500.0, 12.0)
    same_number(t, sheet_laid(r).widths[1], sheet_narrowest_width)
}

fn test_a_double_click_on_an_edge_fits_the_column_to_its_widest_visible_cell(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    let layout = sheet_laid(r)
    let edge = layout.gutter + layout.offsets[0] + layout.widths[0] - 1.0
    sheet_double_click(r, edge, 12.0)
    let after = sheet_laid(r)
    let widest = sheet_fitted(r.frame.source, 0, 0, 14)
    same_number(t, after.widths[0], r.frame.char_width * f32(widest) + sheet_cell_padding * 2.0)
}

fn test_the_header_menu_fits_and_resets_a_column(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    let layout = sheet_laid(r)
    sheet_right_click(r, sheet_cell_x(r, 1), 12.0)
    t.is_true(menu_is_open(r.menu))
    let items = sheet_menu_items(r.frame, sheet_now(r))
    t.equal(items.len, 3)
    t.equal(items[0].label, "Select column")
    t.equal(items[1].label, "Copy column")
    t.equal(items[2].label, "Fit width to visible rows")
    items[2].action()
    t.is_true(sheet_is_sized(sheet_now(r), 1))
    let again = sheet_menu_items(r.frame, sheet_now(r))
    t.equal(again.len, 4)
    t.equal(again[3].label, "Reset column width")
    again[3].action()
    t.is_false(sheet_is_sized(sheet_now(r), 1))
    same_number(t, sheet_laid(r).widths[1], layout.widths[1])
}

fn test_a_cell_menu_offers_view_copy_and_copy_with_headers(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_right_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    t.is_true(menu_is_open(r.menu))
    let cell = sheet_now(r).cell ?? SheetAt { row: -1, column: -1 }
    t.equal(cell.row, 2)
    t.equal(cell.column, 1)
    let items = sheet_menu_items(r.frame, sheet_now(r))
    var labels: str[] = []
    var hints: str[] = []
    for item in items {
        labels.push(item.label)
        hints.push((item.hint ?? ""))
    }
    t.equal_slice(labels, ["View value", "Copy", "Copy with headers", "Copy row as text", "Select all"])
    t.equal(hints[0], "Enter")
    t.equal(hints[1], "Ctrl+C")
    t.equal(hints[2], "Ctrl+Shift+C")
}

fn test_a_right_click_inside_a_selection_keeps_it(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_drag(r, sheet_cell_x(r, 0), sheet_row_y(r, 1), sheet_cell_x(r, 2), sheet_row_y(r, 3))
    sheet_right_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    let block = sheet_block(sheet_now(r)) ?? sheet_nothing()
    t.equal(block.first_row, 1)
    t.equal(block.end_row, 4)
    let items = sheet_menu_items(r.frame, sheet_now(r))
    t.equal(items[3].label, "Copy rows as text")
}

fn test_a_right_click_on_a_row_number_selects_the_row_and_opens_the_cell_menu(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_right_click(r, 6.0, sheet_row_y(r, 3))
    t.is_true(menu_is_open(r.menu))
    let block = sheet_block(sheet_now(r)) ?? sheet_nothing()
    t.equal(block.first_row, 3)
    t.equal(block.end_column, 6)
}

fn test_shift_f10_opens_the_cell_menu_beside_the_current_cell(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    sheet_key_with(r, platform.NamedKey.Function(10), platform.Modifiers { shift: true })
    t.is_true(menu_is_open(r.menu))
    t.equal(sheet_menu_items(r.frame, sheet_now(r))[0].label, "View value")
}

fn test_the_menu_key_opens_the_cell_menu_beside_the_current_cell(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    sheet_key_with(r, platform.NamedKey.Menu, platform.Modifiers {})
    t.is_true(menu_is_open(r.menu))
    t.equal(sheet_menu_items(r.frame, sheet_now(r))[0].label, "View value")
}

fn test_control_c_copies_the_selection_as_tab_separated_text(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_drag(r, sheet_cell_x(r, 0), sheet_row_y(r, 0), sheet_cell_x(r, 1), sheet_row_y(r, 1))
    sheet_chord(r, "c", platform.Modifiers { control: true })
    t.is_true(sheet_waited(r, fn() -> bool { (ui.clipboard(r.cx) ?? "").len > 0 }))
    t.equal(ui.clipboard(r.cx) ?? "", "1:0\t1:1\r\n2:0\t2:1")
    t.equal_slice(sheet_noted(r), ["Copied 2 rows"])
}

fn test_control_shift_c_copies_the_selection_with_the_column_names(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_drag(r, sheet_cell_x(r, 0), sheet_row_y(r, 0), sheet_cell_x(r, 1), sheet_row_y(r, 1))
    sheet_chord(r, "c", platform.Modifiers { control: true, shift: true })
    t.is_true(sheet_waited(r, fn() -> bool { (ui.clipboard(r.cx) ?? "").len > 0 }))
    t.equal(ui.clipboard(r.cx) ?? "", "col0\tcol1\r\n1:0\t1:1\r\n2:0\t2:1")
    t.equal_slice(sheet_noted(r), ["Copied 2 rows with headers"])
}

fn test_a_copy_with_nothing_selected_says_so(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_shot(r)
    ui.set_focus(r.cx, "sheet")
    sheet_chord(r, "c", platform.Modifiers { control: true })
    t.equal_slice(sheet_noted(r), ["Nothing to copy"])
}

fn test_enter_opens_the_value_of_the_current_cell_and_escape_closes_it(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    sheet_key_plain(r, platform.NamedKey.Enter)
    t.is_true(sheet_waited(r, fn() -> bool { sheet_now(r).value != none }))
    let value = sheet_now(r).value ?? sheet_no_value()
    t.equal(value.text, "3:1")
    t.equal(value.title, "col1 · row 3 · Text · 3 characters")
    let sc = sheet_shot(r)
    t.is_some(ui.bounds_of(r.cx, "value-view"))
    sheet_key_plain(r, platform.NamedKey.Escape)
    t.is_none(sheet_now(r).value)
    sheet_shot(r)
    t.is_none(ui.bounds_of(r.cx, "value-view"))
}

fn test_the_value_view_copies_the_whole_value(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    sheet_key_plain(r, platform.NamedKey.Enter)
    t.is_true(sheet_waited(r, fn() -> bool { sheet_now(r).value != none }))
    let bounds = ui.bounds_of(r.cx, "value-copy") ?? geometry.Rect {}
    t.is_true(bounds.width > 0.0)
    sheet_click(r, bounds.x + bounds.width / 2.0, bounds.y + bounds.height / 2.0)
    t.equal(ui.clipboard(r.cx) ?? "", "3:1")
    t.equal_slice(sheet_noted(r), ["Copied the value"])
}

fn test_a_missing_value_is_drawn_as_null_in_the_faint_colour(t: *testing.T) {
    let source = SheetSource {
        columns: ["a"]
        widths: [6]
        numeric: [false]
        total: 2
        read: fn(first: i64, end: i64, first_column: i64, end_column: i64) -> SheetPage {
            var out: str?[][] = []
            for row in first..end {
                var cells: str?[] = []
                cells.push(none)
                out.push(cells)
            }
            SheetPage { first, first_column, rows: out }
        }
    }
    let r = sheet_rig_of(SheetMode.Results, source)
    let sc = sheet_shot(r)
    let layout = sheet_laid(r)
    let cells = sheet_right_of(sheet_glyphs(sc, r.look.faint), layout.gutter)
    t.equal(cells.len, 8)
}

fn test_a_table_sheet_cycles_the_sort_on_each_header_release(t: *testing.T) {
    let table = SheetTable {
        columns: ["id", "name"]
        numeric: [true, false]
        rows: [["2", "b"], ["10", "a"], ["1", "c"]]
    }
    let order = sheet_table_order(table, none)
    let r = sheet_rig_of(SheetMode.Table, sheet_table_source(table, order))
    sheet_click(r, sheet_cell_x(r, 0), 12.0)
    var sorted = sheet_now(r).sort ?? SheetSort { column: -1, descending: false }
    t.equal(sorted.column, 0)
    t.is_false(sorted.descending)
    sheet_click(r, sheet_cell_x(r, 0), 12.0)
    sorted = sheet_now(r).sort ?? SheetSort { column: -1, descending: false }
    t.is_true(sorted.descending)
    sheet_click(r, sheet_cell_x(r, 0), 12.0)
    t.is_none(sheet_now(r).sort)
}

fn test_a_table_sheet_header_menu_lists_the_sorts(t: *testing.T) {
    let table = SheetTable {
        columns: ["id", "name"]
        numeric: [true, false]
        rows: [["2", "b"], ["10", "a"]]
    }
    let r = sheet_rig_of(SheetMode.Table, sheet_table_source(table, sheet_table_order(table, none)))
    sheet_right_click(r, sheet_cell_x(r, 1), 12.0)
    var labels: str[] = []
    for item in sheet_menu_items(r.frame, sheet_now(r)) {
        labels.push(item.label)
    }
    t.equal_slice(labels, ["Sort ascending", "Sort descending", "Select column", "Copy column", "Fit width to every row"])
}

fn test_the_current_row_is_marked_with_the_current_line_colour(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    let sc = sheet_shot(r)
    var found = false
    for q in sc.quads {
        if near(q.background.a, r.look.current_line.a) && near(q.background.r, r.look.current_line.r) && near(q.bounds.height, sheet_row_height) {
            same_number(t, q.bounds.y, sheet_header_height + 2.0 * sheet_row_height)
            found = true
        }
    }
    t.is_true(found)
}

fn test_a_source_with_no_rows_draws_the_header_and_no_cells(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 0, 3)
    let sc = sheet_shot(r)
    t.is_true(sheet_glyphs(sc, r.look.muted).len > 0)
    t.equal(sheet_right_of(sheet_glyphs(sc, r.look.text), sheet_laid(r).gutter).len, 0)
    sheet_wheel(r, 0.0, 100.0)
    t.equal(sheet_now(r).top, 0.0)
    sheet_click(r, 100.0, 100.0)
    t.is_none(sheet_now(r).cell)
}

fn sheet_thumb_quad(r: SheetRig, sc: scene.Scene, hot: bool) -> scene.Quad? {
    let colour = if hot { r.look.scrollbar_hot } else { r.look.scrollbar }
    for q in sc.quads {
        if near(q.background.a, colour.a) && near(q.background.r, colour.r) && q.bounds.x > 300.0 {
            return q
        }
    }
    none
}

fn test_a_long_sheet_draws_a_vertical_thumb_in_the_strip_at_its_right(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 3)
    let sc = sheet_shot(r)
    let thumb = sheet_thumb_quad(r, sc, false) ?? panic("the thumb is drawn")
    t.is_true(sheet_near_pixel(thumb.bounds.x, 400.0 - sheet_bar_width + 2.0))
    t.is_true(sheet_near_pixel(thumb.bounds.width, sheet_bar_width - 4.0))
    t.is_true(sheet_near_pixel(thumb.bounds.y, sheet_header_height))
    t.is_true(sheet_near_pixel(thumb.bounds.height, 24.0))
}

fn test_a_sheet_that_fits_draws_no_thumb(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 3, 2)
    let sc = sheet_shot(r)
    t.is_none(sheet_thumb_quad(r, sc, false))
}

fn test_dragging_the_thumb_scrolls_the_rows_and_releasing_lets_go(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 100000, 3)
    let x: f32 = 395.0
    let y: f32 = sheet_header_height + 6.0
    sheet_press(r, x, y, platform.Modifiers {})
    t.is_some(sheet_now(r).grab)
    ui.dispatch(r.cx, platform.Event.PointerMoved(x, y + 20.0))
    sheet_shot(r)
    ui.dispatch(r.cx, platform.Event.PointerMoved(x, y + 60.0))
    sheet_shot(r)
    t.is_true(sheet_now(r).top > 100000.0)
    t.is_none(sheet_now(r).cell)
    let held = sheet_thumb_quad(r, sheet_shot(r), true)
    t.is_some(held)
    sheet_release(r, x, y + 60.0)
    t.is_none(sheet_now(r).grab)
    let before = sheet_now(r).top
    ui.dispatch(r.cx, platform.Event.PointerMoved(x, y + 90.0))
    sheet_shot(r)
    t.equal(sheet_now(r).top, before)
}

fn test_a_click_on_the_strip_below_the_thumb_jumps_there(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 3)
    sheet_click(r, 400.0 - 5.0, 200.0)
    t.is_true(sheet_now(r).top > 1000.0)
    t.is_none(sheet_now(r).cell)
}

fn test_a_cell_menu_offers_the_exports_after_the_table_items(t: *testing.T) {
    let r = sheet_rig_with(SheetMode.Results, sheet_numbers(1000, 6), true)
    sheet_right_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    var labels: str[] = []
    for item in sheet_menu_items(r.frame, sheet_now(r)) {
        labels.push(item.label)
    }
    t.equal_slice(labels, ["View value", "Copy", "Copy with headers", "Copy row as text", "Select all", "Export to CSV", "Export to JSON"])
}

fn test_an_export_from_the_menu_passes_no_block_without_a_selection(t: *testing.T) {
    let r = sheet_rig_with(SheetMode.Results, sheet_numbers(1000, 6), true)
    sheet_right_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    let items = sheet_menu_items(r.frame, sheet_now(r))
    items[items.len - 2].action()
    t.equal_slice(sheet_noted(r), ["CSV everything"])
}

fn test_a_selection_changes_the_export_labels_and_passes_its_block(t: *testing.T) {
    let r = sheet_rig_with(SheetMode.Results, sheet_numbers(1000, 6), true)
    sheet_drag(r, sheet_cell_x(r, 0), sheet_row_y(r, 1), sheet_cell_x(r, 2), sheet_row_y(r, 3))
    sheet_right_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    let items = sheet_menu_items(r.frame, sheet_now(r))
    t.equal(items[items.len - 2].label, "Export selection to CSV")
    t.equal(items[items.len - 1].label, "Export selection to JSON")
    items[items.len - 1].action()
    t.equal_slice(sheet_noted(r), ["JSON rows 1-4 columns 0-3"])
}

fn test_the_exports_are_set_apart_from_the_items_above_them(t: *testing.T) {
    let r = sheet_rig_with(SheetMode.Results, sheet_numbers(1000, 6), true)
    sheet_right_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    let items = sheet_menu_items(r.frame, sheet_now(r))
    t.is_true(items[items.len - 2].separated)
    t.is_false(items[items.len - 1].separated)
}

fn test_a_cell_menu_offers_the_commands_of_the_row_first_for_the_row_that_was_clicked(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_right_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    var host = r.frame.host
    host.row_items = fn(row: i64) -> MenuItem[] { [plain("Act on row {row}", "x", fn() {})] }
    let frame = SheetFrame { host, source: r.frame.source, char_width: r.frame.char_width }
    var labels: str[] = []
    for item in sheet_menu_items(frame, sheet_now(r)) {
        labels.push(item.label)
    }
    t.equal_slice(labels, ["Act on row 2", "View value", "Copy", "Copy with headers", "Copy row as text", "Select all"])
}

fn sheet_typed(r: SheetRig, content: str) {
    ui.dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(content), text: content }))
    sheet_shot(r)
}

fn sheet_entry_text(r: SheetRig) -> str {
    let open = sheet_now(r).entry ?? SheetEntry { row: -1, column: -1, text: "<none>" }
    open.text
}

fn sheet_entry_opened_on(r: SheetRig, row: i64, column: i64) {
    sheet_click(r, sheet_cell_x(r, column), sheet_row_y(r, row))
    sheet_key_plain(r, platform.NamedKey.Function(2))
    sheet_shot(r)
}

fn test_f2_asks_the_host_to_edit_the_current_cell_and_opens_an_entry_on_what_it_answers(t: *testing.T) {
    let r = sheet_rig_editing(SheetMode.Results, sheet_numbers(1000, 6), some("start"))
    sheet_entry_opened_on(r, 2, 1)
    t.equal_slice(sheet_noted(r), ["begin 2:1"])
    let open = sheet_now(r).entry ?? SheetEntry { row: -1, column: -1, text: "" }
    t.equal(open.row, 2)
    t.equal(open.column, 1)
    t.equal(open.text, "start")
    t.equal(ui.focused(r.cx), "sheet-entry")
    let box = ui.bounds_of(r.cx, "sheet-entry-box") ?? geometry.Rect {}
    t.is_true(box.width >= 160.0)
    t.is_true(sheet_near_pixel(box.y, sheet_header_height + 2.0 * sheet_row_height))
}

fn test_a_cell_the_host_will_not_edit_opens_no_entry(t: *testing.T) {
    let r = sheet_rig_editing(SheetMode.Results, sheet_numbers(1000, 6), none)
    sheet_entry_opened_on(r, 2, 1)
    t.equal_slice(sheet_noted(r), ["begin 2:1"])
    t.is_none(sheet_now(r).entry)
    t.equal(ui.focused(r.cx), "sheet")
}

fn test_a_sheet_whose_host_takes_no_edits_ignores_f2(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    sheet_click(r, sheet_cell_x(r, 1), sheet_row_y(r, 2))
    sheet_key_plain(r, platform.NamedKey.Function(2))
    t.is_none(sheet_now(r).entry)
}

fn test_typing_replaces_the_selected_text_and_enter_hands_it_to_the_host_without_opening_the_value(t: *testing.T) {
    let r = sheet_rig_editing(SheetMode.Results, sheet_numbers(1000, 6), some("start"))
    sheet_entry_opened_on(r, 2, 1)
    sheet_typed(r, "Z")
    t.equal(sheet_entry_text(r), "Z")
    sheet_key_plain(r, platform.NamedKey.Enter)
    t.equal_slice(sheet_noted(r), ["begin 2:1", "commit 2:1=Z"])
    t.is_none(sheet_now(r).entry)
    t.equal(sheet_now(r).viewing, 0)
    t.equal(ui.focused(r.cx), "sheet")
    sheet_shot(r)
    t.is_none(ui.bounds_of(r.cx, "sheet-entry-box"))
}

fn test_escape_drops_what_was_typed_and_returns_the_focus_to_the_sheet(t: *testing.T) {
    let r = sheet_rig_editing(SheetMode.Results, sheet_numbers(1000, 6), some("start"))
    sheet_entry_opened_on(r, 2, 1)
    sheet_typed(r, "Z")
    sheet_key_plain(r, platform.NamedKey.Escape)
    t.equal_slice(sheet_noted(r), ["begin 2:1"])
    t.is_none(sheet_now(r).entry)
    t.equal(ui.focused(r.cx), "sheet")
}

fn test_the_editing_keys_move_the_caret_in_the_entry_and_leave_the_selection_alone(t: *testing.T) {
    let r = sheet_rig_editing(SheetMode.Results, sheet_numbers(1000, 6), some("start"))
    sheet_entry_opened_on(r, 2, 1)
    sheet_key_plain(r, platform.NamedKey.Home)
    sheet_typed(r, "Q")
    t.equal(sheet_entry_text(r), "Qstart")
    sheet_key_plain(r, platform.NamedKey.Left)
    sheet_chord(r, "a", platform.Modifiers { control: true })
    t.is_none(sheet_range(sheet_now(r)))
    let cell = sheet_now(r).cell ?? SheetAt { row: -1, column: -1 }
    t.equal(cell.row, 2)
    t.equal(cell.column, 1)
    t.equal(sheet_entry_text(r), "Qstart")
}

fn test_a_click_in_the_entry_keeps_it_open_and_focused(t: *testing.T) {
    let r = sheet_rig_editing(SheetMode.Results, sheet_numbers(1000, 6), some("start"))
    sheet_entry_opened_on(r, 2, 1)
    let box = ui.bounds_of(r.cx, "sheet-entry-box") ?? geometry.Rect {}
    sheet_click(r, box.x + 20.0, box.y + box.height / 2.0)
    t.is_some(sheet_now(r).entry)
    t.equal(ui.focused(r.cx), "sheet-entry")
}

fn test_a_click_on_another_cell_closes_the_entry_without_keeping_it(t: *testing.T) {
    let r = sheet_rig_editing(SheetMode.Results, sheet_numbers(1000, 6), some("start"))
    sheet_entry_opened_on(r, 2, 1)
    sheet_click(r, sheet_cell_x(r, 3), sheet_row_y(r, 5))
    t.is_none(sheet_now(r).entry)
    t.equal_slice(sheet_noted(r), ["begin 2:1"])
    t.equal(ui.focused(r.cx), "sheet")
}

fn test_a_double_click_edits_a_results_cell_and_views_a_table_cell(t: *testing.T) {
    let results = sheet_rig_editing(SheetMode.Results, sheet_numbers(1000, 6), some("v"))
    sheet_double_click(results, sheet_cell_x(results, 1), sheet_row_y(results, 2))
    t.equal_slice(sheet_noted(results), ["begin 2:1"])
    t.is_some(sheet_now(results).entry)
    let table = sheet_rig_editing(SheetMode.Table, sheet_numbers(1000, 6), some("v"))
    sheet_double_click(table, sheet_cell_x(table, 1), sheet_row_y(table, 2))
    t.equal_slice(sheet_noted(table), [])
    t.is_none(sheet_now(table).entry)
}

fn sheet_marked_source() -> SheetSource {
    var source = sheet_numbers(1000, 6)
    source.marks = some(SheetMarks {
        row: fn(row: i64) -> SheetRowMark {
            match row {
                1 => SheetRowMark.Removed
                2 => SheetRowMark.Added
                _ => SheetRowMark.Plain
            }
        }
        changed: fn(row: i64, column: i64) -> bool { row == 3 && column == 1 }
    })
    source
}

fn sheet_quads_of(sc: scene.Scene, colour: geometry.Color) -> scene.Quad[] {
    var found: scene.Quad[] = []
    for q in sc.quads {
        if near(q.background.r, colour.r) && near(q.background.g, colour.g) && near(q.background.b, colour.b) && near(q.background.a, colour.a) {
            found.push(q)
        }
    }
    found
}

fn test_a_removed_row_is_shaded_in_the_danger_colour_and_drawn_faint(t: *testing.T) {
    let r = sheet_rig_of(SheetMode.Results, sheet_marked_source())
    let sc = sheet_shot(r)
    let shaded = sheet_quads_of(sc, r.look.danger_soft)
    t.equal(shaded.len, 1)
    t.is_true(sheet_near_pixel(shaded[0].bounds.y, sheet_header_height + sheet_row_height))
    let layout = sheet_laid(r)
    let faint = sheet_glyphs(sc, r.look.faint)
    var on_row = 0
    for glyph in faint {
        let y = glyph.bounds.y
        if y >= sheet_header_height + sheet_row_height && y < sheet_header_height + 2.0 * sheet_row_height && glyph.bounds.x > layout.gutter {
            on_row += 1
        }
    }
    t.is_true(on_row > 0)
}

fn test_an_added_row_and_a_changed_cell_are_shaded_green(t: *testing.T) {
    let r = sheet_rig_of(SheetMode.Results, sheet_marked_source())
    let sc = sheet_shot(r)
    let added = sheet_quads_of(sc, ui.rgba(sheet_fresh))
    t.equal(added.len, 1)
    t.is_true(sheet_near_pixel(added[0].bounds.y, sheet_header_height + 2.0 * sheet_row_height))
    let changed = sheet_quads_of(sc, ui.rgba(sheet_changed))
    t.equal(changed.len, 1)
    let layout = sheet_laid(r)
    t.is_true(sheet_near_pixel(changed[0].bounds.x, layout.gutter + layout.offsets[1]))
    t.is_true(sheet_near_pixel(changed[0].bounds.y, sheet_header_height + 3.0 * sheet_row_height))
    t.is_true(sheet_near_pixel(changed[0].bounds.width, layout.widths[1]))
}

fn test_a_sheet_without_marks_draws_no_row_or_cell_tints(t: *testing.T) {
    let r = sheet_rig(SheetMode.Results, 1000, 6)
    let sc = sheet_shot(r)
    t.equal(sheet_quads_of(sc, r.look.danger_soft).len, 0)
    t.equal(sheet_quads_of(sc, ui.rgba(sheet_fresh)).len, 0)
    t.equal(sheet_quads_of(sc, ui.rgba(sheet_changed)).len, 0)
}
