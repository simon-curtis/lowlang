import std/testing
import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn tooltip_view(look: Theme, content: str) -> fn() -> ui.Element {
    fn() -> ui.Element {
        let owner = ui.div().id("owner").size(100.0, 100.0)
        ui.div().size(400.0, 300.0).child(tooltip(look, owner, content))
    }
}

fn tooltip_card_of(sc: scene.Scene, look: Theme) -> scene.Quad? {
    for q in filled(sc) {
        if near(q.background.r, look.raised.r) && near(q.background.a, look.raised.a) && q.corner_radii.top_left == 6.0 {
            return q
        }
    }
    none
}

fn test_a_tooltip_appears_after_the_pointer_rests_half_a_second(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = tooltip_view(look, "Run the query")
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    ui.advance_clock(cx, 499)
    t.equal(filled(shot(cx, view)).len, 0)
    ui.advance_clock(cx, 1)
    let sc = shot(cx, view)
    t.is_true(tooltip_card_of(sc, look) != none)
}

fn test_a_tooltip_is_a_six_radius_raised_card_with_a_border_and_a_shadow(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = tooltip_view(look, "Run the query")
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    ui.advance_clock(cx, 500)
    let sc = shot(cx, view)
    let card = tooltip_card_of(sc, look) ?? scene.Quad { bounds: geometry.Rect {} }
    same_colour(t, card.background, look.raised)
    t.equal(sc.shadows.len, 2)
    same_colour(t, outlined(sc).border_color, look.border)
    t.equal(outlined(sc).border_widths.top, 1.0)
    t.is_true(card.bounds.width > 2.0 * floor(step(2.0)))
    t.is_true(card.bounds.height > 2.0 * floor(step(0.5)) + 2.0)
}

fn test_a_tooltip_sits_three_steps_of_margin_from_the_pointer(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = tooltip_view(look, "Run the query")
    shot(cx, view)
    move_to(cx, 10.0, 20.0)
    ui.advance_clock(cx, 500)
    let card = tooltip_card_of(shot(cx, view), look) ?? scene.Quad { bounds: geometry.Rect {} }
    same_number(t, card.bounds.x, 10.0 + 1.0 + floor(step(3.0) + 0.5))
    same_number(t, card.bounds.y, 20.0 + 1.0 + floor(step(3.0) + 0.5))
}

fn test_a_tooltip_draws_its_text_in_the_text_colour_at_the_tooltip_size(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = tooltip_view(look, "Run the query")
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    ui.advance_clock(cx, 500)
    let sc = shot(cx, view)
    t.is_true(tinted(sc, look.text) > 0)
    t.equal(tinted(sc, look.muted), 0)
    same_number(t, tooltip_text_size, 11.375)
}

fn test_a_longer_text_makes_a_wider_tooltip(t: *testing.T) {
    let look = default_theme()
    let short = ui.headless(ui.rgb(0x0b0b0e))
    let long = ui.headless(ui.rgb(0x0b0b0e))
    let short_view = tooltip_view(look, "Run")
    let long_view = tooltip_view(look, "Run the current task against the open project")
    shot(short, short_view)
    shot(long, long_view)
    move_to(short, 10.0, 10.0)
    move_to(long, 10.0, 10.0)
    ui.advance_clock(short, 500)
    ui.advance_clock(long, 500)
    let narrow = tooltip_card_of(shot(short, short_view), look) ?? scene.Quad { bounds: geometry.Rect {} }
    let wide = tooltip_card_of(shot(long, long_view), look) ?? scene.Quad { bounds: geometry.Rect {} }
    t.is_true(wide.bounds.width > narrow.bounds.width)
    same_number(t, wide.bounds.height, narrow.bounds.height)
}

fn test_a_tooltip_goes_when_the_pointer_leaves_its_owner(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = tooltip_view(look, "Run the query")
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    ui.advance_clock(cx, 500)
    t.is_true(tooltip_card_of(shot(cx, view), look) != none)
    move_to(cx, 300.0, 250.0)
    t.is_true(tooltip_card_of(shot(cx, view), look) == none)
}

fn test_a_tab_chip_close_button_shows_a_tooltip(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = fn() -> ui.Element {
        ui.div().size(400.0, 300.0).child(tab_chip(look, "chip", "Untitled1.txt", none, true, false, true, nothing, nothing))
    }
    shot(cx, view)
    let bounds = ui.bounds_of(cx, "chip-close") ?? geometry.Rect {}
    move_to(cx, bounds.x + bounds.width / 2.0, bounds.y + bounds.height / 2.0)
    ui.advance_clock(cx, 499)
    t.is_true(tooltip_card_of(shot(cx, view), look) == none)
    ui.advance_clock(cx, 1)
    t.is_true(tooltip_card_of(shot(cx, view), look) != none)
}

fn test_a_tooltip_waits_again_after_the_pointer_leaves_and_returns(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let view = tooltip_view(look, "Run the query")
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    ui.advance_clock(cx, 300)
    move_to(cx, 300.0, 250.0)
    ui.advance_clock(cx, 300)
    t.is_true(tooltip_card_of(shot(cx, view), look) == none)
    move_to(cx, 10.0, 10.0)
    ui.advance_clock(cx, 499)
    t.is_true(tooltip_card_of(shot(cx, view), look) == none)
    ui.advance_clock(cx, 1)
    t.is_true(tooltip_card_of(shot(cx, view), look) != none)
}

