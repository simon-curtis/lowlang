import std/testing
import std/ui
import std/ui/geometry

fn tool_window_view(look: Theme, cx: ui.Context) -> fn() -> ui.Element {
    fn() -> ui.Element {
        let content = ui.div().id("tool-content").grow(1.0)
        tool_window(cx, look, Art {}, "default", "Settings", ui.div(), content)
    }
}

fn test_a_tool_window_opens_centred_with_its_own_title_bar_and_a_floor_on_its_size(t: *testing.T) {
    let look = default_theme()
    let o = tool_window_options(look, ToolWindow { title: "Settings", width: 1120, height: 780 }, fn(why: ui.CloseReason) {})
    t.equal(o.title, "Settings")
    t.equal(o.width, 1120)
    t.equal(o.height, 780)
    t.equal(o.min_width, 640)
    t.equal(o.min_height, 420)
    t.is_true(o.titlebar.appears_transparent)
    t.is_true(o.taskbar)
    t.is_none(o.owner)
    same_number(t, o.background.r, look.canvas.r)
    let border = o.border ?? ui.rgb(0x000000)
    t.equal(geometry.rgb_of(border), 0x444444)
    match o.placement {
        CentreOnScreen => {}
        _ => t.fatal("the window is not centred on the screen")
    }
}

fn test_a_tool_window_carries_the_icon_it_is_given(t: *testing.T) {
    let frames = [ui.IconFrame { size: 16, png: "frame" }]
    let o = tool_window_options(default_theme(), ToolWindow { title: "Settings", width: 1120, height: 780, icon: some(frames) }, fn(why: ui.CloseReason) {})
    let icon = o.icon ?? []
    t.equal(icon.len, 1)
    t.equal(icon[0].size, 16)
}

fn test_a_tool_window_has_no_icon_unless_given_one(t: *testing.T) {
    let o = tool_window_options(default_theme(), ToolWindow { title: "Settings", width: 1120, height: 780 }, fn(why: ui.CloseReason) {})
    t.is_none(o.icon)
}

fn test_a_tool_window_puts_the_caption_buttons_top_right_and_its_content_in_an_inset_island(t: *testing.T) {
    let look = default_theme()
    let cx = ui.headless(look.canvas)
    let view = tool_window_view(look, cx)
    shot(cx, view)
    let close = bounds_for(cx, "caption-close")
    same_number(t, close.x + close.width, window().width)
    same_number(t, close.y, 0.0)
    let content = bounds_for(cx, "tool-content")
    t.is_true(content.y >= title_height)
    t.is_true(content.x >= tool_window_margin)
    t.is_true(content.x + content.width <= window().width - tool_window_margin)
    t.is_true(content.y + content.height <= window().height - tool_window_margin)
}
