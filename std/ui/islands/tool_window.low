import std/ui

const tool_window_margin: f32 = 8.0
const tool_window_caption_clearance: f32 = 140.0
const tool_window_min_width: i64 = 640
const tool_window_min_height: i64 = 420

/// What a tool window is called, how large it opens and its icon.
pub struct ToolWindow {
    /// The window title, which the title bar also shows.
    pub title: str
    /// The width of the window's content, in logical pixels.
    pub width: i64
    /// The height of the window's content, in logical pixels.
    pub height: i64
    /// The frames of the window's icon. Defaults to `none`, which keeps the system's.
    pub icon: ui.IconFrame[]? = none
}

/// Returns the options that open `w` as a window with the canvas colour of `t`, a border in its window border colour, a transparent title bar and a place at the centre of the screen. The window cannot be resized below 640 by 420 pixels. `closed` runs once the window has closed, with why it did.
pub fn tool_window_options(t: Theme, w: ToolWindow, closed: fn(ui.CloseReason)) -> ui.WindowOptions {
    let titlebar = ui.TitlebarOptions { appears_transparent: true }
    ui.WindowOptions { title: w.title, width: w.width, height: w.height, min_width: tool_window_min_width, min_height: tool_window_min_height, background: t.canvas, border: some(t.window_border), titlebar, placement: ui.Placement.CentreOnScreen, closed, icon: w.icon }
}

fn tool_window_title(t: Theme, title: str) -> ui.Element {
    let name = ui.row(ui.div()).min_width(0.0).overflow_hidden().text_size(body_size).font_weight(medium).text_color(t.muted).child(ui.text(title).nowrap().ellipsis())
    ui.row(ui.div()).absolute().inset(0.0).padding_xy(tool_window_caption_clearance, 0.0).items_center().justify_center().child(name)
}

fn tool_window_body(t: Theme, content: ui.Element) -> ui.Element {
    let framed = ui.row(island(t)).grow(1.0).min_width(0.0).overflow_hidden().child(content)
    ui.row(ui.div()).grow(1.0).min_height(0.0).padding_xy(tool_window_margin, 0.0).padding_bottom(tool_window_margin).child(framed)
}

/// Returns the content of a tool window: `content` in an island under a title bar that holds `title` in the centre, `brand`, a drag area and the caption buttons. It is drawn on the canvas colour, with the glow of `art` for `scheme` and its grain.
pub fn tool_window(cx: ui.Context, t: Theme, art: Art, scheme: str, title: str, brand: ui.Element, content: ui.Element) -> ui.Element {
    let bar = ui.row(ui.div()).relative().shrink(0.0).height(title_height).items_center().gap(step(2.0)).child(tool_window_title(t, title)).child(brand).child(drag_area()).child(caption_controls(t, cx))
    let frame = ui.column(ui.div()).relative().grow(1.0).min_height(0.0).child(bar).child(tool_window_body(t, content))
    ui.column(ui.div()).relative().background(t.canvas).text_color(t.text).text_size(body_size).font_family(ui_font).child(glow(art, scheme)).child(frame).child(grain(art))
}
