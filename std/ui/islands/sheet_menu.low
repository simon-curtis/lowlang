fn sheet_choose_sort(frame: SheetFrame, column: i64, descending: bool) -> fn() {
    fn() { sheet_sort_by(frame, SheetSort { column, descending }) }
}

fn sheet_clear_sort(frame: SheetFrame) -> fn() {
    fn() { sheet_sort_by(frame, none) }
}

fn sheet_next_hint(item: MenuItem, next: bool) -> MenuItem {
    if next { item.hint("Click") } else { item }
}

fn sheet_column_sort(state: SheetState, column: i64) -> SheetSort? {
    let sorted = state.sort ?? return none
    if sorted.column == column {
        return sorted
    }
    none
}

fn sheet_sort_items(frame: SheetFrame, state: SheetState, column: i64) -> MenuItem[] {
    let sorted = sheet_column_sort(state, column)
    let ascending_next = sorted == none
    var descending_next = false
    var clear_next = false
    match sorted {
        some(by) => {
            descending_next = !by.descending
            clear_next = by.descending
        }
        none => {}
    }
    var items: MenuItem[] = [
        sheet_next_hint(plain("Sort ascending", "arrow-up-narrow-wide", sheet_choose_sort(frame, column, false)), ascending_next)
        sheet_next_hint(plain("Sort descending", "arrow-down-wide-narrow", sheet_choose_sort(frame, column, true)), descending_next)
    ]
    if sorted != none {
        items.push(sheet_next_hint(plain("Clear sort", "list-x", sheet_clear_sort(frame)), clear_next))
    }
    items
}

fn sheet_copy_column(frame: SheetFrame, column: i64) -> fn() {
    fn() {
        sheet_select_column(frame, column)
        sheet_copy(frame, false)
    }
}

fn sheet_header_items(frame: SheetFrame, state: SheetState, column: i64) -> MenuItem[] {
    var items: MenuItem[] = []
    var select_hint = "Click"
    var fit_label = "Fit width to visible rows"
    if sheet_sorts(frame) {
        for item in sheet_sort_items(frame, state, column) {
            items.push(item)
        }
        select_hint = "Ctrl+Click"
        fit_label = "Fit width to every row"
    }
    items.push(plain("Select column", "columns-3", fn() { sheet_select_column(frame, column) }).hint(select_hint).separated_when(sheet_sorts(frame)))
    items.push(plain("Copy column", "copy", sheet_copy_column(frame, column)))
    items.push(plain(fit_label, "move-horizontal", fn() { sheet_fit(frame, column) }).separated())
    if sheet_is_sized(state, column) {
        items.push(plain("Reset column width", "rotate-ccw", fn() { sheet_reset_width(frame, column) }))
    }
    items
}

fn sheet_several_rows(state: SheetState) -> bool {
    let block = sheet_block(state) ?? return false
    sheet_block_rows(block) > 1
}

fn sheet_view_here(frame: SheetFrame, menu: SheetMenu) -> fn() {
    fn() { sheet_view_value(frame, menu.row, menu.column, menu.at) }
}

fn sheet_everything_copied(frame: SheetFrame) -> fn() {
    fn() { sheet_copy_everything(frame) }
}

fn sheet_select_everything_item(frame: SheetFrame) -> MenuItem {
    plain("Select all", "table", fn() { sheet_select_everything(frame) }).hint("Ctrl+A").separated()
}

fn sheet_export_item(frame: SheetFrame, state: SheetState, export: SheetExport) -> MenuItem {
    let range = sheet_range(state)
    let label = if range != none { export.selection_label } else { export.label }
    plain(label, export.glyph, fn() { export.run(range) })
}

fn sheet_export_items(frame: SheetFrame, state: SheetState) -> MenuItem[] {
    var items: MenuItem[] = []
    for index, export in frame.host.exports {
        items.push(sheet_export_item(frame, state, export).separated_when(index == 0))
    }
    items
}

fn sheet_cell_items(frame: SheetFrame, state: SheetState, menu: SheetMenu) -> MenuItem[] {
    let rows_label = if sheet_several_rows(state) { "Copy rows as text" } else { "Copy row as text" }
    let commands = frame.host.row_items(menu.row)
    var items: MenuItem[] = []
    for item in commands {
        items.push(item)
    }
    items.push(plain("View value", "eye", sheet_view_here(frame, menu)).hint("Enter").separated_when(commands.len > 0))
    items.push(plain("Copy", "copy", fn() { sheet_copy(frame, false) }).hint("Ctrl+C").separated())
    items.push(plain("Copy with headers", "clipboard-copy", fn() { sheet_copy(frame, true) }).hint("Ctrl+Shift+C"))
    items.push(plain(rows_label, "rows-3", fn() { sheet_copy_records(frame) }))
    for item in sheet_table_items(frame, state) {
        items.push(item)
    }
    for item in sheet_export_items(frame, state) {
        items.push(item)
    }
    items
}

fn sheet_table_items(frame: SheetFrame, state: SheetState) -> MenuItem[] {
    var items: MenuItem[] = [sheet_select_everything_item(frame)]
    if sheet_sorts(frame) {
        items.push(plain("Copy all with headers", "clipboard-copy", sheet_everything_copied(frame)))
        if state.sort != none {
            items.push(plain("Clear sort", "list-x", sheet_clear_sort(frame)))
        }
    }
    items
}

/// The items of the menu the state asks for: a header menu over a column, a cell menu over a cell or a row number, or the table menu elsewhere.
pub fn sheet_menu_items(frame: SheetFrame, state: SheetState) -> MenuItem[] {
    let menu = state.menu ?? return []
    match menu.kind {
        Header => sheet_header_items(frame, state, menu.column)
        Cell => sheet_cell_items(frame, state, menu)
        Table => sheet_cell_menu_over_nothing(frame, state, menu)
    }
}

fn sheet_cell_menu_over_nothing(frame: SheetFrame, state: SheetState, menu: SheetMenu) -> MenuItem[] {
    if sheet_sorts(frame) {
        return sheet_table_items(frame, state)
    }
    sheet_cell_items(frame, state, menu)
}
