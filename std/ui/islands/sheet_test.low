import std/testing
import std/text
import std/ui/geometry

fn sample_table() -> SheetTable {
    SheetTable {
        columns: ["id", "note", "amount"]
        numeric: [true, false, true]
        rows: [
            ["1", "plain", "10.50"]
            ["2", "says \"hi\", twice\r\nthen stops", none]
            ["3", none, "007"]
        ]
    }
}

fn sample_source() -> SheetSource {
    let table = sample_table()
    sheet_table_source(table, sheet_table_order(table, none))
}

fn grid_size() -> geometry.Size {
    geometry.size(400.0, 126.0)
}

fn big_source(rows: i64, columns: i64) -> SheetSource {
    var names: str[] = []
    var widths: i64[] = []
    var numeric: bool[] = []
    for column in 0..columns {
        names.push("c{column}")
        widths.push(6)
        numeric.push(true)
    }
    SheetSource {
        columns: names
        widths
        numeric
        total: rows
        read: fn(first: i64, end: i64, first_column: i64, end_column: i64) -> SheetPage {
            var out: str?[][] = []
            for row in first..end {
                var cells: str?[] = []
                for column in first_column..end_column {
                    cells.push("{row}")
                }
                out.push(cells)
            }
            SheetPage { first, first_column, rows: out }
        }
    }
}

fn laid_out(state: SheetState, source: SheetSource) -> SheetLayout {
    sheet_layout(state, source, 7.0, grid_size())
}

fn test_a_block_runs_from_the_anchor_to_the_cell_in_either_direction(t: *testing.T) {
    var state = sheet_state()
    t.is_none(sheet_block(state))
    state = sheet_selected(state, SheetAt { row: 4, column: 3 }, SheetAt { row: 1, column: 0 })
    let block = sheet_block(state) ?? return t.fatal("no block")
    t.equal(block.first_row, 1)
    t.equal(block.end_row, 5)
    t.equal(block.first_column, 0)
    t.equal(block.end_column, 4)
    t.equal(sheet_block_cells(block), 16)
}

fn test_a_single_cell_is_a_block_but_not_a_range(t: *testing.T) {
    let state = sheet_selected(sheet_state(), SheetAt { row: 2, column: 1 }, SheetAt { row: 2, column: 1 })
    t.is_some(sheet_block(state))
    t.is_none(sheet_range(state))
}

fn test_moving_clamps_to_the_table_and_starts_from_the_first_cell(t: *testing.T) {
    var state = sheet_moved(sheet_state(), 1, 0, 5, 3, false)
    let first = state.cell ?? return t.fatal("no cell")
    t.equal(first.row, 1)
    t.equal(first.column, 0)
    state = sheet_moved(state, -9, -9, 5, 3, false)
    let top = state.cell ?? return t.fatal("no cell")
    t.equal(top.row, 0)
    t.equal(top.column, 0)
    state = sheet_moved(state, sheet_far, sheet_far, 5, 3, false)
    let last = state.cell ?? return t.fatal("no cell")
    t.equal(last.row, 4)
    t.equal(last.column, 2)
    state = sheet_moved(state, -sheet_far, -sheet_far, 5, 3, false)
    let home = state.cell ?? return t.fatal("no cell")
    t.equal(home.row, 0)
    t.equal(home.column, 0)
}

fn test_extending_keeps_the_anchor_where_the_selection_began(t: *testing.T) {
    var state = sheet_moved(sheet_state(), 1, 1, 5, 3, false)
    state = sheet_moved(state, 2, 0, 5, 3, true)
    state = sheet_moved(state, 0, 1, 5, 3, true)
    let anchor = state.anchor ?? return t.fatal("no anchor")
    t.equal(anchor.row, 1)
    t.equal(anchor.column, 1)
    let block = sheet_block(state) ?? return t.fatal("no block")
    t.equal(block.first_row, 1)
    t.equal(block.end_row, 4)
    t.equal(block.first_column, 1)
    t.equal(block.end_column, 3)
}

fn test_moving_in_an_empty_table_changes_nothing(t: *testing.T) {
    let state = sheet_moved(sheet_state(), 1, 1, 0, 0, false)
    t.is_none(state.cell)
    t.is_none(sheet_selected_all(sheet_state(), 0, 3).cell)
}

fn test_select_all_marks_every_row_and_column_and_stretches_as_rows_arrive(t: *testing.T) {
    var state = sheet_selected_all(sheet_state(), 5, 3)
    t.is_true(state.every_row)
    t.is_true(state.every_column)
    state = sheet_stretched(state, 9, 3)
    let block = sheet_block(state) ?? return t.fatal("no block")
    t.equal(block.end_row, 9)
    t.equal(block.end_column, 3)
}

fn test_a_cell_selection_does_not_stretch(t: *testing.T) {
    let state = sheet_selected(sheet_state(), SheetAt { row: 1, column: 1 }, SheetAt { row: 2, column: 2 })
    let stretched = sheet_stretched(state, 50, 9)
    let block = sheet_block(stretched) ?? return t.fatal("no block")
    t.equal(block.end_row, 3)
    t.equal(block.end_column, 3)
}

fn test_a_whole_selection_clears_when_the_rows_are_gone(t: *testing.T) {
    let state = sheet_selected_all(sheet_state(), 5, 3)
    t.is_none(sheet_stretched(state, 0, 3).cell)
}

fn test_sweeping_columns_selects_whole_columns_and_rows_whole_rows(t: *testing.T) {
    let columns = sheet_swept(sheet_state(), SheetAt { row: 0, column: 1 }, SheetSweep.Columns, false, 5, 3)
    let down = sheet_block(columns) ?? return t.fatal("no block")
    t.equal(down.first_row, 0)
    t.equal(down.end_row, 5)
    t.equal(down.first_column, 1)
    t.equal(down.end_column, 2)
    t.is_true(columns.every_row)
    t.is_false(columns.every_column)
    let rows = sheet_swept(sheet_state(), SheetAt { row: 2, column: 0 }, SheetSweep.Rows, false, 5, 3)
    let across = sheet_block(rows) ?? return t.fatal("no block")
    t.equal(across.first_row, 2)
    t.equal(across.end_row, 3)
    t.equal(across.end_column, 3)
    t.is_true(rows.every_column)
}

fn test_extending_a_column_sweep_reaches_the_columns_between(t: *testing.T) {
    let first = sheet_swept(sheet_state(), SheetAt { row: 0, column: 0 }, SheetSweep.Columns, false, 5, 4)
    let extended = sheet_swept(first, SheetAt { row: 0, column: 2 }, SheetSweep.Columns, true, 5, 4)
    let block = sheet_block(extended) ?? return t.fatal("no block")
    t.equal(block.first_column, 0)
    t.equal(block.end_column, 3)
    t.equal(block.end_row, 5)
}

fn test_the_summary_names_what_is_selected(t: *testing.T) {
    t.is_none(sheet_summary(sheet_state()))
    let one = sheet_selected(sheet_state(), SheetAt { row: 2, column: 1 }, SheetAt { row: 2, column: 1 })
    t.equal(sheet_summary(one) ?? "", "Row 3, column 2 selected")
    let block = sheet_selected(sheet_state(), SheetAt { row: 0, column: 0 }, SheetAt { row: 1, column: 1 })
    t.equal(sheet_summary(block) ?? "", "2 × 2 selected")
    let column = sheet_swept(sheet_state(), SheetAt { row: 0, column: 1 }, SheetSweep.Columns, false, 5000, 3)
    t.equal(sheet_summary(column) ?? "", "1 column selected")
    let row = sheet_swept(sheet_state(), SheetAt { row: 2, column: 0 }, SheetSweep.Rows, false, 5000, 3)
    t.equal(sheet_summary(row) ?? "", "Row 3 selected")
    let rows = sheet_swept(row, SheetAt { row: 5, column: 0 }, SheetSweep.Rows, true, 5000, 3)
    t.equal(sheet_summary(rows) ?? "", "Rows 3 to 6 selected")
    t.equal(sheet_summary(sheet_selected_all(sheet_state(), 5000, 3)) ?? "", "All 5,000 rows selected")
}

fn test_a_layout_sizes_columns_from_characters_and_the_gutter_from_the_row_count(t: *testing.T) {
    let layout = laid_out(sheet_state(), sample_source())
    t.equal(layout.widths.len, 3)
    t.equal(layout.offsets[0], 0.0)
    t.equal(layout.offsets[1], layout.widths[0])
    t.equal(layout.gutter, 7.0 + 16.0)
    t.equal(layout.view_height, 126.0 - sheet_header_height - sheet_bar_width)
}

fn test_a_resized_column_replaces_its_width_within_the_limits(t: *testing.T) {
    var state = sheet_sized(sheet_state(), 1, 120.0)
    t.equal(laid_out(state, sample_source()).widths[1], 120.0)
    state = sheet_sized(state, 1, 5.0)
    t.equal(laid_out(state, sample_source()).widths[1], sheet_narrowest_width)
    state = sheet_sized(state, 1, 9000.0)
    t.equal(laid_out(state, sample_source()).widths[1], sheet_widest_width)
    t.is_true(sheet_is_sized(state, 1))
    state = sheet_unsized(state, 1)
    t.is_false(sheet_is_sized(state, 1))
}

fn test_dragging_an_edge_grows_the_column_by_the_distance_moved(t: *testing.T) {
    let source = sample_source()
    var state = sheet_state()
    let layout = laid_out(state, source)
    let before = layout.widths[0]
    state = sheet_resize_started(state, layout, 0, 100.0)
    state = sheet_resize_dragged(state, 130.0)
    t.equal(laid_out(state, source).widths[0], before + 30.0)
    state = sheet_resize_dragged(state, 0.0)
    t.equal(laid_out(state, source).widths[0], sheet_narrowest_width)
    state = sheet_released(state)
    t.is_none(state.resize)
}

fn test_the_hit_test_tells_header_gutter_edges_and_cells_apart(t: *testing.T) {
    let source = sample_source()
    let state = sheet_state()
    let layout = laid_out(state, source)
    let edge = layout.gutter + layout.widths[0] - 1.0
    match sheet_hit(state, layout, 2.0, 2.0) {
        Corner => {}
        _ => t.error("the corner was not the corner")
    }
    match sheet_hit(state, layout, layout.gutter + 5.0, 2.0) {
        Column(index) => t.equal(index, 0)
        _ => t.error("the header was not a column")
    }
    match sheet_hit(state, layout, edge, 2.0) {
        Edge(index) => t.equal(index, 0)
        _ => t.error("the edge was not an edge")
    }
    match sheet_hit(state, layout, 3.0, sheet_header_height + 30.0) {
        Row(index) => t.equal(index, 1)
        _ => t.error("the gutter was not a row")
    }
    match sheet_hit(state, layout, layout.gutter + layout.widths[0] + 4.0, sheet_header_height + 30.0) {
        Cell(row, column) => {
            t.equal(row, 1)
            t.equal(column, 1)
        }
        _ => t.error("the body was not a cell")
    }
    match sheet_hit(state, layout, layout.gutter + 5.0, sheet_header_height + 22.0 * 3.0 + 5.0) {
        Nothing => {}
        _ => t.error("a point under the last row was a cell")
    }
    match sheet_hit(state, layout, -1.0, 5.0) {
        Nothing => {}
        _ => t.error("a point outside was hit")
    }
}

fn test_the_hit_test_follows_the_scroll(t: *testing.T) {
    let source = big_source(1000, 30)
    var state = sheet_state()
    state.top = 22.0 * 100.0 + 5.0
    state.left = 50.0
    let layout = sheet_layout(state, source, 7.0, geometry.size(400.0, 200.0))
    match sheet_hit(state, layout, layout.gutter + 10.0, sheet_header_height + 1.0) {
        Cell(row, column) => {
            t.equal(row, 100)
            t.equal(column, 1)
        }
        _ => t.error("no cell under the corner of the cells")
    }
}

fn test_the_nearest_cell_clamps_a_point_outside_the_cells(t: *testing.T) {
    let source = sample_source()
    let state = sheet_state()
    let layout = laid_out(state, source)
    let far = sheet_nearest(state, layout, 9000.0, 9000.0) ?? return t.fatal("no cell")
    t.equal(far.row, 2)
    t.equal(far.column, 2)
    let near_corner = sheet_nearest(state, layout, -50.0, -50.0) ?? return t.fatal("no cell")
    t.equal(near_corner.row, 0)
    t.equal(near_corner.column, 0)
}

fn test_a_point_past_an_edge_scrolls_a_step_in_that_direction(t: *testing.T) {
    let layout = laid_out(sheet_state(), sample_source())
    let down = sheet_edge_shift(layout, 100.0, 9000.0)
    t.equal(down.y, 22.0)
    t.equal(down.x, 0.0)
    let left_up = sheet_edge_shift(layout, 2.0, 3.0)
    t.equal(left_up.x, -40.0)
    t.equal(left_up.y, -22.0)
    let inside = sheet_edge_shift(layout, 100.0, 60.0)
    t.equal(inside.x, 0.0)
    t.equal(inside.y, 0.0)
}

fn test_the_wheel_moves_the_cells_a_pixel_at_a_time_and_stays_inside_the_content(t: *testing.T) {
    let source = big_source(1000, 30)
    let layout = sheet_layout(sheet_state(), source, 7.0, geometry.size(400.0, 200.0))
    var state = sheet_wheeled(sheet_state(), layout, 12.0, 7.0)
    t.equal(state.top, 7.0)
    t.equal(state.left, 12.0)
    t.equal(sheet_first_row(state), 0)
    t.equal(sheet_row_shift(state), 7.0)
    state = sheet_wheeled(state, layout, -900.0, -900.0)
    t.equal(state.top, 0.0)
    t.equal(state.left, 0.0)
    state = sheet_wheeled(state, layout, 900000.0, 99999999.0)
    t.equal(state.top, sheet_max_top(layout))
    t.equal(state.left, sheet_max_left(layout))
}

fn test_a_million_rows_scroll_to_the_last_row_without_losing_a_pixel(t: *testing.T) {
    let source = big_source(1000000, 5)
    let layout = sheet_layout(sheet_state(), source, 7.0, geometry.size(400.0, 200.0))
    var state = sheet_wheeled(sheet_state(), layout, 0.0, 99999999999.0)
    t.equal(state.top, 22000000.0 - 200.0 + f64(sheet_header_height) + f64(sheet_bar_width))
    t.equal(sheet_first_row(state), 999992)
    state = sheet_wheeled(sheet_state(), layout, 0.0, 22.0 * 500000.0 + 7.0)
    t.equal(sheet_first_row(state), 500000)
    t.equal(sheet_row_shift(state), 7.0)
}

fn test_revealing_scrolls_just_far_enough(t: *testing.T) {
    let source = big_source(1000, 30)
    let layout = sheet_layout(sheet_state(), source, 7.0, geometry.size(400.0, 200.0))
    var state = sheet_moved(sheet_state(), 50, 0, 1000, 30, false)
    state = sheet_revealed(state, layout)
    t.equal(state.top, 22.0 * 50.0 + 22.0 - f64(layout.view_height))
    state = sheet_moved(state, -50, 0, 1000, 30, false)
    state = sheet_revealed(state, layout)
    t.equal(state.top, 0.0)
    state = sheet_moved(state, 0, 12, 1000, 30, false)
    state = sheet_revealed(state, layout)
    t.equal(state.left, layout.offsets[12] + layout.widths[12] - layout.view_width)
}

fn test_the_page_is_the_rows_shown_less_one(t: *testing.T) {
    let layout = sheet_layout(sheet_state(), big_source(1000, 3), 7.0, geometry.size(400.0, 200.0))
    t.equal(sheet_rows_shown(layout), 8)
    t.equal(sheet_page(layout), 7)
    let tiny = sheet_layout(sheet_state(), big_source(1000, 3), 7.0, geometry.size(400.0, 10.0))
    t.equal(sheet_page(tiny), 1)
}

fn test_visible_columns_are_the_ones_reaching_into_the_viewport(t: *testing.T) {
    let source = big_source(10, 30)
    var state = sheet_state()
    state.left = 200.0
    let layout = sheet_layout(state, source, 7.0, geometry.size(400.0, 200.0))
    let first = sheet_first_column(state, layout)
    let end = sheet_end_column(state, layout, first)
    t.is_true(layout.offsets[first] + layout.widths[first] > 200.0)
    t.is_true(first == 0 || layout.offsets[first - 1] + layout.widths[first - 1] <= 200.0)
    t.is_true(layout.offsets[end - 1] < 200.0 + layout.view_width)
    t.is_true(end == 30 || layout.offsets[end] >= 200.0 + layout.view_width)
}

fn test_the_sort_cycles_ascending_descending_then_off_and_restarts_on_another_column(t: *testing.T) {
    var state = sheet_sort_cycled(sheet_state(), 1)
    let up = state.sort ?? return t.fatal("no sort")
    t.equal(up.column, 1)
    t.is_false(up.descending)
    state = sheet_sort_cycled(state, 1)
    let down = state.sort ?? return t.fatal("no sort")
    t.is_true(down.descending)
    state = sheet_sort_cycled(state, 1)
    t.is_none(state.sort)
    state = sheet_sort_cycled(sheet_sort_cycled(state, 1), 2)
    let other = state.sort ?? return t.fatal("no sort")
    t.equal(other.column, 2)
    t.is_false(other.descending)
}

fn test_numbers_sort_by_value_text_by_lower_case_and_missing_values_stay_last(t: *testing.T) {
    let table = SheetTable {
        columns: ["n", "s"]
        numeric: [true, false]
        rows: [
            ["10", "banana"]
            ["9", "Apple"]
            [none, none]
            ["x", "cherry"]
            ["-3", "apple"]
        ]
    }
    t.equal_slice(sheet_table_order(table, SheetSort { column: 0, descending: false }), [4, 1, 0, 3, 2])
    t.equal_slice(sheet_table_order(table, SheetSort { column: 0, descending: true }), [3, 0, 1, 4, 2])
    t.equal_slice(sheet_table_order(table, SheetSort { column: 1, descending: false }), [1, 4, 0, 3, 2])
    t.equal_slice(sheet_table_order(table, SheetSort { column: 1, descending: true }), [3, 0, 1, 4, 2])
    t.equal_slice(sheet_table_order(table, none), [0, 1, 2, 3, 4])
}

fn test_a_sorted_source_reads_rows_in_the_sorted_order(t: *testing.T) {
    let table = sample_table()
    let order = sheet_table_order(table, SheetSort { column: 0, descending: true })
    let page = sheet_table_source(table, order).read(0, 2, 0, 1)
    t.equal(page.rows[0][0] ?? "", "3")
    t.equal(page.rows[1][0] ?? "", "2")
}

fn test_a_copy_reads_the_stored_rows_when_the_source_has_rows_drawn_over_them(t: *testing.T) {
    let stored = sample_source()
    var drawn = stored
    drawn.total = stored.total + 2
    drawn.read = fn(first: i64, end: i64, first_column: i64, end_column: i64) -> SheetPage {
        let page = stored.read(first, end, first_column, end_column)
        var rows: str?[][] = []
        for _ in page.rows {
            rows.push([some("drawn"), some("drawn")])
        }
        SheetPage { first: page.first, first_column: page.first_column, rows, failure: page.failure }
    }
    drawn.stored = some(SheetStored { total: stored.total, read: stored.read })
    let copied = sheet_copied_source(drawn)
    t.equal(copied.total, stored.total)
    let block = sheet_block_within(sheet_whole(drawn.total, 2), copied.total)
    t.equal(block.end_row, stored.total)
    t.equal(sheet_block_text(copied, SheetBlock { first_row: 0, end_row: 1, first_column: 0, end_column: 2 }, false).text, "1	plain")
    t.equal(sheet_copied_source(stored).total, stored.total)
}

fn test_a_block_copies_as_tab_separated_lines_with_or_without_headers(t: *testing.T) {
    let source = sample_source()
    let block = SheetBlock { first_row: 1, end_row: 3, first_column: 1, end_column: 3 }
    t.equal(sheet_block_text(source, block, false).text, "says \"hi\", twice\r\nthen stops\tNULL\r\nNULL\t007")
    let headed = SheetBlock { first_row: 0, end_row: 1, first_column: 0, end_column: 2 }
    t.equal(sheet_block_text(source, headed, true).text, "id\tnote\r\n1\tplain")
}

fn test_rows_copy_as_named_fields_separated_by_a_blank_line(t: *testing.T) {
    let copied = sheet_records_text(sample_source(), 0, 2)
    t.equal(copied.text, "id: 1\r\nnote: plain\r\namount: 10.50\r\n\r\nid: 2\r\nnote: says \"hi\", twice\r\nthen stops\r\namount: NULL")
    t.is_none(copied.failure)
}

fn test_copying_reads_in_pages_and_reports_a_failed_read(t: *testing.T) {
    let big = big_source(3000, 2)
    let all = sheet_block_text(big, sheet_whole(3000, 2), false)
    var expected: i64 = 2 * 2999
    for row in 0..3000 {
        expected += 2 * ("{row}").len + 1
    }
    t.equal(all.text.len, expected)
    let failing = SheetSource {
        columns: ["a"]
        widths: [4]
        numeric: [false]
        total: 5
        read: fn(first: i64, end: i64, first_column: i64, end_column: i64) -> SheetPage {
            SheetPage { first, first_column, rows: [], failure: "the rows could not be read" }
        }
    }
    let result = sheet_block_text(failing, sheet_whole(5, 1), false)
    t.equal(result.failure ?? "", "the rows could not be read")
}

fn test_a_cell_folds_to_one_line_and_is_cut_with_an_ellipsis(t: *testing.T) {
    t.equal(sheet_clip("  one\r\n   two\tthree", 40), "one two three")
    t.equal(sheet_clip("abcdefghij", 5), "abcd…")
    t.equal(sheet_clip("abcde", 5), "abcde")
    t.equal(sheet_clip("abc", 1), "…")
    t.equal(sheet_clip("héllo wörld", 6), "héllo…")
    t.equal(sheet_folded_length("a\r\n  b"), 3)
}

fn test_fitting_measures_the_widest_cell_and_never_less_than_the_header(t: *testing.T) {
    let source = sample_source()
    t.equal(sheet_fitted(source, 0, 0, 3), 4)
    t.equal(sheet_fitted(source, 1, 0, 3), 27)
    t.equal(sheet_fitted(source, 1, 0, 1), 6)
    t.equal(sheet_fitted(source, 2, 1, 2), 8)
}

fn test_values_are_shown_as_json_xml_binary_or_text(t: *testing.T) {
    let json = sheet_presented("{{\"a\":[1,2]}}")
    t.equal(json.kind, "JSON")
    t.equal(json.text, "{{\n  \"a\": [\n    1,\n    2\n  ]\n}}")
    let binary = sheet_presented("\\x48656c6c6f")
    t.equal(binary.kind, "Binary")
    t.equal(binary.text, "00000000  48 65 6c 6c 6f")
    let broken = sheet_presented("{{not json")
    t.equal(broken.kind, "Text")
    t.equal(broken.text, "{{not json")
    let missing = sheet_presented(none)
    t.equal(missing.kind, "NULL")
    t.equal(missing.text, "NULL")
    let xml = sheet_presented("<a x=\"1\"><b>text</b><c/><!-- note --></a>")
    t.equal(xml.kind, "XML")
    t.equal(xml.text, "<a x=\"1\">\n  <b>text</b>\n  <c/>\n  <!-- note -->\n</a>")
    let unbalanced = sheet_presented("<a><b></a>")
    t.equal(unbalanced.kind, "Text")
}

fn test_a_long_value_is_cut_to_fifty_thousand_characters_with_a_note(t: *testing.T) {
    let short = "short"
    t.equal(sheet_shown(short), short)
    var long = ""
    for chunk in 0..51 {
        long = "{long}{thousand_characters()}"
    }
    let shown = sheet_shown(long)
    t.is_true(shown.len > 50000)
    t.is_true(shown.len < long.len)
    t.is_true(text.contains(shown, "Showing the first 50,000 characters"))
}

fn thousand_characters() -> str {
    text.repeat("0123456789", 100)
}

fn test_a_value_title_counts_rows_from_one(t: *testing.T) {
    t.equal(sheet_value_title("note", 0, "Text", 5), "note · row 1 · Text · 5 characters")
}

fn test_counts_are_grouped_and_pluralised(t: *testing.T) {
    t.equal(sheet_grouped(1234567), "1,234,567")
    t.equal(sheet_grouped(12), "12")
    t.equal(sheet_plural(1, "row"), "1 row")
    t.equal(sheet_plural(2500, "row"), "2,500 rows")
}

fn test_a_very_long_cell_is_clipped_without_reading_all_of_it(t: *testing.T) {
    var long = ""
    for _ in 0..2000 {
        long = "{long}0123456789"
    }
    t.equal(sheet_clip(long, 8), "0123456…")
}

fn test_a_scrollbar_exists_only_for_an_axis_that_scrolls(t: *testing.T) {
    let narrow = big_source(1000, 3)
    let layout = sheet_layout(sheet_state(), narrow, 7.0, grid_size())
    t.is_some(sheet_thumb(sheet_state(), layout, SheetAxis.Vertical))
    t.is_none(sheet_thumb(sheet_state(), layout, SheetAxis.Horizontal))
    let wide = big_source(3, 60)
    let across = sheet_layout(sheet_state(), wide, 7.0, grid_size())
    t.is_none(sheet_thumb(sheet_state(), across, SheetAxis.Vertical))
    t.is_some(sheet_thumb(sheet_state(), across, SheetAxis.Horizontal))
}

fn test_the_thumb_runs_the_length_of_its_strip_as_the_content_scrolls(t: *testing.T) {
    let source = big_source(1000, 3)
    let layout = sheet_layout(sheet_state(), source, 7.0, grid_size())
    let top = sheet_thumb(sheet_state(), layout, SheetAxis.Vertical) ?? panic("scrolls")
    t.equal(top.thumb.y, top.track.y)
    t.equal(top.thumb.height, 24.0)
    t.equal(top.track.x, layout.width - sheet_bar_width)
    t.equal(top.track.height, layout.view_height)
    let end = sheet_wheeled(sheet_state(), layout, 0.0, 99999999.0)
    let bottom = sheet_thumb(end, layout, SheetAxis.Vertical) ?? panic("scrolls")
    t.equal(bottom.thumb.y + bottom.thumb.height, bottom.track.y + bottom.track.height)
}

fn test_a_thumb_grows_with_the_share_of_the_content_in_view(t: *testing.T) {
    let size = geometry.size(400.0, 400.0)
    let few = sheet_layout(sheet_state(), big_source(30, 3), 7.0, size)
    let many = sheet_layout(sheet_state(), big_source(2000, 3), 7.0, size)
    let short = sheet_thumb(sheet_state(), few, SheetAxis.Vertical) ?? panic("scrolls")
    let long = sheet_thumb(sheet_state(), many, SheetAxis.Vertical) ?? panic("scrolls")
    t.is_true(short.thumb.height > long.thumb.height)
    t.is_true(short.thumb.height < few.view_height)
}

fn test_a_scrollbar_is_near_its_strip_and_a_little_inside_the_cells(t: *testing.T) {
    let layout = sheet_layout(sheet_state(), big_source(1000, 3), 7.0, grid_size())
    let strip = layout.width - sheet_bar_width
    t.is_true((sheet_bar_near(sheet_state(), layout, strip + 4.0, 60.0) ?? SheetAxis.Horizontal) == SheetAxis.Vertical)
    t.is_true((sheet_bar_near(sheet_state(), layout, strip - 5.0, 60.0) ?? SheetAxis.Horizontal) == SheetAxis.Vertical)
    t.is_none(sheet_bar_near(sheet_state(), layout, strip - 7.0, 60.0))
    t.is_none(sheet_bar_near(sheet_state(), layout, strip + 4.0, 10.0))
}

fn test_dragging_the_thumb_follows_the_pointer_and_clamps_at_both_ends(t: *testing.T) {
    let layout = sheet_layout(sheet_state(), big_source(1000000, 3), 7.0, grid_size())
    let x = layout.width - 5.0
    let bar = sheet_thumb(sheet_state(), layout, SheetAxis.Vertical) ?? panic("scrolls")
    var state = sheet_bar_pressed(sheet_state(), layout, x, bar.thumb.y + 5.0) ?? panic("on the bar")
    t.equal(state.top, 0.0)
    t.is_some(state.grab)
    state = sheet_bar_dragged(state, layout, x, bar.thumb.y + 5.0 + (bar.track.height - bar.thumb.height) / 2.0)
    let half = sheet_max_top(layout) / 2.0
    t.is_true(state.top > half - 1.0 && state.top < half + 1.0)
    state = sheet_bar_dragged(state, layout, x, 9999.0)
    t.equal(state.top, sheet_max_top(layout))
    state = sheet_bar_dragged(state, layout, x, -9999.0)
    t.equal(state.top, 0.0)
    state = sheet_released(state)
    t.is_none(state.grab)
    t.equal(sheet_bar_dragged(state, layout, x, 100.0).top, 0.0)
}

fn test_a_press_on_the_strip_beside_the_thumb_centres_the_thumb_on_the_pointer(t: *testing.T) {
    let layout = sheet_layout(sheet_state(), big_source(1000, 3), 7.0, grid_size())
    let x = layout.width - 5.0
    let y = sheet_header_height + layout.view_height / 2.0
    let state = sheet_bar_pressed(sheet_state(), layout, x, y) ?? panic("on the bar")
    let bar = sheet_thumb(state, layout, SheetAxis.Vertical) ?? panic("scrolls")
    t.is_true(near_pixel(bar.thumb.y + bar.thumb.height / 2.0, y))
}

fn test_the_horizontal_thumb_scrolls_across_only(t: *testing.T) {
    let layout = sheet_layout(sheet_state(), big_source(1000, 60), 7.0, grid_size())
    let bar = sheet_thumb(sheet_state(), layout, SheetAxis.Horizontal) ?? panic("scrolls")
    let y = layout.height - 5.0
    var state = sheet_bar_pressed(sheet_state(), layout, bar.thumb.x + 3.0, y) ?? panic("on the bar")
    state = sheet_bar_dragged(state, layout, bar.thumb.x + 3.0 + 50.0, y)
    t.is_true(state.left > 0.0)
    t.equal(state.top, 0.0)
    state = sheet_bar_dragged(state, layout, 99999.0, y)
    t.equal(state.left, sheet_max_left(layout))
}

fn near_pixel(got: f32, want: f32) -> bool {
    got > want - 1.0 && got < want + 1.0
}
