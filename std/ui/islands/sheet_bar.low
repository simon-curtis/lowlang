import std/ui/geometry

const sheet_thumb_least: f32 = 24.0
const sheet_bar_reach: f32 = 6.0

/// Which scrollbar of a sheet.
pub enum SheetAxis {
    /// The scrollbar down the right edge.
    Vertical
    /// The scrollbar along the bottom edge.
    Horizontal
}

/// A thumb held by the pointer: its bar, and how far into the thumb the pointer took hold.
pub struct SheetGrab {
    /// The bar being held.
    pub axis: SheetAxis
    /// The distance in pixels from the start of the thumb to where the pointer took hold.
    pub offset: f32
}

/// One scrollbar as drawn: the strip it runs in, the thumb inside it, and how far the content scrolls.
pub struct SheetThumb {
    /// The bar this thumb belongs to.
    pub axis: SheetAxis
    /// The strip the bar runs in, measured from the sheet's top left corner.
    pub track: geometry.Rect
    /// The thumb inside the track, measured from the sheet's top left corner.
    pub thumb: geometry.Rect
    /// The furthest the content scrolls along the bar, in pixels.
    pub most: f64
}

fn sheet_track(layout: SheetLayout, axis: SheetAxis) -> geometry.Rect {
    match axis {
        Vertical => geometry.Rect { x: layout.width - sheet_bar_width, y: sheet_header_height, width: sheet_bar_width, height: layout.view_height }
        Horizontal => geometry.Rect { x: layout.gutter, y: layout.height - sheet_bar_width, width: layout.view_width, height: sheet_bar_width }
    }
}

fn sheet_most_scroll(layout: SheetLayout, axis: SheetAxis) -> f64 {
    match axis {
        Vertical => sheet_max_top(layout)
        Horizontal => f64(sheet_max_left(layout))
    }
}

fn sheet_scroll_of(state: SheetState, axis: SheetAxis) -> f64 {
    match axis {
        Vertical => state.top
        Horizontal => f64(state.left)
    }
}

fn sheet_along(rect: geometry.Rect, axis: SheetAxis) -> f32 {
    match axis {
        Vertical => rect.height
        Horizontal => rect.width
    }
}

fn sheet_begins(rect: geometry.Rect, axis: SheetAxis) -> f32 {
    match axis {
        Vertical => rect.y
        Horizontal => rect.x
    }
}

fn sheet_thumb_length(length: f32, most: f64) -> f32 {
    let share = f64(length) * (f64(length) / (f64(length) + most))
    let sized = f32(share)
    if sized < sheet_thumb_least {
        return if sheet_thumb_least < length { sheet_thumb_least } else { length }
    }
    if sized > length { length } else { sized }
}

/// The scrollbar of `axis`, or `none` while the content fits and there is nothing to scroll.
pub fn sheet_thumb(state: SheetState, layout: SheetLayout, axis: SheetAxis) -> SheetThumb? {
    let most = sheet_most_scroll(layout, axis)
    if most <= 0.0 {
        return none
    }
    let track = sheet_track(layout, axis)
    let length = sheet_along(track, axis)
    let thumb_length = sheet_thumb_length(length, most)
    let progress = sheet_scroll_of(state, axis) / most
    let start = f32(f64(length - thumb_length) * progress)
    var thumb = track
    match axis {
        Vertical => {
            thumb.y = track.y + start
            thumb.height = thumb_length
        }
        Horizontal => {
            thumb.x = track.x + start
            thumb.width = thumb_length
        }
    }
    SheetThumb { axis, track, thumb, most }
}

fn sheet_in_rect(rect: geometry.Rect, x: f32, y: f32) -> bool {
    x >= rect.x && x < rect.x + rect.width && y >= rect.y && y < rect.y + rect.height
}

fn sheet_near_bar(bar: SheetThumb, x: f32, y: f32) -> bool {
    var reach = bar.track
    match bar.axis {
        Vertical => {
            reach.x = bar.track.x - sheet_bar_reach
            reach.width = bar.track.width + sheet_bar_reach
        }
        Horizontal => {
            reach.y = bar.track.y - sheet_bar_reach
            reach.height = bar.track.height + sheet_bar_reach
        }
    }
    sheet_in_rect(reach, x, y)
}

/// The scrollbar a point lies on or within reach of, measured from the sheet's top left corner.
pub fn sheet_bar_near(state: SheetState, layout: SheetLayout, x: f32, y: f32) -> SheetAxis? {
    match sheet_thumb(state, layout, SheetAxis.Vertical) {
        some(bar) => {
            if sheet_near_bar(bar, x, y) {
                return SheetAxis.Vertical
            }
        }
        none => {}
    }
    match sheet_thumb(state, layout, SheetAxis.Horizontal) {
        some(bar) => {
            if sheet_near_bar(bar, x, y) {
                return SheetAxis.Horizontal
            }
        }
        none => {}
    }
    none
}

fn sheet_pointer_along(axis: SheetAxis, x: f32, y: f32) -> f32 {
    match axis {
        Vertical => y
        Horizontal => x
    }
}

fn sheet_grab_of(bar: SheetThumb, x: f32, y: f32) -> SheetGrab {
    let at = sheet_pointer_along(bar.axis, x, y)
    if sheet_in_rect(bar.thumb, x, y) {
        return SheetGrab { axis: bar.axis, offset: at - sheet_begins(bar.thumb, bar.axis) }
    }
    SheetGrab { axis: bar.axis, offset: sheet_along(bar.thumb, bar.axis) / 2.0 }
}

fn sheet_scrolled_by_bar(state: SheetState, layout: SheetLayout, grab: SheetGrab, x: f32, y: f32) -> SheetState {
    let bar = sheet_thumb(state, layout, grab.axis) ?? return state
    let travel = sheet_along(bar.track, grab.axis) - sheet_along(bar.thumb, grab.axis)
    if travel <= 0.0 {
        return state
    }
    let start = sheet_pointer_along(grab.axis, x, y) - grab.offset - sheet_begins(bar.track, grab.axis)
    var share = f64(start) / f64(travel)
    if share < 0.0 {
        share = 0.0
    } else if share > 1.0 {
        share = 1.0
    }
    var next = state
    match grab.axis {
        Vertical => {
            next.top = bar.most * share
        }
        Horizontal => {
            next.left = f32(bar.most * share)
        }
    }
    sheet_clamped(next, layout)
}

/// A press at `x`, `y`: when it lands on a scrollbar, the state holding that thumb and scrolled to the pointer, which on the strip beside the thumb centres the thumb on it.
pub fn sheet_bar_pressed(state: SheetState, layout: SheetLayout, x: f32, y: f32) -> SheetState? {
    let axis = sheet_bar_near(state, layout, x, y) ?? return none
    let bar = sheet_thumb(state, layout, axis) ?? return none
    let grab = sheet_grab_of(bar, x, y)
    var held = state
    held.grab = grab
    sheet_scrolled_by_bar(held, layout, grab, x, y)
}

/// The state with the held thumb followed to the pointer, or unchanged when no thumb is held.
pub fn sheet_bar_dragged(state: SheetState, layout: SheetLayout, x: f32, y: f32) -> SheetState {
    let grab = state.grab ?? return state
    sheet_scrolled_by_bar(state, layout, grab, x, y)
}
