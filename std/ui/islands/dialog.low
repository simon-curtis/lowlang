import std/ui
import std/ui/geometry
import std/ui/platform

const confirm_width: f32 = 480.0
const confirm_detail_height: f32 = 240.0

/// What a dialog card is called, how wide it is, what it asks and the name and label of the button that answers yes.
pub struct ActionCard {
    /// The name of the dialog, which its card id `{id}-card` is built from.
    pub id: str
    /// The width of the card, in pixels.
    pub width: f32
    /// The heading of the card.
    pub title: str
    /// The label of the button that answers yes.
    pub verb: str
    /// The element id of the button that answers yes.
    pub verb_id: str
}

/// Text in a control-coloured box in the code font, as tall as its text up to 240 pixels.
pub fn preview_box(t: Theme, content: str) -> ui.Element {
    preview_box_in(t, content, t.text)
}

/// The same box with its text in `colour`, such as the faint colour of text still waiting for its fields.
pub fn preview_box_in(t: Theme, content: str, colour: geometry.Color) -> ui.Element {
    ui.div().max_height(confirm_detail_height).overflow_hidden().padding(step(2.0)).rounded(radius).background(t.control).font_family(code_font).text_size(small_size).text_color(colour).child(ui.text(content).wrapping())
}

/// A popover card with a heading, `body` and a Cancel button beside the button that answers yes. Enter answers yes; the card takes no focus itself, so the dialog opens on the first focusable element of `body`; both buttons close the dialog before they call `confirmed` or `dismissed`.
pub fn action_card(cx: ui.Context, t: Theme, card: ActionCard, body: ui.Element[], confirmed: fn(), dismissed: fn()) -> ui.Element {
    let confirm = fn() {
        ui.close_overlay(cx, card.id)
        confirmed()
    }
    let cancel = fn() {
        ui.close_overlay(cx, card.id)
        dismissed()
    }
    let heading = ui.text(card.title).text_size(heading_size).font_weight(semibold)
    let actions = ui.row(ui.div()).justify_end().gap(step(2.0)).child(button(t, "dialog-cancel", "Cancel", Secondary, cancel)).child(button(t, card.verb_id, card.verb, Primary, confirm))
    var parts: ui.Element[] = [heading]
    for part in body {
        parts.push(part)
    }
    parts.push(actions)
    ui.column(popover(t)).id("{card.id}-card").width(card.width).shrink(0.0).padding(step(5.0)).gap(step(3.0)).text_color(t.text).text_size(body_size).font_family(ui_font).on_key(enter_key(confirm)).children(parts)
}

fn confirm_card(cx: ui.Context, t: Theme, id: str, title: str, detail: str, verb: str, confirmed: fn(), dismissed: fn()) -> ui.Element {
    let card = ActionCard { id, width: confirm_width, title, verb, verb_id: "dialog-confirm" }
    action_card(cx, t, card, [preview_box(t, detail)], confirmed, dismissed).focusable()
}

/// The default width of a form card, in pixels.
pub const form_card_width: f32 = 560.0
const form_card_fields_height: f32 = 420.0

/// What a form card is called, how wide it is, the button that runs it and whether it can run yet, the text its fields make, a note that stands under it while nothing has failed and why the last run failed. A `draft` preview is drawn in the faint colour.
pub struct FormCard {
    /// The name of the dialog, which its card id `{id}-card` is built from.
    pub id: str
    /// The heading of the card.
    pub title: str
    /// The width of the card, in pixels. Defaults to `form_card_width`.
    pub width: f32 = form_card_width
    /// The label of the button that runs the form.
    pub verb: str
    /// The element id of the button that runs the form.
    pub verb_id: str
    /// Whether the form can run yet. While it is `false` the button is drawn unavailable and running the form calls `refused` in place of `confirmed`. Defaults to `true`.
    pub ready: bool = true
    /// The text the fields make, shown under them in a box in the code font. Defaults to empty, which leaves the box out.
    pub preview: str = ""
    /// Whether `preview` is still waiting for its fields, which draws it in the faint colour. Defaults to `false`.
    pub draft: bool = false
    /// A note drawn under the fields while nothing has failed. Defaults to `none`.
    pub note: str? = none
    /// Why the last run failed, drawn under the fields in place of `note`. Defaults to `none`.
    pub failure: str? = none
    /// Called when Enter or the button runs the form while `ready` is `false`. Defaults to `none`, which does nothing.
    pub refused: fn()? = none
}

/// A popover card for a form: a heading, `fields` in a column that scrolls once taller than 420 pixels, the text they make, the reason the last run failed, and Cancel beside the button that runs it. Enter runs it while it is ready, and calls `refused` when it is not. Cancel closes the dialog before it calls `dismissed`; `confirmed` closes it when it chooses, so a failure can stay on the card.
pub fn form_card(cx: ui.Context, t: Theme, card: FormCard, fields: ui.Element[], confirmed: fn(), dismissed: fn()) -> ui.Element {
    let cancel = fn() {
        ui.close_overlay(cx, card.id)
        dismissed()
    }
    let run = fn() {
        if card.ready {
            confirmed()
            return
        }
        match card.refused {
            some(refuse) => refuse()
            none => {}
        }
    }
    let heading = ui.text(card.title).text_size(heading_size).font_weight(semibold)
    let column = ui.column(ui.div()).id("{card.id}-fields").max_height(form_card_fields_height).overflow_y_scroll().gap(step(3.0)).children(fields).scrollbar(scrollbars(t))
    var parts: ui.Element[] = [heading, column]
    if card.preview != "" {
        parts.push(preview_box_in(t, card.preview, if card.draft { t.faint } else { t.text }))
    }
    match card.failure {
        some(reason) => parts.push(form_failure(t, reason))
        none => {
            match card.note {
                some(note) => parts.push(form_note(t, note))
                none => {}
            }
        }
    }
    let kind = if card.ready { ButtonKind.Primary } else { ButtonKind.Unavailable }
    parts.push(ui.row(ui.div()).justify_end().gap(step(2.0)).child(button(t, "dialog-cancel", "Cancel", Secondary, cancel)).child(button(t, card.verb_id, card.verb, kind, run)))
    ui.column(popover(t)).id("{card.id}-card").width(card.width).shrink(1.0).padding(step(5.0)).gap(step(3.0)).text_color(t.text).text_size(body_size).font_family(ui_font).on_key(enter_key(run)).children(parts)
}

/// Opens a dialog called `id` that asks `title` over `detail`, shown in a box in the code font, with Cancel beside a button labelled `verb`. The button and Enter call `confirmed`, Cancel calls `dismissed`, and each closes the dialog first. The card takes the focus, so Enter answers at once.
pub fn open_confirm_dialog(cx: ui.Context, t: Theme, id: str, title: str, detail: str, verb: str, confirmed: fn(), dismissed: fn()) {
    ui.open_dialog(cx, id, fn() -> ui.Element { confirm_card(cx, t, id, title, detail, verb, confirmed, dismissed) })
}

/// Returns a key handler that calls `act` when Escape is pressed and lets every other key through.
pub fn escape_key(act: fn()) -> fn(platform.KeyEvent) -> bool {
    fn(k: platform.KeyEvent) -> bool {
        if !k.pressed {
            return false
        }
        match k.key {
            Named(named) => {
                match named {
                    Escape => {
                        act()
                        true
                    }
                    _ => false
                }
            }
            Character(text) => false
        }
    }
}

/// Returns a key handler that calls `act` when Enter is pressed and lets every other key through.
pub fn enter_key(act: fn()) -> fn(platform.KeyEvent) -> bool {
    fn(k: platform.KeyEvent) -> bool {
        if !k.pressed {
            return false
        }
        match k.key {
            Named(named) => {
                match named {
                    Enter => {
                        act()
                        true
                    }
                    _ => false
                }
            }
            Character(text) => false
        }
    }
}
