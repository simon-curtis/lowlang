import std/hash
import std/math
import std/ui
import uitext = std/ui/text

const full_turn: f32 = 6.2832

struct Tint {
    red: f32
    green: f32
    blue: f32
}

struct Swirl {
    twist: f32
    angle: f32
    frequency: f32
    warp: f32
    warp_frequency: f32
    phase: f32
    ribbon_frequency: f32
    ribbon_phase: f32
}

struct Palette {
    base: Tint
    second: Tint
    deep: Tint
}

fn sine(x: f32) -> f32 {
    f32(math.sin(f64(x)))
}

fn cosine(x: f32) -> f32 {
    f32(math.cos(f64(x)))
}

fn clamped(x: f32) -> f32 {
    if x < 0.0 {
        return 0.0
    }
    if x > 1.0 {
        return 1.0
    }
    x
}

fn tint_of(colour: u32) -> Tint {
    Tint { red: f32((colour >> 16) & 0xff) / 255.0, green: f32((colour >> 8) & 0xff) / 255.0, blue: f32(colour & 0xff) / 255.0 }
}

fn mixed(a: Tint, b: Tint, t: f32) -> Tint {
    Tint { red: a.red + (b.red - a.red) * t, green: a.green + (b.green - a.green) * t, blue: a.blue + (b.blue - a.blue) * t }
}

fn hue_turned(c: Tint, degrees: f32) -> Tint {
    let turn = degrees * full_turn / 360.0
    let k: f32 = 0.57735
    let c0 = cosine(turn)
    let s0 = sine(turn)
    let grey = k * k * (c.red + c.green + c.blue) * (1.0 - c0)
    Tint {
        red: clamped(c.red * c0 + k * (c.blue - c.green) * s0 + grey),
        green: clamped(c.green * c0 + k * (c.red - c.blue) * s0 + grey),
        blue: clamped(c.blue * c0 + k * (c.green - c.red) * s0 + grey),
    }
}

fn swirl_drawn(n: *Noise) -> Swirl {
    Swirl {
        twist: 1.6 + 2.2 * noise_next(n),
        angle: full_turn * noise_next(n),
        frequency: 2.4 + 1.6 * noise_next(n),
        warp: 0.9 + 0.9 * noise_next(n),
        warp_frequency: 1.8 + 1.4 * noise_next(n),
        phase: full_turn * noise_next(n),
        ribbon_frequency: 1.5 + 1.5 * noise_next(n),
        ribbon_phase: full_turn * noise_next(n),
    }
}

fn palette_drawn(n: *Noise, colour: u32) -> Palette {
    let base = tint_of(colour)
    var shift = 30.0 + 50.0 * noise_next(n)
    if noise_next(n) < 0.5 {
        shift = -shift
    }
    Palette { base, second: hue_turned(base, shift), deep: mixed(base, Tint { red: 0.02, green: 0.02, blue: 0.06 }, 0.35) }
}

fn swirl_at(swirl: Swirl, palette: Palette, u: f32, v: f32, r2: f32, half: f32) -> Tint {
    let turn = swirl.angle + swirl.twist * r2
    let qu = u * cosine(turn) - v * sine(turn)
    let qv = u * sine(turn) + v * cosine(turn)
    let f = sine(swirl.frequency * qu + swirl.warp * sine(swirl.warp_frequency * qv + swirl.phase))
    let c = mixed(palette.deep, palette.base, clamped(0.5 + 1.5 * f))
    let ribbon = sine(swirl.ribbon_frequency * qv + 0.8 * sine(2.1 * qu + swirl.ribbon_phase))
    mixed(c, palette.second, clamped((ribbon - 0.55) * half / 4.0))
}

fn tint_byte(x: f32) -> u8 {
    u8(i64(clamped(x) * 255.0 + 0.5))
}

fn marble_pixels(seed: str, colour: u32, pixels: i64) -> u8[] {
    let n = new(Noise { state: hash.fnv1a_64(bytes(seed)) | 1 })
    let swirl = swirl_drawn(n)
    let palette = palette_drawn(n, colour)
    let half = f32(pixels) / 2.0
    var out: u8[] = []
    for y in 0..pixels {
        let v = (f32(y) + 0.5 - half) / half
        for x in 0..pixels {
            let u = (f32(x) + 0.5 - half) / half
            let r2 = u * u + v * v
            let alpha = clamped((1.0 - sqrt(r2)) * half + 0.5)
            if alpha <= 0.0 {
                out.push(0)
                out.push(0)
                out.push(0)
                out.push(0)
                continue
            }
            let c = swirl_at(swirl, palette, u, v, r2, half)
            out.push(tint_byte(c.red))
            out.push(tint_byte(c.green))
            out.push(tint_byte(c.blue))
            out.push(tint_byte(alpha))
        }
    }
    out
}

fn marble_key(seed: str, colour: u32, pixels: i64) -> str {
    "{seed}|{colour}|{pixels}"
}

/// Returns `art` with the marble of `seed`, `colour` and `edge` made, for `marble` to draw. A marble is a disc of swirled shades of `colour`, an `0xrrggbb` value, whose swirl and second shade come from `seed`, so the same arguments always make the same marble. Marbles are kept by seed, colour and size, and one already made is not made again. Returns `art` unchanged when the context cannot keep the picture.
pub fn art_with_marble(cx: ui.Context, art: Art, seed: str, colour: u32, edge: f32) -> Art {
    let pixels = art_pixels(art, edge)
    let key = marble_key(seed, colour, pixels)
    if art.marbles[key] != none {
        return art
    }
    let next = art
    match ui.add_image(cx, pixels, pixels, marble_pixels(seed, colour, pixels)) {
        some(picture) => {
            next.marbles[key] = picture
        }
        none => {}
    }
    next
}

/// Returns the marble of `seed`, `colour` and `edge` that `art_with_marble` made, `edge` pixels square. While `art` holds none for them, it draws a plain disc of `colour` instead.
pub fn marble(art: Art, seed: str, colour: u32, edge: f32) -> ui.Element {
    match art.marbles[marble_key(seed, colour, art_pixels(art, edge))] {
        some(picture) => ui.image(picture).object_fit(uitext.Fit.Fill).size(edge, edge).shrink(0.0)
        none => ui.div().size(edge, edge).shrink(0.0).rounded(edge / 2.0).background(ui.rgb(colour))
    }
}
