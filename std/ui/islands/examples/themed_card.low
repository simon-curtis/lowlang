import std/ui
import std/ui/geometry
import std/ui/islands
import std/ui/platform

fn card_view(t: islands.Theme, log: ui.Signal[str]) -> fn() -> ui.Element {
    let saved = fn() { ui.set(log, "saved") }
    let cancelled = fn() { ui.set(log, "cancelled") }
    fn() -> ui.Element {
        let heading = ui.text("Settings").text_size(islands.heading_size)
        let actions = ui.row(ui.div()).gap(islands.step(2.0)).child(islands.button(t, "cancel", "Cancel", islands.ButtonKind.Secondary, cancelled)).child(islands.button(t, "save", "Save", islands.ButtonKind.Primary, saved))
        let card = ui.column(islands.island(t)).padding(islands.step(5.0)).gap(islands.step(3.0)).text_color(t.text).child(heading).child(actions)
        ui.column(ui.div()).size(400.0, 200.0).background(t.canvas).padding(islands.float_inset).items_start().child(card)
    }
}

fn hex(c: geometry.Color) -> str {
    "#{geometry.rgb_of(c):x6}"
}

fn click(cx: ui.Context, at: geometry.Rect) {
    let x = at.x + at.width / 2.0
    let y = at.y + at.height / 2.0
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x, y, clicks: 1 }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x, y, clicks: 1 }))
}

/// Lists the colour schemes, draws a card in the teal theme with a Cancel and a Save button, then clicks Save and prints what the card did.
fn main() {
    for s in islands.schemes() {
        print("{s.name}: {hex(ui.rgb(s.accent))}")
    }
    let t = islands.theme("teal")
    print("canvas {hex(t.canvas)}, island {hex(t.surface)}, accent {hex(t.accent)}")

    let cx = ui.headless(t.canvas)
    let log = ui.signal(cx, "")
    let view = card_view(t, log)
    let _ = ui.frame(cx, view, geometry.size(400.0, 200.0), 1.0)
    let save = ui.bounds_of(cx, "save") ?? panic("no save button")
    print("save button {save.height} px high")
    click(cx, save)
    let _ = ui.frame(cx, view, geometry.size(400.0, 200.0), 1.0)
    print(ui.get(log))
}
