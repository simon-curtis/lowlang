import std/text
import std/ui
import std/ui/geometry

/// The gap in pixels between the badge, title and body of an empty state, 6.5.
pub const empty_state_gap: f32 = 6.5
const status_line_height: f32 = 27.0

/// Returns a div filled with `surface`, with a one-pixel `border` and `radius_large` corners.
pub fn card(t: Theme) -> ui.Element {
    ui.div().background(t.surface).border(1.0, t.border).rounded(radius_large)
}

/// Returns a div filled with `surface`, with a one-pixel `island_border` and `radius_large` corners.
pub fn island(t: Theme) -> ui.Element {
    ui.div().background(t.surface).border(1.0, t.island_border).rounded(radius_large)
}

/// Returns a div filled with `raised`, with a one-pixel `border`, `radius_large` corners and the popover shadow.
pub fn popover(t: Theme) -> ui.Element {
    ui.div().background(t.raised).border(1.0, t.border).rounded(radius_large).shadow(popover_shadow())
}

/// Returns a layer that covers its parent in the `scrim` colour, blocks the pointer from reaching what is behind it and centres `dialog`.
pub fn scrim(t: Theme, dialog: ui.Element) -> ui.Element {
    ui.row(ui.div()).id("dialog-scrim").absolute().inset(0.0).occlude().items_center().justify_center().background(t.scrim).child(dialog)
}

/// Returns the side rail: a column `rail_width` wide holding `buttons` centred, 6 pixels apart, below one spacing step of space.
pub fn rail(buttons: ui.Element[]) -> ui.Element {
    let column = ui.column(ui.div()).grow(1.0).items_center().gap(6.0).children(buttons)
    ui.column(ui.div()).width(rail_width).shrink(0.0).child(ui.div().height(step(1.0))).child(column)
}

/// Returns a one-pixel-high horizontal rule in the `border` colour.
pub fn line(t: Theme) -> ui.Element {
    ui.div().height(1.0).shrink(0.0).background(t.border)
}

/// Returns a one-pixel-wide, 16-pixel-high vertical rule in the `border` colour, with one spacing step of room on each side.
pub fn divider(t: Theme) -> ui.Element {
    let stroke = ui.div().size(1.0, 16.0).shrink(0.0).background(t.border)
    ui.row(ui.div()).width(1.0 + 2.0 * step(1.0)).height(16.0).shrink(0.0).justify_center().child(stroke)
}

/// Returns an empty block `margin - gap` pixels high, which tops up a gap the parent already applies to reach `margin`.
pub fn margin_spacer(margin: f32, gap: f32) -> ui.Element {
    ui.div().height(margin - gap).shrink(0.0)
}

/// Returns a header band `header_height` tall that centres `content` vertically above a one-pixel bottom `line`.
pub fn band(t: Theme, content: ui.Element) -> ui.Element {
    let body = ui.row(ui.div()).height(header_height - 1.0).items_center().shrink(0.0).child(content)
    ui.column(ui.div()).height(header_height).shrink(0.0).child(body).child(line(t))
}

/// Returns a `band` holding `leading` at the start and `trailing` at the end, with three spacing steps of room before and one after.
pub fn panel_header(t: Theme, leading: ui.Element, trailing: ui.Element[]) -> ui.Element {
    let ends = ui.row(ui.div()).grow(1.0).items_center().justify_between().child(leading).child(ui.row(ui.div()).items_center().children(trailing))
    let content = ui.row(ui.div()).grow(1.0).items_center().child(ui.div().width(step(3.0)).shrink(0.0)).child(ends).child(ui.div().width(step(1.0)).shrink(0.0))
    band(t, content)
}

/// Returns `title` as a panel title: small, medium weight and in the `text` colour.
pub fn panel_title(t: Theme, title: str) -> ui.Element {
    ui.text(title).text_size(small_size).text_color(t.text).font_weight(medium)
}

/// Returns `content` as an empty-pane message in the `faint` colour, padded by two spacing steps across and one and a half down.
pub fn empty(t: Theme, content: str) -> ui.Element {
    ui.div().padding_xy(step(2.0), step(1.5)).shrink(0.0).text_size(body_size).text_color(t.faint).child(ui.text(content))
}

/// Returns `content` as a field label: caption size, semibold and in the `muted` colour.
pub fn field_label(t: Theme, content: str) -> ui.Element {
    ui.text(content).text_size(caption_size).text_color(t.muted).font_weight(semibold)
}

/// Returns the status strip: a top `line` above `items` in a row, four spacing steps apart, in the `muted` colour.
pub fn status_strip(t: Theme, items: ui.Element[]) -> ui.Element {
    let inner = ui.row(ui.div()).height(status_line_height).items_center().gap(step(4.0)).padding_xy(step(3.0), 0.0).text_size(small_size).text_color(t.muted).children(items)
    ui.column(ui.div()).height(status_height).shrink(0.0).child(line(t)).child(inner)
}

/// Returns a centred empty state: a round badge showing the icon `glyph`, then `title`, then `body`, which wraps at 420 pixels wide.
pub fn empty_state(t: Theme, glyph: str, title: str, body: str) -> ui.Element {
    let badge = ui.row(ui.div()).size(48.0, 48.0).shrink(0.0).rounded(24.0).background(t.control).items_center().justify_center().child(icon_in(glyph, empty_icon_size, t.muted))
    let heading = ui.text(title).text_size(body_size).text_color(t.text).font_weight(semibold)
    let detail = ui.text(body).text_size(small_size).text_color(t.muted).text_center().wrapping()
    let wrapped = ui.row(ui.div()).shrink(0.0).justify_center().child(ui.column(ui.div()).grow(1.0).basis(0.0).min_width(0.0).max_width(420.0).child(detail))
    let title_row = ui.row(ui.div()).shrink(0.0).justify_center().child(heading)
    let badge_row = ui.row(ui.div()).shrink(0.0).justify_center().child(badge)
    ui.column(ui.div()).grow(1.0).justify_center().gap(empty_state_gap).padding(step(6.0)).child(badge_row).child(title_row).child(wrapped)
}

/// Returns `content` in a small rounded label drawn in `colour`, on a fill of that colour at 0.14 alpha.
pub fn pill(content: str, colour: geometry.Color) -> ui.Element {
    ui.row(ui.div()).height(18.0).shrink(0.0).items_center().padding_xy(7.0, 0.0).rounded(9.0).background(geometry.with_alpha(colour, 0.14)).text_size(caption_size).text_color(colour).child(ui.text(content))
}

/// Returns `chord` as a single key cap.
pub fn kbd(t: Theme, chord: str) -> ui.Element {
    ui.row(ui.div()).height(20.0).min_width(24.0).shrink(0.0).items_center().justify_center().padding_xy(6.0, 0.0).rounded(4.0).background(t.control).border(1.0, t.border).text_size(caption_size).text_color(t.muted).child(ui.text(chord))
}

/// Returns the key caps of `chord`. Keys joined with `+` are separate caps, and steps separated by spaces are joined with `then`.
pub fn keys(t: Theme, chord: str) -> ui.Element {
    var parts: ui.Element[] = []
    let steps = text.split_str(chord, " ")
    for index, step_chord in steps {
        if index > 0 {
            parts.push(ui.text("then").text_size(caption_size).text_color(t.faint))
        }
        var caps: ui.Element[] = []
        for key in text.split_str(step_chord, "+") {
            caps.push(kbd(t, key))
        }
        parts.push(ui.row(ui.div()).gap(3.0).children(caps))
    }
    ui.row(ui.div()).shrink(0.0).items_center().gap(step(2.0)).children(parts)
}
