import std/ui

/// A row of checkboxes that continues on the next line when it runs out of width, each named `{id}-{position}`, ticked as `on` says. `toggled` receives the position of the one pressed.
pub fn check_group(t: Theme, id: str, labels: str[], on: bool[], toggled: fn(i64)) -> ui.Element {
    var boxes: ui.Element[] = []
    for position, label in labels {
        let at = position
        let ticked = position < on.len && on[position]
        boxes.push(checkbox(t, "{id}-{position}", label, ticked, fn() { toggled(at) }))
    }
    ui.row(ui.div()).flex_wrap().gap(step(3.0)).children(boxes)
}
