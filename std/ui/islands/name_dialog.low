import std/text
import std/ui

const name_dialog_width: f32 = 360.0

/// What a name dialog is called, what it asks, the label of the button that submits, the name it starts with and where the selection over that name ends, the whole name when none.
pub struct NameCard {
    /// The name of the dialog, which its card id `{id}-card` is built from.
    pub id: str
    /// The heading of the card.
    pub title: str
    /// The label of the button that submits.
    pub verb: str
    /// The name the field starts with.
    pub name: str
    /// The byte offset where the selection over `name` ends, counted from its start. Defaults to `none`, which selects the whole name.
    pub selected: i64? = none
}

/// The key of the field a name dialog called `id` asks in.
pub fn name_dialog_entry(id: str) -> str {
    "{id}-name-entry"
}

fn name_dialog_submitted(cx: ui.Context, card: NameCard, name: ui.Signal[str], error: ui.Signal[str], submitted: fn(str) -> str?) -> fn() {
    fn() {
        let entered = text.trim(ui.get(name))
        let refusal = submitted(entered)
        match refusal {
            some(reason) => ui.set(error, reason)
            none => ui.close_overlay(cx, card.id)
        }
    }
}

fn name_dialog_edited(name: ui.Signal[str], error: ui.Signal[str]) -> fn(str) {
    fn(value: str) {
        ui.set(name, value)
        ui.set(error, "")
    }
}

fn name_dialog_card(cx: ui.Context, t: Theme, card: NameCard, name: ui.Signal[str], error: ui.Signal[str], submit: fn()) -> ui.Element {
    let cancel = fn() { ui.close_overlay(cx, card.id) }
    let heading = ui.text(card.title).text_size(heading_size).font_weight(semibold)
    let entry = form_field(t, "{card.id}-name", "Name", ui.get(name), "", name_dialog_edited(name, error))
    var parts: ui.Element[] = [heading, entry]
    let failure = ui.get(error)
    if failure.len > 0 {
        parts.push(form_failure(t, failure))
    }
    let actions = ui.row(ui.div()).justify_end().gap(step(2.0)).child(button(t, "dialog-cancel", "Cancel", Secondary, cancel)).child(button(t, "dialog-confirm", card.verb, Primary, submit))
    parts.push(actions)
    ui.column(popover(t)).id("{card.id}-card").width(name_dialog_width).shrink(0.0).padding(step(5.0)).gap(step(3.0)).text_color(t.text).text_size(body_size).font_family(ui_font).on_key(enter_key(submit)).children(parts)
}

/// Opens a dialog asking for a name, filled with `card.name` and selected up to `card.selected`, that `submitted` receives trimmed when Enter or the verb button is pressed. A message `submitted` returns is shown in the dialog, which stays open and clears it when the name is edited; none closes the dialog. Cancel and Escape close it without calling `submitted`.
pub fn open_name_dialog(cx: ui.Context, t: Theme, card: NameCard, submitted: fn(str) -> str?) {
    let name = ui.signal(cx, card.name)
    let error = ui.signal(cx, "")
    let submit = name_dialog_submitted(cx, card, name, error, submitted)
    ui.open_dialog(cx, card.id, fn() -> ui.Element { name_dialog_card(cx, t, card, name, error, submit) })
    let entry = name_dialog_entry(card.id)
    ui.set_focus(cx, entry)
    let end = card.selected ?? card.name.len
    ui.set_field_selection(cx, entry, 0, end)
}
