import std/ui
import std/ui/geometry
import std/ui/platform

const menu_min_width: f32 = 180.0

/// One row of a menu: its label, icon and the action run when it is chosen.
pub struct MenuItem {
    /// The text shown on the row.
    pub label: str
    /// The name of the icon drawn before the label, or an empty string for none.
    pub icon: str
    /// The function called when the row is chosen, after the menu has closed.
    pub action: fn()
    /// The text drawn at the end of the row, such as a shortcut, or `none` for none. Defaults to `none`.
    pub hint: str? = none
    /// Whether a line is drawn above the row, which the first row never has. Defaults to `false`.
    pub separated: bool = false
    /// Whether the row is drawn in the danger colour. Defaults to `false`.
    pub danger: bool = false
}

/// Returns a row labelled `label` with `icon` that calls `action` when chosen, with no hint, line or danger colour.
pub fn plain(label: str, icon: str, action: fn()) -> MenuItem {
    MenuItem { label, icon, action }
}

/// Returns `item` with `shown` as its hint.
pub fn hint(item: MenuItem, shown: str) -> MenuItem {
    var out = item
    out.hint = shown
    out
}

/// Returns `item` with a line drawn above it.
pub fn separated(item: MenuItem) -> MenuItem {
    separated_when(item, true)
}

/// Returns `item` with the line above it drawn only when `on` is true.
pub fn separated_when(item: MenuItem, on: bool) -> MenuItem {
    var out = item
    out.separated = on
    out
}

/// Returns `item` drawn in the danger colour when `on` is true and in the normal colours otherwise.
pub fn danger(item: MenuItem, on: bool) -> MenuItem {
    var out = item
    out.danger = on
    out
}

/// The state of one pop-up menu: whether it is open, where it opens, which row is selected and which element gets focus back when it closes.
pub struct OpenMenu {
    cx: ui.Context
    id: str
    owner: str
    shown: ui.Signal[bool]
    at: ui.Signal[geometry.Point]
    selected: ui.Signal[i64]
    restore: ui.Signal[str]
    sideways: fn(i64) = no_sideways
}

fn no_sideways(step: i64) {}

/// Creates a closed menu with the element id `id` that opens at the position it is shown with.
pub fn open_menu(cx: ui.Context, id: str) -> OpenMenu {
    open_menu_below(cx, id, "")
}

/// Creates a closed menu with the element id `id` that opens under the element named `owner`. An empty `owner` opens it at the position it is shown with.
pub fn open_menu_below(cx: ui.Context, id: str, owner: str) -> OpenMenu {
    OpenMenu {
        cx
        id
        owner
        shown: ui.signal(cx, false)
        at: ui.signal(cx, geometry.Point {})
        selected: ui.signal(cx, -1)
        restore: ui.signal(cx, "")
    }
}

/// Returns whether the menu is open.
pub fn menu_is_open(m: OpenMenu) -> bool {
    ui.get(m.shown)
}

/// Opens the menu at `position` with no row selected and moves focus to it. When it closes, focus returns to the element that held it before the menu first opened.
pub fn show_menu(m: OpenMenu, position: geometry.Point) {
    var restore = ui.get(m.restore)
    if !ui.get(m.shown) {
        restore = ui.focused(m.cx)
    }
    show_menu_from(m, position, restore)
}

/// Opens the menu to hand focus back to `restore` when it closes, for a caller that read the focus before the press that opens it took it away.
pub fn show_menu_from(m: OpenMenu, position: geometry.Point, restore: str) {
    ui.set(m.restore, restore)
    ui.set(m.at, position)
    ui.set(m.selected, -1)
    ui.set(m.shown, true)
    ui.set_focus(m.cx, m.id)
}

/// Closes the menu if it is open, and returns focus to the element it was opened from unless focus has already moved elsewhere.
pub fn dismiss_menu(m: OpenMenu) {
    if !ui.get(m.shown) {
        return
    }
    ui.set(m.shown, false)
    let now = ui.focused(m.cx)
    if now == m.id || now == "" {
        ui.set_focus(m.cx, ui.get(m.restore))
    }
}

fn context_trigger(owner: ui.Element, m: OpenMenu) -> ui.Element {
    owner.on_mouse_down(platform.Button.Right, fn(e: ui.MouseDownEvent) { show_menu(m, e.position) })
}

fn dropdown_trigger(owner: ui.Element, m: OpenMenu) -> ui.Element {
    owner.on_click(fn(e: ui.ClickEvent) {
        if ui.get(m.shown) {
            dismiss_menu(m)
        } else {
            show_menu(m, e.position)
        }
    })
}

/// Returns the pop-up of `items` drawn above other content, or an empty element while the menu is closed. It sits under its owner when it has one and at its position otherwise. Up and Down move the selection, Enter chooses the selected row, Escape closes the menu, and a press outside it closes it unless the press is on its owner.
pub fn menu_element(t: Theme, m: OpenMenu, items: MenuItem[]) -> ui.Element {
    if !ui.get(m.shown) {
        return ui.div().absolute()
    }
    let place = if m.owner == "" {
        ui.anchored().position(ui.get(m.at))
    } else {
        ui.anchored().attach_to(m.owner, ui.Corner.BottomLeft)
    }
    ui.deferred(place.child(menu_panel(t, m, items))).priority(1)
}

fn menu_panel(t: Theme, m: OpenMenu, items: MenuItem[]) -> ui.Element {
    var rows: ui.Element[] = []
    let selected = ui.get(m.selected)
    for index, item in items {
        if item.separated && index > 0 {
            rows.push(menu_separator(t))
        }
        rows.push(menu_row(t, m, items, index, selected == index))
    }
    ui.column(popover(t)).id(m.id).focusable().occlude().min_width(menu_min_width).padding(step(1.0)).on_key(menu_key(m, items)).on_mouse_down_out(pressed_outside(m)).children(rows)
}

fn menu_separator(t: Theme) -> ui.Element {
    ui.div().height(1.0).shrink(0.0).margin_xy(step(1.0), step(1.0)).background(t.border)
}

fn menu_row(t: Theme, m: OpenMenu, items: MenuItem[], index: i64, selected: bool) -> ui.Element {
    let item = items[index]
    let text = if item.danger { t.danger } else { t.text }
    let glyph = if item.danger { t.danger } else { t.muted }
    var parts: ui.Element[] = []
    if item.icon != "" {
        parts.push(small_icon_in(item.icon, glyph))
    }
    parts.push(ui.div().flex_1().child(ui.text(item.label)))
    match item.hint {
        some(shown) => parts.push(ui.div().shrink(0.0).padding_left(step(4.0)).text_size(caption_size).text_color(t.faint).child(ui.text(shown)))
        none => {}
    }
    row(t, "{m.id}-{index}", selected, fn() { choose(m, items, index) }).text_color(text).children(parts)
}

fn choose(m: OpenMenu, items: MenuItem[], index: i64) {
    if index < 0 || index >= items.len {
        return
    }
    let action = items[index].action
    dismiss_menu(m)
    action()
}

fn pressed_outside(m: OpenMenu) -> fn(ui.MouseDownEvent) {
    fn(e: ui.MouseDownEvent) {
        if !over_owner(m, e.position) {
            dismiss_menu(m)
        }
    }
}

fn over_owner(m: OpenMenu, position: geometry.Point) -> bool {
    if m.owner == "" {
        return false
    }
    let bounds = ui.bounds_of(m.cx, m.owner) ?? return false
    geometry.contains(bounds, position)
}

fn menu_key(m: OpenMenu, items: MenuItem[]) -> fn(platform.KeyEvent) -> bool {
    fn(k: platform.KeyEvent) -> bool {
        if !k.pressed {
            return true
        }
        let count = if items.len > 0 { items.len } else { 1 }
        let current = ui.get(m.selected)
        match k.key {
            Named(named) => {
                match named {
                    Down => ui.set(m.selected, if current < 0 { 0 } else { (current + 1) % count })
                    Up => ui.set(m.selected, if current < 0 { count - 1 } else { (current + count - 1) % count })
                    Enter => choose(m, items, current)
                    Escape => dismiss_menu(m)
                    Left => m.sideways(-1)
                    Right => m.sideways(1)
                    _ => return false
                }
            }
            Character(text) => return false
        }
        true
    }
}
