import std/text
import std/ui
import std/ui/geometry
import std/ui/platform

const sheet_context: str = "Sheet"
const sheet_autoscroll_ms: i64 = 40

/// How a sheet treats the header: `Results` selects the column on a click and fits to the rows in view, as the query results do; `Table` sorts on a click and fits to every row, as a dashboard table does.
pub enum SheetMode {
    /// The mode in which a header click selects the column and a fit reads the rows in view.
    Results
    /// The mode in which a header click sorts and a fit reads every row.
    Table
}

/// One way to take a sheet's cells out as a file: what the menu calls it, with a selection and without, its icon, and what it does, handed the selected block or `none` for every row.
pub struct SheetExport {
    /// The menu text when nothing is selected, so the export takes every row.
    pub label: str
    /// The menu text when a block is selected.
    pub selection_label: str
    /// The name of the icon shown beside the menu text.
    pub glyph: str
    /// The action, called with the selected block, or `none` when nothing is selected.
    pub run: fn(SheetBlock?)
}

/// What a sheet needs from the application that holds it: its element id, the context, a menu, how to read and change its state, where to say what a copy did, the exports its menu offers, the commands its menu offers for the row shown at a position, and how it takes edits. `begin_edit` is asked when a cell is to be edited in place and answers the text to start from, or none for a cell that cannot be edited; `commit_edit` receives the text typed when Enter keeps it.
pub struct SheetHost {
    /// The element id of the sheet, used to measure it and to give it focus.
    pub id: str
    /// The UI context the sheet measures in and sets focus, clipboard and background work on.
    pub cx: ui.Context
    /// The context menu the sheet opens.
    pub menu: OpenMenu
    /// How the header acts.
    pub mode: SheetMode
    /// Returns the current state of the sheet.
    pub read: fn() -> SheetState
    /// Applies a change to the state of the sheet, handed a function from the current state to the next.
    pub edit: fn(fn(SheetState) -> SheetState)
    /// Says what an action did, called with a short message.
    pub notice: fn(str)
    /// The exports the menu offers; none by default.
    pub exports: SheetExport[] = []
    /// Returns the commands the menu offers for a row, called with its position; none by default.
    pub row_items: fn(i64) -> MenuItem[] = sheet_no_row_items
    /// Asked, with a row and a column, when a cell is to be edited in place; answers the text to start from, or `none` for a cell that cannot be edited. Every cell answers `none` by default.
    pub begin_edit: fn(i64, i64) -> str? = sheet_no_edit
    /// Called with the row, the column and the text typed when Enter keeps it. Does nothing by default.
    pub commit_edit: fn(i64, i64, str) = sheet_no_commit
}

fn sheet_no_edit(row: i64, column: i64) -> str? {
    none
}

fn sheet_no_commit(row: i64, column: i64, typed: str) {}

fn sheet_no_row_items(row: i64) -> MenuItem[] {
    []
}

/// The host with the source and the width of a character, which every handler needs to lay the sheet out again.
pub struct SheetFrame {
    /// The application that holds the sheet.
    pub host: SheetHost
    /// The rows and columns the sheet draws.
    pub source: SheetSource
    /// The width of one character of the sheet's font, in pixels.
    pub char_width: f32
}

struct SheetChord {
    keys: str
    action: str
}

fn sheet_chords() -> SheetChord[] {
    [
        SheetChord { keys: "up", action: "grid.up" }
        SheetChord { keys: "down", action: "grid.down" }
        SheetChord { keys: "left", action: "grid.left" }
        SheetChord { keys: "right", action: "grid.right" }
        SheetChord { keys: "pageup", action: "grid.page_up" }
        SheetChord { keys: "pagedown", action: "grid.page_down" }
        SheetChord { keys: "shift-up", action: "grid.extend_up" }
        SheetChord { keys: "shift-down", action: "grid.extend_down" }
        SheetChord { keys: "shift-left", action: "grid.extend_left" }
        SheetChord { keys: "shift-right", action: "grid.extend_right" }
        SheetChord { keys: "shift-pageup", action: "grid.extend_page_up" }
        SheetChord { keys: "shift-pagedown", action: "grid.extend_page_down" }
        SheetChord { keys: "ctrl-home", action: "grid.first" }
        SheetChord { keys: "ctrl-end", action: "grid.last" }
        SheetChord { keys: "ctrl-shift-home", action: "grid.extend_first" }
        SheetChord { keys: "ctrl-shift-end", action: "grid.extend_last" }
        SheetChord { keys: "home", action: "grid.row_start" }
        SheetChord { keys: "end", action: "grid.row_end" }
        SheetChord { keys: "shift-home", action: "grid.extend_row_start" }
        SheetChord { keys: "shift-end", action: "grid.extend_row_end" }
        SheetChord { keys: "ctrl-a", action: "grid.select_all" }
        SheetChord { keys: "ctrl-c", action: "grid.copy" }
        SheetChord { keys: "ctrl-shift-c", action: "grid.copy_with_headers" }
        SheetChord { keys: "f2", action: "grid.edit_cell" }
        SheetChord { keys: "enter", action: "grid.view_value" }
    ]
}

/// A key a sheet answers and what it does, in the words a shortcuts page uses.
pub struct SheetShortcut {
    /// The key chord, written as `ctrl-shift-c`.
    pub keys: str
    /// What the key does, in words.
    pub label: str
}

fn sheet_label(action: str) -> str {
    match action {
        "grid.up" => "Move"
        "grid.down" => "Move"
        "grid.left" => "Move"
        "grid.right" => "Move"
        "grid.page_up" => "A page at a time"
        "grid.page_down" => "A page at a time"
        "grid.first" => "The first and last cell"
        "grid.last" => "The first and last cell"
        "grid.row_start" => "The start and end of the row"
        "grid.row_end" => "The start and end of the row"
        "grid.extend_page_up" => "Extend the selection by a page"
        "grid.extend_page_down" => "Extend the selection by a page"
        "grid.extend_first" => "Extend the selection to the first or last cell"
        "grid.extend_last" => "Extend the selection to the first or last cell"
        "grid.extend_row_start" => "Extend the selection to the start or end of the row"
        "grid.extend_row_end" => "Extend the selection to the start or end of the row"
        "grid.select_all" => "Select everything"
        "grid.copy" => "Copy, or copy with headers"
        "grid.copy_with_headers" => "Copy, or copy with headers"
        "grid.view_value" => "View the whole value of a cell"
        "grid.edit_cell" => "Edit the value of a cell"
        _ => "Extend the selection"
    }
}

/// Lists the keys a sheet answers, each with the words for what it does, in the order they are bound.
pub fn sheet_shortcuts() -> SheetShortcut[] {
    var found: SheetShortcut[] = []
    for chord in sheet_chords() {
        found.push(SheetShortcut { keys: chord.keys, label: sheet_label(chord.action) })
    }
    found
}

fn sheet_keymap() -> ui.KeyBinding[] ! ui.KeymapError {
    var bindings: ui.KeyBinding[] = []
    for chord in sheet_chords() {
        let binding = ui.key_binding(chord.keys, chord.action, sheet_context)?
        bindings.push(binding)
    }
    bindings
}

/// The key bindings a sheet answers while it has focus; the application binds them once with `ui.bind_keys`.
pub fn sheet_bindings() -> ui.KeyBinding[] {
    sheet_keymap() catch {
        e => panic("the sheet key bindings cannot be read")
    }
}

fn sheet_room(host: SheetHost) -> geometry.Size {
    let bounds = ui.bounds_of(host.cx, host.id) ?? return geometry.size(sheet_unmeasured, sheet_unmeasured)
    geometry.size(bounds.width, bounds.height)
}

fn sheet_origin(host: SheetHost) -> geometry.Point {
    let bounds = ui.bounds_of(host.cx, host.id) ?? return geometry.point(0.0, 0.0)
    geometry.point(bounds.x, bounds.y)
}

fn sheet_local(host: SheetHost, at: geometry.Point) -> geometry.Point {
    let origin = sheet_origin(host)
    geometry.point(at.x - origin.x, at.y - origin.y)
}

/// Returns the layout of `state` for the frame, within the room the sheet's element measures.
pub fn sheet_layout_in(frame: SheetFrame, state: SheetState) -> SheetLayout {
    sheet_layout(state, frame.source, frame.char_width, sheet_room(frame.host))
}

fn sheet_edited(frame: SheetFrame, change: fn(SheetState, SheetLayout) -> SheetState) {
    let host = frame.host
    host.edit(fn(s: SheetState) -> SheetState { change(s, sheet_layout_in(frame, s)) })
}

fn sheet_totals(frame: SheetFrame) -> SheetAt {
    SheetAt { row: frame.source.total, column: frame.source.columns.len }
}

fn sheet_step(frame: SheetFrame, rows: i64, columns: i64, extend: bool, paged: bool) {
    let totals = sheet_totals(frame)
    sheet_edited(frame, fn(s: SheetState, layout: SheetLayout) -> SheetState {
        let moved_rows = if paged { rows * sheet_page(layout) } else { rows }
        sheet_revealed(sheet_moved(s, moved_rows, columns, totals.row, totals.column, extend), layout)
    })
}

fn sheet_select_everything(frame: SheetFrame) {
    let totals = sheet_totals(frame)
    sheet_edited(frame, fn(s: SheetState, layout: SheetLayout) -> SheetState {
        sheet_selected_all(s, totals.row, totals.column)
    })
}

fn sheet_select_column(frame: SheetFrame, column: i64) {
    let totals = sheet_totals(frame)
    sheet_edited(frame, fn(s: SheetState, layout: SheetLayout) -> SheetState {
        sheet_swept(s, SheetAt { row: 0, column }, SheetSweep.Columns, false, totals.row, totals.column)
    })
}

fn sheet_fit_rows(frame: SheetFrame, state: SheetState, layout: SheetLayout) -> SheetAt {
    match frame.host.mode {
        Table => SheetAt { row: 0, column: frame.source.total }
        Results => {
            let first = sheet_first_row(state)
            let end = first + sheet_rows_shown(layout)
            SheetAt { row: first, column: if end < frame.source.total { end } else { frame.source.total } }
        }
    }
}

fn sheet_fit(frame: SheetFrame, column: i64) {
    let state = frame.host.read()
    let layout = sheet_layout_in(frame, state)
    let range = sheet_fit_rows(frame, state, layout)
    let characters = sheet_fitted(frame.source, column, range.row, range.column)
    let width = frame.char_width * f32(characters) + sheet_cell_padding * 2.0
    frame.host.edit(fn(s: SheetState) -> SheetState { sheet_sized(s, column, width) })
}

fn sheet_reset_width(frame: SheetFrame, column: i64) {
    frame.host.edit(fn(s: SheetState) -> SheetState { sheet_unsized(s, column) })
}

fn sheet_sort_by(frame: SheetFrame, sort: SheetSort?) {
    sheet_edited(frame, fn(s: SheetState, layout: SheetLayout) -> SheetState {
        sheet_revealed(sheet_sorted_by(s, sort), layout)
    })
}

fn sheet_copy_done(frame: SheetFrame, rows: i64, headers: bool) -> fn(SheetCopy) {
    fn(copied: SheetCopy) {
        match copied.failure {
            some(reason) => frame.host.notice(reason)
            none => {
                ui.set_clipboard(frame.host.cx, copied.text)
                let tail = if headers { " with headers" } else { "" }
                frame.host.notice("Copied {sheet_plural(rows, "row")}{tail}")
            }
        }
    }
}

fn sheet_copy_block(frame: SheetFrame, block: SheetBlock, headers: bool) {
    let source = sheet_copied_source(frame.source)
    let taken = sheet_block_within(block, source.total)
    if sheet_block_rows(taken) <= 0 {
        return frame.host.notice("Nothing to copy")
    }
    ui.background_spawn(frame.host.cx, fn() -> SheetCopy { sheet_block_text(source, taken, headers) }, sheet_copy_done(frame, sheet_block_rows(taken), headers))
}

fn sheet_copy(frame: SheetFrame, headers: bool) {
    let block = sheet_block(frame.host.read()) ?? return frame.host.notice("Nothing to copy")
    sheet_copy_block(frame, block, headers)
}

/// Copies every row with the column names to the clipboard, reading in the background, and says so through `notice`. Says `Nothing to copy` when there are no rows or columns.
pub fn sheet_copy_everything(frame: SheetFrame) {
    if frame.source.total == 0 || frame.source.columns.len == 0 {
        return frame.host.notice("Nothing to copy")
    }
    sheet_copy_block(frame, sheet_whole(frame.source.total, frame.source.columns.len), true)
}

fn sheet_records_done(frame: SheetFrame, rows: i64) -> fn(SheetCopy) {
    fn(copied: SheetCopy) {
        match copied.failure {
            some(reason) => frame.host.notice(reason)
            none => {
                ui.set_clipboard(frame.host.cx, copied.text)
                frame.host.notice("Copied {sheet_plural(rows, "row")} as text")
            }
        }
    }
}

fn sheet_copy_records(frame: SheetFrame) {
    let source = sheet_copied_source(frame.source)
    let block = sheet_block_within(sheet_block(frame.host.read()) ?? return, source.total)
    if sheet_block_rows(block) <= 0 {
        return frame.host.notice("Nothing to copy")
    }
    let first = block.first_row
    let end = block.end_row
    ui.background_spawn(frame.host.cx, fn() -> SheetCopy { sheet_records_text(source, first, end) }, sheet_records_done(frame, sheet_block_rows(block)))
}

fn sheet_value_made(frame: SheetFrame, row: i64, column: i64, cell: str?, at: geometry.Point) -> fn() -> SheetValue {
    let name = if column < frame.source.columns.len { frame.source.columns[column] } else { "" }
    fn() -> SheetValue {
        let presented = sheet_presented(cell)
        let characters = match cell {
            some(value) => text.char_count(value)
            none => 0
        }
        SheetValue {
            title: sheet_value_title(name, row, presented.kind, characters)
            text: presented.text
            shown: sheet_shown(presented.text)
            at
        }
    }
}

fn sheet_value_ready(frame: SheetFrame, generation: i64) -> fn(SheetValue) {
    fn(made: SheetValue) {
        frame.host.edit(fn(s: SheetState) -> SheetState {
            if s.viewing != generation {
                return s
            }
            var next = s
            next.value = made
            next
        })
    }
}

fn sheet_view_value(frame: SheetFrame, row: i64, column: i64, at: geometry.Point) {
    if row < 0 || row >= frame.source.total || column < 0 || column >= frame.source.columns.len {
        return
    }
    let page = frame.source.read(row, row + 1, column, column + 1)
    var cell: str? = none
    if page.rows.len > 0 && page.rows[0].len > 0 {
        cell = page.rows[0][0]
    } else if page.failure != none {
        return frame.host.notice(page.failure ?? "")
    }
    let generation = frame.host.read().viewing + 1
    frame.host.edit(fn(s: SheetState) -> SheetState {
        var next = s
        next.viewing = generation
        next
    })
    ui.background_spawn(frame.host.cx, sheet_value_made(frame, row, column, cell, at), sheet_value_ready(frame, generation))
}

/// The key of the field a sheet takes text for in place in.
pub fn sheet_entry_id(host: SheetHost) -> str {
    "{host.id}-entry"
}

/// Opens an entry on a cell when the host agrees to edit it, scrolled into view with the text selected for typing over.
pub fn sheet_edit_cell(frame: SheetFrame, row: i64, column: i64) {
    if row < 0 || row >= frame.source.total || column < 0 || column >= frame.source.columns.len {
        return
    }
    let start = frame.host.begin_edit(row, column) ?? return
    sheet_edited(frame, fn(s: SheetState, layout: SheetLayout) -> SheetState {
        sheet_revealed(sheet_entry_opened(s, row, column, start), layout)
    })
    let id = sheet_entry_id(frame.host)
    ui.set_focus(frame.host.cx, id)
    ui.set_field_selection(frame.host.cx, id, 0, start.len)
}

fn sheet_edit_current(frame: SheetFrame) {
    let cell = frame.host.read().cell ?? return
    sheet_edit_cell(frame, cell.row, cell.column)
}

/// Closes the entry, keeping what was typed: the host receives it and the sheet takes the focus back.
pub fn sheet_entry_commit(frame: SheetFrame) {
    let open = frame.host.read().entry ?? return
    frame.host.edit(fn(s: SheetState) -> SheetState { sheet_entry_closed(s) })
    ui.set_focus(frame.host.cx, frame.host.id)
    frame.host.commit_edit(open.row, open.column, open.text)
}

/// Closes the entry, dropping what was typed, and gives the focus back to the sheet.
pub fn sheet_entry_cancel(frame: SheetFrame) {
    if frame.host.read().entry == none {
        return
    }
    frame.host.edit(fn(s: SheetState) -> SheetState { sheet_entry_closed(s) })
    ui.set_focus(frame.host.cx, frame.host.id)
}

fn sheet_entry_typed_in(frame: SheetFrame) -> fn(str) {
    fn(typed: str) {
        frame.host.edit(fn(s: SheetState) -> SheetState { sheet_entry_typed(s, typed) })
    }
}

/// The keys of the entry's field: Enter keeps the text and Escape drops it.
pub fn sheet_entry_key(frame: SheetFrame) -> fn(platform.KeyEvent) -> bool {
    fn(k: platform.KeyEvent) -> bool {
        if !k.pressed {
            return false
        }
        match k.key {
            Named(named) => {
                match named {
                    Enter => {
                        sheet_entry_commit(frame)
                        true
                    }
                    Escape => {
                        sheet_entry_cancel(frame)
                        true
                    }
                    _ => false
                }
            }
            Character(typed) => false
        }
    }
}

fn sheet_view_current(frame: SheetFrame) {
    let state = frame.host.read()
    let cell = state.cell ?? return
    let layout = sheet_layout_in(frame, state)
    let at = sheet_cursor_point(state, layout, sheet_origin(frame.host)) ?? return
    sheet_view_value(frame, cell.row, cell.column, at)
}

fn sheet_value_closed(frame: SheetFrame) {
    frame.host.edit(fn(s: SheetState) -> SheetState {
        var next = s
        next.value = none
        next.viewing = s.viewing + 1
        next
    })
}

fn sheet_value_copied(frame: SheetFrame, content: str) {
    ui.set_clipboard(frame.host.cx, content)
    frame.host.notice("Copied the value")
}

fn sheet_opened_menu(frame: SheetFrame, kind: SheetMenuKind, row: i64, column: i64, at: geometry.Point) {
    frame.host.edit(fn(s: SheetState) -> SheetState {
        var next = s
        next.menu = SheetMenu { kind, row, column, at }
        next
    })
    show_menu(frame.host.menu, at)
}

fn sheet_holds_cell(state: SheetState, row: i64, column: i64) -> bool {
    let block = sheet_block(state) ?? return false
    sheet_block_contains(block, row, column)
}

fn sheet_holds_row(state: SheetState, row: i64) -> bool {
    let block = sheet_block(state) ?? return false
    sheet_block_has_row(block, row)
}

fn sheet_context_opened(frame: SheetFrame, at: geometry.Point) {
    ui.set_focus(frame.host.cx, frame.host.id)
    let state = frame.host.read()
    let layout = sheet_layout_in(frame, state)
    let local = sheet_local(frame.host, at)
    let totals = sheet_totals(frame)
    match sheet_hit(state, layout, local.x, local.y) {
        Column(column) => sheet_opened_menu(frame, SheetMenuKind.Header, 0, column, at)
        Edge(column) => sheet_opened_menu(frame, SheetMenuKind.Header, 0, column, at)
        Cell(row, column) => {
            if !sheet_holds_cell(state, row, column) {
                frame.host.edit(fn(s: SheetState) -> SheetState {
                    sheet_selected(s, SheetAt { row, column }, SheetAt { row, column })
                })
            }
            sheet_opened_menu(frame, SheetMenuKind.Cell, row, column, at)
        }
        Row(row) => {
            if !sheet_holds_row(state, row) {
                frame.host.edit(fn(s: SheetState) -> SheetState {
                    sheet_swept(s, SheetAt { row, column: 0 }, SheetSweep.Rows, false, totals.row, totals.column)
                })
            }
            sheet_opened_menu(frame, SheetMenuKind.Cell, row, 0, at)
        }
        _ => sheet_opened_menu(frame, SheetMenuKind.Table, 0, 0, at)
    }
}

fn sheet_keyboard_menu(frame: SheetFrame) {
    let state = frame.host.read()
    let cell = state.cell ?? return
    let layout = sheet_layout_in(frame, state)
    let at = sheet_cursor_point(state, layout, sheet_origin(frame.host)) ?? return
    sheet_opened_menu(frame, SheetMenuKind.Cell, cell.row, cell.column, at)
}

fn sheet_autoscrolled(frame: SheetFrame) {
    let state = frame.host.read()
    if state.autoscrolling {
        return
    }
    frame.host.edit(fn(s: SheetState) -> SheetState {
        var next = s
        next.autoscrolling = true
        next
    })
    sheet_tick(frame)
}

fn sheet_ticked(frame: SheetFrame) -> fn(bool) {
    fn(waited: bool) {
        sheet_edited(frame, fn(s: SheetState, layout: SheetLayout) -> SheetState {
            var next = sheet_swept_on(s, layout)
            next.autoscrolling = sheet_sweep_moving(next, layout)
            next
        })
        if frame.host.read().autoscrolling {
            sheet_tick(frame)
        }
    }
}

fn sheet_tick(frame: SheetFrame) {
    ui.background_spawn(frame.host.cx, fn() -> bool {
        sleep(sheet_autoscroll_ms)
        true
    }, sheet_ticked(frame))
}

fn sheet_started(frame: SheetFrame, cell: SheetAt, sweep: SheetSweep, extend: bool) {
    let totals = sheet_totals(frame)
    frame.host.edit(fn(s: SheetState) -> SheetState {
        sheet_sweep_started(s, cell, sweep, extend, totals.row, totals.column)
    })
}

/// A press of the primary button: selects, begins a sweep or a resize, or fits a column on a double press of its edge.
pub fn sheet_pressed(frame: SheetFrame, e: ui.MouseDownEvent) {
    sheet_entry_cancel(frame)
    ui.set_focus(frame.host.cx, frame.host.id)
    let state = frame.host.read()
    let layout = sheet_layout_in(frame, state)
    let local = sheet_local(frame.host, e.position)
    if sheet_bar_pressed(state, layout, local.x, local.y) != none {
        sheet_edited(frame, fn(s: SheetState, l: SheetLayout) -> SheetState { sheet_bar_pressed(s, l, local.x, local.y) ?? s })
        return
    }
    let extend = e.modifiers.shift
    frame.host.edit(fn(s: SheetState) -> SheetState {
        var next = s
        next.pointer = local
        next
    })
    match sheet_hit(state, layout, local.x, local.y) {
        Corner => sheet_select_everything(frame)
        Column(column) => sheet_header_pressed(frame, column, extend, e.modifiers.control, e.click_count)
        Row(row) => sheet_started(frame, SheetAt { row, column: 0 }, SheetSweep.Rows, extend)
        Cell(row, column) => {
            if e.click_count == 2 && sheet_sorts(frame) {
                sheet_started(frame, SheetAt { row, column }, SheetSweep.Cells, false)
                sheet_view_value(frame, row, column, e.position)
            } else if e.click_count == 2 {
                sheet_started(frame, SheetAt { row, column }, SheetSweep.Cells, false)
                sheet_edit_cell(frame, row, column)
            } else {
                sheet_started(frame, SheetAt { row, column }, SheetSweep.Cells, extend)
            }
        }
        Edge(column) => {
            if e.click_count == 2 {
                sheet_fit(frame, column)
            } else {
                frame.host.edit(fn(s: SheetState) -> SheetState { sheet_resize_started(s, layout, column, local.x) })
            }
        }
        Nothing => {}
    }
}

fn sheet_sorts(frame: SheetFrame) -> bool {
    match frame.host.mode {
        Table => true
        Results => false
    }
}

fn sheet_header_pressed(frame: SheetFrame, column: i64, extend: bool, control: bool, clicks: i64) {
    match frame.host.mode {
        Results => sheet_started(frame, SheetAt { row: 0, column }, SheetSweep.Columns, extend)
        Table => {
            if extend || control {
                sheet_started(frame, SheetAt { row: 0, column }, SheetSweep.Columns, extend)
            } else if clicks == 1 {
                frame.host.edit(fn(s: SheetState) -> SheetState {
                    var next = s
                    next.pressed_header = column
                    next
                })
            }
        }
    }
}

/// A release of the primary button: ends a sweep or a resize, and cycles the sort when a header press ends over the header it began on.
pub fn sheet_let_go(frame: SheetFrame, e: ui.MouseUpEvent) {
    let state = frame.host.read()
    let layout = sheet_layout_in(frame, state)
    let local = sheet_local(frame.host, e.position)
    let pressed = state.pressed_header
    frame.host.edit(fn(s: SheetState) -> SheetState { sheet_released(s) })
    if pressed < 0 {
        return
    }
    match sheet_hit(state, layout, local.x, local.y) {
        Column(column) => {
            if column == pressed {
                sheet_sort_by(frame, sheet_sort_cycled(state, column).sort)
            }
        }
        _ => {}
    }
}

/// A move of the pointer during a drag that began on the sheet: sizes a column, or extends the selection and scrolls while the pointer is past an edge.
pub fn sheet_dragged(frame: SheetFrame, e: ui.DragMoveEvent) {
    if e.drag.value != frame.host.id {
        return
    }
    let local = sheet_local(frame.host, e.position)
    sheet_edited(frame, fn(s: SheetState, layout: SheetLayout) -> SheetState {
        var next = s
        next.pointer = local
        if s.grab != none {
            return sheet_bar_dragged(next, layout, local.x, local.y)
        }
        if s.resize != none {
            return sheet_resize_dragged(next, local.x)
        }
        if s.sweep != none {
            return sheet_swept_on(next, layout)
        }
        next
    })
    let state = frame.host.read()
    if sheet_sweep_moving(state, sheet_layout_in(frame, state)) {
        sheet_autoscrolled(frame)
    }
}

fn sheet_wheeled_by(frame: SheetFrame, e: ui.ScrollEvent) {
    sheet_edited(frame, fn(s: SheetState, layout: SheetLayout) -> SheetState {
        sheet_wheeled(s, layout, e.dx, e.dy)
    })
}

/// Keys that are not bound actions: Shift+F10 and the Menu key open the context menu at the current cell and Escape closes the value view.
pub fn sheet_key(frame: SheetFrame) -> fn(platform.KeyEvent) -> bool {
    fn(k: platform.KeyEvent) -> bool {
        if !k.pressed {
            return false
        }
        match k.key {
            Named(named) => {
                match named {
                    Function(number) => {
                        if number == 10 && k.modifiers.shift {
                            sheet_keyboard_menu(frame)
                            return true
                        }
                        false
                    }
                    Menu => {
                        sheet_keyboard_menu(frame)
                        true
                    }
                    Escape => {
                        if frame.host.read().entry != none {
                            sheet_entry_cancel(frame)
                            return true
                        }
                        if frame.host.read().value != none {
                            sheet_value_closed(frame)
                            return true
                        }
                        false
                    }
                    _ => false
                }
            }
            Character(typed) => false
        }
    }
}

/// The element with the key actions of a sheet attached.
pub fn sheet_actions(frame: SheetFrame, root: ui.Element) -> ui.Element {
    let keys = root.on_action("grid.up", fn() { sheet_step(frame, -1, 0, false, false) }).on_action("grid.down", fn() { sheet_step(frame, 1, 0, false, false) }).on_action("grid.left", fn() { sheet_step(frame, 0, -1, false, false) }).on_action("grid.right", fn() { sheet_step(frame, 0, 1, false, false) })
    let pages = keys.on_action("grid.page_up", fn() { sheet_step(frame, -1, 0, false, true) }).on_action("grid.page_down", fn() { sheet_step(frame, 1, 0, false, true) }).on_action("grid.extend_page_up", fn() { sheet_step(frame, -1, 0, true, true) }).on_action("grid.extend_page_down", fn() { sheet_step(frame, 1, 0, true, true) })
    let extends = pages.on_action("grid.extend_up", fn() { sheet_step(frame, -1, 0, true, false) }).on_action("grid.extend_down", fn() { sheet_step(frame, 1, 0, true, false) }).on_action("grid.extend_left", fn() { sheet_step(frame, 0, -1, true, false) }).on_action("grid.extend_right", fn() { sheet_step(frame, 0, 1, true, false) })
    let corners = extends.on_action("grid.first", fn() { sheet_step(frame, -sheet_far, -sheet_far, false, false) }).on_action("grid.last", fn() { sheet_step(frame, sheet_far, sheet_far, false, false) }).on_action("grid.extend_first", fn() { sheet_step(frame, -sheet_far, -sheet_far, true, false) }).on_action("grid.extend_last", fn() { sheet_step(frame, sheet_far, sheet_far, true, false) })
    let ends = corners.on_action("grid.row_start", fn() { sheet_step(frame, 0, -sheet_far, false, false) }).on_action("grid.row_end", fn() { sheet_step(frame, 0, sheet_far, false, false) }).on_action("grid.extend_row_start", fn() { sheet_step(frame, 0, -sheet_far, true, false) }).on_action("grid.extend_row_end", fn() { sheet_step(frame, 0, sheet_far, true, false) })
    ends.on_action("grid.select_all", fn() { sheet_select_everything(frame) }).on_action("grid.copy", fn() { sheet_copy(frame, false) }).on_action("grid.copy_with_headers", fn() { sheet_copy(frame, true) }).on_action("grid.view_value", fn() { sheet_view_current(frame) }).on_action("grid.edit_cell", fn() { sheet_edit_current(frame) })
}
