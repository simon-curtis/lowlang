import std/testing
import std/ui
import std/ui/geometry

struct PathBrowserRig {
    cx: ui.Context
    log: ui.Signal[str[]]
    paint: fn() -> ui.Element
}

fn path_browser_entries() -> PathEntry[] {
    [PathEntry { name: "backups", directory: true }, PathEntry { name: "sales.bak", directory: false }]
}

fn path_browser_handlers(log: ui.Signal[str[]]) -> PathBrowserHandlers {
    PathBrowserHandlers {
        up: noting(log, "up")
        drives: noting(log, "drives")
        opened: fn(index: i64) { note(log, "opened {index}") }
        named: fn(name: str) { note(log, "named {name}") }
        chosen: noting(log, "chosen")
        dismissed: noting(log, "dismissed")
    }
}

fn path_browser_rig(view: PathBrowser) -> PathBrowserRig {
    let cx = ui.headless(ui.rgb(0x0b0b0e))
    let look = default_theme()
    let log = new_log(cx)
    let handlers = path_browser_handlers(log)
    let paint = fn() -> ui.Element {
        ui.div().size(800.0, 700.0).child(path_browser(look, view, handlers))
    }
    let rig = PathBrowserRig { cx, log, paint }
    path_browser_shot(rig)
    rig
}

fn path_browser_shot(r: PathBrowserRig) {
    ui.frame(r.cx, r.paint, geometry.size(800.0, 700.0), 1.0)
}

fn path_browser_view(file: str?) -> PathBrowser {
    PathBrowser { id: "files", title: "Choose a backup file", place: "D:\\backups", entries: path_browser_entries(), loading: false, file, verb: "Choose file" }
}

fn test_path_browser_a_click_on_a_row_opens_the_row_it_hit_and_up_and_drives_answer(t: *testing.T) {
    let r = path_browser_rig(path_browser_view(none))
    click_key(r.cx, path_browser_row_id("files", 1))
    click_key(r.cx, "files-up")
    click_key(r.cx, "files-drives")
    click_key(r.cx, "files-choose")
    click_key(r.cx, "files-cancel")
    t.equal_slice(ui.get(r.log), ["opened 1", "up", "drives", "chosen", "dismissed"])
}

fn test_path_browser_the_card_is_the_set_size_and_lists_one_row_per_entry(t: *testing.T) {
    let r = path_browser_rig(path_browser_view(none))
    let card = bounds_for(r.cx, "files-card")
    same_number(t, card.width, path_browser_width)
    same_number(t, card.height, path_browser_height)
    t.is_true(ui.bounds_of(r.cx, path_browser_row_id("files", 0)) != none)
    t.is_true(ui.bounds_of(r.cx, path_browser_row_id("files", 1)) != none)
    t.is_true(ui.bounds_of(r.cx, path_browser_row_id("files", 2)) == none)
}

fn test_path_browser_a_file_name_field_shows_only_when_a_file_is_chosen(t: *testing.T) {
    let folder = path_browser_rig(path_browser_view(none))
    t.is_true(ui.bounds_of(folder.cx, "files-file-entry") == none)
    let file = path_browser_rig(path_browser_view(some("sales.bak")))
    t.is_true(ui.bounds_of(file.cx, "files-file-entry") != none)
}

fn test_path_browser_rows_from_the_last_listing_are_hidden_while_the_next_one_loads(t: *testing.T) {
    var loading = path_browser_view(none)
    loading.loading = true
    let r = path_browser_rig(loading)
    t.is_true(ui.bounds_of(r.cx, path_browser_row_id("files", 0)) == none)
    t.is_true(ui.bounds_of(r.cx, "files-card") != none)
}
