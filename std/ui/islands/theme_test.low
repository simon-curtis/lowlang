import std/testing
import std/ui/geometry

fn byte(channel: f32) -> u32 {
    u32(floor(channel * 255.0 + 0.5))
}

fn hex(c: geometry.Color) -> u32 {
    (byte(c.r) << 16) | (byte(c.g) << 8) | byte(c.b)
}

fn alpha(c: geometry.Color) -> u32 {
    byte(c.a)
}

fn same_hex(t: *testing.T, got: geometry.Color, want: u32) {
    t.equal(hex(got), want)
    t.equal(alpha(got), 255)
}

fn test_the_default_theme_is_pink(t: *testing.T) {
    let pink = default_theme()
    t.equal(pink.scheme.name, "pink")
    same_hex(t, pink.accent, 0xe874d9)
}

fn test_the_neutral_tokens_match_the_rust_hex(t: *testing.T) {
    let pink = default_theme()
    same_hex(t, pink.canvas, 0x0b0b0e)
    same_hex(t, pink.surface, 0x131316)
    same_hex(t, pink.raised, 0x1c1c21)
    same_hex(t, pink.border, 0x26262b)
    same_hex(t, pink.text, 0xe7e7ea)
    same_hex(t, pink.muted, 0xa9a9b2)
    same_hex(t, pink.faint, 0x8a8a94)
    same_hex(t, pink.on_accent, 0x16161a)
    same_hex(t, pink.danger, 0xef5f67)
    same_hex(t, pink.ok, 0x4cc38a)
    same_hex(t, pink.warn, 0xf2b35b)
}

fn test_the_translucent_tokens_carry_their_alpha(t: *testing.T) {
    let pink = default_theme()
    t.equal(hex(pink.hover), 0xffffff)
    t.equal(alpha(pink.hover), 0x0b)
    t.equal(alpha(pink.rail_selected), 0x24)
    t.equal(alpha(pink.control), 0x0f)
    t.equal(alpha(pink.selected), 0x14)
    t.equal(alpha(pink.scrim), 0xa6)
    t.equal(hex(pink.scrim), 0x000000)
    t.equal(hex(pink.find_match), 0xf5c451)
    t.equal(alpha(pink.find_match), 0x40)
    t.equal(alpha(pink.find_current), 0x99)
    t.equal(alpha(pink.danger_soft), 0x26)
    t.equal(alpha(pink.current_line), 0x08)
    t.equal(alpha(pink.whitespace), 0x2e)
    t.equal(hex(pink.scrollbar), 0x3b3c3c)
    t.equal(hex(pink.scrollbar_hot), 0xc0c0c1)
}

fn test_the_accent_tints_follow_the_scheme(t: *testing.T) {
    let pink = default_theme()
    t.equal(hex(pink.accent_soft), 0xe874d9)
    t.equal(alpha(pink.accent_soft), 0x24)
    t.equal(hex(pink.selection), 0xe874d9)
    t.equal(alpha(pink.selection), 0x40)
    t.equal(hex(pink.line_flash), 0xe874d9)
    t.equal(alpha(pink.line_flash), 0x38)
    let teal = theme("teal")
    same_hex(t, teal.accent, 0x34c6a8)
    t.equal(hex(teal.accent_soft), 0x34c6a8)
}

fn test_the_connector_is_the_muted_colour_at_seventy_percent(t: *testing.T) {
    let pink = default_theme()
    t.equal(hex(pink.connector), 0xa9a9b2)
    t.equal(alpha(pink.connector), 179)
}

fn test_the_syntax_colours_match_the_rust_hex(t: *testing.T) {
    let pink = default_theme()
    same_hex(t, pink.syntax_plain, 0xe7e7ea)
    same_hex(t, pink.syntax_comment, 0x8a8a94)
    same_hex(t, pink.syntax_keyword, 0xef9ee4)
    same_hex(t, pink.syntax_string, 0xa5d6a7)
    same_hex(t, pink.syntax_number, 0xf2b880)
    same_hex(t, pink.syntax_variable, 0xe6cf8a)
}

fn test_blend_rounds_each_channel(t: *testing.T) {
    t.equal(blend(0x000000, 0xffffff, 0.5), 0x808080)
    t.equal(blend(0xe874d9, 0xffffff, 0.0), 0xe874d9)
    t.equal(blend(0xe874d9, 0xffffff, 1.0), 0xffffff)
}

fn test_an_unknown_scheme_name_gives_the_default_theme(t: *testing.T) {
    same_hex(t, theme("nope").accent, 0xe874d9)
}

fn test_the_popover_shadow_matches_the_rust_values(t: *testing.T) {
    let shadow = popover_shadow()
    t.equal(shadow.y, 12.0)
    t.equal(shadow.blur, 32.0)
    t.equal(shadow.spread, -8.0)
    t.equal(alpha(shadow.color), 0x73)
}
