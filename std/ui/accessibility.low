/// An application's accessibility tree on the desktop's accessibility service.
///
/// Releasing it withdraws the application from the service.
pub struct Accessibility {
    release: fn()
    drop release()
}

/// Exports the elements of the window of `cx` to assistive technology such as a screen reader, under the application name `application`, and keeps the export current after every frame.
///
/// Each element the frame drew becomes one accessible object whose name is `label`, whose role follows `role`, and whose position is `bounds`. An element with a button, link, check box, tab or menu item role takes the `Action` interface, whose action presses it as `click_element` does; a field takes the keyboard focus on `GrabFocus`, as `set_focus` does; a text run or heading serves its text. What assistive technology asks for runs on the context's green thread before the next frame. On Linux the tree goes to the AT-SPI2 bus the session names, and the call fails with `Unsupported` when the session has none. On Windows UI Automation is not implemented and the call fails with `Unsupported`.
pub fn enable_accessibility(cx: Context, application: str) -> Accessibility ! Error {
    attach_accessibility(cx, application) catch Platform
}
