/// Opens the system fonts through DirectWrite, which only the Windows target has: other targets fail with `Unavailable`.
pub fn open() -> *Fonts ! Error {
    fail Unavailable
}

/// Returns the index of the face of `family` closest to `weight` and `style`, picking it on first use: from the fonts added with `add_font` when one has the family, else from the installed fonts. `style` is `0` for upright, `1` for oblique and `2` for italic; a family with no face of that style gives its upright face, which DirectWrite shears.
pub fn face(fonts: *Fonts, family: str, weight: i64, style: i64) -> i64 ! Error {
    fail Unavailable
}

/// Adds the font file in `data` to the fonts `face` picks from; a family it holds is used before an installed family of the same name. The bytes stay pinned until the process ends. Fails when `data` is not a font.
pub fn add_font(fonts: *Fonts, data: str) ! Error {
    fail Unavailable
}

/// Shapes `text` as one line of face `index` at `size` pixels with ligatures and contextual alternates on, and returns its runs and metrics.
pub fn layout(fonts: *Fonts, index: i64, text: str, size: f32) -> Line ! Error {
    fail Unavailable
}

/// Returns the underline and strikethrough strokes face `index` recommends at `size` pixels, from the face's `DWRITE_FONT_METRICS`.
pub fn strokes(fonts: *Fonts, index: i64, size: f32) -> Strokes ! Error {
    fail Unavailable
}

/// Rasterises glyph `glyph` of face `index` at `size` logical pixels under `scale` device pixels per logical pixel, with the origin `variant` quarter pixels right of a pixel edge, as ClearType stripes when `subpixel` and as grey coverage otherwise.
pub fn rasterize(fonts: *Fonts, index: i64, glyph: i64, size: f32, scale: f32, variant: i64, subpixel: bool) -> Bitmap ! Error {
    fail Unavailable
}

/// Reads the system's text rendering parameters.
pub fn rendering(fonts: *Fonts) -> Rendering ! Error {
    fail Unavailable
}

/// Reports whether the system draws text with ClearType.
pub fn subpixel_enabled() -> bool {
    false
}
