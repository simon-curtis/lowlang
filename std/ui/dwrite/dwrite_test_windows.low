import std/testing

fn open_face(t: *testing.T) -> *Fonts? {
    let fonts = open() catch {
        e => {
            testing.fatal(t, describe(e))
            return none
        }
    }
    fonts
}

fn is_missing(fonts: *Fonts, family: str) -> bool {
    face(fonts, family, 400) catch {
        NoFont => return true
        e => return false
    }
    false
}

fn test_an_unknown_family_has_no_face(t: *testing.T) {
    let fonts = open_face(t) ?? return
    testing.is_true(t, is_missing(fonts, "No Such Family Anywhere"))
    testing.is_true(t, !is_missing(fonts, "Segoe UI"))
}

fn test_a_line_has_one_glyph_per_letter_and_a_positive_advance(t: *testing.T) {
    let fonts = open_face(t) ?? return
    let index = face(fonts, "Segoe UI", 400) or return
    let line = layout(fonts, index, "AB", 13.0) or return
    testing.equal(t, line.runs.len, 1)
    testing.equal(t, line.runs[0].glyphs.len, 2)
    testing.is_true(t, line.runs[0].glyphs[1].x > 0.0)
    testing.is_true(t, line.width > line.runs[0].glyphs[1].x)
    testing.is_true(t, line.ascent > 0.0)
    testing.is_true(t, line.descent > 0.0)
}

fn test_subpixel_bitmaps_hold_three_stripes_per_pixel(t: *testing.T) {
    let fonts = open_face(t) ?? return
    let index = face(fonts, "Segoe UI", 400) or return
    let line = layout(fonts, index, "A", 13.0) or return
    let id = line.runs[0].glyphs[0].id
    let stripes = rasterize(fonts, index, id, 13.0, 1.0, 0, true) or return
    let grey = rasterize(fonts, index, id, 13.0, 1.0, 0, false) or return
    testing.is_true(t, stripes.width > 0)
    testing.equal(t, stripes.pixels.len, stripes.width * stripes.height * 3)
    testing.equal(t, grey.pixels.len, grey.width * grey.height)
    testing.is_true(t, stripes.top < 0)
}

fn test_the_four_horizontal_variants_move_the_ink(t: *testing.T) {
    let fonts = open_face(t) ?? return
    let index = face(fonts, "Segoe UI", 400) or return
    let line = layout(fonts, index, "A", 13.0) or return
    let id = line.runs[0].glyphs[0].id
    let first = rasterize(fonts, index, id, 13.0, 1.0, 0, true) or return
    let half = rasterize(fonts, index, id, 13.0, 1.0, 2, true) or return
    testing.is_true(t, differs(first, half))
}

fn differs(a: Bitmap, b: Bitmap) -> bool {
    if a.left != b.left || a.width != b.width || a.pixels.len != b.pixels.len {
        return true
    }
    for i in 0..a.pixels.len {
        if a.pixels[i] != b.pixels[i] {
            return true
        }
    }
    false
}

fn test_a_space_has_no_ink(t: *testing.T) {
    let fonts = open_face(t) ?? return
    let index = face(fonts, "Segoe UI", 400) or return
    let line = layout(fonts, index, " ", 13.0) or return
    let id = line.runs[0].glyphs[0].id
    let blank = rasterize(fonts, index, id, 13.0, 1.0, 0, true) or return
    testing.equal(t, blank.width, 0)
    testing.equal(t, blank.pixels.len, 0)
}

fn test_the_rendering_parameters_are_usable(t: *testing.T) {
    let fonts = open_face(t) ?? return
    let params = rendering(fonts) or return
    testing.equal(t, params.gamma.len, 4)
    testing.is_true(t, params.subpixel_contrast >= 0.0)
    testing.is_true(t, params.grayscale_contrast >= 0.0)
}

fn bundled() -> str {
    embed("../font/GoRegular.ttf")
}

fn test_an_added_font_is_found_by_its_family(t: *testing.T) {
    let fonts = open_face(t) ?? return
    testing.is_true(t, is_missing(fonts, "Go"))
    add_font(fonts, bundled()) or return
    testing.is_true(t, !is_missing(fonts, "Go"))
}

fn test_an_added_font_shapes_a_line(t: *testing.T) {
    let fonts = open_face(t) ?? return
    add_font(fonts, bundled()) or return
    let index = face(fonts, "Go", 400) or return
    let line = layout(fonts, index, "AB", 13.0) or return
    testing.equal(t, line.runs[0].glyphs.len, 2)
    testing.is_true(t, line.width > 0.0)
    let bitmap = rasterize(fonts, index, line.runs[0].glyphs[0].id, 13.0, 1.0, 0, false) or return
    testing.is_true(t, bitmap.width > 0)
}

fn test_data_that_is_not_a_font_is_rejected(t: *testing.T) {
    let fonts = open_face(t) ?? return
    var rejected = false
    add_font(fonts, "not a font") catch {
        e => { rejected = true }
    }
    testing.is_true(t, rejected)
}

