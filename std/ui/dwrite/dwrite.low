/// The ways a native text call can fail.
pub enum Error {
    /// This target has no native text rasteriser.
    Unavailable
    /// No installed font matches the family and weight asked for.
    NoFont
    /// A system call returned a failing `HRESULT`. `call` names the call.
    Call(call: str, result: i64)
}

/// Returns a one-line description of `e`.
pub fn describe(e: Error) -> str {
    match e {
        Unavailable => "this target has no native text rasteriser"
        NoFont => "no installed font matches the family and weight"
        Call(call, result) => "{call} failed with {result:x}"
    }
}

struct Face {
    object: ptr
    family: str
    weight: i64
}

/// The system's installed fonts and the faces picked from them.
pub struct Fonts {
    factory: ptr
    set: ptr
    renderer: ptr
    sink: i64[]
    sink_at: ptr
    faces: Face[]
}

/// A glyph of a shaped line.
pub struct Glyph {
    /// The glyph index in its face.
    pub id: i64
    /// The pen position from the line's left edge, in pixels, with the glyph's offset applied.
    pub x: f32
    /// The distance the glyph sits above its baseline, in pixels.
    pub y: f32
}

/// The glyphs of one face in a shaped line.
pub struct Run {
    /// The index of the face that draws the glyphs, as `Fonts` numbers them.
    pub face: i64
    /// The glyphs in order.
    pub glyphs: Glyph[]
}

/// A line of text shaped at one size.
pub struct Line {
    /// The runs from the left.
    pub runs: Run[]
    /// The distance from the top of the line to its baseline, in pixels.
    pub ascent: f32
    /// The distance from the baseline to the bottom of the line, in pixels.
    pub descent: f32
    /// The advance of the whole line, in pixels.
    pub width: f32
}

/// The coverage of one glyph, with its box relative to the glyph's origin.
pub struct Bitmap {
    /// The distance from the origin to the left edge, in whole pixels.
    pub left: i64
    /// The distance from the origin to the top edge, in whole pixels; negative above the baseline.
    pub top: i64
    /// The width in pixels; zero for a glyph with no ink.
    pub width: i64
    /// The height in pixels.
    pub height: i64
    /// One coverage byte per pixel, or three (red, green and blue stripe) per pixel for a subpixel bitmap.
    pub pixels: u8[]
}

fn gamma_table() -> f32[] {
    [
        0.0000, 0.0000, 0.0000, 0.0000,
        0.0166, -0.0807, 0.2227, -0.0751,
        0.0350, -0.1760, 0.4325, -0.1370,
        0.0543, -0.2821, 0.6302, -0.1876,
        0.0739, -0.3963, 0.8167, -0.2287,
        0.0933, -0.5161, 0.9926, -0.2616,
        0.1121, -0.6395, 1.1588, -0.2877,
        0.1300, -0.7649, 1.3159, -0.3080,
        0.1469, -0.8911, 1.4644, -0.3234,
        0.1627, -1.0170, 1.6051, -0.3347,
        0.1773, -1.1420, 1.7385, -0.3426,
        0.1908, -1.2652, 1.8650, -0.3476,
        0.2031, -1.3864, 1.9851, -0.3501
    ]
}

/// Returns the four coefficients of the text alpha correction for `gamma`, from the table DirectWrite's reference renderer ships: gamma `1.0` to `2.2` in steps of `0.1`, the nearest step to `gamma`.
pub fn gamma_ratios(gamma: f32) -> f32[] {
    var step = i64(floor(gamma * 10.0 + 0.5))
    if step < 10 {
        step = 10
    }
    if step > 22 {
        step = 22
    }
    let table = gamma_table()
    let base = (step - 10) * 4
    let norm13 = f32(65536.0 / (255.0 * 255.0) * 4.0)
    let norm24 = f32(256.0 / 255.0 * 4.0)
    [
        table[base] / 4.0 * norm13,
        table[base + 1] / 4.0 * norm24,
        table[base + 2] / 4.0 * norm13,
        table[base + 3] / 4.0 * norm24
    ]
}

/// Returns the family that text with no family of its own is drawn in.
pub fn default_family() -> str {
    "Segoe UI"
}

/// The values the text shaders read: the gamma ratios, the contrast for grey and for subpixel text, and the stripe order.
pub struct Rendering {
    pub gamma: f32[]
    pub grayscale_contrast: f32
    pub subpixel_contrast: f32
    pub bgr: bool
}
