import std/testing

fn test_gamma_one_needs_no_correction(t: *testing.T) {
    let ratios = gamma_ratios(1.0)
    testing.equal(t, ratios.len, 4)
    for r in ratios {
        testing.close_to(t, f64(r), 0.0, 0.0)
    }
}

fn test_gamma_picks_the_nearest_step_and_clamps(t: *testing.T) {
    let low = gamma_ratios(0.2)
    let one = gamma_ratios(1.0)
    let high = gamma_ratios(9.0)
    let top = gamma_ratios(2.2)
    for i in 0..4 {
        testing.close_to(t, f64(low[i]), f64(one[i]), 0.0)
        testing.close_to(t, f64(high[i]), f64(top[i]), 0.0)
    }
    let near = gamma_ratios(1.84)
    let exact = gamma_ratios(1.8)
    for i in 0..4 {
        testing.close_to(t, f64(near[i]), f64(exact[i]), 0.0)
    }
}

fn test_gamma_scales_the_table_by_the_reference_norms(t: *testing.T) {
    let ratios = gamma_ratios(2.2)
    let norm13 = 65536.0 / (255.0 * 255.0) * 4.0
    let norm24 = 256.0 / 255.0 * 4.0
    testing.close_to(t, f64(ratios[0]), 0.2031 / 4.0 * norm13, 0.000001)
    testing.close_to(t, f64(ratios[1]), -1.3864 / 4.0 * norm24, 0.000001)
    testing.close_to(t, f64(ratios[2]), 1.9851 / 4.0 * norm13, 0.000001)
    testing.close_to(t, f64(ratios[3]), -0.3501 / 4.0 * norm24, 0.000001)
}

fn test_every_error_describes_itself(t: *testing.T) {
    testing.is_true(t, describe(Unavailable).len > 0)
    testing.is_true(t, describe(NoFont).len > 0)
    testing.is_true(t, describe(Call("Draw", 0x80004005)).len > 0)
}
