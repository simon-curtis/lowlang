import std/testing
import std/ui/geometry
import std/ui/platform

fn bar_cx(height: f32) -> Context {
    let cx = headless(rgb(0xffffff))
    cx.state.decoration_height = fn() -> f32 { height }
    cx
}

fn content() -> Element {
    div().id("content").size_full().background(rgb(0x123456))
}

fn bounds_by_id(cx: Context, id: str) -> geometry.Rect {
    for info in elements(cx) {
        if info.id == id {
            return info.bounds
        }
    }
    geometry.Rect {}
}

fn test_a_window_with_no_decoration_height_is_the_content_alone(t: *testing.T) {
    let cx = bar_cx(0.0)
    frame(cx, content, geometry.size(300.0, 200.0), 1.0)
    let area = bounds_by_id(cx, "content")
    testing.equal(t, area.y, 0.0)
    testing.equal(t, area.height, 200.0)
    testing.is_true(t, window_control_area_at(cx, 10.0, 10.0) == none)
}

fn test_the_content_sits_under_the_title_bar_the_decoration_height_asks_for(t: *testing.T) {
    let cx = bar_cx(32.0)
    frame(cx, content, geometry.size(300.0, 232.0), 1.0)
    let area = bounds_by_id(cx, "content")
    testing.equal(t, area.y, 32.0)
    testing.equal(t, area.width, 300.0)
    testing.equal(t, area.height, 200.0)
}

fn test_the_title_bar_answers_the_control_areas_the_platform_asks_for(t: *testing.T) {
    let cx = bar_cx(32.0)
    frame(cx, content, geometry.size(300.0, 232.0), 1.0)
    testing.is_true(t, window_control_area_at(cx, 10.0, 10.0) == some(platform.WindowControlArea.Drag))
    testing.is_true(t, window_control_area_at(cx, 280.0, 10.0) == some(platform.WindowControlArea.Close))
    testing.is_true(t, window_control_area_at(cx, 240.0, 10.0) == some(platform.WindowControlArea.Max))
    testing.is_true(t, window_control_area_at(cx, 200.0, 10.0) == some(platform.WindowControlArea.Min))
    testing.is_true(t, window_control_area_at(cx, 150.0, 100.0) == none)
}

fn test_the_title_bar_shows_the_window_title(t: *testing.T) {
    let cx = bar_cx(32.0)
    set_title(cx, "Notes")
    frame(cx, content, geometry.size(300.0, 232.0), 1.0)
    var shown = false
    for info in elements(cx) {
        if info.text == "Notes" {
            shown = true
        }
    }
    testing.is_true(t, shown)
}
