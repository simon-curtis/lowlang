import std/testing
import std/ui/geometry

fn empty() -> Element {
    div()
}

fn counter(cx: Context) -> Signal[i64] {
    signal(cx, 0)
}

fn bump(s: Signal[i64]) -> fn() {
    fn() { update(s, fn(n: i64) -> i64 { n + 1 }) }
}

fn test_after_runs_once_when_the_clock_reaches_its_time(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let runs = counter(cx)
    after(cx, 100, bump(runs))
    advance_clock(cx, 99)
    testing.equal(t, get(runs), 0)
    advance_clock(cx, 1)
    testing.equal(t, get(runs), 1)
    advance_clock(cx, 1000)
    testing.equal(t, get(runs), 1)
}

fn test_a_timer_that_ran_makes_a_frame_due(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    frame(cx, empty, geometry.size(100.0, 100.0), 1.0)
    testing.is_false(t, frame_due(cx))
    after(cx, 10, fn() {})
    advance_clock(cx, 9)
    testing.is_false(t, frame_due(cx))
    advance_clock(cx, 1)
    testing.is_true(t, frame_due(cx))
}

fn test_cancel_timer_stops_a_timer_before_it_runs(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let runs = counter(cx)
    let id = after(cx, 100, bump(runs))
    let other = after(cx, 100, bump(runs))
    cancel_timer(cx, id)
    advance_clock(cx, 100)
    testing.equal(t, get(runs), 1)
    cancel_timer(cx, other)
}

fn test_every_runs_on_each_tick_under_one_id(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let runs = counter(cx)
    let id = every(cx, 50, bump(runs))
    advance_clock(cx, 49)
    testing.equal(t, get(runs), 0)
    advance_clock(cx, 1)
    testing.equal(t, get(runs), 1)
    advance_clock(cx, 50)
    testing.equal(t, get(runs), 2)
    cancel_timer(cx, id)
    advance_clock(cx, 500)
    testing.equal(t, get(runs), 2)
}

fn test_every_runs_once_for_a_clock_that_jumps_over_several_ticks(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let runs = counter(cx)
    every(cx, 100, bump(runs))
    advance_clock(cx, 1000)
    testing.equal(t, get(runs), 1)
    advance_clock(cx, 99)
    testing.equal(t, get(runs), 1)
    advance_clock(cx, 1)
    testing.equal(t, get(runs), 2)
}

fn test_every_with_no_period_ticks_each_millisecond(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let runs = counter(cx)
    every(cx, 0, bump(runs))
    advance_clock(cx, 1)
    advance_clock(cx, 1)
    testing.equal(t, get(runs), 2)
}

fn test_a_repeating_timer_can_cancel_itself(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let runs = counter(cx)
    let own = signal(cx, i64(0))
    let id = every(cx, 10, fn() {
        update(runs, fn(n: i64) -> i64 { n + 1 })
        cancel_timer(cx, get(own))
    })
    set(own, id)
    advance_clock(cx, 10)
    advance_clock(cx, 10)
    testing.equal(t, get(runs), 1)
}

fn test_now_reads_the_clock_and_holds_still_inside_a_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let seen = signal(cx, i64(-1))
    let view = fn() -> Element {
        advance_clock(cx, 5)
        set(seen, now(cx))
        div()
    }
    advance_clock(cx, 30)
    testing.equal(t, now(cx), 30)
    frame(cx, view, geometry.size(100.0, 100.0), 1.0)
    testing.equal(t, get(seen), 30)
    testing.equal(t, now(cx), 35)
}

fn test_animate_follows_the_clock_until_it_returns_false(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let seen = signal(cx, i64(-1))
    advance_clock(cx, 100)
    let started = now(cx)
    animate(cx, fn(at: i64) -> bool {
        set(seen, at - started)
        at - started < 300
    })
    let size = geometry.size(100.0, 100.0)
    frame(cx, empty, size, 1.0)
    testing.equal(t, get(seen), 0)
    testing.is_true(t, frame_due(cx))
    advance_clock(cx, 120)
    frame(cx, empty, size, 1.0)
    testing.equal(t, get(seen), 120)
    testing.is_true(t, frame_due(cx))
    advance_clock(cx, 200)
    frame(cx, empty, size, 1.0)
    testing.equal(t, get(seen), 320)
    testing.is_false(t, frame_due(cx))
    advance_clock(cx, 50)
    frame(cx, empty, size, 1.0)
    testing.equal(t, get(seen), 320)
}

fn test_animate_keeps_frames_due_while_it_runs(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    animate(cx, fn(at: i64) -> bool { at < 10 })
    let size = geometry.size(100.0, 100.0)
    frame(cx, empty, size, 1.0)
    testing.is_true(t, frame_due(cx))
    frame(cx, empty, size, 1.0)
    testing.is_true(t, frame_due(cx))
    advance_clock(cx, 10)
    frame(cx, empty, size, 1.0)
    testing.is_false(t, frame_due(cx))
}

fn test_cancel_timer_stops_an_animation(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let calls = counter(cx)
    let id = animate(cx, fn(at: i64) -> bool {
        update(calls, fn(n: i64) -> i64 { n + 1 })
        true
    })
    let size = geometry.size(100.0, 100.0)
    frame(cx, empty, size, 1.0)
    cancel_timer(cx, id)
    frame(cx, empty, size, 1.0)
    testing.equal(t, get(calls), 1)
    testing.is_false(t, frame_due(cx))
}

fn test_an_animation_started_by_an_animation_runs_in_the_next_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let inner = counter(cx)
    animate(cx, fn(at: i64) -> bool {
        animate(cx, fn(later: i64) -> bool {
            update(inner, fn(n: i64) -> i64 { n + 1 })
            false
        })
        false
    })
    let size = geometry.size(100.0, 100.0)
    frame(cx, empty, size, 1.0)
    testing.equal(t, get(inner), 0)
    frame(cx, empty, size, 1.0)
    testing.equal(t, get(inner), 1)
}

fn test_a_headless_context_does_not_prefer_reduced_motion(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    testing.is_false(t, prefers_reduced_motion(cx))
}

fn test_set_reduced_motion_overrides_the_system_for_every_window(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let other = window_context(opened(cx))
    set_reduced_motion(cx, some(true))
    testing.is_true(t, prefers_reduced_motion(cx))
    testing.is_true(t, prefers_reduced_motion(other))
    set_reduced_motion(cx, some(false))
    testing.is_false(t, prefers_reduced_motion(other))
    set_reduced_motion(cx, none)
    testing.is_false(t, prefers_reduced_motion(cx))
}

fn test_the_system_setting_is_read_at_most_once_a_second(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let sh = cx.state.shared
    let asked = signal(cx, i64(0))
    let reduced = signal(cx, false)
    sh.system_motion = fn() -> bool {
        update(asked, fn(n: i64) -> i64 { n + 1 })
        get(reduced)
    }
    testing.is_false(t, prefers_reduced_motion(cx))
    set(reduced, true)
    testing.is_false(t, prefers_reduced_motion(cx))
    testing.equal(t, get(asked), 1)
    advance_clock(cx, motion_refresh_ms)
    testing.is_true(t, prefers_reduced_motion(cx))
    testing.equal(t, get(asked), 2)
}
