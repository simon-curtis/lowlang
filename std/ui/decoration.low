import std/ui/geometry
import std/ui/platform

const caption_width: f32 = 46.0

fn decorated(cx: Context, content: Element) -> Element {
    let height = cx.state.decoration_height()
    if height <= 0.0 {
        return content
    }
    div().column().size_full().children() {
        caption_bar(cx, height),
        div().grow(1.0).min_height(0.0).overflow_hidden().child(content),
    }
}

fn caption_bar(cx: Context, height: f32) -> Element {
    let ink = if window_focused(cx) { geometry.rgb(0x2e3436) } else { geometry.rgb(0x8d9091) }
    div().row().height(height).items_center().background(geometry.rgb(0xebebeb)).border_bottom(1.0).border_color(geometry.rgb(0xcdcfd0)).window_control_area(platform.WindowControlArea.Drag).children() {
        div().grow(1.0).min_width(0.0).padding_xy(12.0, 0.0).child(text(window_title(cx)).text_size(14.0).text_color(ink).truncate()),
        caption_button(platform.WindowControlArea.Min, height, geometry.rgb(0xd9dbdc), div().width(10.0).height(1.0).background(ink)),
        caption_button(platform.WindowControlArea.Max, height, geometry.rgb(0xd9dbdc), div().size(10.0, 10.0).border(1.0, ink)),
        caption_button(platform.WindowControlArea.Close, height, geometry.rgb(0xe0564e), text("\u{00d7}").text_size(20.0).text_color(ink)),
    }
}

fn caption_button(area: platform.WindowControlArea, height: f32, hovered: geometry.Color, glyph: Element) -> Element {
    div().size(caption_width, height).items_center().justify_center().window_control_area(area).hover(fn(v: Visual) -> Visual { v.with_background(hovered) }).child(glyph)
}
