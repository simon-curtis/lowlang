import std/ui/geometry
import std/ui/scene

const squiggle_rise: f32 = 3.0

struct MarkSpan {
    left: f32
    right: f32
}

fn mark_under(m: TextMark) -> bool {
    m.start < m.end && match m.style {
        Fill => true
        _ => false
    }
}

fn mark_span(r: AreaRow, m: TextMark, origin: f32) -> MarkSpan {
    let start = area_snap(r.text, m.start)
    let stop = area_snap(r.text, if m.end < start { start } else { m.end })
    MarkSpan { left: origin + area_x(r.shaped, start), right: origin + area_x(r.shaped, stop) }
}

fn paint_foot_line(mut sc: scene.Scene, span: MarkSpan, bottom: f32, rise: f32, wavy: bool, tint: geometry.Color, scale: f32) {
    let bounds = geometry.snap(geometry.rect(span.left, bottom - rise, span.right - span.left, rise), scale)
    let thickness = geometry.snap_stroke(1.0, scale)
    let wave: f32 = if wavy { 1.0 } else { 0.0 }
    scene.push_underline(mut sc, scene.Underline { bounds, color: tint, thickness, wavy: wave })
}

fn paint_text_mark(mut sc: scene.Scene, r: AreaRow, m: TextMark, origin: f32, line_height: f32, tint: geometry.Color, scale: f32) {
    let span = mark_span(r, m, origin)
    if span.right <= span.left {
        solid(mut sc, geometry.rect(span.left, r.top, 1.0, line_height), tint, scale)
        return
    }
    let bottom = r.top + line_height
    match m.style {
        Fill => solid(mut sc, geometry.rect(span.left, r.top, span.right - span.left, line_height), tint, scale)
        Underline => paint_foot_line(mut sc, span, bottom, 1.0, false, tint, scale)
        Squiggle => paint_foot_line(mut sc, span, bottom, squiggle_rise, true, tint, scale)
        Bar => solid(mut sc, geometry.rect(span.right, r.top, 1.0, line_height), tint, scale)
    }
}

fn paint_text_marks(mut sc: scene.Scene, r: AreaRow, over: bool, origin: f32, line_height: f32, opacity: f32, scale: f32) {
    for m in r.marks {
        if mark_under(m) != over {
            paint_text_mark(mut sc, r, m, origin, line_height, faded(m.color, opacity), scale)
        }
    }
}

fn paint_run_backgrounds(mut sc: scene.Scene, r: AreaRow, origin: f32, line_height: f32, opacity: f32, scale: f32) {
    for p in r.shaped.pieces {
        match p.background {
            some(c) => solid(mut sc, geometry.rect(origin + p.x, r.top, p.layout.lines[0].end, line_height), faded(c, opacity), scale)
            none => {}
        }
    }
}
