import std/ui/geometry
import std/ui/scene

const squiggle_period = 4

struct MarkSpan {
    left: f32
    right: f32
}

fn mark_under(m: TextMark) -> bool {
    m.start < m.end && match m.style {
        Fill => true
        _ => false
    }
}

fn mark_span(r: AreaRow, m: TextMark, origin: f32) -> MarkSpan {
    let start = area_snap(r.text, m.start)
    let stop = area_snap(r.text, if m.end < start { start } else { m.end })
    MarkSpan { left: origin + area_x(r.shaped, start), right: origin + area_x(r.shaped, stop) }
}

fn squiggle_offset(i: i64) -> f32 {
    let k = i % squiggle_period
    f32(if k == 3 { 1 } else { k })
}

fn paint_squiggle(mut sc: scene.Scene, span: MarkSpan, top: f32, bounds: geometry.Rect, tint: geometry.Color, scale: f32) {
    let from = larger(span.left, bounds.x)
    let to = if span.right < bounds.x + bounds.width { span.right } else { bounds.x + bounds.width }
    var i = i64(floor(from - span.left))
    for span.left + f32(i) < to {
        solid(mut sc, geometry.rect(span.left + f32(i), top + squiggle_offset(i), 1.0, 1.0), tint, scale)
        i += 1
    }
}

fn paint_text_mark(mut sc: scene.Scene, r: AreaRow, m: TextMark, origin: f32, bounds: geometry.Rect, line_height: f32, tint: geometry.Color, scale: f32) {
    let span = mark_span(r, m, origin)
    if span.right <= span.left {
        solid(mut sc, geometry.rect(span.left, r.top, 1.0, line_height), tint, scale)
        return
    }
    match m.style {
        Fill => solid(mut sc, geometry.rect(span.left, r.top, span.right - span.left, line_height), tint, scale)
        Underline => solid(mut sc, geometry.rect(span.left, r.top + line_height - 1.0, span.right - span.left, 1.0), tint, scale)
        Squiggle => paint_squiggle(mut sc, span, r.top + line_height - 3.0, bounds, tint, scale)
        Bar => solid(mut sc, geometry.rect(span.right, r.top, 1.0, line_height), tint, scale)
    }
}

fn paint_text_marks(mut sc: scene.Scene, r: AreaRow, over: bool, origin: f32, bounds: geometry.Rect, line_height: f32, opacity: f32, scale: f32) {
    for m in r.marks {
        if mark_under(m) == over {
            continue
        }
        paint_text_mark(mut sc, r, m, origin, bounds, line_height, faded(m.color, opacity), scale)
    }
}

fn paint_run_backgrounds(mut sc: scene.Scene, r: AreaRow, origin: f32, line_height: f32, opacity: f32, scale: f32) {
    for p in r.shaped.pieces {
        match p.background {
            some(c) => solid(mut sc, geometry.rect(origin + p.x, r.top, p.layout.lines[0].end, line_height), faded(c, opacity), scale)
            none => {}
        }
    }
}
