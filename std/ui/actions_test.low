import std/testing
import std/ui/platform

fn binding_of(keys: str, action: str, context: str) -> KeyBinding {
    key_binding(keys, action, context) catch {
        e => panic("cannot bind {keys}")
    }
}

fn type_char(cx: Context, text: str, modifiers: platform.Modifiers) {
    let typed = if modifiers.control || modifiers.alt || modifiers.super { "" } else { text }
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(text), text: typed, modifiers }))
}

fn type_plain(cx: Context, text: str) {
    type_char(cx, text, platform.Modifiers {})
}

fn type_ctrl(cx: Context, text: str) {
    type_char(cx, text, platform.Modifiers { control: true })
}

fn action_log(cx: Context) -> Signal[str] {
    signal(cx, "")
}

fn add_note(log: Signal[str], s: str) {
    let before = get(log)
    let gap = if before == "" { "" } else { " " }
    set(log, "{before}{gap}{s}")
}

fn pending_text(cx: Context) -> str {
    var out = ""
    for k in pending_keystrokes(cx) {
        out = "{out}[{keystroke_text(k)}]"
    }
    out
}

fn typing_field(text: Signal[str]) -> Element {
    field(get(text)).id("f").width(200.0).on_change(fn(s: str) { set(text, s) })
}

fn test_an_action_bubbles_from_the_focused_element_until_a_handler_stops_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = action_log(cx)
    let go_on = signal(cx, false)
    let inner = fn() {
        add_note(log, "inner")
        if get(go_on) {
            propagate(cx)
        }
    }
    let view = fn() -> Element {
        let button = div().id("b").size(20.0, 20.0).focusable().on_action("save", inner)
        div().id("outer").size(100.0, 100.0).on_action("save", fn() { add_note(log, "outer") }).child(button)
    }
    bind_keys(cx, [binding_of("ctrl-s", "save", "")])
    frame(cx, view, window(), 1.0)
    set_focus(cx, "b")
    type_ctrl(cx, "s")
    testing.equal(t, get(log), "inner")
    set(go_on, true)
    type_ctrl(cx, "s")
    testing.equal(t, get(log), "inner inner outer")
}

fn test_capture_handlers_run_outermost_first_and_can_stop_the_action(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = action_log(cx)
    let stop = signal(cx, false)
    let outer_capture = fn() {
        add_note(log, "capture outer")
        if get(stop) {
            stop_propagation(cx)
        }
    }
    let view = fn() -> Element {
        let button = div().id("b").size(20.0, 20.0).focusable()
            .capture_action("save", fn() { add_note(log, "capture inner") })
            .on_action("save", fn() { add_note(log, "inner") })
        div().size(100.0, 100.0).capture_action("save", outer_capture).child(button)
    }
    bind_keys(cx, [binding_of("ctrl-s", "save", "")])
    frame(cx, view, window(), 1.0)
    set_focus(cx, "b")
    type_ctrl(cx, "s")
    testing.equal(t, get(log), "capture outer capture inner inner")
    set(log, "")
    set(stop, true)
    type_ctrl(cx, "s")
    testing.equal(t, get(log), "capture outer")
}

fn test_with_nothing_focused_the_root_receives_the_action(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = action_log(cx)
    let view = fn() -> Element {
        div().size(100.0, 100.0).on_action("quit", fn() { add_note(log, "quit") }).child(div().id("b").size(20.0, 20.0).focusable())
    }
    bind_keys(cx, [binding_of("ctrl-q", "quit", "")])
    frame(cx, view, window(), 1.0)
    type_ctrl(cx, "q")
    testing.equal(t, get(log), "quit")
    testing.equal(t, dispatch_action(cx, "quit"), true)
    testing.equal(t, dispatch_action(cx, "missing"), false)
    testing.equal(t, get(log), "quit quit")
}

fn test_key_contexts_choose_between_bindings_of_one_keystroke(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = action_log(cx)
    let view = fn() -> Element {
        let editor = div().key_context("Editor mode = full").column().size(100.0, 50.0).children() {
            div().id("text").size(20.0, 20.0).focusable(),
        }
        div().key_context("Workspace").column().size(200.0, 200.0)
            .on_action("editor.save", fn() { add_note(log, "editor") })
            .on_action("workspace.save", fn() { add_note(log, "workspace") })
            .children() {
                editor,
                div().id("side").size(20.0, 20.0).focusable(),
            }
    }
    bind_keys(cx, [
        binding_of("ctrl-s", "workspace.save", "Workspace"),
        binding_of("ctrl-s", "editor.save", "Editor && mode == full"),
    ])
    frame(cx, view, window(), 1.0)
    set_focus(cx, "text")
    type_ctrl(cx, "s")
    set_focus(cx, "side")
    type_ctrl(cx, "s")
    testing.equal(t, get(log), "editor workspace")
}

fn test_a_chord_waits_for_its_next_keystroke_and_types_nothing(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = action_log(cx)
    let text = signal(cx, "")
    let view = fn() -> Element {
        div().size(300.0, 100.0).on_action("open", fn() { add_note(log, "open") }).child(typing_field(text))
    }
    bind_keys(cx, [binding_of("ctrl-k ctrl-o", "open", "")])
    frame(cx, view, window(), 1.0)
    set_focus(cx, "f")
    type_ctrl(cx, "k")
    testing.equal(t, pending_text(cx), "[ctrl-k]")
    type_ctrl(cx, "o")
    testing.equal(t, pending_text(cx), "")
    testing.equal(t, get(log), "open")
    testing.equal(t, get(text), "")
}

fn test_a_chord_left_waiting_replays_its_keystrokes_as_typing(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = action_log(cx)
    let text = signal(cx, "")
    let view = fn() -> Element {
        div().size(300.0, 100.0).on_action("leave", fn() { add_note(log, "leave") }).child(typing_field(text))
    }
    bind_keys(cx, [binding_of("j k", "leave", "")])
    frame(cx, view, window(), 1.0)
    set_focus(cx, "f")
    type_plain(cx, "j")
    testing.equal(t, get(text), "")
    advance_clock(cx, 999)
    testing.equal(t, get(text), "")
    advance_clock(cx, 1)
    testing.equal(t, get(text), "j")
    testing.equal(t, pending_text(cx), "")
    frame(cx, view, window(), 1.0)
    type_plain(cx, "j")
    type_plain(cx, "x")
    testing.equal(t, get(text), "jjx")
    frame(cx, view, window(), 1.0)
    type_plain(cx, "j")
    type_plain(cx, "k")
    testing.equal(t, get(text), "jjx")
    testing.equal(t, get(log), "leave")
}

fn test_a_binding_nobody_handles_falls_through_to_typing(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let text = signal(cx, "")
    let log = action_log(cx)
    let view = fn() -> Element {
        div().size(300.0, 100.0).on_action("taken", fn() { add_note(log, "taken") }).child(typing_field(text))
    }
    bind_keys(cx, [binding_of("a", "unhandled", ""), binding_of("b", "taken", "")])
    frame(cx, view, window(), 1.0)
    set_focus(cx, "f")
    type_plain(cx, "a")
    frame(cx, view, window(), 1.0)
    type_plain(cx, "b")
    testing.equal(t, get(text), "a")
    testing.equal(t, get(log), "taken")
}

fn test_moving_focus_drops_a_waiting_chord(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = action_log(cx)
    let view = fn() -> Element {
        div().column().size(100.0, 100.0).on_action("open", fn() { add_note(log, "open") }).children() {
            div().id("a").size(20.0, 20.0).focusable(),
            div().id("b").size(20.0, 20.0).focusable(),
        }
    }
    bind_keys(cx, [binding_of("ctrl-k ctrl-o", "open", "")])
    frame(cx, view, window(), 1.0)
    set_focus(cx, "a")
    type_ctrl(cx, "k")
    set_focus(cx, "b")
    testing.equal(t, pending_text(cx), "")
    type_ctrl(cx, "o")
    testing.equal(t, get(log), "")
}

fn test_releases_reach_key_handlers_but_not_bindings(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = action_log(cx)
    let seen = fn(k: platform.KeyEvent) -> bool {
        let what = if k.pressed { "down" } else { "up" }
        add_note(log, what)
        false
    }
    let view = fn() -> Element {
        div().id("b").size(20.0, 20.0).focusable().on_key(seen).on_action("go", fn() { add_note(log, "go") })
    }
    bind_keys(cx, [binding_of("g", "go", "")])
    frame(cx, view, window(), 1.0)
    set_focus(cx, "b")
    type_plain(cx, "g")
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("g"), pressed: false }))
    testing.equal(t, get(log), "go up")
}

fn test_enter_still_clicks_when_its_binding_is_unhandled(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = action_log(cx)
    let view = fn() -> Element {
        div().id("b").size(20.0, 20.0).focusable().on_click(fn(e: ClickEvent) { add_note(log, "click") })
    }
    bind_keys(cx, [binding_of("enter", "confirm", "")])
    frame(cx, view, window(), 1.0)
    set_focus(cx, "b")
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Enter) }))
    testing.equal(t, get(log), "click")
}

fn test_bindings_are_listed_for_the_focused_element_and_for_any_other(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().key_context("Workspace").column().size(200.0, 200.0).on_action("save", fn() {}).children() {
            div().key_context("Editor").child(div().id("text").size(20.0, 20.0).focusable().on_action("undo", fn() {})),
            div().id("side").size(20.0, 20.0).focusable(),
        }
    }
    bind_keys(cx, [
        binding_of("ctrl-s", "save", ""),
        binding_of("ctrl-k s", "save", "Workspace"),
        binding_of("ctrl-z", "undo", "Editor"),
        binding_of("ctrl-s", "format", "Editor"),
    ])
    frame(cx, view, window(), 1.0)
    set_focus(cx, "side")
    testing.equal(t, keystroke_text_for(cx, "save"), "ctrl-k s")
    testing.equal(t, bindings_for_action(cx, "save").len, 2)
    testing.equal(t, keystroke_text_for(cx, "undo"), "undo")
    testing.equal(t, binding_text(bindings_for_action_in(cx, "undo", "text")[0]), "ctrl-z")
    testing.equal(t, bindings_for_action_in(cx, "save", "text").len, 1)
    testing.equal(t, is_action_available(cx, "undo"), false)
    testing.equal(t, is_action_available(cx, "save"), true)
    set_focus(cx, "text")
    testing.equal(t, is_action_available(cx, "undo"), true)
    let names = available_actions(cx)
    testing.equal(t, names.len, 2)
    testing.equal(t, "{names[0]} {names[1]}", "save undo")
}
