import std/testing
import std/ui/geometry
import std/ui/platform

fn area() -> geometry.Size {
    geometry.size(200.0, 100.0)
}

fn tally(cx: Context) -> Signal[i64] {
    signal(cx, 0)
}

fn increment(n: Signal[i64]) {
    update(n, fn(v: i64) -> i64 { v + 1 })
}

struct Trace {
    lines: str[] = []
}

fn traced(tr: *Trace, line: str) {
    tr.lines.push(line)
}

fn trace_text(tr: *Trace) -> str {
    var out = ""
    for i, line in tr.lines {
        out = if i == 0 { line } else { "{out}, {line}" }
    }
    out
}

fn test_a_memo_recomputes_only_after_what_it_read_changes(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let s = signal(cx, 2)
    let runs = tally(cx)
    let square = memo(cx, fn() -> i64 {
        increment(runs)
        get(s) * get(s)
    })
    testing.equal(t, read(square), 4)
    testing.equal(t, read(square), 4)
    testing.equal(t, get(runs), 1)
    set(s, 3)
    testing.equal(t, read(square), 9)
    testing.equal(t, get(runs), 2)
}

fn test_a_diamond_runs_its_effect_once_with_consistent_values(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let s = signal(cx, 1)
    let left = memo(cx, fn() -> i64 { get(s) + 1 })
    let right = memo(cx, fn() -> i64 { get(s) * 10 })
    let seen = new(Trace {})
    effect(cx, fn() { traced(seen, "{read(left)}/{read(right)}") })
    set(s, 2)
    set(s, 5)
    testing.equal(t, trace_text(seen), "2/10, 3/20, 6/50")
}

fn test_an_equal_memo_value_stops_at_the_memo(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let s = signal(cx, 4)
    let parity = memo(cx, fn() -> bool { get(s) % 2 == 0 })
    let downstream_runs = tally(cx)
    let label = memo(cx, fn() -> str {
        increment(downstream_runs)
        if read(parity) { "even" } else { "odd" }
    })
    let effect_runs = tally(cx)
    effect(cx, fn() {
        read(label)
        increment(effect_runs)
    })
    set(s, 6)
    set(s, 8)
    testing.equal(t, get(effect_runs), 1)
    testing.equal(t, get(downstream_runs), 1)
    set(s, 9)
    testing.equal(t, get(effect_runs), 2)
    testing.equal(t, read(label), "odd")
}

fn test_an_outer_effect_ends_the_inner_effects_of_its_last_run(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let shared = signal(cx, 0)
    let inner_only = signal(cx, 0)
    let log = new(Trace {})
    effect(cx, fn() {
        let outer_saw = get(shared)
        traced(log, "outer {outer_saw}")
        effect(cx, fn() {
            traced(log, "inner {get(shared)} {get(inner_only)}")
            on_cleanup(cx, fn() { traced(log, "end inner {outer_saw}") })
        })
    })
    set(inner_only, 1)
    set(shared, 1)
    testing.equal(t, trace_text(log), "outer 0, inner 0 0, end inner 0, inner 0 1, end inner 0, outer 1, inner 1 1")
}

fn test_a_disposed_effect_runs_its_cleanups_and_never_again(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let s = signal(cx, 0)
    let runs = tally(cx)
    let cleaned = tally(cx)
    let e = effect(cx, fn() {
        get(s)
        increment(runs)
        on_cleanup(cx, fn() { increment(cleaned) })
    })
    set(s, 1)
    dispose(e)
    dispose(e)
    set(s, 2)
    testing.equal(t, get(runs), 2)
    testing.equal(t, get(cleaned), 2)
}

fn test_a_memo_keeps_its_last_value_once_its_owner_ends(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let s = signal(cx, 1)
    var held: Memo[i64]? = none
    let e = effect(cx, fn() {
        held = some(memo(cx, fn() -> i64 { get(s) * 2 }))
    })
    let m = held ?? panic("the effect made no memo")
    let reader = memo(cx, fn() -> i64 { read(m) + 1 })
    set(s, 7)
    dispose(e)
    set(s, 8)
    testing.equal(t, read(reader), 3)
    testing.equal(t, read(m), 2)
}

fn test_closing_a_window_ends_the_effects_made_with_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let w = open_window(cx, WindowOptions {}, fn() -> Element { div() }) catch {
        e => panic("cannot open a window")
    }
    let s = signal(cx, 0)
    let runs = tally(cx)
    effect(window_context(w), fn() {
        get(s)
        increment(runs)
    })
    close_window(w)
    set(s, 1)
    testing.equal(t, get(runs), 1)
}

fn test_an_effect_that_sets_a_signal_on_its_first_run_does_not_rerun_inside_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let source = signal(cx, 1)
    let target = signal(cx, 0)
    let log = new(Trace {})
    effect(cx, fn() { traced(log, "target {get(target)}") })
    effect(cx, fn() {
        traced(log, "start")
        set(target, get(source) * 2)
        set(target, get(source) * 3)
        traced(log, "end")
    })
    testing.equal(t, trace_text(log), "target 0, start, end, target 3")
}

fn test_untracked_reads_make_no_dependency(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let s = signal(cx, 0)
    let runs = tally(cx)
    effect(cx, fn() {
        untracked(cx, fn() -> i64 { get(s) })
        increment(runs)
    })
    set(s, 1)
    testing.equal(t, get(runs), 1)
}

fn test_a_post_that_sets_nothing_leaves_a_tracked_frame_not_due(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    set_tracked_frames(cx, true)
    frame(cx, fn() -> Element { div() }, area(), 1.0)
    post(handle(cx), fn() {})
    dispatch(cx, platform.Event.Woken)
    testing.is_false(t, frame_due(cx))
}

fn test_a_tracked_frame_that_read_only_a_memo_skips_an_equal_value(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    set_tracked_frames(cx, true)
    let s = signal(cx, 4)
    let parity = memo(cx, fn() -> bool { get(s) % 2 == 0 })
    let view = fn() -> Element { text("{read(parity)}") }
    frame(cx, view, area(), 1.0)
    set(s, 6)
    testing.is_false(t, frame_due(cx))
    set(s, 7)
    testing.is_true(t, frame_due(cx))
}

fn test_a_tracked_frame_is_due_for_window_state_and_application_wide_changes(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    set_tracked_frames(cx, true)
    let view = fn() -> Element { div().size(50.0, 50.0) }
    frame(cx, view, area(), 1.0)
    dispatch(cx, platform.Event.Resized(320.0, 240.0, 1.0))
    testing.is_true(t, frame_due(cx))
    frame(cx, view, area(), 1.0)
    set_menu_style(cx, MenuStyle {})
    testing.is_true(t, frame_due(cx))
}

fn test_a_tracked_window_ignores_a_signal_only_another_window_read(t: *testing.T) {
    let a = headless(rgb(0xffffff))
    set_tracked_frames(a, true)
    let w = open_window(a, WindowOptions {}, fn() -> Element { div() }) catch {
        e => panic("cannot open a window")
    }
    let b = window_context(w)
    let s = signal(a, 0)
    frame(a, fn() -> Element { div() }, area(), 1.0)
    frame(b, fn() -> Element { text("{get(s)}") }, area(), 1.0)
    set(s, 1)
    testing.is_false(t, frame_due(a))
    testing.is_true(t, frame_due(b))
}

fn test_an_untracked_frame_is_due_for_any_signal(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let unseen = signal(cx, 0)
    frame(cx, fn() -> Element { div() }, area(), 1.0)
    set(unseen, 1)
    testing.is_true(t, frame_due(cx))
}
