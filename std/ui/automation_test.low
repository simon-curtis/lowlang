import std/testing
import std/ui/geometry
import std/ui/platform

fn save_button(clicks: Signal[i64]) -> Element {
    div().id("save").size(80.0, 30.0).on_click(fn(e: ClickEvent) { set(clicks, get(clicks) + 1) }).child(text("Save"))
}

fn form(clicks: Signal[i64]) -> Element {
    div().column().size(200.0, 200.0).children() {
        save_button(clicks),
        div().size(30.0, 30.0).label("Close").role(Role.Button),
        text("Hello").id("greeting"),
        field("abc").id("name").width(100.0),
        div().size(10.0, 10.0),
    }
}

fn info_for(cx: Context, key: str) -> ElementInfo {
    for e in elements(cx) {
        if e.key == key {
            return e
        }
    }
    panic("no element {key}")
}

fn test_elements_lists_the_drawn_elements_in_paint_order(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    shot(cx, fn() -> Element { form(clicks) })
    var keys: str[] = []
    for e in elements(cx) {
        keys.push(e.key)
    }
    testing.equal(t, "{keys}", "[\"save\", \"save/0\", \"0/1\", \"greeting\", \"name\"]")
}

fn test_a_button_is_named_by_its_text_and_a_label_wins(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    shot(cx, fn() -> Element { form(clicks) })
    testing.equal(t, info_for(cx, "save").label, "Save")
    testing.equal(t, info_for(cx, "save").role, Role.Button)
    testing.equal(t, info_for(cx, "greeting").label, "Hello")
    testing.equal(t, info_for(cx, "greeting").role, Role.Text)
    testing.equal(t, info_for(cx, "0/1").label, "Close")
    testing.equal(t, info_for(cx, "0/1").role, Role.Button)
    testing.equal(t, info_for(cx, "name").role, Role.TextInput)
}

fn test_a_label_replaces_the_text_of_a_button(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    shot(cx, fn() -> Element { save_button(clicks).label("Store").role(Role.Link) })
    testing.equal(t, info_for(cx, "save").label, "Store")
    testing.equal(t, info_for(cx, "save").role, Role.Link)
}

fn test_the_bounds_of_a_labelled_element_are_recorded_without_an_id_or_handler(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    shot(cx, fn() -> Element { form(clicks) })
    let b = bounds_of(cx, "0/1") ?? geometry.Rect {}
    testing.equal(t, b.y, 30.0)
    testing.equal(t, b.width, 30.0)
    testing.equal(t, info_for(cx, "0/1").bounds.y, 30.0)
}

fn test_focus_marks_one_element(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    shot(cx, fn() -> Element { form(clicks) })
    set_focus(cx, "name")
    shot(cx, fn() -> Element { form(clicks) })
    var focused: str[] = []
    for e in elements(cx) {
        if e.focused {
            focused.push(e.key)
        }
    }
    testing.equal(t, focused.len, 1)
    testing.equal(t, focused[0], "name")
}

fn test_click_element_clicks_the_centre_of_the_element(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    shot(cx, fn() -> Element { form(clicks) })
    testing.is_true(t, click_element(cx, "save"))
    testing.equal(t, get(clicks), 1)
    testing.is_false(t, click_element(cx, "missing"))
    testing.equal(t, get(clicks), 1)
}

fn test_click_element_clicks_what_is_on_top_of_a_covered_element(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let under = signal(cx, 0)
    let over = signal(cx, 0)
    let view = fn() -> Element {
        div().size(100.0, 100.0).children() {
            div().id("under").absolute().top(0.0).left(0.0).size(50.0, 50.0).on_click(fn(e: ClickEvent) { set(under, get(under) + 1) }),
            div().id("over").absolute().top(0.0).left(0.0).size(50.0, 50.0).on_click(fn(e: ClickEvent) { set(over, get(over) + 1) }),
        }
    }
    shot(cx, view)
    click_element(cx, "under")
    testing.equal(t, get(under), 0)
    testing.equal(t, get(over), 1)
}

fn test_a_covered_element_is_not_visible(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(100.0, 100.0).children() {
            div().id("under").absolute().top(0.0).left(0.0).size(50.0, 50.0).on_click(fn(e: ClickEvent) {}),
            div().id("over").absolute().top(0.0).left(0.0).size(50.0, 50.0).on_click(fn(e: ClickEvent) {}),
            div().id("beside").absolute().top(0.0).left(60.0).size(20.0, 20.0).on_click(fn(e: ClickEvent) {}),
        }
    }
    shot(cx, view)
    testing.is_false(t, info_for(cx, "under").visible)
    testing.is_true(t, info_for(cx, "over").visible)
    testing.is_true(t, info_for(cx, "beside").visible)
}

fn test_an_element_inside_a_covering_overlay_is_visible(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(100.0, 100.0).children() {
            div().id("page").size(100.0, 100.0).on_click(fn(e: ClickEvent) {}),
            div().id("card").absolute().top(0.0).left(0.0).size(60.0, 60.0).on_click(fn(e: ClickEvent) {}).child(text("Inside").id("inside")),
        }
    }
    shot(cx, view)
    testing.is_false(t, info_for(cx, "page").visible)
    testing.is_true(t, info_for(cx, "card").visible)
    testing.is_true(t, info_for(cx, "inside").visible)
}

fn test_invisible_and_clipped_elements_are_not_visible(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(100.0, 100.0).children() {
            div().id("hidden").size(20.0, 20.0).invisible().label("hidden").child(text("inside").id("child")),
            div().id("box").size(50.0, 20.0).overflow_hidden().children() {
                div().id("far").absolute().top(0.0).left(80.0).size(10.0, 10.0).label("far"),
                div().id("near").size(10.0, 10.0).label("near"),
            },
        }
    }
    shot(cx, view)
    testing.is_false(t, info_for(cx, "hidden").visible)
    testing.is_false(t, info_for(cx, "child").visible)
    testing.is_false(t, info_for(cx, "far").visible)
    testing.is_true(t, info_for(cx, "near").visible)
    testing.is_true(t, info_for(cx, "box").visible)
}

fn test_click_element_does_nothing_for_an_element_clipped_away(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(100.0, 100.0).overflow_hidden().children() {
            div().id("far").absolute().top(0.0).left(150.0).size(10.0, 10.0).label("far"),
        }
    }
    shot(cx, view)
    testing.is_false(t, click_element(cx, "far"))
}

fn test_element_at_names_the_topmost_element_that_takes_the_pointer(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    shot(cx, fn() -> Element { form(clicks) })
    testing.equal(t, element_at(cx, geometry.point(10.0, 10.0)) ?? "", "save")
    testing.equal(t, element_at(cx, geometry.point(150.0, 90.0)) ?? "", "")
}

fn test_an_element_at_a_point_outside_every_element_is_none(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    shot(cx, fn() -> Element { form(clicks) })
    testing.is_true(t, element_at(cx, geometry.point(190.0, 95.0)) == none)
}

fn test_the_rows_of_a_list_are_listed_with_the_rows_in_view(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let rows = fn(start: i64, end: i64) -> Element[] {
        var out: Element[] = []
        for ix in start..end {
            out.push(div().height(20.0).on_click(fn(e: ClickEvent) {}).child(text("row {ix}")))
        }
        out
    }
    shot(cx, fn() -> Element { uniform_list("rows", 1000, rows).size(200.0, 100.0) })
    var labels: str[] = []
    for e in elements(cx) {
        if e.role == Role.Button {
            labels.push(e.label)
        }
    }
    testing.equal(t, labels.len, 5)
    testing.equal(t, labels[0], "row 0")
    testing.equal(t, info_for(cx, "rows").role, Role.List)
}

fn test_elements_reads_the_last_frame_only(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, fn() -> Element { div().id("a").label("A") })
    shot(cx, fn() -> Element { div().id("b").label("B") })
    testing.equal(t, elements(cx).len, 1)
    testing.equal(t, elements(cx)[0].id, "b")
}

fn test_an_element_hidden_while_pressed_hides_the_elements_inside_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("panel").size(100.0, 50.0).on_click(fn(e: ClickEvent) {}).active(fn(v: Visual) -> Visual { with_visible(v, false) }).children() {
            div().id("note").size(10.0, 10.0).label("note"),
        }
    }
    shot(cx, view)
    testing.is_true(t, info_for(cx, "note").visible)
    press(cx, 50.0, 40.0)
    shot(cx, view)
    testing.is_false(t, info_for(cx, "panel").visible)
    testing.is_false(t, info_for(cx, "note").visible)
}

fn test_a_container_with_a_hitbox_takes_no_label_from_its_content(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, fn() -> Element { div().id("pane").size(100.0, 50.0).overflow_y_scroll().child(text("inside")) })
    testing.equal(t, info_for(cx, "pane").label, "")
}

fn test_click_element_aims_at_the_part_of_the_element_in_view(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = fn() -> Element {
        div().size(100.0, 50.0).overflow_hidden().children() {
            div().id("edge").absolute().top(0.0).left(80.0).size(40.0, 20.0).on_click(fn(e: ClickEvent) { set(clicks, get(clicks) + 1) }),
        }
    }
    shot(cx, view)
    testing.is_true(t, click_element(cx, "edge"))
    testing.equal(t, get(clicks), 1)
}
