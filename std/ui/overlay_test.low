import std/testing
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn same_color(c: geometry.Color, hex: u32) -> bool {
    let want = rgb(hex)
    near(c.r, want.r) && near(c.g, want.g) && near(c.b, want.b)
}

fn quad_of(sc: scene.Scene, hex: u32) -> i64 {
    for i, q in sc.quads {
        if same_color(q.background, hex) {
            return i
        }
    }
    -1
}

fn painted_at(t: *testing.T, overlay: Element) -> geometry.Rect {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(200.0, 100.0).child(deferred(overlay))
    }
    let sc = frame(cx, view, window(), 1.0)
    let at = quad_of(sc, 0xff0000)
    if at < 0 {
        t.error("no red quad")
        return geometry.Rect {}
    }
    sc.quads[at].bounds
}

fn big(cx: Context, view: fn() -> Element) -> scene.Scene {
    frame(cx, view, geometry.size(400.0, 300.0), 1.0)
}

fn red_box(w: f32, h: f32) -> Element {
    div().size(w, h).background(rgb(0xff0000))
}

fn right_press(cx: Context, x: f32, y: f32) {
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Right, x, y }))
    dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Right, x, y }))
}

fn hit_key(cx: Context, n: platform.NamedKey) {
    dispatch(cx, named(n))
}

fn center_of(cx: Context, key: str) -> geometry.Point {
    let r = bounds_of(cx, key) ?? geometry.Rect {}
    geometry.point(r.x + r.width / 2.0, r.y + r.height / 2.0)
}

fn click_on(cx: Context, key: str) {
    let p = center_of(cx, key)
    move_to(cx, p.x, p.y)
    click(cx, p.x, p.y)
}

fn edit_items(log: Signal[str[]]) -> fn() -> MenuItem[] {
    fn() -> MenuItem[] {
        [
            menu_entry("Copy", fn() { note(log, "copy") }),
            menu_separator(),
            disabled(menu_entry("Cut", fn() { note(log, "cut") })),
            menu_entry("Paste", fn() { note(log, "paste") }),
            submenu("More", [menu_entry("Inner", fn() { note(log, "inner") })]),
        ]
    }
}

fn highlighted(cx: Context, id: str) -> str {
    let at = layer_index(cx.state, id)
    if at < 0 {
        return "closed"
    }
    var out = ""
    for i in cx.state.layers[at].path {
        out = "{out}[{i}]"
    }
    out
}

fn test_an_occluding_element_hides_what_is_under_it_from_the_pointer(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = fn() -> Element {
        div().size(200.0, 100.0).children() {
            div().id("under").absolute().size(100.0, 100.0).on_click(count_up(clicks)),
            div().id("cover").absolute().size(50.0, 50.0).occlude(),
        }
    }
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    testing.equal(t, cx.state.hits[find(cx.state, "under")], false)
    click(cx, 10.0, 10.0)
    testing.equal(t, get(clicks), 0)
    move_to(cx, 70.0, 10.0)
    click(cx, 70.0, 10.0)
    testing.equal(t, get(clicks), 1)
}

fn scroll_under(cx: Context, cover: Element) -> f32 {
    let view = fn() -> Element {
        div().size(200.0, 100.0).children() {
            div().id("list").absolute().size(100.0, 50.0).overflow_y_scroll().child(div().size(100.0, 200.0)),
            cover,
        }
    }
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    dispatch(cx, platform.Event.Scrolled(0.0, 20.0, platform.Modifiers {}))
    scroll_offset(cx, "list").y
}

fn test_a_wheel_turn_passes_only_an_element_that_blocks_the_mouse_except_scroll(t: *testing.T) {
    let passing = headless(rgb(0xffffff))
    testing.equal(t, scroll_under(passing, div().absolute().size(50.0, 50.0).block_mouse_except_scroll()), 20.0)
    testing.equal(t, passing.state.hits[find(passing.state, "list")], false)
    let blocking = headless(rgb(0xffffff))
    testing.equal(t, scroll_under(blocking, div().absolute().size(50.0, 50.0).occlude()), 0.0)
}

fn test_a_deferred_element_escapes_its_clip_draws_last_and_takes_the_pointer(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        let popup = div().absolute().top(30.0).left(30.0).size(60.0, 60.0).background(rgb(0xff0000))
            .on_click(fn(e: ClickEvent) { note(log, "popup") })
        div().size(200.0, 100.0).children() {
            div().size(50.0, 50.0).overflow_hidden().child(deferred(popup)),
            div().absolute().size(200.0, 100.0).background(rgb(0x00ff00)).on_click(fn(e: ClickEvent) { note(log, "cover") }),
        }
    }
    let sc = shot(cx, view)
    let red = quad_of(sc, 0xff0000)
    testing.equal(t, red, sc.quads.len - 1)
    same_rect(t, sc.quads[red].clip, geometry.rect(0.0, 0.0, 200.0, 100.0))
    move_to(cx, 70.0, 70.0)
    click(cx, 70.0, 70.0)
    testing.equal(t, joined(get(log)), "popup\n")
}

fn test_deferred_elements_draw_by_priority_and_nested_ones_after_their_parent(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        let nested = deferred(div().absolute().size(10.0, 10.0).background(rgb(0x0000ff)))
        div().size(200.0, 100.0).children() {
            deferred(div().absolute().size(10.0, 10.0).background(rgb(0xff0000))).priority(2),
            deferred(div().absolute().size(10.0, 10.0).background(rgb(0x00ff00)).child(nested)).priority(1),
        }
    }
    let sc = shot(cx, view)
    testing.equal(t, quad_of(sc, 0x00ff00), 0)
    testing.equal(t, quad_of(sc, 0xff0000), 1)
    testing.equal(t, quad_of(sc, 0x0000ff), 2)
}

fn test_anchored_children_switch_sides_then_snap_inside_the_window(t: *testing.T) {
    same_rect(t, painted_at(t, anchored().position(geometry.point(10.0, 10.0)).child(red_box(50.0, 20.0))), geometry.rect(10.0, 10.0, 50.0, 20.0))
    same_rect(t, painted_at(t, anchored().position(geometry.point(180.0, 10.0)).child(red_box(50.0, 20.0))), geometry.rect(130.0, 10.0, 50.0, 20.0))
    same_rect(t, painted_at(t, anchored().position(geometry.point(10.0, 90.0)).child(red_box(50.0, 20.0))), geometry.rect(10.0, 70.0, 50.0, 20.0))
    same_rect(t, painted_at(t, anchored().position(geometry.point(180.0, 10.0)).snap_to_window().child(red_box(50.0, 20.0))), geometry.rect(150.0, 10.0, 50.0, 20.0))
    let margin = anchored().position(geometry.point(180.0, 90.0)).snap_to_window_with_margin(geometry.edges(8.0)).child(red_box(50.0, 20.0))
    same_rect(t, painted_at(t, margin), geometry.rect(142.0, 72.0, 50.0, 20.0))
    same_rect(t, painted_at(t, anchored().position(geometry.point(20.0, 50.0)).snap_to_window().child(red_box(250.0, 20.0))), geometry.rect(0.0, 50.0, 250.0, 20.0))
}

fn test_anchored_children_follow_the_anchor_corner_offset_and_position_mode(t: *testing.T) {
    same_rect(t, painted_at(t, anchored().position(geometry.point(100.0, 50.0)).anchor(BottomRight).child(red_box(50.0, 20.0))), geometry.rect(50.0, 30.0, 50.0, 20.0))
    same_rect(t, painted_at(t, anchored().position(geometry.point(10.0, 10.0)).offset(geometry.point(5.0, 6.0)).child(red_box(20.0, 20.0))), geometry.rect(15.0, 16.0, 20.0, 20.0))
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        let local = anchored().position_mode(Local).position(geometry.point(5.0, 5.0)).child(red_box(20.0, 20.0))
        div().size(200.0, 100.0).padding(20.0).child(div().size(60.0, 40.0).child(local))
    }
    let sc = shot(cx, view)
    same_rect(t, sc.quads[quad_of(sc, 0xff0000)].bounds, geometry.rect(25.0, 25.0, 20.0, 20.0))
}

fn test_attach_to_places_an_overlay_at_a_corner_of_an_element_in_the_same_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(200.0, 100.0).padding(20.0).children() {
            div().id("trigger").size(40.0, 10.0),
            deferred(anchored().attach_to("trigger", BottomLeft).child(red_box(30.0, 10.0))),
        }
    }
    let sc = shot(cx, view)
    same_rect(t, sc.quads[quad_of(sc, 0xff0000)].bounds, geometry.rect(20.0, 30.0, 30.0, 10.0))
    same_rect(t, bounds_of(cx, "trigger") ?? geometry.Rect {}, geometry.rect(20.0, 20.0, 40.0, 10.0))
    testing.equal(t, (bounds_of(cx, "missing") ?? geometry.rect(-1.0, 0.0, 0.0, 0.0)).x, -1.0)
}

fn tip_view(hoverable: bool) -> fn() -> Element {
    fn() -> Element {
        let build = fn() -> Element { div().id("tipbox").size(30.0, 10.0).background(rgb(0xff0000)) }
        let owner = div().id("owner").size(100.0, 100.0)
        let with_tip = if hoverable { owner.hoverable_tooltip(build) } else { owner.tooltip(build) }
        div().size(200.0, 100.0).child(with_tip)
    }
}

fn test_a_tooltip_shows_after_the_pointer_rests_half_a_second(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = tip_view(false)
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    shot(cx, view)
    advance_clock(cx, 499)
    testing.equal(t, cx.state.tip.visible, false)
    testing.equal(t, frame_due(cx), false)
    advance_clock(cx, 1)
    testing.equal(t, cx.state.tip.visible, true)
    testing.equal(t, frame_due(cx), true)
    let sc = shot(cx, view)
    testing.equal(t, quad_of(sc, 0xff0000), sc.quads.len - 1)
    same_rect(t, bounds_of(cx, "tipbox") ?? geometry.Rect {}, geometry.rect(11.0, 11.0, 30.0, 10.0))
    move_to(cx, 20.0, 20.0)
    shot(cx, view)
    same_rect(t, bounds_of(cx, "tipbox") ?? geometry.Rect {}, geometry.rect(11.0, 11.0, 30.0, 10.0))
}

fn test_a_tooltip_near_the_edge_appears_above_and_left_of_the_pointer(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = tip_view(false)
    shot(cx, view)
    move_to(cx, 90.0, 95.0)
    advance_clock(cx, 500)
    shot(cx, view)
    same_rect(t, bounds_of(cx, "tipbox") ?? geometry.Rect {}, geometry.rect(91.0, 84.0, 30.0, 10.0))
    let wide = headless(rgb(0xffffff))
    let narrow = fn() -> Element { tip_view(false)() }
    frame(wide, narrow, geometry.size(110.0, 100.0), 1.0)
    move_to(wide, 95.0, 10.0)
    advance_clock(wide, 500)
    frame(wide, narrow, geometry.size(110.0, 100.0), 1.0)
    same_rect(t, bounds_of(wide, "tipbox") ?? geometry.Rect {}, geometry.rect(64.0, 11.0, 30.0, 10.0))
}

fn test_a_tooltip_waits_again_when_the_pointer_leaves_and_hides_on_a_press_or_leave(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = tip_view(false)
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    advance_clock(cx, 300)
    move_to(cx, 150.0, 10.0)
    advance_clock(cx, 500)
    testing.equal(t, cx.state.tip.visible, false)
    move_to(cx, 10.0, 10.0)
    advance_clock(cx, 500)
    testing.equal(t, cx.state.tip.visible, true)
    press(cx, 10.0, 10.0)
    testing.equal(t, cx.state.tip.visible, false)
    release(cx, 10.0, 10.0)
    move_to(cx, 12.0, 10.0)
    advance_clock(cx, 500)
    testing.equal(t, cx.state.tip.visible, true)
    dispatch(cx, platform.Event.Scrolled(0.0, 5.0, platform.Modifiers {}))
    testing.equal(t, cx.state.tip.visible, false)
    move_to(cx, 14.0, 10.0)
    advance_clock(cx, 500)
    dispatch(cx, platform.Event.PointerLeft)
    testing.equal(t, cx.state.tip.visible, false)
}

fn test_a_hoverable_tooltip_stays_over_itself_and_hides_after_the_pointer_leaves_both(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = tip_view(true)
    shot(cx, view)
    move_to(cx, 90.0, 10.0)
    advance_clock(cx, 500)
    shot(cx, view)
    move_to(cx, 110.0, 15.0)
    testing.equal(t, cx.state.tip.visible, true)
    press(cx, 110.0, 15.0)
    release(cx, 110.0, 15.0)
    testing.equal(t, cx.state.tip.visible, true)
    move_to(cx, 150.0, 60.0)
    advance_clock(cx, 499)
    testing.equal(t, cx.state.tip.visible, true)
    move_to(cx, 110.0, 15.0)
    advance_clock(cx, 500)
    testing.equal(t, cx.state.tip.visible, true)
    move_to(cx, 150.0, 60.0)
    shot(cx, view)
    advance_clock(cx, 499)
    testing.equal(t, frame_due(cx), false)
    advance_clock(cx, 1)
    testing.equal(t, cx.state.tip.visible, false)
    testing.equal(t, frame_due(cx), true)
}

fn test_a_tooltip_whose_owner_leaves_the_tree_is_hidden(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let shown = signal(cx, true)
    let view = fn() -> Element {
        let root = div().size(200.0, 100.0)
        if !get(shown) {
            return root
        }
        root.child(div().id("owner").size(100.0, 100.0).tooltip(fn() -> Element { div().size(30.0, 10.0).background(rgb(0xff0000)) }))
    }
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    advance_clock(cx, 300)
    set(shown, false)
    shot(cx, view)
    advance_clock(cx, 200)
    testing.equal(t, cx.state.tip.visible, false)
    set(shown, true)
    shot(cx, view)
    move_to(cx, 11.0, 10.0)
    advance_clock(cx, 500)
    testing.equal(t, cx.state.tip.visible, true)
    set(shown, false)
    let sc = shot(cx, view)
    testing.equal(t, quad_of(sc, 0xff0000), -1)
    testing.equal(t, cx.state.tip.visible, false)
}

fn menu_field_view(cx: Context, log: Signal[str[]]) -> fn() -> Element {
    let items = edit_items(log)
    fn() -> Element {
        div().column().size(400.0, 300.0).on_action("cancel", fn() { note(log, "cancel") }).children() {
            field("text").id("f").width(100.0).context_menu("edit", items),
            div().id("other").size(50.0, 20.0).on_click(fn(e: ClickEvent) { note(log, "other") }),
        }
    }
}

fn test_a_context_menu_opens_on_a_field_at_the_pointer_and_takes_the_keys(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = menu_field_view(cx, log)
    big(cx, view)
    set_focus(cx, "f")
    move_to(cx, 10.0, 5.0)
    right_press(cx, 10.0, 5.0)
    testing.equal(t, overlay_open(cx, "edit"), true)
    testing.equal(t, focused(cx), "edit")
    big(cx, view)
    let panel = bounds_of(cx, "edit") ?? geometry.Rect {}
    testing.equal(t, panel.x, 10.0)
    testing.equal(t, panel.y, 5.0)
    hit_key(cx, platform.NamedKey.Down)
    testing.equal(t, highlighted(cx, "edit"), "[0]")
    hit_key(cx, platform.NamedKey.Down)
    testing.equal(t, highlighted(cx, "edit"), "[3]")
    hit_key(cx, platform.NamedKey.Up)
    testing.equal(t, highlighted(cx, "edit"), "[0]")
    hit_key(cx, platform.NamedKey.End)
    testing.equal(t, highlighted(cx, "edit"), "[4]")
    hit_key(cx, platform.NamedKey.Home)
    hit_key(cx, platform.NamedKey.Enter)
    testing.equal(t, joined(get(log)), "copy\n")
    testing.equal(t, overlay_open(cx, "edit"), false)
    testing.equal(t, focused(cx), "f")
}

fn test_escape_closes_an_open_menu_before_a_global_escape_binding(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = menu_field_view(cx, log)
    bind_keys(cx, [binding_of("escape", "cancel", "")])
    big(cx, view)
    move_to(cx, 10.0, 5.0)
    right_press(cx, 10.0, 5.0)
    big(cx, view)
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "edit"), false)
    testing.equal(t, joined(get(log)), "")
    big(cx, view)
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, joined(get(log)), "cancel\n")
}

fn test_a_press_outside_a_menu_closes_it_and_reaches_the_element_under_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = menu_field_view(cx, log)
    big(cx, view)
    move_to(cx, 60.0, 5.0)
    right_press(cx, 60.0, 5.0)
    big(cx, view)
    move_to(cx, 5.0, 30.0)
    click(cx, 5.0, 30.0)
    testing.equal(t, overlay_open(cx, "edit"), false)
    testing.equal(t, joined(get(log)), "other\n")
}

fn test_a_submenu_opens_beside_its_row_and_a_press_in_it_chooses_its_item(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = menu_field_view(cx, log)
    frame(cx, view, geometry.size(400.0, 300.0), 1.0)
    move_to(cx, 10.0, 5.0)
    right_press(cx, 10.0, 5.0)
    frame(cx, view, geometry.size(400.0, 300.0), 1.0)
    hit_key(cx, platform.NamedKey.End)
    hit_key(cx, platform.NamedKey.Right)
    testing.equal(t, highlighted(cx, "edit"), "[4][0]")
    hit_key(cx, platform.NamedKey.Left)
    testing.equal(t, highlighted(cx, "edit"), "[4]")
    hit_key(cx, platform.NamedKey.Right)
    frame(cx, view, geometry.size(400.0, 300.0), 1.0)
    let row = bounds_of(cx, "edit/4") ?? geometry.Rect {}
    let inner = bounds_of(cx, "edit>1") ?? geometry.Rect {}
    testing.equal(t, inner.x, row.x + row.width)
    testing.equal(t, inner.y, row.y)
    click_on(cx, "edit>1/0")
    testing.equal(t, joined(get(log)), "inner\n")
    testing.equal(t, overlay_open(cx, "edit"), false)
}

fn test_a_submenu_with_no_room_on_the_right_opens_left_of_its_menu(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let items = edit_items(log)
    let view = fn() -> Element { div().id("area").size(400.0, 300.0).context_menu("edit", items) }
    big(cx, view)
    move_to(cx, 300.0, 5.0)
    right_press(cx, 300.0, 5.0)
    big(cx, view)
    hit_key(cx, platform.NamedKey.End)
    hit_key(cx, platform.NamedKey.Right)
    big(cx, view)
    let panel = bounds_of(cx, "edit") ?? geometry.Rect {}
    let row = bounds_of(cx, "edit/4") ?? geometry.Rect {}
    let inner = bounds_of(cx, "edit>1") ?? geometry.Rect {}
    testing.equal(t, inner.x + inner.width, row.x)
    testing.equal(t, inner.x + inner.width <= panel.x + panel.width, true)
    testing.equal(t, inner.y, row.y)
}

fn test_menu_actions_dispatch_to_the_element_focused_before_and_show_its_shortcuts(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let items = fn() -> MenuItem[] { [menu_action("Save", "save"), menu_action("Undo", "undo")] }
    let view = fn() -> Element {
        div().size(200.0, 100.0).children() {
            div().key_context("Editor").child(div().id("doc").size(50.0, 20.0).focusable().on_action("save", fn() { note(log, "saved") }).context_menu("m", items)),
            div().id("side").size(20.0, 20.0).focusable(),
        }
    }
    bind_keys(cx, [binding_of("ctrl-s", "save", "Editor")])
    shot(cx, view)
    set_focus(cx, "doc")
    move_to(cx, 5.0, 5.0)
    right_press(cx, 5.0, 5.0)
    shot(cx, view)
    let l = cx.state.layers[0]
    let listed = items()
    testing.equal(t, shortcut_hint(cx.state, l, listed[0]), "ctrl-s")
    testing.equal(t, enabled(cx.state, l, listed[0]), true)
    testing.equal(t, enabled(cx.state, l, listed[1]), false)
    hit_key(cx, platform.NamedKey.Down)
    hit_key(cx, platform.NamedKey.Down)
    testing.equal(t, highlighted(cx, "m"), "[0]")
    hit_key(cx, platform.NamedKey.Enter)
    testing.equal(t, joined(get(log)), "saved\n")
    testing.equal(t, focused(cx), "doc")
}

fn dropdown_view(log: Signal[str[]]) -> fn() -> Element {
    let items = fn() -> MenuItem[] { [menu_entry("A label wider than it", fn() { note(log, "chose") })] }
    fn() -> Element {
        div().size(300.0, 200.0).padding(10.0).child(div().id("pick").size(20.0, 10.0).dropdown_menu("pick-menu", items))
    }
}

fn test_a_dropdown_with_no_room_below_or_right_opens_above_its_trigger_and_ends_at_its_right_edge(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let items = fn() -> MenuItem[] { [menu_entry("A label wider than it", fn() { note(log, "chose") })] }
    let view = fn() -> Element {
        div().size(300.0, 200.0).child(div().id("pick").absolute().left(270.0).top(180.0).size(20.0, 10.0).dropdown_menu("pick-menu", items))
    }
    frame(cx, view, geometry.size(300.0, 200.0), 1.0)
    click_on(cx, "pick")
    frame(cx, view, geometry.size(300.0, 200.0), 1.0)
    let panel = bounds_of(cx, "pick-menu") ?? geometry.Rect {}
    testing.equal(t, panel.y + panel.height, 180.0)
    testing.equal(t, panel.x + panel.width, 290.0)
    click_on(cx, "pick")
    testing.equal(t, overlay_open(cx, "pick-menu"), false)
}

fn test_a_dropdown_opens_under_its_trigger_at_its_natural_width_and_a_second_click_closes_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = dropdown_view(log)
    frame(cx, view, geometry.size(300.0, 200.0), 1.0)
    click_on(cx, "pick")
    testing.equal(t, overlay_open(cx, "pick-menu"), true)
    frame(cx, view, geometry.size(300.0, 200.0), 1.0)
    let panel = bounds_of(cx, "pick-menu") ?? geometry.Rect {}
    let row = bounds_of(cx, "pick-menu/0") ?? geometry.Rect {}
    testing.equal(t, panel.x, 10.0)
    testing.equal(t, panel.y, 20.0)
    testing.equal(t, panel.width > 100.0, true)
    testing.equal(t, row.height < 40.0, true)
    click_on(cx, "pick")
    testing.equal(t, overlay_open(cx, "pick-menu"), false)
    frame(cx, view, geometry.size(300.0, 200.0), 1.0)
    click_on(cx, "pick")
    frame(cx, view, geometry.size(300.0, 200.0), 1.0)
    click_on(cx, "pick-menu/0")
    testing.equal(t, joined(get(log)), "chose\n")
}

fn test_a_wheel_turn_over_an_open_menu_does_not_scroll_the_list_under_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let items = edit_items(log)
    let view = fn() -> Element {
        div().size(200.0, 100.0).child(div().id("list").size(200.0, 100.0).overflow_y_scroll().context_menu("edit", items).child(div().size(200.0, 400.0)))
    }
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    right_press(cx, 10.0, 10.0)
    shot(cx, view)
    move_to(cx, 20.0, 20.0)
    dispatch(cx, platform.Event.Scrolled(0.0, 30.0, platform.Modifiers {}))
    testing.equal(t, scroll_offset(cx, "list").y, 0.0)
    move_to(cx, 190.0, 90.0)
    dispatch(cx, platform.Event.Scrolled(0.0, 30.0, platform.Modifiers {}))
    testing.equal(t, scroll_offset(cx, "list").y, 30.0)
}

fn test_a_popover_shows_under_its_trigger_and_closes_on_escape_or_a_press_outside(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        let content = fn() -> Element { div().id("inside").size(60.0, 20.0).on_click(fn(e: ClickEvent) { note(log, "inside") }) }
        div().size(200.0, 100.0).padding(10.0).child(div().id("open").size(30.0, 10.0).popover("pop", content))
    }
    shot(cx, view)
    click_on(cx, "open")
    shot(cx, view)
    let panel = bounds_of(cx, "pop") ?? geometry.Rect {}
    testing.equal(t, panel.y, 20.0)
    click_on(cx, "inside")
    testing.equal(t, overlay_open(cx, "pop"), true)
    testing.equal(t, joined(get(log)), "inside\n")
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "pop"), false)
    shot(cx, view)
    click_on(cx, "open")
    shot(cx, view)
    move_to(cx, 190.0, 90.0)
    click(cx, 190.0, 90.0)
    testing.equal(t, overlay_open(cx, "pop"), false)
}

fn dialog_view(cx: Context, log: Signal[str[]]) -> fn() -> Element {
    fn() -> Element {
        div().size(200.0, 100.0).child(div().id("behind").size(200.0, 100.0).focusable().on_click(fn(e: ClickEvent) { note(log, "behind") }))
    }
}

fn dialog_body(log: Signal[str[]]) -> fn() -> Element {
    let items = fn() -> MenuItem[] { [menu_entry("Inside", fn() { note(log, "menu") })] }
    fn() -> Element {
        div().row().gap(4.0).children() {
            div().id("ok").size(20.0, 10.0).focusable(),
            div().id("no").size(20.0, 10.0).focusable(),
            div().id("more").size(20.0, 10.0).dropdown_menu("dialog-menu", items),
        }
    }
}

fn test_a_dialog_keeps_focus_inside_and_gives_it_back_when_closed(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = dialog_view(cx, log)
    shot(cx, view)
    set_focus(cx, "behind")
    open_dialog(cx, "confirm", dialog_body(log))
    shot(cx, view)
    testing.equal(t, focused(cx), "ok")
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "no")
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "ok")
    dispatch(cx, tab(true))
    testing.equal(t, focused(cx), "no")
    move_to(cx, 2.0, 2.0)
    click(cx, 2.0, 2.0)
    testing.equal(t, focused(cx), "no")
    testing.equal(t, joined(get(log)), "")
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "confirm"), false)
    testing.equal(t, focused(cx), "behind")
}

fn test_a_dropdown_inside_a_dialog_draws_over_it_and_takes_the_pointer(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = dialog_view(cx, log)
    shot(cx, view)
    open_dialog(cx, "confirm", dialog_body(log))
    shot(cx, view)
    click_on(cx, "more")
    testing.equal(t, overlay_open(cx, "dialog-menu"), true)
    shot(cx, view)
    testing.equal(t, find(cx.state, "dialog-menu") > find(cx.state, "confirm"), true)
    click_on(cx, "dialog-menu/0")
    testing.equal(t, joined(get(log)), "menu\n")
    testing.equal(t, overlay_open(cx, "confirm"), true)
    testing.equal(t, overlay_open(cx, "dialog-menu"), false)
}

fn quads_at(sc: scene.Scene, r: geometry.Rect) -> i64 {
    var n = 0
    for q in sc.quads {
        if near(q.bounds.x, r.x) && near(q.bounds.y, r.y) && near(q.bounds.width, r.width) && near(q.bounds.height, r.height) {
            n += 1
        }
    }
    n
}

fn red_dialog() -> Element {
    red_box(10.0, 10.0)
}

fn empty_view() -> Element {
    div()
}

fn test_a_dialog_draws_its_content_as_given_on_the_backdrop(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    open_dialog(cx, "d", red_dialog)
    let sc = big(cx, empty_view)
    testing.equal(t, sc.quads.len, 2)
    testing.equal(t, sc.shadows.len, 0)
    same_rect(t, sc.quads[0].bounds, geometry.rect(0.0, 0.0, 400.0, 300.0))
    testing.equal(t, near(sc.quads[0].background.a, 0.4), true)
    same_rect(t, sc.quads[1].bounds, geometry.rect(195.0, 145.0, 10.0, 10.0))
    testing.equal(t, quads_at(sc, sc.quads[1].bounds), 1)
    testing.equal(t, quad_of(sc, 0xffffff), -1)
}

fn test_a_popover_draws_its_content_as_given(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        let content = fn() -> Element { red_box(60.0, 20.0) }
        div().size(200.0, 100.0).padding(10.0).child(div().id("open").size(30.0, 10.0).popover("pop", content))
    }
    shot(cx, view)
    click_on(cx, "open")
    let sc = shot(cx, view)
    testing.equal(t, sc.quads.len, 1)
    testing.equal(t, sc.shadows.len, 0)
    same_rect(t, sc.quads[0].bounds, geometry.rect(10.0, 20.0, 60.0, 20.0))
    testing.equal(t, sc.quads[0].border_widths.top, 0.0)
}

fn test_open_dialog_with_draws_the_backdrop_it_is_given(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let nothing = fn() {}
    open_dialog_with(cx, "d", rgba(0x336699cc), red_dialog, nothing)
    let sc = big(cx, empty_view)
    same_rect(t, sc.quads[0].bounds, geometry.rect(0.0, 0.0, 400.0, 300.0))
    testing.equal(t, same_color(sc.quads[0].background, 0x336699), true)
    testing.equal(t, near(sc.quads[0].background.a, 0.8), true)
    same_rect(t, sc.quads[1].bounds, geometry.rect(195.0, 145.0, 10.0, 10.0))
}

fn counting(n: Signal[i64]) -> fn() {
    fn() { set(n, get(n) + 1) }
}

fn settle(cx: Context) {
    dispatch(cx, platform.Event.Woken)
    big(cx, empty_view)
    dispatch(cx, platform.Event.Woken)
}

fn test_a_dialog_notifies_once_when_escape_closes_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let closed = signal(cx, 0)
    set_focus(cx, "before")
    open_dialog_with(cx, "d", rgba(0x00000066), red_dialog, counting(closed))
    settle(cx)
    big(cx, empty_view)
    testing.equal(t, get(closed), 0)
    testing.equal(t, overlay_open(cx, "d"), true)
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "d"), false)
    testing.equal(t, focused(cx), "before")
    testing.equal(t, get(closed), 0)
    settle(cx)
    testing.equal(t, get(closed), 1)
    hit_key(cx, platform.NamedKey.Escape)
    close_overlay(cx, "d")
    settle(cx)
    testing.equal(t, get(closed), 1)
}

fn test_a_dialog_notifies_once_when_close_overlay_closes_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let closed = signal(cx, 0)
    open_dialog_with(cx, "d", rgba(0x00000066), red_dialog, counting(closed))
    settle(cx)
    close_overlay(cx, "d")
    testing.equal(t, get(closed), 0)
    settle(cx)
    testing.equal(t, get(closed), 1)
    close_overlay(cx, "d")
    settle(cx)
    testing.equal(t, get(closed), 1)
}

fn test_closing_a_layer_under_a_dialog_notifies_the_dialog_once(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let lower = signal(cx, 0)
    let upper = signal(cx, 0)
    open_dialog_with(cx, "lower", rgba(0x00000066), red_dialog, counting(lower))
    settle(cx)
    open_dialog_with(cx, "upper", rgba(0x00000066), red_dialog, counting(upper))
    settle(cx)
    close_overlay(cx, "lower")
    testing.equal(t, overlay_open(cx, "upper"), false)
    settle(cx)
    testing.equal(t, get(lower), 1)
    testing.equal(t, get(upper), 1)
}

fn test_a_dialog_notifies_once_when_the_window_drops_its_layer(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let closed = signal(cx, 0)
    let with_owner = fn() -> Element {
        let content = fn() -> Element { red_box(60.0, 20.0) }
        div().size(200.0, 100.0).padding(10.0).child(div().id("open").size(30.0, 10.0).popover("pop", content))
    }
    shot(cx, with_owner)
    click_on(cx, "open")
    shot(cx, with_owner)
    open_dialog_with(cx, "d", rgba(0x00000066), red_dialog, counting(closed))
    shot(cx, with_owner)
    testing.equal(t, get(closed), 0)
    shot(cx, empty_view)
    testing.equal(t, overlay_open(cx, "d"), false)
    testing.equal(t, get(closed), 0)
    settle(cx)
    testing.equal(t, get(closed), 1)
}

fn test_a_dialog_does_not_notify_while_it_stays_open(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let closed = signal(cx, 0)
    open_dialog_with(cx, "d", rgba(0x00000066), red_dialog, counting(closed))
    settle(cx)
    settle(cx)
    hit_key(cx, platform.NamedKey.Tab)
    click_on(cx, "d")
    settle(cx)
    testing.equal(t, overlay_open(cx, "d"), true)
    testing.equal(t, get(closed), 0)
}

fn test_reopening_an_open_dialog_notifies_the_one_it_replaces(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let first = signal(cx, 0)
    let second = signal(cx, 0)
    open_dialog_with(cx, "d", rgba(0x00000066), red_dialog, counting(first))
    settle(cx)
    open_dialog_with(cx, "d", rgba(0x00000066), red_dialog, counting(second))
    settle(cx)
    testing.equal(t, overlay_open(cx, "d"), true)
    testing.equal(t, get(first), 1)
    testing.equal(t, get(second), 0)
    close_overlay(cx, "d")
    settle(cx)
    testing.equal(t, get(first), 1)
    testing.equal(t, get(second), 1)
}

fn escaping_dialog(handled: Signal[bool], presses: Signal[i64]) -> fn() -> Element {
    fn() -> Element {
        div().row().children() {
            div().id("picker").size(20.0, 10.0).focusable().on_key(fn(k: platform.KeyEvent) -> bool {
                set(presses, get(presses) + 1)
                get(handled)
            }),
            div().id("plain").size(20.0, 10.0).focusable()
        }
    }
}

fn test_escape_goes_to_the_focused_element_in_a_dialog_before_the_dialog_closes(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let handled = signal(cx, true)
    let presses = signal(cx, 0)
    open_dialog(cx, "d", escaping_dialog(handled, presses))
    big(cx, empty_view)
    testing.equal(t, focused(cx), "picker")
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "d"), true)
    testing.equal(t, get(presses), 1)
    set(handled, false)
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "d"), false)
    testing.equal(t, get(presses), 2)
}

fn test_escape_closes_a_dialog_whose_focused_element_has_no_key_handler(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let handled = signal(cx, true)
    let presses = signal(cx, 0)
    open_dialog(cx, "d", escaping_dialog(handled, presses))
    big(cx, empty_view)
    set_focus(cx, "plain")
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "d"), false)
    testing.equal(t, get(presses), 0)
}

fn test_escape_goes_to_the_focused_element_in_a_popover_before_it_closes(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let handled = signal(cx, true)
    let presses = signal(cx, 0)
    let view = fn() -> Element {
        div().size(200.0, 100.0).child(div().id("open").size(30.0, 10.0).popover("pop", escaping_dialog(handled, presses)))
    }
    shot(cx, view)
    click_on(cx, "open")
    shot(cx, view)
    set_focus(cx, "picker")
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "pop"), true)
    set(handled, false)
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "pop"), false)
}

fn dark_menu() -> MenuStyle {
    MenuStyle {
        background: rgb(0x202020)
        border: rgb(0x404040)
        highlight: rgb(0x303060)
        separator: rgb(0x505050)
        text: rgb(0xeeeeee)
    }
}

fn test_menus_draw_with_the_style_the_application_sets(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let items = fn() -> MenuItem[] { [menu_entry("Copy", fn() {}), menu_separator(), menu_entry("Paste", fn() {})] }
    let view = fn() -> Element { div().size(200.0, 100.0).child(div().id("more").size(40.0, 10.0).dropdown_menu("m", items)) }
    big(cx, view)
    click_on(cx, "more")
    let light = big(cx, view)
    testing.is_true(t, quad_of(light, 0xffffff) >= 0)
    testing.equal(t, quad_of(light, 0x202020), -1)
    set_menu_style(cx, dark_menu())
    testing.is_true(t, frame_due(cx))
    let dark = big(cx, view)
    testing.equal(t, quad_of(dark, 0xffffff), -1)
    testing.is_true(t, quad_of(dark, 0x202020) >= 0)
    testing.is_true(t, quad_of(dark, 0x505050) >= 0)
}

fn test_escape_closes_a_popover_when_the_handler_that_takes_it_is_outside_the_popover(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let handled = signal(cx, true)
    let presses = signal(cx, 0)
    let view = fn() -> Element {
        div().size(200.0, 100.0).children() {
            div().id("outside").size(30.0, 10.0).focusable().on_key(fn(k: platform.KeyEvent) -> bool { true }),
            div().id("open").size(30.0, 10.0).popover("pop", escaping_dialog(handled, presses))
        }
    }
    shot(cx, view)
    click_on(cx, "open")
    shot(cx, view)
    set_focus(cx, "outside")
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "pop"), false)
}

fn test_escape_closes_a_dialog_when_the_handler_that_takes_it_is_above_the_dialog(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let handled = signal(cx, true)
    let presses = signal(cx, 0)
    let view = fn() -> Element {
        div().size(400.0, 300.0).on_key(fn(k: platform.KeyEvent) -> bool { true })
    }
    open_dialog(cx, "d", escaping_dialog(handled, presses))
    big(cx, view)
    set_focus(cx, "plain")
    hit_key(cx, platform.NamedKey.Escape)
    testing.equal(t, overlay_open(cx, "d"), false)
    testing.equal(t, get(presses), 0)
}
