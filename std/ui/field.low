import std/builder
import std/ui/geometry
import std/ui/layout
import std/ui/platform
import std/ui/scene
import std/unicode
import uitext = std/ui/text

const control_limit: u32 = 32
const delete_code: u32 = 127

struct FieldState {
    text: str = ""
    caret: i64 = 0
    anchor: i64 = 0
    preedit: str = ""
    preedit_cursor: platform.TextRange? = none
    origin: f32 = 0.0
    scroll: f32 = 0.0
    size: f32 = 16.0
}

fn selection_color() -> geometry.Color {
    geometry.rgba(0x3b82f666)
}

fn is_field(e: Element) -> bool {
    match e.kind {
        Field => true
        _ => false
    }
}

fn field_state(st: *State, name: str) -> *FieldState {
    match st.fields[name] {
        some(existing) => return existing
        none => {}
    }
    let created = new(FieldState {})
    st.fields[name] = created
    created
}

fn sel_start(fs: *FieldState) -> i64 {
    if fs.caret < fs.anchor { fs.caret } else { fs.anchor }
}

fn sel_end(fs: *FieldState) -> i64 {
    if fs.caret < fs.anchor { fs.anchor } else { fs.caret }
}

fn has_selection(fs: *FieldState) -> bool {
    fs.caret != fs.anchor
}

fn clamped(v: i64, top: i64) -> i64 {
    if v < 0 { 0 } else if v > top { top } else { v }
}

fn gap_between(a: f32, b: f32) -> f32 {
    if a < b { b - a } else { a - b }
}

fn runes(s: str) -> i64 {
    var n = 0
    for _ in s {
        n += 1
    }
    n
}

fn single_line(s: str) -> str {
    var out = builder.builder()
    for c in s {
        if c >= control_limit && c != delete_code {
            builder.write_char(mut out, c)
        }
    }
    builder.to_str(out)
}

fn blank(s: str) -> bool {
    for c in s {
        if !unicode.is_space(c) {
            return false
        }
    }
    true
}

fn previous_grapheme(s: str, at: i64) -> i64 {
    var start = 0
    for start < at {
        let stop = unicode.grapheme_end(s, start)
        if stop >= at {
            return start
        }
        start = stop
    }
    0
}

fn next_grapheme(s: str, at: i64) -> i64 {
    if at >= s.len { s.len } else { unicode.grapheme_end(s, at) }
}

fn next_word(s: str, at: i64) -> i64 {
    var pos = at
    for pos < s.len {
        let stop = unicode.word_end(s, pos)
        let spaces = blank(s[pos..stop])
        pos = stop
        if !spaces {
            return pos
        }
    }
    s.len
}

fn previous_word(s: str, at: i64) -> i64 {
    var start = 0
    var found = 0
    for start < at {
        let stop = unicode.word_end(s, start)
        if !blank(s[start..stop]) {
            found = start
        }
        start = stop
    }
    found
}

fn glyph_x(l: uitext.Layout, index: i64) -> f32 {
    let line = l.lines[0]
    if index < line.glyphs.len { line.glyphs[index].x } else { line.end }
}

fn x_of(l: uitext.Layout, s: str, at: i64) -> f32 {
    glyph_x(l, runes(s[..at]))
}

fn move_caret(fs: *FieldState, to: i64, extend: bool) {
    fs.caret = to
    if !extend {
        fs.anchor = to
    }
}

fn announce(st: *State, e: Element, s: str) {
    st.dirty = true
    for l in e.listeners {
        match l {
            Change(f) => f(s)
            _ => {}
        }
    }
}

fn replace_range(st: *State, e: Element, fs: *FieldState, lo: i64, hi: i64, s: str) {
    let edited = "{fs.text[..lo]}{s}{fs.text[hi..]}"
    fs.text = edited
    fs.caret = lo + s.len
    fs.anchor = fs.caret
    fs.preedit = ""
    fs.preedit_cursor = none
    announce(st, e, edited)
}

fn replace_selection(st: *State, e: Element, fs: *FieldState, s: str) {
    replace_range(st, e, fs, sel_start(fs), sel_end(fs), s)
}

fn field_key(st: *State, at: i64, k: platform.KeyEvent) -> bool {
    let h = st.hitboxes[at]
    if !is_field(h.element) || !k.pressed {
        return false
    }
    let fs = field_state(st, h.key)
    let shortcut = (k.modifiers.control || k.modifiers.super) && !k.modifiers.alt
    match k.key {
        Named(named) => named_key(st, h.element, fs, named, k.modifiers)
        Character(c) => {
            if shortcut {
                shortcut_key(st, h.element, fs, c)
            } else {
                typed_key(st, h.element, fs, k.text)
            }
        }
    }
}

fn typed_key(st: *State, e: Element, fs: *FieldState, s: str) -> bool {
    let clean = single_line(s)
    if clean.len == 0 {
        return false
    }
    replace_selection(st, e, fs, clean)
    true
}

fn shortcut_key(st: *State, e: Element, fs: *FieldState, c: str) -> bool {
    let letter = unicode.lower(c)
    if letter == "a" {
        fs.anchor = 0
        fs.caret = fs.text.len
        st.dirty = true
        return true
    }
    if letter == "c" {
        copy_selection(st, fs)
        return true
    }
    if letter == "x" {
        copy_selection(st, fs)
        if has_selection(fs) {
            replace_selection(st, e, fs, "")
        }
        return true
    }
    if letter == "v" {
        paste_text(st, e, fs)
        return true
    }
    false
}

fn copy_selection(st: *State, fs: *FieldState) {
    if has_selection(fs) {
        st.copy(fs.text[sel_start(fs)..sel_end(fs)])
    }
}

fn paste_text(st: *State, e: Element, fs: *FieldState) {
    let got = st.paste() ?? return
    let clean = single_line(got)
    if clean.len > 0 {
        replace_selection(st, e, fs, clean)
    }
}

fn named_key(st: *State, e: Element, fs: *FieldState, named: platform.NamedKey, m: platform.Modifiers) -> bool {
    match named {
        Left => {
            move_left(fs, m)
            st.dirty = true
            true
        }
        Right => {
            move_right(fs, m)
            st.dirty = true
            true
        }
        Home => {
            move_caret(fs, 0, m.shift)
            st.dirty = true
            true
        }
        End => {
            move_caret(fs, fs.text.len, m.shift)
            st.dirty = true
            true
        }
        Backspace => {
            remove_backward(st, e, fs, m.control)
            true
        }
        Delete => {
            remove_forward(st, e, fs, m.control)
            true
        }
        _ => false
    }
}

fn move_left(fs: *FieldState, m: platform.Modifiers) {
    if has_selection(fs) && !m.shift {
        move_caret(fs, sel_start(fs), false)
        return
    }
    let to = if m.control { previous_word(fs.text, fs.caret) } else { previous_grapheme(fs.text, fs.caret) }
    move_caret(fs, to, m.shift)
}

fn move_right(fs: *FieldState, m: platform.Modifiers) {
    if has_selection(fs) && !m.shift {
        move_caret(fs, sel_end(fs), false)
        return
    }
    let to = if m.control { next_word(fs.text, fs.caret) } else { next_grapheme(fs.text, fs.caret) }
    move_caret(fs, to, m.shift)
}

fn remove_backward(st: *State, e: Element, fs: *FieldState, by_word: bool) {
    if has_selection(fs) {
        replace_selection(st, e, fs, "")
    } else if fs.caret > 0 {
        let lo = if by_word { previous_word(fs.text, fs.caret) } else { previous_grapheme(fs.text, fs.caret) }
        replace_range(st, e, fs, lo, fs.caret, "")
    }
}

fn remove_forward(st: *State, e: Element, fs: *FieldState, by_word: bool) {
    if has_selection(fs) {
        replace_selection(st, e, fs, "")
    } else if fs.caret < fs.text.len {
        let hi = if by_word { next_word(fs.text, fs.caret) } else { next_grapheme(fs.text, fs.caret) }
        replace_range(st, e, fs, fs.caret, hi, "")
    }
}

fn focused_field(st: *State) -> i64 {
    let at = find(st, st.focus)
    if at >= 0 && is_field(st.hitboxes[at].element) { at } else { -1 }
}

fn field_preedit(st: *State, s: str, range: platform.TextRange?) {
    let at = focused_field(st)
    if at < 0 {
        return
    }
    let fs = field_state(st, st.hitboxes[at].key)
    let clean = single_line(s)
    fs.preedit = clean
    fs.preedit_cursor = if clean.len == s.len { range } else { none }
    st.dirty = true
}

fn field_commit(st: *State, s: str) {
    let at = focused_field(st)
    if at < 0 {
        return
    }
    let fs = field_state(st, st.hitboxes[at].key)
    replace_selection(st, st.hitboxes[at].element, fs, single_line(s))
}

fn index_at(st: *State, fs: *FieldState, x: f32) -> i64 {
    let l = uitext.wrap(mut st.text, fs.text, fs.size, layout.unbounded)
    let local = x - fs.origin
    var best = 0
    var best_gap = gap_between(local, glyph_x(l, 0))
    var at = 0
    var index = 0
    for at < fs.text.len {
        let stop = unicode.grapheme_end(fs.text, at)
        index += runes(fs.text[at..stop])
        at = stop
        let gap = gap_between(local, glyph_x(l, index))
        if gap < best_gap {
            best_gap = gap
            best = at
        }
    }
    best
}

fn field_press(st: *State) {
    let at = topmost(st)
    if at < 0 || !is_field(st.hitboxes[at].element) {
        return
    }
    let h = st.hitboxes[at]
    let fs = field_state(st, h.key)
    let to = index_at(st, fs, st.pointer.x)
    fs.caret = to
    fs.anchor = to
    st.drag = h.key
    st.dirty = true
}

fn field_drag(st: *State) {
    if st.drag.len == 0 {
        return
    }
    if st.held == none {
        st.drag = ""
        return
    }
    let fs = field_state(st, st.drag)
    fs.caret = index_at(st, fs, st.pointer.x)
    st.dirty = true
}

fn solid(mut sc: scene.Scene, r: geometry.Rect, c: geometry.Color, scale: f32) {
    scene.push_quad(mut sc, scene.Quad { bounds: geometry.snap(r, scale), background: c })
}

fn snapped(v: f32, scale: f32) -> f32 {
    floor(v * scale + 0.5) / scale
}

fn paint_field(st: *State, mut sc: scene.Scene, e: Element, at: i64, content: geometry.Rect, own: TextStyle, scale: f32) {
    let name = st.hitboxes[at].key
    let fs = field_state(st, name)
    fs.text = e.content
    fs.size = own.size
    fs.caret = clamped(fs.caret, fs.text.len)
    fs.anchor = clamped(fs.anchor, fs.text.len)
    let live = name == st.focus
    let lo = sel_start(fs)
    let hi = sel_end(fs)
    let composing = live && fs.preedit.len > 0
    let shown = if composing { "{fs.text[..lo]}{fs.preedit}{fs.text[hi..]}" } else { fs.text }
    let l = uitext.wrap(mut st.text, shown, own.size, layout.unbounded)
    var caret_at = fs.caret
    if composing {
        let inside = fs.preedit_cursor
        caret_at = lo + fs.preedit.len
        if inside != none {
            let range = inside ?? platform.TextRange { start: 0, end: 0 }
            caret_at = lo + clamped(range.end, fs.preedit.len)
        }
    }
    let caret_x = x_of(l, shown, caret_at)
    let line_end = l.lines[0].end
    let total = if line_end > caret_x { line_end } else { caret_x }
    let room = content.width - 1.0
    var scroll = fs.scroll
    if scroll > total - room {
        scroll = total - room
    }
    if scroll < 0.0 {
        scroll = 0.0
    }
    if live {
        if caret_x - scroll > room {
            scroll = caret_x - room
        }
        if caret_x < scroll {
            scroll = caret_x
        }
    }
    fs.scroll = scroll
    fs.origin = content.x - scroll
    scene.push_clip(mut sc, geometry.cover(content, scale))
    if live && !composing && lo != hi {
        let left = fs.origin + x_of(l, shown, lo)
        let right = fs.origin + x_of(l, shown, hi)
        solid(mut sc, geometry.rect(left, content.y, right - left, l.height), selection_color(), scale)
    }
    uitext.paint(mut st.text, mut sc, l, geometry.point(fs.origin, content.y), own.color, scale)
    if composing {
        let left = fs.origin + x_of(l, shown, lo)
        let right = fs.origin + x_of(l, shown, lo + fs.preedit.len)
        solid(mut sc, geometry.rect(left, content.y + l.height - 1.0, right - left, 1.0), own.color, scale)
    }
    if live {
        let x = snapped(fs.origin + caret_x, scale)
        solid(mut sc, geometry.rect(x, content.y, 1.0, l.height), own.color, scale)
        st.caret = platform.Caret { x: i64(floor(fs.origin + caret_x)), y: i64(floor(content.y)), width: 0, height: i64(floor(l.height + 0.999)) }
    }
    scene.pop_clip(mut sc)
}
