import std/testing
import std/ui/geometry
import std/ui/platform
import std/ui/scene
import uitext = std/ui/text

fn window() -> geometry.Size {
    geometry.size(200.0, 100.0)
}

fn near(got: f32, want: f32) -> bool {
    got > want - 0.01 && got < want + 0.01
}

fn same_rect(t: *testing.T, got: geometry.Rect, want: geometry.Rect) {
    if !near(got.x, want.x) || !near(got.y, want.y) || !near(got.width, want.width) || !near(got.height, want.height) {
        t.error("rect {got.x} {got.y} {got.width} {got.height}, want {want.x} {want.y} {want.width} {want.height}")
    }
}

fn white(width: i64, height: i64) -> u8[] {
    var pixels: u8[] = []
    for _ in 0..width * height * 4 {
        pixels.push(255)
    }
    pixels
}

fn white_picture(cx: Context, width: i64, height: i64) -> uitext.Image {
    let pixels = white(width, height)
    add_image(cx, width, height, pixels) ?? uitext.Image { id: -1, width: 0, height: 0 }
}

fn picture_over_text(picture: uitext.Image) -> Element {
    column(div()).child(image(picture).size(110.0, 10.0)).child(text("Hello"))
}

fn test_a_picture_wider_than_the_atlas_draws_beside_the_text_on_every_frame(t: *testing.T) {
    let cx = headless(rgb(0x000000))
    let picture = white_picture(cx, 1100, 100)
    let view = fn() -> Element { picture_over_text(picture) }
    for _ in 0..3 {
        let sc = frame(cx, view, window(), 1.0)
        testing.equal(t, sc.polychrome_sprites.len, 1)
        testing.equal(t, sc.sprites.len, 5)
    }
}

fn test_a_frame_that_fills_the_atlas_makes_a_frame_due_that_draws_everything(t: *testing.T) {
    let cx = headless(rgb(0x000000))
    let picture = white_picture(cx, 1020, 1020)
    let view = fn() -> Element { picture_over_text(picture) }
    let first = frame(cx, view, window(), 1.0)
    testing.equal(t, first.sprites.len, 0)
    testing.is_true(t, frame_due(cx))
    let second = frame(cx, view, window(), 1.0)
    testing.equal(t, second.polychrome_sprites.len, 1)
    testing.equal(t, second.sprites.len, 5)
    testing.is_false(t, frame_due(cx))
}

fn test_a_picture_wider_than_the_atlas_added_once_a_frame_has_begun_waits_a_frame_without_dropping_the_text(t: *testing.T) {
    let cx = headless(rgb(0x000000))
    let shown = signal(cx, uitext.Image { id: -1, width: 0, height: 0 })
    let view = fn() -> Element {
        let picture = get(shown)
        if picture.id < 0 {
            return text("Wait")
        }
        picture_over_text(picture)
    }
    frame(cx, view, window(), 1.0)
    post(handle(cx), fn() {
        let added = white_picture(cx, 1100, 100)
        set(shown, added)
    })
    let first = frame(cx, view, window(), 1.0)
    testing.equal(t, first.polychrome_sprites.len, 0)
    testing.equal(t, first.sprites.len, 5)
    testing.is_true(t, frame_due(cx))
    let second = frame(cx, view, window(), 1.0)
    testing.equal(t, second.polychrome_sprites.len, 1)
    testing.equal(t, second.sprites.len, 5)
}

fn test_a_window_border_reaches_the_platform_as_rrggbb(t: *testing.T) {
    testing.equal(t, platform_border(some(rgb(0x445566))), some(0x445566))
    testing.equal(t, platform_border(none), none)
}

fn test_frame_lays_out_and_paints_boxes(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element {
        div().column().padding(10.0).gap(4.0).background(rgb(0x202020)).children() {
            div().height(20.0).background(rgb(0xff0000)),
            div().height(30.0).background(rgb(0x00ff00)).rounded(6.0),
        }
    }
    let sc = frame(cx, view, window(), 1.0)
    testing.equal(t, sc.quads.len, 3)
    same_rect(t, sc.quads[0].bounds, geometry.rect(0.0, 0.0, 200.0, 100.0))
    same_rect(t, sc.quads[1].bounds, geometry.rect(10.0, 10.0, 180.0, 20.0))
    same_rect(t, sc.quads[2].bounds, geometry.rect(10.0, 34.0, 180.0, 30.0))
    testing.equal(t, sc.quads[2].corner_radii.top_left, 6.0)
    testing.equal(t, sc.quads[1].background.r, 1.0)
}

fn test_radii_are_limited_to_half_the_smaller_side(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element { div().size(60.0, 20.0).background(rgb(0x3366cc)).rounded(30.0) }
    let sc = frame(cx, view, window(), 1.0)
    testing.equal(t, sc.quads[0].corner_radii.top_left, 10.0)
    testing.equal(t, sc.quads[0].corner_radii.bottom_right, 10.0)
}

fn test_the_border_is_a_quad_over_the_children_and_the_background_has_none(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element {
        div().size(60.0, 40.0).padding(5.0).background(rgb(0x3366cc)).border(3.0, rgb(0xe67e22)).child(div().size(20.0, 10.0).background(rgb(0x00ff00)))
    }
    let sc = frame(cx, view, window(), 1.0)
    testing.is_true(t, sc.quads.len >= 3)
    testing.equal(t, sc.quads[0].background.b, 0.8)
    testing.equal(t, sc.quads[0].border_widths.top, 0.0)
    testing.equal(t, sc.quads[1].background.g, 1.0)
    testing.equal(t, sc.quads[2].background.a, 0.0)
    testing.equal(t, sc.quads[2].border_color.r, 0.9019608)
    testing.equal(t, sc.quads[2].border_widths.top, 3.0)
}

fn test_each_side_has_its_own_padding_border_and_margin(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element {
        div().row().size(100.0, 60.0).padding_top(2.0).padding_left(14.0).border_top(3.0).border_left(5.0).border_color(rgb(0xe67e22)).children() {
            div().size(10.0, 10.0).margin_left(7.0).margin_top(-1.0).background(rgb(0x00ff00)),
            div().size(10.0, 10.0).margin_left_auto().background(rgb(0x0000ff))
        }
    }
    let sc = frame(cx, view, window(), 1.0)
    same_rect(t, sc.quads[0].bounds, geometry.rect(5.0 + 14.0 + 7.0, 3.0 + 2.0 - 1.0, 10.0, 10.0))
    same_rect(t, sc.quads[1].bounds, geometry.rect(90.0, 5.0, 10.0, 10.0))
}

fn test_sizes_are_limited_by_their_minimum_and_maximum(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element {
        div().row().children() {
            div().width(10.0).min_width(30.0).height(5.0).background(rgb(0xff0000)),
            div().width(80.0).max_width(50.0).min_height(12.0).max_height(8.0).background(rgb(0x00ff00))
        }
    }
    let sc = frame(cx, view, window(), 1.0)
    same_rect(t, sc.quads[0].bounds, geometry.rect(0.0, 0.0, 30.0, 5.0))
    same_rect(t, sc.quads[1].bounds, geometry.rect(30.0, 0.0, 50.0, 12.0))
}

fn test_an_absolute_element_leaves_the_flow_and_sits_by_its_inset(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element {
        div().size(100.0, 80.0).padding(4.0).children() {
            div().absolute().right(4.0).bottom(6.0).size(20.0, 10.0).background(rgb(0xff0000)),
            div().absolute().left(40.0).right(40.0).top(30.0).height(10.0).background(rgb(0x00ff00)),
            div().size(12.0, 12.0).relative().top(2.0).left(3.0).background(rgb(0x0000ff))
        }
    }
    let sc = frame(cx, view, window(), 1.0)
    same_rect(t, sc.quads[0].bounds, geometry.rect(76.0, 64.0, 20.0, 10.0))
    same_rect(t, sc.quads[1].bounds, geometry.rect(40.0, 30.0, 20.0, 10.0))
    same_rect(t, sc.quads[2].bounds, geometry.rect(7.0, 6.0, 12.0, 12.0))
}

fn test_flex_1_starts_from_a_basis_of_zero_percent_and_flex_auto_from_the_size(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element {
        div().column().children() {
            div().row().size(100.0, 10.0).children() {
                div().flex_1().width(40.0).background(rgb(0xff0000)),
                div().flex_1().background(rgb(0x00ff00))
            },
            div().row().size(100.0, 10.0).children() {
                div().flex_auto().width(40.0).background(rgb(0xff0000)),
                div().flex_auto().width(20.0).background(rgb(0x00ff00))
            }
        }
    }
    let sc = frame(cx, view, window(), 1.0)
    same_rect(t, sc.quads[0].bounds, geometry.rect(0.0, 0.0, 50.0, 10.0))
    same_rect(t, sc.quads[1].bounds, geometry.rect(50.0, 0.0, 50.0, 10.0))
    same_rect(t, sc.quads[2].bounds, geometry.rect(0.0, 10.0, 60.0, 10.0))
    same_rect(t, sc.quads[3].bounds, geometry.rect(60.0, 10.0, 40.0, 10.0))
}

fn test_flex_wrap_starts_a_line_when_the_children_do_not_fit(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element {
        div().row().flex_wrap().size(70.0, 24.0).gap(4.0).children() {
            div().size(30.0, 10.0).background(rgb(0xff0000)),
            div().size(30.0, 10.0).background(rgb(0x00ff00)),
            div().size(30.0, 10.0).background(rgb(0x0000ff))
        }
    }
    let sc = frame(cx, view, window(), 1.0)
    same_rect(t, sc.quads[1].bounds, geometry.rect(34.0, 0.0, 30.0, 10.0))
    same_rect(t, sc.quads[2].bounds, geometry.rect(0.0, 14.0, 30.0, 10.0))
}

fn test_opacity_multiplies_the_alpha_of_each_colour_down_the_tree(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element {
        div().size(60.0, 40.0).background(rgb(0x3366cc)).opacity(0.5).text_color(rgb(0x00ff00)).text_size(12.0).children() {
            div().size(20.0, 10.0).background(rgb(0xff0000)).opacity(0.5),
            text("Hi")
        }
    }
    let sc = frame(cx, view, window(), 1.0)
    testing.equal(t, sc.quads[0].background.a, 0.5)
    testing.equal(t, sc.quads[1].background.a, 0.25)
    testing.equal(t, sc.sprites[0].color.a, 0.5)
}

fn test_a_colour_is_faded_by_a_factor_clamped_to_zero_and_one(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element {
        div().children() {
            div().size(10.0, 10.0).background(rgb(0xff0000)).opacity(2.0),
            div().size(10.0, 10.0).background(rgb(0x00ff00)).opacity(-1.0)
        }
    }
    let sc = frame(cx, view, window(), 1.0)
    testing.equal(t, sc.quads[0].background.a, 1.0)
    testing.equal(t, sc.quads[1].background.a, 0.0)
}

fn test_frame_scales_to_device_pixels(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { div().size(40.0, 20.0).background(rgb(0x0000ff)) }
    let sc = frame(cx, view, geometry.size(100.0, 50.0), 2.0)
    testing.equal(t, sc.width, 200)
    testing.equal(t, sc.height, 100)
    same_rect(t, sc.quads[0].bounds, geometry.rect(0.0, 0.0, 80.0, 40.0))
}

fn test_text_paints_sprites_in_its_colour(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { div().padding(8.0).text_color(rgb(0x00ff00)).text_size(20.0).child(text("Hi")) }
    let sc = frame(cx, view, window(), 1.0)
    testing.is_true(t, sc.sprites.len == 2)
    testing.equal(t, sc.sprites[0].color.g, 1.0)
    testing.is_true(t, sc.sprites[0].bounds.x >= 8.0)
}

fn dash() -> str {
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"12\" x2=\"20\" y2=\"12\"/></svg>"
}

fn test_icon_is_a_sprite_in_the_text_colour_over_its_box(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { div().padding(8.0).text_color(rgb(0x00ff00)).child(icon(dash())) }
    let sc = frame(cx, view, window(), 1.0)
    testing.equal(t, sc.sprites.len, 1)
    testing.equal(t, sc.sprites[0].color.g, 1.0)
    same_rect(t, sc.sprites[0].bounds, geometry.rect(8.0, 8.0, 16.0, 16.0))
}

fn test_icon_follows_the_size_and_scale_it_is_given(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { icon(dash()).size(24.0, 24.0) }
    let sc = frame(cx, view, window(), 2.0)
    same_rect(t, sc.sprites[0].bounds, geometry.rect(0.0, 0.0, 48.0, 48.0))
}

fn test_shadow_is_drawn_below_the_box(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(50.0, 50.0).background(rgb(0xffffff)).shadow(BoxShadow { blur: 8.0, y: 2.0 })
    }
    let sc = frame(cx, view, window(), 1.0)
    testing.equal(t, sc.shadows.len, 1)
    testing.equal(t, sc.shadows[0].bounds.y, 2.0)
    testing.equal(t, sc.shadows[0].sigma, 8.0)
}

fn test_signals_request_a_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let count = signal(cx, 0)
    let view = fn() -> Element { text("n={get(count)}") }
    testing.is_true(t, frame_due(cx))
    frame(cx, view, window(), 1.0)
    testing.is_false(t, frame_due(cx))
    set(count, 3)
    testing.is_true(t, frame_due(cx))
    frame(cx, view, window(), 1.0)
    update(count, fn(n: i64) -> i64 { n + 1 })
    testing.equal(t, get(count), 4)
    testing.is_true(t, frame_due(cx))
}

fn test_posted_closures_run_before_the_next_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let count = signal(cx, 0)
    let view = fn() -> Element { text("n={get(count)}") }
    frame(cx, view, window(), 1.0)
    post(handle(cx), fn() { set(count, 7) })
    testing.is_false(t, frame_due(cx))
    dispatch(cx, platform.Event.Woken)
    testing.equal(t, get(count), 7)
    testing.is_true(t, frame_due(cx))
}

fn test_dispatch_resize_and_close(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    dispatch(cx, platform.Event.Resized(320.0, 240.0, 2.0))
    testing.equal(t, cx.state.width, 320.0)
    testing.equal(t, cx.state.scale, 2.0)
    testing.is_false(t, closed(cx))
    dispatch(cx, platform.Event.CloseRequested)
    testing.is_true(t, closed(cx))
}

fn test_a_rem_is_sixteen_pixels_until_it_is_set(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    testing.equal(t, rems(cx, 0.5), 8.0)
    set_rem_size(cx, 13.0)
    testing.equal(t, rems(cx, 0.5), 6.5)
}

fn lined(size: f32, height: f32?) -> Element {
    let row = div().background(rgb(0x202020)).text_size(size).child(text("hello"))
    match height {
        some(h) => row.line_height(h)
        none => row
    }
}

fn test_a_line_is_the_golden_ratio_of_the_size_unless_a_height_is_set(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().column().items_start().children() {
            lined(13.0, none),
            lined(13.0, 20.0),
            lined(16.0, none),
        }
    }
    let one = frame(cx, view, window(), 1.0)
    testing.equal(t, one.quads[0].bounds.height, 21.0)
    testing.equal(t, one.quads[1].bounds.height, 20.0)
    testing.equal(t, one.quads[2].bounds.height, 26.0)
    let dense = frame(cx, view, window(), 2.0)
    testing.equal(t, dense.quads[0].bounds.height, 42.0)
    testing.equal(t, dense.quads[1].bounds.height, 40.0)
}

fn test_the_default_text_size_is_a_rem(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    set_rem_size(cx, 20.0)
    let view = fn() -> Element { div().items_start().children() { div().background(rgb(0x202020)).child(text("hello")) } }
    let sc = frame(cx, view, window(), 1.0)
    testing.equal(t, sc.quads[0].bounds.height, 32.0)
}

fn test_a_rem_gap_rounds_to_device_pixels_at_each_scale(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    set_rem_size(cx, 13.0)
    let view = fn() -> Element {
        div().gap(rems(cx, 0.5)).background(rgb(0x202020)).children() {
            div().size(40.0, 20.0).background(rgb(0xff0000)),
            div().size(40.0, 20.0).background(rgb(0x00ff00)),
        }
    }
    let one = frame(cx, view, window(), 1.0)
    testing.equal(t, one.quads[2].bounds.x, 46.0)
    let five_quarters = frame(cx, view, window(), 1.25)
    testing.equal(t, five_quarters.quads[2].bounds.x, 58.0)
    let seven_quarters = frame(cx, view, window(), 1.75)
    testing.equal(t, seven_quarters.quads[2].bounds.x, 81.0)
}
