import std/testing
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn window() -> geometry.Size {
    geometry.size(200.0, 100.0)
}

fn near(got: f32, want: f32) -> bool {
    got > want - 0.01 && got < want + 0.01
}

fn same_rect(t: *testing.T, got: geometry.Rect, want: geometry.Rect) {
    if !near(got.x, want.x) || !near(got.y, want.y) || !near(got.width, want.width) || !near(got.height, want.height) {
        t.error("rect {got.x} {got.y} {got.width} {got.height}, want {want.x} {want.y} {want.width} {want.height}")
    }
}

fn test_frame_lays_out_and_paints_boxes(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let view = fn() -> Element {
        div().column().padding(10.0).gap(4.0).background(rgb(0x202020)).children() {
            div().height(20.0).background(rgb(0xff0000)),
            div().height(30.0).background(rgb(0x00ff00)).rounded(6.0),
        }
    }
    let sc = frame(cx, view, window(), 1.0)
    testing.equal(t, sc.quads.len, 3)
    same_rect(t, sc.quads[0].bounds, geometry.rect(0.0, 0.0, 200.0, 100.0))
    same_rect(t, sc.quads[1].bounds, geometry.rect(10.0, 10.0, 180.0, 20.0))
    same_rect(t, sc.quads[2].bounds, geometry.rect(10.0, 34.0, 180.0, 30.0))
    testing.equal(t, sc.quads[2].corner_radii.top_left, 6.0)
    testing.equal(t, sc.quads[1].background.r, 1.0)
}

fn test_frame_scales_to_device_pixels(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { div().size(40.0, 20.0).background(rgb(0x0000ff)) }
    let sc = frame(cx, view, geometry.size(100.0, 50.0), 2.0)
    testing.equal(t, sc.width, 200)
    testing.equal(t, sc.height, 100)
    same_rect(t, sc.quads[0].bounds, geometry.rect(0.0, 0.0, 80.0, 40.0))
}

fn test_text_paints_sprites_in_its_colour(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { div().padding(8.0).text_color(rgb(0x00ff00)).text_size(20.0).child(text("Hi")) }
    let sc = frame(cx, view, window(), 1.0)
    testing.is_true(t, sc.sprites.len == 2)
    testing.equal(t, sc.sprites[0].color.g, 1.0)
    testing.is_true(t, sc.sprites[0].bounds.x >= 8.0)
}

fn test_shadow_is_drawn_below_the_box(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(50.0, 50.0).background(rgb(0xffffff)).shadow(BoxShadow { blur: 8.0, y: 2.0 })
    }
    let sc = frame(cx, view, window(), 1.0)
    testing.equal(t, sc.shadows.len, 1)
    testing.equal(t, sc.shadows[0].bounds.y, 2.0)
    testing.equal(t, sc.shadows[0].sigma, 8.0)
}

fn test_signals_request_a_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let count = signal(cx, 0)
    let view = fn() -> Element { text("n={get(count)}") }
    testing.is_true(t, frame_due(cx))
    frame(cx, view, window(), 1.0)
    testing.is_false(t, frame_due(cx))
    set(count, 3)
    testing.is_true(t, frame_due(cx))
    frame(cx, view, window(), 1.0)
    update(count, fn(n: i64) -> i64 { n + 1 })
    testing.equal(t, get(count), 4)
    testing.is_true(t, frame_due(cx))
}

fn test_posted_closures_run_before_the_next_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let count = signal(cx, 0)
    let view = fn() -> Element { text("n={get(count)}") }
    frame(cx, view, window(), 1.0)
    post(handle(cx), fn() { set(count, 7) })
    testing.is_false(t, frame_due(cx))
    dispatch(cx, platform.Event.Woken)
    testing.equal(t, get(count), 7)
    testing.is_true(t, frame_due(cx))
}

fn test_dispatch_resize_and_close(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    dispatch(cx, platform.Event.Resized(320, 240, 2))
    testing.equal(t, cx.state.width, 320.0)
    testing.equal(t, cx.state.scale, 2.0)
    testing.is_false(t, closed(cx))
    dispatch(cx, platform.Event.CloseRequested)
    testing.is_true(t, closed(cx))
}
