struct AreaWalk {
    line: i64
    short: bool
}

fn area_next_visible(src: LineSource, count: i64, from: i64, dir: i64) -> i64 {
    var line = from + dir
    for line >= 0 && line < count && area_hidden(src, line) {
        line += dir
    }
    if line < 0 || line >= count { -1 } else { line }
}

fn area_walk(src: LineSource, count: i64, from: i64, rows: i64) -> AreaWalk {
    let dir = if rows < 0 { -1 } else { 1 }
    var left = if rows < 0 { -rows } else { rows }
    var line = from
    for left > 0 {
        let next = area_next_visible(src, count, line, dir)
        if next < 0 {
            return AreaWalk { line, short: true }
        }
        line = next
        left -= 1
    }
    AreaWalk { line, short: false }
}

fn area_visible_near(src: LineSource, count: i64, line: i64) -> i64 {
    let at = clamped(line, count - 1)
    if !area_hidden(src, at) {
        return at
    }
    let above = area_next_visible(src, count, at, -1)
    if above >= 0 {
        return above
    }
    let below = area_next_visible(src, count, at, 1)
    if below >= 0 { below } else { at }
}

fn area_top_line(src: LineSource, count: i64) -> i64 {
    area_visible_near(src, count, 0)
}

fn area_bottom_line(src: LineSource, count: i64) -> i64 {
    area_visible_near(src, count, count - 1)
}

fn area_doc_start(src: LineSource, count: i64) -> TextPosition {
    area_pos(area_top_line(src, count), 0)
}

fn area_doc_end(src: LineSource, count: i64) -> TextPosition {
    let line = area_bottom_line(src, count)
    area_pos(line, src.line_text(line).len)
}

fn area_hidden(src: LineSource, line: i64) -> bool {
    src.hidden_before(line + 1) > 0 && src.line_hidden(line)
}

fn area_rows_before(src: LineSource, line: i64) -> i64 {
    line - src.hidden_before(line)
}

fn area_rows_between(src: LineSource, from: i64, to: i64) -> i64 {
    area_rows_before(src, to + 1) - area_rows_before(src, from + 1)
}

fn area_row_line(src: LineSource, count: i64, row: i64) -> i64 {
    if row >= area_rows_before(src, count) {
        return area_bottom_line(src, count)
    }
    var lo = 0
    var hi = count - 1
    for lo < hi {
        let mid = (lo + hi) / 2
        if area_rows_before(src, mid + 1) > row {
            hi = mid
        } else {
            lo = mid + 1
        }
    }
    lo
}

fn area_row_of(rows: AreaRow[], line: i64) -> i64 {
    var lo = 0
    var hi = rows.len
    for lo < hi {
        let mid = (lo + hi) / 2
        if rows[mid].line < line {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < rows.len && rows[lo].line == line { lo } else { -1 }
}
