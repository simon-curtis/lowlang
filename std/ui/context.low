import std/ui/geometry
import std/ui/layout
import std/ui/platform
import std/ui/scene
import uitext = std/ui/text

struct Hitbox {
    bounds: geometry.Rect
    key: str
    parent: i64
    element: Element
    offset: geometry.Point
    scroll_max: geometry.Point
    rect: geometry.Rect
    bound: i64[]
    hidden: bool = false
}

struct NamedGroup {
    name: str
    at: i64
}

struct Laid {
    node: i64
    element: Element
    children: Laid[]
}

struct TextStyle {
    color: geometry.Color
    text: uitext.Style
    opacity: f32 = 1.0
}

fn faded(c: geometry.Color, opacity: f32) -> geometry.Color {
    geometry.Color { r: c.r, g: c.g, b: c.b, a: c.a * within(opacity, 0.0, 1.0) }
}

struct Walk {
    parent: i64
    clip: geometry.Rect
    shift: geometry.Point
    groups: NamedGroup[] = []
    hidden: bool = false
    text: TextStyle = TextStyle { color: geometry.Color {}, text: uitext.Style {} }
    scale: f32 = 1.0
}

struct State {
    text: uitext.System
    background: geometry.Color
    dirty: bool = true
    closed: bool = false
    width: f32 = 0.0
    height: f32 = 0.0
    scale: f32 = 1.0
    rem: f32 = 16.0
    hitboxes: Hitbox[] = []
    hits: bool[] = []
    virtuals: [i64: VirtualRow[]] = [:]
    inside: bool[] = []
    wheel: bool[] = []
    viewport: geometry.Rect = geometry.Rect {}
    rects: [str: geometry.Rect] = [:]
    last_rects: [str: geometry.Rect] = [:]
    deferred: DeferredDraw[] = []
    anchor_shifts: geometry.Point[] = []
    anchors_painted: i64 = 0
    layers: Layer[] = []
    layer_draws: LayerDraw[] = []
    tip: TooltipState = TooltipState {}
    painted: i64 = 0
    concealing: bool = false
    pointer: geometry.Point = geometry.Point {}
    pointer_inside: bool = false
    hovered: str = ""
    pressed: [str: bool] = [:]
    held: platform.Button? = none
    buttons: platform.Button[] = []
    modifiers: platform.Modifiers = platform.Modifiers {}
    stopped: bool = false
    focus: str = ""
    scroll: [str: geometry.Point] = [:]
    window_focused: bool = false
    fields: [str: *FieldState] = [:]
    drag: str = ""
    dragged: ActiveDrag? = none
    drag_view: DragView? = none
    press_point: geometry.Point = geometry.Point {}
    caret: platform.Caret? = none
    applied_caret: platform.Caret? = none
    applied_cursor: platform.Cursor = platform.Cursor.Arrow
    memory: str? = none
    maximized: bool = false
    minimize: fn()
    zoom: fn()
    root_hitbox: i64 = -1
    keymap: KeyBinding[] = []
    pending_keys: platform.KeyEvent[] = []
    pending_focus: str = ""
    pending_timer: i64 = 0
    manual_ms: i64 = 0
    timers: Timer[] = []
    next_timer: i64 = 0
    clock: fn() -> i64
    posts: chan[fn()]
    wake: fn()
    copy: fn(str)
    paste: fn() -> str?
}

/// The state of one user interface apart from its window: the signals' owner, the text system, and what the pointer and the keyboard are on.
///
/// A context is a handle: copies share the state. `frame` and `dispatch` drive it without a window or a GPU, as `run` drives it with them.
pub struct Context {
    state: *State
}

/// A copyable handle that runs closures on a context's green thread from any other.
pub struct Handle {
    posts: chan[fn()]
    wake: fn()
}

const phi: f32 = 1.618034

fn default_text_style(st: *State) -> TextStyle {
    TextStyle { color: geometry.rgb(0x000000), text: uitext.Style { size: st.rem } }
}

fn drawn(st: *State, ts: TextStyle) -> TextStyle {
    let natural = if ts.text.line_height > 0.0 { ts.text.line_height } else { ts.text.size * phi }
    var out = ts
    out.text.line_height = geometry.round_half_to_zero(natural * st.scale) / st.scale
    out
}

fn measured(st: *State, content: str, style: uitext.Style, width: f32) -> geometry.Size {
    let m = uitext.measure(mut st.text, content, style, width)
    geometry.size(-floor(-m.width), m.height)
}

/// Returns a context with no window whose frames clear to `background`.
pub fn headless(background: geometry.Color) -> Context {
    let state = new(State {
        text: uitext.default_system()
        background
        posts: chan[fn()](1024)
        minimize: fn() {}
        zoom: fn() {}
        wake: fn() {}
        copy: fn(s: str) {}
        paste: fn() -> str? { none }
        clock: fn() -> i64 { 0 }
    })
    state.zoom = fn() {
        state.maximized = !state.maximized
        state.dirty = true
    }
    state.clock = fn() -> i64 { state.manual_ms }
    state.copy = fn(s: str) { state.memory = s }
    state.paste = fn() -> str? { state.memory }
    Context { state }
}

/// Adds the font file in `data` to the context's installed fonts, and returns whether it could: a text whose `font_family` the font holds is drawn with it. A headless context draws with built-in fonts and returns `false`.
pub fn add_font(cx: Context, data: str) -> bool {
    uitext.add_font(mut cx.state.text, data)
}

/// Keeps `rgba`, `width` by `height` pixels of red, green, blue and alpha bytes in rows with each colour already multiplied by its alpha, in the context, and returns the picture for `image`, or `none` when `rgba` is not `width * height * 4` bytes or a size is below one.
pub fn add_image(cx: Context, width: i64, height: i64, rgba: u8[]) -> uitext.Image? {
    uitext.add_image(mut cx.state.text, width, height, rgba)
}

/// Returns the text on the clipboard, the system's when the context has a window, or `none` when it holds no text.
pub fn clipboard(cx: Context) -> str? {
    cx.state.paste()
}

/// Puts `s` on the clipboard, the system's when the context has a window.
pub fn set_clipboard(cx: Context, s: str) {
    cx.state.copy(s)
}

/// Returns the shape the pointer should have: that of the innermost element under it that sets a `cursor`, or the arrow. While a drag started by `on_drag` is active it is the `cursor` of the element that started it, or the arrow when that sets none, whatever is under the pointer, as gpui gives every element the drag's cursor style (`elements/div.rs:2538`).
pub fn pointer_cursor(cx: Context) -> platform.Cursor {
    let st = cx.state
    match st.dragged {
        some(d) => return d.cursor ?? platform.Cursor.Arrow
        none => {}
    }
    var i = topmost(st)
    for i >= 0 {
        let h = st.hitboxes[i]
        match h.element.cursor {
            some(shape) => return shape
            none => {}
        }
        i = ancestor_hit(st, h.parent)
    }
    platform.Cursor.Arrow
}

/// Returns the `WindowControlArea` at `x`, `y` logical pixels from the top left of the window as of the last frame, or `none` for plain content. The window asks it which part of the frame the pointer is over.
///
/// The area is that of the innermost hitbox at the point, else of its nearest ancestor with one, walking outward; an element with a click, key, scroll or change handler, a `field` or a `focusable` element ends the walk with `none` before it reaches an area further out. The hitboxes are clipped, so an area scrolled or clipped out of view is not under any point.
pub fn window_control_area_at(cx: Context, x: f32, y: f32) -> platform.WindowControlArea? {
    let st = cx.state
    let at = geometry.point(x, y)
    var i = st.hitboxes.len - 1
    for i >= 0 && (st.hitboxes[i].hidden || !geometry.contains(st.hitboxes[i].bounds, at)) {
        i -= 1
    }
    for i >= 0 {
        let h = st.hitboxes[i]
        match h.element.control_area {
            some(area) => return area
            none => {}
        }
        if takes_pointer(h.element) {
            return none
        }
        i = h.parent
    }
    none
}

fn takes_pointer(e: Element) -> bool {
    e.listeners.len > 0 || e.focusable || is_field(e)
}

/// Returns `true` while the window is maximised: after a `Maximized(true)` event, or a `toggle_maximize` of a context with no window.
pub fn is_maximized(cx: Context) -> bool {
    cx.state.maximized
}

/// Minimises the window. A context with no window does nothing.
pub fn minimize(cx: Context) {
    cx.state.minimize()
}

/// Maximises the window, or restores it when it is maximised. With a window the state changes when its `Maximized` event arrives; a context with no window flips it at once. Either way a frame is due once it has changed.
pub fn toggle_maximize(cx: Context) {
    cx.state.zoom()
}

/// Returns where the text caret of the focused field is as of the last frame, for an input method to place its candidate window beside, or `none` when no field is focused.
pub fn text_input(cx: Context) -> platform.Caret? {
    cx.state.caret
}

/// Returns `true` while a frame is due: after a signal changed, a closure was posted, the window changed size, or the element under the pointer or the focused element changed.
pub fn frame_due(cx: Context) -> bool {
    cx.state.dirty
}

/// Returns `true` once a `CloseRequested` event has been dispatched or `quit` called.
pub fn closed(cx: Context) -> bool {
    cx.state.closed
}

/// Ends `run` after the events it is dispatching.
pub fn quit(cx: Context) {
    cx.state.closed = true
}

/// Returns the key of the focused element, its id or its position in the tree, or `""` when none is focused.
pub fn focused(cx: Context) -> str {
    cx.state.focus
}

/// Focuses the element with the key `key`, an id or a position such as `"0/1"`, or none when `key` is empty. The element takes focus whether or not it is `focusable`.
pub fn set_focus(cx: Context, key: str) {
    move_focus(cx.state, key)
}

/// Removes focus from the focused element.
pub fn blur(cx: Context) {
    move_focus(cx.state, "")
}

/// Returns how far the scrolling element whose key is `key` is scrolled, in logical pixels from its start.
pub fn scroll_offset(cx: Context, key: str) -> geometry.Point {
    cx.state.scroll[key] ?? geometry.Point {}
}

/// Scrolls the element whose key is `key` to `offset`, which the next frame keeps within the element's content.
pub fn scroll_to(cx: Context, key: str, offset: geometry.Point) {
    cx.state.scroll[key] = offset
    cx.state.dirty = true
}

/// Returns the logical pixels in one rem, 16 until `set_rem_size` changes it.
pub fn rem_size(cx: Context) -> f32 {
    cx.state.rem
}

/// Sets the logical pixels in one rem and asks for a new frame.
pub fn set_rem_size(cx: Context, size: f32) {
    cx.state.rem = size
    cx.state.dirty = true
}

/// Returns `count` rems in logical pixels: `rems(cx, 0.5)` is 6.5 when a rem is 13 pixels. The builders take logical pixels, which layout rounds to device pixels.
pub fn rems(cx: Context, count: f32) -> f32 {
    count * cx.state.rem
}

/// Returns a handle that posts closures to `cx`.
pub fn handle(cx: Context) -> Handle {
    Handle { posts: cx.state.posts, wake: cx.state.wake }
}

/// Queues `f` to run on the context's green thread before its next frame, and wakes the window waiting for events.
pub fn post(h: Handle, f: fn()) {
    h.posts <- f
    h.wake()
}

fn drain(st: *State) {
    for {
        let posted = select {
            v = <-st.posts => v ?? return
            else => return
        }
        posted()
        st.dirty = true
    }
}

/// Builds the tree `render` returns, lays it out in a window of `size` logical pixels and paints it into a scene of `scale` device pixels per logical pixel.
///
/// The hitboxes of the painted elements replace those of the last frame, so `dispatch` finds the elements this frame drew.
pub fn frame(cx: Context, render: fn() -> Element, size: geometry.Size, scale: f32) -> scene.Scene {
    let st = cx.state
    uitext.end_frame(mut st.text)
    drain(st)
    st.dirty = false
    let root = render()
    var t = layout.tree(scale)
    let laid = build(st, mut t, root, default_text_style(st))
    layout.compute(mut t, laid.node, size)
    st.viewport = geometry.rect(0.0, 0.0, size.width, size.height)
    let whole = Walk { parent: -1, clip: st.viewport, shift: geometry.Point {}, text: default_text_style(st), scale }
    st.hitboxes = []
    st.virtuals = [:]
    st.root_hitbox = -1
    st.last_rects = st.rects
    st.rects = [:]
    st.anchor_shifts = []
    st.deferred = []
    prepaint(st, t, laid, "0", whole)
    prepaint_deferred(st)
    prepaint_layers(st, scale)
    prepaint_tooltip(st, scale)
    prepaint_drag(st, scale)
    hit_test(st)
    st.hovered = hovered_keys(st)
    let device_width = i64(floor(size.width * scale + 0.5))
    let device_height = i64(floor(size.height * scale + 0.5))
    var sc = scene.empty(device_width, device_height, st.background)
    sc.text = uitext.params(st.text)
    st.painted = 0
    st.anchors_painted = 0
    st.caret = none
    paint(st, t, mut sc, laid, whole, default_text_style(st), scale)
    paint_deferred(st, mut sc, scale)
    paint_layers(st, mut sc, scale)
    paint_tooltip(st, mut sc, scale)
    paint_drag(st, mut sc, scale)
    hit_test(st)
    sc
}

fn is_text(e: Element) -> bool {
    match e.kind {
        Text => true
        _ => false
    }
}

fn is_icon(e: Element) -> bool {
    match e.kind {
        Icon => true
        _ => false
    }
}

fn is_picture(e: Element) -> bool {
    match e.kind {
        Picture => true
        _ => false
    }
}

fn picture_style(s: layout.Style, p: uitext.Image) -> layout.Style {
    var out = s
    let across = f32(p.width)
    let down = f32(p.height)
    match s.width {
        Auto => {
            out.width = match s.height {
                Px(h) => Px(across * h / down)
                _ => Px(across)
            }
        }
        _ => {}
    }
    match s.height {
        Auto => {
            out.height = match out.width {
                Px(w) => Px(down * w / across)
                _ => Px(down)
            }
        }
        _ => {}
    }
    out
}

fn scrolls(s: layout.Style) -> bool {
    s.overflow_x == Scroll || s.overflow_y == Scroll
}

fn clips(s: layout.Style) -> bool {
    s.overflow_x != Visible || s.overflow_y != Visible
}

fn interactive(e: Element) -> bool {
    e.focusable || e.listeners.len > 0 || e.conditionals.len > 0 || e.group != "" || scrolls(e.style) || e.cursor != none || e.control_area != none || e.key_context != none || e.behavior != Normal || is_virtual(e)
}

fn nearest_group(groups: NamedGroup[], name: str) -> i64 {
    var i = groups.len - 1
    for i >= 0 {
        if groups[i].name == name {
            return groups[i].at
        }
        i -= 1
    }
    -1
}

fn bind_groups(e: Element, groups: NamedGroup[]) -> i64[] {
    var bound: i64[] = []
    for c in e.conditionals {
        let at = match c.when {
            GroupHovered(name) => nearest_group(groups, name)
            GroupActive(name) => nearest_group(groups, name)
            _ => -1
        }
        bound.push(at)
    }
    bound
}

fn larger(a: f32, b: f32) -> f32 {
    if a > b { a } else { b }
}

fn within(v: f32, low: f32, high: f32) -> f32 {
    if v < low { low } else if v > high { high } else { v }
}

fn inherit(ts: TextStyle, v: Visual) -> TextStyle {
    let text = uitext.Style {
        size: v.text_size ?? ts.text.size
        family: v.font_family ?? ts.text.family
        weight: v.font_weight ?? ts.text.weight
        line_height: v.line_height ?? ts.text.line_height
        wrap: v.wrap ?? ts.text.wrap
        truncate: v.truncate ?? ts.text.truncate
        align: v.align ?? ts.text.align
    }
    TextStyle { color: v.text_color ?? ts.color, text, opacity: ts.opacity * v.opacity }
}

fn build(st: *State, mut t: layout.Tree, e: Element, ts: TextStyle) -> Laid {
    let own = inherit(ts, e.visual)
    if is_text(e) {
        let content = e.content
        let style = drawn(st, own).text
        let measure = fn(w: f32) -> geometry.Size { measured(st, content, style, w) }
        return Laid { node: layout.leaf(mut t, e.style, measure), element: e, children: [] }
    }
    if is_field(e) {
        let content = e.content
        let style = drawn(st, own).text
        let measure = fn(w: f32) -> geometry.Size { measured(st, content, style, layout.unbounded) }
        return Laid { node: layout.leaf(mut t, e.style, measure), element: e, children: [] }
    }
    if is_picture(e) {
        let p = e.picture ?? return Laid { node: layout.node(mut t, e.style, []), element: e, children: [] }
        let measure = fn(w: f32) -> geometry.Size { geometry.size(f32(p.width), f32(p.height)) }
        return Laid { node: layout.leaf(mut t, picture_style(e.style, p), measure), element: e, children: [] }
    }
    var kids: Laid[] = []
    var nodes: i64[] = []
    for c in e.children {
        let k = build(st, mut t, c, own)
        nodes.push(k.node)
        kids.push(k)
    }
    Laid { node: layout.node(mut t, e.style, nodes), element: e, children: kids }
}

fn prepaint(st: *State, t: layout.Tree, laid: Laid, key_path: str, w: Walk) {
    if laid.element.deferred {
        let walk = Walk { parent: w.parent, clip: st.viewport, shift: w.shift, text: w.text, scale: w.scale }
        defer_draw(st, DeferredDraw { tree: t, laid, key_path, walk, text: default_text_style(st), priority: laid.element.priority })
        return
    }
    prepaint_element(st, t, laid, key_path, w)
}

fn prepaint_element(st: *State, t: layout.Tree, laid: Laid, key_path: str, w: Walk) {
    let e = laid.element
    if e.style.display == None {
        return
    }
    let key = if e.id != "" { e.id } else { key_path }
    let rect = geometry.offset(layout.rect(t, laid.node), w.shift.x, w.shift.y)
    if e.id != "" || interactive(e) {
        st.rects[key] = rect
    }
    if is_virtual(e) {
        prepaint_virtual(st, t, laid, key, rect, w)
        return
    }
    var inner = w
    inner.text = inherit(w.text, e.visual)
    if interactive(e) {
        let range = scroll_range(t, laid)
        let scrolled = settled_offset(st, key, e.style, range)
        let bound = bind_groups(e, w.groups)
        st.hitboxes.push(Hitbox { bounds: geometry.intersect(rect, w.clip), key, parent: w.parent, element: e, offset: scrolled, scroll_max: range, rect, bound })
        inner.parent = st.hitboxes.len - 1
        if w.parent < 0 && key_path == "0" {
            st.root_hitbox = inner.parent
        }
        inner.shift = geometry.point(w.shift.x - scrolled.x, w.shift.y - scrolled.y)
        if e.group != "" {
            inner.groups = w.groups[0..]
            inner.groups.push(NamedGroup { name: e.group, at: inner.parent })
        }
    }
    if is_text(e) || is_field(e) {
        return
    }
    if clips(e.style) {
        inner.clip = geometry.intersect(w.clip, clip_bounds(geometry.inset(rect, e.style.border), e.style))
    }
    if is_anchored(e) {
        let moved = anchored_shift(st, t, laid, anchoring_of(e), inner)
        st.anchor_shifts.push(moved)
        inner.shift = geometry.point(inner.shift.x + moved.x, inner.shift.y + moved.y)
    }
    for i, c in laid.children {
        prepaint(st, t, c, "{key}/{i}", inner)
    }
}

fn scroll_range(t: layout.Tree, laid: Laid) -> geometry.Point {
    let s = laid.element.style
    if !scrolls(s) {
        return geometry.Point {}
    }
    let r = layout.rect(t, laid.node)
    var right = r.x
    var bottom = r.y
    for k in laid.children {
        let c = layout.rect(t, k.node)
        if c.width > 0.0 || c.height > 0.0 {
            right = larger(right, c.x + c.width)
            bottom = larger(bottom, c.y + c.height)
        }
    }
    let inner_right = r.x + r.width - s.border.right - s.padding.right
    let inner_bottom = r.y + r.height - s.border.bottom - s.padding.bottom
    let x = if s.overflow_x == Scroll { larger(right - inner_right, 0.0) } else { 0.0 }
    let y = if s.overflow_y == Scroll { larger(bottom - inner_bottom, 0.0) } else { 0.0 }
    geometry.point(x, y)
}

fn settled_offset(st: *State, key: str, s: layout.Style, max: geometry.Point) -> geometry.Point {
    if !scrolls(s) {
        return geometry.Point {}
    }
    let wanted = st.scroll[key] ?? geometry.Point {}
    let settled = geometry.point(within(wanted.x, 0.0, max.x), within(wanted.y, 0.0, max.y))
    if settled.x != wanted.x || settled.y != wanted.y {
        st.scroll[key] = settled
        st.dirty = true
    }
    settled
}

fn clip_bounds(padding_box: geometry.Rect, s: layout.Style) -> geometry.Rect {
    let far: f32 = 1.0e9
    var out = padding_box
    if s.overflow_x == Visible {
        out.x = -far
        out.width = 2.0 * far
    }
    if s.overflow_y == Visible {
        out.y = -far
        out.height = 2.0 * far
    }
    out
}

fn paint(st: *State, t: layout.Tree, mut sc: scene.Scene, laid: Laid, w: Walk, ts: TextStyle, scale: f32) {
    if laid.element.deferred {
        defer_draw(st, DeferredDraw { tree: t, laid, key_path: "", walk: w, text: ts, priority: laid.element.priority })
        return
    }
    paint_element(st, t, mut sc, laid, w, ts, scale)
}

fn paint_element(st: *State, t: layout.Tree, mut sc: scene.Scene, laid: Laid, w: Walk, ts: TextStyle, scale: f32) {
    let e = laid.element
    if e.style.display == None {
        return
    }
    var visual = e.visual
    var inner = w
    var at = -1
    if interactive(e) {
        at = st.painted
        st.painted += 1
        visual = styled(st, at, e)
        let offset = st.hitboxes[at].offset
        inner.shift = geometry.point(w.shift.x - offset.x, w.shift.y - offset.y)
    }
    inner.hidden = w.hidden || !visual.visible
    if at >= 0 {
        st.hitboxes[at].hidden = inner.hidden
    }
    if inner.hidden && !st.concealing {
        var discarded = scene.empty(0, 0, geometry.Color {})
        st.concealing = true
        paint_drawn(st, t, mut discarded, laid, w, inner, visual, at, ts, scale)
        st.concealing = false
        return
    }
    paint_drawn(st, t, mut sc, laid, w, inner, visual, at, ts, scale)
}

fn paint_drawn(st: *State, t: layout.Tree, mut sc: scene.Scene, laid: Laid, w: Walk, below: Walk, visual: Visual, at: i64, ts: TextStyle, scale: f32) {
    let e = laid.element
    var inner = below
    let own = inherit(ts, visual)
    let r = geometry.offset(layout.rect(t, laid.node), w.shift.x, w.shift.y)
    paint_background(mut sc, r, visual, own.opacity, scale)
    if is_text(e) {
        let content = geometry.offset(layout.content(t, laid.node), w.shift.x, w.shift.y)
        let lines = uitext.wrap(mut st.text, e.content, drawn(st, own).text, content.width)
        uitext.paint(mut st.text, mut sc, lines, geometry.point(content.x, content.y), faded(own.color, own.opacity), scale)
    } else if is_field(e) {
        let content = geometry.offset(layout.content(t, laid.node), w.shift.x, w.shift.y)
        paint_field(st, mut sc, e, at, content, drawn(st, own), scale)
    } else if is_icon(e) {
        uitext.paint_icon(mut st.text, mut sc, e.content, r, faded(own.color, own.opacity), scale)
    } else if is_picture(e) {
        match e.picture {
            some(p) => uitext.paint_image(mut st.text, mut sc, p, e.fit, r, visual.corners, e.gray, own.opacity, scale)
            none => {}
        }
    } else {
        let clipping = clips(e.style)
        if clipping {
            let bounds = clip_bounds(geometry.inset(r, e.style.border), e.style)
            scene.push_clip(mut sc, geometry.cover(bounds, scale))
        }
        if is_anchored(e) {
            let moved = st.anchor_shifts[st.anchors_painted]
            st.anchors_painted += 1
            inner.shift = geometry.point(inner.shift.x + moved.x, inner.shift.y + moved.y)
        }
        if is_virtual(e) {
            let content = geometry.offset(layout.content(t, laid.node), w.shift.x, w.shift.y)
            paint_rows(st, mut sc, at, content, own, scale)
        } else {
            for c in laid.children {
                paint(st, t, mut sc, c, inner, own, scale)
            }
        }
        if clipping {
            scene.pop_clip(mut sc)
        }
    }
    paint_border(mut sc, r, e.style.border, visual, own.opacity, scale)
}

fn styled(st: *State, at: i64, e: Element) -> Visual {
    var out = e.visual
    let bound = st.hitboxes[at].bound
    for i, c in e.conditionals {
        if holds(st, at, c.when, bound[i]) {
            out = c.change(out)
        }
    }
    out
}

fn pressed_on(st: *State, at: i64) -> bool {
    st.held == platform.Button.Left && (st.pressed[st.hitboxes[at].key] ?? false)
}

fn holds(st: *State, at: i64, c: Condition, group_at: i64) -> bool {
    match c {
        Hovered => st.hits[at] && !is_dragging(st)
        DragHovered(kind) => drag_hovers(st, at, kind)
        Active => pressed_on(st, at)
        Focused => st.focus != "" && st.hitboxes[at].key == st.focus
        GroupHovered(_) => group_at >= 0 && st.hits[group_at] && !is_dragging(st)
        GroupActive(_) => group_at >= 0 && pressed_on(st, group_at)
    }
}

fn paint_background(mut sc: scene.Scene, r: geometry.Rect, v: Visual, opacity: f32, scale: f32) {
    let corners = geometry.scale_corners(geometry.clamp_corners(v.corners, r.width, r.height), scale)
    for s in v.shadows {
        let grown = geometry.outset(geometry.offset(r, s.x, s.y), geometry.edges(s.spread))
        let shadow = scene.Shadow {
            bounds: geometry.cover(grown, scale)
            color: faded(s.color, opacity)
            corner_radii: corners
            sigma: s.blur * scale
        }
        scene.push_shadow(mut sc, shadow)
    }
    if v.background.a <= 0.0 {
        return
    }
    let quad = scene.Quad {
        bounds: geometry.snap(r, scale)
        background: faded(v.background, opacity)
        border_color: geometry.Color { r: v.background.r, g: v.background.g, b: v.background.b, a: 0.0 }
        corner_radii: corners
    }
    scene.push_quad(mut sc, quad)
}

fn paint_border(mut sc: scene.Scene, r: geometry.Rect, border: geometry.Edges, v: Visual, opacity: f32, scale: f32) {
    let bordered = border.top > 0.0 || border.right > 0.0 || border.bottom > 0.0 || border.left > 0.0
    if !bordered || v.border_color.a <= 0.0 {
        return
    }
    let quad = scene.Quad {
        bounds: geometry.snap(r, scale)
        background: geometry.Color { r: v.border_color.r, g: v.border_color.g, b: v.border_color.b, a: 0.0 }
        border_color: faded(v.border_color, opacity)
        corner_radii: geometry.scale_corners(geometry.clamp_corners(v.corners, r.width, r.height), scale)
        border_widths: geometry.snap_edges(border, scale)
    }
    scene.push_quad(mut sc, quad)
}

fn hit_test(st: *State) {
    var inside: bool[] = []
    var hits: bool[] = []
    var wheel: bool[] = []
    for h in st.hitboxes {
        inside.push(!h.hidden && st.pointer_inside && geometry.contains(h.bounds, st.pointer))
        hits.push(false)
        wheel.push(false)
    }
    var hover_blocked = false
    var i = st.hitboxes.len - 1
    for i >= 0 {
        if inside[i] {
            wheel[i] = true
            hits[i] = !hover_blocked
            let b = st.hitboxes[i].element.behavior
            if b == BlockMouseExceptScroll {
                hover_blocked = true
            }
            if b == BlockMouse {
                i = 0
            }
        }
        i -= 1
    }
    st.inside = inside
    st.hits = hits
    st.wheel = wheel
}

fn ancestor_hit(st: *State, at: i64) -> i64 {
    var i = at
    for i >= 0 && !st.hits[i] {
        i = st.hitboxes[i].parent
    }
    i
}

fn hovered_keys(st: *State) -> str {
    var keys = ""
    for i, h in st.hitboxes {
        if st.hits[i] {
            keys += "{h.key}\n"
        }
    }
    keys
}

fn find(st: *State, key: str) -> i64 {
    for i, h in st.hitboxes {
        if h.key == key {
            return i
        }
    }
    -1
}

fn topmost(st: *State) -> i64 {
    var i = st.hitboxes.len - 1
    for i >= 0 && !st.hits[i] {
        i -= 1
    }
    i
}

fn refresh_hover(st: *State) {
    hit_test(st)
    let keys = hovered_keys(st)
    if keys != st.hovered {
        st.hovered = keys
        st.dirty = true
    }
}

fn move_focus(st: *State, key: str) {
    if key != st.focus {
        st.focus = key
        st.dirty = true
        drop_pending_keys(st)
    }
}

/// Applies `event` to `cx`: records the size and scale, moves the pointer, runs the handlers of the elements of the last frame and moves focus.
///
/// The elements are those of the last `frame`, so a pointer position is tested against what was drawn.
pub fn dispatch(cx: Context, event: platform.Event) {
    let st = cx.state
    match event {
        Resized(width, height, scale) => {
            st.width = width
            st.height = height
            st.scale = scale
            st.dirty = true
        }
        CloseRequested => {
            st.closed = true
        }
        PointerMoved(x, y) => pointer_moved(st, x, y)
        PointerLeft => pointer_left(st)
        PointerDown(b) => {
            st.modifiers = b.modifiers
            move_pointer(st, b.x, b.y)
            mouse_down(st, b)
        }
        PointerUp(b) => {
            st.modifiers = b.modifiers
            move_pointer(st, b.x, b.y)
            mouse_up(st, b)
        }
        Scrolled(dx, dy) => scroll_wheel(st, dx, dy)
        Key(k) => {
            st.modifiers = k.modifiers
            key(st, k)
        }
        Preedit(s, range) => field_preedit(st, s, range)
        Commit(s) => field_commit(st, s)
        Maximized(maximized) => {
            if maximized != st.maximized {
                st.maximized = maximized
                st.dirty = true
            }
        }
        FocusChanged(focused) => {
            st.window_focused = focused
        }
        Woken => drain(st)
        FileDragEntered(x, y, paths) => file_drag_entered(st, x, y, paths)
        FileDragMoved(x, y) => file_drag_moved(st, x, y)
        FileDropped(x, y) => file_dropped(st, x, y)
        FileDragExited => file_drag_exited(st)
        _ => {}
    }
}

fn pointer_left(st: *State) {
    st.pointer_inside = false
    refresh_hover(st)
    tooltip_check(st)
}

fn move_pointer(st: *State, x: f32, y: f32) {
    st.pointer = geometry.point(x, y)
    st.pointer_inside = true
    refresh_hover(st)
    field_drag(st)
}

fn pointer_moved(st: *State, x: f32, y: f32) {
    let moved = !st.pointer_inside || x != st.pointer.x || y != st.pointer.y
    move_pointer(st, x, y)
    if moved {
        mouse_move(st, MouseMoveEvent { position: st.pointer, pressed_button: pressed_button(st), modifiers: st.modifiers })
        tooltip_moved(st)
    }
}

fn mouse_down(st: *State, b: platform.ButtonEvent) {
    tooltip_pressed(st)
    close_outside(st)
    hold_button(st, b.button)
    let event = MouseDownEvent { button: b.button, position: st.pointer, modifiers: b.modifiers, click_count: b.clicks }
    if b.button == platform.Button.Left {
        st.held = b.button
        st.press_point = st.pointer
        st.pressed = [:]
        for i, h in st.hitboxes {
            if st.hits[i] {
                st.pressed[h.key] = true
            }
        }
        st.dirty = true
        focus_under_pointer(st)
        field_press(st, b.clicks)
    }
    run_mouse_down(st, event)
    if b.button == platform.Button.Right {
        open_context_menu(st)
    }
}

fn focus_under_pointer(st: *State) {
    let root = trap(st)
    var i = topmost(st)
    for i >= 0 {
        if st.hitboxes[i].element.focusable {
            if within_trap(st, i, root) {
                move_focus(st, st.hitboxes[i].key)
            }
            return
        }
        i = ancestor_hit(st, st.hitboxes[i].parent)
    }
    if root < 0 {
        move_focus(st, "")
    }
}

fn mouse_up(st: *State, b: platform.ButtonEvent) {
    drop_button(st, b.button)
    let event = MouseUpEvent { button: b.button, position: st.pointer, modifiers: b.modifiers, click_count: b.clicks }
    run_mouse_up(st, event)
    end_drag(st)
    if b.button != platform.Button.Left || st.held == none {
        return
    }
    st.held = none
    st.drag = ""
    let pressed = st.pressed
    st.pressed = [:]
    st.dirty = true
    let click = ClickEvent { position: st.pointer, modifiers: b.modifiers, click_count: b.clicks }
    var i = topmost(st)
    for i >= 0 {
        let h = st.hitboxes[i]
        if pressed[h.key] ?? false {
            if run_click(st, i, click) {
                return
            }
        }
        i = ancestor_hit(st, h.parent)
    }
}

fn run_click(st: *State, at: i64, click: ClickEvent) -> bool {
    for l in st.hitboxes[at].element.listeners {
        match l {
            Click(f) => {
                f(click)
                return true
            }
            _ => {
                if run_trigger(st, at, l) {
                    return true
                }
            }
        }
    }
    false
}

fn scroll_wheel(st: *State, dx: f32, dy: f32) {
    tooltip_pressed(st)
    let event = ScrollEvent { position: st.pointer, dx, dy }
    var i = st.hitboxes.len - 1
    for i >= 0 {
        if st.wheel[i] {
            let h = st.hitboxes[i]
            run_scrolls(h.element, event)
            if scroll_by(st, i, dx, dy) {
                return
            }
        }
        i -= 1
    }
}

fn run_scrolls(e: Element, event: ScrollEvent) {
    for l in e.listeners {
        match l {
            Scroll(f) => f(event)
            _ => {}
        }
    }
}

fn scroll_by(st: *State, at: i64, dx: f32, dy: f32) -> bool {
    let h = st.hitboxes[at]
    if !scrolls(h.element.style) {
        return false
    }
    match variable_list(h.element) {
        some(state) => return wheel_list(state, dy)
        none => {}
    }
    let x = within(h.offset.x + dx, 0.0, h.scroll_max.x)
    let y = within(h.offset.y + dy, 0.0, h.scroll_max.y)
    if x == h.offset.x && y == h.offset.y {
        return false
    }
    let moved = geometry.point(x, y)
    st.hitboxes[at].offset = moved
    st.scroll[h.key] = moved
    st.dirty = true
    true
}

fn key(st: *State, k: platform.KeyEvent) {
    if k.pressed && layer_key(st, k) {
        return
    }
    if k.pressed {
        press_key(st, k)
    } else {
        deliver_key(st, k)
    }
}

fn deliver_key(st: *State, k: platform.KeyEvent) {
    var at = find(st, st.focus)
    var innermost = true
    var handled = false
    for at >= 0 && !handled {
        if !st.hitboxes[at].hidden {
            handled = run_keys(st.hitboxes[at].element, k)
            if !handled && innermost {
                handled = field_key(st, at, k)
            }
        }
        innermost = false
        at = st.hitboxes[at].parent
    }
    if handled || !k.pressed {
        return
    }
    if is_named(k.key, platform.NamedKey.Tab) {
        cycle_focus(st, !k.modifiers.shift)
    } else if activates(k.key) {
        let focused = find(st, st.focus)
        if focused >= 0 && !st.hitboxes[focused].hidden {
            let bounds = st.hitboxes[focused].bounds
            let click = ClickEvent { position: geometry.point(bounds.x, bounds.y + bounds.height), keyboard: true }
            run_click(st, focused, click)
        }
    }
}

fn run_keys(e: Element, k: platform.KeyEvent) -> bool {
    for l in e.listeners {
        match l {
            Key(f) => {
                if f(k) {
                    return true
                }
            }
            _ => {}
        }
    }
    false
}

fn is_named(k: platform.Key, n: platform.NamedKey) -> bool {
    match k {
        Named(named) => named == n
        Character(_) => false
    }
}

fn activates(k: platform.Key) -> bool {
    match k {
        Named(named) => named == platform.NamedKey.Enter
        Character(text) => text == " "
    }
}

fn cycle_focus(st: *State, forward: bool) {
    let root = trap(st)
    var order: i64[] = []
    for i, h in st.hitboxes {
        if h.element.focusable && !h.hidden && within_trap(st, i, root) {
            order.push(i)
        }
    }
    if order.len == 0 {
        return
    }
    let current = find(st, st.focus)
    var position = -1
    for n, i in order {
        if i == current {
            position = n
        }
    }
    var next = 0
    if position < 0 {
        next = if forward { 0 } else { order.len - 1 }
    } else {
        next = if forward { (position + 1) % order.len } else { (position + order.len - 1) % order.len }
    }
    move_focus(st, st.hitboxes[order[next]].key)
}
