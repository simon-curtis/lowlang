import std/testing

fn test_a_tie_rounds_toward_zero(t: *testing.T) {
    testing.equal(t, round_half_to_zero(0.5), 0.0)
    testing.equal(t, round_half_to_zero(1.5), 1.0)
    testing.equal(t, round_half_to_zero(2.5), 2.0)
    testing.equal(t, round_half_to_zero(-0.5), 0.0)
    testing.equal(t, round_half_to_zero(-1.5), -1.0)
    testing.equal(t, round_half_to_zero(-2.5), -2.0)
}

fn test_rounding_elsewhere_goes_to_the_nearest_integer(t: *testing.T) {
    testing.equal(t, round_half_to_zero(1.5001), 2.0)
    testing.equal(t, round_half_to_zero(1.4999), 1.0)
    testing.equal(t, round_half_to_zero(-1.5001), -2.0)
    testing.equal(t, round_half_to_zero(-1.4999), -1.0)
    testing.equal(t, round_half_to_zero(3.0), 3.0)
    testing.equal(t, round_half_to_zero(-3.0), -3.0)
}

fn test_snap_rounds_each_edge_rather_than_the_size(t: *testing.T) {
    let r = snap(rect(20.5, 100.5, 100.0, 60.0), 1.0)
    testing.equal(t, r.x, 20.0)
    testing.equal(t, r.y, 100.0)
    testing.equal(t, r.width, 100.0)
    testing.equal(t, r.height, 60.0)
    let s = snap(rect(10.4, 10.4, 10.2, 10.2), 1.0)
    testing.equal(t, s.x, 10.0)
    testing.equal(t, s.width, 11.0)
}

fn test_snap_scales_before_it_rounds(t: *testing.T) {
    let r = snap(rect(1.0, 1.0, 1.0, 1.0), 1.5)
    testing.equal(t, r.x, 1.0)
    testing.equal(t, r.width, 2.0)
    let wide = snap(rect(0.3, 0.0, 0.1, 10.0), 2.0)
    testing.equal(t, wide.x, 1.0)
    testing.equal(t, wide.width, 0.0)
}

fn test_cover_floors_the_near_edges_and_ceils_the_far_ones(t: *testing.T) {
    let r = cover(rect(10.2, 20.7, 5.0, 5.0), 1.0)
    testing.equal(t, r.x, 10.0)
    testing.equal(t, r.y, 20.0)
    testing.equal(t, r.width, 6.0)
    testing.equal(t, r.height, 6.0)
    let whole = cover(rect(4.0, 4.0, 8.0, 8.0), 1.0)
    testing.equal(t, whole.width, 8.0)
}

fn test_a_stroke_is_at_least_one_device_pixel_unless_it_is_zero(t: *testing.T) {
    testing.equal(t, snap_stroke(0.0, 1.0), 0.0)
    testing.equal(t, snap_stroke(0.3, 1.0), 1.0)
    testing.equal(t, snap_stroke(1.4, 1.0), 1.0)
    testing.equal(t, snap_stroke(1.6, 1.0), 2.0)
    testing.equal(t, snap_stroke(0.3, 2.0), 1.0)
    testing.equal(t, snap_stroke(1.0, 1.5), 1.0)
}

fn test_clamp_corners_limits_each_radius_to_half_the_smaller_side(t: *testing.T) {
    let c = clamp_corners(Corners { top_left: 3.0, top_right: 50.0, bottom_right: 10.0, bottom_left: 0.0 }, 40.0, 20.0)
    testing.equal(t, c.top_left, 3.0)
    testing.equal(t, c.top_right, 10.0)
    testing.equal(t, c.bottom_right, 10.0)
    testing.equal(t, c.bottom_left, 0.0)
}

fn test_snap_edges_snaps_each_width(t: *testing.T) {
    let e = snap_edges(Edges { top: 1.0, right: 0.0, bottom: 2.4, left: 0.2 }, 1.0)
    testing.equal(t, e.top, 1.0)
    testing.equal(t, e.right, 0.0)
    testing.equal(t, e.bottom, 2.0)
    testing.equal(t, e.left, 1.0)
}

fn test_rgba_reads_alpha_from_the_low_byte(t: *testing.T) {
    let c = rgba(0x00000080)
    testing.equal(t, c.r, 0.0)
    testing.equal(t, c.a, f32(128) / 255.0)
    testing.equal(t, rgb(0x000000).a, 1.0)
}

fn test_offset_moves_the_origin_and_keeps_the_size(t: *testing.T) {
    let r = offset(rect(20.0, 20.0, 40.0, 40.0), 1.0, -1.0)
    testing.equal(t, r.x, 21.0)
    testing.equal(t, r.y, 19.0)
    testing.equal(t, r.width, 40.0)
    testing.equal(t, r.height, 40.0)
}

fn test_inset_never_goes_below_empty(t: *testing.T) {
    let r = inset(rect(10.0, 10.0, 20.0, 20.0), edges(15.0))
    testing.equal(t, r.x, 25.0)
    testing.equal(t, r.y, 25.0)
    testing.equal(t, r.width, 0.0)
    testing.equal(t, r.height, 0.0)
}
