/// A position in pixels from the top left, `x` to the right and `y` down.
pub extern struct Point {
    /// The distance to the right.
    pub x: f32 = 0.0
    /// The distance down.
    pub y: f32 = 0.0
}

/// A width and a height in pixels.
pub extern struct Size {
    /// The horizontal extent.
    pub width: f32 = 0.0
    /// The vertical extent.
    pub height: f32 = 0.0
}

/// An axis-aligned rectangle: its top-left corner and its size.
///
/// Its fields are laid out as four `f32`s, the order the shaders read a rectangle in.
pub extern struct Rect {
    /// The left edge.
    pub x: f32 = 0.0
    /// The top edge.
    pub y: f32 = 0.0
    /// The width, never negative in a rectangle this module returns.
    pub width: f32 = 0.0
    /// The height, never negative in a rectangle this module returns.
    pub height: f32 = 0.0
}

/// One length per side, in the order top, right, bottom, left.
pub extern struct Edges {
    /// The top side.
    pub top: f32 = 0.0
    /// The right side.
    pub right: f32 = 0.0
    /// The bottom side.
    pub bottom: f32 = 0.0
    /// The left side.
    pub left: f32 = 0.0
}

/// One radius per corner, clockwise from the top left.
pub extern struct Corners {
    /// The top-left corner.
    pub top_left: f32 = 0.0
    /// The top-right corner.
    pub top_right: f32 = 0.0
    /// The bottom-right corner.
    pub bottom_right: f32 = 0.0
    /// The bottom-left corner.
    pub bottom_left: f32 = 0.0
}

/// An sRGB-encoded colour with straight alpha, each channel from `0.0` to `1.0`.
pub extern struct Color {
    /// The red channel.
    pub r: f32 = 0.0
    /// The green channel.
    pub g: f32 = 0.0
    /// The blue channel.
    pub b: f32 = 0.0
    /// The alpha channel, `0.0` transparent and `1.0` opaque.
    pub a: f32 = 0.0
}

/// Returns the point at `x`, `y`.
pub fn point(x: f32, y: f32) -> Point {
    Point { x, y }
}

/// Returns the size `width` by `height`.
pub fn size(width: f32, height: f32) -> Size {
    Size { width, height }
}

/// Returns the rectangle at `x`, `y` of `width` by `height`.
pub fn rect(x: f32, y: f32, width: f32, height: f32) -> Rect {
    Rect { x, y, width, height }
}

/// Returns edges that are all `v`.
pub fn edges(v: f32) -> Edges {
    Edges { top: v, right: v, bottom: v, left: v }
}

/// Returns corners that are all `r`.
pub fn corners(r: f32) -> Corners {
    Corners { top_left: r, top_right: r, bottom_right: r, bottom_left: r }
}

/// Returns the opaque colour written as `0xRRGGBB`.
pub fn rgb(hex: u32) -> Color {
    rgba((hex << 8) | 0xff)
}

/// Returns the colour written as `0xRRGGBBAA`.
pub fn rgba(hex: u32) -> Color {
    Color {
        r: channel(hex >> 24)
        g: channel(hex >> 16)
        b: channel(hex >> 8)
        a: channel(hex)
    }
}

fn channel(bits: u32) -> f32 {
    f32(bits & 0xff) / 255.0
}

/// Returns `c` with its alpha replaced by `a`.
pub fn with_alpha(c: Color, a: f32) -> Color {
    Color { r: c.r, g: c.g, b: c.b, a }
}

/// Returns the x coordinate of the right edge of `r`.
pub fn right(r: Rect) -> f32 {
    r.x + r.width
}

/// Returns the y coordinate of the bottom edge of `r`.
pub fn bottom(r: Rect) -> f32 {
    r.y + r.height
}

/// Returns the size of `r`.
pub fn extent(r: Rect) -> Size {
    Size { width: r.width, height: r.height }
}

/// Returns `true` when `r` covers no area.
pub fn is_empty(r: Rect) -> bool {
    r.width <= 0.0 || r.height <= 0.0
}

/// Returns `true` when `p` lies in `r`, counting the top and left edges but not the bottom and right ones.
pub fn contains(r: Rect, p: Point) -> bool {
    p.x >= r.x && p.y >= r.y && p.x < right(r) && p.y < bottom(r)
}

/// Returns the overlap of `a` and `b`, a rectangle of zero width or height when they do not overlap.
pub fn intersect(a: Rect, b: Rect) -> Rect {
    let x = larger(a.x, b.x)
    let y = larger(a.y, b.y)
    let r = smaller(right(a), right(b))
    let d = smaller(bottom(a), bottom(b))
    Rect { x, y, width: larger(r - x, 0.0), height: larger(d - y, 0.0) }
}

/// Returns the smallest rectangle that holds both `a` and `b`.
pub fn union(a: Rect, b: Rect) -> Rect {
    let x = smaller(a.x, b.x)
    let y = smaller(a.y, b.y)
    Rect { x, y, width: larger(right(a), right(b)) - x, height: larger(bottom(a), bottom(b)) - y }
}

/// Returns `r` moved right by `dx` and down by `dy`.
pub fn offset(r: Rect, dx: f32, dy: f32) -> Rect {
    Rect { x: r.x + dx, y: r.y + dy, width: r.width, height: r.height }
}

/// Returns `r` with each side moved inward by its edge in `e`, never smaller than empty.
pub fn inset(r: Rect, e: Edges) -> Rect {
    Rect {
        x: r.x + e.left
        y: r.y + e.top
        width: larger(r.width - e.left - e.right, 0.0)
        height: larger(r.height - e.top - e.bottom, 0.0)
    }
}

/// Returns `r` with each side moved outward by its edge in `e`.
pub fn outset(r: Rect, e: Edges) -> Rect {
    Rect { x: r.x - e.left, y: r.y - e.top, width: r.width + e.left + e.right, height: r.height + e.top + e.bottom }
}

/// Returns `r` with every coordinate multiplied by `factor`, as when logical pixels become device pixels.
pub fn scale(r: Rect, factor: f32) -> Rect {
    Rect { x: r.x * factor, y: r.y * factor, width: r.width * factor, height: r.height * factor }
}

/// Returns `c` with every radius multiplied by `factor`.
pub fn scale_corners(c: Corners, factor: f32) -> Corners {
    Corners { top_left: c.top_left * factor, top_right: c.top_right * factor, bottom_right: c.bottom_right * factor, bottom_left: c.bottom_left * factor }
}

/// Returns `e` with every edge multiplied by `factor`.
pub fn scale_edges(e: Edges, factor: f32) -> Edges {
    Edges { top: e.top * factor, right: e.right * factor, bottom: e.bottom * factor, left: e.left * factor }
}

/// Returns the sum of the left and right edges of `e`.
pub fn horizontal(e: Edges) -> f32 {
    e.left + e.right
}

/// Returns the sum of the top and bottom edges of `e`.
pub fn vertical(e: Edges) -> f32 {
    e.top + e.bottom
}

fn larger(a: f32, b: f32) -> f32 {
    if a > b { a } else { b }
}

fn smaller(a: f32, b: f32) -> f32 {
    if a < b { a } else { b }
}
