import std/testing
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn drag_preview(value: str) -> Element {
    div().size(60.0, 40.0).background(rgb(0xff0000))
}

fn drag_source() -> Element {
    div().id("src").size(40.0, 30.0).background(rgb(0x0000ff)).on_drag("tile", "7", drag_preview)
}

fn drag_started(cx: Context, view: fn() -> Element) {
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
}

fn drag_field() -> Element {
    div().size(200.0, 100.0).padding_xy(20.0, 10.0).child(drag_source())
}

fn file_enter(cx: Context, x: f32, y: f32, paths: str[]) {
    dispatch(cx, platform.Event.FileDragEntered(x, y, paths))
}

fn file_move(cx: Context, x: f32, y: f32) {
    dispatch(cx, platform.Event.FileDragMoved(x, y))
}

fn file_drop(cx: Context, x: f32, y: f32) {
    dispatch(cx, platform.Event.FileDropped(x, y))
}

fn test_a_drag_starts_when_the_pointer_moves_more_than_two_pixels_from_the_press(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { drag_field() }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 32.0, 20.0)
    move_to(cx, 30.0, 22.0)
    if dragging(cx) {
        t.error("a move of two pixels started a drag")
    }
    move_to(cx, 32.5, 20.0)
    if !dragging(cx) {
        t.error("a move of two and a half pixels did not start a drag")
    }
    let p = drag_payload(cx) ?? DragPayload { kind: "" }
    if p.kind != "tile" || p.value != "7" || p.paths.len != 0 {
        t.error("the drag carries {p.kind} {p.value}")
    }
}

fn test_only_a_press_of_the_primary_button_on_the_element_starts_a_drag(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { drag_field() }
    shot(cx, view)
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Right, x: 30.0, y: 20.0 }))
    move_to(cx, 60.0, 20.0)
    if dragging(cx) {
        t.error("a secondary press started a drag")
    }
    dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Right, x: 60.0, y: 20.0 }))
    press(cx, 150.0, 80.0)
    move_to(cx, 190.0, 80.0)
    if dragging(cx) {
        t.error("a press beside the element started a drag")
    }
    release(cx, 190.0, 80.0)
    move_to(cx, 30.0, 20.0)
    move_to(cx, 60.0, 20.0)
    if dragging(cx) {
        t.error("a move without a press started a drag")
    }
}

fn test_the_preview_is_drawn_at_the_pointer_minus_the_offset_of_the_drag_start(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { drag_field() }
    drag_started(cx, view)
    move_to(cx, 100.0, 60.0)
    let sc = shot(cx, view)
    let at = quad_of(sc, 0xff0000)
    if at < 0 {
        t.error("no preview quad")
        return
    }
    same_rect(t, sc.quads[at].bounds, geometry.rect(86.0, 50.0, 60.0, 40.0))
    move_to(cx, 150.0, 70.0)
    let again = shot(cx, view)
    let next = quad_of(again, 0xff0000)
    if next < 0 {
        t.error("no preview quad after another move")
        return
    }
    same_rect(t, again.quads[next].bounds, geometry.rect(136.0, 60.0, 60.0, 40.0))
}

fn test_the_preview_is_drawn_after_the_frame_and_its_deferred_elements(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        drag_field().child(deferred(div().size(30.0, 30.0).background(rgb(0x00ff00))))
    }
    drag_started(cx, view)
    let sc = shot(cx, view)
    let preview = quad_of(sc, 0xff0000)
    let deferred_at = quad_of(sc, 0x00ff00)
    let source = quad_of(sc, 0x0000ff)
    if preview < 0 || deferred_at < 0 || source < 0 {
        t.error("a quad is missing: preview {preview} deferred {deferred_at} source {source}")
        return
    }
    if preview < deferred_at || deferred_at < source {
        t.error("drawing order: source {source} deferred {deferred_at} preview {preview}")
    }
}

fn test_the_preview_takes_no_pointer_events_and_covers_nothing_from_a_drop(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let loud = fn(value: str) -> Element {
        div().size(60.0, 40.0).background(rgb(0xff0000)).occlude()
            .on_mouse_move(fn(e: MouseMoveEvent) { note(log, "preview move") })
            .on_mouse_down(platform.Button.Right, fn(e: MouseDownEvent) { note(log, "preview down") })
    }
    let target = fn(e: DropEvent) { note(log, "drop {e.drag.value}") }
    let view = fn() -> Element {
        let source = div().id("src").size(40.0, 30.0).background(rgb(0x0000ff)).on_drag("tile", "7", loud)
        let zone = div().id("zone").size(100.0, 40.0).on_drop("tile", target)
        div().size(200.0, 100.0).padding_xy(20.0, 10.0).column().child(source).child(zone)
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 60.0, 60.0)
    shot(cx, view)
    move_to(cx, 61.0, 61.0)
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Right, x: 61.0, y: 61.0 }))
    release(cx, 61.0, 61.0)
    let seen = joined(get(log))
    if seen != "drop 7\n" {
        t.error("events: {seen}")
    }
}

fn test_a_drag_does_not_click_the_element_it_started_on_or_those_around_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        let source = drag_source().on_click(fn(e: ClickEvent) { note(log, "source click") })
        div().size(200.0, 100.0).padding_xy(20.0, 10.0).on_click(fn(e: ClickEvent) { note(log, "outer click") }).child(source)
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    release(cx, 34.0, 20.0)
    if get(log).len != 0 {
        t.error("clicks after a drag: {joined(get(log))}")
    }
    shot(cx, view)
    click(cx, 30.0, 20.0)
    let seen = joined(get(log))
    if seen != "source click\n" {
        t.error("a plain click ran {seen}")
    }
}

fn test_the_active_style_ends_when_a_drag_starts_and_hover_styles_wait_for_it_to_end(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        let source = drag_source().active(fn(v: Visual) -> Visual { v.with_background(rgb(0x111111)) })
        let other = div().id("other").size(40.0, 30.0).background(rgb(0x222222)).hover(fn(v: Visual) -> Visual { v.with_background(rgb(0x333333)) })
        div().size(200.0, 100.0).padding_xy(20.0, 10.0).row().child(source).child(other)
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    let down = shot(cx, view)
    if quad_of(down, 0x111111) < 0 {
        t.error("the press did not activate the source")
    }
    move_to(cx, 34.0, 20.0)
    let moved = shot(cx, view)
    if quad_of(moved, 0x111111) >= 0 {
        t.error("the source stays active during a drag")
    }
    move_to(cx, 80.0, 20.0)
    let over = shot(cx, view)
    if quad_of(over, 0x333333) >= 0 {
        t.error("an element is hovered during a drag")
    }
    release(cx, 80.0, 20.0)
    let after = shot(cx, view)
    if quad_of(after, 0x333333) < 0 {
        t.error("the element is not hovered after the drag")
    }
}

fn test_a_tooltip_does_not_show_during_a_drag(t: *testing.T) {
    let view = fn() -> Element {
        let other = div().id("other").size(40.0, 30.0).tooltip(fn() -> Element { div().size(20.0, 10.0).background(rgb(0x00ff00)) })
        div().size(200.0, 100.0).padding_xy(20.0, 10.0).row().child(drag_source()).child(other)
    }
    let control = headless(rgb(0xffffff))
    shot(control, view)
    move_to(control, 80.0, 20.0)
    advance_clock(control, 600)
    if quad_of(shot(control, view), 0x00ff00) < 0 {
        t.error("the tooltip does not show after the delay without a drag")
    }
    let cx = headless(rgb(0xffffff))
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    move_to(cx, 80.0, 20.0)
    advance_clock(cx, 600)
    if quad_of(shot(cx, view), 0x00ff00) >= 0 {
        t.error("a tooltip shows during a drag")
    }
    let files = headless(rgb(0xffffff))
    shot(files, view)
    move_to(files, 80.0, 20.0)
    advance_clock(files, 400)
    file_enter(files, 80.0, 20.0, ["a.txt"])
    advance_clock(files, 200)
    if quad_of(shot(files, view), 0x00ff00) >= 0 {
        t.error("a tooltip whose delay ends during a drag of files shows")
    }
}

fn test_on_drag_move_runs_for_every_move_of_a_matching_drag_wherever_the_pointer_is(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let far = fn(e: DragMoveEvent) {
        note(log, "far {e.position.x} {e.position.y} bounds {e.bounds.x} {e.bounds.y} {e.bounds.width} {e.bounds.height} value {e.drag.value}")
    }
    let wrong = fn(e: DragMoveEvent) { note(log, "wrong kind") }
    let view = fn() -> Element {
        let watcher = div().id("far").size(40.0, 30.0).on_drag_move("tile", far)
        let other = div().id("wrong").size(40.0, 30.0).on_drag_move("other", wrong)
        div().size(200.0, 140.0).padding_xy(20.0, 10.0).column().child(drag_source()).child(watcher).child(other)
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    if get(log).len != 0 {
        t.error("the move that started the drag ran a drag move handler: {joined(get(log))}")
    }
    shot(cx, view)
    move_to(cx, 150.0, 90.0)
    let seen = joined(get(log))
    if seen != "far 150 90 bounds 20 40 40 30 value 7\n" {
        t.error("drag moves: {seen}")
    }
}

fn test_a_drop_runs_only_on_an_element_of_the_dragged_kind_and_the_drag_always_ends(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let wanted = fn(e: DropEvent) { note(log, "tile {e.drag.value} at {e.position.x} {e.position.y}") }
    let unwanted = fn(e: DropEvent) { note(log, "other") }
    let view = fn() -> Element {
        let a = div().id("a").size(40.0, 30.0).on_drop("tile", wanted)
        let b = div().id("b").size(40.0, 30.0).on_drop("other", unwanted)
        div().size(200.0, 100.0).padding_xy(20.0, 10.0).column().child(drag_source()).child(a).child(b)
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 30.0, 85.0)
    release(cx, 30.0, 85.0)
    if get(log).len != 0 || dragging(cx) {
        t.error("an element of another kind took the drop: {joined(get(log))}")
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 30.0, 55.0)
    release(cx, 30.0, 55.0)
    let seen = joined(get(log))
    if seen != "tile 7 at 30 55\n" || dragging(cx) {
        t.error("drop: {seen}")
    }
}

fn test_can_drop_refuses_a_drop_and_the_refused_drag_goes_no_further_out(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let inner_drop = fn(e: DropEvent) { note(log, "inner") }
    let outer_drop = fn(e: DropEvent) { note(log, "outer") }
    let refuse = fn(p: DragPayload) -> bool { false }
    let allow = fn(p: DragPayload) -> bool { p.value == "7" }
    let view = fn() -> Element {
        let inner = div().id("inner").size(30.0, 20.0).on_drop("tile", inner_drop).can_drop(refuse)
        let outer = div().id("outer").size(60.0, 40.0).padding(5.0).on_drop("tile", outer_drop).child(inner)
        let guarded = div().id("guarded").size(40.0, 30.0).on_drop("tile", fn(e: DropEvent) { note(log, "guarded") }).can_drop(allow)
        div().size(200.0, 140.0).padding_xy(20.0, 10.0).column().child(drag_source()).child(outer).child(guarded)
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 35.0, 55.0)
    release(cx, 35.0, 55.0)
    if get(log).len != 0 {
        t.error("a refused drag reached {joined(get(log))}")
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 30.0, 95.0)
    release(cx, 30.0, 95.0)
    let seen = joined(get(log))
    if seen != "guarded\n" {
        t.error("an accepted drag ran {seen}")
    }
}

fn test_drag_over_restyles_only_while_a_matching_accepted_drag_is_over_the_element(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let lit = fn(v: Visual) -> Visual { v.with_background(rgb(0x00ff00)) }
    let refuse = fn(p: DragPayload) -> bool { false }
    let view = fn() -> Element {
        let zone = div().id("zone").size(40.0, 30.0).background(rgb(0x888888)).drag_over("tile", lit)
        let other = div().id("other").size(40.0, 30.0).background(rgb(0x777777)).drag_over("other", lit)
        let refused = div().id("refused").size(40.0, 30.0).background(rgb(0x666666)).drag_over("tile", lit).can_drop(refuse)
        div().size(200.0, 140.0).padding_xy(20.0, 10.0).column().child(drag_source()).child(zone).child(other).child(refused)
    }
    let before = big(cx, view)
    if quad_of(before, 0x00ff00) >= 0 {
        t.error("styled with no drag")
    }
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    let started = big(cx, view)
    if quad_of(started, 0x00ff00) >= 0 {
        t.error("styled while the drag is away from the element")
    }
    move_to(cx, 30.0, 55.0)
    let over = big(cx, view)
    if quad_of(over, 0x00ff00) < 0 || quad_of(over, 0x888888) >= 0 {
        t.error("not styled while over the element")
    }
    move_to(cx, 30.0, 85.0)
    let wrong = big(cx, view)
    if quad_of(wrong, 0x00ff00) >= 0 || quad_of(wrong, 0x777777) < 0 {
        t.error("styled for another kind")
    }
    move_to(cx, 30.0, 115.0)
    let refusing = big(cx, view)
    if quad_of(refusing, 0x00ff00) >= 0 || quad_of(refusing, 0x666666) < 0 {
        t.error("styled although can_drop refuses")
    }
    move_to(cx, 150.0, 55.0)
    let away = big(cx, view)
    if quad_of(away, 0x00ff00) >= 0 {
        t.error("still styled after the pointer left")
    }
}

fn test_an_occluded_element_neither_takes_the_drop_nor_restyles(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let lit = fn(v: Visual) -> Visual { v.with_background(rgb(0x00ff00)) }
    let view = fn() -> Element {
        let zone = div().id("zone").size(80.0, 60.0).background(rgb(0x888888)).on_drop("tile", fn(e: DropEvent) { note(log, "zone") }).drag_over("tile", lit)
        let cover = div().id("cover").absolute().top(40.0).left(40.0).size(40.0, 40.0).occlude()
        div().size(200.0, 140.0).padding_xy(20.0, 10.0).column().child(drag_source()).child(zone).child(cover)
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 60.0, 60.0)
    let sc = shot(cx, view)
    if quad_of(sc, 0x00ff00) >= 0 {
        t.error("an occluded element is styled")
    }
    release(cx, 60.0, 60.0)
    if get(log).len != 0 {
        t.error("an occluded element took the drop: {joined(get(log))}")
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 30.0, 90.0)
    release(cx, 30.0, 90.0)
    if joined(get(log)) != "zone\n" {
        t.error("the uncovered part of the element did not take the drop: {joined(get(log))}")
    }
}

fn test_a_release_over_no_target_ends_the_drag_and_the_preview_goes(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { drag_field() }
    drag_started(cx, view)
    let during = shot(cx, view)
    if quad_of(during, 0xff0000) < 0 {
        t.error("no preview during the drag")
    }
    release(cx, 150.0, 80.0)
    if dragging(cx) {
        t.error("the drag outlived the release")
    }
    let after = shot(cx, view)
    if quad_of(after, 0xff0000) >= 0 {
        t.error("the preview stays after the release")
    }
}

fn test_any_button_release_ends_a_drag_and_escape_does_not(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { drag_field() }
    drag_started(cx, view)
    hit_key(cx, platform.NamedKey.Escape)
    if !dragging(cx) {
        t.error("Escape ended the drag")
    }
    dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Right, x: 34.0, y: 20.0 }))
    if dragging(cx) {
        t.error("a secondary release left the drag")
    }
    drag_started(cx, view)
    if !cancel_drag(cx) || dragging(cx) {
        t.error("cancel_drag did not end the drag")
    }
    if cancel_drag(cx) {
        t.error("cancel_drag reported a drag that was not there")
    }
}

fn test_the_innermost_element_with_a_drag_starts_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        let inner = div().id("inner").size(20.0, 20.0).on_drag("small", "inner", drag_preview)
        let outer = div().id("outer").size(60.0, 60.0).on_drag("large", "outer", drag_preview).child(inner)
        div().size(200.0, 100.0).padding_xy(20.0, 10.0).child(outer)
    }
    shot(cx, view)
    press(cx, 25.0, 15.0)
    move_to(cx, 29.0, 15.0)
    let p = drag_payload(cx) ?? DragPayload { kind: "" }
    if p.kind != "small" {
        t.error("the drag is {p.kind}")
    }
}

fn test_a_drag_of_files_from_another_program_drives_drag_over_move_and_drop(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let lit = fn(v: Visual) -> Visual { v.with_background(rgb(0x00ff00)) }
    let moved = fn(e: DragMoveEvent) { note(log, "move {e.position.x} {e.position.y} {e.drag.paths.len}") }
    let dropped = fn(e: DropEvent) {
        note(log, "drop {e.position.x} {e.position.y} {e.drag.kind} {e.drag.paths[0]} {e.drag.paths[1]}")
    }
    let view = fn() -> Element {
        let zone = div().id("zone").size(80.0, 60.0).background(rgb(0x888888)).on_drop(external_paths, dropped).drag_over(external_paths, lit)
        let watcher = div().id("watcher").size(10.0, 10.0).on_drag_move(external_paths, moved)
        div().size(200.0, 140.0).padding_xy(20.0, 10.0).child(zone).child(watcher)
    }
    shot(cx, view)
    file_enter(cx, 150.0, 100.0, ["a.txt", "b.txt"])
    if !dragging(cx) {
        t.error("files entering did not start a drag")
    }
    let p = drag_payload(cx) ?? DragPayload { kind: "" }
    if p.kind != external_paths || p.paths.len != 2 || p.value != "" {
        t.error("payload {p.kind} {p.paths.len}")
    }
    let outside = shot(cx, view)
    if quad_of(outside, 0x00ff00) >= 0 || quad_of(outside, 0xff0000) >= 0 {
        t.error("the zone is styled or a preview is drawn while the files are away")
    }
    file_move(cx, 40.0, 30.0)
    let inside = shot(cx, view)
    if quad_of(inside, 0x00ff00) < 0 {
        t.error("the zone is not styled while the files are over it")
    }
    file_drop(cx, 40.0, 30.0)
    if dragging(cx) {
        t.error("the drop left the drag")
    }
    let seen = joined(get(log))
    if seen != "move 150 100 2\nmove 40 30 2\ndrop 40 30 external_paths a.txt b.txt\n" {
        t.error("events: {seen}")
    }
}

fn test_files_leaving_the_window_end_the_drag_without_a_drop(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        div().size(200.0, 100.0).on_drop(external_paths, fn(e: DropEvent) { note(log, "drop") })
    }
    shot(cx, view)
    file_enter(cx, 10.0, 10.0, ["a.txt"])
    dispatch(cx, platform.Event.FileDragExited)
    if dragging(cx) {
        t.error("the drag outlived the exit")
    }
    file_move(cx, 10.0, 10.0)
    file_drop(cx, 10.0, 10.0)
    if get(log).len != 0 {
        t.error("a drop with no entered files ran {joined(get(log))}")
    }
}

fn test_a_drop_zone_under_a_sibling_that_overlaps_without_occluding_takes_the_drop(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let lit = fn(v: Visual) -> Visual { v.with_background(rgb(0x00ff00)) }
    let view = fn() -> Element {
        let zone = div().id("zone").size(80.0, 60.0).background(rgb(0x888888)).on_drop("tile", fn(e: DropEvent) { note(log, "zone") }).drag_over("tile", lit)
        let cover = div().id("cover").absolute().top(40.0).left(40.0).size(40.0, 40.0).on_mouse_down(platform.Button.Middle, fn(e: MouseDownEvent) { note(log, "cover down") })
        div().size(200.0, 140.0).padding_xy(20.0, 10.0).column().child(drag_source()).child(zone).child(cover)
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 60.0, 60.0)
    if quad_of(shot(cx, view), 0x00ff00) < 0 {
        t.error("the element under the overlapping sibling is not styled")
    }
    release(cx, 60.0, 60.0)
    if joined(get(log)) != "zone\n" {
        t.error("the element under the overlapping sibling did not take the drop: {joined(get(log))}")
    }
}

fn zone_with_ups(log: Signal[str[]], refuse: bool) -> fn() -> Element {
    fn() -> Element {
        let refusing = fn(p: DragPayload) -> bool { !refuse }
        let zone = div().id("zone").size(80.0, 40.0)
            .on_drop("tile", fn(e: DropEvent) { note(log, "drop") })
            .can_drop(refusing)
            .on_mouse_up(platform.Button.Left, fn(e: MouseUpEvent) { note(log, "zone up") })
        div().size(200.0, 100.0).padding_xy(20.0, 10.0).column()
            .on_mouse_up(platform.Button.Left, fn(e: MouseUpEvent) { note(log, "outer up") })
            .child(drag_source()).child(zone)
    }
}

fn test_a_drop_runs_before_the_mouse_up_handlers_and_an_accepted_one_skips_them(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = zone_with_ups(log, false)
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 30.0, 55.0)
    release(cx, 30.0, 55.0)
    if joined(get(log)) != "drop\n" {
        t.error("an accepted drop ran {joined(get(log))}")
    }
    let none_yet: str[] = []
    set(log, none_yet)
    shot(cx, view)
    click(cx, 30.0, 55.0)
    if joined(get(log)) != "zone up\nouter up\n" {
        t.error("a release with no drag ran {joined(get(log))}")
    }
    let refusing_cx = headless(rgb(0xffffff))
    let refusing_log = log_of(refusing_cx)
    let refusing_view = zone_with_ups(refusing_log, true)
    shot(refusing_cx, refusing_view)
    press(refusing_cx, 30.0, 20.0)
    move_to(refusing_cx, 34.0, 20.0)
    shot(refusing_cx, refusing_view)
    move_to(refusing_cx, 30.0, 55.0)
    release(refusing_cx, 30.0, 55.0)
    if joined(get(refusing_log)) != "zone up\nouter up\n" {
        t.error("a refused drop ran {joined(get(refusing_log))}")
    }
}

fn test_the_pointer_shows_the_cursor_of_the_drag_source_while_dragging(t: *testing.T) {
    let grabbing = fn() -> Element {
        let source = drag_source().cursor(platform.Cursor.Grabbing)
        let text = div().id("text").size(40.0, 30.0).cursor(platform.Cursor.Text)
        div().size(200.0, 100.0).padding_xy(20.0, 10.0).column().child(source).child(text)
    }
    let plain = fn() -> Element {
        let text = div().id("text").size(40.0, 30.0).cursor(platform.Cursor.Text)
        div().size(200.0, 100.0).padding_xy(20.0, 10.0).column().child(drag_source()).child(text)
    }
    let cx = headless(rgb(0xffffff))
    shot(cx, grabbing)
    move_to(cx, 30.0, 55.0)
    if pointer_cursor(cx) != platform.Cursor.Text {
        t.error("the cursor before the drag is not the text cursor")
    }
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, grabbing)
    move_to(cx, 30.0, 55.0)
    if pointer_cursor(cx) != platform.Cursor.Grabbing {
        t.error("the cursor over another element during the drag is not the source's")
    }
    release(cx, 30.0, 55.0)
    if pointer_cursor(cx) != platform.Cursor.Text {
        t.error("the cursor after the drag is not the text cursor")
    }
    let other = headless(rgb(0xffffff))
    shot(other, plain)
    press(other, 30.0, 20.0)
    move_to(other, 34.0, 20.0)
    shot(other, plain)
    move_to(other, 30.0, 55.0)
    if pointer_cursor(other) != platform.Cursor.Arrow {
        t.error("a source with no cursor leaves another element's cursor in effect during the drag")
    }
}

fn test_files_leaving_the_window_move_the_pointer_out_and_refresh_hover(t: *testing.T) {
    let lit = fn(v: Visual) -> Visual { v.with_background(rgb(0x00ff00)) }
    let view = fn() -> Element {
        div().size(200.0, 100.0).background(rgb(0x888888)).hover(lit)
    }
    let cx = headless(rgb(0xffffff))
    shot(cx, view)
    file_enter(cx, 10.0, 10.0, ["a.txt"])
    shot(cx, view)
    dispatch(cx, platform.Event.FileDragExited)
    testing.equal(t, cx.state.pointer_inside, false)
    testing.equal(t, frame_due(cx), true)
    if quad_of(shot(cx, view), 0x00ff00) >= 0 {
        t.error("the element is hovered after the files left the window")
    }
    let dropped = headless(rgb(0xffffff))
    shot(dropped, view)
    file_enter(dropped, 10.0, 10.0, ["a.txt"])
    file_drop(dropped, 10.0, 10.0)
    if quad_of(shot(dropped, view), 0x00ff00) < 0 {
        t.error("the element is not hovered after the files dropped on it")
    }
}

fn test_on_drag_move_stop_propagation_stops_the_other_handlers_and_the_elements_under_the_pointer(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let stop = signal(cx, true)
    let first = fn(e: DragMoveEvent) {
        note(log, "first")
        if get(stop) {
            stop_propagation(cx)
        }
    }
    let second = fn(e: DragMoveEvent) { note(log, "second") }
    let view = fn() -> Element {
        let a = div().id("a").size(40.0, 30.0).on_drag_move("tile", first)
        let b = div().id("b").size(40.0, 30.0).on_drag_move("tile", second)
        let under = div().id("under").size(40.0, 30.0).on_mouse_move(fn(e: MouseMoveEvent) { note(log, "under") })
        div().size(200.0, 160.0).padding_xy(20.0, 10.0).column().child(drag_source()).child(a).child(b).child(under)
    }
    big(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    big(cx, view)
    move_to(cx, 30.0, 115.0)
    if joined(get(log)) != "first\n" {
        t.error("a stopped move reached {joined(get(log))}")
    }
    set(stop, false)
    move_to(cx, 31.0, 115.0)
    if joined(get(log)) != "first\nfirst\nsecond\nunder\n" {
        t.error("an unstopped move ran {joined(get(log))}")
    }
}

fn test_an_element_keeps_only_its_last_can_drop(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let refuse = fn(p: DragPayload) -> bool { false }
    let allow = fn(p: DragPayload) -> bool { true }
    let view = fn() -> Element {
        let a = div().id("a").size(40.0, 30.0).on_drop("tile", fn(e: DropEvent) { note(log, "a") }).can_drop(refuse).can_drop(allow)
        let b = div().id("b").size(40.0, 30.0).on_drop("tile", fn(e: DropEvent) { note(log, "b") }).can_drop(allow).can_drop(refuse)
        div().size(200.0, 140.0).padding_xy(20.0, 10.0).column().child(drag_source()).child(a).child(b)
    }
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 30.0, 55.0)
    release(cx, 30.0, 55.0)
    shot(cx, view)
    press(cx, 30.0, 20.0)
    move_to(cx, 34.0, 20.0)
    shot(cx, view)
    move_to(cx, 30.0, 85.0)
    release(cx, 30.0, 85.0)
    if joined(get(log)) != "a\n" {
        t.error("drops ran {joined(get(log))}")
    }
}

fn test_a_drag_of_files_ignores_a_move_to_the_same_position_and_drops_with_one_click(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        let watcher = div().id("watcher").size(10.0, 10.0).on_drag_move(external_paths, fn(e: DragMoveEvent) { note(log, "move {e.position.x} {e.position.y}") })
        let pad = div().id("pad").size(100.0, 100.0).on_mouse_up(platform.Button.Left, fn(e: MouseUpEvent) { note(log, "up {e.click_count}") })
        div().size(200.0, 140.0).child(watcher).child(pad)
    }
    shot(cx, view)
    file_enter(cx, 40.0, 50.0, ["a.txt"])
    file_move(cx, 40.0, 50.0)
    file_move(cx, 41.0, 50.0)
    file_move(cx, 41.0, 50.0)
    file_drop(cx, 41.0, 50.0)
    if joined(get(log)) != "move 40 50\nmove 41 50\nup 1\n" {
        t.error("events: {joined(get(log))}")
    }
}
