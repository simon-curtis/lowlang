import std/ui/geometry
import std/ui/platform

enum ItemKind {
    Entry
    Action
    Separator
    Submenu
}

/// One row of a menu: an entry that runs a function, an item that dispatches an action, a separator or a submenu.
pub struct MenuItem {
    kind: ItemKind = Entry
    label: str = ""
    action: str = ""
    run: fn() = no_run
    disabled: bool = false
    items: MenuItem[] = []
}

fn no_run() {}

/// Returns a menu item labelled `label` that runs `f` when chosen.
pub fn menu_entry(label: str, f: fn()) -> MenuItem {
    MenuItem { kind: Entry, label, run: f }
}

/// Returns a menu item labelled `label` that dispatches the action `action` to the element focused before the menu opened, showing the keystrokes bound to it there and drawn disabled where no element on that element's path handles it.
pub fn menu_action(label: str, action: str) -> MenuItem {
    MenuItem { kind: Action, label, action }
}

/// Returns a line between groups of menu items.
pub fn menu_separator() -> MenuItem {
    MenuItem { kind: Separator }
}

/// Returns a menu item labelled `label` that opens the menu `items` beside it.
pub fn submenu(label: str, items: MenuItem[]) -> MenuItem {
    MenuItem { kind: Submenu, label, items }
}

/// Returns `item` drawn greyed out, skipped by the arrow keys and not chosen by a click.
pub fn disabled(item: MenuItem) -> MenuItem {
    var out = item
    out.disabled = true
    out
}

fn items_at(l: Layer, level: i64) -> MenuItem[] {
    var items = l.items()
    for k in 0..level {
        let i = l.path[k]
        if i < 0 || i >= items.len {
            return []
        }
        items = items[i].items
    }
    items
}

fn enabled(st: *State, l: Layer, item: MenuItem) -> bool {
    match item.kind {
        Separator => false
        Action => !item.disabled && available_in(st, item.action, l.restore)
        _ => !item.disabled
    }
}

fn available_in(st: *State, name: str, key: str) -> bool {
    for at in dispatch_path(st, key) {
        if handles(st.hitboxes[at].element, name) {
            return true
        }
    }
    false
}

fn shortcut_hint(st: *State, l: Layer, item: MenuItem) -> str {
    match item.kind {
        Action => {
            let path = dispatch_path(st, l.restore)
            let found = bindings_for(st.shared.keymap, item.action, context_stack(st, path))
            if found.len == 0 { "" } else { binding_text(found[found.len - 1]) }
        }
        Submenu => ">"
        _ => ""
    }
}

fn menu_panel(st: *State, l: Layer, level: i64) -> Element {
    var rows: Element[] = []
    let highlighted = l.path[level]
    for i, item in items_at(l, level) {
        rows.push(menu_row(st, l, level, i, item, i == highlighted))
    }
    div().id(panel_key(l.id, level)).column().focusable().occlude().min_width(120.0).padding(4.0)
        .background(geometry.rgb(0xffffff)).border(1.0, geometry.rgb(0xd4d4d8)).rounded(6.0).shadow(BoxShadow { y: 2.0, blur: 4.0 })
        .children(rows)
}

fn menu_row(st: *State, l: Layer, level: i64, index: i64, item: MenuItem, highlighted: bool) -> Element {
    if item.kind == Separator {
        return div().height(1.0).margin_xy(0.0, 4.0).background(geometry.rgb(0xe4e4e7))
    }
    let on = enabled(st, l, item)
    let label_color = if on { geometry.rgb(0x18181b) } else { geometry.rgb(0xa1a1aa) }
    let fill = if highlighted && on { geometry.rgb(0xe4e4e7) } else { geometry.Color {} }
    let hint = text(shortcut_hint(st, l, item)).text_color(geometry.rgb(0x71717a))
    var row = div().row().justify_between().gap(24.0).padding_xy(8.0, 2.0).rounded(4.0).background(fill)
        .text_color(label_color).child(text(item.label)).child(hint)
    if !on {
        return row
    }
    let id = l.id
    row = row.on_mouse_move(fn(e: MouseMoveEvent) { highlight(st, id, level, index) })
    row.on_click(fn(e: ClickEvent) { choose(st, id, level, index) })
}

fn highlight(st: *State, id: str, level: i64, index: i64) {
    let at = layer_index(st, id)
    if at < 0 || level >= st.layers[at].path.len {
        return
    }
    let l = st.layers[at]
    if l.path[level] == index && l.path.len == level + 1 {
        return
    }
    var path = l.path[0..level + 1]
    path[level] = index
    let items = items_at(l, level)
    if items[index].kind == Submenu {
        path.push(-1)
    }
    st.layers[at].path = path
    st.dirty = true
}

fn choose(st: *State, id: str, level: i64, index: i64) {
    let at = layer_index(st, id)
    if at < 0 {
        return
    }
    let l = st.layers[at]
    let items = items_at(l, level)
    if index < 0 || index >= items.len || !enabled(st, l, items[index]) {
        return
    }
    let item = items[index]
    match item.kind {
        Submenu => {
            var path = l.path[0..level + 1]
            path[level] = index
            path.push(next_enabled(st, l, item.items, -1, 1))
            st.layers[at].path = path
            st.dirty = true
        }
        Entry => {
            close_layer(st, at)
            item.run()
        }
        Action => {
            close_layer(st, at)
            run_action(st, dispatch_path(st, st.focus), item.action)
        }
        Separator => {}
    }
}

fn next_enabled(st: *State, l: Layer, items: MenuItem[], from: i64, step: i64) -> i64 {
    let n = items.len
    if n == 0 {
        return -1
    }
    var i = from
    for _ in 0..n {
        i = if i < 0 && step < 0 { n - 1 } else { (i + step + n) % n }
        if enabled(st, l, items[i]) {
            return i
        }
    }
    -1
}

fn menu_key(st: *State, at: i64, k: platform.KeyEvent) -> bool {
    let l = st.layers[at]
    let level = l.path.len - 1
    let items = items_at(l, level)
    let current = l.path[level]
    match k.key {
        Named(n) => {
            match n {
                Down => set_highlight(st, at, level, next_enabled(st, l, items, current, 1))
                Up => set_highlight(st, at, level, next_enabled(st, l, items, current, -1))
                Home => set_highlight(st, at, level, next_enabled(st, l, items, -1, 1))
                End => set_highlight(st, at, level, next_enabled(st, l, items, 0, -1))
                Enter => choose(st, l.id, level, current)
                Right => {
                    if current >= 0 && items[current].kind == Submenu {
                        choose(st, l.id, level, current)
                    }
                }
                Left => {
                    if level > 0 {
                        st.layers[at].path = l.path[0..level]
                        st.dirty = true
                    }
                }
                Escape => close_layer(st, at)
                _ => return false
            }
            true
        }
        Character(c) => {
            if c != " " {
                return false
            }
            choose(st, l.id, level, current)
            true
        }
    }
}

fn set_highlight(st: *State, at: i64, level: i64, index: i64) {
    var path = st.layers[at].path[0..level + 1]
    path[level] = index
    st.layers[at].path = path
    st.dirty = true
}
