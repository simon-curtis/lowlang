import std/ui/scene

struct Band {
    top: i64
    bottom: i64
}

fn ensure_atlas(s: *State, size: i64) ! Error {
    if size < 1 {
        fail InvalidSize(size, size)
    }
    if s.atlas.handle.handle != 0 && s.atlas.width == size {
        return
    }
    let d = s.device
    let usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT
    let image = create_image(d, VK_FORMAT_R8_UNORM, size, size, usage)?
    check(vkDeviceWaitIdle(d.handle), "vkDeviceWaitIdle")?
    destroy_image(d, s.atlas)
    s.atlas = image
    s.atlas_ready = false
    for f in s.frames {
        for set in f.sets {
            write_atlas_binding(d, set, s.sampler, image)
        }
    }
}

fn atlas_band(s: *State, a: scene.Atlas) -> Band {
    if !s.atlas_ready {
        return Band { top: 0, bottom: a.size }
    }
    if !scene.dirty(a) {
        return Band { top: 0, bottom: 0 }
    }
    let top = if a.dirty_top > 0 { a.dirty_top } else { 0 }
    let bottom = if a.dirty_bottom < a.size { a.dirty_bottom } else { a.size }
    Band { top, bottom }
}

fn stage_atlas(s: *State, f: *Frame, a: scene.Atlas, band: Band) ! Error {
    if band.bottom <= band.top {
        return
    }
    let bytes = (band.bottom - band.top) * a.size
    ensure_buffer(s.device, mut f.staging, bytes, VK_BUFFER_USAGE_TRANSFER_SRC_BIT)?
    let at: ptr[u8] = f.staging.mapped
    let rows = view(at, bytes)
    __memmove(rows, a.pixels[band.top * a.size..band.bottom * a.size])
}

fn record_atlas_upload(mut pins: Pins, cmd: VkCommandBuffer, s: *State, f: *Frame, a: scene.Atlas, band: Band) {
    if band.bottom <= band.top {
        return
    }
    let from = if s.atlas_ready { VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL } else { VK_IMAGE_LAYOUT_UNDEFINED }
    image_barrier(mut pins, cmd, s.atlas.handle, from, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
        VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT,
        VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT)
    let layers = VkImageSubresourceLayers { aspectMask: VK_IMAGE_ASPECT_COLOR_BIT, layerCount: 1 }
    let offset = VkOffset3D { x: 0, y: i32(band.top), z: 0 }
    let extent = VkExtent3D { width: u32(a.size), height: u32(band.bottom - band.top), depth: 1 }
    let copy = VkBufferImageCopy { imageSubresource: layers, imageOffset: offset, imageExtent: extent }
    let regions = pins.hold(copy)
    vkCmdCopyBufferToImage(cmd, f.staging.handle, s.atlas.handle, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, regions)
    image_barrier(mut pins, cmd, s.atlas.handle, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
        VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
        VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT)
}
