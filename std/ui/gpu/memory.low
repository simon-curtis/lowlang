struct Buffer {
    handle: VkBuffer = VkBuffer {}
    memory: VkDeviceMemory = VkDeviceMemory {}
    size: i64 = 0
    mapped: ptr = null
}

struct Image {
    handle: VkImage = VkImage {}
    memory: VkDeviceMemory = VkDeviceMemory {}
    view: VkImageView = VkImageView {}
    format: i32 = 0
    width: i64 = 0
    height: i64 = 0
}

const host_visible: u32 = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT

fn memory_type(d: Device, allowed: u32, wanted: u32) -> u32 ! Error {
    for i, kind in d.memory_types {
        let bit: u32 = 1 << i
        if allowed & bit != 0 && kind.propertyFlags & wanted == wanted {
            return u32(i)
        }
    }
    fail NoMemoryType(allowed, wanted)
}

fn allocate(d: Device, needs: VkMemoryRequirements, wanted: u32) -> VkDeviceMemory ! Error {
    let index = memory_type(d, needs.memoryTypeBits, wanted)?
    var info = VkMemoryAllocateInfo { allocationSize: needs.size, memoryTypeIndex: index }
    var memory = VkDeviceMemory {}
    check(vkAllocateMemory(d.handle, mut info, null, mut memory), "vkAllocateMemory")?
    memory
}

fn create_buffer(d: Device, size: i64, usage: u32) -> Buffer ! Error {
    var b = Buffer { size }
    build_buffer(d, mut b, usage) catch {
        e => {
            destroy_buffer(d, b)
            fail e
        }
    }
    b
}

fn build_buffer(d: Device, mut b: Buffer, usage: u32) ! Error {
    var info = VkBufferCreateInfo { size: b.size, usage }
    check(vkCreateBuffer(d.handle, mut info, null, mut b.handle), "vkCreateBuffer")?
    var needs = VkMemoryRequirements {}
    vkGetBufferMemoryRequirements(d.handle, b.handle, mut needs)
    b.memory = allocate(d, needs, host_visible)?
    check(vkBindBufferMemory(d.handle, b.handle, b.memory, 0), "vkBindBufferMemory")?
    check(vkMapMemory(d.handle, b.memory, 0, b.size, 0, mut b.mapped), "vkMapMemory")?
}

fn destroy_buffer(d: Device, b: Buffer) {
    vkDestroyBuffer(d.handle, b.handle, null)
    vkFreeMemory(d.handle, b.memory, null)
}

fn ensure_buffer(d: Device, mut b: Buffer, needed: i64, usage: u32) -> bool ! Error {
    if needed <= b.size {
        return false
    }
    var size = if b.size > 0 { b.size } else { 16384 }
    for size < needed {
        size *= 2
    }
    let grown = create_buffer(d, size, usage)?
    destroy_buffer(d, b)
    b = grown
    true
}

fn create_image(d: Device, format: i32, width: i64, height: i64, usage: u32) -> Image ! Error {
    var image = Image { format, width, height }
    build_image(d, mut image, usage) catch {
        e => {
            destroy_image(d, image)
            fail e
        }
    }
    image
}

fn build_image(d: Device, mut image: Image, usage: u32) ! Error {
    var info = VkImageCreateInfo {
        imageType: VK_IMAGE_TYPE_2D
        format: image.format
        extent: VkExtent3D { width: u32(image.width), height: u32(image.height), depth: 1 }
        mipLevels: 1
        arrayLayers: 1
        samples: VK_SAMPLE_COUNT_1_BIT
        tiling: VK_IMAGE_TILING_OPTIMAL
        usage
        initialLayout: VK_IMAGE_LAYOUT_UNDEFINED
    }
    check(vkCreateImage(d.handle, mut info, null, mut image.handle), "vkCreateImage")?
    var needs = VkMemoryRequirements {}
    vkGetImageMemoryRequirements(d.handle, image.handle, mut needs)
    image.memory = allocate(d, needs, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)?
    check(vkBindImageMemory(d.handle, image.handle, image.memory, 0), "vkBindImageMemory")?
    let range = VkImageSubresourceRange { aspectMask: VK_IMAGE_ASPECT_COLOR_BIT, levelCount: 1, layerCount: 1 }
    var view_info = VkImageViewCreateInfo { image: image.handle, viewType: VK_IMAGE_VIEW_TYPE_2D, format: image.format, subresourceRange: range }
    check(vkCreateImageView(d.handle, mut view_info, null, mut image.view), "vkCreateImageView")?
}

fn destroy_image(d: Device, image: Image) {
    vkDestroyImageView(d.handle, image.view, null)
    vkDestroyImage(d.handle, image.handle, null)
    vkFreeMemory(d.handle, image.memory, null)
}

fn image_barrier(mut pins: Pins, cmd: VkCommandBuffer, image: VkImage, from: i32, to: i32, src_stage: i64, src_access: i64, dst_stage: i64, dst_access: i64) {
    let range = VkImageSubresourceRange { aspectMask: VK_IMAGE_ASPECT_COLOR_BIT, levelCount: 1, layerCount: 1 }
    let barrier = VkImageMemoryBarrier2 {
        srcStageMask: src_stage
        srcAccessMask: src_access
        dstStageMask: dst_stage
        dstAccessMask: dst_access
        oldLayout: from
        newLayout: to
        srcQueueFamilyIndex: VK_QUEUE_FAMILY_IGNORED
        dstQueueFamilyIndex: VK_QUEUE_FAMILY_IGNORED
        image
        subresourceRange: range
    }
    let barriers = pins.hold(barrier)
    var dependency = VkDependencyInfo { imageMemoryBarrierCount: 1, pImageMemoryBarriers: barriers }
    vkCmdPipelineBarrier2(cmd, mut dependency)
}
