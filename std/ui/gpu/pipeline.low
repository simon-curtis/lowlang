extern struct TargetSize {
    width: f32
    height: f32
}

struct Pipelines {
    quad: VkPipeline = VkPipeline {}
    shadow: VkPipeline = VkPipeline {}
    sprite: VkPipeline = VkPipeline {}
}

struct Fixed {
    rendering: ptr[VkPipelineRenderingCreateInfo]
    vertex_input: ptr[VkPipelineVertexInputStateCreateInfo]
    assembly: ptr[VkPipelineInputAssemblyStateCreateInfo]
    viewport: ptr[VkPipelineViewportStateCreateInfo]
    raster: ptr[VkPipelineRasterizationStateCreateInfo]
    multisample: ptr[VkPipelineMultisampleStateCreateInfo]
    colour: ptr[VkPipelineColorBlendStateCreateInfo]
    dynamic: ptr[VkPipelineDynamicStateCreateInfo]
    layout: VkPipelineLayout
}

const both_stages: u32 = VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT

fn create_set_layout(d: Device) -> VkDescriptorSetLayout ! Error {
    using var pins = new_pins()
    let instances = VkDescriptorSetLayoutBinding {
        binding: 0
        descriptorType: VK_DESCRIPTOR_TYPE_STORAGE_BUFFER
        descriptorCount: 1
        stageFlags: both_stages
    }
    let atlas = VkDescriptorSetLayoutBinding {
        binding: 1
        descriptorType: VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
        descriptorCount: 1
        stageFlags: VK_SHADER_STAGE_FRAGMENT_BIT
    }
    let all: []VkDescriptorSetLayoutBinding = [instances, atlas]
    let bindings = pins.hold_all(all)
    var info = VkDescriptorSetLayoutCreateInfo { bindingCount: 2, pBindings: bindings }
    var layout = VkDescriptorSetLayout {}
    check(vkCreateDescriptorSetLayout(d.handle, mut info, null, mut layout), "vkCreateDescriptorSetLayout")?
    layout
}

fn create_pipeline_layout(d: Device, set_layout: VkDescriptorSetLayout) -> VkPipelineLayout ! Error {
    using var pins = new_pins()
    let layouts = pins.hold(set_layout)
    let range = VkPushConstantRange { stageFlags: both_stages, offset: 0, size: 8 }
    let ranges = pins.hold(range)
    var info = VkPipelineLayoutCreateInfo { setLayoutCount: 1, pSetLayouts: layouts, pushConstantRangeCount: 1, pPushConstantRanges: ranges }
    var layout = VkPipelineLayout {}
    check(vkCreatePipelineLayout(d.handle, mut info, null, mut layout), "vkCreatePipelineLayout")?
    layout
}

fn create_sampler(d: Device) -> VkSampler ! Error {
    var info = VkSamplerCreateInfo {
        magFilter: VK_FILTER_NEAREST
        minFilter: VK_FILTER_NEAREST
        mipmapMode: VK_SAMPLER_MIPMAP_MODE_NEAREST
        addressModeU: VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
        addressModeV: VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
        addressModeW: VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
    }
    var sampler = VkSampler {}
    check(vkCreateSampler(d.handle, mut info, null, mut sampler), "vkCreateSampler")?
    sampler
}

fn create_shader(d: Device, code: str) -> VkShaderModule ! Error {
    using var pins = new_pins()
    let words = bytes(code)
    let held: ptr = pins.hold_all(words)
    let data: ptr[u32] = held
    var info = VkShaderModuleCreateInfo { codeSize: code.len, pCode: data }
    var module = VkShaderModule {}
    check(vkCreateShaderModule(d.handle, mut info, null, mut module), "vkCreateShaderModule")?
    module
}

fn stages(mut pins: Pins, vertex: VkShaderModule, fragment: VkShaderModule, entry: ptr[u8]) -> ptr[VkPipelineShaderStageCreateInfo] {
    let first = VkPipelineShaderStageCreateInfo { stage: VK_SHADER_STAGE_VERTEX_BIT, module: vertex, pName: entry }
    let second = VkPipelineShaderStageCreateInfo { stage: VK_SHADER_STAGE_FRAGMENT_BIT, module: fragment, pName: entry }
    let both: []VkPipelineShaderStageCreateInfo = [first, second]
    pins.hold_all(both)
}

fn create_pipelines(d: Device, layout: VkPipelineLayout, format: i32) -> Pipelines ! Error {
    using var pins = new_pins()
    let quad_vertex = create_shader(d, embed("shaders/quad.vert.spv"))?
    defer vkDestroyShaderModule(d.handle, quad_vertex, null)
    let quad_fragment = create_shader(d, embed("shaders/quad.frag.spv"))?
    defer vkDestroyShaderModule(d.handle, quad_fragment, null)
    let shadow_vertex = create_shader(d, embed("shaders/shadow.vert.spv"))?
    defer vkDestroyShaderModule(d.handle, shadow_vertex, null)
    let shadow_fragment = create_shader(d, embed("shaders/shadow.frag.spv"))?
    defer vkDestroyShaderModule(d.handle, shadow_fragment, null)
    let sprite_vertex = create_shader(d, embed("shaders/sprite.vert.spv"))?
    defer vkDestroyShaderModule(d.handle, sprite_vertex, null)
    let sprite_fragment = create_shader(d, embed("shaders/sprite.frag.spv"))?
    defer vkDestroyShaderModule(d.handle, sprite_fragment, null)

    let entry = cstr("main")
    let formats = pins.hold(format)
    let rendering = pins.hold(VkPipelineRenderingCreateInfo { colorAttachmentCount: 1, pColorAttachmentFormats: formats })
    let blend = VkPipelineColorBlendAttachmentState {
        blendEnable: 1
        srcColorBlendFactor: VK_BLEND_FACTOR_SRC_ALPHA
        dstColorBlendFactor: VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
        colorBlendOp: VK_BLEND_OP_ADD
        srcAlphaBlendFactor: VK_BLEND_FACTOR_ONE
        dstAlphaBlendFactor: VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
        alphaBlendOp: VK_BLEND_OP_ADD
        colorWriteMask: 15
    }
    let blend_attachment = pins.hold(blend)
    let dynamic: []i32 = [VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR]
    let dynamic_states = pins.hold_all(dynamic)
    let vertex_input = pins.hold(VkPipelineVertexInputStateCreateInfo {})
    let assembly = pins.hold(VkPipelineInputAssemblyStateCreateInfo { topology: VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST })
    let viewport = pins.hold(VkPipelineViewportStateCreateInfo { viewportCount: 1, scissorCount: 1 })
    let raster = pins.hold(VkPipelineRasterizationStateCreateInfo { polygonMode: VK_POLYGON_MODE_FILL, cullMode: VK_CULL_MODE_NONE, lineWidth: 1.0 })
    let multisample = pins.hold(VkPipelineMultisampleStateCreateInfo { rasterizationSamples: VK_SAMPLE_COUNT_1_BIT })
    let colour = pins.hold(VkPipelineColorBlendStateCreateInfo { attachmentCount: 1, pAttachments: blend_attachment })
    let dynamic_info = pins.hold(VkPipelineDynamicStateCreateInfo { dynamicStateCount: 2, pDynamicStates: dynamic_states })

    let quad_stages = stages(mut pins, quad_vertex, quad_fragment, entry)
    let shadow_stages = stages(mut pins, shadow_vertex, shadow_fragment, entry)
    let sprite_stages = stages(mut pins, sprite_vertex, sprite_fragment, entry)
    let parts = Fixed {
        rendering
        vertex_input
        assembly
        viewport
        raster
        multisample
        colour
        dynamic: dynamic_info
        layout
    }
    let infos: []VkGraphicsPipelineCreateInfo = [
        pipeline_info(parts, quad_stages),
        pipeline_info(parts, shadow_stages),
        pipeline_info(parts, sprite_stages)
    ]
    let info_data = pins.hold_all(infos)
    let made: []VkPipeline = __make(3)
    let made_data = pins.hold_all(made)
    let result = vkCreateGraphicsPipelines(d.handle, VkPipelineCache {}, 3, info_data, null, made_data)
    if result != VK_SUCCESS {
        for p in made {
            vkDestroyPipeline(d.handle, p, null)
        }
        fail Vulkan("vkCreateGraphicsPipelines", result)
    }
    Pipelines { quad: made[0], shadow: made[1], sprite: made[2] }
}

fn pipeline_info(f: Fixed, stages: ptr[VkPipelineShaderStageCreateInfo]) -> VkGraphicsPipelineCreateInfo {
    VkGraphicsPipelineCreateInfo {
        pNext: f.rendering
        stageCount: 2
        pStages: stages
        pVertexInputState: f.vertex_input
        pInputAssemblyState: f.assembly
        pViewportState: f.viewport
        pRasterizationState: f.raster
        pMultisampleState: f.multisample
        pColorBlendState: f.colour
        pDynamicState: f.dynamic
        layout: f.layout
    }
}

fn destroy_pipelines(d: Device, p: Pipelines) {
    vkDestroyPipeline(d.handle, p.quad, null)
    vkDestroyPipeline(d.handle, p.shadow, null)
    vkDestroyPipeline(d.handle, p.sprite, null)
}
