import std/ui/scene

extern struct TargetSize {
    width: f32
    height: f32
}

const intermediate_format: i32 = VK_FORMAT_R8G8B8A8_UNORM
const path_samples: u32 = VK_SAMPLE_COUNT_4_BIT

struct Pipelines {
    made: VkPipeline[]
    composite: VkPipeline
}

enum Blend {
    Straight
    Stripe
    Premultiplied
}

struct Program {
    vertex: str
    fragment: str
    blend: Blend = Straight
    rasterised: bool = false
}

struct Modules {
    device: Handles
    made: [str: VkShaderModule] = [:]
    drop {
        for _, m in made {
            vkDestroyShaderModule(device.handle, m, null)
        }
    }
}

struct Fixed {
    rendering: ptr[VkPipelineRenderingCreateInfo]
    intermediate_rendering: ptr[VkPipelineRenderingCreateInfo]
    vertex_input: ptr[VkPipelineVertexInputStateCreateInfo]
    assembly: ptr[VkPipelineInputAssemblyStateCreateInfo]
    viewport: ptr[VkPipelineViewportStateCreateInfo]
    raster: ptr[VkPipelineRasterizationStateCreateInfo]
    multisample: ptr[VkPipelineMultisampleStateCreateInfo]
    intermediate_multisample: ptr[VkPipelineMultisampleStateCreateInfo]
    dynamic: ptr[VkPipelineDynamicStateCreateInfo]
    straight: ptr[VkPipelineColorBlendStateCreateInfo]
    stripe: ptr[VkPipelineColorBlendStateCreateInfo]
    premultiplied: ptr[VkPipelineColorBlendStateCreateInfo]
    layout: VkPipelineLayout
}

const both_stages: u32 = VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT

fn create_set_layout(d: Handles) -> VkDescriptorSetLayout ! Error {
    using var pins = new_pins()
    let instances = VkDescriptorSetLayoutBinding {
        binding: 0
        descriptorType: VK_DESCRIPTOR_TYPE_STORAGE_BUFFER
        descriptorCount: 1
        stageFlags: both_stages
    }
    let atlas = VkDescriptorSetLayoutBinding {
        binding: 1
        descriptorType: VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
        descriptorCount: 1
        stageFlags: VK_SHADER_STAGE_FRAGMENT_BIT
    }
    let all: VkDescriptorSetLayoutBinding[] = [instances, atlas]
    let bindings = pins.hold_all(all)
    var info = VkDescriptorSetLayoutCreateInfo { bindingCount: 2, pBindings: bindings }
    var layout = VkDescriptorSetLayout {}
    check(vkCreateDescriptorSetLayout(d.handle, mut info, null, mut layout), "vkCreateDescriptorSetLayout")?
    layout
}

fn create_pipeline_layout(d: Handles, set_layout: VkDescriptorSetLayout) -> VkPipelineLayout ! Error {
    using var pins = new_pins()
    let layouts = pins.hold(set_layout)
    let range = VkPushConstantRange { stageFlags: both_stages, offset: 0, size: 48 }
    let ranges = pins.hold(range)
    var info = VkPipelineLayoutCreateInfo { setLayoutCount: 1, pSetLayouts: layouts, pushConstantRangeCount: 1, pPushConstantRanges: ranges }
    var layout = VkPipelineLayout {}
    check(vkCreatePipelineLayout(d.handle, mut info, null, mut layout), "vkCreatePipelineLayout")?
    layout
}

fn create_sampler(d: Handles) -> VkSampler ! Error {
    var info = VkSamplerCreateInfo {
        magFilter: VK_FILTER_LINEAR
        minFilter: VK_FILTER_LINEAR
        mipmapMode: VK_SAMPLER_MIPMAP_MODE_NEAREST
        addressModeU: VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
        addressModeV: VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
        addressModeW: VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
    }
    var sampler = VkSampler {}
    check(vkCreateSampler(d.handle, mut info, null, mut sampler), "vkCreateSampler")?
    sampler
}

fn create_shader(d: Handles, code: str) -> VkShaderModule ! Error {
    using var pins = new_pins()
    let words = bytes(code)
    let held: ptr = pins.hold_all(words)
    let data: ptr[u32] = held
    var info = VkShaderModuleCreateInfo { codeSize: code.len, pCode: data }
    var module = VkShaderModule {}
    check(vkCreateShaderModule(d.handle, mut info, null, mut module), "vkCreateShaderModule")?
    module
}

fn stages(mut pins: Pins, vertex: VkShaderModule, fragment: VkShaderModule, entry: ptr[u8]) -> ptr[VkPipelineShaderStageCreateInfo] {
    let first = VkPipelineShaderStageCreateInfo { stage: VK_SHADER_STAGE_VERTEX_BIT, module: vertex, pName: entry }
    let second = VkPipelineShaderStageCreateInfo { stage: VK_SHADER_STAGE_FRAGMENT_BIT, module: fragment, pName: entry }
    let both: VkPipelineShaderStageCreateInfo[] = [first, second]
    pins.hold_all(both)
}

fn program(kind: scene.Kind, dual_source: bool) -> Program {
    match kind {
        Shadows => Program { vertex: embed("shaders/shadow.vert.spv"), fragment: embed("shaders/shadow.frag.spv") }
        Quads => Program { vertex: embed("shaders/quad.vert.spv"), fragment: embed("shaders/quad.frag.spv") }
        Paths => Program { vertex: embed("shaders/path.vert.spv"), fragment: embed("shaders/path.frag.spv"), blend: Premultiplied, rasterised: true }
        Underlines => Program { vertex: embed("shaders/underline.vert.spv"), fragment: embed("shaders/underline.frag.spv") }
        Sprites => Program { vertex: embed("shaders/sprite.vert.spv"), fragment: embed("shaders/sprite.frag.spv") }
        SubpixelSprites => {
            let fragment = if dual_source { embed("shaders/subpixel.frag.spv") } else { embed("shaders/sprite.frag.spv") }
            Program { vertex: embed("shaders/sprite.vert.spv"), fragment, blend: Stripe }
        }
        PolychromeSprites => Program { vertex: embed("shaders/polychrome.vert.spv"), fragment: embed("shaders/polychrome.frag.spv") }
    }
}

fn composite_program() -> Program {
    Program { vertex: embed("shaders/pathsprite.vert.spv"), fragment: embed("shaders/pathsprite.frag.spv"), blend: Premultiplied }
}

fn add_shader(mut m: Modules, code: str) -> VkShaderModule ! Error {
    match m.made[code] {
        some(module) => module
        none => {
            let module = create_shader(m.device, code)?
            m.made[code] = module
            module
        }
    }
}

fn create_pipelines(d: Handles, layout: VkPipelineLayout, format: i32, dual_source: bool) -> Pipelines ! Error {
    using var pins = new_pins()
    using var modules = Modules { device: d }
    let entry = cstr("main")
    let formats = pins.hold(format)
    let rendering = pins.hold(VkPipelineRenderingCreateInfo { colorAttachmentCount: 1, pColorAttachmentFormats: formats })
    let intermediate_formats = pins.hold(intermediate_format)
    let intermediate_rendering = pins.hold(VkPipelineRenderingCreateInfo { colorAttachmentCount: 1, pColorAttachmentFormats: intermediate_formats })
    let blend = VkPipelineColorBlendAttachmentState {
        blendEnable: 1
        srcColorBlendFactor: VK_BLEND_FACTOR_SRC_ALPHA
        dstColorBlendFactor: VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
        colorBlendOp: VK_BLEND_OP_ADD
        srcAlphaBlendFactor: VK_BLEND_FACTOR_ONE
        dstAlphaBlendFactor: VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
        alphaBlendOp: VK_BLEND_OP_ADD
        colorWriteMask: 15
    }
    let blend_attachment = pins.hold(blend)
    let stripe_blend = VkPipelineColorBlendAttachmentState {
        blendEnable: 1
        srcColorBlendFactor: VK_BLEND_FACTOR_SRC1_COLOR
        dstColorBlendFactor: VK_BLEND_FACTOR_ONE_MINUS_SRC1_COLOR
        colorBlendOp: VK_BLEND_OP_ADD
        srcAlphaBlendFactor: VK_BLEND_FACTOR_ONE
        dstAlphaBlendFactor: VK_BLEND_FACTOR_ZERO
        alphaBlendOp: VK_BLEND_OP_ADD
        colorWriteMask: 7
    }
    let stripe_attachment = pins.hold(stripe_blend)
    let premultiplied_blend = VkPipelineColorBlendAttachmentState {
        blendEnable: 1
        srcColorBlendFactor: VK_BLEND_FACTOR_ONE
        dstColorBlendFactor: VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
        colorBlendOp: VK_BLEND_OP_ADD
        srcAlphaBlendFactor: VK_BLEND_FACTOR_ONE
        dstAlphaBlendFactor: VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
        alphaBlendOp: VK_BLEND_OP_ADD
        colorWriteMask: 15
    }
    let premultiplied_attachment = pins.hold(premultiplied_blend)
    let dynamic: i32[] = [VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR]
    let dynamic_states = pins.hold_all(dynamic)
    let parts = Fixed {
        rendering
        intermediate_rendering
        vertex_input: pins.hold(VkPipelineVertexInputStateCreateInfo {})
        assembly: pins.hold(VkPipelineInputAssemblyStateCreateInfo { topology: VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST })
        viewport: pins.hold(VkPipelineViewportStateCreateInfo { viewportCount: 1, scissorCount: 1 })
        raster: pins.hold(VkPipelineRasterizationStateCreateInfo { polygonMode: VK_POLYGON_MODE_FILL, cullMode: VK_CULL_MODE_NONE, lineWidth: 1.0 })
        multisample: pins.hold(VkPipelineMultisampleStateCreateInfo { rasterizationSamples: VK_SAMPLE_COUNT_1_BIT })
        intermediate_multisample: pins.hold(VkPipelineMultisampleStateCreateInfo { rasterizationSamples: path_samples })
        dynamic: pins.hold(VkPipelineDynamicStateCreateInfo { dynamicStateCount: 2, pDynamicStates: dynamic_states })
        straight: pins.hold(VkPipelineColorBlendStateCreateInfo { attachmentCount: 1, pAttachments: blend_attachment })
        stripe: pins.hold(VkPipelineColorBlendStateCreateInfo { attachmentCount: 1, pAttachments: stripe_attachment })
        premultiplied: pins.hold(VkPipelineColorBlendStateCreateInfo { attachmentCount: 1, pAttachments: premultiplied_attachment })
        layout
    }
    var programs: Program[] = []
    for kind in scene.kinds() {
        programs.push(program(kind, dual_source))
    }
    programs.push(composite_program())
    var infos: VkGraphicsPipelineCreateInfo[] = []
    for p in programs {
        let vertex = modules.add_shader(p.vertex)?
        let fragment = modules.add_shader(p.fragment)?
        infos.push(pipeline_info(parts, p, stages(mut pins, vertex, fragment, entry)))
    }
    let info_data = pins.hold_all(infos)
    let made: VkPipeline[] = __make(programs.len)
    let made_data = pins.hold_all(made)
    let result = vkCreateGraphicsPipelines(d.handle, VkPipelineCache {}, u32(programs.len), info_data, null, made_data)
    if result != VK_SUCCESS {
        for p in made {
            vkDestroyPipeline(d.handle, p, null)
        }
        fail Vulkan("vkCreateGraphicsPipelines", result)
    }
    let kinds = scene.kinds().len
    Pipelines { made: made[..kinds], composite: made[kinds] }
}

fn pipeline_info(f: Fixed, p: Program, stages: ptr[VkPipelineShaderStageCreateInfo]) -> VkGraphicsPipelineCreateInfo {
    VkGraphicsPipelineCreateInfo {
        pNext: if p.rasterised { f.intermediate_rendering } else { f.rendering }
        stageCount: 2
        pStages: stages
        pVertexInputState: f.vertex_input
        pInputAssemblyState: f.assembly
        pViewportState: f.viewport
        pRasterizationState: f.raster
        pMultisampleState: if p.rasterised { f.intermediate_multisample } else { f.multisample }
        pColorBlendState: blend_state(f, p.blend)
        pDynamicState: f.dynamic
        layout: f.layout
    }
}

fn blend_state(f: Fixed, blend: Blend) -> ptr[VkPipelineColorBlendStateCreateInfo] {
    match blend {
        Straight => f.straight
        Stripe => f.stripe
        Premultiplied => f.premultiplied
    }
}

fn destroy_pipelines(d: Handles, p: Pipelines) {
    for made in p.made {
        vkDestroyPipeline(d.handle, made, null)
    }
    vkDestroyPipeline(d.handle, p.composite, null)
}
