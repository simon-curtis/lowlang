import std/testing
import std/ui/geometry
import std/ui/scene

fn test_instance_strides_match_the_std430_layout_of_the_shaders(t: *testing.T) {
    testing.equal(t, stride_of[scene.Quad](), 96)
    testing.equal(t, stride_of[scene.Shadow](), 80)
    testing.equal(t, stride_of[scene.Underline](), 64)
    testing.equal(t, stride_of[scene.Sprite](), 64)
    testing.equal(t, stride_of[scene.SubpixelSprite](), 64)
    testing.equal(t, stride_of[scene.PolychromeSprite](), 80)
}

fn test_path_vertices_match_the_layout_of_the_path_shaders(t: *testing.T) {
    testing.equal(t, stride_of[scene.PathVertex](), 16)
    testing.equal(t, stride_of[RasterVertex](), 48)
    testing.equal(t, stride_of[PathSprite](), 16)
}

fn two_paths(width: i64, height: i64, spread: f32) -> scene.Scene {
    var s = scene.empty(width, height, geometry.rgb(0xffffff))
    for i in 0..2 {
        let x = 2.0 + f32(i) * spread
        var p = scene.path(geometry.point(x, 2.0), geometry.rgb(0xff0000))
        scene.line_to(mut p, geometry.point(x + 6.0, 2.0))
        scene.line_to(mut p, geometry.point(x, 8.0))
        scene.push_path(mut s, p)
    }
    s
}

fn test_a_batch_of_paths_sharing_one_order_plans_one_sprite_each(t: *testing.T) {
    let s = two_paths(64, 16, 20.0)
    let plan = plan_paths(s, scene.batches(s), 64, 16)
    testing.equal(t, plan.batches.len, 1)
    testing.equal(t, plan.batches[0].sprite_count, 2)
    testing.equal(t, plan.vertices.len, 6)
    testing.equal(t, i64(plan.batches[0].area.offset.x), 2)
    testing.equal(t, i64(plan.batches[0].area.extent.width), 26)
}

fn test_a_batch_of_paths_beyond_the_target_is_not_drawn(t: *testing.T) {
    let s = two_paths(256, 16, 100.0)
    let plan = plan_paths(s, scene.batches(s), 64, 16)
    testing.equal(t, plan.batches[0].drawn, true)
    let beyond = plan_paths(s, scene.batches(s), 1, 16)
    testing.equal(t, beyond.batches[0].area.extent.width, 0)
    testing.equal(t, beyond.batches[0].drawn, false)
}
