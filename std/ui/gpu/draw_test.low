import std/testing
import std/ui/scene

fn test_instance_strides_match_the_std430_layout_of_the_shaders(t: *testing.T) {
    testing.equal(t, stride_of[scene.Quad](), 96)
    testing.equal(t, stride_of[scene.Shadow](), 80)
    testing.equal(t, stride_of[scene.Underline](), 64)
    testing.equal(t, stride_of[scene.Sprite](), 64)
    testing.equal(t, stride_of[scene.SubpixelSprite](), 64)
    testing.equal(t, stride_of[scene.PolychromeSprite](), 80)
}
