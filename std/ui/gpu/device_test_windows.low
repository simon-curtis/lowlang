import std/testing
import std/ui/platform
import std/ui/scene

fn test_a_window_takes_one_presenter(t: *testing.T) {
    using r = open_rig() catch {
        e => {
            report(t, e)
            return
        }
    }
    using extra = presenter(r.device, surface_of(r.first.window)) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    var atlases = [scene.atlas(1024)]
    present_to(r.first_presenter, flat(r.first.size, 0x203040), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    var refused: i32 = 0
    present_to(extra, flat(r.first.size, 0x203040), mut atlases) catch {
        Vulkan(call, result) => {
            refused = result
        }
        e => t.fatal(describe(e))
    }
    t.equal(refused, VK_ERROR_NATIVE_WINDOW_IN_USE_KHR)
}
