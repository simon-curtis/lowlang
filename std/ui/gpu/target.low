import std/ui/scene

struct TargetState {
    device: *DeviceState
    image: Image = Image {}
    readback: Buffer = Buffer {}
    width: i64 = 0
    height: i64 = 0
}

/// An offscreen image that scenes are drawn into and read back from, `R8G8B8A8_UNORM` with `width` by `height` pixels.
///
/// Releasing a `Target` waits for the device to go idle and destroys its image. A `Target` released after the `Gpu` it was made from, or drawn to or read through another `Gpu`, does nothing or fails with `WrongDevice`; releasing the `Gpu` destroys every `Target` still alive.
pub struct Target {
    /// The width in pixels.
    pub width: i64
    /// The height in pixels.
    pub height: i64
    state: *TargetState
    drop destroy_target(state)
}

const target_format: i32 = VK_FORMAT_R8G8B8A8_UNORM

/// Makes a target of `width` by `height` pixels on `g`.
///
/// Fails with `InvalidSize` when either is below one.
pub fn target(g: Gpu, width: i64, height: i64) -> Target ! Error {
    target_of(g.state.device, width, height)?
}

/// Makes a target of `width` by `height` pixels on the device behind `d`, as `target` does. It fails with `NoDevice` once the device is closed.
pub fn target_on(d: DeviceHandle, width: i64, height: i64) -> Target ! Error {
    target_of(d.state, width, height)?
}

fn target_of(device: *DeviceState, width: i64, height: i64) -> Target ! Error {
    if device.closed {
        fail NoDevice
    }
    if width < 1 || height < 1 {
        fail InvalidSize(width, height)
    }
    pipelines_for(device, target_format)?
    let state = new(TargetState { device, width, height })
    device.targets.push(state)
    using t = Target { width, height, state }
    build_target(state)?
    t
}

fn build_target(t: *TargetState) ! Error {
    let usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT
    t.image = create_image(t.device.device, target_format, t.width, t.height, VK_SAMPLE_COUNT_1_BIT, usage)?
    t.readback = create_buffer(t.device.device, t.width * t.height * 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT)?
}

fn destroy_target(t: *TargetState) {
    let device = t.device
    let handles = device.device
    if handles.handle.handle != null {
        vkDeviceWaitIdle(handles.handle)
        free_target(handles, t)
    }
    var kept: *TargetState[] = []
    for other in device.targets {
        if other != t {
            kept.push(other)
        }
    }
    device.targets = kept
}

fn free_target(d: Handles, t: *TargetState) {
    destroy_buffer(d, t.readback)
    destroy_image(d, t.image)
    t.readback = Buffer {}
    t.image = Image {}
}

/// Draws `s` into `t`, clearing it to the scene's background first, and uploads the rows of each of `atlases` that changed since the last call.
///
/// Positions in `s` are device pixels of `t`; the scene's own width and height are not read. A sprite samples the atlas at the index its `push_sprite_from` named, so every index a sprite names must be below `atlases.len`, or the call fails with `InvalidTexture`. The call returns once the work is submitted, and `read` waits for it. The `Gpu` keeps one texture for each atlas it was last given, which mirrors that atlas, so every call passes the same atlases in the same order, and a call with fewer destroys the textures past the end of its list. After the call every atlas is marked clean.
pub fn render(g: Gpu, t: Target, s: scene.Scene, mut atlases: scene.Atlas[]) ! Error {
    render_frame(g.state.device, t, s, mut atlases)?
}

/// Draws `s` into `t` on the device behind `d`, as `render` does. It fails with `NoDevice` once the device is closed.
pub fn render_on(d: DeviceHandle, t: Target, s: scene.Scene, mut atlases: scene.Atlas[]) ! Error {
    render_frame(d.state, t, s, mut atlases)?
}

fn render_frame(state: *DeviceState, t: Target, s: scene.Scene, mut atlases: scene.Atlas[]) ! Error {
    if state.closed {
        fail NoDevice
    }
    let target = t.state
    if target.device != state {
        fail WrongDevice
    }
    let pipelines = pipelines_for(state, target_format)?
    let frame = state.frames[state.next_frame]
    wait_frame(state.device, frame)?
    write_instances(state, frame, s, atlases.len, target.width, target.height)?
    ensure_textures(state, atlases)?
    let bands = atlas_bands(state, atlases)
    stage_atlases(state, frame, atlases, bands)?
    record_target(state, frame, target, pipelines, s, atlases, bands)?
    submit(state, frame)?
    state.next_frame = (state.next_frame + 1) % state.frames.len
    settle_atlases(state, mut atlases)
}

/// Waits for every submitted frame and returns the pixels of `t` as rows from the top of four bytes each, red, green, blue and alpha, `width * height * 4` bytes in all.
///
/// The bytes are unspecified until `render` has drawn into `t`.
pub fn read(g: Gpu, t: Target) -> u8[] ! Error {
    pixels_of(g.state.device, t)?
}

/// Waits for every submitted frame of the device behind `d` and returns the pixels of `t`, as `read` does. It fails with `NoDevice` once the device is closed.
pub fn read_on(d: DeviceHandle, t: Target) -> u8[] ! Error {
    pixels_of(d.state, t)?
}

fn pixels_of(state: *DeviceState, t: Target) -> u8[] ! Error {
    if state.closed {
        fail NoDevice
    }
    if t.state.device != state {
        fail WrongDevice
    }
    check(vkQueueWaitIdle(state.device.queue), "vkQueueWaitIdle")?
    let bytes = t.width * t.height * 4
    let out: u8[] = __make(bytes)
    let at: ptr[u8] = t.state.readback.mapped
    let pixels = view(at, bytes)
    __memmove(out, pixels)
    out
}

fn record_target(s: *DeviceState, f: *Frame, t: *TargetState, p: Pipelines, sc: scene.Scene, atlases: scene.Atlas[], bands: Band[]) ! Error {
    using var pins = new_pins()
    let cmd = f.command_buffer
    check(vkResetCommandBuffer(cmd, 0), "vkResetCommandBuffer")?
    var begin = VkCommandBufferBeginInfo { flags: VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT }
    check(vkBeginCommandBuffer(cmd, mut begin), "vkBeginCommandBuffer")?
    record_atlas_uploads(mut pins, cmd, s, f, atlases, bands)
    image_barrier(mut pins, cmd, t.image.handle, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
        VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
        VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT)
    let attachment = Attachment { image: t.image.handle, view: t.image.view, width: t.width, height: t.height }
    record_pass(mut pins, cmd, s, f, p, attachment, sc)
    image_barrier(mut pins, cmd, t.image.handle, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
        VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
        VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT)
    record_readback(mut pins, cmd, t)
    check(vkEndCommandBuffer(cmd), "vkEndCommandBuffer")?
}

fn record_readback(mut pins: Pins, cmd: VkCommandBuffer, t: *TargetState) {
    let layers = VkImageSubresourceLayers { aspectMask: VK_IMAGE_ASPECT_COLOR_BIT, layerCount: 1 }
    let extent = VkExtent3D { width: u32(t.width), height: u32(t.height), depth: 1 }
    let copy = VkBufferImageCopy { imageSubresource: layers, imageExtent: extent }
    let regions = pins.hold(copy)
    vkCmdCopyImageToBuffer(cmd, t.image.handle, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, t.readback.handle, 1, regions)
    let visible = VkBufferMemoryBarrier2 {
        srcStageMask: VK_PIPELINE_STAGE_2_COPY_BIT
        srcAccessMask: VK_ACCESS_2_TRANSFER_WRITE_BIT
        dstStageMask: VK_PIPELINE_STAGE_2_HOST_BIT
        dstAccessMask: VK_ACCESS_2_HOST_READ_BIT
        srcQueueFamilyIndex: VK_QUEUE_FAMILY_IGNORED
        dstQueueFamilyIndex: VK_QUEUE_FAMILY_IGNORED
        buffer: t.readback.handle
        size: VK_WHOLE_SIZE
    }
    let barriers = pins.hold(visible)
    var dependency = VkDependencyInfo { bufferMemoryBarrierCount: 1, pBufferMemoryBarriers: barriers }
    vkCmdPipelineBarrier2(cmd, mut dependency)
}

fn submit(s: *DeviceState, f: *Frame) ! Error {
    using var pins = new_pins()
    let command = VkCommandBufferSubmitInfo { commandBuffer: f.command_buffer }
    let commands = pins.hold(command)
    let info = VkSubmitInfo2 { commandBufferInfoCount: 1, pCommandBufferInfos: commands }
    let infos = pins.hold(info)
    check(vkQueueSubmit2(s.device.queue, 1, infos, f.fence), "vkQueueSubmit2")?
    f.submitted = true
}
