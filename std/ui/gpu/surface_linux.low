const surface_extension = "VK_KHR_wayland_surface"

fn create_surface(instance: VkInstance, s: Surface) -> VkSurfaceKHR ! Error {
    var info = VkWaylandSurfaceCreateInfoKHR { display: s.display, surface: s.window }
    var surface = VkSurfaceKHR {}
    check(vkCreateWaylandSurfaceKHR(instance, mut info, null, mut surface), "vkCreateWaylandSurfaceKHR")?
    surface
}
