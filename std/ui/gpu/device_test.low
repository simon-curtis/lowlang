import std/testing
import std/ui/geometry
import std/ui/platform
import std/ui/scene

const target_width = 32
const target_height = 16
const first_background = 0x102030
const second_background = 0x302010
const first_quad = 0xc04040
const second_quad = 0x40c040

enum Setup {
    Unavailable(reason: str)
    Failed(reason: str)
}

struct Size {
    width: i64
    height: i64
}

struct Opened {
    window: platform.Window
    size: Size
}

struct Rig {
    first_presenter: Presenter
    second_presenter: Presenter
    device: Device
    first: Opened
    second: Opened
}

struct Early {
    device: Device
    presenter: Presenter
    target: Target
}

struct Tiles {
    first: u8[]
    deep: u8[]
}

struct Probe {
    background: i64
    channel: i64
}

fn surface_of(w: platform.Window) -> Surface {
    let native = platform.native(w)
    Surface { display: native.display, window: native.window }
}

fn size_of(events: platform.Event[]) -> Size {
    var size = Size { width: 0, height: 0 }
    for e in events {
        match e {
            Resized(width, height, scale) => {
                size = Size { width: i64(floor(width * scale + 0.5)), height: i64(floor(height * scale + 0.5)) }
            }
            _ => {}
        }
    }
    size
}

fn open_window(title: str, width: i64, height: i64) -> Opened ! Setup {
    using w = platform.open(platform.Options { title, width, height, hidden: true, activate: false }) catch {
        e => fail Setup.Unavailable("cannot open a window: {e}")
    }
    let events = platform.next(w, 5000) catch {
        e => fail Setup.Unavailable("cannot read window events: {e}")
    }
    let size = size_of(events)
    if size.width < 1 || size.height < 1 {
        fail Setup.Failed("the window reported no size")
    }
    Opened { window: w, size }
}

fn open_rig() -> Rig ! Setup {
    using first = open_window("first", 200, 120)?
    using second = open_window("second", 320, 180)?
    using device = open_device(surface_of(first.window)) catch {
        NoDevice => fail Setup.Unavailable("no Vulkan 1.3 device that presents to a window")
        e => fail Setup.Failed(describe(e))
    }
    using first_presenter = presenter(device, surface_of(first.window)) catch {
        e => fail Setup.Failed(describe(e))
    }
    using second_presenter = presenter(device, surface_of(second.window)) catch {
        e => fail Setup.Failed(describe(e))
    }
    Rig { first_presenter, second_presenter, device, first, second }
}

fn flat(size: Size, color: u32) -> scene.Scene {
    scene.empty(size.width, size.height, geometry.rgb(color))
}

fn first_scene(atlas: scene.Atlas, size: Size) -> scene.Scene {
    var s = scene.empty(size.width, size.height, geometry.rgb(u32(first_background)))
    let tile = scene.tile(atlas, 0, 0, 4, 1)
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(2.0, 2.0, 4.0, 1.0), color: geometry.rgb(0xffffff), tile })
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(16.0, 2.0, 12.0, 12.0), background: geometry.rgb(u32(first_quad)), corner_radii: geometry.corners(0.0) })
    s
}

fn second_scene(atlas: scene.Atlas, size: Size) -> scene.Scene {
    var s = scene.empty(size.width, size.height, geometry.rgb(u32(second_background)))
    let tile = scene.tile(atlas, 10, 900, 4, 1)
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(2.0, 6.0, 4.0, 1.0), color: geometry.rgb(0xffffff), tile })
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(16.0, 8.0, 12.0, 6.0), background: geometry.rgb(u32(second_quad)), corner_radii: geometry.corners(0.0) })
    s
}

fn write_tiles(mut atlas: scene.Atlas, tiles: Tiles) {
    scene.write(mut atlas, 0, 0, 4, 1, tiles.first)
    scene.write(mut atlas, 10, 900, 4, 1, tiles.deep)
}

fn channel_at(pixels: u8[], x: i64, y: i64, channel: i64) -> i64 {
    i64(pixels[(y * target_width + x) * 4 + channel])
}

fn near(got: i64, want: i64) -> bool {
    got - want <= 2 && want - got <= 2
}

fn tinted(p: Probe, coverage: i64) -> i64 {
    p.background + (255 - p.background) * coverage / 255
}

fn sprite_row(pixels: u8[], y: i64, background: i64, coverage: u8[]) -> bool {
    for i in 0..coverage.len {
        for channel in 0..3 {
            let shift = 16 - channel * 8
            let probe = Probe { background: (background >> shift) & 0xff, channel }
            if !near(channel_at(pixels, 2 + i, y, channel), tinted(probe, i64(coverage[i]))) {
                return false
            }
        }
    }
    true
}

fn quad_is(pixels: u8[], x: i64, y: i64, color: i64) -> bool {
    for channel in 0..3 {
        let shift = 16 - channel * 8
        if !near(channel_at(pixels, x, y, channel), (color >> shift) & 0xff) {
            return false
        }
    }
    true
}

fn drawn_first(r: Rig, t: Target, mut atlases: scene.Atlas[], tiles: Tiles) -> bool ! Error {
    render_frame(r.device.handle.state, t, first_scene(atlases[0], r.first.size), mut atlases)?
    let pixels = pixels_of(r.device.handle.state, t)?
    sprite_row(pixels, 2, first_background, tiles.first) && quad_is(pixels, 20, 6, first_quad)
}

fn drawn_second(r: Rig, t: Target, mut atlases: scene.Atlas[], tiles: Tiles) -> bool ! Error {
    render_frame(r.device.handle.state, t, second_scene(atlases[0], r.second.size), mut atlases)?
    let pixels = pixels_of(r.device.handle.state, t)?
    sprite_row(pixels, 6, second_background, tiles.deep) && quad_is(pixels, 20, 11, second_quad)
}

fn report(t: *testing.T, e: Setup) {
    match e {
        Unavailable(reason) => t.skip(reason)
        Failed(reason) => t.fatal(reason)
    }
}

fn test_release_order_does_not_matter(t: *testing.T) {
    using w = open_window("release order", 200, 120) catch {
        e => {
            report(t, e)
            return
        }
    }
    var atlases = [scene.atlas(1024)]
    using d = open_device(surface_of(w.window)) catch {
        NoDevice => {
            t.skip("no Vulkan 1.3 device that presents to a window")
            return
        }
        e => {
            t.fatal(describe(e))
            return
        }
    }
    using p = presenter(d, surface_of(w.window)) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    using target = target_of(d.handle.state, 8, 8) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    present_to(p, with_path(w.size, 0x203040), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    using early = Early { device: d, presenter: p, target }
    t.log("released with the device first")
}

fn test_presenters_have_their_own_swapchains(t: *testing.T) {
    using r = open_rig() catch {
        e => {
            report(t, e)
            return
        }
    }
    var atlases = [scene.atlas(1024)]
    present_to(r.first_presenter, flat(r.first.size, 0x203040), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    present_to(r.second_presenter, flat(r.second.size, 0x402030), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    let a = r.first_presenter.handle.state.swapchain
    let b = r.second_presenter.handle.state.swapchain
    t.equal(a.width, r.first.size.width)
    t.equal(a.height, r.first.size.height)
    t.equal(b.width, r.second.size.width)
    t.equal(b.height, r.second.size.height)
    t.equal(a.handle.handle != b.handle.handle, true)
}

fn test_atlas_uploaded_through_one_presenter_is_sampled_by_the_other(t: *testing.T) {
    using r = open_rig() catch {
        e => {
            report(t, e)
            return
        }
    }
    using target = target_of(r.device.handle.state, target_width, target_height) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    var atlases = [scene.atlas(1024)]
    let one = Tiles { first: [255, 200, 100, 50], deep: [60, 120, 180, 240] }
    let two = Tiles { first: [10, 20, 30, 40], deep: [250, 150, 90, 30] }

    write_tiles(mut atlases[0], one)
    present_to(r.first_presenter, first_scene(atlases[0], r.first.size), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    present_to(r.second_presenter, second_scene(atlases[0], r.second.size), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    let first_after_first = drawn_first(r, target, mut atlases, one) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    let second_after_first = drawn_second(r, target, mut atlases, one) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    t.equal(first_after_first, true)
    t.equal(second_after_first, true)

    write_tiles(mut atlases[0], two)
    present_to(r.second_presenter, second_scene(atlases[0], r.second.size), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    present_to(r.first_presenter, first_scene(atlases[0], r.first.size), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    let first_after_second = drawn_first(r, target, mut atlases, two) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    let second_after_second = drawn_second(r, target, mut atlases, two) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    t.equal(first_after_second, true)
    t.equal(second_after_second, true)
}

fn with_path(size: Size, color: u32) -> scene.Scene {
    var s = flat(size, color)
    var p = scene.path(geometry.point(2.0, 2.0), geometry.rgb(0xffffff))
    scene.line_to(mut p, geometry.point(12.0, 2.0))
    scene.line_to(mut p, geometry.point(2.0, 12.0))
    scene.push_path(mut s, p)
    s
}

fn test_paths_are_presented_through_every_presenter(t: *testing.T) {
    using r = open_rig() catch {
        e => {
            report(t, e)
            return
        }
    }
    var atlases = [scene.atlas(1024)]
    for round in 0..3 {
        present_to(r.first_presenter, with_path(r.first.size, 0x102030), mut atlases) catch {
            e => {
                t.fatal("round {round}: {describe(e)}")
                return
            }
        }
        present_to(r.second_presenter, with_path(r.second.size, 0x302010), mut atlases) catch {
            e => {
                t.fatal("round {round}: {describe(e)}")
                return
            }
        }
    }
    let state = r.device.handle.state
    t.equal(state.resolved.width >= r.first.size.width, true)
    t.equal(state.resolved.height >= r.second.size.height, true)
    t.equal(state.resolved.width % 256, 0)
}

fn test_presents_alternate_between_windows(t: *testing.T) {
    using r = open_rig() catch {
        e => {
            report(t, e)
            return
        }
    }
    var atlases = [scene.atlas(1024)]
    for round in 0..40 {
        let shade = u32(round * 5)
        present_to(r.first_presenter, flat(r.first.size, 0x102030 + shade), mut atlases) catch {
            e => {
                t.fatal("round {round}: {describe(e)}")
                return
            }
        }
        present_to(r.second_presenter, flat(r.second.size, 0x302010 + shade), mut atlases) catch {
            e => {
                t.fatal("round {round}: {describe(e)}")
                return
            }
        }
    }
    t.equal(r.first_presenter.handle.state.swapchain.stale, false)
    t.equal(r.second_presenter.handle.state.swapchain.stale, false)
}

fn test_a_target_from_another_device_is_rejected(t: *testing.T) {
    using r = open_rig() catch {
        e => {
            report(t, e)
            return
        }
    }
    using other = open_device(surface_of(r.first.window)) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    using target = target_of(r.device.handle.state, target_width, target_height) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    var atlases = [scene.atlas(1024)]
    var draw_rejected = false
    render_frame(other.handle.state, target, flat(r.first.size, 0x203040), mut atlases) catch {
        WrongDevice => {
            draw_rejected = true
        }
        e => t.fatal(describe(e))
    }
    var read_rejected = false
    let _ = pixels_of(other.handle.state, target) catch {
        WrongDevice => {
            read_rejected = true
            []
        }
        e => {
            t.fatal(describe(e))
            []
        }
    }
    t.equal(draw_rejected, true)
    t.equal(read_rejected, true)
}

fn test_a_failed_draw_releases_the_acquired_image(t: *testing.T) {
    using r = open_rig() catch {
        e => {
            report(t, e)
            return
        }
    }
    var empty = [scene.atlas(0)]
    var failed = false
    present_to(r.first_presenter, flat(r.first.size, 0x203040), mut empty) catch {
        InvalidSize(width, height) => {
            failed = true
        }
        e => t.fatal(describe(e))
    }
    t.equal(failed, true)
    let device = r.device.handle.state
    t.equal(device.frames[device.next_frame].submitted, true)
    t.equal(r.first_presenter.handle.state.swapchain.stale, true)

    var atlases = [scene.atlas(1024)]
    for round in 0..4 {
        present_to(r.first_presenter, flat(r.first.size, 0x203040), mut atlases) catch {
            e => {
                t.fatal("round {round}: {describe(e)}")
                return
            }
        }
    }
}

fn two_atlas_scene(atlases: scene.Atlas[], size: Size) -> scene.Scene {
    var s = scene.empty(size.width, size.height, geometry.rgb(u32(first_background)))
    let white = geometry.rgb(0xffffff)
    scene.push_sprite_from(mut s, scene.Sprite { bounds: geometry.rect(2.0, 2.0, 4.0, 1.0), color: white, tile: scene.tile(atlases[0], 0, 0, 4, 1) }, 0)
    scene.push_sprite_from(mut s, scene.Sprite { bounds: geometry.rect(2.0, 6.0, 4.0, 1.0), color: white, tile: scene.tile(atlases[1], 0, 0, 4, 1) }, 1)
    scene.push_sprite_from(mut s, scene.Sprite { bounds: geometry.rect(2.0, 10.0, 4.0, 1.0), color: white, tile: scene.tile(atlases[0], 0, 0, 4, 1) }, 0)
    s
}

fn sprite_runs_drawn_last(s: *DeviceState) -> i64 {
    let written = (s.next_frame + s.frames.len - 1) % s.frames.len
    var runs = 0
    for b in s.frames[written].drawing.runs {
        if b.kind == scene.Kind.Sprites {
            runs += 1
        }
    }
    runs
}

fn test_sprites_of_two_atlases_are_drawn_through_a_presenter_and_a_target(t: *testing.T) {
    using r = open_rig() catch {
        e => {
            report(t, e)
            return
        }
    }
    using target = target_of(r.device.handle.state, target_width, target_height) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    let first: u8[] = [255, 200, 100, 50]
    let second: u8[] = [40, 80, 160, 240]
    var atlases = [scene.atlas(64), scene.atlas(32)]
    scene.write(mut atlases[0], 0, 0, 4, 1, first)
    scene.write(mut atlases[1], 0, 0, 4, 1, second)
    present_to(r.first_presenter, two_atlas_scene(atlases, r.first.size), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    render_frame(r.device.handle.state, target, two_atlas_scene(atlases, r.first.size), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    t.equal(sprite_runs_drawn_last(r.device.handle.state), 2)
    let pixels = pixels_of(r.device.handle.state, target) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    t.equal(sprite_row(pixels, 2, first_background, first), true)
    t.equal(sprite_row(pixels, 6, first_background, second), true)
    t.equal(sprite_row(pixels, 10, first_background, first), true)
}

fn sprite_from(texture: i64, size: Size) -> scene.Scene {
    var s = flat(size, 0x203040)
    scene.push_sprite_from(mut s, scene.Sprite { bounds: geometry.rect(2.0, 2.0, 4.0, 1.0), color: geometry.rgb(0xffffff) }, texture)
    s
}

fn test_a_sprite_naming_a_missing_atlas_fails_the_draw_and_the_next_draw_succeeds(t: *testing.T) {
    using r = open_rig() catch {
        e => {
            report(t, e)
            return
        }
    }
    var atlases = [scene.atlas(64), scene.atlas(64)]
    var rejected: i64[] = []
    for texture in [-1, 2, 9] {
        present_to(r.first_presenter, sprite_from(texture, r.first.size), mut atlases) catch {
            InvalidTexture(named, count) => {
                rejected.push(named)
                t.equal(count, 2)
            }
            e => t.fatal(describe(e))
        }
    }
    t.equal(rejected.len, 3)
    t.equal(rejected[0], -1)
    for round in 0..4 {
        present_to(r.first_presenter, sprite_from(round % 2, r.first.size), mut atlases) catch {
            e => {
                t.fatal("round {round}: {describe(e)}")
                return
            }
        }
    }
}

fn test_a_native_window_in_use_has_a_name(t: *testing.T) {
    t.equal(describe(Vulkan("vkCreateSwapchainKHR", VK_ERROR_NATIVE_WINDOW_IN_USE_KHR)), "vkCreateSwapchainKHR failed with VK_ERROR_NATIVE_WINDOW_IN_USE_KHR (-1000000001)")
}

fn is_no_device(e: Error) -> bool {
    match e {
        NoDevice => true
        _ => false
    }
}

fn is_no_surface(e: Error) -> bool {
    match e {
        NoSurface => true
        _ => false
    }
}

fn target_refused(dh: DeviceHandle) -> bool {
    using made = target_on(dh, 4, 4) catch {
        e => return is_no_device(e)
    }
    false
}

fn test_handles_draw_and_close_idempotently(t: *testing.T) {
    using w = open_window("handles", 200, 120) catch {
        e => {
            report(t, e)
            return
        }
    }
    using d = open_device(surface_of(w.window)) catch {
        NoDevice => {
            t.skip("no Vulkan 1.3 device that presents to a window")
            return
        }
        e => {
            t.fatal(describe(e))
            return
        }
    }
    let dh = d.handle
    t.equal(supports_subpixel_on(dh), d.handle.state.dual_source)
    using var made = presenter_on(dh, surface_of(w.window)) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    let ph = detach_presenter(mut made)
    using target = target_on(dh, target_width, target_height) catch {
        e => {
            t.fatal(describe(e))
            return
        }
    }
    var atlases = [scene.atlas(1024)]
    present_to_on(ph, flat(w.size, 0x203040), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    render_on(dh, target, flat(w.size, 0x405060), mut atlases) catch {
        e => t.fatal(describe(e))
    }
    let pixels = read_on(dh, target) catch {
        e => {
            t.fatal(describe(e))
            []
        }
    }
    t.equal(pixels.len, target_width * target_height * 4)
    t.equal(quad_is(pixels, 0, 0, 0x405060), true)

    close_presenter_on(ph)
    close_presenter_on(ph)
    var after_presenter = false
    present_to_on(ph, flat(w.size, 0x203040), mut atlases) catch {
        e => {
            after_presenter = is_no_surface(e)
        }
    }
    t.equal(after_presenter, true)

    close_device_on(dh)
    close_device_on(dh)
    t.equal(supports_subpixel_on(dh), false)
    var refused = 0
    present_to_on(ph, flat(w.size, 0x203040), mut atlases) catch {
        e => {
            if is_no_device(e) {
                refused += 1
            }
        }
    }
    render_on(dh, target, flat(w.size, 0x405060), mut atlases) catch {
        e => {
            if is_no_device(e) {
                refused += 1
            }
        }
    }
    let _ = read_on(dh, target) catch {
        e => {
            if is_no_device(e) {
                refused += 1
            }
            []
        }
    }
    if target_refused(dh) {
        refused += 1
    }
    t.equal(refused, 4)
}
