import std/ui/geometry
import std/ui/scene

struct Attachment {
    image: VkImage
    view: VkImageView
    width: i64
    height: i64
}

fn write_instances(s: *DeviceState, f: *Frame, pushed: scene.Scene, textures: i64, width: i64, height: i64) ! Error {
    let sc = scene.grouped(pushed)
    let runs = scene.batches(sc)
    check_textures(runs, textures)?
    let plan = plan_paths(sc, runs, width, height)
    if plan.batches.len > 0 {
        ensure_intermediate(s, width, height)?
    }
    f.drawing = Drawing { runs, plan }
    fill_kind(s.device, f, scene.Kind.Quads, sc.quads)?
    fill_kind(s.device, f, scene.Kind.Shadows, sc.shadows)?
    fill_kind(s.device, f, scene.Kind.Paths, plan.vertices)?
    fill_kind(s.device, f, scene.Kind.Underlines, sc.underlines)?
    fill_kind(s.device, f, scene.Kind.Sprites, sc.sprites)?
    fill_kind(s.device, f, scene.Kind.SubpixelSprites, sc.subpixel_sprites)?
    fill_kind(s.device, f, scene.Kind.PolychromeSprites, sc.polychrome_sprites)?
    fill(s.device, mut f.composite, [f.composite_set], plan.sprites)?
}

fn fill_kind[T](d: Handles, f: *Frame, kind: scene.Kind, items: T[]) ! Error {
    fill(d, mut f.instances[kind.index], f.sets[kind.index], items)?
}

fn fill[T](d: Handles, mut b: Buffer, sets: VkDescriptorSet[], items: T[]) ! Error {
    let needed = items.len * stride_of[T]()
    let grown = ensure_buffer(d, mut b, needed, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT)?
    if grown {
        for set in sets {
            write_instances_binding(d, set, b)
        }
    }
    if items.len == 0 {
        return
    }
    let at: ptr[T] = b.mapped
    let dst = view(at, items.len)
    __memmove(dst, items)
}

fn stride_of[T]() -> i64 {
    let pair: T[] = __make(2)
    let first: ptr = __slice_ptr(pair)
    let second: ptr = __slice_ptr(pair[1..])
    __address(second) - __address(first)
}

fn record_pass(mut pins: Pins, cmd: VkCommandBuffer, s: *DeviceState, f: *Frame, p: Pipelines, a: Attachment, sc: scene.Scene) {
    begin_pass(mut pins, cmd, a, VK_ATTACHMENT_LOAD_OP_CLEAR, sc.background)
    let size = TargetSize { width: f32(a.width), height: f32(a.height) }
    let constants = pins.hold(size)
    vkCmdPushConstants(cmd, s.pipeline_layout, both_stages, 0, 8, constants)
    let text = pins.hold(sc.text)
    vkCmdPushConstants(cmd, s.pipeline_layout, both_stages, 16, 32, text)

    var next_path = 0
    for b in f.drawing.runs {
        if b.kind != scene.Kind.Paths {
            draw_batch(mut pins, cmd, s, p, f, b)
            continue
        }
        let planned = f.drawing.plan.batches[next_path]
        next_path += 1
        if planned.drawn {
            vkCmdEndRendering(cmd)
            record_rasterise(mut pins, cmd, s, p, a, planned, pins.hold(f.sets[b.kind.index][0]))
            begin_pass(mut pins, cmd, a, VK_ATTACHMENT_LOAD_OP_LOAD, sc.background)
            draw_composite(cmd, s, p, pins.hold(f.composite_set), planned)
        }
    }
    vkCmdEndRendering(cmd)
}

fn begin_pass(mut pins: Pins, cmd: VkCommandBuffer, a: Attachment, load: i32, background: geometry.Color) {
    let color = VkClearColorValue { float32_0: background.r, float32_1: background.g, float32_2: background.b, float32_3: background.a }
    let attachment = VkRenderingAttachmentInfo {
        imageView: a.view
        imageLayout: VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
        loadOp: load
        storeOp: VK_ATTACHMENT_STORE_OP_STORE
        clearValue: VkClearValue { color }
    }
    let attachments = pins.hold(attachment)
    let area = VkRect2D { extent: VkExtent2D { width: u32(a.width), height: u32(a.height) } }
    var rendering = VkRenderingInfo { renderArea: area, layerCount: 1, colorAttachmentCount: 1, pColorAttachments: attachments }
    vkCmdBeginRendering(cmd, mut rendering)
    set_viewport(mut pins, cmd, a, area)
}

fn set_viewport(mut pins: Pins, cmd: VkCommandBuffer, a: Attachment, area: VkRect2D) {
    let viewport = VkViewport { width: f32(a.width), height: f32(a.height), maxDepth: 1.0 }
    let viewports = pins.hold(viewport)
    vkCmdSetViewport(cmd, 0, 1, viewports)
    let scissors = pins.hold(area)
    vkCmdSetScissor(cmd, 0, 1, scissors)
}

fn draw_batch(mut pins: Pins, cmd: VkCommandBuffer, s: *DeviceState, p: Pipelines, f: *Frame, b: scene.Batch) {
    vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, p.made[b.kind.index])
    let set = pins.hold(f.sets[b.kind.index][b.texture])
    vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s.pipeline_layout, 0, 1, set, 0, null)
    vkCmdDraw(cmd, 6, u32(b.count), 0, u32(b.first))
}

fn draw_composite(cmd: VkCommandBuffer, s: *DeviceState, p: Pipelines, set: ptr[VkDescriptorSet], planned: PathBatch) {
    vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, p.composite)
    vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s.pipeline_layout, 0, 1, set, 0, null)
    vkCmdDraw(cmd, 6, u32(planned.sprite_count), 0, u32(planned.first_sprite))
}
