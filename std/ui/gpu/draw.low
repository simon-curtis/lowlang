import std/ui/scene

struct Attachment {
    view: VkImageView
    width: i64
    height: i64
}

fn write_instances(s: *DeviceState, f: *Frame, sc: scene.Scene) ! Error {
    fill(s.device, f, scene.Kind.Quads.index, sc.quads)?
    fill(s.device, f, scene.Kind.Shadows.index, sc.shadows)?
    fill(s.device, f, scene.Kind.Underlines.index, sc.underlines)?
    fill(s.device, f, scene.Kind.Sprites.index, sc.sprites)?
    fill(s.device, f, scene.Kind.SubpixelSprites.index, sc.subpixel_sprites)?
    fill(s.device, f, scene.Kind.PolychromeSprites.index, sc.polychrome_sprites)?
}

fn fill[T](d: Handles, f: *Frame, index: i64, items: T[]) ! Error {
    let needed = items.len * stride_of[T]()
    let grown = ensure_buffer(d, mut f.instances[index], needed, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT)?
    if grown {
        write_instances_binding(d, f.sets[index], f.instances[index])
    }
    if items.len == 0 {
        return
    }
    let at: ptr[T] = f.instances[index].mapped
    let dst = view(at, items.len)
    __memmove(dst, items)
}

fn stride_of[T]() -> i64 {
    let pair: T[] = __make(2)
    let first: ptr = __slice_ptr(pair)
    let second: ptr = __slice_ptr(pair[1..])
    __address(second) - __address(first)
}

fn record_pass(mut pins: Pins, cmd: VkCommandBuffer, s: *DeviceState, f: *Frame, p: Pipelines, a: Attachment, sc: scene.Scene) {
    let background = sc.background
    let color = VkClearColorValue { float32_0: background.r, float32_1: background.g, float32_2: background.b, float32_3: background.a }
    let clear = VkClearValue { color }
    let attachment = VkRenderingAttachmentInfo {
        imageView: a.view
        imageLayout: VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
        loadOp: VK_ATTACHMENT_LOAD_OP_CLEAR
        storeOp: VK_ATTACHMENT_STORE_OP_STORE
        clearValue: clear
    }
    let attachments = pins.hold(attachment)
    let extent = VkExtent2D { width: u32(a.width), height: u32(a.height) }
    let area = VkRect2D { extent }
    var rendering = VkRenderingInfo { renderArea: area, layerCount: 1, colorAttachmentCount: 1, pColorAttachments: attachments }
    vkCmdBeginRendering(cmd, mut rendering)

    let viewport = VkViewport { width: f32(a.width), height: f32(a.height), maxDepth: 1.0 }
    let viewports = pins.hold(viewport)
    vkCmdSetViewport(cmd, 0, 1, viewports)
    let scissors = pins.hold(area)
    vkCmdSetScissor(cmd, 0, 1, scissors)
    let size = TargetSize { width: f32(a.width), height: f32(a.height) }
    let constants = pins.hold(size)
    vkCmdPushConstants(cmd, s.pipeline_layout, both_stages, 0, 8, constants)
    let text = pins.hold(sc.text)
    vkCmdPushConstants(cmd, s.pipeline_layout, both_stages, 16, 32, text)

    var bound: ptr[VkDescriptorSet][] = []
    for set in f.sets {
        bound.push(pins.hold(set))
    }
    for b in scene.batches(sc) {
        draw_batch(cmd, s, p, bound, b)
    }
    vkCmdEndRendering(cmd)
}

fn draw_batch(cmd: VkCommandBuffer, s: *DeviceState, p: Pipelines, bound: ptr[VkDescriptorSet][], b: scene.Batch) {
    vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, p.made[b.kind.index])
    vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s.pipeline_layout, 0, 1, bound[b.kind.index], 0, null)
    vkCmdDraw(cmd, 6, u32(b.count), 0, u32(b.first))
}
