struct Pins {
    held: []ptr
    drop {
        for at in held {
            unpin(at)
        }
    }
}

fn new_pins() -> Pins {
    Pins { held: [] }
}

fn hold[T](mut p: Pins, value: T) -> ptr[T] {
    let at: ptr[T] = pin(new(value))
    p.held.push(at)
    at
}

fn hold_all[T](mut p: Pins, values: []T) -> ptr[T] {
    if values.len == 0 {
        return null
    }
    let at: ptr[T] = pin(values)
    p.held.push(at)
    at
}

fn hold_names(mut p: Pins, names: []str) -> ptr {
    if names.len == 0 {
        return null
    }
    var table: []ptr = []
    for name in names {
        var text = bytes(name)
        text.push(0)
        let at: ptr = pin(text)
        p.held.push(at)
        table.push(at)
    }
    let at: ptr = pin(table)
    p.held.push(at)
    at
}
