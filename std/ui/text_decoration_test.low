import std/testing
import std/ui/geometry
import std/ui/platform
import uitext = std/ui/text

fn decorated_lines(view: fn() -> Element, scale: f32) -> geometry.Rect[] {
    let cx = headless(rgb(0x101010))
    let sc = frame(cx, view, window(), scale)
    var bounds: geometry.Rect[] = []
    for q in sc.underlines {
        bounds.push(q.bounds)
    }
    bounds
}

fn test_underline_draws_one_line_below_the_glyphs_across_the_text(t: *testing.T) {
    let view = fn() -> Element { text("Hello").underline().text_color(rgb(0x00ff00)) }
    let cx = headless(rgb(0x101010))
    let sc = frame(cx, view, window(), 1.0)
    testing.equal(t, sc.underlines.len, 1)
    let line = sc.underlines[0]
    testing.equal(t, line.color, rgb(0x00ff00))
    let first = sc.sprites[0].bounds
    testing.is_true(t, line.bounds.y >= first.y + first.height)
    testing.is_true(t, line.bounds.height >= 1.0)
    testing.equal(t, line.bounds.x, 0.0)
    let last = sc.sprites[sc.sprites.len - 1].bounds
    testing.is_true(t, line.bounds.x + line.bounds.width >= last.x + last.width - 1.0)
}

fn test_strikethrough_crosses_the_glyphs_above_the_baseline(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    let sc = frame(cx, fn() -> Element { text("Hello").text_size(32.0).strikethrough() }, window(), 1.0)
    testing.equal(t, sc.underlines.len, 1)
    let glyph = sc.sprites[0].bounds
    let line = sc.underlines[0].bounds
    testing.is_true(t, line.y > glyph.y)
    testing.is_true(t, line.y + line.height < glyph.y + glyph.height)
}

fn test_a_decoration_is_at_least_one_device_pixel_thick_at_any_scale(t: *testing.T) {
    for scale in [f32(0.5), 1.0, 2.0] {
        let lines = decorated_lines(fn() -> Element { text("Hello").underline() }, scale)
        testing.equal(t, lines.len, 1)
        testing.is_true(t, lines[0].height >= 1.0)
    }
}

fn test_a_decoration_is_inherited_until_a_child_sets_its_own(t: *testing.T) {
    let view = fn() -> Element {
        div().column().underline().children() {
            text("one"),
            text("two").text_decoration(uitext.Decoration.None),
            text("three").strikethrough()
        }
    }
    let lines = decorated_lines(view, 1.0)
    testing.equal(t, lines.len, 2)
    testing.is_true(t, lines[1].y > lines[0].y)
}

fn test_spaces_at_the_end_of_a_line_are_not_underlined(t: *testing.T) {
    let bare = decorated_lines(fn() -> Element { text("Hi").underline() }, 1.0)
    let trailing = decorated_lines(fn() -> Element { text("Hi   ").underline() }, 1.0)
    testing.equal(t, trailing[0].width, bare[0].width)
}

fn masked_view(value: Signal[str]) -> fn() -> Element {
    fn() -> Element {
        field(get(value)).id("secret").masked().width(150.0).height(30.0).on_change(fn(s: str) { set(value, s) })
    }
}

fn typed(cx: Context, s: str) {
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn control_chord(cx: Context, letter: str) {
    dispatch(cx, platform.Event.Key(platform.KeyEvent {
        key: platform.Key.Character(letter)
        modifiers: platform.Modifiers { control: true }
    }))
}

fn secret_field(cx: Context, initial: str) -> Signal[str] {
    let value = signal(cx, initial)
    shot(cx, masked_view(value))
    click(cx, 10.0, 10.0)
    value
}

fn field_sprites(cx: Context, shown: str, masked: bool) -> geometry.Rect[] {
    let view = fn() -> Element {
        let f = field(shown).width(150.0).height(30.0)
        if masked { f.masked() } else { f }
    }
    var bounds: geometry.Rect[] = []
    for sp in shot(cx, view).sprites {
        bounds.push(sp.bounds)
    }
    bounds
}

fn same_sprites(t: *testing.T, got: geometry.Rect[], want: geometry.Rect[]) {
    testing.is_true(t, want.len > 0)
    testing.equal(t, got.len, want.len)
    for i in 0..want.len {
        same_rect(t, got[i], want[i])
    }
}

fn test_a_masked_field_draws_one_bullet_per_grapheme_and_keeps_the_text(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = secret_field(cx, "")
    typed(cx, "pa")
    typed(cx, "ss")
    testing.equal(t, get(value), "pass")
    same_sprites(t, field_sprites(cx, "pass", true), field_sprites(cx, "\u2022\u2022\u2022\u2022", false))
    same_sprites(t, field_sprites(cx, "e\u0301x", true), field_sprites(cx, "\u2022\u2022", false))
}

fn test_a_masked_field_refuses_copy_and_cut_and_still_selects_and_deletes(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = secret_field(cx, "hunter2")
    control_chord(cx, "a")
    control_chord(cx, "c")
    testing.equal(t, clipboard(cx) ?? "", "")
    control_chord(cx, "x")
    testing.equal(t, clipboard(cx) ?? "", "")
    testing.equal(t, get(value), "hunter2")
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Backspace) }))
    testing.equal(t, get(value), "")
}

fn test_control_backspace_in_a_masked_field_removes_one_grapheme_and_not_a_word(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = secret_field(cx, "one two")
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.End) }))
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Backspace), modifiers: platform.Modifiers { control: true } }))
    testing.equal(t, get(value), "one tw")
}

fn test_changing_the_text_smoothing_makes_a_frame_due(t: *testing.T) {
    let cx = headless(rgb(0x101010))
    shot(cx, fn() -> Element { text("Hi") })
    testing.is_false(t, frame_due(cx))
    set_text_smoothing(cx, TextSmoothing.Greyscale)
    testing.is_true(t, frame_due(cx))
}
