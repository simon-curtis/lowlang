import std/io
import std/net
import std/os
import std/sys

const owner_only = 384
const probe_millis = 100

fn endpoint_path(pid: i64) -> str {
    let runtime = os.env("XDG_RUNTIME_DIR") ?? ""
    if runtime != "" {
        return "{runtime}/low-ui-{pid}.sock"
    }
    "/tmp/low-ui-{sys.uid()}-{pid}.sock"
}

fn listen_endpoint(path: str) -> Endpoint ! io.Error {
    listen_for(path, sys.uid())?
}

fn listen_for(path: str, owner: i64) -> Endpoint ! io.Error {
    let listener = bind_owner_only(path)?
    Endpoint {
        accept: fn() -> io.Stream ! io.Error { accept_from(listener, owner)? }
        close: fn() { net.close_listener_on(listener) }
    }
}

fn bind_owner_only(path: str) -> net.ListenerHandle ! io.Error {
    using var listener = listen_replacing_stale(path)?
    sys.chmod(path, owner_only)?
    net.detach_listener(mut listener)
}

fn listen_replacing_stale(path: str) -> net.Listener ! io.Error {
    net.listen_unix(path) catch {
        AddrInUse => {
            if answers(path) {
                fail AddrInUse
            }
            sys.unlink(path)?
            net.listen_unix(path)?
        }
        e => fail e
    }
}

fn answers(path: str) -> bool {
    using c = net.connect_unix_within(path, probe_millis) catch {
        e => return false
    }
    true
}

fn accept_from(listener: net.ListenerHandle, owner: i64) -> io.Stream ! io.Error {
    for {
        let c = net.accept_handle(listener)?
        if is_owned_by(c, owner) {
            return net.stream_on(c)
        }
        net.close_on(c)
    }
}

fn is_owned_by(c: net.ConnHandle, owner: i64) -> bool {
    let peer = net.peer_credentials_on(c) catch {
        e => return false
    }
    peer.uid == owner
}

fn dial(path: str) -> io.Stream ! io.Error {
    using var c = net.connect_unix(path)?
    net.stream_on(net.detach(mut c))
}
