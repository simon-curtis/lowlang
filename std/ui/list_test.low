import std/testing
import std/ui/geometry
import std/ui/platform

fn row_item(ix: i64, px: f32) -> Element {
    let shade = u32(ix % 200) * 0x010101
    div().height(px).shrink(0.0).background(rgb(shade))
}

fn counting_rows(items: Signal[i64], peak: Signal[i64], px: f32) -> fn(i64, i64) -> Element[] {
    fn(start: i64, end: i64) -> Element[] {
        set(items, get(items) + end - start)
        if end > get(peak) {
            set(peak, end)
        }
        var out: Element[] = []
        for ix in start..end {
            out.push(row_item(ix, px))
        }
        out
    }
}

fn clicking_rows(clicked: Signal[i64]) -> fn(i64, i64) -> Element[] {
    fn(start: i64, end: i64) -> Element[] {
        var out: Element[] = []
        for ix in start..end {
            out.push(clickable_row(ix, clicked))
        }
        out
    }
}

fn clickable_row(ix: i64, clicked: Signal[i64]) -> Element {
    row_item(ix, 20.0).on_click(fn(e: ClickEvent) { set(clicked, ix) })
}

fn focus_rows(start: i64, end: i64) -> Element[] {
    var out: Element[] = []
    for ix in start..end {
        let lit = fn(v: Visual) -> Visual { v.with_background(rgb(0xff0000)) }
        out.push(row_item(ix, 20.0).focusable().focus(lit))
    }
    out
}

fn varied_height(ix: i64) -> f32 {
    10.0 + f32(ix % 3) * 10.0
}

fn varied_rows(asked: Signal[i64]) -> fn(i64) -> Element {
    fn(ix: i64) -> Element {
        set(asked, get(asked) + 1)
        row_item(ix, varied_height(ix))
    }
}

fn even_rows(asked: Signal[i64], px: f32) -> fn(i64) -> Element {
    fn(ix: i64) -> Element {
        set(asked, get(asked) + 1)
        row_item(ix, px)
    }
}

fn uniform_view(count: i64, rows: fn(i64, i64) -> Element[]) -> fn() -> Element {
    fn() -> Element { uniform_list("u", count, rows).size(200.0, 100.0) }
}

fn tracked_view(count: i64, handle: UniformListScrollHandle) -> fn() -> Element {
    let rows = fn(start: i64, end: i64) -> Element[] {
        var out: Element[] = []
        for ix in start..end {
            out.push(row_item(ix, 20.0))
        }
        out
    }
    fn() -> Element { uniform_list("u", count, rows).size(200.0, 100.0).track_scroll(handle) }
}

fn list_view(state: ListState, render: fn(i64) -> Element) -> fn() -> Element {
    fn() -> Element { list(state, render).size(200.0, 100.0) }
}

fn wheel_at(cx: Context, y: f32, dy: f32) {
    dispatch(cx, platform.Event.PointerMoved(10.0, y))
    dispatch(cx, platform.Event.Scrolled(0.0, dy))
}

fn click_at(cx: Context, y: f32) {
    dispatch(cx, platform.Event.PointerMoved(10.0, y))
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: y }))
    dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: y }))
}

fn test_a_uniform_list_renders_only_the_rows_in_view(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let items = signal(cx, 0)
    let peak = signal(cx, 0)
    let view = uniform_view(1000, counting_rows(items, peak, 20.0))
    let sc = shot(cx, view)
    testing.equal(t, sc.quads.len, 5)
    testing.equal(t, sc.quads[0].bounds.y, 0.0)
    testing.equal(t, sc.quads[4].bounds.y, 80.0)
    testing.equal(t, sc.quads[4].bounds.height, 20.0)
    testing.equal(t, sc.quads[1].bounds.width, 200.0)
    same_rect(t, sc.quads[0].clip, geometry.rect(0.0, 0.0, 200.0, 100.0))
    testing.equal(t, get(items), 6)
    testing.equal(t, get(peak), 5)
}

fn test_a_uniform_list_of_a_million_items_asks_for_a_small_range(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let items = signal(cx, 0)
    let peak = signal(cx, 0)
    let view = uniform_view(1000000, counting_rows(items, peak, 10.0))
    let sc = shot(cx, view)
    testing.equal(t, sc.quads.len, 10)
    testing.is_true(t, get(items) <= 20)
    testing.equal(t, get(peak), 10)
    scroll_to(cx, "u", geometry.point(0.0, 5000000.0))
    let moved = shot(cx, view)
    testing.equal(t, moved.quads.len, 10)
    testing.equal(t, get(peak), 500010)
    testing.is_true(t, get(items) <= 40)
    wheel_at(cx, 10.0, 100000000.0)
    let end = shot(cx, view)
    testing.equal(t, scroll_offset(cx, "u").y, 9999900.0)
    testing.equal(t, end.quads.len, 10)
    testing.equal(t, get(peak), 1000000)
    testing.is_true(t, get(items) <= 60)
}

fn test_the_visible_range_follows_scroll_to_and_the_wheel(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let handle = uniform_list_scroll_handle(cx)
    let view = tracked_view(100, handle)
    shot(cx, view)
    testing.equal(t, visible_range(handle).start, 0)
    testing.equal(t, visible_range(handle).end, 5)
    testing.equal(t, item_height(handle), 20.0)
    testing.is_true(t, is_scrollable(handle))
    scroll_to(cx, "u", geometry.point(0.0, 50.0))
    let sc = shot(cx, view)
    testing.equal(t, visible_range(handle).start, 2)
    testing.equal(t, visible_range(handle).end, 8)
    testing.equal(t, sc.quads.len, 6)
    testing.equal(t, sc.quads[0].bounds.y, -10.0)
    testing.equal(t, sc.quads[5].bounds.y, 90.0)
    wheel_at(cx, 50.0, 30.0)
    testing.equal(t, scroll_offset(cx, "u").y, 80.0)
    shot(cx, view)
    testing.equal(t, visible_range(handle).start, 4)
    testing.equal(t, visible_range(handle).end, 9)
    testing.equal(t, logical_scroll_top_index(handle), 4)
    wheel_at(cx, 50.0, 100000.0)
    shot(cx, view)
    testing.equal(t, scroll_offset(cx, "u").y, 1900.0)
    testing.equal(t, visible_range(handle).end, 100)
}

fn test_a_short_uniform_list_does_not_scroll(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let handle = uniform_list_scroll_handle(cx)
    let view = tracked_view(3, handle)
    let sc = shot(cx, view)
    testing.equal(t, sc.quads.len, 3)
    testing.is_false(t, is_scrollable(handle))
    wheel_at(cx, 50.0, 30.0)
    testing.equal(t, scroll_offset(cx, "u").y, 0.0)
}

fn test_an_empty_uniform_list_draws_nothing(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let items = signal(cx, 0)
    let peak = signal(cx, 0)
    let sc = shot(cx, uniform_view(0, counting_rows(items, peak, 20.0)))
    testing.equal(t, sc.quads.len, 0)
    testing.equal(t, get(items), 0)
}

fn scrolled_to(strategy: ScrollStrategy, index: i64) -> f32 {
    let cx = headless(rgb(0xffffff))
    let handle = uniform_list_scroll_handle(cx)
    let view = tracked_view(100, handle)
    shot(cx, view)
    scroll_to_item(handle, index, strategy)
    shot(cx, view)
    scroll_offset(cx, "u").y
}

fn test_scroll_to_item_places_the_item_by_strategy(t: *testing.T) {
    testing.equal(t, scrolled_to(ScrollStrategy.Top, 10), 200.0)
    testing.equal(t, scrolled_to(ScrollStrategy.Center, 10), 160.0)
    testing.equal(t, scrolled_to(ScrollStrategy.Bottom, 10), 120.0)
}

fn test_scroll_to_item_stays_within_the_content(t: *testing.T) {
    testing.equal(t, scrolled_to(ScrollStrategy.Top, 99), 1900.0)
    testing.equal(t, scrolled_to(ScrollStrategy.Center, 99), 1900.0)
    testing.equal(t, scrolled_to(ScrollStrategy.Bottom, 99), 1900.0)
    testing.equal(t, scrolled_to(ScrollStrategy.Top, 0), 0.0)
    testing.equal(t, scrolled_to(ScrollStrategy.Center, 1), 0.0)
}

fn test_scroll_to_item_leaves_an_item_that_is_fully_in_view(t: *testing.T) {
    testing.equal(t, scrolled_to(ScrollStrategy.Top, 3), 0.0)
    testing.equal(t, scrolled_to(ScrollStrategy.Center, 4), 0.0)
    testing.equal(t, scrolled_to(ScrollStrategy.Bottom, 0), 0.0)
}

fn test_scroll_to_item_moves_a_partly_hidden_item_by_strategy(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let handle = uniform_list_scroll_handle(cx)
    let view = tracked_view(100, handle)
    scroll_to(cx, "u", geometry.point(0.0, 10.0))
    shot(cx, view)
    scroll_to_item(handle, 0, ScrollStrategy.Top)
    shot(cx, view)
    testing.equal(t, scroll_offset(cx, "u").y, 0.0)
    scroll_to_item(handle, 5, ScrollStrategy.Bottom)
    shot(cx, view)
    testing.equal(t, scroll_offset(cx, "u").y, 20.0)
}

fn test_the_strict_and_offset_forms_of_scroll_to_item(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let handle = uniform_list_scroll_handle(cx)
    let view = tracked_view(100, handle)
    shot(cx, view)
    scroll_to_item_strict(handle, 3, ScrollStrategy.Top)
    shot(cx, view)
    testing.equal(t, scroll_offset(cx, "u").y, 60.0)
    scroll_to_item_with_offset(handle, 10, ScrollStrategy.Top, 2)
    shot(cx, view)
    testing.equal(t, scroll_offset(cx, "u").y, 160.0)
    scroll_to_item_strict_with_offset(handle, 10, ScrollStrategy.Bottom, 1)
    shot(cx, view)
    testing.equal(t, scroll_offset(cx, "u").y, 140.0)
}

fn test_a_pending_scroll_is_the_logical_scroll_top_until_the_next_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let handle = uniform_list_scroll_handle(cx)
    let view = tracked_view(100, handle)
    shot(cx, view)
    scroll_to_item(handle, 40, ScrollStrategy.Top)
    testing.is_true(t, frame_due(cx))
    testing.equal(t, logical_scroll_top_index(handle), 40)
    shot(cx, view)
    testing.equal(t, logical_scroll_top_index(handle), 40)
}

fn test_a_click_after_scrolling_reaches_the_row_under_the_pointer(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicked = signal(cx, -1)
    let view = uniform_view(1000, clicking_rows(clicked))
    shot(cx, view)
    click_at(cx, 30.0)
    testing.equal(t, get(clicked), 1)
    wheel_at(cx, 10.0, 50.0)
    shot(cx, view)
    click_at(cx, 30.0)
    testing.equal(t, get(clicked), 4)
    click_at(cx, 95.0)
    testing.equal(t, get(clicked), 7)
}

fn test_a_row_keeps_its_focus_style_as_it_moves_in_the_range(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { uniform_list("u", 100, focus_rows).size(200.0, 100.0) }
    shot(cx, view)
    click_at(cx, 30.0)
    testing.equal(t, focused(cx), "u/1")
    wheel_at(cx, 10.0, 20.0)
    let sc = shot(cx, view)
    testing.equal(t, sc.quads[0].background.r, 1.0)
    testing.equal(t, sc.quads[0].background.g, 0.0)
    testing.is_true(t, sc.quads[1].background.r < 0.1)
    wheel_at(cx, 10.0, 100.0)
    shot(cx, view)
    testing.equal(t, focused(cx), "u/1")
}

fn test_a_list_renders_and_measures_only_the_rows_it_needs(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let state = list_state(cx, 100000, ListAlignment.Top, 40.0)
    let view = list_view(state, even_rows(asked, 20.0))
    let sc = shot(cx, view)
    testing.equal(t, sc.quads.len, 5)
    testing.equal(t, get(asked), 7)
    testing.is_true(t, bounds_for_item(state, 6) != none)
    testing.is_true(t, bounds_for_item(state, 7) == none)
    shot(cx, view)
    testing.equal(t, get(asked), 12)
    testing.equal(t, item_count(state), 100000)
}

fn test_a_list_positions_rows_of_different_heights(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let state = list_state(cx, 1000, ListAlignment.Top, 0.0)
    let sc = shot(cx, list_view(state, varied_rows(asked)))
    testing.equal(t, sc.quads.len, 6)
    testing.equal(t, sc.quads[0].bounds.y, 0.0)
    testing.equal(t, sc.quads[1].bounds.y, 10.0)
    testing.equal(t, sc.quads[1].bounds.height, 20.0)
    testing.equal(t, sc.quads[2].bounds.y, 30.0)
    testing.equal(t, sc.quads[3].bounds.y, 60.0)
    testing.equal(t, sc.quads[4].bounds.y, 70.0)
    testing.equal(t, sc.quads[5].bounds.y, 90.0)
    testing.equal(t, sc.quads[5].bounds.height, 30.0)
    testing.equal(t, get(asked), 6)
}

fn test_the_wheel_moves_a_list_by_an_item_and_an_offset(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let state = list_state(cx, 1000, ListAlignment.Top, 60.0)
    let view = list_view(state, even_rows(asked, 20.0))
    shot(cx, view)
    wheel_at(cx, 50.0, 30.0)
    testing.equal(t, logical_scroll_top(state).item_ix, 1)
    testing.equal(t, logical_scroll_top(state).offset_in_item, 10.0)
    let sc = shot(cx, view)
    testing.equal(t, sc.quads[0].bounds.y, -10.0)
    testing.equal(t, sc.quads.len, 6)
    wheel_at(cx, 50.0, -500.0)
    testing.equal(t, logical_scroll_top(state).item_ix, 0)
    testing.equal(t, logical_scroll_top(state).offset_in_item, 0.0)
}

fn test_a_list_counts_unmeasured_rows_as_zero_high(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let state = list_state(cx, 1000, ListAlignment.Top, 0.0)
    let view = list_view(state, even_rows(asked, 20.0))
    shot(cx, view)
    wheel_at(cx, 50.0, 30.0)
    testing.equal(t, logical_scroll_top(state).item_ix, 0)
    testing.equal(t, logical_scroll_top(state).offset_in_item, 0.0)
}

fn test_a_click_on_a_scrolled_list_reaches_the_row_under_the_pointer(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicked = signal(cx, -1)
    let state = list_state(cx, 1000, ListAlignment.Top, 40.0)
    let render = fn(ix: i64) -> Element { clickable_row(ix, clicked) }
    let view = list_view(state, render)
    shot(cx, view)
    wheel_at(cx, 10.0, 50.0)
    shot(cx, view)
    click_at(cx, 30.0)
    testing.equal(t, get(clicked), 3)
}

fn test_scroll_to_reveal_item_brings_a_row_fully_into_view(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let state = list_state(cx, 1000, ListAlignment.Top, 30.0)
    let view = list_view(state, varied_rows(asked))
    shot(cx, view)
    scroll_to_reveal_item(state, 5)
    testing.is_true(t, frame_due(cx))
    shot(cx, view)
    let low = bounds_for_item(state, 5) ?? geometry.Rect {}
    testing.equal(t, low.y, 70.0)
    testing.equal(t, low.height, 30.0)
    testing.equal(t, logical_scroll_top(state).item_ix, 1)
    scroll_to_reveal_item(state, 0)
    shot(cx, view)
    let high = bounds_for_item(state, 0) ?? geometry.Rect {}
    testing.equal(t, high.y, 0.0)
    testing.equal(t, logical_scroll_top(state).item_ix, 0)
}

fn test_list_scroll_to_and_by_set_the_position(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let state = list_state(cx, 1000, ListAlignment.Top, 0.0)
    let view = list_view(state, varied_rows(asked))
    shot(cx, view)
    list_scroll_to(state, ListOffset { item_ix: 40, offset_in_item: 5.0 })
    let sc = shot(cx, view)
    testing.equal(t, logical_scroll_top(state).item_ix, 40)
    testing.equal(t, sc.quads[0].bounds.y, -5.0)
    list_scroll_by(state, 12.0)
    testing.equal(t, logical_scroll_top(state).item_ix, 40)
    testing.equal(t, logical_scroll_top(state).offset_in_item, 17.0)
    list_scroll_to(state, ListOffset { item_ix: 5000, offset_in_item: 3.0 })
    testing.equal(t, logical_scroll_top(state).item_ix, 1000)
    testing.equal(t, logical_scroll_top(state).offset_in_item, 0.0)
}

fn test_a_bottom_aligned_list_rests_on_its_last_row(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let state = list_state(cx, 10, ListAlignment.Bottom, 0.0)
    let sc = shot(cx, list_view(state, even_rows(asked, 20.0)))
    testing.equal(t, sc.quads.len, 5)
    testing.equal(t, sc.quads[0].bounds.y, 0.0)
    testing.equal(t, sc.quads[4].bounds.y, 80.0)
    testing.equal(t, get(asked), 5)
}

fn test_a_bottom_aligned_list_shorter_than_its_viewport_sits_at_the_bottom(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let bottom = list_state(cx, 3, ListAlignment.Bottom, 0.0)
    let at_bottom = shot(cx, list_view(bottom, even_rows(asked, 20.0)))
    testing.equal(t, at_bottom.quads.len, 3)
    testing.equal(t, at_bottom.quads[0].bounds.y, 40.0)
    testing.equal(t, at_bottom.quads[2].bounds.y, 80.0)
    let top = list_state(cx, 3, ListAlignment.Top, 0.0)
    let at_top = shot(cx, list_view(top, even_rows(asked, 20.0)))
    testing.equal(t, at_top.quads[0].bounds.y, 0.0)
    testing.equal(t, at_top.quads[2].bounds.y, 40.0)
}

fn test_a_bottom_aligned_list_leaves_the_end_when_scrolled_up_and_returns(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let state = list_state(cx, 10, ListAlignment.Bottom, 60.0)
    let view = list_view(state, even_rows(asked, 20.0))
    shot(cx, view)
    testing.equal(t, logical_scroll_top(state).item_ix, 10)
    wheel_at(cx, 50.0, -30.0)
    shot(cx, view)
    testing.equal(t, logical_scroll_top(state).item_ix, 3)
    testing.equal(t, logical_scroll_top(state).offset_in_item, 10.0)
    wheel_at(cx, 50.0, 100000.0)
    testing.equal(t, logical_scroll_top(state).item_ix, 10)
    let sc = shot(cx, view)
    testing.equal(t, sc.quads[4].bounds.y, 80.0)
}

fn test_splice_and_reset_drop_heights_and_keep_the_position_on_its_item(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let state = list_state(cx, 10, ListAlignment.Top, 0.0)
    list_scroll_to(state, ListOffset { item_ix: 6, offset_in_item: 5.0 })
    list_splice(state, 0, 2, 5)
    testing.equal(t, item_count(state), 13)
    testing.equal(t, logical_scroll_top(state).item_ix, 9)
    testing.equal(t, logical_scroll_top(state).offset_in_item, 5.0)
    list_splice(state, 8, 10, 1)
    testing.equal(t, item_count(state), 12)
    testing.equal(t, logical_scroll_top(state).item_ix, 8)
    testing.equal(t, logical_scroll_top(state).offset_in_item, 0.0)
    list_splice(state, 11, 12, 0)
    testing.equal(t, item_count(state), 11)
    list_reset(state, 4)
    testing.equal(t, item_count(state), 4)
    testing.equal(t, logical_scroll_top(state).item_ix, 0)
}

fn test_reset_forgets_measured_heights_and_drops_wheel_events_until_the_next_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let state = list_state(cx, 1000, ListAlignment.Top, 40.0)
    let view = list_view(state, even_rows(asked, 20.0))
    shot(cx, view)
    let before = get(asked)
    list_reset(state, 1000)
    wheel_at(cx, 50.0, 30.0)
    testing.equal(t, logical_scroll_top(state).item_ix, 0)
    testing.is_true(t, bounds_for_item(state, 6) == none)
    shot(cx, view)
    testing.equal(t, get(asked), before + 7)
    wheel_at(cx, 50.0, 30.0)
    testing.equal(t, logical_scroll_top(state).item_ix, 1)
}

fn test_a_row_of_a_list_keeps_its_key_by_index(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let state = list_state(cx, 100, ListAlignment.Top, 40.0)
    let render = fn(ix: i64) -> Element { row_item(ix, 20.0).focusable() }
    let view = fn() -> Element { list(state, render).id("feed").size(200.0, 100.0) }
    shot(cx, view)
    click_at(cx, 50.0)
    testing.equal(t, focused(cx), "feed/2")
}

fn test_a_uniform_list_inside_a_padded_box_places_its_rows_in_the_content_box(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicked = signal(cx, -1)
    let rows = clicking_rows(clicked)
    let view = fn() -> Element {
        div().column().size(200.0, 100.0).children() {
            div().height(30.0).shrink(0.0).background(rgb(0x0000ff)),
            uniform_list("u", 100, rows).height(70.0).shrink(0.0).padding(10.0),
        }
    }
    let sc = shot(cx, view)
    testing.equal(t, sc.quads.len, 4)
    same_rect(t, sc.quads[1].bounds, geometry.rect(10.0, 40.0, 180.0, 20.0))
    same_rect(t, sc.quads[3].bounds, geometry.rect(10.0, 80.0, 180.0, 20.0))
    same_rect(t, sc.quads[1].clip, geometry.rect(10.0, 40.0, 180.0, 50.0))
    click_at(cx, 35.0)
    testing.equal(t, get(clicked), -1)
    click_at(cx, 45.0)
    testing.equal(t, get(clicked), 0)
    wheel_at(cx, 50.0, 40.0)
    shot(cx, view)
    click_at(cx, 45.0)
    testing.equal(t, get(clicked), 2)
}

fn test_wheel_events_between_frames_add_up_on_a_list(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let state = list_state(cx, 1000, ListAlignment.Top, 90.0)
    let view = list_view(state, even_rows(asked, 30.0))
    shot(cx, view)
    wheel_at(cx, 50.0, 10.0)
    dispatch(cx, platform.Event.Scrolled(0.0, 10.0))
    testing.equal(t, logical_scroll_top(state).item_ix, 0)
    testing.equal(t, logical_scroll_top(state).offset_in_item, 20.0)
    dispatch(cx, platform.Event.Scrolled(0.0, 20.0))
    testing.equal(t, logical_scroll_top(state).item_ix, 1)
    testing.equal(t, logical_scroll_top(state).offset_in_item, 10.0)
}

fn test_a_list_lays_its_rows_out_again_when_its_width_changes(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let asked = signal(cx, 0)
    let wide = signal[f32](cx, 200.0)
    let state = list_state(cx, 1000, ListAlignment.Top, 40.0)
    let render = even_rows(asked, 20.0)
    let view = fn() -> Element { list(state, render).size(get(wide), 100.0) }
    shot(cx, view)
    shot(cx, view)
    testing.equal(t, get(asked), 12)
    set(wide, 150.0)
    shot(cx, view)
    testing.equal(t, get(asked), 19)
}

fn test_rows_take_the_text_style_of_the_list_and_its_parents(t: *testing.T) {
    let rows = fn(start: i64, end: i64) -> Element[] {
        var out: Element[] = []
        for ix in start..end {
            out.push(text("Row"))
        }
        out
    }
    let cx = headless(rgb(0xffffff))
    let small = uniform_list_scroll_handle(cx)
    let large = uniform_list_scroll_handle(cx)
    let small_view = fn() -> Element {
        div().text_size(10.0).child(uniform_list("s", 20, rows).size(200.0, 100.0).track_scroll(small))
    }
    let large_view = fn() -> Element {
        div().text_size(32.0).child(uniform_list("l", 20, rows).size(200.0, 100.0).track_scroll(large))
    }
    shot(cx, small_view)
    shot(cx, large_view)
    testing.is_true(t, item_height(small) > 0.0)
    testing.is_true(t, item_height(large) > item_height(small))
}

fn test_a_uniform_list_measures_its_first_item_at_the_content_width(t: *testing.T) {
    let rows = fn(start: i64, end: i64) -> Element[] {
        var out: Element[] = []
        for ix in start..end {
            out.push(text("alpha beta gamma delta epsilon"))
        }
        out
    }
    let cx = headless(rgb(0xffffff))
    let narrow = uniform_list_scroll_handle(cx)
    let wide = uniform_list_scroll_handle(cx)
    let narrow_view = fn() -> Element { uniform_list("n", 50, rows).size(60.0, 100.0).track_scroll(narrow) }
    let wide_view = fn() -> Element { uniform_list("w", 50, rows).size(600.0, 100.0).track_scroll(wide) }
    shot(cx, narrow_view)
    shot(cx, wide_view)
    testing.is_true(t, item_height(narrow) > item_height(wide))
    testing.is_true(t, item_height(wide) > 0.0)
}

fn painted_rows(shade: u32) -> fn(i64, i64) -> Element[] {
    fn(start: i64, end: i64) -> Element[] {
        var out: Element[] = []
        for _ in start..end {
            out.push(div().height(20.0).shrink(0.0).background(rgb(shade)))
        }
        out
    }
}

fn test_children_of_a_list_element_are_skipped_by_paint_as_by_prepaint(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicked = signal(cx, -1)
    let kid = div().on_click(fn(e: ClickEvent) { set(clicked, 99) })
    let uniform = fn() -> Element { uniform_list("u", 1000, clicking_rows(clicked)).size(200.0, 100.0).child(kid) }
    let first = shot(cx, uniform)
    let second = shot(cx, uniform)
    testing.equal(t, first.quads.len, 5)
    testing.equal(t, second.quads.len, 5)
    click_at(cx, 30.0)
    testing.equal(t, get(clicked), 1)
    let asked = signal(cx, 0)
    let state = list_state(cx, 100, ListAlignment.Top, 0.0)
    let variable = fn() -> Element { list(state, even_rows(asked, 20.0)).size(200.0, 100.0).child(kid) }
    shot(cx, variable)
    let again = shot(cx, variable)
    testing.equal(t, again.quads.len, 5)
}

fn test_two_lists_with_one_id_draw_their_own_rows(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let red = painted_rows(0xff0000)
    let blue = painted_rows(0x0000ff)
    let view = fn() -> Element {
        div().column().child(uniform_list("u", 100, red).size(200.0, 50.0)).child(uniform_list("u", 100, blue).size(200.0, 50.0))
    }
    let sc = shot(cx, view)
    testing.equal(t, sc.quads.len, 6)
    for i in 0..3 {
        testing.equal(t, sc.quads[i].background.r, 1.0)
        testing.equal(t, sc.quads[i].background.b, 0.0)
        testing.equal(t, sc.quads[i + 3].background.r, 0.0)
        testing.equal(t, sc.quads[i + 3].background.b, 1.0)
    }
}

fn test_a_row_with_a_negative_height_counts_as_zero_high(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let state = list_state(cx, 10, ListAlignment.Top, 0.0)
    let render = fn(ix: i64) -> Element { div().height(20.0).margin_top(-30.0) }
    let view = list_view(state, render)
    shot(cx, view)
    shot(cx, view)
    shot(cx, view)
    let first = bounds_for_item(state, 0) ?? geometry.Rect {}
    let last = bounds_for_item(state, 9) ?? geometry.Rect { y: -1.0 }
    testing.equal(t, first.height, 0.0)
    testing.equal(t, last.height, 0.0)
    testing.equal(t, last.y, first.y)
}

fn test_scroll_to_item_clamps_the_stored_offset_before_it_applies(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let count = signal(cx, 100)
    let handle = uniform_list_scroll_handle(cx)
    let rows = painted_rows(0x00ff00)
    let view = fn() -> Element { uniform_list("u", get(count), rows).size(200.0, 100.0).track_scroll(handle) }
    shot(cx, view)
    scroll_to(cx, "u", geometry.point(0.0, 1900.0))
    shot(cx, view)
    testing.equal(t, scroll_offset(cx, "u").y, 1900.0)
    set(count, 50)
    scroll_to_item(handle, 47, ScrollStrategy.Bottom)
    shot(cx, view)
    testing.equal(t, scroll_offset(cx, "u").y, 900.0)
}

fn test_an_empty_uniform_list_leaves_its_offset_alone(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let count = signal(cx, 100)
    let rows = painted_rows(0x00ff00)
    let view = fn() -> Element { uniform_list("u", get(count), rows).size(200.0, 100.0) }
    shot(cx, view)
    scroll_to(cx, "u", geometry.point(0.0, 300.0))
    shot(cx, view)
    set(count, 0)
    let empty = shot(cx, view)
    testing.equal(t, empty.quads.len, 0)
    testing.equal(t, scroll_offset(cx, "u").y, 300.0)
    set(count, 100)
    shot(cx, view)
    testing.equal(t, scroll_offset(cx, "u").y, 300.0)
}
