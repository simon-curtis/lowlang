import std/ui/geometry
import std/ui/layout
import std/ui/platform
import std/ui/scene

enum LayerKind {
    Menu
    Popover
    Dialog
}

struct Layer {
    id: str
    kind: LayerKind
    owner: str = ""
    at: geometry.Point? = none
    items: fn() -> MenuItem[]
    content: fn() -> Element
    restore: str = ""
    backdrop: geometry.Color = geometry.rgba(0x00000066)
    closed: fn() = no_notice
    path: i64[] = []
    panels: geometry.Rect[] = []
    root: i64 = -1
    focus_inside: bool = false
}

struct LayerDraw {
    tree: layout.Tree
    laid: Laid
    walk: Walk
}

/// Returns `e` opening the menu `items` returns at the pointer when the secondary button is pressed over it, as a context menu: the menu is drawn over the window, kept inside it, takes the keyboard until it closes, and closes on Escape, on a press outside it and when an item is chosen, giving focus back to the element that had it. `id` names the menu for `overlay_open` and `close_overlay`.
pub fn context_menu(e: Element, id: str, items: fn() -> MenuItem[]) -> Element {
    listen(e, ContextMenu(id, items))
}

/// Returns `e` opening the menu `items` returns under it when it is clicked, or above it where there is no room below, and closing it when it is clicked again, as a dropdown menu. It closes as a context menu does.
pub fn dropdown_menu(e: Element, id: str, items: fn() -> MenuItem[]) -> Element {
    listen(e, DropdownMenu(id, items))
}

/// Returns `e` showing the element `content` returns, drawn as given, under it when it is clicked, or above it where there is no room below, and hiding it when it is clicked again, on Escape or on a press outside both.
pub fn popover(e: Element, id: str, content: fn() -> Element) -> Element {
    listen(e, Popover(id, content))
}

/// Opens the modal dialog `id` showing the element `content` returns, centred and drawn as given, over a translucent backdrop that covers the window and stops the pointer reaching what is under it. Focus moves to the first focusable element in the dialog, Tab and Shift+Tab keep it inside, and Escape or `close_overlay` closes it and gives focus back to the element that had it.
pub fn open_dialog(cx: Context, id: str, content: fn() -> Element) {
    open_dialog_with(cx, id, geometry.rgba(0x00000066), content, no_notice)
}

/// Opens the modal dialog `id` as `open_dialog` does with `backdrop` as the colour that covers the window, and runs `closed` once the dialog has closed, by Escape, `close_overlay` on it or on a layer under it, or the window dropping it, after focus has been given back and as a closure posted to the context, as `post` posts one. Opening `id` again while it is open closes the first dialog and notifies it.
pub fn open_dialog_with(cx: Context, id: str, backdrop: geometry.Color, content: fn() -> Element, closed: fn()) {
    let st = cx.state
    open_layer(st, Layer { id, kind: Dialog, items: no_items, content, restore: st.focus, backdrop, closed })
}

/// Closes the menu, popover or dialog `id` and those opened over it, giving focus back to the element that had it before it opened.
pub fn close_overlay(cx: Context, id: str) {
    let at = layer_index(cx.state, id)
    if at >= 0 {
        close_layer(cx.state, at)
    }
}

/// Returns `true` while the menu, popover or dialog `id` is open.
pub fn overlay_open(cx: Context, id: str) -> bool {
    layer_index(cx.state, id) >= 0
}

fn no_items() -> MenuItem[] {
    []
}

fn no_content() -> Element {
    div()
}

fn no_notice() {
}

fn layer_index(st: *State, id: str) -> i64 {
    for i, l in st.layers {
        if l.id == id {
            return i
        }
    }
    -1
}

fn open_layer(st: *State, l: Layer) {
    let existing = layer_index(st, l.id)
    if existing >= 0 {
        close_layer(st, existing)
    }
    st.layers.push(l)
    if l.kind == Menu {
        move_focus(st, l.id)
    }
    st.dirty = true
}

fn close_layer(st: *State, at: i64) {
    let restore = st.layers[at].restore
    let dropped = st.layers[at..]
    st.layers = st.layers[0..at]
    move_focus(st, restore)
    st.dirty = true
    var i = dropped.len - 1
    for i >= 0 {
        if dropped[i].kind == Dialog {
            post(Handle { posts: st.posts, wake: st.wake }, dropped[i].closed)
        }
        i -= 1
    }
}

fn toggle_layer(st: *State, l: Layer) {
    let at = layer_index(st, l.id)
    if at >= 0 {
        close_layer(st, at)
        return
    }
    open_layer(st, l)
}

fn open_context_menu(st: *State) -> bool {
    var i = topmost(st)
    for i >= 0 {
        let h = st.hitboxes[i]
        for l in h.element.listeners {
            match l {
                ContextMenu(id, items) => {
                    open_layer(st, Layer { id, kind: Menu, owner: h.key, at: st.pointer, items, content: no_content, restore: st.focus, path: [-1] })
                    return true
                }
                _ => {}
            }
        }
        i = ancestor_hit(st, h.parent)
    }
    false
}

fn run_trigger(st: *State, at: i64, l: Listener) -> bool {
    let h = st.hitboxes[at]
    match l {
        DropdownMenu(id, items) => {
            toggle_layer(st, Layer { id, kind: Menu, owner: h.key, items, content: no_content, restore: st.focus, path: [-1] })
            true
        }
        Popover(id, content) => {
            toggle_layer(st, Layer { id, kind: Popover, owner: h.key, items: no_items, content, restore: st.focus })
            true
        }
        _ => false
    }
}

fn inside_layer(st: *State, l: Layer) -> bool {
    for r in l.panels {
        if geometry.contains(r, st.pointer) {
            return true
        }
    }
    let at_pointer = match l.at {
        some(p) => true
        none => false
    }
    if l.owner == "" || at_pointer {
        return false
    }
    let owner = st.rects[l.owner] ?? return false
    geometry.contains(owner, st.pointer)
}

fn close_outside(st: *State) {
    var i = st.layers.len - 1
    for i >= 0 {
        let l = st.layers[i]
        if l.kind == Dialog || inside_layer(st, l) {
            return
        }
        close_layer(st, i)
        i -= 1
    }
}

fn layer_key(st: *State, k: platform.KeyEvent) -> bool {
    if st.layers.len == 0 {
        return false
    }
    let top = st.layers.len - 1
    let l = st.layers[top]
    if l.kind == Menu {
        return menu_key(st, top, k)
    }
    if is_named(k.key, platform.NamedKey.Escape) {
        close_layer(st, top)
        return true
    }
    false
}

fn trap(st: *State) -> i64 {
    var i = st.layers.len - 1
    for i >= 0 {
        if st.layers[i].kind == Dialog {
            return st.layers[i].root
        }
        i -= 1
    }
    -1
}

fn within_trap(st: *State, at: i64, root: i64) -> bool {
    if root < 0 {
        return true
    }
    var i = at
    for i >= 0 {
        if i == root {
            return true
        }
        i = st.hitboxes[i].parent
    }
    false
}

fn layer_element(st: *State, at: i64, level: i64) -> Element {
    let l = st.layers[at]
    match l.kind {
        Menu => menu_panel(st, l, level)
        Popover => div().id(l.id).occlude().child(l.content())
        Dialog => dialog_backdrop(st, l)
    }
}

fn dialog_backdrop(st: *State, l: Layer) -> Element {
    div().id(l.id).occlude().size(st.viewport.width, st.viewport.height).background(l.backdrop).items_center().justify_center().child(l.content())
}

fn prepaint_layers(st: *State, scale: f32) {
    st.layer_draws = []
    var i = 0
    for i < st.layers.len {
        if prepaint_layer(st, i, scale) {
            i += 1
        } else {
            close_layer(st, i)
        }
    }
}

fn prepaint_layer(st: *State, at: i64, scale: f32) -> bool {
    let l = st.layers[at]
    var parent = st.root_hitbox
    if l.owner != "" {
        parent = find(st, l.owner)
        if parent < 0 {
            return false
        }
    }
    st.layers[at].panels = []
    st.layers[at].root = st.hitboxes.len
    let levels = if l.kind == Menu { l.path.len } else { 1 }
    for level in 0..levels {
        place_panel(st, at, level, parent, scale)
    }
    if l.kind == Dialog && !st.layers[at].focus_inside {
        st.layers[at].focus_inside = true
        focus_first_inside(st, st.layers[at].root, l.id)
    }
    true
}

fn place_panel(st: *State, at: i64, level: i64, parent: i64, scale: f32) {
    let e = layer_element(st, at, level)
    var t = layout.tree(scale)
    let laid = build(st, mut t, e, default_text_style(st))
    let room = if st.layers[at].kind == Dialog { geometry.size(st.viewport.width, st.viewport.height) } else { geometry.size(layout.unbounded, layout.unbounded) }
    layout.compute(mut t, laid.node, room)
    let r = layout.rect(t, laid.node)
    let size = geometry.size(r.width, r.height)
    var shift = geometry.Point {}
    if st.layers[at].kind != Dialog {
        shift = panel_shift(st, at, level, r, size)
    }
    let walk = Walk { parent, clip: st.viewport, shift, text: default_text_style(st), scale }
    st.layers[at].panels.push(geometry.offset(r, shift.x, shift.y))
    prepaint(st, t, laid, panel_key(st.layers[at].id, level), walk)
    prepaint_deferred(st)
    st.layer_draws.push(LayerDraw { tree: t, laid, walk })
}

fn panel_shift(st: *State, at: i64, level: i64, r: geometry.Rect, size: geometry.Size) -> geometry.Point {
    let l = st.layers[at]
    if level > 0 {
        let row = known_rect(st, item_key(l.id, level - 1, l.path[level - 1])) ?? return geometry.Point {}
        return beside(row, r, size, st.viewport)
    }
    match l.at {
        some(p) => placed(Anchoring { position: p, fit: SnapToWindowWithMargin, margin: geometry.edges(8.0) }, p, r, size, st.viewport)
        none => {
            let owner = known_rect(st, l.owner) ?? return geometry.Point {}
            below(owner, r, size, st.viewport)
        }
    }
}

fn known_rect(st: *State, key: str) -> geometry.Rect? {
    st.rects[key] ?? st.last_rects[key]
}

fn below(owner: geometry.Rect, r: geometry.Rect, size: geometry.Size, limits: geometry.Rect) -> geometry.Point {
    var x = owner.x
    if x + size.width > limits.x + limits.width && owner.x + owner.width - size.width >= limits.x {
        x = owner.x + owner.width - size.width
    }
    var y = owner.y + owner.height
    if y + size.height > limits.y + limits.height && owner.y - size.height >= limits.y {
        y = owner.y - size.height
    }
    kept_inside(geometry.rect(x, y, size.width, size.height), r, limits)
}

fn beside(row: geometry.Rect, r: geometry.Rect, size: geometry.Size, limits: geometry.Rect) -> geometry.Point {
    var x = row.x + row.width
    if x + size.width > limits.x + limits.width && row.x - size.width >= limits.x {
        x = row.x - size.width
    }
    var y = row.y
    if y + size.height > limits.y + limits.height && row.y + row.height - size.height >= limits.y {
        y = row.y + row.height - size.height
    }
    kept_inside(geometry.rect(x, y, size.width, size.height), r, limits)
}

fn kept_inside(wanted: geometry.Rect, r: geometry.Rect, limits: geometry.Rect) -> geometry.Point {
    placed(Anchoring { position: geometry.point(wanted.x, wanted.y), fit: SnapToWindow }, geometry.point(wanted.x, wanted.y), r, geometry.size(wanted.width, wanted.height), limits)
}

fn panel_key(id: str, level: i64) -> str {
    if level == 0 { id } else { "{id}>{level}" }
}

fn item_key(id: str, level: i64, index: i64) -> str {
    "{panel_key(id, level)}/{index}"
}

fn focus_first_inside(st: *State, root: i64, id: str) {
    for i in root..st.hitboxes.len {
        if st.hitboxes[i].element.focusable && within_trap(st, i, root) {
            move_focus(st, st.hitboxes[i].key)
            return
        }
    }
    move_focus(st, id)
}

fn paint_layers(st: *State, mut sc: scene.Scene, scale: f32) {
    for d in st.layer_draws {
        paint(st, d.tree, mut sc, d.laid, d.walk, default_text_style(st), scale)
        paint_deferred(st, mut sc, scale)
    }
}
