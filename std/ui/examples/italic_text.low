import std/ui
import std/ui/geometry
import uitext = std/ui/text

fn glyph_width(view: fn() -> ui.Element) -> f32 {
    let cx = ui.headless(geometry.rgb(0xffffff))
    let scene = ui.frame(cx, view, geometry.Size { width: 200.0, height: 100.0 }, 1.0)
    scene.sprites[0].bounds.width
}

fn upright() -> ui.Element {
    ui.text("l").text_size(32.0)
}

fn slanted() -> ui.Element {
    ui.div().italic().child(ui.text("l").text_size(32.0))
}

fn restored() -> ui.Element {
    ui.div().italic().child(ui.text("l").text_size(32.0).font_style(uitext.FontStyle.Normal))
}

/// Draws one letter upright, in an italic parent and in an italic parent with its own upright style, and prints whether the sheared glyph is wider.
fn main() {
    let normal = glyph_width(upright)
    print("italic wider: {glyph_width(slanted) > normal}")
    print("own style wins: {glyph_width(restored) == normal}")
}
