import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene
import uitext = std/ui/text

const edge: f32 = 24.0

struct Made {
    side: i64 = 0
    picture: uitext.Image? = none
}

fn stripes(side: i64) -> u8[] {
    var pixels: u8[] = []
    for y in 0..side {
        for x in 0..side {
            let v: u8 = if (x + y) % 4 < 2 { 255 } else { 0 }
            pixels.push(v)
            pixels.push(v)
            pixels.push(v)
            pixels.push(255)
        }
    }
    pixels
}

fn report(cx: ui.Context, sc: scene.Scene) {
    let drawn = sc.polychrome_sprites[0].bounds
    print("scale {ui.scale(cx)}: drawn {drawn.width}x{drawn.height} device pixels")
}

/// Draws a picture of stripes in a box of 24 logical pixels and makes the picture again whenever `scale` changes, at the box's size in device pixels, so each picture pixel lands on one device pixel. The window's scale arrives in a `Resized` event; a headless frame sets it too.
fn main() {
    let cx = ui.headless(geometry.rgb(0xffffff))
    let made = new(Made {})
    let view = fn() -> ui.Element {
        let side = i64(floor(edge * ui.scale(cx) + 0.5))
        if made.side != side {
            made.side = side
            made.picture = ui.add_image(cx, side, side, stripes(side))
            print("made a {side}x{side} picture")
        }
        match made.picture {
            some(p) => ui.image(p).size(edge, edge)
            none => ui.div()
        }
    }
    print("scale before a frame: {ui.scale(cx)}")
    ui.dispatch(cx, platform.Event.Resized(200.0, 120.0, 2.0))
    report(cx, ui.frame(cx, view, ui.window_size(cx), ui.scale(cx)))
    report(cx, ui.frame(cx, view, ui.window_size(cx), 1.5))
}
