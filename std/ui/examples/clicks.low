import std/ui
import std/ui/geometry
import std/ui/platform

fn row_view(log: ui.Signal[str]) -> fn() -> ui.Element {
    let opened = fn(e: ui.MouseDownEvent) { ui.set(log, "menu at {e.position.x},{e.position.y}") }
    let clicked = fn(e: ui.ClickEvent) {
        let what = if e.click_count == 2 { "open" } else { "select" }
        ui.set(log, "{what} (click {e.click_count})")
    }
    let closed = fn(e: ui.MouseDownEvent) { ui.set(log, "tab closed") }
    fn() -> ui.Element {
        ui.div().id("row").size(200.0, 24.0)
            .on_click(clicked)
            .on_mouse_down(platform.Button.Right, opened)
            .on_mouse_down(platform.Button.Middle, closed)
    }
}

fn press(cx: ui.Context, b: platform.Button, clicks: i64) {
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: b, x: 30.0, y: 12.0, clicks }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: b, x: 30.0, y: 12.0, clicks }))
}

/// Builds a list row that selects on a click, opens on a double click, shows a menu on a right press and closes on a middle press, then sends it each press and prints what the row did.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let log = ui.signal(cx, "")
    ui.frame(cx, row_view(log), geometry.size(320.0, 100.0), 1.0)

    press(cx, platform.Button.Left, 1)
    print(ui.get(log))
    press(cx, platform.Button.Left, 2)
    print(ui.get(log))
    press(cx, platform.Button.Right, 1)
    print(ui.get(log))
    press(cx, platform.Button.Middle, 1)
    print(ui.get(log))
}
