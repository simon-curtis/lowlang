import std/ui
import std/ui/platform

fn focus_note(cx: ui.Context) -> fn(bool) {
    fn(focused: bool) { print("  focus {focused}, title {ui.window_title(cx)}") }
}

/// Renames a window as the active document changes, reads its focus state through `on_focus_changed`, and asks for its native handles, which a headless window does not have.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    ui.on_focus_changed(cx, focus_note(cx))
    print("title: {ui.window_title(cx)}")
    ui.set_title(cx, "notes.txt - Editor")
    print("title: {ui.window_title(cx)}")
    ui.dispatch(cx, platform.Event.FocusChanged(true))
    ui.set_title(cx, "todo.txt - Editor")
    ui.dispatch(cx, platform.Event.FocusChanged(false))
    print("focused: {ui.window_focused(cx)}")
    print("native handles: {ui.native_window(cx) != none}")
}
