import std/ui
import std/ui/geometry

fn form(saved: ui.Signal[i64], name: ui.Signal[str]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        ui.div().column().size(240.0, 120.0).children() {
            ui.field(ui.get(name)).id("name").width(160.0),
            ui.div().size(60.0, 24.0).on_click(fn(e: ui.ClickEvent) { ui.set(saved, ui.get(saved) + 1) }).child(ui.text("Save")),
            ui.div().size(24.0, 24.0).label("Close").role(ui.Role.Button).on_click(fn(e: ui.ClickEvent) {}),
        }
    }
}

fn find(cx: ui.Context, label: str) -> ui.ElementInfo? {
    for e in ui.elements(cx) {
        if e.label == label && e.visible {
            return e
        }
    }
    none
}

/// Draws a small form with no window, lists the elements the frame drew, finds the button labelled "Save" without knowing where it is, clicks it and prints how many times it saved.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let saved = ui.signal(cx, 0)
    let name = ui.signal(cx, "Ada")
    let view = form(saved, name)
    let _ = ui.frame(cx, view, geometry.size(320.0, 200.0), 1.0)

    for e in ui.elements(cx) {
        print("{e.key} {e.role} label={e.label} text={e.text} visible={e.visible}")
    }
    let save = find(cx, "Save") ?? return
    print("Save is at {save.bounds.x},{save.bounds.y}")
    let _ = ui.click_element(cx, save.key)
    print("saved {ui.get(saved)}")
    let top = ui.element_at(cx, geometry.point(save.bounds.x + 1.0, save.bounds.y + 1.0)) ?? "none"
    print("topmost at the Save button: {top}")
}
