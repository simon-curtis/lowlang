import std/ui
import std/ui/geometry
import std/ui/platform

fn count() -> i64 {
    10
}

fn line(i: i64) -> str {
    "line {i}"
}

fn edit(e: ui.TextEdit) {}

fn hidden(i: i64) -> bool {
    i >= 3 && i <= 6
}

fn hidden_before(n: i64) -> i64 {
    match n {
        <= 3 => 0
        <= 7 => n - 3
        _ => 4
    }
}

fn press(cx: ui.Context, key: platform.NamedKey) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(key) }))
}

/// Hides lines 3 to 6 of a ten line text area, moves the caret down from line 2 to show that it skips them, and prints the row each document line is drawn in, which a gutter numbers from.
fn main() {
    let cx = ui.headless(geometry.rgb(0xffffff))
    ui.bind_keys(cx, ui.text_area_bindings())
    var source = ui.line_source(count, line, edit)
    source.line_hidden = hidden
    source.hidden_before = hidden_before
    let view = fn() -> ui.Element { ui.text_area(source).id("editor").size(240.0, 156.0) }
    let size = geometry.size(320.0, 240.0)
    let _ = ui.frame(cx, view, size, 1.0)
    ui.set_focus(cx, "editor")
    let at = ui.TextPosition { line: 2, column: 0 }
    ui.set_text_area_selection(cx, "editor", at, at)
    let _ = ui.frame(cx, view, size, 1.0)
    press(cx, platform.NamedKey.Down)
    print("caret: line {ui.text_area_selection(cx, "editor").caret.line}")
    for n in 0..10 {
        let row = ui.text_area_visible_row(cx, "editor", n)
        match row {
            some(r) => print("line {n}: row {r}")
            none => print("line {n}: not drawn")
        }
    }
}
