import std/ui
import std/ui/geometry
import std/ui/platform

fn greeter(name: ui.Signal[str], greeting: ui.Signal[str]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        ui.column(ui.div()).padding(16.0).gap(8.0).children() {
            ui.field(ui.get(name)).id("name").on_change(fn(s: str) { ui.set(name, s) }),
            ui.div().id("greet").width(120.0).height(30.0).cursor(platform.Cursor.Pointer).on_click(fn(c: ui.ClickEvent) { ui.set(greeting, "Hello, {ui.get(name)}") }).child(ui.text("Greet")),
            ui.text(ui.get(greeting)),
        }
    }
}

fn shape(c: platform.Cursor) -> str {
    match c {
        Arrow => "arrow"
        Text => "text"
        Pointer => "pointer"
        _ => "other"
    }
}

fn type_text(cx: ui.Context, letters: str[]) {
    for letter in letters {
        ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(letter), text: letter }))
    }
}

fn point_at(cx: ui.Context, x: f32, y: f32) -> str {
    ui.dispatch(cx, platform.Event.PointerMoved(x, y))
    shape(ui.pointer_cursor(cx))
}

/// Builds a form with a text field and a button, then types a name, clicks the button and prints what each step changed, with no window and no GPU.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let name = ui.signal(cx, "")
    let greeting = ui.signal(cx, "")
    let render = greeter(name, greeting)
    let size = geometry.size(320.0, 200.0)

    let _ = ui.frame(cx, render, size, 1.0)
    ui.set_focus(cx, "name")
    type_text(cx, ["L", "o", "w"])
    print("name: {ui.get(name)}")
    let _ = ui.frame(cx, render, size, 1.0)
    print("focused: {ui.focused(cx)}")
    print("caret reported: {ui.text_input(cx) != none}")

    print("over the field: {point_at(cx, 100.0, 30.0)}")
    print("over the button: {point_at(cx, 60.0, 70.0)}")
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: 60.0, y: 70.0 }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: 60.0, y: 70.0 }))
    print("greeting: {ui.get(greeting)}")
    print("over the margin: {point_at(cx, 300.0, 190.0)}")
}
