import std/ui
import std/ui/geometry
import std/ui/platform

fn caption_button(area: platform.WindowControlArea, label: str) -> ui.Element {
    ui.div().width(46.0).height(32.0).window_control_area(area).child(ui.text(label))
}

fn title_bar(cx: ui.Context, menu_clicks: ui.Signal[i64]) -> ui.Element {
    let shade: u32 = if ui.is_maximized(cx) { 0xdddddd } else { 0xf3f3f3 }
    let opened = fn(e: ui.ClickEvent) { ui.update(menu_clicks, fn(n: i64) -> i64 { n + 1 }) }
    ui.div().row().height(32.0).background(ui.rgb(shade)).window_control_area(platform.WindowControlArea.Drag).children() {
        ui.div().width(60.0).height(32.0).on_click(opened).child(ui.text("Menu")),
        ui.div().grow(1.0).height(32.0),
        caption_button(platform.WindowControlArea.Min, "-"),
        caption_button(platform.WindowControlArea.Max, "+"),
        caption_button(platform.WindowControlArea.Close, "x"),
    }
}

fn area_name(cx: ui.Context, x: f32, y: f32) -> str {
    let found = ui.window_control_area_at(cx, x, y)
    match found {
        some(area) => match area {
            Drag => "drag"
            Close => "close"
            Max => "max"
            Min => "min"
        }
        none => "content"
    }
}

fn report(cx: ui.Context, what: str, x: f32, y: f32) {
    print("{what}: {area_name(cx, x, y)}")
}

/// Draws a title bar of a Menu button, a free stretch and three caption buttons marked with `window_control_area`, then asks which area lies under points and shows the maximised state follow the window's events and `toggle_maximize`, with no window and no GPU.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let menu_clicks = ui.signal(cx, 0)
    let render = fn() -> ui.Element { title_bar(cx, menu_clicks) }
    let size = geometry.size(400.0, 200.0)

    let _ = ui.frame(cx, render, size, 1.0)
    report(cx, "free stretch", 200.0, 16.0)
    report(cx, "menu button", 30.0, 16.0)
    report(cx, "minimise", 270.0, 16.0)
    report(cx, "maximise", 320.0, 16.0)
    report(cx, "close", 370.0, 16.0)
    report(cx, "below the bar", 200.0, 100.0)

    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: 30.0, y: 16.0 }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: 30.0, y: 16.0 }))
    print("menu clicks: {ui.get(menu_clicks)}")

    print("maximised: {ui.is_maximized(cx)}")
    ui.dispatch(cx, platform.Event.Maximized(true))
    print("maximised: {ui.is_maximized(cx)}, frame due: {ui.frame_due(cx)}")
    let _ = ui.frame(cx, render, size, 1.0)
    ui.toggle_maximize(cx)
    print("toggled: {ui.is_maximized(cx)}, frame due: {ui.frame_due(cx)}")
}
