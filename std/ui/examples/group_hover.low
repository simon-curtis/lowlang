import std/ui
import std/ui/geometry
import std/ui/platform

fn reveal(v: ui.Visual) -> ui.Visual {
    v.with_visible(true)
}

fn tint(v: ui.Visual) -> ui.Visual {
    v.with_background(ui.rgb(0xdddddd))
}

fn entry(removed: ui.Signal[i64]) -> ui.Element {
    let delete = ui.div().size(40.0, 24.0).background(ui.rgb(0xcc3333)).invisible().group_hover("row", reveal).on_click(fn(e: ui.ClickEvent) { ui.update(removed, fn(n: i64) -> i64 { n + 1 }) })
    ui.div().group("row").row().size(240.0, 32.0).items_center().justify_between().background(ui.rgb(0xf4f4f4)).hover(tint).children() {
        ui.text("Entry"),
        delete,
    }
}

fn drawn(cx: ui.Context, removed: ui.Signal[i64]) -> bool {
    let render = fn() -> ui.Element { entry(removed) }
    let sc = ui.frame(cx, render, geometry.size(320.0, 200.0), 1.0)
    sc.quads.len == 2
}

/// Builds a row whose delete button is hidden until the pointer is over the row, moves the pointer and prints whether the button is drawn and whether a click on it runs.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let removed = ui.signal(cx, 0)

    print("pointer off the row: button drawn {drawn(cx, removed)}")
    ui.dispatch(cx, platform.Event.PointerMoved(20.0, 16.0))
    print("pointer over the row: button drawn {drawn(cx, removed)}")
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: 220.0, y: 16.0 }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: 220.0, y: 16.0 }))
    print("removed: {ui.get(removed)}")
    ui.dispatch(cx, platform.Event.PointerMoved(300.0, 150.0))
    print("pointer away again: button drawn {drawn(cx, removed)}")
}
