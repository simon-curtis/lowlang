import std/ui
import std/ui/geometry

fn tree() -> ui.Element {
    ui.div().column().children() {
        ui.text("Deleted.txt").strikethrough().text_color(geometry.rgb(0x888888)),
        ui.text("Docs").underline().text_color(geometry.rgb(0x2255cc))
    }
}

/// Draws a struck-through and an underlined text and prints the line each one gets, then changes the text smoothing and prints whether a frame is due.
fn main() {
    let cx = ui.headless(geometry.rgb(0xffffff))
    let scene = ui.frame(cx, tree, geometry.Size { width: 200.0, height: 100.0 }, 1.0)
    for q in scene.underlines {
        let b = q.bounds
        print("line at y {b.y}, {b.width} wide, {b.height} thick")
    }
    print("due before: {ui.frame_due(cx)}")
    ui.set_text_smoothing(cx, ui.TextSmoothing.Greyscale)
    print("due after: {ui.frame_due(cx)}")
}
