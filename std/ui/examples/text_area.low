import std/text
import std/ui
import std/ui/geometry
import std/ui/platform

fn apply_edit(doc: ui.Signal[str[]], edit: ui.TextEdit) {
    let lines = ui.get(doc)
    let head = lines[edit.start.line][..edit.start.column]
    let tail = lines[edit.end.line][edit.end.column..]
    let joined = "{head}{edit.text}{tail}"
    var next: str[] = []
    for i in 0..edit.start.line {
        next.push(lines[i])
    }
    for part in text.split_str(joined, "\n") {
        next.push(part)
    }
    let resume = edit.end.line + 1
    for i in resume..lines.len {
        next.push(lines[i])
    }
    ui.set(doc, next)
}

fn document(doc: ui.Signal[str[]]) -> ui.LineSource {
    let count = fn() -> i64 { ui.get(doc).len }
    let line = fn(i: i64) -> str { ui.get(doc)[i] }
    let edit = fn(e: ui.TextEdit) { apply_edit(doc, e) }
    ui.line_source(count, line, edit)
}

fn press(cx: ui.Context, key: platform.NamedKey, control: bool) {
    let modifiers = platform.Modifiers { control: control }
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(key), modifiers: modifiers }))
}

fn type_text(cx: ui.Context, s: str) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn shortcut(cx: ui.Context, letter: str) {
    let modifiers = platform.Modifiers { control: true }
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(letter), modifiers: modifiers }))
}

fn show(cx: ui.Context, step: str, doc: ui.Signal[str[]]) {
    let caret = ui.text_area_selection(cx, "editor").caret
    let joined = text.join(ui.get(doc), "|")
    print("{step}: {joined} at {caret.line}:{caret.column}")
}

/// Edits a document held in a signal through a text area with no window: types, splits a line with Enter, deletes with Backspace, replaces a selection, then undoes twice and redoes, printing the lines joined with `|` and the caret after each step.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    ui.bind_keys(cx, ui.text_area_bindings())
    let doc = ui.signal(cx, ["alpha", "omega"])
    let source = document(doc)
    let view = fn() -> ui.Element { ui.text_area(source).id("editor").size(240.0, 104.0) }
    let size = geometry.size(320.0, 240.0)
    let _ = ui.frame(cx, view, size, 1.0)
    ui.set_focus(cx, "editor")
    let _ = ui.frame(cx, view, size, 1.0)
    show(cx, "start", doc)
    press(cx, platform.NamedKey.Down, false)
    press(cx, platform.NamedKey.Left, false)
    press(cx, platform.NamedKey.Enter, false)
    type_text(cx, "  ")
    type_text(cx, "beta")
    show(cx, "typed", doc)
    press(cx, platform.NamedKey.Up, false)
    press(cx, platform.NamedKey.End, false)
    press(cx, platform.NamedKey.Backspace, false)
    show(cx, "backspace", doc)
    shortcut(cx, "a")
    type_text(cx, "x")
    show(cx, "overwrite", doc)
    shortcut(cx, "z")
    show(cx, "undo", doc)
    shortcut(cx, "z")
    show(cx, "undo", doc)
    shortcut(cx, "y")
    show(cx, "redo", doc)
}
