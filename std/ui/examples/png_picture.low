import std/image
import std/ui
import std/ui/geometry

fn two_pixels() -> u8[] {
    let source = image.create(2, 1, Rgba8)
    image.set(source, 0, 0, image.Rgba { r: 255, g: 0, b: 0, a: 255 })
    image.set(source, 1, 0, image.Rgba { r: 0, g: 0, b: 255, a: 128 })
    image.encode_png(source)
}

/// Encodes a two-pixel PNG, adds it to a headless context with `add_png`, draws it in an `image` element and prints its size and the number of pictures in the frame.
fn main() {
    let cx = ui.headless(geometry.rgb(0xffffff))
    let picture = ui.add_png(cx, two_pixels()) catch {
        e => {
            print("add_png failed: {e}")
            return
        }
    }
    print("picture {picture.width}x{picture.height}")
    let view = fn() -> ui.Element { ui.image(picture).size(40.0, 20.0) }
    let scene = ui.frame(cx, view, geometry.Size { width: 100.0, height: 100.0 }, 1.0)
    print("pictures drawn: {scene.polychrome_sprites.len}")
}
