import std/ui
import std/ui/geometry

fn describe(why: ui.CloseReason) -> str {
    match why {
        Requested => "requested"
        Failed(e) => "failed"
    }
}

fn report(name: str) -> fn(ui.CloseReason) {
    fn(why: ui.CloseReason) { print("{name} closed: {describe(why)}") }
}

fn tree(name: str, count: ui.Signal[i64]) -> fn() -> ui.Element {
    fn() -> ui.Element { ui.div().padding(16.0).child(ui.text("{name} {ui.get(count)}")) }
}

fn open_tool(cx: ui.Context, name: str, owner: ui.Window, count: ui.Signal[i64]) -> ui.Window {
    let options = ui.WindowOptions { title: name, owner: some(owner), placement: ui.Placement.CentreOnOwner, closed: report(name) }
    ui.open_window(cx, options, tree(name, count)) catch {
        e => panic("cannot open the {name} window")
    }
}

/// Opens a settings window and a palette it owns beside the main window, with no system window and no GPU. A signal set from one window makes every window due, and closing the settings window closes the palette first, running each window's closed callback.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let count = ui.signal(cx, 0)
    let main = ui.main_window(cx)
    let settings = open_tool(cx, "settings", main, count)
    let palette = open_tool(cx, "palette", settings, count)
    let size = geometry.size(240.0, 80.0)
    let settings_cx = ui.window_context(settings)
    let palette_cx = ui.window_context(palette)
    ui.frame(cx, tree("main", count), size, 1.0)
    ui.frame(settings_cx, tree("settings", count), size, 1.0)
    ui.frame(palette_cx, tree("palette", count), size, 1.0)
    print("open: main {ui.is_open(main)} settings {ui.is_open(settings)} palette {ui.is_open(palette)}")
    print("due: main {ui.frame_due(cx)} settings {ui.frame_due(settings_cx)} palette {ui.frame_due(palette_cx)}")

    ui.set(count, 1)
    print("due: main {ui.frame_due(cx)} settings {ui.frame_due(settings_cx)} palette {ui.frame_due(palette_cx)}")

    ui.close_window(settings)
    print("open: main {ui.is_open(main)} settings {ui.is_open(settings)} palette {ui.is_open(palette)}")
    ui.close_window(settings)
}
