import std/ui
import std/ui/geometry
import std/ui/platform

fn tree(name: ui.Signal[str]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        ui.field_signal(name).id("name").width(150.0).height(30.0)
    }
}

fn type_text(cx: ui.Context, s: str) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn press_left(cx: ui.Context) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Left) }))
}

/// Binds a field to a signal with `field_signal` and watches its caret with an effect, which runs again each time typing or an arrow key moves it, and not when the pointer moves.
fn main() {
    let cx = ui.headless(geometry.rgb(0xffffff))
    let name = ui.signal(cx, "")
    ui.frame(cx, tree(name), geometry.Size { width: 200.0, height: 100.0 }, 1.0)
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: 10.0 }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: 10.0 }))
    ui.effect(cx, fn() {
        let selection = ui.field_selection(cx, "name")
        print("caret at {selection.caret}")
    })
    type_text(cx, "low")
    press_left(cx)
    ui.dispatch(cx, platform.Event.PointerMoved(150.0, 80.0))
    print("name: {ui.get(name)}")
}
