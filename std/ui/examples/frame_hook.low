import std/ui
import std/ui/geometry

fn form() -> ui.Element {
    ui.div().column().size(200.0, 100.0).children() {
        ui.text("Settings").role(ui.Role.Heading),
        ui.div().id("save").size(80.0, 30.0).on_click(fn(e: ui.ClickEvent) {}).child(ui.text("Save")),
    }
}

/// Adds an `on_frame` handler to a headless context that lists the elements each frame drew with their roles, which is what `enable_accessibility` sends to a screen reader after every frame.
fn main() {
    let cx = ui.headless(geometry.rgb(0xffffff))
    ui.on_frame(cx, fn() {
        for e in ui.elements(cx) {
            print("{e.key} {e.label} {e.role}")
        }
    })
    ui.frame(cx, form, geometry.Size { width: 200.0, height: 100.0 }, 1.0)
}
