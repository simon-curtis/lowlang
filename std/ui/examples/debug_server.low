import std/ui
import std/ui/geometry
import std/ui/platform

fn form(saved: ui.Signal[i64], name: ui.Signal[str]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        ui.div().column().size(240.0, 120.0).children() {
            ui.field(ui.get(name)).id("name").width(160.0).height(24.0).on_change(fn(s: str) { ui.set(name, s) }),
            ui.div().size(60.0, 24.0).on_click(fn(e: ui.ClickEvent) { ui.set(saved, ui.get(saved) + 1) }).child(ui.text("Save")),
        }
    }
}

fn find(elements: ui.ElementInfo[], label: str) -> ui.ElementInfo? {
    for e in elements {
        if e.label == label && e.visible {
            return e
        }
    }
    none
}

fn script(path: str, finished: chan[bool]) {
    using client = ui.debug_connect(path) or panic("connect")
    let save = find(ui.debug_elements(client) or panic("elements"), "Save") ?? panic("no Save button")
    print("found {save.label} at {save.bounds.x},{save.bounds.y}")
    ui.debug_type_into(client, "name", "Dr. ") or panic("type")
    print("name is now {ui.debug_text(client, "name") or panic("text")}")
    ui.debug_click(client, save.key) or panic("click")
    finished <- true
}

/// Serves a headless context's elements to a client on another green thread, which stands for a script in another process: it lists the elements, finds the button labelled "Save", types into the name field and clicks the button, and the program prints what the script saw and how often the button saved.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let saved = ui.signal(cx, 0)
    let name = ui.signal(cx, "Ada")
    let view = form(saved, name)
    using server = ui.serve_debug(cx, ui.DebugOptions {}) or panic("serve_debug")
    let finished = chan[bool](1)
    spawn script(server.path, finished)
    ui.frame(cx, view, geometry.size(320.0, 200.0), 1.0)
    for {
        let done: bool? = select {
            v = <-finished => v
            else => none
        }
        if done != none {
            break
        }
        ui.dispatch(cx, platform.Event.Woken)
        if ui.frame_due(cx) {
            ui.frame(cx, view, geometry.size(320.0, 200.0), 1.0)
        }
        sleep(1)
    }
    print("saved {ui.get(saved)} times as {ui.get(name)}")
}
