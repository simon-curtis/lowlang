import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn window() -> geometry.Size {
    geometry.size(300.0, 200.0)
}

fn chip_preview(name: str) -> ui.Element {
    ui.div().padding(4.0).background(ui.rgb(0xffe08a)).child(ui.text(name))
}

fn board(log: ui.Signal[str]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        let lit = fn(v: ui.Visual) -> ui.Visual { v.with_background(ui.rgb(0xa8e6a1)) }
        let target = ui.div().id("bin").size(100.0, 60.0).background(ui.rgb(0xeeeeee))
            .drag_over("chip", lit)
            .drag_over(ui.external_paths, lit)
            .on_drop("chip", fn(e: ui.DropEvent) { ui.set(log, "dropped {e.drag.value} at {e.position.x} {e.position.y}") })
            .on_drop(ui.external_paths, fn(e: ui.DropEvent) { ui.set(log, "received {e.drag.paths.len} files, the first {e.drag.paths[0]}") })
        let locked = ui.div().id("locked").size(100.0, 60.0).background(ui.rgb(0xeeeeee))
            .can_drop(fn(p: ui.DragPayload) -> bool { false })
            .on_drop("chip", fn(e: ui.DropEvent) { ui.set(log, "locked took {e.drag.value}") })
        let chip = ui.div().id("chip").size(60.0, 30.0).background(ui.rgb(0x4a7bd0))
            .on_drag("chip", "apple", chip_preview)
            .on_click(fn(e: ui.ClickEvent) { ui.set(log, "clicked the chip") })
        ui.div().column().gap(10.0).size(300.0, 200.0).children() {
            chip,
            target,
            locked,
        }
    }
}

fn pointer(cx: ui.Context, x: f32, y: f32) {
    ui.dispatch(cx, platform.Event.PointerMoved(x, y))
}

fn press(cx: ui.Context, x: f32, y: f32) {
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x, y }))
}

fn release(cx: ui.Context, x: f32, y: f32) {
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x, y }))
}

fn bin_lit(sc: scene.Scene) -> bool {
    let lit = ui.rgb(0xa8e6a1)
    for q in sc.quads {
        if q.bounds.y == 40.0 && q.background.g == lit.g {
            return true
        }
    }
    false
}

/// Drags a chip onto two targets, one that accepts it and one whose `can_drop` refuses it, then drops files from another program on the first: a drag starts once the pointer moves more than two pixels from the press, makes no click, shows its preview at the pointer, restyles the target it is over, and ends on release.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let log = ui.signal(cx, "")
    let view = board(log)
    let _ = ui.frame(cx, view, window(), 1.0)

    pointer(cx, 10.0, 10.0)
    press(cx, 10.0, 10.0)
    pointer(cx, 11.0, 10.0)
    print("after a one pixel move: dragging {ui.dragging(cx)}")
    pointer(cx, 14.0, 10.0)
    print("after a four pixel move: dragging {ui.dragging(cx)}")
    let _ = ui.frame(cx, view, window(), 1.0)
    pointer(cx, 150.0, 20.0)
    let drawn = ui.frame(cx, view, window(), 1.0)
    let preview = drawn.quads[drawn.quads.len - 1].bounds
    print("preview at {preview.x} {preview.y}, drawn last")
    print("bin lit while elsewhere: {bin_lit(drawn)}")
    pointer(cx, 30.0, 70.0)
    let over = ui.frame(cx, view, window(), 1.0)
    print("bin lit while over it: {bin_lit(over)}")
    release(cx, 30.0, 70.0)
    print("{ui.get(log)}, dragging {ui.dragging(cx)}")
    print("bin lit after the drop: {bin_lit(ui.frame(cx, view, window(), 1.0))}")

    ui.set(log, "")
    let _ = ui.frame(cx, view, window(), 1.0)
    press(cx, 10.0, 10.0)
    pointer(cx, 20.0, 10.0)
    release(cx, 20.0, 10.0)
    print("released over the chip: \"{ui.get(log)}\", dragging {ui.dragging(cx)}")

    press(cx, 10.0, 10.0)
    pointer(cx, 20.0, 10.0)
    pointer(cx, 30.0, 140.0)
    let _ = ui.frame(cx, view, window(), 1.0)
    release(cx, 30.0, 140.0)
    print("refused drop: \"{ui.get(log)}\", dragging {ui.dragging(cx)}")

    press(cx, 10.0, 10.0)
    release(cx, 10.0, 10.0)
    print("a press and release with no move: \"{ui.get(log)}\"")

    ui.dispatch(cx, platform.Event.FileDragEntered(30.0, 70.0, ["C:\\notes.txt", "C:\\photo.png"]))
    let files = ui.drag_payload(cx) ?? ui.DragPayload { kind: "" }
    print("file drag {files.kind} with {files.paths.len} paths")
    let carrying = ui.frame(cx, view, window(), 1.0)
    print("bin lit by the files: {bin_lit(carrying)}")
    ui.dispatch(cx, platform.Event.FileDropped(30.0, 70.0))
    print("{ui.get(log)}, dragging {ui.dragging(cx)}")
}
