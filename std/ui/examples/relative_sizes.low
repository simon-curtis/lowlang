import std/ui
import std/ui/geometry

fn tag() -> ui.Element {
    ui.div().width(40.0).h_full().background(geometry.rgb(0xff0000))
}

fn tree() -> ui.Element {
    ui.div().column().size(200.0, 100.0).padding(10.0).children() {
        ui.row(ui.div()).height(32.0).items_center().child(tag()),
        ui.div().w_full().height(8.0).background(geometry.rgb(0x00ff00)),
        ui.div().width_percent(50.0).height_percent(25.0).background(geometry.rgb(0x0000ff))
    }
}

/// Sizes children from their parents with `h_full`, `w_full` and the percentage builders, then prints the rectangle each one is drawn in.
fn main() {
    let cx = ui.headless(geometry.rgb(0x101010))
    let scene = ui.frame(cx, tree, geometry.Size { width: 400.0, height: 300.0 }, 1.0)
    for q in scene.quads {
        let b = q.bounds
        print("{b.x},{b.y} {b.width}x{b.height}")
    }
}
