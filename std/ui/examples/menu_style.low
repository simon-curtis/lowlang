import std/ui
import std/ui/geometry
import std/ui/platform

fn tree() -> ui.Element {
    let items = fn() -> ui.MenuItem[] { [ui.menu_entry("Copy", fn() {}), ui.menu_separator(), ui.menu_entry("Paste", fn() {})] }
    ui.div().size(200.0, 100.0).child(ui.div().id("more").size(40.0, 12.0).dropdown_menu("edit", items))
}

fn print_colors(cx: ui.Context) {
    let scene = ui.frame(cx, tree, geometry.Size { width: 200.0, height: 100.0 }, 1.0)
    print("  panel {geometry.rgb_of(scene.quads[0].background):x}, separator {geometry.rgb_of(scene.quads[1].background):x}")
}

/// Opens a dropdown menu, then gives menus a dark `MenuStyle` and prints the colour of the panel before and after.
fn main() {
    let cx = ui.headless(geometry.rgb(0x101010))
    let _ = ui.frame(cx, tree, geometry.Size { width: 200.0, height: 100.0 }, 1.0)
    ui.dispatch(cx, platform.Event.PointerMoved(5.0, 5.0))
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: 5.0, y: 5.0 }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: 5.0, y: 5.0 }))
    print("menu open: {ui.overlay_open(cx, "edit")}")
    print("default style:")
    print_colors(cx)
    ui.set_menu_style(cx, ui.MenuStyle { background: geometry.rgb(0x202020), separator: geometry.rgb(0x505050) })
    print("dark style:")
    print_colors(cx)
}
