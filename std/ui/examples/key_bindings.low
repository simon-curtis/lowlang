import std/ui
import std/ui/geometry
import std/ui/platform

fn bindings() -> ui.KeyBinding[] ! ui.KeymapError {
    [
        ui.key_binding("ctrl-s", "workspace.save", "Workspace")?,
        ui.key_binding("ctrl-k ctrl-o", "workspace.open", "Workspace")?,
        ui.key_binding("ctrl-s", "editor.save_all", "Editor && mode == full")?,
        ui.key_binding("escape", "editor.cancel", "Editor")?,
        ui.key_binding("ctrl-insert", "editor.copy", "Editor")?,
        ui.key_binding("menu", "editor.context_menu", "Editor")?,
        ui.key_binding("shift-menu", "editor.context_menu_alternate", "Editor")?,
    ]
}

fn editor_view(log: ui.Signal[str]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        let editor = ui.div().id("editor").key_context("Editor mode = full").focusable().size(200.0, 100.0)
            .on_action("editor.save_all", fn() { ui.set(log, "saved every file") })
            .on_action("editor.copy", fn() { ui.set(log, "copied") })
            .on_action("editor.context_menu", fn() { ui.set(log, "menu opened") })
            .on_action("editor.context_menu_alternate", fn() { ui.set(log, "alternate menu opened") })
        ui.div().key_context("Workspace").size(320.0, 200.0)
            .on_action("workspace.save", fn() { ui.set(log, "saved") })
            .on_action("workspace.open", fn() { ui.set(log, "opened") })
            .child(editor)
    }
}

fn ctrl(cx: ui.Context, letter: str) {
    ctrl_key(cx, platform.Key.Character(letter))
}

fn ctrl_key(cx: ui.Context, key: platform.Key) {
    press_key(cx, key, platform.Modifiers { control: true })
}

fn press_key(cx: ui.Context, key: platform.Key, modifiers: platform.Modifiers) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key, modifiers }))
}

/// Binds keys in a workspace and an editor inside it, lists the shortcut shown for each action, then sends a shortcut, named keys with and without modifiers, a chord and the same shortcut outside the editor and prints which action ran.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let keymap = bindings() catch {
        e => {
            print("cannot read the keymap")
            return
        }
    }
    ui.bind_keys(cx, keymap)
    let log = ui.signal(cx, "")
    let view = editor_view(log)
    ui.frame(cx, view, geometry.size(320.0, 200.0), 1.0)
    ui.set_focus(cx, "editor")
    for name in ["workspace.save", "workspace.open", "editor.save_all", "editor.cancel", "editor.copy", "editor.context_menu", "editor.context_menu_alternate", "editor.undo"] {
        print("{name}: {ui.keystroke_text_for(cx, name)} available {ui.is_action_available(cx, name)}")
    }
    ctrl(cx, "s")
    print(ui.get(log))
    ctrl_key(cx, platform.Key.Named(platform.NamedKey.Insert))
    print(ui.get(log))
    press_key(cx, platform.Key.Named(platform.NamedKey.Menu), platform.Modifiers {})
    print(ui.get(log))
    press_key(cx, platform.Key.Named(platform.NamedKey.Menu), platform.Modifiers { shift: true })
    print(ui.get(log))
    ctrl(cx, "k")
    print("waiting after {ui.pending_keystrokes(cx).len} keystroke")
    ctrl(cx, "o")
    print(ui.get(log))
    ui.blur(cx)
    ctrl(cx, "s")
    print(ui.get(log))
}
