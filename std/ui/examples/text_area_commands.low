import std/text
import std/ui
import std/ui/geometry
import std/ui/platform

fn apply_edit(doc: ui.Signal[str[]], edit: ui.TextEdit) {
    let lines = ui.get(doc)
    let joined = "{lines[edit.start.line][..edit.start.column]}{edit.text}{lines[edit.end.line][edit.end.column..]}"
    var next: str[] = []
    for i in 0..edit.start.line {
        next.push(lines[i])
    }
    for part in text.split_str(joined, "\n") {
        next.push(part)
    }
    for i in edit.end.line + 1..lines.len {
        next.push(lines[i])
    }
    ui.set(doc, next)
}

fn indent(cx: ui.Context, first: i64, last: i64) {
    var edits: ui.TextEdit[] = []
    for i in first..last + 1 {
        let at = ui.TextPosition { line: i, column: 0 }
        edits.push(ui.TextEdit { start: at, end: at, text: "    " })
    }
    ui.text_area_apply(cx, "editor", edits, ui.text_area_selection(cx, "editor"))
}

fn shortcut(cx: ui.Context, letter: str) {
    let modifiers = platform.Modifiers { control: true }
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(letter), modifiers: modifiers }))
}

fn show(step: str, doc: ui.Signal[str[]]) {
    let joined = text.join(ui.get(doc), "|")
    print("{step}: {joined}")
}

/// Indents two lines of a text area as one undoable step from outside the area, undoes it with Control+Z, then asks where a position is drawn and which position lies under a point, as a completion popup and a double-click selection would.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    ui.bind_keys(cx, ui.text_area_bindings())
    let doc = ui.signal(cx, ["main:", "let a = 1", "let b = 2", "end"])
    let count = fn() -> i64 { ui.get(doc).len }
    let line = fn(i: i64) -> str { ui.get(doc)[i] }
    let source = ui.line_source(count, line, fn(e: ui.TextEdit) { apply_edit(doc, e) })
    let view = fn() -> ui.Element { ui.text_area(source).id("editor").size(240.0, 104.0) }
    let size = geometry.size(320.0, 240.0)
    ui.frame(cx, view, size, 1.0)
    ui.set_focus(cx, "editor")
    ui.frame(cx, view, size, 1.0)
    indent(cx, 1, 2)
    show("indented", doc)
    shortcut(cx, "z")
    show("undone", doc)
    let at = ui.TextPosition { line: 2, column: 4 }
    let point = ui.text_area_point_of(cx, "editor", at) ?? geometry.Point {}
    let inside = point.x > 0.0
    print("line 2 column 4 is drawn {point.y} pixels down, right of the left edge: {inside}")
    let under = ui.text_area_position_at(cx, "editor", geometry.point(point.x + 1.0, point.y + 1.0)) ?? ui.TextPosition {}
    print("under that point: line {under.line} column {under.column}")
}
