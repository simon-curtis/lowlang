import std/ui
import std/ui/geometry
import std/ui/platform

fn samples() -> f32[] {
    [12.0, 30.0, 18.0, 44.0, 26.0, 50.0]
}

fn plotted(p: ui.Painter) -> geometry.Point[] {
    let values = samples()
    let step = p.width / f32(values.len - 1)
    var points: geometry.Point[] = []
    for i, v in values {
        points.push(geometry.point(f32(i) * step, p.height - v))
    }
    points
}

fn chart(p: ui.Painter) {
    let points = plotted(p)
    p.fill_area(points, p.height, ui.rgba(0x2f6fed40))
    p.stroke_polyline(points, 2.0, ui.rgb(0x2f6fed))
    for at in points {
        p.fill_circle(at, 3.0, ui.rgb(0x1b3f8a))
    }
    let from = geometry.point(0.0, 10.0)
    let to = geometry.point(p.width, 10.0)
    p.stroke_cubic(from, geometry.point(p.width * 0.5, 10.0), geometry.point(p.width * 0.5, 40.0), to, 1.0, ui.rgb(0x888888))
}

fn button(x: f32, y: f32) -> platform.ButtonEvent {
    platform.ButtonEvent { button: platform.Button.Left, x, y }
}

/// Draws a line chart over a filled area in a canvas, 200 by 60 logical pixels inside 10 of padding, prints what the scene holds for it, then clicks the chart and prints the point of the click inside the canvas.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let page = fn() -> ui.Element {
        ui.div().padding(20.0).child(ui.canvas(chart).id("chart").size(220.0, 80.0).padding(10.0).on_click(fn(c: ui.ClickEvent) {
            let at = ui.canvas_point(cx, "chart", c.position) ?? return
            print("clicked at {i64(at.x)},{i64(at.y)} of the canvas")
        }))
    }
    let sc = ui.frame(cx, page, geometry.size(320.0, 200.0), 1.0)
    print("{sc.paths.len} paths and {sc.quads.len} quads")
    let clip = sc.paths[0].clip
    print("clipped to {i64(clip.width)}x{i64(clip.height)} at {i64(clip.x)},{i64(clip.y)}")

    ui.dispatch(cx, platform.Event.PointerDown(button(130.0, 60.0)))
    ui.dispatch(cx, platform.Event.PointerUp(button(130.0, 60.0)))
}
