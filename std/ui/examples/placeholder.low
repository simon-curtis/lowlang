import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn search(query: ui.Signal[str]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        ui.field(ui.get(query)).id("query").width(160.0).height(28.0).placeholder("Search").on_change(fn(s: str) { ui.set(query, s) })
    }
}

fn ink(sprites: scene.Sprite[]) -> str {
    if sprites.len == 0 {
        return "none"
    }
    let c = sprites[0].color
    "{c.r} {c.g} {c.b} {c.a}"
}

fn type_text(cx: ui.Context, letter: str) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(letter), text: letter }))
}

/// Builds a search field with a placeholder and prints the colour of its glyphs while it is empty, while an input method composes, and after typing, with no window and no GPU.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let query = ui.signal(cx, "")
    let render = search(query)
    let size = geometry.size(240.0, 60.0)

    let empty = ui.frame(cx, render, size, 1.0)
    print("empty: {empty.sprites.len} glyphs, ink {ink(empty.sprites)}")
    ui.set_focus(cx, "query")
    ui.dispatch(cx, platform.Event.Preedit("ni", platform.TextRange { start: 0, end: 2 }))
    let composing = ui.frame(cx, render, size, 1.0)
    print("composing: {composing.sprites.len} glyphs, ink {ink(composing.sprites)}")
    ui.dispatch(cx, platform.Event.Preedit("", none))
    type_text(cx, "L")
    type_text(cx, "o")
    type_text(cx, "w")
    let typed = ui.frame(cx, render, size, 1.0)
    print("typed: {typed.sprites.len} glyphs, ink {ink(typed.sprites)}")
    print("text: {ui.get(query)}")
}
