import std/ui
import std/ui/geometry

fn budget_view(total: ui.Memo[i64], over_budget: ui.Memo[bool]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        let note = if ui.read(over_budget) { "over budget" } else { "within budget" }
        ui.column(ui.div()).padding(16.0).children() {
            ui.text("total {ui.read(total)}"),
            ui.text(note),
        }
    }
}

/// Derives a total and a budget check from two prices with memos, logs each new total from an effect, and draws a window that tracks its frames, with no system window and no GPU. A change that leaves the budget check equal does not reach the effect that reads only the check, and a frame is due only when something the last frame read changed.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    ui.set_tracked_frames(cx, true)
    let apples = ui.signal(cx, 3)
    let pears = ui.signal(cx, 4)
    let unrelated = ui.signal(cx, "")
    let total = ui.memo(cx, fn() -> i64 { ui.get(apples) + ui.get(pears) })
    let over_budget = ui.memo(cx, fn() -> bool { ui.read(total) > 10 })
    ui.effect(cx, fn() { print("total is {ui.read(total)}") })
    ui.effect(cx, fn() { print("over budget: {ui.read(over_budget)}") })
    let render = budget_view(total, over_budget)
    let size = geometry.size(240.0, 120.0)
    ui.frame(cx, render, size, 1.0)

    ui.batch(cx, fn() {
        ui.set(apples, 2)
        ui.set(pears, 6)
    })
    print("due after a new total: {ui.frame_due(cx)}")
    ui.frame(cx, render, size, 1.0)

    ui.set(unrelated, "note")
    print("due after a signal no frame read: {ui.frame_due(cx)}")

    ui.set(pears, 9)
}
