import std/ui
import std/ui/geometry
import std/ui/platform

fn find_bar(open: ui.Signal[bool], query: ui.Signal[str]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        if ui.get(open) {
            ui.field(ui.get(query)).id("find").width(160.0).height(28.0).on_change(fn(s: str) { ui.set(query, s) })
        } else {
            ui.div().width(160.0).height(28.0)
        }
    }
}

fn type_text(cx: ui.Context, letter: str) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(letter), text: letter }))
}

fn show_selection(cx: ui.Context, label: str) {
    let s = ui.field_selection(cx, "find")
    print("{label}: {s.anchor} to {s.caret}")
}

/// Opens a find bar that holds the previous search, selects all of the text in the same event that adds the field to the tree, and prints the selection after the next frame, after typing replaces it and after `set_field_selection` selects a range, with no window and no GPU.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let open = ui.signal(cx, false)
    let query = ui.signal(cx, "previous")
    let render = find_bar(open, query)
    let size = geometry.size(240.0, 60.0)

    let _ = ui.frame(cx, render, size, 1.0)
    ui.set(open, true)
    ui.set_focus(cx, "find")
    ui.select_field_text(cx, "find")
    let _ = ui.frame(cx, render, size, 1.0)
    show_selection(cx, "opened")
    type_text(cx, "n")
    type_text(cx, "e")
    type_text(cx, "x")
    type_text(cx, "t")
    let _ = ui.frame(cx, render, size, 1.0)
    print("text: {ui.get(query)}")
    ui.set_field_selection(cx, "find", 1, 100)
    let _ = ui.frame(cx, render, size, 1.0)
    show_selection(cx, "from the second letter")
}
