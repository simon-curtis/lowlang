import std/ui
import std/ui/geometry
import std/ui/platform

fn sum_to(n: i64) -> fn() -> i64 {
    fn() -> i64 {
        var total = 0
        for i in 1..n + 1 {
            total += i
        }
        total
    }
}

fn label(total: ui.Signal[i64]) -> str {
    if ui.get(total) < 0 { "summing..." } else { "sum: {ui.get(total)}" }
}

fn settle(cx: ui.Context, task: ui.Task) {
    for !task.finished() {
        sleep(1)
        ui.dispatch(cx, platform.Event.Woken)
    }
}

/// Sums a range on another green thread while the interface shows that it is working, then shows the sum the task wrote into a signal, and cancels a second task so its result never arrives, with no window and no GPU.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let total = ui.signal(cx, -1)
    let render = fn() -> ui.Element { ui.div().padding(16.0).child(ui.text(label(total))) }
    let size = geometry.size(240.0, 80.0)
    let _ = ui.frame(cx, render, size, 1.0)

    let task = total.spawn_into(sum_to(1000000))
    print("{label(total)} finished: {task.finished()}")
    settle(cx, task)
    print("{label(total)} finished: {task.finished()} frame due: {ui.frame_due(cx)}")
    let _ = ui.frame(cx, render, size, 1.0)

    let stale = ui.signal(cx, 0)
    let late = stale.spawn_into(sum_to(10))
    late.cancel()
    settle(cx, late)
    print("cancelled task finished: {late.finished()} kept: {ui.get(stale)}")
}
