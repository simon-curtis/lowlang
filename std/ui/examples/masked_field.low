import std/ui
import std/ui/geometry
import std/ui/platform

fn tree(secret: ui.Signal[str]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        ui.field(ui.get(secret)).id("secret").masked().width(150.0).height(30.0).on_change(fn(s: str) { ui.set(secret, s) })
    }
}

fn type_text(cx: ui.Context, s: str) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

/// Types into a masked field, copies it with Control and C, and prints the value, the clipboard and how many glyphs the field draws.
fn main() {
    let cx = ui.headless(geometry.rgb(0xffffff))
    let secret = ui.signal(cx, "")
    ui.frame(cx, tree(secret), geometry.Size { width: 200.0, height: 100.0 }, 1.0)
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: 10.0 }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: 10.0 }))
    type_text(cx, "hunter2")
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("a"), modifiers: platform.Modifiers { control: true } }))
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("c"), modifiers: platform.Modifiers { control: true } }))
    let scene = ui.frame(cx, tree(secret), geometry.Size { width: 200.0, height: 100.0 }, 1.0)
    print("value: {ui.get(secret)}")
    let copied = ui.clipboard(cx) ?? "empty"
    print("clipboard: {copied}")
    print("glyphs drawn: {scene.sprites.len}")
}
