import std/ui
import std/ui/geometry

fn count() -> i64 {
    2
}

fn line(i: i64) -> str {
    match i {
        0 => "select name from users where name = 'a'"
        _ => "order by name"
    }
}

fn edit(e: ui.TextEdit) {}

fn marks(i: i64) -> ui.TextMark[] {
    match i {
        0 => [
            ui.TextMark { start: 7, end: 11, color: geometry.rgba(0xf5c24266) }
            ui.TextMark { start: 38, end: 41, color: geometry.rgb(0xdc2626), style: ui.MarkStyle.Squiggle }
            ui.TextMark { start: 14, end: 19, color: geometry.rgb(0x2563eb), style: ui.MarkStyle.Underline }
            ui.TextMark { start: 44, end: 44, color: geometry.rgb(0x3b82f6), style: ui.MarkStyle.Bar }
        ]
        _ => []
    }
}

fn runs(i: i64) -> ui.TextRun[] {
    match i {
        1 => [ui.TextRun { start: 0, end: 5, background: geometry.rgb(0xdbeafe) }]
        _ => []
    }
}

/// Highlights a match, underlines a word, draws a squiggle under another and a peer's caret on one line, and gives a word of the next line a background through its run, then prints how many quads and underlines the frame holds and whether each underline is wavy.
fn main() {
    let cx = ui.headless(geometry.rgb(0xffffff))
    var source = ui.line_source(count, line, edit)
    source.line_marks = marks
    source.line_runs = runs
    let view = fn() -> ui.Element { ui.text_area(source).size(320.0, 104.0) }
    let sc = ui.frame(cx, view, geometry.size(400.0, 200.0), 1.0)
    print("quads: {sc.quads.len}")
    print("underlines: {sc.underlines.len}")
    for u in sc.underlines {
        print("wavy: {u.wavy == 1.0}, {u.bounds.height} pixels high")
    }
}
