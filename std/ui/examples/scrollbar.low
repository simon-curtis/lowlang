import std/ui
import std/ui/geometry
import std/ui/platform

fn script() -> ui.LineSource {
    ui.line_source(fn() -> i64 { 200 }, fn(i: i64) -> str { "line {i}" }, fn(e: ui.TextEdit) {})
}

fn page() -> ui.Element {
    ui.text_area(script()).id("script").size(300.0, 100.0).line_height(20.0).scrollbar(ui.ScrollbarOptions { width: 10.0 })
}

fn button(x: f32, y: f32) -> platform.ButtonEvent {
    platform.ButtonEvent { button: platform.Button.Left, x, y }
}

/// Draws a text area of 200 lines with a scrollbar, prints how much of it is in view, then drags the thumb to the end of its track and prints the first line in view.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    ui.frame(cx, page, geometry.size(320.0, 120.0), 1.0)
    let held = ui.scroll_metrics(cx, "script") ?? ui.ScrollMetrics {}
    print("{i64(held.viewport.height)} of {i64(held.content.height)} pixels in view")

    ui.dispatch(cx, platform.Event.PointerMoved(295.0, 5.0))
    ui.dispatch(cx, platform.Event.PointerDown(button(295.0, 5.0)))
    ui.dispatch(cx, platform.Event.PointerMoved(295.0, 400.0))
    ui.dispatch(cx, platform.Event.PointerUp(button(295.0, 400.0)))
    print("first line in view: {ui.text_area_top_line(cx, "script")}")
}
