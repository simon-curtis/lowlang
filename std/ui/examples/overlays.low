import std/ui
import std/ui/geometry
import std/ui/platform

fn window() -> geometry.Size {
    geometry.size(400.0, 300.0)
}

fn edit_menu(log: ui.Signal[str]) -> fn() -> ui.MenuItem[] {
    fn() -> ui.MenuItem[] {
        [
            ui.menu_action("Save", "editor.save"),
            ui.menu_separator(),
            ui.disabled(ui.menu_entry("Cut", fn() { ui.set(log, "cut") })),
            ui.menu_entry("Paste", fn() { ui.set(log, "pasted") }),
            ui.submenu("Insert", [ui.menu_entry("Date", fn() { ui.set(log, "inserted a date") })]),
        ]
    }
}

fn editor_view(log: ui.Signal[str]) -> fn() -> ui.Element {
    let items = edit_menu(log)
    fn() -> ui.Element {
        let help = fn() -> ui.Element { ui.div().id("help").padding(4.0).background(ui.rgb(0xfffbe6)).child(ui.text("Right click for the edit menu")) }
        ui.div().column().size(400.0, 300.0).children() {
            ui.field("draft").id("editor").width(200.0).context_menu("edit", items).tooltip(help)
                .on_action("editor.save", fn() { ui.set(log, "saved") }),
        }
    }
}

fn key(cx: ui.Context, n: platform.NamedKey) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(n) }))
}

fn right_click(cx: ui.Context, x: f32, y: f32) {
    ui.dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Right, x, y }))
    ui.dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Right, x, y }))
}

fn confirm_body() -> ui.Element {
    ui.div().row().gap(8.0).children() {
        ui.div().id("discard").size(60.0, 20.0).focusable(),
        ui.div().id("keep").size(60.0, 20.0).focusable(),
    }
}

/// Shows a tooltip after the pointer rests on a field, opens its context menu with the secondary button, chooses items with the arrow keys and Enter, and keeps focus inside a modal dialog until Escape closes it.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let shortcut = ui.key_binding("ctrl-s", "editor.save", "") catch {
        e => {
            print("cannot read the keymap")
            return
        }
    }
    ui.bind_keys(cx, [shortcut])
    let log = ui.signal(cx, "")
    let view = editor_view(log)
    ui.frame(cx, view, window(), 1.0)
    ui.set_focus(cx, "editor")
    ui.dispatch(cx, platform.Event.PointerMoved(20.0, 10.0))
    ui.advance_clock(cx, 500)
    ui.frame(cx, view, window(), 1.0)
    let tip = ui.bounds_of(cx, "help") ?? geometry.Rect {}
    print("tooltip at {tip.x} {tip.y}")
    right_click(cx, 20.0, 10.0)
    ui.frame(cx, view, window(), 1.0)
    let menu = ui.bounds_of(cx, "edit") ?? geometry.Rect {}
    print("menu open {ui.overlay_open(cx, "edit")} at {menu.x} {menu.y}, focus on {ui.focused(cx)}")
    key(cx, platform.NamedKey.Down)
    key(cx, platform.NamedKey.Down)
    key(cx, platform.NamedKey.Enter)
    print("{ui.get(log)}, focus back on {ui.focused(cx)}")
    ui.frame(cx, view, window(), 1.0)
    right_click(cx, 20.0, 10.0)
    ui.frame(cx, view, window(), 1.0)
    key(cx, platform.NamedKey.End)
    key(cx, platform.NamedKey.Right)
    ui.frame(cx, view, window(), 1.0)
    key(cx, platform.NamedKey.Enter)
    print(ui.get(log))
    ui.frame(cx, view, window(), 1.0)
    right_click(cx, 20.0, 10.0)
    ui.frame(cx, view, window(), 1.0)
    key(cx, platform.NamedKey.Home)
    key(cx, platform.NamedKey.Enter)
    print(ui.get(log))
    ui.frame(cx, view, window(), 1.0)
    ui.open_dialog(cx, "confirm", confirm_body)
    ui.frame(cx, view, window(), 1.0)
    print("dialog focus on {ui.focused(cx)}")
    key(cx, platform.NamedKey.Tab)
    print("after tab focus on {ui.focused(cx)}")
    key(cx, platform.NamedKey.Tab)
    print("after another tab focus on {ui.focused(cx)}")
    key(cx, platform.NamedKey.Escape)
    print("dialog open {ui.overlay_open(cx, "confirm")}, focus on {ui.focused(cx)}")
}
