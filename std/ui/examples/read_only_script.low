import std/ui
import std/ui/geometry
import std/ui/platform

fn press(cx: ui.Context, key: platform.NamedKey, control: bool) {
    let modifiers = platform.Modifiers { control: control }
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(key), modifiers: modifiers }))
}

fn type_text(cx: ui.Context, s: str) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn shortcut(cx: ui.Context, letter: str) {
    let modifiers = platform.Modifiers { control: true }
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(letter), modifiers: modifiers }))
}

fn show(cx: ui.Context, step: str, edits: ui.Signal[i64]) {
    let selection = ui.text_area_selection(cx, "script")
    let caret = selection.caret
    let anchor = selection.anchor
    let input = if ui.text_input(cx) == none { "no" } else { "yes" }
    print("{step}: edits {ui.get(edits)}, selection {anchor.line}:{anchor.column} to {caret.line}:{caret.column}, input method {input}")
}

/// Shows a script in a read-only text area with no window: selects all and copies it, moves the caret, then tries typing, Enter, Backspace, paste and undo, and prints how many edits reached the document, the selection and whether an input method is open after each step.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    ui.bind_keys(cx, ui.text_area_bindings())
    let lines = ["echo start", "sleep 1", "echo done"]
    let edits = ui.signal(cx, 0)
    let count = fn() -> i64 { lines.len }
    let line = fn(i: i64) -> str { lines[i] }
    let edit = fn(e: ui.TextEdit) { ui.set(edits, ui.get(edits) + 1) }
    let source = ui.line_source(count, line, edit)
    let view = fn() -> ui.Element { ui.text_area(source).id("script").size(240.0, 104.0).read_only() }
    let size = geometry.size(320.0, 240.0)
    ui.frame(cx, view, size, 1.0)
    ui.set_focus(cx, "script")
    ui.frame(cx, view, size, 1.0)
    show(cx, "start", edits)
    shortcut(cx, "a")
    shortcut(cx, "c")
    show(cx, "copy", edits)
    print("clipboard: {ui.clipboard(cx) ?? ""}")
    press(cx, platform.NamedKey.Home, true)
    press(cx, platform.NamedKey.Down, false)
    show(cx, "move", edits)
    type_text(cx, "x")
    press(cx, platform.NamedKey.Enter, false)
    press(cx, platform.NamedKey.Backspace, false)
    ui.set_clipboard(cx, "rm -rf")
    shortcut(cx, "v")
    shortcut(cx, "z")
    ui.frame(cx, view, size, 1.0)
    show(cx, "refused", edits)
}
