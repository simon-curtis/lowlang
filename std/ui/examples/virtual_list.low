import std/ui
import std/ui/geometry
import std/ui/platform

fn uniform_rows(log: ui.Signal[str]) -> fn(i64, i64) -> ui.Element[] {
    fn(start: i64, end: i64) -> ui.Element[] {
        ui.set(log, "{ui.get(log)} [{start}, {end})")
        var out: ui.Element[] = []
        for ix in start..end {
            out.push(ui.text("row {ix}").height(24.0).shrink(0.0))
        }
        out
    }
}

fn varied_rows(log: ui.Signal[str]) -> fn(i64) -> ui.Element {
    fn(ix: i64) -> ui.Element {
        ui.set(log, "{ui.get(log)} {ix}")
        ui.text("item {ix}").height(16.0 + f32(ix % 3) * 8.0).shrink(0.0)
    }
}

fn take(log: ui.Signal[str]) -> str {
    let seen = ui.get(log)
    ui.set(log, "")
    seen
}

fn wheel(cx: ui.Context, dy: f32) {
    ui.dispatch(cx, platform.Event.PointerMoved(20.0, 20.0))
    ui.dispatch(cx, platform.Event.Scrolled(0.0, dy, platform.Modifiers {}))
}

/// Builds a `uniform_list` of a million rows and a `list` of rows of three heights in windows 240 pixels high, scrolls each, and prints which rows the frames asked for, with no window and no GPU.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let size = geometry.size(200.0, 240.0)
    let log = ui.signal(cx, "")

    let handle = ui.uniform_list_scroll_handle(cx)
    let rows = uniform_rows(log)
    let fixed = fn() -> ui.Element { ui.uniform_list("rows", 1000000, rows).size(200.0, 240.0).track_scroll(handle) }
    print("uniform list of 1000000 rows, 24 pixels each, 240 pixels high")
    ui.frame(cx, fixed, size, 1.0)
    print("first frame asked:{take(log)}")
    ui.scroll_to(cx, "rows", geometry.point(0.0, 12000000.0))
    ui.frame(cx, fixed, size, 1.0)
    print("scroll_to 12000000 asked:{take(log)}")
    wheel(cx, 60.0)
    ui.frame(cx, fixed, size, 1.0)
    print("wheel 60 asked:{take(log)}")
    ui.scroll_to_item(handle, 999999, ui.ScrollStrategy.Bottom)
    ui.frame(cx, fixed, size, 1.0)
    print("scroll_to_item 999999 asked:{take(log)}")
    print("top item {ui.logical_scroll_top_index(handle)} of range {ui.visible_range(handle).start} to {ui.visible_range(handle).end}")

    let state = ui.list_state(cx, 100000, ui.ListAlignment.Top, 24.0)
    let render = varied_rows(log)
    let varied = fn() -> ui.Element { ui.list(state, render).size(200.0, 240.0) }
    print("list of 100000 rows, 16, 24 and 32 pixels, 240 pixels high")
    ui.frame(cx, varied, size, 1.0)
    print("first frame laid out rows:{take(log)}")
    ui.frame(cx, varied, size, 1.0)
    print("second frame laid out rows:{take(log)}")
    wheel(cx, 30.0)
    ui.frame(cx, varied, size, 1.0)
    let top = ui.logical_scroll_top(state)
    print("wheel 30 laid out rows:{take(log)} with item {top.item_ix} at the top, {top.offset_in_item} pixels in")
    ui.scroll_to_reveal_item(state, 0)
    ui.frame(cx, varied, size, 1.0)
    print("scroll_to_reveal_item 0 laid out rows:{take(log)}")
}
