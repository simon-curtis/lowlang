import std/ui
import std/ui/geometry
import std/ui/platform

fn pane() -> ui.Element {
    ui.div().id("pane").row().size(100.0, 50.0).overflow_scroll().children() {
        ui.div().width(80.0).height(80.0).shrink(0.0).background(ui.rgb(0xff0000)),
        ui.div().width(80.0).height(80.0).shrink(0.0).background(ui.rgb(0x00ff00)),
    }
}

fn turn(cx: ui.Context, label: str, dy: f32, modifiers: platform.Modifiers) {
    ui.dispatch(cx, platform.Event.PointerMoved(10.0, 10.0))
    ui.dispatch(cx, platform.Event.Scrolled(0.0, dy, modifiers))
    let at = ui.scroll_offset(cx, "pane")
    print("{label}: offset {at.x} {at.y}")
}

/// Turns the wheel over a pane that overflows both ways, with no modifiers, with Shift, and with Shift and Control, and prints where the pane ends up each time. With Shift alone the wheel scrolls the pane sideways, so the same wheel turn that moved it down now moves it right, and `on_scroll_wheel` handlers see the modifiers.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let seen = ui.signal(cx, "none")
    let view = fn() -> ui.Element {
        pane().on_scroll_wheel(fn(e: ui.ScrollEvent) {
            ui.set(seen, "shift {e.modifiers.shift} control {e.modifiers.control}")
        })
    }
    let _ = ui.frame(cx, view, geometry.size(200.0, 100.0), 1.0)
    turn(cx, "wheel down 20", 20.0, platform.Modifiers {})
    turn(cx, "shift wheel down 20", 20.0, platform.Modifiers { shift: true })
    turn(cx, "control wheel down 10", 10.0, platform.Modifiers { control: true })
    turn(cx, "shift control wheel down 10", 10.0, platform.Modifiers { shift: true, control: true })
    turn(cx, "shift wheel up 5", -5.0, platform.Modifiers { shift: true })
    print("handler saw {ui.get(seen)}")
}
