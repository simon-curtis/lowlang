import std/ui
import std/ui/geometry

fn panel(width: ui.Signal[f32]) -> fn() -> ui.Element {
    fn() -> ui.Element {
        ui.div().id("panel").size(ui.get(width), 40.0)
    }
}

fn slide_open(cx: ui.Context, width: ui.Signal[f32]) {
    if ui.prefers_reduced_motion(cx) {
        ui.set(width, 300.0)
        return
    }
    let started = ui.now(cx)
    ui.animate(cx, fn(now: i64) -> bool {
        let t = f32(now - started) / 300.0
        ui.set(width, 300.0 * if t > 1.0 { 1.0 } else { t })
        t < 1.0
    })
}

fn frame_width(cx: ui.Context, view: fn() -> ui.Element) -> i64 {
    ui.frame(cx, view, geometry.size(400.0, 100.0), 1.0)
    i64((ui.bounds_of(cx, "panel") ?? geometry.Rect {}).width)
}

/// Slides a panel open over 300 milliseconds on the context's clock, printing its width after each 100 milliseconds step, then opens it at once where the system asks for no animation, and schedules a callback with `after`.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let width = ui.signal(cx, f32(0.0))
    let view = panel(width)
    slide_open(cx, width)
    for step in 0..4 {
        print("{ui.now(cx)} ms: {frame_width(cx, view)}")
        ui.advance_clock(cx, 100)
    }
    print("frame due after the animation ended: {ui.frame_due(cx)}")

    ui.set_reduced_motion(cx, true)
    ui.set(width, 0.0)
    slide_open(cx, width)
    print("reduced motion: {frame_width(cx, view)}")

    let hidden = ui.signal(cx, false)
    ui.after(cx, 250, fn() { ui.set(hidden, true) })
    ui.advance_clock(cx, 249)
    print("hidden at 249 ms: {ui.get(hidden)}")
    ui.advance_clock(cx, 1)
    print("hidden at 250 ms: {ui.get(hidden)}")
}
