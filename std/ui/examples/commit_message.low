import std/text
import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn apply_edit(doc: ui.Signal[str[]], edit: ui.TextEdit) {
    let lines = ui.get(doc)
    let joined = "{lines[edit.start.line][..edit.start.column]}{edit.text}{lines[edit.end.line][edit.end.column..]}"
    var next: str[] = []
    for i in 0..edit.start.line {
        next.push(lines[i])
    }
    for part in text.split_str(joined, "\n") {
        next.push(part)
    }
    for i in edit.end.line + 1..lines.len {
        next.push(lines[i])
    }
    ui.set(doc, next)
}

fn message_box(doc: ui.Signal[str[]]) -> fn() -> ui.Element {
    let count = fn() -> i64 { ui.get(doc).len }
    let line = fn(i: i64) -> str { ui.get(doc)[i] }
    let edit = fn(e: ui.TextEdit) { apply_edit(doc, e) }
    let source = ui.line_source(count, line, edit)
    fn() -> ui.Element {
        ui.text_area(source).id("message").size(240.0, 104.0).placeholder("Message").selection_color(geometry.rgba(0x10b98180))
    }
}

fn glyphs(sc: scene.Scene) -> i64 {
    sc.sprites.len + sc.subpixel_sprites.len
}

fn type_text(cx: ui.Context, s: str) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn undo(cx: ui.Context) {
    let modifiers = platform.Modifiers { control: true }
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("z"), modifiers: modifiers }))
}

/// Shows a commit message box with a placeholder and a theme's selection colour, types a message, then clears the document the way a commit does and resets the area so that undo has nothing left to replay, printing the glyphs drawn and the document at each step.
fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    ui.bind_keys(cx, ui.text_area_bindings())
    let doc = ui.signal(cx, [""])
    let view = message_box(doc)
    let size = geometry.size(320.0, 240.0)
    print("empty: {glyphs(ui.frame(cx, view, size, 1.0))} glyphs from the placeholder")
    ui.set_focus(cx, "message")
    type_text(cx, "fix")
    print("typed: {glyphs(ui.frame(cx, view, size, 1.0))} glyphs, document {text.join(ui.get(doc), "|")}")
    ui.set(doc, [""])
    ui.reset_text_area(cx, "message")
    ui.frame(cx, view, size, 1.0)
    undo(cx)
    print("after commit: document {text.join(ui.get(doc), "|")} with {glyphs(ui.frame(cx, view, size, 1.0))} glyphs from the placeholder")
}
