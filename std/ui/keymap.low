import std/slices
import std/ui/platform
import stdtext = std/text

/// One keystroke of a key binding, as gpui's `Keystroke`: a key named in lower case, such as `"a"`, `"enter"`, `"space"`, `"f5"` or `"?"`, and the modifiers held with it.
pub struct Keystroke {
    /// The key: a character in lower case or one of `enter`, `escape`, `tab`, `backspace`, `delete`, `left`, `right`, `up`, `down`, `home`, `end`, `pageup`, `pagedown`, `space` and `f1` to `f12`.
    pub key: str
    /// The modifiers held with the key.
    pub modifiers: platform.Modifiers = platform.Modifiers {}
}

/// Keystrokes bound to a named action where a context predicate holds, as gpui's `KeyBinding`.
pub struct KeyBinding {
    /// The keystrokes, more than one for a chord such as `ctrl-k ctrl-o`.
    pub keystrokes: Keystroke[] = []
    /// The action the keystrokes dispatch. An empty name unbinds the keystrokes where the predicate holds, as gpui's `NoAction` does.
    pub action: str = ""
    /// The context predicate as written, empty for a binding that holds everywhere.
    pub context: str = ""
    predicate: Predicate = Predicate {}
}

/// Why a keystroke, a binding's context predicate or an element's key context could not be read.
pub enum KeymapError {
    /// The keystroke `text` names no key, names an unknown modifier, or has text after its key.
    InvalidKeystroke(text: str)
    /// The predicate or key context `text` could not be read, for the reason given.
    InvalidContext(text: str, reason: str)
}

struct ContextEntry {
    key: str
    value: str? = none
}

struct KeyContext {
    entries: ContextEntry[] = []
}

enum Test {
    Identifier
    Equal
    NotEqual
    Not
    Descendant
    And
    Or
}

struct Term {
    test: Test
    name: str = ""
    value: str = ""
    left: i64 = -1
    right: i64 = -1
}

struct Predicate {
    terms: Term[] = []
    root: i64 = -1
}

struct PredicateParser {
    source: str
    at: i64 = 0
    terms: Term[] = []
}

struct Operator {
    text: str
    precedence: i64
    test: Test
}

struct Candidate {
    depth: i64
    index: i64
}

struct Matched {
    bindings: KeyBinding[] = []
    pending: bool = false
}

const precedence_child = 1
const precedence_or = 2
const precedence_and = 3
const precedence_eq = 4
const precedence_not = 5

/// Returns the binding of `keystrokes`, keystrokes separated by spaces such as `"ctrl-k ctrl-o"`, to `action` where the predicate `context` holds, or everywhere when `context` is empty, as gpui's `KeyBinding::load` does.
///
/// A keystroke is modifiers and a key joined by `-`: `ctrl`, `alt`, `shift`, `super` (also written `cmd` or `win`) and `secondary`, which is `ctrl`. A single upper case letter is that letter with `shift`, and `ctrl--` is Control with the minus key. A predicate names contexts and joins them with `&&`, `||`, `!`, `==`, `!=`, `>` (a context inside another) and parentheses, as gpui's `KeyBindingContextPredicate` does.
pub fn key_binding(keystrokes: str, action: str, context: str) -> KeyBinding ! KeymapError {
    let parts = stdtext.fields(keystrokes)
    if parts.len == 0 {
        fail InvalidKeystroke(keystrokes)
    }
    var strokes: Keystroke[] = []
    for part in parts {
        let stroke = parse_keystroke(part)?
        strokes.push(stroke)
    }
    let predicate = if stdtext.trim(context) == "" { Predicate {} } else { parse_predicate(context)? }
    KeyBinding { keystrokes: strokes, action, context, predicate }
}

/// Returns `k` written as a binding writes it, such as `"ctrl-shift-p"`, with the modifiers in gpui's order: `ctrl`, `alt`, `super`, `shift`.
pub fn keystroke_text(k: Keystroke) -> str {
    var out = ""
    if k.modifiers.control {
        out = "{out}ctrl-"
    }
    if k.modifiers.alt {
        out = "{out}alt-"
    }
    if k.modifiers.super {
        out = "{out}super-"
    }
    if k.modifiers.shift {
        out = "{out}shift-"
    }
    "{out}{k.key}"
}

/// Returns the keystrokes of `b` written as a binding writes them, separated by spaces, such as `"ctrl-k ctrl-o"`.
pub fn binding_text(b: KeyBinding) -> str {
    strokes_text(b.keystrokes)
}

fn strokes_text(strokes: Keystroke[]) -> str {
    var out = ""
    for i, k in strokes {
        let gap = if i == 0 { "" } else { " " }
        out = "{out}{gap}{keystroke_text(k)}"
    }
    out
}

fn parse_keystroke(source: str) -> Keystroke ! KeymapError {
    var modifiers = platform.Modifiers {}
    var rest = source
    for {
        if rest == "-" {
            return Keystroke { key: "-", modifiers }
        }
        let dash = stdtext.index(rest, "-")
        if dash < 0 {
            break
        }
        let part = stdtext.lower(rest[0..dash])
        if part == "ctrl" || part == "secondary" {
            modifiers.control = true
        } else if part == "alt" {
            modifiers.alt = true
        } else if part == "shift" {
            modifiers.shift = true
        } else if part == "cmd" || part == "super" || part == "win" {
            modifiers.super = true
        } else {
            fail InvalidKeystroke(source)
        }
        rest = rest[dash + 1..]
    }
    if rest == "" {
        fail InvalidKeystroke(source)
    }
    if rest.len == 1 && rest[0] >= 'A' && rest[0] <= 'Z' {
        modifiers.shift = true
    }
    Keystroke { key: stdtext.lower(rest), modifiers }
}

fn parse_key_context(source: str) -> KeyContext ! KeymapError {
    var context = KeyContext {}
    var at = skip_spaces(source, 0)
    for at < source.len {
        let key_end = identifier_end(source, at, false)
        if key_end == at {
            fail InvalidContext(source, "expected an identifier")
        }
        let key = source[at..key_end]
        at = skip_spaces(source, key_end)
        if at < source.len && source[at] == '=' {
            at = skip_spaces(source, at + 1)
            let value_end = identifier_end(source, at, false)
            if value_end == at {
                fail InvalidContext(source, "expected a value after =")
            }
            set_entry(mut context, key, source[at..value_end])
            at = skip_spaces(source, value_end)
        } else {
            add_entry(mut context, key)
        }
    }
    context
}

fn add_entry(mut c: KeyContext, key: str) {
    if !has_entry(c, key) {
        c.entries.push(ContextEntry { key })
    }
}

fn set_entry(mut c: KeyContext, key: str, value: str) {
    if !has_entry(c, key) {
        c.entries.push(ContextEntry { key, value })
    }
}

fn has_entry(c: KeyContext, key: str) -> bool {
    for e in c.entries {
        if e.key == key {
            return true
        }
    }
    false
}

fn entry_value(c: KeyContext, key: str) -> str? {
    for e in c.entries {
        if e.key == key {
            return e.value
        }
    }
    none
}

fn identifier_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c >= 0x80
}

fn operator_byte(c: u8) -> bool {
    c == '>' || c == '<' || c == '~' || c == '"' || c == '?'
}

fn identifier_end(s: str, from: i64, operators: bool) -> i64 {
    var at = from
    for at < s.len && (identifier_byte(s[at]) || (operators && operator_byte(s[at]))) {
        at += 1
    }
    at
}

fn skip_spaces(s: str, from: i64) -> i64 {
    var at = from
    for at < s.len && stdtext.space(s[at]) {
        at += 1
    }
    at
}

fn parse_predicate(source: str) -> Predicate ! KeymapError {
    let p = new(PredicateParser { source })
    p.at = skip_spaces(source, 0)
    let root = parse_expression(p, 0)?
    if p.at < source.len {
        fail InvalidContext(source, "unexpected character")
    }
    Predicate { terms: p.terms, root }
}

fn operators() -> Operator[] {
    [
        Operator { text: ">", precedence: precedence_child, test: Test.Descendant },
        Operator { text: "&&", precedence: precedence_and, test: Test.And },
        Operator { text: "||", precedence: precedence_or, test: Test.Or },
        Operator { text: "==", precedence: precedence_eq, test: Test.Equal },
        Operator { text: "!=", precedence: precedence_eq, test: Test.NotEqual },
    ]
}

fn operator_at(p: *PredicateParser, min: i64) -> Operator? {
    let rest = p.source[p.at..]
    for op in operators() {
        if stdtext.starts_with(rest, op.text) && op.precedence >= min {
            return op
        }
    }
    none
}

fn parse_expression(p: *PredicateParser, min: i64) -> i64 ! KeymapError {
    var left = parse_primary(p)?
    for {
        let found = operator_at(p, min)
        let op = found ?? break
        p.at = skip_spaces(p.source, p.at + op.text.len)
        let right = parse_expression(p, op.precedence + 1)?
        left = combine(p, op.test, left, right)?
    }
    left
}

fn combine(p: *PredicateParser, test: Test, left: i64, right: i64) -> i64 ! KeymapError {
    if test == Test.Equal || test == Test.NotEqual {
        let a = p.terms[left]
        let b = p.terms[right]
        if a.test != Test.Identifier || b.test != Test.Identifier {
            fail InvalidContext(p.source, "operands of == and != must be identifiers")
        }
        return add_term(p, Term { test, name: a.name, value: b.name })
    }
    add_term(p, Term { test, left, right })
}

fn add_term(p: *PredicateParser, t: Term) -> i64 {
    p.terms.push(t)
    p.terms.len - 1
}

fn parse_primary(p: *PredicateParser) -> i64 ! KeymapError {
    if p.at >= p.source.len {
        fail InvalidContext(p.source, "unexpected end")
    }
    let c = p.source[p.at]
    if c == '(' {
        p.at = skip_spaces(p.source, p.at + 1)
        let inner = parse_expression(p, 0)?
        if p.at >= p.source.len || p.source[p.at] != ')' {
            fail InvalidContext(p.source, "expected a )")
        }
        p.at = skip_spaces(p.source, p.at + 1)
        return inner
    }
    if c == '!' {
        p.at = skip_spaces(p.source, p.at + 1)
        let inner = parse_expression(p, precedence_not)?
        return add_term(p, Term { test: Test.Not, left: inner })
    }
    if identifier_byte(c) {
        let end = identifier_end(p.source, p.at, true)
        let name = p.source[p.at..end]
        p.at = skip_spaces(p.source, end)
        return add_term(p, Term { test: Test.Identifier, name })
    }
    if operator_byte(c) {
        let name = p.source[p.at..p.at + 1]
        p.at = skip_spaces(p.source, p.at + 1)
        return add_term(p, Term { test: Test.Identifier, name })
    }
    fail InvalidContext(p.source, "unexpected character")
}

fn depth_of(p: Predicate, contexts: KeyContext[]) -> i64 {
    if p.root < 0 {
        return contexts.len
    }
    var depth = contexts.len
    for depth >= 0 {
        if holds_in(p, p.root, contexts[0..depth], contexts) {
            return depth
        }
        depth -= 1
    }
    -1
}

fn holds_in(p: Predicate, at: i64, contexts: KeyContext[], all: KeyContext[]) -> bool {
    if contexts.len == 0 {
        return false
    }
    let c = contexts[contexts.len - 1]
    let t = p.terms[at]
    match t.test {
        Identifier => has_entry(c, t.name)
        Equal => (entry_value(c, t.name) ?? return false) == t.value
        NotEqual => (entry_value(c, t.name) ?? return true) != t.value
        Not => {
            for i in 0..all.len {
                if holds_in(p, t.left, all[0..i + 1], all) {
                    return false
                }
            }
            true
        }
        Descendant => {
            for i in 0..contexts.len - 1 {
                if holds_in(p, t.left, contexts[0..i + 1], all) {
                    let below = contexts[i + 1..]
                    return holds_in(p, t.right, below, below)
                }
            }
            false
        }
        And => holds_in(p, t.left, contexts, all) && holds_in(p, t.right, contexts, all)
        Or => holds_in(p, t.left, contexts, all) || holds_in(p, t.right, contexts, all)
    }
}

fn named_key_text(n: platform.NamedKey) -> str {
    match n {
        Enter => "enter"
        Escape => "escape"
        Tab => "tab"
        Backspace => "backspace"
        Delete => "delete"
        Left => "left"
        Right => "right"
        Up => "up"
        Down => "down"
        Home => "home"
        End => "end"
        PageUp => "pageup"
        PageDown => "pagedown"
        Function(number) => "f{number}"
    }
}

fn stroke_key(k: platform.Key) -> str {
    match k {
        Named(n) => named_key_text(n)
        Character(text) => if text == " " { "space" } else { stdtext.lower(text) }
    }
}

fn produced_by_shift(k: platform.Key) -> bool {
    match k {
        Named(_) => false
        Character(text) => text != " " && stdtext.lower(text) == stdtext.upper(text)
    }
}

fn typed_stroke(k: platform.KeyEvent) -> Keystroke {
    Keystroke { key: stroke_key(k.key), modifiers: k.modifiers }
}

fn stroke_matches(k: platform.KeyEvent, target: Keystroke) -> bool {
    let typed = typed_stroke(k)
    let m = typed.modifiers
    let t = target.modifiers
    if typed.key != target.key || m.control != t.control || m.alt != t.alt || m.super != t.super {
        return false
    }
    m.shift == t.shift || (!t.shift && produced_by_shift(k.key))
}

fn strokes_match(b: KeyBinding, input: platform.KeyEvent[]) -> i64 {
    if b.keystrokes.len < input.len {
        return -1
    }
    for i, k in input {
        if !stroke_matches(k, b.keystrokes[i]) {
            return -1
        }
    }
    if b.keystrokes.len > input.len { 1 } else { 0 }
}

fn bindings_for_input(keymap: KeyBinding[], input: platform.KeyEvent[], contexts: KeyContext[]) -> Matched {
    var matched: Candidate[] = []
    var pending: i64[] = []
    var i = keymap.len - 1
    for i >= 0 {
        let depth = depth_of(keymap[i].predicate, contexts)
        if depth >= 0 {
            let state = strokes_match(keymap[i], input)
            if state == 0 {
                matched.push(Candidate { depth, index: i })
            } else if state == 1 {
                pending.push(i)
            }
        }
        i -= 1
    }
    slices.sort_stable_by(mut matched, fn(a: Candidate, b: Candidate) -> bool { a.depth > b.depth })
    var out = Matched {}
    var first = -1
    for c in matched {
        if keymap[c.index].action == "" {
            break
        }
        out.bindings.push(keymap[c.index])
        if first < 0 {
            first = c.index
        }
    }
    var open: str[] = []
    var j = pending.len - 1
    for j >= 0 {
        let at = pending[j]
        j -= 1
        if first >= 0 && first > at {
            continue
        }
        let strokes = binding_text(keymap[at])
        open = without(open, strokes)
        if keymap[at].action != "" {
            open.push(strokes)
        }
    }
    out.pending = open.len > 0
    out
}

fn without(list: str[], s: str) -> str[] {
    var kept: str[] = []
    for item in list {
        if item != s {
            kept.push(item)
        }
    }
    kept
}

fn shadowed(keymap: KeyBinding[], b: KeyBinding, contexts: KeyContext[]) -> bool {
    let typed = events_of(b.keystrokes)
    let found = bindings_for_input(keymap, typed, contexts)
    found.bindings.len == 0 || found.bindings[0].action != b.action
}

fn events_of(strokes: Keystroke[]) -> platform.KeyEvent[] {
    var out: platform.KeyEvent[] = []
    for s in strokes {
        let key = event_key(s.key)
        out.push(platform.KeyEvent { key, modifiers: s.modifiers })
    }
    out
}

fn event_key(name: str) -> platform.Key {
    if name == "space" {
        return platform.Key.Character(" ")
    }
    for n in named_keys() {
        if named_key_text(n) == name {
            return platform.Key.Named(n)
        }
    }
    platform.Key.Character(name)
}

fn named_keys() -> platform.NamedKey[] {
    var out = [
        platform.NamedKey.Enter, platform.NamedKey.Escape, platform.NamedKey.Tab, platform.NamedKey.Backspace,
        platform.NamedKey.Delete, platform.NamedKey.Left, platform.NamedKey.Right, platform.NamedKey.Up,
        platform.NamedKey.Down, platform.NamedKey.Home, platform.NamedKey.End, platform.NamedKey.PageUp,
        platform.NamedKey.PageDown,
    ]
    for f in 1..13 {
        out.push(platform.NamedKey.Function(f))
    }
    out
}

fn bindings_for(keymap: KeyBinding[], action: str, contexts: KeyContext[]) -> KeyBinding[] {
    var out: KeyBinding[] = []
    for b in keymap {
        if b.action == action && !shadowed(keymap, b, contexts) {
            out.push(b)
        }
    }
    out
}
