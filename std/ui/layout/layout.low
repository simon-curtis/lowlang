import std/ui/geometry

/// Whether a node takes part in layout.
pub enum Display {
    /// The node is a flex container, or a leaf when it has no children.
    Flex
    /// The node and its subtree take no space and get empty rectangles.
    None
}

/// How a node is positioned within its parent.
pub enum Position {
    /// The node is a flex item of its parent.
    Relative
    /// The node leaves the flow and is placed against its parent's padding box by its `inset`.
    Absolute
}

/// The main axis of a flex container.
pub enum Direction {
    /// Children run left to right.
    Row
    /// Children run top to bottom.
    Column
}

/// How a container distributes free space along its main axis.
///
/// When the children overflow, `Center` and `End` still offset them by the negative free space, and the three spaced values place them as `Start`.
pub enum Justify {
    /// Children sit at the start of the main axis.
    Start
    /// Children sit at the end of the main axis.
    End
    /// Children sit in the middle of the main axis.
    Center
    /// Free space goes between the children, none before the first or after the last.
    SpaceBetween
    /// Free space goes around each child, half of a share at each end.
    SpaceAround
    /// Free space goes in equal shares before, between and after the children.
    SpaceEvenly
}

/// How a container places its children along its cross axis.
pub enum Align {
    /// Children sit at the start of the cross axis.
    Start
    /// Children sit at the end of the cross axis.
    End
    /// Children sit in the middle of the cross axis.
    Center
    /// Children with an `Auto` cross size grow to the container's inner cross size.
    Stretch
}

/// A child's own cross alignment.
pub enum AlignSelf {
    /// The container's `align_items`.
    Auto
    /// The child sits at the start of the cross axis.
    Start
    /// The child sits at the end of the cross axis.
    End
    /// The child sits in the middle of the cross axis.
    Center
    /// The child grows to the container's inner cross size when its cross size is `Auto`.
    Stretch
}

/// A length along one axis.
pub enum Dimension {
    /// Not set: the node's content decides for a size, and the box has no minimum or maximum.
    Auto
    /// A length in logical pixels.
    Px(f32)
    /// A percentage of a reference length, where `50.0` is half of it. Against an unknown length it behaves as `Auto`.
    Percent(f32)
}

/// The offsets of an absolute node from the sides of its parent's padding box.
pub struct Inset {
    /// The distance from the top edge, or `Auto`.
    pub top: Dimension = Auto
    /// The distance from the right edge, or `Auto`.
    pub right: Dimension = Auto
    /// The distance from the bottom edge, or `Auto`.
    pub bottom: Dimension = Auto
    /// The distance from the left edge, or `Auto`.
    pub left: Dimension = Auto
}

/// The layout properties of one node.
///
/// Sizes, minimums, maximums and `basis` are border-box lengths. Percentages refer to the parent's inner size on the same axis, or to the padding box for an absolute node. A box is never smaller than its padding and border.
pub struct Style {
    /// Whether the node takes part in layout.
    pub display: Display = Flex
    /// Whether the node is a flex item or leaves the flow.
    pub position: Position = Relative
    /// The offsets of an absolute node. When both sides of an axis are set, the start side positions the node and, for an `Auto` size, the pair sizes it. When neither is set the node sits where `justify` and `align_items` of its parent would put it alone.
    pub inset: Inset = Inset {}
    /// The main axis of the node's children.
    pub direction: Direction = Row
    /// How the node distributes free space along its main axis.
    pub justify: Justify = Start
    /// How the node aligns its children along its cross axis.
    pub align_items: Align = Stretch
    /// This node's cross alignment within its parent.
    pub align_self: AlignSelf = Auto
    /// The share of positive free space this node takes, relative to its siblings.
    pub grow: f32 = 0.0
    /// The share of negative free space this node gives up, weighted by its basis.
    pub shrink: f32 = 1.0
    /// The starting main size before free space is shared; `Auto` uses the main size, then the content.
    pub basis: Dimension = Auto
    /// The width of the border box.
    pub width: Dimension = Auto
    /// The height of the border box.
    pub height: Dimension = Auto
    /// The smallest width; `Auto` is zero.
    pub min_width: Dimension = Auto
    /// The smallest height; `Auto` is zero.
    pub min_height: Dimension = Auto
    /// The largest width; `Auto` is unlimited.
    pub max_width: Dimension = Auto
    /// The largest height; `Auto` is unlimited.
    pub max_height: Dimension = Auto
    /// The space outside the border box, in pixels. It counts towards the node's outer size.
    pub margin: geometry.Edges = geometry.Edges {}
    /// The space between the border and the content, in pixels.
    pub padding: geometry.Edges = geometry.Edges {}
    /// The width of the border, in pixels.
    pub border: geometry.Edges = geometry.Edges {}
    /// The space between consecutive children along the main axis, in pixels.
    pub gap: f32 = 0.0
}

struct Node {
    style: Style
    children: []i64
    measure: fn(f32) -> geometry.Size
    rect: geometry.Rect
}

/// A set of styled nodes and the rectangles `compute` gives them.
///
/// Nodes are named by the index `node` and `leaf` return. A tree is built for a frame, laid out once and read through `rect` and `content`.
pub struct Tree {
    nodes: []Node
}

struct Item {
    node: i64
    base: f32
    low: f32
    high: f32
    grow: f32
    shrink: f32
    target: f32
    frozen: bool
    start: f32
    end: f32
    cross: f32
    cross_start: f32
    cross_end: f32
    align: Align
}

struct Line {
    items: []Item
    main: f32
    cross: f32
}

struct Spread {
    lead: f32
    step: f32
}

struct Span {
    start: f32
    size: f32
    known: bool
}

struct Axes {
    main: f32
    cross: f32
}

struct Known {
    width: bool
    height: bool
}

enum Role {
    InFlow
    Floating
    Hidden
}

/// Returns an empty tree.
pub fn tree() -> Tree {
    Tree { nodes: [] }
}

/// Adds a container with the given children, which are indices returned by earlier calls, and returns its index.
///
/// A container with no children has no content and is as large as its padding and border.
pub fn node(mut t: Tree, style: Style, children: []i64) -> i64 {
    add(mut t, style, children, no_content)
}

/// Adds a leaf and returns its index.
///
/// `measure` takes the width available to the leaf's content, `unbounded` when there is no limit, and returns the content size. Its height may depend on the width, as wrapped text does.
pub fn leaf(mut t: Tree, style: Style, measure: fn(f32) -> geometry.Size) -> i64 {
    add(mut t, style, [], measure)
}

/// The width that stands for no limit: positive infinity.
pub const unbounded: f32 = 1.0 / 0.0

/// Returns `true` when `width` is a limit rather than `unbounded`.
pub fn is_bounded(width: f32) -> bool {
    width < unbounded
}

/// Places `root` and everything under it in a window of `available` logical pixels.
///
/// A root with an `Auto` size fills `available` less its margin. Every node's rectangle is replaced, so a tree may be computed again for a new size.
pub fn compute(mut t: Tree, root: i64, available: geometry.Size) {
    let s = t.nodes[root].style
    if role(s) == Hidden {
        hide(mut t, root)
        return
    }
    let own_width = resolve(s.width, available.width)
    let own_height = resolve(s.height, available.height)
    let width = clamp_axis(s, true, own_width ?? root_fill(t, root, true, available.width, 0.0), available.width)
    let height = clamp_axis(s, false, own_height ?? root_fill(t, root, false, available.height, width), available.height)
    let known = Known { width: own_width != none || is_bounded(available.width), height: own_height != none || is_bounded(available.height) }
    place(mut t, root, s.margin.left, s.margin.top, width, height, known)
}

/// Returns the border box of `node` in logical pixels from the top left of the window.
pub fn rect(t: Tree, node: i64) -> geometry.Rect {
    t.nodes[node].rect
}

/// Returns the content box of `node`: its border box less its border and padding.
pub fn content(t: Tree, node: i64) -> geometry.Rect {
    let n = t.nodes[node]
    content_box(n.rect, n.style)
}

fn add(mut t: Tree, style: Style, children: []i64, measure: fn(f32) -> geometry.Size) -> i64 {
    push(mut t.nodes, Node { style, children, measure, rect: geometry.Rect {} })
    t.nodes.len - 1
}

fn no_content(width: f32) -> geometry.Size {
    geometry.Size {}
}

fn larger(a: f32, b: f32) -> f32 {
    if a > b { a } else { b }
}

fn smaller(a: f32, b: f32) -> f32 {
    if a < b { a } else { b }
}

fn magnitude(v: f32) -> f32 {
    if v < 0.0 { -v } else { v }
}

fn role(s: Style) -> Role {
    if s.display == None {
        Hidden
    } else if s.position == Absolute {
        Floating
    } else {
        InFlow
    }
}

fn resolve(d: Dimension, base: f32) -> f32? {
    match d {
        Auto => none
        Px(v) => v
        Percent(p) => if is_bounded(base) { base * p / 100.0 } else { none }
    }
}

fn size_dim(s: Style, horizontal: bool) -> Dimension {
    if horizontal { s.width } else { s.height }
}

fn min_dim(s: Style, horizontal: bool) -> Dimension {
    if horizontal { s.min_width } else { s.min_height }
}

fn max_dim(s: Style, horizontal: bool) -> Dimension {
    if horizontal { s.max_width } else { s.max_height }
}

fn inset_lead(i: Inset, horizontal: bool) -> Dimension {
    if horizontal { i.left } else { i.top }
}

fn inset_trail(i: Inset, horizontal: bool) -> Dimension {
    if horizontal { i.right } else { i.bottom }
}

fn edge_sum(e: geometry.Edges, horizontal: bool) -> f32 {
    if horizontal { geometry.horizontal(e) } else { geometry.vertical(e) }
}

fn edge_lead(e: geometry.Edges, horizontal: bool) -> f32 {
    if horizontal { e.left } else { e.top }
}

fn edge_trail(e: geometry.Edges, horizontal: bool) -> f32 {
    if horizontal { e.right } else { e.bottom }
}

fn frame(s: Style, horizontal: bool) -> f32 {
    edge_sum(s.padding, horizontal) + edge_sum(s.border, horizontal)
}

fn content_box(outer: geometry.Rect, s: Style) -> geometry.Rect {
    let frame_edges = geometry.Edges {
        top: s.padding.top + s.border.top
        right: s.padding.right + s.border.right
        bottom: s.padding.bottom + s.border.bottom
        left: s.padding.left + s.border.left
    }
    geometry.inset(outer, frame_edges)
}

fn low_bound(s: Style, horizontal: bool, base: f32) -> f32 {
    larger(resolve(min_dim(s, horizontal), base) ?? 0.0, frame(s, horizontal))
}

fn high_bound(s: Style, horizontal: bool, base: f32) -> f32 {
    resolve(max_dim(s, horizontal), base) ?? unbounded
}

fn clamp_axis(s: Style, horizontal: bool, v: f32, base: f32) -> f32 {
    larger(low_bound(s, horizontal, base), smaller(v, high_bound(s, horizontal, base)))
}

fn gap_total(gap: f32, count: i64) -> f32 {
    if count > 1 { gap * f32(count - 1) } else { 0.0 }
}

fn with_align(own: AlignSelf, items: Align) -> Align {
    match own {
        Auto => items
        Start => Start
        End => End
        Center => Center
        Stretch => Stretch
    }
}

fn unstretched(a: Align) -> Align {
    if a == Stretch { Start } else { a }
}

fn spread_align(j: Justify) -> Align {
    match j {
        Start => Start
        End => End
        Center => Center
        SpaceBetween => Start
        SpaceAround => Center
        SpaceEvenly => Center
    }
}

fn align_offset(a: Align, room: f32, size: f32) -> f32 {
    match a {
        Start => 0.0
        End => room - size
        Center => (room - size) / 2.0
        Stretch => 0.0
    }
}

fn root_fill(t: Tree, n: i64, horizontal: bool, available: f32, width: f32) -> f32 {
    let s = t.nodes[n].style
    let room = available - edge_sum(s.margin, horizontal)
    if is_bounded(room) {
        room
    } else if horizontal {
        content_width(t, n)
    } else {
        content_height(t, n, width)
    }
}

fn content_width(t: Tree, n: i64) -> f32 {
    let node = t.nodes[n]
    if node.children.len == 0 {
        return node.measure(unbounded).width + frame(node.style, true)
    }
    let row = node.style.direction == Row
    var total: f32 = 0.0
    var count = 0
    for c in node.children {
        if role(t.nodes[c].style) == InFlow {
            let outer = outer_width(t, c, row)
            total = if row { total + outer } else { larger(total, outer) }
            count += 1
        }
    }
    let gaps = if row { gap_total(node.style.gap, count) } else { 0.0 }
    total + gaps + frame(node.style, true)
}

fn outer_width(t: Tree, c: i64, row: bool) -> f32 {
    let s = t.nodes[c].style
    let size = if row {
        clamp_axis(s, true, base_width(t, c, s, unbounded), unbounded)
    } else {
        clamp_axis(s, true, resolve(s.width, unbounded) ?? content_width(t, c), unbounded)
    }
    size + edge_sum(s.margin, true)
}

fn base_width(t: Tree, c: i64, s: Style, base: f32) -> f32 {
    resolve(s.basis, base) ?? resolve(s.width, base) ?? content_width(t, c)
}

fn base_height(t: Tree, c: i64, s: Style, base: f32, width: f32) -> f32 {
    resolve(s.basis, base) ?? resolve(s.height, base) ?? content_height(t, c, width)
}

fn content_height(t: Tree, n: i64, width: f32) -> f32 {
    let node = t.nodes[n]
    let s = node.style
    let inner = larger(width - frame(s, true), 0.0)
    if node.children.len == 0 {
        return node.measure(inner).height + frame(s, false)
    }
    let space = geometry.Size { width: inner, height: unbounded }
    let line = arrange(t, n, space, space)
    let used = if s.direction == Row { line.cross } else { line.main }
    used + frame(s, false)
}

fn axes(row: bool, size: geometry.Size) -> Axes {
    if row {
        Axes { main: size.width, cross: size.height }
    } else {
        Axes { main: size.height, cross: size.width }
    }
}

fn arrange(t: Tree, n: i64, inner: geometry.Size, percent: geometry.Size) -> Line {
    let node = t.nodes[n]
    let s = node.style
    let row = s.direction == Row
    let space = axes(row, inner)
    let base = axes(row, percent)
    var items: []Item = []
    for c in node.children {
        if role(t.nodes[c].style) == InFlow {
            push(mut items, item(t, c, row, s.align_items, space, base))
        }
    }
    let gaps = gap_total(s.gap, items.len)
    if is_bounded(space.main) {
        flex(items, space.main - gaps)
    }
    if row {
        for i in 0..items.len {
            items[i].cross = cross_size(t, items[i].node, row, items[i].align, space.cross, base.cross, items[i].target)
        }
    }
    var main = gaps
    var cross: f32 = 0.0
    for it in items {
        main += it.target + it.start + it.end
        cross = larger(cross, it.cross + it.cross_start + it.cross_end)
    }
    Line { items, main, cross }
}

fn item(t: Tree, c: i64, row: bool, align_items: Align, space: Axes, percent: Axes) -> Item {
    let s = t.nodes[c].style
    let align = with_align(s.align_self, align_items)
    let cross = if row { 0.0 } else { cross_size(t, c, row, align, space.cross, percent.cross, 0.0) }
    let base = if row { base_width(t, c, s, percent.main) } else { base_height(t, c, s, percent.main, cross) }
    let low = low_bound(s, row, percent.main)
    let high = high_bound(s, row, percent.main)
    Item {
        node: c
        base
        low
        high
        grow: larger(s.grow, 0.0)
        shrink: larger(s.shrink, 0.0)
        target: larger(low, smaller(base, high))
        frozen: false
        start: edge_lead(s.margin, row)
        end: edge_trail(s.margin, row)
        cross
        cross_start: edge_lead(s.margin, !row)
        cross_end: edge_trail(s.margin, !row)
        align
    }
}

fn cross_size(t: Tree, c: i64, row: bool, align: Align, inner_cross: f32, percent_cross: f32, main: f32) -> f32 {
    let s = t.nodes[c].style
    let horizontal = !row
    let room = inner_cross - edge_sum(s.margin, horizontal)
    let raw = resolve(size_dim(s, horizontal), percent_cross) ?? auto_cross(t, c, row, align, room, main)
    clamp_axis(s, horizontal, raw, percent_cross)
}

fn auto_cross(t: Tree, c: i64, row: bool, align: Align, room: f32, main: f32) -> f32 {
    if align == Stretch && is_bounded(room) {
        room
    } else if row {
        content_height(t, c, main)
    } else {
        smaller(content_width(t, c), room)
    }
}

fn limit(it: Item, v: f32) -> f32 {
    larger(it.low, smaller(v, it.high))
}

fn factor(it: Item, growing: bool) -> f32 {
    if growing { it.grow } else { it.shrink }
}

fn weight(it: Item, growing: bool) -> f32 {
    if growing { it.grow } else { it.shrink * it.base }
}

fn flex(items: []Item, space: f32) {
    var hypothetical: f32 = 0.0
    for it in items {
        hypothetical += limit(it, it.base) + it.start + it.end
    }
    let growing = hypothetical < space
    for i in 0..items.len {
        items[i] = seeded(items[i], growing)
    }
    let initial = free_space(items, space)
    for round in 0..items.len {
        if unfrozen(items) == 0 {
            break
        }
        share_out(items, space, growing, initial)
        fix_violations(items)
    }
}

fn seeded(it: Item, growing: bool) -> Item {
    let hypothetical = limit(it, it.base)
    let inflexible = factor(it, growing) == 0.0 || (growing && it.base > hypothetical) || (!growing && it.base < hypothetical)
    var out = it
    out.frozen = inflexible
    out.target = if inflexible { hypothetical } else { it.base }
    out
}

fn unfrozen(items: []Item) -> i64 {
    var count = 0
    for it in items {
        if !it.frozen {
            count += 1
        }
    }
    count
}

fn free_space(items: []Item, space: f32) -> f32 {
    var free = space
    for it in items {
        free -= it.start + it.end + (if it.frozen { it.target } else { it.base })
    }
    free
}

fn share_out(items: []Item, space: f32, growing: bool, initial: f32) {
    var remaining = free_space(items, space)
    var factors: f32 = 0.0
    var weights: f32 = 0.0
    for it in items {
        if !it.frozen {
            factors += factor(it, growing)
            weights += weight(it, growing)
        }
    }
    if factors < 1.0 && magnitude(initial * factors) < magnitude(remaining) {
        remaining = initial * factors
    }
    for i in 0..items.len {
        if !items[i].frozen {
            items[i].target = shared(items[i], remaining, growing, weights)
        }
    }
}

fn shared(it: Item, remaining: f32, growing: bool, weights: f32) -> f32 {
    if weights <= 0.0 {
        return it.base
    }
    let part = remaining * weight(it, growing) / weights
    if growing { it.base + part } else { it.base - magnitude(part) }
}

fn fix_violations(items: []Item) {
    var total: f32 = 0.0
    for it in items {
        if !it.frozen {
            total += limit(it, it.target) - it.target
        }
    }
    for i in 0..items.len {
        let it = items[i]
        if !it.frozen {
            let clamped = limit(it, it.target)
            let violation = clamped - it.target
            items[i].target = clamped
            items[i].frozen = total == 0.0 || (total > 0.0 && violation > 0.0) || (total < 0.0 && violation < 0.0)
        }
    }
}

fn justify(j: Justify, free: f32, count: i64, gap: f32) -> Spread {
    let plain = Spread { lead: 0.0, step: gap }
    match j {
        Start => plain
        End => Spread { lead: free, step: gap }
        Center => Spread { lead: free / 2.0, step: gap }
        SpaceBetween => if free > 0.0 && count > 1 { Spread { lead: 0.0, step: gap + free / f32(count - 1) } } else { plain }
        SpaceAround => if free > 0.0 { Spread { lead: free / f32(count) / 2.0, step: gap + free / f32(count) } } else { plain }
        SpaceEvenly => if free > 0.0 { Spread { lead: free / f32(count + 1), step: gap + free / f32(count + 1) } } else { plain }
    }
}

fn place(mut t: Tree, n: i64, x: f32, y: f32, width: f32, height: f32, known: Known) {
    let outer = geometry.Rect { x, y, width, height }
    t.nodes[n].rect = outer
    let node = t.nodes[n]
    if node.children.len == 0 {
        return
    }
    let s = node.style
    let content = content_box(outer, s)
    let inner = geometry.Size { width: content.width, height: content.height }
    let percent = geometry.Size {
        width: if known.width { content.width } else { unbounded }
        height: if known.height { content.height } else { unbounded }
    }
    let line = arrange(t, n, inner, percent)
    place_items(mut t, s, content, percent, line)
    for c in node.children {
        let r = role(t.nodes[c].style)
        if r == Floating {
            place_floating(mut t, c, s, geometry.inset(outer, s.border), content)
        } else if r == Hidden {
            hide(mut t, c)
        }
    }
}

fn place_items(mut t: Tree, s: Style, content: geometry.Rect, percent: geometry.Size, line: Line) {
    if line.items.len == 0 {
        return
    }
    let row = s.direction == Row
    let main_room = if row { content.width } else { content.height }
    let cross_room = if row { content.height } else { content.width }
    let spread = justify(s.justify, main_room - line.main, line.items.len, s.gap)
    var cursor = (if row { content.x } else { content.y }) + spread.lead
    let cross_origin = if row { content.y } else { content.x }
    for it in line.items {
        let outer_cross = it.cross + it.cross_start + it.cross_end
        let across = cross_origin + align_offset(it.align, cross_room, outer_cross) + it.cross_start
        let along = cursor + it.start
        let known = child_known(t.nodes[it.node].style, row, it, percent)
        if row {
            place(mut t, it.node, along, across, it.target, it.cross, known)
        } else {
            place(mut t, it.node, across, along, it.cross, it.target, known)
        }
        cursor += it.start + it.target + it.end + spread.step
    }
}

fn child_known(s: Style, row: bool, it: Item, percent: geometry.Size) -> Known {
    let space = axes(row, percent)
    let main = is_bounded(space.main) || resolve(size_dim(s, row), space.main) != none
    let cross = resolve(size_dim(s, !row), space.cross) != none || (it.align == Stretch && is_bounded(space.cross))
    if row { Known { width: main, height: cross } } else { Known { width: cross, height: main } }
}

fn place_floating(mut t: Tree, c: i64, parent: Style, padding_box: geometry.Rect, content: geometry.Rect) {
    let row = parent.direction == Row
    let main_align = spread_align(parent.justify)
    let cross_align = unstretched(with_align(t.nodes[c].style.align_self, parent.align_items))
    let horizontal = floating_span(t, c, true, padding_box, content, 0.0, if row { main_align } else { cross_align })
    let vertical = floating_span(t, c, false, padding_box, content, horizontal.size, if row { cross_align } else { main_align })
    let known = Known { width: horizontal.known, height: vertical.known }
    place(mut t, c, horizontal.start, vertical.start, horizontal.size, vertical.size, known)
}

fn floating_span(t: Tree, c: i64, horizontal: bool, padding_box: geometry.Rect, content: geometry.Rect, width: f32, align: Align) -> Span {
    let s = t.nodes[c].style
    let origin = if horizontal { padding_box.x } else { padding_box.y }
    let extent = if horizontal { padding_box.width } else { padding_box.height }
    let first = resolve(inset_lead(s.inset, horizontal), extent)
    let last = resolve(inset_trail(s.inset, horizontal), extent)
    let before = edge_lead(s.margin, horizontal)
    let after = edge_trail(s.margin, horizontal)
    let room = extent - before - after - (first ?? 0.0) - (last ?? 0.0)
    let between: f32? = if first != none && last != none { room } else { none }
    let own = resolve(size_dim(s, horizontal), extent) ?? between
    let raw = own ?? floating_fit(t, c, horizontal, width, room)
    let size = clamp_axis(s, horizontal, raw, extent)
    let start = match first {
        some(v) => origin + v + before
        none => match last {
            some(v) => origin + extent - v - after - size
            none => {
                let content_origin = if horizontal { content.x } else { content.y }
                let content_extent = if horizontal { content.width } else { content.height }
                content_origin + before + align_offset(align, content_extent, before + size + after)
            }
        }
    }
    Span { start, size, known: own != none }
}

fn floating_fit(t: Tree, c: i64, horizontal: bool, width: f32, room: f32) -> f32 {
    if horizontal { smaller(content_width(t, c), room) } else { content_height(t, c, width) }
}

fn hide(mut t: Tree, n: i64) {
    t.nodes[n].rect = geometry.Rect {}
    for c in t.nodes[n].children {
        hide(mut t, c)
    }
}
