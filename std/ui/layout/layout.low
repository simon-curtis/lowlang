import std/ui/geometry

/// Whether a node takes part in layout.
pub enum Display {
    /// The node is a flex container, or a leaf when it has no children.
    Flex
    /// The node and its subtree take no space and get empty rectangles at the top left of the node's parent.
    None
}

/// How a node is positioned within its parent.
pub enum Position {
    /// The node is a flex item of its parent.
    Relative
    /// The node leaves the flow and is placed against its parent's padding box by its `inset`.
    Absolute
}

/// The main axis of a flex container.
pub enum Direction {
    /// Children run left to right.
    Row
    /// Children run top to bottom.
    Column
}

/// Whether a flex container breaks its children onto further lines.
pub enum Wrap {
    /// All children share one line.
    Single
    /// Children that do not fit the main axis start a new line.
    Multi
}

/// How a container distributes free space along its main axis.
///
/// When the children overflow, `Center` and `End` still offset them by the negative free space, and the three spaced values place them as `Start`.
pub enum Justify {
    /// Children sit at the start of the main axis.
    Start
    /// Children sit at the end of the main axis.
    End
    /// Children sit in the middle of the main axis.
    Center
    /// Free space goes between the children, none before the first or after the last.
    SpaceBetween
    /// Free space goes around each child, half of a share at each end.
    SpaceAround
    /// Free space goes in equal shares before, between and after the children.
    SpaceEvenly
}

/// How a wrapping container distributes free cross space between its lines.
pub enum AlignContent {
    /// Lines sit at the start of the cross axis.
    Start
    /// Lines sit at the end of the cross axis.
    End
    /// Lines sit in the middle of the cross axis.
    Center
    /// Lines grow by equal amounts to fill the container's inner cross size.
    Stretch
    /// Free space goes between the lines.
    SpaceBetween
    /// Free space goes around each line, half of a share at each end.
    SpaceAround
    /// Free space goes in equal shares before, between and after the lines.
    SpaceEvenly
}

/// How a container places its children along its cross axis.
pub enum Align {
    /// Children sit at the start of the cross axis.
    Start
    /// Children sit at the end of the cross axis.
    End
    /// Children sit in the middle of the cross axis.
    Center
    /// Children with an `Auto` cross size grow to the line's cross size.
    Stretch
}

/// A child's own cross alignment.
pub enum AlignSelf {
    /// The container's `align_items`.
    Auto
    /// The child sits at the start of the cross axis.
    Start
    /// The child sits at the end of the cross axis.
    End
    /// The child sits in the middle of the cross axis.
    Center
    /// The child grows to the line's cross size when its cross size is `Auto`.
    Stretch
}

/// What a node does with content that does not fit it along one axis.
pub enum Overflow {
    /// The content shows outside the node, and the node is never smaller along its parent's main axis than its content's narrowest size.
    Visible
    /// The content is cut off at the padding box, and the node may shrink below its content.
    Hidden
    /// The content is cut off at the padding box and can be scrolled, and the node may shrink below its content.
    Scroll
}

/// A length along one axis.
pub enum Dimension {
    /// Not set: the node's content decides for a size, and the box has no minimum or maximum. As a margin it absorbs free space.
    Auto
    /// A length in the unit of the tree.
    Px(f32)
    /// A percentage of a reference length, where `50.0` is half of it. Against an unknown length it behaves as `Auto`.
    Percent(f32)
}

/// The offsets of an absolute node from the sides of its parent's padding box.
pub struct Inset {
    /// The distance from the top edge, or `Auto`.
    pub top: Dimension = Auto
    /// The distance from the right edge, or `Auto`.
    pub right: Dimension = Auto
    /// The distance from the bottom edge, or `Auto`.
    pub bottom: Dimension = Auto
    /// The distance from the left edge, or `Auto`.
    pub left: Dimension = Auto
}

/// The margin on each side of a node. A negative length pulls the node over its neighbours and an `Auto` side absorbs free space.
pub struct Margin {
    /// The margin above the node.
    pub top: Dimension = Px(0.0)
    /// The margin right of the node.
    pub right: Dimension = Px(0.0)
    /// The margin below the node.
    pub bottom: Dimension = Px(0.0)
    /// The margin left of the node.
    pub left: Dimension = Px(0.0)
}

/// The layout properties of one node.
///
/// Sizes, minimums, maximums and `basis` are border-box lengths. Percentages refer to the parent's inner size on the same axis, or to the padding box for an absolute node. A box is never smaller than its padding and border.
pub struct Style {
    /// Whether the node takes part in layout.
    pub display: Display = Flex
    /// Whether the node is a flex item or leaves the flow.
    pub position: Position = Relative
    /// The offsets of an absolute node, or of a relative node from its place in the flow. When both sides of an axis are set on an absolute node, the pair sizes an `Auto` size.
    pub inset: Inset = Inset {}
    /// The main axis of the node's children.
    pub direction: Direction = Row
    /// Whether the node's children wrap onto further lines.
    pub wrap: Wrap = Single
    /// How the node distributes free space along its main axis.
    pub justify: Justify = Start
    /// How the node aligns its children along its cross axis.
    pub align_items: Align = Stretch
    /// How a wrapping node distributes free cross space between its lines.
    pub align_content: AlignContent = Stretch
    /// This node's cross alignment within its parent.
    pub align_self: AlignSelf = Auto
    /// The share of positive free space this node takes, relative to its siblings.
    pub grow: f32 = 0.0
    /// The share of negative free space this node gives up, weighted by its basis.
    pub shrink: f32 = 1.0
    /// The starting main size before free space is shared; `Auto` uses the main size, then the content.
    pub basis: Dimension = Auto
    /// The width of the border box.
    pub width: Dimension = Auto
    /// The height of the border box.
    pub height: Dimension = Auto
    /// The smallest width; `Auto` is the automatic minimum along a parent row's main axis, else zero.
    pub min_width: Dimension = Auto
    /// The smallest height; `Auto` is the automatic minimum along a parent column's main axis, else zero.
    pub min_height: Dimension = Auto
    /// The largest width; `Auto` is unlimited.
    pub max_width: Dimension = Auto
    /// The largest height; `Auto` is unlimited.
    pub max_height: Dimension = Auto
    /// The space outside the border box. It counts towards the node's outer size.
    pub margin: Margin = Margin {}
    /// The space between the border and the content.
    pub padding: geometry.Edges = geometry.Edges {}
    /// The width of the border.
    pub border: geometry.Edges = geometry.Edges {}
    /// The space between consecutive children along a row.
    pub column_gap: f32 = 0.0
    /// The space between consecutive children along a column, and between lines of a row.
    pub row_gap: f32 = 0.0
    /// What the node does with content wider than its padding box.
    pub overflow_x: Overflow = Visible
    /// What the node does with content taller than its padding box.
    pub overflow_y: Overflow = Visible
}

/// What a leaf is measured against: the width its content may use, or `unbounded` when there is no limit, as when the leaf is asked for its widest or narrowest layout.
pub const unbounded: f32 = 1.0 / 0.0

enum Avail {
    Definite(f32)
    MinContent
    MaxContent
}

struct Dims {
    width: f32? = none
    height: f32? = none
}

struct Space {
    width: Avail = MaxContent
    height: Avail = MaxContent
}

enum Sizing {
    ContentSize
    InherentSize
}

enum Axis {
    Both
    Horizontal
    Vertical
}

enum Run {
    ComputeSize
    PerformLayout
}

struct Known {
    width: bool = true
    height: bool = true
}

struct Input {
    known: Dims
    definite: Known
    parent: Dims
    space: Space
    sizing: Sizing
    axis: Axis
    run: Run
}

struct Slot {
    tag: i64
    value: f32
}

struct Key {
    width: Slot
    height: Slot
    parent_width: f32?
    parent_height: f32?
    definite: Known
    axis: Axis
}

struct Entry {
    key: Key
    size: geometry.Size
}

struct Cache {
    inherent: bool
    layout: Entry[]
    measures: Entry[]
    next: i64
}

struct Node {
    style: Style
    auto_width: bool
    auto_height: bool
    children: i64[]
    measure: fn(f32) -> geometry.Size
    cache: Cache
    size: geometry.Size
    location: geometry.Point
    rect: geometry.Rect
}

/// A set of styled nodes and the rectangles `compute` gives them.
///
/// Nodes are named by the index `node` and `leaf` return. A tree is built for a frame, laid out once and read through `rect` and `content`.
///
/// Styles and measured sizes are in logical pixels. The tree rounds each authored length to whole device pixels as it takes a node, lays the nodes out in device pixels, and `rect` returns every border box with its edges snapped to whole device pixels, in logical pixels again.
pub struct Tree {
    nodes: Node[]
    scale: f32
}

/// Returns an empty tree whose lengths are rounded to the device pixels of a display with `scale` device pixels per logical pixel.
pub fn tree(scale: f32) -> Tree {
    Tree { nodes: [], scale }
}

/// Adds a container with the given children, which are indices returned by earlier calls, and returns its index.
///
/// A container with no children has no content and is as large as its padding and border.
pub fn node(mut t: Tree, style: Style, children: i64[]) -> i64 {
    add(mut t, style, children, no_content)
}

/// Adds a leaf and returns its index.
///
/// `measure` takes the width available to the leaf's content, or `unbounded` when there is no limit, and returns the content size. Its height may depend on the width, as wrapped text does. Both are in logical pixels, and the size the tree uses is rounded up to whole device pixels.
pub fn leaf(mut t: Tree, style: Style, measure: fn(f32) -> geometry.Size) -> i64 {
    let scale = t.scale
    let in_device_pixels = fn(w: f32) -> geometry.Size {
        let size = measure(w / scale)
        geometry.Size { width: ceiling(larger(size.width, 0.0) * scale), height: ceiling(larger(size.height, 0.0) * scale) }
    }
    add(mut t, style, [], in_device_pixels)
}

/// Returns `true` when `width` is a limit rather than `unbounded`.
pub fn is_bounded(width: f32) -> bool {
    width < unbounded
}

/// Places `root` and everything under it in a window of `window` logical pixels.
///
/// A root with an `Auto` width or height is as large as the window along that axis, rounded to whole device pixels, and as large as its content along an axis where the window is `unbounded`. Every node's rectangle is replaced, so a tree may be computed again for a new size.
pub fn compute(mut t: Tree, root: i64, window: geometry.Size) {
    reset(mut t)
    let scale = t.scale
    if t.nodes[root].auto_width {
        t.nodes[root].style.width = fill(window.width, scale)
    }
    if t.nodes[root].auto_height {
        t.nodes[root].style.height = fill(window.height, scale)
    }
    let space = Space { width: avail_of(window.width * scale), height: avail_of(window.height * scale) }
    let own = t.nodes[root].style
    if own.display == None {
        hide(mut t, root)
        return
    }
    let basis = Dims { width: definite_of(space.width), height: definite_of(space.height) }
    let margin = resolve_edges(own.margin, basis.width)
    let root_space = Space {
        width: reduce(space.width, geometry.horizontal(margin))
        height: reduce(space.height, geometry.vertical(margin))
    }
    let input = Input {
        known: Dims {}
        definite: Known {}
        parent: basis
        space: root_space
        sizing: InherentSize
        axis: Both
        run: PerformLayout
    }
    let size = compute_child(mut t, root, input)
    var left = margin.left
    var top = margin.top
    if own.position == Relative {
        let first_x = resolve(own.inset.left, basis.width)
        let last_x = resolve(own.inset.right, basis.width)
        let first_y = resolve(own.inset.top, basis.height)
        let last_y = resolve(own.inset.bottom, basis.height)
        left += first_x ?? (negated(last_x) ?? 0.0)
        top += first_y ?? (negated(last_y) ?? 0.0)
    }
    t.nodes[root].size = size
    t.nodes[root].location = geometry.Point { x: left, y: top }
    settle(mut t, root, 0.0, 0.0)
}

/// Returns the border box of `node` from the top left of the window, in logical pixels, with each edge on a whole device pixel.
///
/// An edge is rounded where it lies in the window and not where it lies in its parent, so edges that meet in the window are rounded alike. A tie rounds toward zero.
pub fn rect(t: Tree, node: i64) -> geometry.Rect {
    t.nodes[node].rect
}

/// Returns the content box of `node`: its border box less its border and padding.
pub fn content(t: Tree, node: i64) -> geometry.Rect {
    let n = t.nodes[node]
    let e = sum_edges(n.style.padding, n.style.border)
    let scale = t.scale
    geometry.Rect {
        x: n.rect.x + e.left / scale
        y: n.rect.y + e.top / scale
        width: n.rect.width - (e.left + e.right) / scale
        height: n.rect.height - (e.top + e.bottom) / scale
    }
}

fn add(mut t: Tree, style: Style, children: i64[], measure: fn(f32) -> geometry.Size) -> i64 {
    let device = device_style(style, t.scale)
    t.nodes.push(Node {
        style: device
        auto_width: is_auto(style.width)
        auto_height: is_auto(style.height)
        children
        measure
        cache: Cache { inherent: false, layout: [], measures: [], next: 0 }
        size: geometry.Size {}
        location: geometry.Point {}
        rect: geometry.Rect {}
    })
    t.nodes.len - 1
}

fn no_content(width: f32) -> geometry.Size {
    geometry.Size {}
}

fn larger(a: f32, b: f32) -> f32 {
    if a > b { a } else { b }
}

fn smaller(a: f32, b: f32) -> f32 {
    if a < b { a } else { b }
}

fn magnitude(v: f32) -> f32 {
    if v < 0.0 { -v } else { v }
}

fn is_normal(v: f32) -> bool {
    v == v && magnitude(v) < unbounded && magnitude(v) >= 1.17549435e-38
}

fn avail_of(v: f32) -> Avail {
    if is_bounded(v) { Avail.Definite(v) } else { Avail.MaxContent }
}

fn definite_of(a: Avail) -> f32? {
    match a {
        Definite(v) => v
        _ => none
    }
}

fn reduce(a: Avail, by: f32) -> Avail {
    match a {
        Definite(v) => Avail.Definite(larger(v - by, 0.0))
        MinContent => MinContent
        MaxContent => MaxContent
    }
}

fn is_min_content(a: Avail) -> bool {
    match a {
        MinContent => true
        _ => false
    }
}

fn is_definite(a: Avail) -> bool {
    match a {
        Definite(v) => true
        _ => false
    }
}

fn negated(v: f32?) -> f32? {
    match v {
        some(x) => -x
        none => none
    }
}

fn resolve(d: Dimension, base: f32?) -> f32? {
    match d {
        Auto => none
        Px(v) => v
        Percent(p) => match base {
            some(b) => b * (p / 100.0)
            none => none
        }
    }
}

fn is_auto(d: Dimension) -> bool {
    match d {
        Auto => true
        _ => false
    }
}

fn resolve_zero(d: Dimension, base: f32?) -> f32 {
    resolve(d, base) ?? 0.0
}

fn resolve_edges(m: Margin, base: f32?) -> geometry.Edges {
    geometry.Edges {
        top: resolve_zero(m.top, base)
        right: resolve_zero(m.right, base)
        bottom: resolve_zero(m.bottom, base)
        left: resolve_zero(m.left, base)
    }
}

fn edge_sum(e: geometry.Edges, horizontal: bool) -> f32 {
    if horizontal { geometry.horizontal(e) } else { geometry.vertical(e) }
}

fn edge_lead(e: geometry.Edges, horizontal: bool) -> f32 {
    if horizontal { e.left } else { e.top }
}

fn edge_trail(e: geometry.Edges, horizontal: bool) -> f32 {
    if horizontal { e.right } else { e.bottom }
}

fn sum_edges(a: geometry.Edges, b: geometry.Edges) -> geometry.Edges {
    geometry.Edges { top: a.top + b.top, right: a.right + b.right, bottom: a.bottom + b.bottom, left: a.left + b.left }
}

fn reset(mut t: Tree) {
    for i in 0..t.nodes.len {
        t.nodes[i].cache = Cache { inherent: false, layout: [], measures: [], next: 0 }
        t.nodes[i].size = geometry.Size {}
        t.nodes[i].location = geometry.Point {}
        t.nodes[i].rect = geometry.Rect {}
    }
}

fn hide(mut t: Tree, n: i64) {
    t.nodes[n].size = geometry.Size {}
    t.nodes[n].location = geometry.Point {}
    t.nodes[n].rect = geometry.Rect {}
    t.nodes[n].cache = Cache { inherent: false, layout: [], measures: [], next: 0 }
    for c in t.nodes[n].children {
        hide(mut t, c)
    }
}

fn park(mut t: Tree, n: i64, x: f32, y: f32) {
    let scale = t.scale
    let device = geometry.snap(geometry.Rect { x, y, width: 0.0, height: 0.0 }, 1.0)
    t.nodes[n].rect = geometry.Rect { x: device.x / scale, y: device.y / scale, width: 0.0, height: 0.0 }
    for c in t.nodes[n].children {
        park(mut t, c, x, y)
    }
}

fn settle(mut t: Tree, n: i64, x: f32, y: f32) {
    if t.nodes[n].style.display == None {
        hide(mut t, n)
        park(mut t, n, x, y)
        return
    }
    let left = x + t.nodes[n].location.x
    let top = y + t.nodes[n].location.y
    let size = t.nodes[n].size
    let device = geometry.snap(geometry.Rect { x: left, y: top, width: size.width, height: size.height }, 1.0)
    let scale = t.scale
    t.nodes[n].rect = geometry.Rect { x: device.x / scale, y: device.y / scale, width: device.width / scale, height: device.height / scale }
    for c in t.nodes[n].children {
        settle(mut t, c, left, top)
    }
}

fn fill(window: f32, scale: f32) -> Dimension {
    if is_bounded(window) {
        return Dimension.Px(geometry.round_half_to_zero(window * scale))
    }
    Dimension.Auto
}

fn ceiling(v: f32) -> f32 {
    -floor(-v)
}

fn device_length(d: Dimension, scale: f32) -> Dimension {
    match d {
        Px(v) => Dimension.Px(geometry.round_half_to_zero(v * scale))
        _ => d
    }
}

fn device_edges(e: geometry.Edges, scale: f32) -> geometry.Edges {
    geometry.Edges {
        top: geometry.round_half_to_zero(e.top * scale)
        right: geometry.round_half_to_zero(e.right * scale)
        bottom: geometry.round_half_to_zero(e.bottom * scale)
        left: geometry.round_half_to_zero(e.left * scale)
    }
}

fn device_style(s: Style, scale: f32) -> Style {
    var out = s
    out.inset = Inset {
        top: device_length(s.inset.top, scale)
        right: device_length(s.inset.right, scale)
        bottom: device_length(s.inset.bottom, scale)
        left: device_length(s.inset.left, scale)
    }
    out.margin = Margin {
        top: device_length(s.margin.top, scale)
        right: device_length(s.margin.right, scale)
        bottom: device_length(s.margin.bottom, scale)
        left: device_length(s.margin.left, scale)
    }
    out.basis = device_length(s.basis, scale)
    out.width = device_length(s.width, scale)
    out.height = device_length(s.height, scale)
    out.min_width = device_length(s.min_width, scale)
    out.min_height = device_length(s.min_height, scale)
    out.max_width = device_length(s.max_width, scale)
    out.max_height = device_length(s.max_height, scale)
    out.padding = device_edges(s.padding, scale)
    out.border = geometry.snap_edges(s.border, scale)
    out.column_gap = geometry.round_half_to_zero(s.column_gap * scale)
    out.row_gap = geometry.round_half_to_zero(s.row_gap * scale)
    out
}

fn slot_of(known: f32?, space: Avail) -> Slot {
    match known {
        some(v) => Slot { tag: 0, value: v }
        none => match space {
            Definite(v) => Slot { tag: 1, value: v }
            MinContent => Slot { tag: 2, value: 0.0 }
            MaxContent => Slot { tag: 3, value: 0.0 }
        }
    }
}

fn same_slot(a: Slot, b: Slot) -> bool {
    a.tag == b.tag && a.value == b.value
}

fn same_option(a: f32?, b: f32?) -> bool {
    match a {
        some(x) => match b {
            some(y) => x == y
            none => false
        }
        none => b == none
    }
}

fn same_axis(a: Axis, b: Axis) -> bool {
    match a {
        Both => match b {
            Both => true
            _ => false
        }
        Horizontal => match b {
            Horizontal => true
            _ => false
        }
        Vertical => match b {
            Vertical => true
            _ => false
        }
    }
}

fn is_both(a: Axis) -> bool {
    match a {
        Both => true
        _ => false
    }
}

fn key_of(inp: Input) -> Key {
    Key {
        width: slot_of(inp.known.width, inp.space.width)
        height: slot_of(inp.known.height, inp.space.height)
        parent_width: inp.parent.width
        parent_height: inp.parent.height
        definite: Known {
            width: inp.definite.width || inp.known.width == none
            height: inp.definite.height || inp.known.height == none
        }
        axis: inp.axis
    }
}

fn layout_key_matches(a: Key, b: Key) -> bool {
    let slots = same_slot(a.width, b.width) && same_slot(a.height, b.height)
    let parents = same_option(a.parent_width, b.parent_width) && same_option(a.parent_height, b.parent_height)
    let definite = a.definite.width == b.definite.width && a.definite.height == b.definite.height
    slots && parents && definite && same_axis(a.axis, b.axis)
}

fn measure_key_matches(entry: Key, key: Key) -> bool {
    let slots = same_slot(entry.width, key.width) && same_slot(entry.height, key.height)
    let definite = entry.definite.width == key.definite.width && entry.definite.height == key.definite.height
    let axis = is_both(entry.axis) || same_axis(entry.axis, key.axis)
    slots && definite && same_option(entry.parent_width, key.parent_width) && axis
}

fn cache_get(mut t: Tree, n: i64, inp: Input) -> geometry.Size? {
    let cache = t.nodes[n].cache
    let inherent = inp.sizing == InherentSize
    if cache.inherent != inherent {
        return none
    }
    let key = key_of(inp)
    if inp.run == PerformLayout {
        for e in cache.layout {
            if layout_key_matches(e.key, key) {
                return e.size
            }
        }
        return none
    }
    for i in 0..cache.measures.len {
        let e = cache.measures[i]
        if measure_key_matches(e.key, key) {
            return e.size
        }
    }
    none
}

fn cache_store(mut t: Tree, n: i64, inp: Input, size: geometry.Size) {
    let inherent = inp.sizing == InherentSize
    if t.nodes[n].cache.inherent != inherent {
        t.nodes[n].cache = Cache { inherent, layout: [], measures: [], next: 0 }
    }
    let key = key_of(inp)
    let entry = Entry { key, size }
    if inp.run == PerformLayout {
        t.nodes[n].cache.layout = [entry]
        return
    }
    for i in 0..t.nodes[n].cache.measures.len {
        if layout_key_matches(t.nodes[n].cache.measures[i].key, key) {
            t.nodes[n].cache.measures[i].size = size
            return
        }
    }
    if t.nodes[n].cache.measures.len < 9 {
        t.nodes[n].cache.measures.push(entry)
        return
    }
    let next = t.nodes[n].cache.next
    t.nodes[n].cache.measures[next] = entry
    t.nodes[n].cache.next = if next + 1 == 9 { 0 } else { next + 1 }
}

fn compute_child(mut t: Tree, n: i64, inp: Input) -> geometry.Size {
    let cached = cache_get(mut t, n, inp)
    match cached {
        some(size) => return size
        none => {}
    }
    var size = geometry.Size {}
    if t.nodes[n].style.display == None {
        hide(mut t, n)
    } else if t.nodes[n].children.len > 0 {
        size = flexbox(mut t, n, inp)
    } else {
        size = leaf_layout(mut t, n, inp)
    }
    cache_store(mut t, n, inp, size)
    size
}

fn measure_child(mut t: Tree, n: i64, known: Dims, parent: Dims, space: Space, axis: Axis) -> geometry.Size {
    compute_child(mut t, n, Input {
        known
        definite: Known {}
        parent
        space
        sizing: ContentSize
        axis
        run: ComputeSize
    })
}
