fn opt_min(a: f32?, b: f32?) -> f32? {
    match a {
        some(l) => match b {
            some(r) => smaller(l, r)
            none => a
        }
        none => none
    }
}

fn opt_max(a: f32?, b: f32?) -> f32? {
    match a {
        some(l) => match b {
            some(r) => larger(l, r)
            none => a
        }
        none => none
    }
}

fn opt_clamp(a: f32?, lo: f32?, hi: f32?) -> f32? {
    match a {
        some(v) => clamp_to(v, lo, hi)
        none => none
    }
}

fn opt_max_f(a: f32?, b: f32) -> f32? {
    match a {
        some(v) => larger(v, b)
        none => none
    }
}

fn opt_sub_f(a: f32?, b: f32) -> f32? {
    match a {
        some(v) => v - b
        none => none
    }
}

fn min_o(a: f32, b: f32?) -> f32 {
    match b {
        some(v) => smaller(a, v)
        none => a
    }
}

fn max_o(a: f32, b: f32?) -> f32 {
    match b {
        some(v) => larger(a, v)
        none => a
    }
}

fn clamp_to(v: f32, lo: f32?, hi: f32?) -> f32 {
    match lo {
        some(l) => match hi {
            some(h) => larger(smaller(v, h), l)
            none => larger(v, l)
        }
        none => match hi {
            some(h) => smaller(v, h)
            none => v
        }
    }
}

fn av_max(a: Avail, b: f32?) -> Avail {
    match a {
        Definite(v) => match b {
            some(r) => Avail.Definite(larger(v, r))
            none => a
        }
        _ => a
    }
}

fn av_max_f(a: Avail, b: f32) -> Avail {
    av_max(a, b)
}

fn av_sub(a: Avail, b: f32) -> Avail {
    match a {
        Definite(v) => Avail.Definite(v - b)
        _ => a
    }
}

fn av_clamp(a: Avail, lo: f32?, hi: f32?) -> Avail {
    match a {
        Definite(v) => Avail.Definite(clamp_to(v, lo, hi))
        _ => a
    }
}

fn av_set(a: Avail, v: f32?) -> Avail {
    match v {
        some(x) => Avail.Definite(x)
        none => a
    }
}

fn av_option(a: Avail) -> f32? {
    definite_of(a)
}
