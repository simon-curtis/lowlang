fn collect_lines(c: Consts, space: SpaceAx, items: Item[]) -> Line[] {
    var lines: Line[] = []
    let count = items.len
    if !c.wrap || !c.main_definite {
        lines.push(Line { start: 0, end: count })
        return lines
    }
    var limit = space.main
    match c.max.main {
        some(max) => {
            var available = av_option(space.main) ?? max
            if !c.def_main {
                available = smaller(available, max)
            }
            limit = Avail.Definite(max_o(available, c.min.main))
        }
        none => {
            if !c.row && !c.def_main && is_definite(space.main) {
                limit = MaxContent
            }
        }
    }
    match limit {
        MaxContent => {
            lines.push(Line { start: 0, end: count })
        }
        MinContent => {
            for i in 0..count {
                lines.push(Line { start: i, end: i + 1 })
            }
        }
        Definite(available) => {
            var start = 0
            for start < count {
                var length: f32 = 0.0
                var end = count
                for i in start..count {
                    let gap = if i == start { 0.0 } else { c.gap.main }
                    length += items[i].hyp_outer.main + gap
                    if length > available && i != start {
                        end = i
                        break
                    }
                }
                lines.push(Line { start, end })
                start = end
            }
        }
    }
    lines
}

fn item_main_length(c: Consts, it: Item) -> f32 {
    let pb = edge_sum(it.padding, c.row) + edge_sum(it.border, c.row)
    larger(max_o(it.basis, it.min.main) + edge_sum(it.margin, c.row), pb)
}

fn longest_line(c: Consts, lines: Line[], items: Item[]) -> f32 {
    var longest: f32 = 0.0
    for line in lines {
        var total: f32 = 0.0
        for i in line.start..line.end {
            total += item_main_length(c, items[i])
        }
        let length = total + sum_gaps(c.gap.main, line.end - line.start)
        longest = larger(longest, length)
    }
    longest
}

fn content_contribution(mut t: Tree, c: Consts, space: SpaceAx, it: Item) -> f32 {
    let row = c.row
    let style_min = it.min.main
    let preferred = it.size.main
    let style_max = it.max.main
    let margin_main = edge_sum(it.margin, row)
    var clamping: f32? = none
    if row {
        clamping = opt_max(some(it.basis), preferred)
    } else {
        clamping = some(it.basis)
    }
    let basis_min: f32? = if it.shrink == 0.0 { clamping } else { none }
    let basis_max: f32? = if it.grow == 0.0 { clamping } else { none }
    let min_main = larger(or_else(opt_max(style_min, basis_min), basis_min) ?? it.min_main, it.min_main)
    let max_main = or_else(opt_min(style_max, basis_max), basis_max) ?? unbounded
    match preferred {
        some(pref) => {
            if max_main <= min_main || max_main <= pref {
                return larger(smaller(pref, max_main), min_main) + margin_main
            }
        }
        none => {}
    }
    if max_main <= min_main {
        return min_main + margin_main
    }
    if it.scroll {
        return it.basis + margin_main
    }
    match preferred {
        some(pref) => {
            let pb_main = edge_sum(it.padding, row) + edge_sum(it.border, row)
            let inner = larger(pref, pb_main)
            if row {
                return clamp_to(inner + margin_main, style_min, style_max)
            }
            return clamp_to(larger(inner, it.basis) + margin_main, style_min, style_max)
        }
        none => {}
    }
    let cross_parent = c.inner.cross
    let cross_av = av_clamp(av_map_cross(space.cross, cross_parent, edge_sum(it.margin, !row)), it.min.cross, it.max.cross)
    let child_space = space_of(row, space.main, cross_av)
    var cross_known = opt_clamp(it.size.cross, it.min.cross, it.max.cross)
    if is_stretch(it.align) && cross_known == none {
        cross_known = av_option(cross_av)
    }
    let known = dims_of(row, none, cross_known)
    let measured = measure_main(mut t, c, it.node, known, item_parent(c), child_space)
    if row {
        return clamp_to(measured + margin_main, style_min, style_max)
    }
    clamp_to(larger(measured, it.basis) + margin_main, style_min, style_max)
}

fn av_map_cross(a: Avail, parent: f32?, margin: f32) -> Avail {
    match a {
        Definite(val) => Avail.Definite(larger((parent ?? val) - margin, 0.0))
        _ => a
    }
}

fn intrinsic_main(mut t: Tree, c: Consts, space: SpaceAx, mut items: Item[], lines: Line[]) -> f32 {
    var main_size: f32 = 0.0
    for line in lines {
        for i in line.start..line.end {
            let it = items[i]
            let contribution = content_contribution(mut t, c, space, it)
            let diff = contribution - it.basis
            if diff > 0.0 {
                items[i].fraction = diff / larger(1.0, it.grow)
            } else if diff < 0.0 {
                let scaled = larger(1.0, it.shrink) * it.inner_basis
                items[i].fraction = diff / scaled
            } else {
                items[i].fraction = 0.0
            }
        }
        var sum: f32 = 0.0
        for i in line.start..line.end {
            let it = items[i]
            var contribution: f32 = 0.0
            if it.fraction > 0.0 {
                contribution = larger(1.0, it.grow) * it.fraction
            } else if it.fraction < 0.0 {
                let scaled = larger(1.0, it.shrink) * it.inner_basis
                if scaled == 0.0 {
                    contribution = 0.0
                } else {
                    contribution = scaled * it.fraction
                }
            }
            let size = it.basis + contribution
            items[i].outer_target.main = size
            items[i].target.main = size
            sum += size
        }
        let gap_sum = sum_gaps(c.gap.main, line.end - line.start)
        main_size = larger(main_size, sum + gap_sum)
    }
    main_size
}

fn container_main(mut t: Tree, space: SpaceAx, lines: Line[], mut items: Item[], mut c: Consts) {
    let inset_main = edge_sum(c.inset, c.row)
    var outer: f32 = 0.0
    match c.outer.main {
        some(v) => { outer = v }
        none => {
            match space.main {
                Definite(available) => {
                    let size = longest_line(c, lines, items) + inset_main
                    if lines.len > 1 {
                        outer = larger(size, available)
                    } else {
                        outer = size
                    }
                }
                MinContent => {
                    if c.wrap {
                        outer = longest_line(c, lines, items) + inset_main
                    } else {
                        outer = intrinsic_main(mut t, c, space, mut items, lines) + inset_main
                    }
                }
                MaxContent => {
                    outer = intrinsic_main(mut t, c, space, mut items, lines) + inset_main
                }
            }
        }
    }
    outer = larger(clamp_to(outer, c.min.main, c.max.main), inset_main)
    let inner = larger(outer - inset_main, 0.0)
    c.container.main = outer
    c.inner_container.main = inner
    c.inner.main = inner
}

fn resolve_lengths(c: Consts, mut items: Item[], line: Line) {
    let row = c.row
    let count = line.end - line.start
    let total_gap = sum_gaps(c.gap.main, count)
    var total_hyp: f32 = 0.0
    for i in line.start..line.end {
        total_hyp += items[i].hyp_outer.main
    }
    let used_factor = total_gap + total_hyp
    let inner_main = c.inner.main ?? 0.0
    let growing = used_factor < inner_main
    let shrinking = used_factor > inner_main
    let exact = !growing && !shrinking
    for i in line.start..line.end {
        let it = items[i]
        let inner_target = it.hyp_inner.main
        items[i].target.main = inner_target
        if exact || (it.grow == 0.0 && it.shrink == 0.0) || (growing && it.basis > it.hyp_inner.main) || (shrinking && it.basis < it.hyp_inner.main) {
            items[i].frozen = true
            items[i].outer_target.main = inner_target + edge_sum(it.margin, row)
        }
    }
    if exact {
        return
    }
    var used: f32 = 0.0
    for i in line.start..line.end {
        let it = items[i]
        if it.frozen {
            used += it.outer_target.main
        } else {
            used += it.basis + edge_sum(it.margin, row)
        }
    }
    let initial_free = opt_sub_f(c.inner.main, total_gap + used) ?? 0.0
    resolve_loop(c, mut items, line, total_gap, used_factor, growing, shrinking, initial_free)
}

fn resolve_loop(c: Consts, mut items: Item[], line: Line, total_gap: f32, used_factor: f32, growing: bool, shrinking: bool, initial_free: f32) {
    let row = c.row
    for {
        var all_frozen = true
        for i in line.start..line.end {
            if !items[i].frozen {
                all_frozen = false
            }
        }
        if all_frozen {
            break
        }
        var used_sum: f32 = 0.0
        for i in line.start..line.end {
            let it = items[i]
            if it.frozen {
                used_sum += it.outer_target.main
            } else {
                used_sum += it.basis + edge_sum(it.margin, row)
            }
        }
        let used = total_gap + used_sum
        var sum_grow: f32 = 0.0
        var sum_shrink: f32 = 0.0
        for i in line.start..line.end {
            if !items[i].frozen {
                sum_grow = sum_grow + items[i].grow
                sum_shrink = sum_shrink + items[i].shrink
            }
        }
        let room = opt_sub_f(c.inner.main, used)
        var free: f32 = 0.0
        if growing && sum_grow < 1.0 {
            free = min_o(initial_free * sum_grow - total_gap, room)
        } else if shrinking && sum_shrink < 1.0 {
            free = max_o(initial_free * sum_shrink - total_gap, room)
        } else {
            free = room ?? (used_factor - used)
        }
        if is_normal(free) {
            if growing && sum_grow > 0.0 {
                for i in line.start..line.end {
                    if !items[i].frozen {
                        items[i].target.main = items[i].basis + free * (items[i].grow / sum_grow)
                    }
                }
            } else if shrinking && sum_shrink > 0.0 {
                var sum_scaled: f32 = 0.0
                for i in line.start..line.end {
                    if !items[i].frozen {
                        sum_scaled += items[i].inner_basis * items[i].shrink
                    }
                }
                if sum_scaled > 0.0 {
                    for i in line.start..line.end {
                        if !items[i].frozen {
                            let scaled = items[i].inner_basis * items[i].shrink
                            items[i].target.main = items[i].basis + free * (scaled / sum_scaled)
                        }
                    }
                }
            }
        }
        var total_violation: f32 = 0.0
        for i in line.start..line.end {
            if !items[i].frozen {
                let it = items[i]
                let clamped = larger(clamp_to(it.target.main, some(it.min_main), it.max.main), 0.0)
                items[i].violation = clamped - it.target.main
                items[i].target.main = clamped
                items[i].outer_target.main = clamped + edge_sum(it.margin, row)
                total_violation = total_violation + items[i].violation
            }
        }
        for i in line.start..line.end {
            if !items[i].frozen {
                if total_violation > 0.0 {
                    items[i].frozen = items[i].violation > 0.0
                } else if total_violation < 0.0 {
                    items[i].frozen = items[i].violation < 0.0
                } else {
                    items[i].frozen = true
                }
            }
        }
    }
}
