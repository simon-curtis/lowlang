import std/testing
import std/ui/geometry

fn nothing(width: f32) -> geometry.Size {
    geometry.Size {}
}

fn grower() -> Style {
    Style { grow: 1.0 }
}

fn row(mut t: Tree, style: Style, count: i64) -> i64 {
    var kids: i64[] = []
    for i in 0..count {
        kids.push(node(mut t, grower(), []))
    }
    node(mut t, style, kids)
}

fn near(got: f32, want: f32) -> bool {
    let d = got - want
    d < 0.0001 && d > -0.0001
}

fn test_a_fractional_gap_rounds_to_whole_device_pixels(t: *testing.T) {
    var tr = tree(1.0)
    let root = row(mut tr, Style { column_gap: 6.5, width: Dimension.Px(100.0), height: Dimension.Px(10.0) }, 3)
    compute(mut tr, root, geometry.size(100.0, 10.0))
    let first = rect(tr, 0)
    let second = rect(tr, 1)
    let third = rect(tr, 2)
    testing.equal(t, first.x, 0.0)
    testing.equal(t, first.width, 29.0)
    testing.equal(t, second.x, 35.0)
    testing.equal(t, second.width, 30.0)
    testing.equal(t, third.x, 71.0)
    testing.equal(t, third.width, 29.0)
}

fn test_gaps_of_nine_and_three_quarters_round_to_ten_and_three(t: *testing.T) {
    var tr = tree(1.0)
    let wide = row(mut tr, Style { column_gap: 9.75, width: Dimension.Px(100.0), height: Dimension.Px(10.0) }, 2)
    compute(mut tr, wide, geometry.size(100.0, 10.0))
    testing.equal(t, rect(tr, 1).x, 55.0)
    var tall = tree(1.0)
    let column = row(mut tall, Style { direction: Column, row_gap: 3.25, width: Dimension.Px(10.0), height: Dimension.Px(21.0) }, 2)
    compute(mut tall, column, geometry.size(10.0, 21.0))
    testing.equal(t, rect(tall, 0).height, 9.0)
    testing.equal(t, rect(tall, 1).y, 12.0)
}

fn test_a_centred_child_in_an_odd_leftover_rounds_toward_zero(t: *testing.T) {
    var tr = tree(1.0)
    let child = node(mut tr, Style { width: Dimension.Px(40.0), height: Dimension.Px(10.0) }, [])
    let root = node(mut tr, Style { justify: Center, width: Dimension.Px(101.0), height: Dimension.Px(10.0) }, [child])
    compute(mut tr, root, geometry.size(101.0, 10.0))
    testing.equal(t, rect(tr, child).x, 30.0)
    testing.equal(t, rect(tr, child).width, 40.0)
}

fn test_authored_lengths_round_before_layout(t: *testing.T) {
    var tr = tree(1.0)
    let child = node(mut tr, Style { width: Dimension.Px(30.3), height: Dimension.Px(10.6), margin: Margin { left: Dimension.Px(2.5) } }, [])
    let root = node(mut tr, Style { width: Dimension.Px(100.0), height: Dimension.Px(20.0) }, [child])
    compute(mut tr, root, geometry.size(100.0, 20.0))
    testing.equal(t, rect(tr, child).x, 2.0)
    testing.equal(t, rect(tr, child).width, 30.0)
    testing.equal(t, rect(tr, child).height, 11.0)
}

fn test_a_percentage_keeps_its_fraction_until_the_edges_snap(t: *testing.T) {
    var tr = tree(1.0)
    let child = node(mut tr, Style { width: Dimension.Percent(33.3), height: Dimension.Px(10.0) }, [])
    let root = node(mut tr, Style { width: Dimension.Px(201.0), height: Dimension.Px(10.0) }, [child])
    compute(mut tr, root, geometry.size(201.0, 10.0))
    testing.equal(t, rect(tr, child).width, 67.0)
}

fn test_a_measured_leaf_rounds_up_to_whole_device_pixels(t: *testing.T) {
    var tr = tree(1.0)
    let measure = fn(width: f32) -> geometry.Size { geometry.size(33.2, 17.4) }
    let leaf_node = leaf(mut tr, Style {}, measure)
    let root = node(mut tr, Style { align_items: Start }, [leaf_node])
    compute(mut tr, root, geometry.size(100.0, 40.0))
    testing.equal(t, rect(tr, leaf_node).width, 34.0)
    testing.equal(t, rect(tr, leaf_node).height, 18.0)
}

fn test_a_measured_leaf_rounds_up_in_device_pixels_at_a_scale(t: *testing.T) {
    var tr = tree(2.0)
    let measure = fn(width: f32) -> geometry.Size { geometry.size(10.25, 4.0) }
    let leaf_node = leaf(mut tr, Style {}, measure)
    let root = node(mut tr, Style { align_items: Start }, [leaf_node])
    compute(mut tr, root, geometry.size(50.0, 20.0))
    testing.equal(t, rect(tr, leaf_node).width, 10.5)
    testing.equal(t, rect(tr, leaf_node).height, 4.0)
}

fn test_an_auto_root_fills_the_window_in_whole_device_pixels(t: *testing.T) {
    var tr = tree(1.0)
    let root = node(mut tr, Style {}, [])
    compute(mut tr, root, geometry.size(100.5, 50.4))
    testing.equal(t, rect(tr, root).width, 100.0)
    testing.equal(t, rect(tr, root).height, 50.0)
}

fn test_an_auto_root_is_its_content_where_the_window_is_unbounded(t: *testing.T) {
    var tr = tree(1.0)
    let child = node(mut tr, Style { width: Dimension.Px(30.0), height: Dimension.Px(12.0) }, [])
    let root = node(mut tr, Style { direction: Column }, [child])
    compute(mut tr, root, geometry.size(100.0, unbounded))
    testing.equal(t, rect(tr, root).width, 100.0)
    testing.equal(t, rect(tr, root).height, 12.0)
}

fn test_lengths_round_in_device_pixels_at_a_fractional_scale(t: *testing.T) {
    var tr = tree(1.25)
    let child = node(mut tr, Style { width: Dimension.Px(10.0), height: Dimension.Px(10.0) }, [])
    let root = node(mut tr, Style { padding: geometry.edges(2.0) }, [child])
    compute(mut tr, root, geometry.size(40.0, 40.0))
    testing.is_true(t, near(rect(tr, child).x, 2.0 / 1.25))
    testing.is_true(t, near(rect(tr, child).width, 12.0 / 1.25))
}

fn test_a_border_is_never_thinner_than_one_device_pixel(t: *testing.T) {
    var tr = tree(1.0)
    let child = node(mut tr, Style { width: Dimension.Px(20.0), height: Dimension.Px(20.0), border: geometry.edges(0.3) }, [])
    let root = node(mut tr, Style { align_items: Start }, [child])
    compute(mut tr, root, geometry.size(40.0, 40.0))
    testing.equal(t, content(tr, child).x, 1.0)
    testing.equal(t, content(tr, child).width, 18.0)
}

fn test_edges_that_meet_in_the_window_round_alike(t: *testing.T) {
    var tr = tree(1.0)
    let root = row(mut tr, Style { width: Dimension.Px(100.0), height: Dimension.Px(4.0) }, 3)
    compute(mut tr, root, geometry.size(100.0, 4.0))
    testing.equal(t, rect(tr, 0).x + rect(tr, 0).width, rect(tr, 1).x)
    testing.equal(t, rect(tr, 1).x + rect(tr, 1).width, rect(tr, 2).x)
    testing.equal(t, rect(tr, 2).x + rect(tr, 2).width, 100.0)
}
