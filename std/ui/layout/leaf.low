import std/ui/geometry

fn measure_width(known: f32?, space: Avail) -> f32 {
    match known {
        some(w) => w
        none => match space {
            Definite(v) => v
            MinContent => unbounded
            MaxContent => unbounded
        }
    }
}

fn leaf_layout(mut t: Tree, n: i64, inp: Input) -> geometry.Size {
    let style = t.nodes[n].style
    let parent = inp.parent
    let pb = sum_edges(style.padding, style.border)
    let pbw = pb.left + pb.right
    let pbh = pb.top + pb.bottom
    var node_size = inp.known
    var node_min = Dims {}
    var node_max = Dims {}
    if inp.sizing == InherentSize {
        let styled = Dims { width: resolve(style.width, parent.width), height: resolve(style.height, parent.height) }
        node_min = Dims { width: resolve(style.min_width, parent.width), height: resolve(style.min_height, parent.height) }
        node_max = Dims { width: resolve(style.max_width, parent.width), height: resolve(style.max_height, parent.height) }
        node_size = Dims {
            width: or_else(inp.known.width, styled.width)
            height: or_else(inp.known.height, styled.height)
        }
    }
    if inp.run == ComputeSize {
        match node_size.width {
            some(w) => {
                match node_size.height {
                    some(h) => {
                        return geometry.Size {
                            width: larger(clamp_to(w, node_min.width, node_max.width), pbw)
                            height: larger(clamp_to(h, node_min.height, node_max.height), pbh)
                        }
                    }
                    none => {}
                }
            }
            none => {}
        }
    }
    let width_space = av_set(av_set(match inp.known.width {
        some(v) => Avail.Definite(v)
        none => inp.space.width
    }, inp.known.width), node_size.width)
    let height_space = av_set(av_set(match inp.known.height {
        some(v) => Avail.Definite(v)
        none => inp.space.height
    }, inp.known.height), node_size.height)
    let available = Space {
        width: match width_space {
            Definite(s) => Avail.Definite(clamp_to(s, node_min.width, node_max.width) - pbw)
            _ => width_space
        }
        height: match height_space {
            Definite(s) => Avail.Definite(clamp_to(s, node_min.height, node_max.height) - pbh)
            _ => height_space
        }
    }
    var known_for_measure = Dims {}
    if inp.run == ComputeSize {
        known_for_measure = inp.known
    }
    let measure = t.nodes[n].measure
    let measured = measure(measure_width(known_for_measure.width, available.width))
    let width = clamp_to(or_else(inp.known.width, node_size.width) ?? (measured.width + pbw), node_min.width, node_max.width)
    let height = clamp_to(or_else(inp.known.height, node_size.height) ?? (measured.height + pbh), node_min.height, node_max.height)
    geometry.Size {
        width: larger(width, pbw)
        height: larger(larger(height, 0.0), pbh)
    }
}
