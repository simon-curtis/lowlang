import std/ui/geometry
import std/ui/layout

fn show(name: str, t: layout.Tree, node: i64) {
    let r = layout.rect(t, node)
    print("{name}: x={r.x} y={r.y} w={r.width} h={r.height}")
}

fn label(width: f32) -> geometry.Size {
    if layout.is_bounded(width) && width < 120.0 {
        return geometry.size(width, 40.0)
    }
    geometry.size(120.0, 20.0)
}

/// Lays out a header, a sidebar and a content column that holds a text-like leaf, then computes the same tree for a narrower window.
fn main() {
    var t = layout.tree()
    let title = layout.leaf(mut t, layout.Style { grow: 1.0, height: layout.Dimension.Px(24.0) }, label)
    let close = layout.node(mut t, layout.Style { width: layout.Dimension.Px(24.0), height: layout.Dimension.Px(24.0) }, [])
    let header = layout.node(mut t, layout.Style {
        height: layout.Dimension.Px(48.0)
        padding: geometry.edges(12.0)
        gap: 8.0
        align_items: Center
    }, [title, close])

    let menu = layout.node(mut t, layout.Style { width: layout.Dimension.Px(160.0), shrink: 0.0 }, [])
    let note = layout.leaf(mut t, layout.Style { margin: geometry.edges(8.0) }, label)
    let footer = layout.node(mut t, layout.Style { height: layout.Dimension.Px(32.0) }, [])
    let content = layout.node(mut t, layout.Style { direction: Column, grow: 1.0, justify: SpaceBetween }, [note, footer])
    let body = layout.node(mut t, layout.Style { grow: 1.0 }, [menu, content])
    let root = layout.node(mut t, layout.Style { direction: Column }, [header, body])

    for width in [f32(640.0), f32(200.0)] {
        layout.compute(mut t, root, geometry.size(width, 400.0))
        print("window {width}x400")
        show("header", t, header)
        show("title", t, title)
        show("close", t, close)
        show("menu", t, menu)
        show("note", t, note)
        show("footer", t, footer)
        let inner = layout.content(t, header)
        print("header content: x={inner.x} w={inner.width}")
    }
}
