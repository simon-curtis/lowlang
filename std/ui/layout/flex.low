import std/ui/geometry

struct Ax {
    main: f32 = 0.0
    cross: f32 = 0.0
}

struct Opt {
    main: f32? = none
    cross: f32? = none
}

struct SpaceAx {
    main: Avail = MaxContent
    cross: Avail = MaxContent
}

enum Mode {
    Lead
    Trail
    Mid
    Fill
    Between
    Around
    Evenly
}

struct Item {
    node: i64
    size: Opt
    min: Opt
    max: Opt
    auto_size_cross: bool
    align: Align
    grow: f32
    shrink: f32
    scroll_main: bool
    scroll: bool
    margin: geometry.Edges
    auto_top: bool
    auto_right: bool
    auto_bottom: bool
    auto_left: bool
    padding: geometry.Edges
    border: geometry.Edges
    inset_main: f32
    inset_cross: f32
    basis_definite: bool = false
    basis: f32 = 0.0
    inner_basis: f32 = 0.0
    min_main: f32 = 0.0
    hyp_inner: Ax = Ax {}
    hyp_outer: Ax = Ax {}
    target: Ax = Ax {}
    outer_target: Ax = Ax {}
    violation: f32 = 0.0
    frozen: bool = false
    fraction: f32 = 0.0
    offset_main: f32 = 0.0
    offset_cross: f32 = 0.0
}

struct Consts {
    row: bool
    wrap: bool
    min: Opt
    max: Opt
    border: geometry.Edges
    inset: geometry.Edges
    gap: Ax
    align_items: Align
    align_content: AlignContent
    justify: Justify
    outer: Opt
    inner: Opt
    main_definite: bool
    def_main: bool
    def_cross: bool
    cross_space_definite: bool
    container: Ax = Ax {}
    inner_container: Ax = Ax {}
}

struct Line {
    start: i64
    end: i64
    cross: f32 = 0.0
    offset: f32 = 0.0
}

fn dims_of(row: bool, main: f32?, cross: f32?) -> Dims {
    if row { Dims { width: main, height: cross } } else { Dims { width: cross, height: main } }
}

fn opt_of(d: Dims, row: bool) -> Opt {
    if row { Opt { main: d.width, cross: d.height } } else { Opt { main: d.height, cross: d.width } }
}

fn space_of(row: bool, main: Avail, cross: Avail) -> Space {
    if row { Space { width: main, height: cross } } else { Space { width: cross, height: main } }
}

fn space_ax(s: Space, row: bool) -> SpaceAx {
    if row { SpaceAx { main: s.width, cross: s.height } } else { SpaceAx { main: s.height, cross: s.width } }
}

fn size_of(row: bool, main: f32, cross: f32) -> geometry.Size {
    if row { geometry.Size { width: main, height: cross } } else { geometry.Size { width: cross, height: main } }
}

fn size_main(s: geometry.Size, row: bool) -> f32 {
    if row { s.width } else { s.height }
}

fn size_cross(s: geometry.Size, row: bool) -> f32 {
    if row { s.height } else { s.width }
}

fn axis_main(row: bool) -> Axis {
    if row { Horizontal } else { Vertical }
}

fn axis_cross(row: bool) -> Axis {
    if row { Vertical } else { Horizontal }
}

fn axis_value(s: geometry.Size, axis: Axis) -> f32 {
    match axis {
        Horizontal => s.width
        Vertical => s.height
        Both => 0.0
    }
}

fn is_horizontal(axis: Axis) -> bool {
    match axis {
        Horizontal => true
        _ => false
    }
}

fn is_vertical(axis: Axis) -> bool {
    match axis {
        Vertical => true
        _ => false
    }
}

fn or_else(a: f32?, b: f32?) -> f32? {
    match a {
        some(v) => a
        none => b
    }
}

fn sum_gaps(gap: f32, count: i64) -> f32 {
    if count <= 1 { 0.0 } else { gap * f32(count - 1) }
}

fn is_scroll(o: Overflow) -> bool {
    match o {
        Visible => false
        _ => true
    }
}

fn is_stretch(a: Align) -> bool {
    match a {
        Stretch => true
        _ => false
    }
}

fn resolve_align(own: AlignSelf, items: Align) -> Align {
    match own {
        Auto => items
        Start => Start
        End => End
        Center => Center
        Stretch => Stretch
    }
}

fn justify_mode(j: Justify) -> Mode {
    match j {
        Start => Lead
        End => Trail
        Center => Mid
        SpaceBetween => Between
        SpaceAround => Around
        SpaceEvenly => Evenly
    }
}

fn content_mode(a: AlignContent) -> Mode {
    match a {
        Start => Lead
        End => Trail
        Center => Mid
        Stretch => Fill
        SpaceBetween => Between
        SpaceAround => Around
        SpaceEvenly => Evenly
    }
}

fn is_fill(a: AlignContent) -> bool {
    match a {
        Stretch => true
        _ => false
    }
}

fn fallback_mode(free: f32, count: i64, mode: Mode) -> Mode {
    var keyword = mode
    var safe = false
    if count <= 1 || free <= 0.0 {
        match keyword {
            Fill => {
                keyword = Lead
                safe = true
            }
            Between => {
                keyword = Lead
                safe = true
            }
            Around => {
                keyword = Mid
                safe = true
            }
            Evenly => {
                keyword = Mid
                safe = true
            }
            _ => {}
        }
    }
    if free <= 0.0 && safe {
        keyword = Lead
    }
    keyword
}

fn alignment_offset(free: f32, count: i64, gap: f32, mode: Mode, first: bool) -> f32 {
    if first {
        match mode {
            Lead => 0.0
            Trail => free
            Mid => free / 2.0
            Fill => 0.0
            Between => 0.0
            Around => if free >= 0.0 { (free / f32(count)) / 2.0 } else { free / 2.0 }
            Evenly => if free >= 0.0 { free / f32(count + 1) } else { free / 2.0 }
        }
    } else {
        let room = larger(free, 0.0)
        let extra = match mode {
            Between => room / f32(count - 1)
            Around => room / f32(count)
            Evenly => room / f32(count + 1)
            _ => 0.0
        }
        gap + extra
    }
}

fn margin_auto_main_start(it: Item, row: bool) -> bool {
    if row { it.auto_left } else { it.auto_top }
}

fn margin_auto_main_end(it: Item, row: bool) -> bool {
    if row { it.auto_right } else { it.auto_bottom }
}

fn margin_auto_cross_start(it: Item, row: bool) -> bool {
    if row { it.auto_top } else { it.auto_left }
}

fn margin_auto_cross_end(it: Item, row: bool) -> bool {
    if row { it.auto_bottom } else { it.auto_right }
}

fn item_parent(c: Consts) -> Dims {
    dims_of(c.row, c.inner.main, c.inner.cross)
}

fn container_size(c: Consts) -> geometry.Size {
    size_of(c.row, c.container.main, c.container.cross)
}

fn constants(style: Style, inp: Input) -> Consts {
    let row = style.direction == Row
    let parent = inp.parent
    let pb = sum_edges(style.padding, style.border)
    let inset_w = pb.left + pb.right
    let inset_h = pb.top + pb.bottom
    let known = opt_of(inp.known, row)
    let inner = opt_of(Dims { width: opt_sub_f(inp.known.width, inset_w), height: opt_sub_f(inp.known.height, inset_h) }, row)
    let definite = if row { inp.definite } else { Known { width: inp.definite.height, height: inp.definite.width } }
    let def_main = definite.width && known.main != none
    let def_cross = definite.height && known.cross != none
    let cross_space = space_ax(inp.space, row).cross
    let min = opt_of(Dims { width: resolve(style.min_width, parent.width), height: resolve(style.min_height, parent.height) }, row)
    let max = opt_of(Dims { width: resolve(style.max_width, parent.width), height: resolve(style.max_height, parent.height) }, row)
    let gap = if row { Ax { main: style.column_gap, cross: style.row_gap } } else { Ax { main: style.row_gap, cross: style.column_gap } }
    Consts {
        row
        wrap: style.wrap == Multi
        min
        max
        border: style.border
        inset: pb
        gap
        align_items: style.align_items
        align_content: style.align_content
        justify: style.justify
        outer: known
        inner
        main_definite: definite.width
        def_main
        def_cross
        cross_space_definite: def_cross || is_definite(cross_space)
    }
}

fn generate_items(t: Tree, n: i64, c: Consts) -> Item[] {
    var items: Item[] = []
    let inner = item_parent(c)
    let percent = if c.main_definite { inner } else { dims_of(c.row, none, c.inner.cross) }
    for child in t.nodes[n].children {
        let cs = t.nodes[child].style
        if cs.position == Absolute || cs.display == None {
            continue
        }
        let size = opt_of(Dims { width: resolve(cs.width, percent.width), height: resolve(cs.height, percent.height) }, c.row)
        let min = opt_of(Dims { width: resolve(cs.min_width, percent.width), height: resolve(cs.min_height, percent.height) }, c.row)
        let max = opt_of(Dims { width: resolve(cs.max_width, percent.width), height: resolve(cs.max_height, percent.height) }, c.row)
        var inset_main: f32 = 0.0
        var inset_cross: f32 = 0.0
        if cs.position == Relative {
            let left = resolve(cs.inset.left, inner.width)
            let right = resolve(cs.inset.right, inner.width)
            let top = resolve(cs.inset.top, inner.height)
            let bottom = resolve(cs.inset.bottom, inner.height)
            let main_start = if c.row { left } else { top }
            let main_end = if c.row { right } else { bottom }
            let cross_start = if c.row { top } else { left }
            let cross_end = if c.row { bottom } else { right }
            inset_main = or_else(main_start, negated(main_end)) ?? 0.0
            inset_cross = or_else(cross_start, negated(cross_end)) ?? 0.0
        }
        let cross_size = if c.row { cs.height } else { cs.width }
        items.push(Item {
            node: child
            size
            min
            max
            auto_size_cross: is_auto(cross_size)
            align: resolve_align(cs.align_self, c.align_items)
            grow: cs.grow
            shrink: cs.shrink
            scroll_main: is_scroll(if c.row { cs.overflow_x } else { cs.overflow_y })
            scroll: is_scroll(cs.overflow_x) || is_scroll(cs.overflow_y)
            margin: resolve_edges(cs.margin, inner.width)
            auto_top: is_auto(cs.margin.top)
            auto_right: is_auto(cs.margin.right)
            auto_bottom: is_auto(cs.margin.bottom)
            auto_left: is_auto(cs.margin.left)
            padding: cs.padding
            border: cs.border
            inset_main
            inset_cross
        })
    }
    items
}

fn available_for_items(inp: Input, c: Consts) -> SpaceAx {
    let inset_w = c.inset.left + c.inset.right
    let inset_h = c.inset.top + c.inset.bottom
    let width = match inp.known.width {
        some(w) => Avail.Definite(larger(w - inset_w, 0.0))
        none => av_max_f(av_sub(inp.space.width, inset_w), 0.0)
    }
    let height = match inp.known.height {
        some(h) => Avail.Definite(larger(h - inset_h, 0.0))
        none => av_max_f(av_sub(inp.space.height, inset_h), 0.0)
    }
    space_ax(Space { width, height }, c.row)
}

fn measure_main(mut t: Tree, c: Consts, node: i64, known: Dims, parent: Dims, space: Space) -> f32 {
    let size = measure_child(mut t, node, known, parent, space, axis_main(c.row))
    size_main(size, c.row)
}

fn base_size(mut t: Tree, c: Consts, space: SpaceAx, mut items: Item[], i: i64) {
    let it = items[i]
    let row = c.row
    let cross_parent = c.inner.cross
    let child_parent = dims_of(row, none, cross_parent)
    let margin_cross = edge_sum(it.margin, !row)
    let margin_main = edge_sum(it.margin, row)
    let cross_av = match space.cross {
        Definite(val) => Avail.Definite(clamp_to(larger((cross_parent ?? val) - margin_cross, 0.0), it.min.cross, it.max.cross))
        MinContent => match it.min.cross {
            some(m) => Avail.Definite(m)
            none => Avail.MinContent
        }
        MaxContent => match it.max.cross {
            some(m) => Avail.Definite(m)
            none => Avail.MaxContent
        }
    }
    var cross_known = opt_clamp(it.size.cross, it.min.cross, it.max.cross)
    if is_stretch(it.align) && !margin_auto_cross_start(it, row) && !margin_auto_cross_end(it, row) && cross_known == none {
        cross_known = av_option(cross_av)
    }
    let known = dims_of(row, none, cross_known)
    let percent_main: f32? = if c.main_definite { c.inner.main } else { none }
    let basis_style = t.nodes[it.node].style.basis
    let styled_basis = resolve(basis_style, percent_main)
    var basis: f32 = 0.0
    var settled = false
    match styled_basis {
        some(v) => {
            basis = v
            settled = true
        }
        none => {
            if is_auto(basis_style) {
                match it.size.main {
                    some(v) => {
                        basis = v
                        settled = true
                    }
                    none => {}
                }
            }
        }
    }
    if settled {
        items[i].basis_definite = true
    } else {
        let main_space = if is_min_content(space.main) { Avail.MinContent } else { Avail.MaxContent }
        basis = measure_main(mut t, c, it.node, known, child_parent, space_of(row, main_space, cross_av))
    }
    let pb_main = edge_sum(it.padding, row) + edge_sum(it.border, row)
    basis = larger(basis, pb_main)
    items[i].basis = basis
    items[i].inner_basis = basis - edge_sum(it.padding, row) - edge_sum(it.border, row)
    let pb_axes = sum_edges(it.padding, it.border)
    let pb_axes_main = edge_sum(pb_axes, row)
    let auto_min: f32? = if it.scroll_main { some(0.0) } else { none }
    let style_min = or_else(it.min.main, auto_min)
    var resolved_min: f32 = 0.0
    match style_min {
        some(v) => { resolved_min = v }
        none => {
            let content = measure_main(mut t, c, it.node, known, child_parent, space_of(row, Avail.MinContent, cross_av))
            let clamped = min_o(min_o(content, it.size.main), it.max.main)
            resolved_min = larger(clamped, pb_axes_main)
        }
    }
    items[i].min_main = resolved_min
    let hyp_min = max_o(max_o(resolved_min, it.min.main), pb_axes_main)
    let hyp_inner = clamp_to(basis, some(hyp_min), it.max.main)
    items[i].hyp_inner.main = hyp_inner
    items[i].hyp_outer.main = hyp_inner + margin_main
}
