import std/ui/geometry

fn item_definite(c: Consts, it: Item) -> Known {
    let main_definite = c.def_main || it.basis_definite
    let auto_cross = margin_auto_cross_start(it, c.row) || margin_auto_cross_end(it, c.row)
    let stretched = !auto_cross && is_stretch(it.align) && it.auto_size_cross
    let cross_definite = stretched || it.size.cross != none || (!c.row && c.cross_space_definite)
    if c.row {
        Known { width: main_definite, height: cross_definite }
    } else {
        Known { width: cross_definite, height: main_definite }
    }
}

fn cross_padding(it: Item, row: bool) -> f32 {
    edge_sum(sum_edges(it.padding, it.border), !row)
}

fn hypothetical_cross(mut t: Tree, c: Consts, space: SpaceAx, mut items: Item[], line: Line) {
    let row = c.row
    for i in line.start..line.end {
        let it = items[i]
        let pb = cross_padding(it, row)
        let margin_main = edge_sum(it.margin, row)
        let margin_cross = edge_sum(it.margin, !row)
        let available_main = Avail.Definite(larger(c.container.main - margin_main, 0.0))
        let known_cross = opt_max_f(opt_clamp(it.size.cross, it.min.cross, it.max.cross), pb)
        var available_cross = space.cross
        match available_cross {
            Definite(val) => { available_cross = Avail.Definite(larger(val - margin_cross, 0.0)) }
            _ => {}
        }
        available_cross = av_max_f(av_clamp(available_cross, it.min.cross, it.max.cross), pb)
        var inner_cross: f32 = 0.0
        match known_cross {
            some(v) => { inner_cross = v }
            none => {
                let known = dims_of(row, some(it.target.main), none)
                let result = compute_child(mut t, it.node, Input {
                    known
                    definite: item_definite(c, it)
                    parent: item_parent(c)
                    space: space_of(row, available_main, available_cross)
                    sizing: ContentSize
                    axis: axis_cross(row)
                    run: ComputeSize
                })
                let measured = size_cross(result, row)
                inner_cross = larger(clamp_to(measured, it.min.cross, it.max.cross), pb)
            }
        }
        items[i].hyp_inner.cross = inner_cross
        items[i].hyp_outer.cross = inner_cross + margin_cross
    }
}

fn line_cross_sizes(c: Consts, mut lines: Line[], items: Item[]) {
    let cross_pb = edge_sum(c.inset, !c.row)
    match c.outer.cross {
        some(v) => {
            if !c.wrap {
                lines[0].cross = larger(clamp_to(v, c.min.cross, c.max.cross) - cross_pb, 0.0)
                return
            }
        }
        none => {}
    }
    for li in 0..lines.len {
        var longest: f32 = 0.0
        for i in lines[li].start..lines[li].end {
            longest = larger(longest, items[i].hyp_outer.cross)
        }
        lines[li].cross = longest
    }
    if !c.wrap {
        lines[0].cross = clamp_to(lines[0].cross, opt_sub_f(c.min.cross, cross_pb), opt_sub_f(c.max.cross, cross_pb))
    }
}

fn stretch_lines(c: Consts, mut lines: Line[]) {
    if !is_fill(c.align_content) {
        return
    }
    let cross_pb = edge_sum(c.inset, !c.row)
    let base = opt_clamp(or_else(c.outer.cross, c.min.cross), c.min.cross, c.max.cross)
    let min_inner = opt_max_f(opt_sub_f(base, cross_pb), 0.0) ?? 0.0
    let total_gap = sum_gaps(c.gap.cross, lines.len)
    var total: f32 = 0.0
    for line in lines {
        total += line.cross
    }
    let lines_total = total + total_gap
    if lines_total < min_inner {
        let addition = (min_inner - lines_total) / f32(lines.len)
        for li in 0..lines.len {
            lines[li].cross = lines[li].cross + addition
        }
    }
}

fn used_cross(c: Consts, lines: Line[], mut items: Item[]) {
    let row = c.row
    for line in lines {
        for i in line.start..line.end {
            let it = items[i]
            let margin_cross = edge_sum(it.margin, !row)
            var target = it.hyp_inner.cross
            if !margin_auto_cross_start(it, row) && !margin_auto_cross_end(it, row) && is_stretch(it.align) && it.auto_size_cross {
                target = clamp_to(larger(line.cross - margin_cross, 0.0), it.min.cross, it.max.cross)
            }
            items[i].target.cross = target
            items[i].outer_target.cross = target + margin_cross
        }
    }
}

fn distribute_main(c: Consts, lines: Line[], mut items: Item[]) {
    let row = c.row
    for line in lines {
        let count = line.end - line.start
        let total_gap = sum_gaps(c.gap.main, count)
        var sum: f32 = 0.0
        for i in line.start..line.end {
            sum += items[i].outer_target.main
        }
        let used = total_gap + sum
        var free = c.inner_container.main - used
        var autos = 0
        for i in line.start..line.end {
            if margin_auto_main_start(items[i], row) {
                autos += 1
            }
            if margin_auto_main_end(items[i], row) {
                autos += 1
            }
        }
        if free > 0.0 && autos > 0 {
            let margin = free / f32(autos)
            for i in line.start..line.end {
                if margin_auto_main_start(items[i], row) {
                    if row {
                        items[i].margin.left = margin
                    } else {
                        items[i].margin.top = margin
                    }
                }
                if margin_auto_main_end(items[i], row) {
                    if row {
                        items[i].margin.right = margin
                    } else {
                        items[i].margin.bottom = margin
                    }
                }
            }
            free = 0.0
        }
        let mode = fallback_mode(free, count, justify_mode(c.justify))
        for i in line.start..line.end {
            items[i].offset_main = alignment_offset(free, count, c.gap.main, mode, i == line.start)
        }
    }
}

fn cross_margins(c: Consts, lines: Line[], mut items: Item[]) {
    let row = c.row
    for line in lines {
        for i in line.start..line.end {
            let it = items[i]
            let free = line.cross - it.outer_target.cross
            let start_auto = margin_auto_cross_start(it, row)
            let end_auto = margin_auto_cross_end(it, row)
            if start_auto && end_auto {
                if row {
                    items[i].margin.top = free / 2.0
                    items[i].margin.bottom = free / 2.0
                } else {
                    items[i].margin.left = free / 2.0
                    items[i].margin.right = free / 2.0
                }
            } else if start_auto {
                if row {
                    items[i].margin.top = free
                } else {
                    items[i].margin.left = free
                }
            } else if end_auto {
                if row {
                    items[i].margin.bottom = free
                } else {
                    items[i].margin.right = free
                }
            } else {
                items[i].offset_cross = match it.align {
                    End => free
                    Center => free / 2.0
                    _ => 0.0
                }
            }
        }
    }
}

fn container_cross(lines: Line[], mut c: Consts) -> f32 {
    let total_gap = sum_gaps(c.gap.cross, lines.len)
    var total: f32 = 0.0
    for line in lines {
        total += line.cross
    }
    let pb = edge_sum(c.inset, !c.row)
    let natural = total + total_gap + pb
    let outer = larger(clamp_to(c.outer.cross ?? natural, c.min.cross, c.max.cross), pb)
    c.container.cross = outer
    c.inner_container.cross = larger(outer - pb, 0.0)
    total
}

fn align_lines(c: Consts, mut lines: Line[], total_cross: f32) {
    let count = lines.len
    let gap = c.gap.cross
    let total_gap = sum_gaps(gap, count)
    let free = c.inner_container.cross - total_cross - total_gap
    let mode = fallback_mode(free, count, content_mode(c.align_content))
    for li in 0..count {
        lines[li].offset = alignment_offset(free, count, gap, mode, li == 0)
    }
}

fn place_item(mut t: Tree, c: Consts, mut items: Item[], i: i64, mut total_main: f32, total_cross: f32, line_offset: f32) {
    let row = c.row
    let it = items[i]
    let margin = it.margin
    let container = container_size(c)
    let available = Space {
        width: Avail.Definite(larger(container.width - (margin.left + margin.right), 0.0))
        height: Avail.Definite(larger(container.height - (margin.top + margin.bottom), 0.0))
    }
    let size = compute_child(mut t, it.node, Input {
        known: dims_of(row, some(it.target.main), some(it.target.cross))
        definite: item_definite(c, it)
        parent: item_parent(c)
        space: available
        sizing: ContentSize
        axis: Both
        run: PerformLayout
    })
    let margin_main_start = edge_lead(margin, row)
    let margin_cross_start = edge_lead(margin, !row)
    let offset_main = total_main + it.offset_main + margin_main_start + it.inset_main
    let offset_cross = total_cross + it.offset_cross + line_offset + margin_cross_start + it.inset_cross
    t.nodes[it.node].size = size
    if row {
        t.nodes[it.node].location = geometry.Point { x: offset_main, y: offset_cross }
    } else {
        t.nodes[it.node].location = geometry.Point { x: offset_cross, y: offset_main }
    }
    total_main = total_main + ((it.offset_main + edge_sum(margin, row)) + size_main(size, row))
}

fn final_pass(mut t: Tree, c: Consts, mut items: Item[], lines: Line[]) {
    var total_cross = edge_lead(c.inset, !c.row)
    for line in lines {
        var total_main = edge_lead(c.inset, c.row)
        for i in line.start..line.end {
            place_item(mut t, c, mut items, i, mut total_main, total_cross, line.offset)
        }
        total_cross += line.offset + line.cross
    }
}

fn flexbox(mut t: Tree, n: i64, inp: Input) -> geometry.Size {
    let style = t.nodes[n].style
    let parent = inp.parent
    let padding = style.padding
    let border = style.border
    let pbw = (padding.left + padding.right) + (border.left + border.right)
    let pbh = (padding.top + padding.bottom) + (border.top + border.bottom)
    let min = Dims { width: resolve(style.min_width, parent.width), height: resolve(style.min_height, parent.height) }
    let max = Dims { width: resolve(style.max_width, parent.width), height: resolve(style.max_height, parent.height) }
    var styled = Dims {}
    if inp.sizing == InherentSize {
        styled = Dims {
            width: opt_clamp(resolve(style.width, parent.width), min.width, max.width)
            height: opt_clamp(resolve(style.height, parent.height), min.height, max.height)
        }
    }
    let fixed = Dims {
        width: pinned(min.width, max.width)
        height: pinned(min.height, max.height)
    }
    let known = Dims {
        width: or_else(inp.known.width, opt_max_f(or_else(fixed.width, styled.width), pbw))
        height: or_else(inp.known.height, opt_max_f(or_else(fixed.height, styled.height), pbh))
    }
    if inp.run == ComputeSize {
        match known.width {
            some(w) => {
                match known.height {
                    some(h) => return geometry.Size { width: w, height: h }
                    none => {}
                }
                if is_horizontal(inp.axis) {
                    return geometry.Size { width: w, height: 0.0 }
                }
            }
            none => {}
        }
    }
    let definite = Known {
        width: inp.definite.width || inp.known.width == none
        height: inp.definite.height || inp.known.height == none
    }
    let resolved = Input {
        known
        definite
        parent: inp.parent
        space: inp.space
        sizing: inp.sizing
        axis: inp.axis
        run: inp.run
    }
    preliminary(mut t, n, resolved)
}

fn pinned(min: f32?, max: f32?) -> f32? {
    match min {
        some(l) => match max {
            some(h) => if h <= l { some(l) } else { none }
            none => none
        }
        none => none
    }
}

fn preliminary(mut t: Tree, n: i64, inp: Input) -> geometry.Size {
    let style = t.nodes[n].style
    var c = constants(style, inp)
    let row = c.row
    var items = generate_items(t, n, c)
    let space = available_for_items(inp, c)
    for i in 0..items.len {
        base_size(mut t, c, space, mut items, i)
    }
    var lines = collect_lines(c, space, items)
    match c.inner.main {
        some(inner_main) => {
            c.inner_container.main = inner_main
            c.container.main = inner_main + edge_sum(c.inset, row)
        }
        none => {
            container_main(mut t, space, lines, mut items, mut c)
            c.outer.main = c.container.main
        }
    }
    if inp.run == ComputeSize {
        let requested = (is_horizontal(inp.axis) && row) || (is_vertical(inp.axis) && !row)
        if requested {
            return size_of(row, c.container.main, 0.0)
        }
    }
    for line in lines {
        resolve_lengths(c, mut items, line)
    }
    for line in lines {
        hypothetical_cross(mut t, c, space, mut items, line)
    }
    line_cross_sizes(c, mut lines, items)
    stretch_lines(c, mut lines)
    used_cross(c, lines, mut items)
    distribute_main(c, lines, mut items)
    cross_margins(c, lines, mut items)
    let total_cross = container_cross(lines, mut c)
    if inp.run == ComputeSize {
        return container_size(c)
    }
    align_lines(c, mut lines, total_cross)
    final_pass(mut t, c, mut items, lines)
    layout_absolute(mut t, n, c, style)
    container_size(c)
}
