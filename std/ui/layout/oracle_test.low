import std/file
import std/testing
import std/text
import std/ui/geometry

const window_width: f32 = 640.0
const window_height: f32 = 480.0
const space_width: f32 = 4.0

struct Spec {
    depth: i64
    style: Style
    words: f32[]
    line_height: f32
    measured: bool
}

struct Source {
    name: str
    specs: Spec[]
}

struct Cursor {
    specs: Spec[]
    ids: i64[]
    next: i64
}

struct Expected {
    name: str
    scale: f32
    rects: f32[]
}

fn number(value: str) -> f32 {
    f32(text.parse_float(value) or 0.0)
}

fn dimension(value: str) -> Dimension {
    if value == "auto" {
        return Dimension.Auto
    }
    if text.ends_with(value, "%") {
        return Dimension.Percent(number(value[..value.len - 1]))
    }
    Dimension.Px(number(value))
}

fn dimensions(value: str) -> Dimension[] {
    var all: Dimension[] = []
    for part in text.split(value, ',') {
        all.push(dimension(part))
    }
    if all.len == 1 {
        return [all[0], all[0], all[0], all[0]]
    }
    all
}

fn numbers(value: str) -> f32[] {
    var all: f32[] = []
    for part in text.split(value, ',') {
        all.push(number(part))
    }
    all
}

fn edges_of(value: str) -> geometry.Edges {
    let all = numbers(value)
    if all.len == 1 {
        return geometry.edges(all[0])
    }
    geometry.Edges { top: all[0], right: all[1], bottom: all[2], left: all[3] }
}

fn justify_of(value: str) -> Justify {
    match value {
        "end" => Justify.End
        "center" => Justify.Center
        "between" => Justify.SpaceBetween
        "around" => Justify.SpaceAround
        "evenly" => Justify.SpaceEvenly
        _ => Justify.Start
    }
}

fn align_of(value: str) -> Align {
    match value {
        "start" => Align.Start
        "end" => Align.End
        "center" => Align.Center
        _ => Align.Stretch
    }
}

fn self_of(value: str) -> AlignSelf {
    match value {
        "start" => AlignSelf.Start
        "end" => AlignSelf.End
        "center" => AlignSelf.Center
        _ => AlignSelf.Stretch
    }
}

fn content_of(value: str) -> AlignContent {
    match value {
        "start" => AlignContent.Start
        "end" => AlignContent.End
        "center" => AlignContent.Center
        "between" => AlignContent.SpaceBetween
        "around" => AlignContent.SpaceAround
        "evenly" => AlignContent.SpaceEvenly
        _ => AlignContent.Stretch
    }
}

fn overflow_of(value: str) -> Overflow {
    match value {
        "hidden" => Overflow.Hidden
        "scroll" => Overflow.Scroll
        _ => Overflow.Visible
    }
}

fn apply(mut spec: Spec, key: str, value: str) {
    match key {
        "dir" => {
            spec.style.direction = if value == "col" { Direction.Column } else { Direction.Row }
        }
        "wrap" => {
            spec.style.wrap = if value == "none" { Wrap.Single } else { Wrap.Multi }
        }
        "justify" => {
            spec.style.justify = justify_of(value)
        }
        "items" => {
            spec.style.align_items = align_of(value)
        }
        "self" => {
            spec.style.align_self = self_of(value)
        }
        "content" => {
            spec.style.align_content = content_of(value)
        }
        "grow" => {
            spec.style.grow = number(value)
        }
        "shrink" => {
            spec.style.shrink = number(value)
        }
        "basis" => {
            spec.style.basis = dimension(value)
        }
        "w" => {
            spec.style.width = dimension(value)
        }
        "h" => {
            spec.style.height = dimension(value)
        }
        "minw" => {
            spec.style.min_width = dimension(value)
        }
        "minh" => {
            spec.style.min_height = dimension(value)
        }
        "maxw" => {
            spec.style.max_width = dimension(value)
        }
        "maxh" => {
            spec.style.max_height = dimension(value)
        }
        "m" => {
            let d = dimensions(value)
            spec.style.margin = Margin { top: d[0], right: d[1], bottom: d[2], left: d[3] }
        }
        "inset" => {
            let d = dimensions(value)
            spec.style.inset = Inset { top: d[0], right: d[1], bottom: d[2], left: d[3] }
        }
        "p" => {
            spec.style.padding = edges_of(value)
        }
        "b" => {
            spec.style.border = edges_of(value)
        }
        "gap" => {
            let all = numbers(value)
            spec.style.column_gap = all[0]
            spec.style.row_gap = all[all.len - 1]
        }
        "ox" => {
            spec.style.overflow_x = overflow_of(value)
        }
        "oy" => {
            spec.style.overflow_y = overflow_of(value)
        }
        "pos" => {
            spec.style.position = Position.Absolute
        }
        "display" => {
            spec.style.display = Display.None
        }
        "leaf" => {
            let halves = text.cut(value, "|")
            spec.measured = true
            spec.line_height = number(halves.after)
            for word in text.split(halves.before, ';') {
                if word.len > 0 {
                    spec.words.push(number(word))
                }
            }
        }
        _ => {}
    }
}

fn spec_of(line: str) -> Spec {
    let parts = text.fields(line)
    var spec = Spec { depth: i64(text.parse_int(parts[0]) or 0), style: Style {}, words: [], line_height: 0.0, measured: false }
    for part in parts[1..] {
        let pair = text.cut(part, "=")
        apply(mut spec, pair.before, pair.after)
    }
    spec
}

fn parse_sources(contents: str) -> Source[] {
    var sources: Source[] = []
    for raw in text.lines(contents) {
        let line = text.trim(raw)
        if line.len == 0 {
            continue
        }
        let name = text.strip_prefix(line, "TREE ")
        if name != none {
            sources.push(Source { name: name ?? "", specs: [] })
        } else {
            sources[sources.len - 1].specs.push(spec_of(line))
        }
    }
    sources
}

fn parse_expected(contents: str) -> Expected[] {
    var all: Expected[] = []
    for raw in text.lines(contents) {
        let parts = text.fields(raw)
        if parts.len == 0 {
            continue
        }
        if parts[0] == "RESULT" {
            all.push(Expected { name: parts[1], scale: number(parts[2]), rects: [] })
        } else {
            for part in parts[1..] {
                all[all.len - 1].rects.push(number(part))
            }
        }
    }
    all
}

fn measure_of(words: f32[], line_height: f32) -> fn(f32) -> geometry.Size {
    fn(width: f32) -> geometry.Size {
        var lines: f32 = 0.0
        var widest: f32 = 0.0
        var line_width: f32 = 0.0
        var open = false
        for word in words {
            if !open {
                open = true
                lines += 1.0
                line_width = word
            } else if line_width + space_width + word <= width {
                line_width = line_width + space_width + word
            } else {
                widest = larger(widest, line_width)
                lines += 1.0
                line_width = word
            }
        }
        if open {
            widest = larger(widest, line_width)
        }
        geometry.Size { width: widest, height: lines * line_height }
    }
}

fn build(mut t: Tree, c: *Cursor) -> i64 {
    let me = c.next
    c.next += 1
    let spec = c.specs[me]
    var children: i64[] = []
    for c.next < c.specs.len && c.specs[c.next].depth == spec.depth + 1 {
        children.push(build(mut t, c))
    }
    let id = if spec.measured {
        leaf(mut t, spec.style, measure_of(spec.words, spec.line_height))
    } else {
        node(mut t, spec.style, children)
    }
    c.ids[me] = id
    id
}

fn mismatch(mut t: Tree, source: Source, want: Expected) -> str {
    var c = new(Cursor { specs: source.specs, ids: [], next: 0 })
    for _ in source.specs {
        c.ids.push(0)
    }
    let root = build(mut t, c)
    compute(mut t, root, geometry.size(window_width, window_height))
    for i in 0..source.specs.len {
        let r = rect(t, c.ids[i])
        let got = [r.x, r.y, r.width, r.height]
        for k in 0..4 {
            if got[k] != want.rects[i * 4 + k] {
                return "{source.name} at scale {want.scale}, node {i}: got {got[0]} {got[1]} {got[2]} {got[3]}, want {want.rects[i * 4]} {want.rects[i * 4 + 1]} {want.rects[i * 4 + 2]} {want.rects[i * 4 + 3]}"
            }
        }
    }
    ""
}

fn check_scale(t: *testing.T, sources: Source[], goldens: str) {
    let expected = parse_expected(goldens)
    testing.equal(t, expected.len, sources.len)
    for i in 0..sources.len {
        var tr = tree(expected[i].scale)
        let message = mismatch(mut tr, sources[i], expected[i])
        if message.len > 0 {
            t.error(message)
        }
    }
}

fn read(t: *testing.T, name: str) -> str {
    file.read_text("testdata/ui_layout/{name}") catch {
        e => {
            t.fatal("read {name}: {e}")
            return ""
        }
    }
}

fn test_trees_match_the_flexbox_oracle_at_every_scale(t: *testing.T) {
    let sources = parse_sources(read(t, "oracle_trees.txt"))
    check_scale(t, sources, read(t, "oracle_golden_100.txt"))
    check_scale(t, sources, read(t, "oracle_golden_125.txt"))
    check_scale(t, sources, read(t, "oracle_golden_150.txt"))
    check_scale(t, sources, read(t, "oracle_golden_175.txt"))
}
