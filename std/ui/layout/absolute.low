import std/ui/geometry

enum Edge {
    Front
    Back
    Middle
}

enum Own {
    Normal
    Stretching
    Leading
    Centred
    Trailing
}

struct Strip {
    start: f32
    end: f32
}

struct Place {
    area: Strip
    edge: Edge
}

struct OofAxis {
    cb: f32
    first: f32?
    last: f32?
    margin_first: f32?
    margin_last: f32?
    place: Place
    own: Own
    inline: bool
    scroll: bool
}

fn align_in(strip: Strip, size: f32, edge: Edge) -> f32 {
    match edge {
        Front => strip.start
        Back => strip.end - size
        Middle => (strip.start + strip.end - size) / 2.0
    }
}

fn own_of(a: AlignSelf) -> Own {
    match a {
        Auto => Normal
        Stretch => Stretching
        Start => Leading
        End => Trailing
        Center => Centred
    }
}

fn physical_edge(own: Own) -> Edge {
    match own {
        Centred => Middle
        Trailing => Back
        _ => Front
    }
}

fn is_normal_own(own: Own) -> bool {
    match own {
        Normal => true
        _ => false
    }
}

fn modified_block(ax: OofAxis) -> Strip {
    var block = Strip { start: 0.0, end: ax.cb }
    var weaker_front = false
    match ax.first {
        some(first) => {
            match ax.last {
                some(last) => {
                    block = Strip { start: first, end: ax.cb - last }
                }
                none => {
                    block = Strip { start: first, end: ax.cb }
                }
            }
        }
        none => {
            match ax.last {
                some(last) => {
                    block = Strip { start: 0.0, end: ax.cb - last }
                    weaker_front = true
                }
                none => {
                    let p = ax.place
                    match p.edge {
                        Front => {
                            block = Strip { start: p.area.start, end: ax.cb }
                        }
                        Back => {
                            block = Strip { start: 0.0, end: p.area.end }
                        }
                        Middle => {
                            let centre = (p.area.start + p.area.end) / 2.0
                            let to_start = centre
                            let to_end = ax.cb - centre
                            if magnitude(to_start) <= magnitude(to_end) {
                                block = Strip { start: 0.0, end: 2.0 * to_start }
                            } else {
                                block = Strip { start: ax.cb - 2.0 * to_end, end: ax.cb }
                            }
                        }
                    }
                }
            }
        }
    }
    if block.end < block.start {
        if weaker_front {
            block.start = block.end
        } else {
            block.end = block.start
        }
    }
    block
}

fn stretch_fit(ax: OofAxis) -> f32 {
    let block = modified_block(ax)
    let margins = (ax.margin_first ?? 0.0) + (ax.margin_last ?? 0.0)
    larger((block.end - block.start) - margins, 0.0)
}

fn is_stretch_sized(ax: OofAxis) -> bool {
    let pinned = ax.first != none && ax.last != none
    if !pinned {
        return false
    }
    match ax.own {
        Stretching => true
        Normal => true
        _ => false
    }
}

fn resolve_margins(ax: OofAxis, size: f32) -> Strip {
    let both = ax.first != none && ax.last != none
    let block = modified_block(ax)
    let free = block.end - block.start - size
    match ax.margin_first {
        some(a) => {
            match ax.margin_last {
                some(b) => return Strip { start: a, end: b }
                none => {}
            }
        }
        none => {}
    }
    if !both {
        return Strip { start: ax.margin_first ?? 0.0, end: ax.margin_last ?? 0.0 }
    }
    match ax.margin_first {
        some(a) => return Strip { start: a, end: free - a }
        none => {}
    }
    match ax.margin_last {
        some(b) => return Strip { start: free - b, end: b }
        none => {}
    }
    if free < 0.0 && ax.inline {
        return Strip { start: 0.0, end: free }
    }
    Strip { start: free / 2.0, end: free / 2.0 }
}

fn oof_position(ax: OofAxis, size: f32, margin: Strip) -> f32 {
    let block = modified_block(ax)
    match ax.first {
        none => {
            match ax.last {
                none => {
                    let margin_box = size + margin.start + margin.end
                    return align_in(ax.place.area, margin_box, ax.place.edge) + margin.start
                }
                some(last) => return block.end - size - margin.end
            }
        }
        some(first) => {
            match ax.last {
                none => return block.start + margin.start
                some(last) => {}
            }
        }
    }
    if ax.margin_first == none || ax.margin_last == none {
        return block.start + margin.start
    }
    let margin_box = size + margin.start + margin.end
    let block_size = block.end - block.start
    let edge = physical_edge(ax.own)
    var start: f32 = 0.0
    if margin_box <= block_size || is_normal_own(ax.own) {
        start = align_in(block, margin_box, edge)
    } else {
        var limit = Strip { start: smaller(block.start, 0.0), end: larger(block.end, ax.cb) }
        if ax.scroll {
            limit.end = unbounded
        }
        if margin_box <= limit.end - limit.start {
            let aligned = align_in(block, margin_box, edge)
            start = larger(smaller(aligned, limit.end - margin_box), limit.start)
        } else {
            start = align_in(limit, margin_box, Front)
        }
    }
    start + margin.start
}

fn justify_edge(j: Justify) -> Edge {
    match j {
        Start => Front
        End => Back
        Center => Middle
        SpaceBetween => Front
        SpaceAround => Middle
        SpaceEvenly => Middle
    }
}

fn align_edge(a: Align) -> Edge {
    match a {
        End => Back
        Center => Middle
        _ => Front
    }
}

fn layout_absolute(mut t: Tree, n: i64, c: Consts, style: Style) {
    let container = container_size(c)
    let area = geometry.Size {
        width: container.width - (c.border.left + c.border.right)
        height: container.height - (c.border.top + c.border.bottom)
    }
    let offset = geometry.Point { x: c.border.left, y: c.border.top }
    let main_area = Strip { start: edge_lead(c.inset, c.row), end: c.container.main - edge_trail(c.inset, c.row) }
    let cross_area = Strip { start: edge_lead(c.inset, !c.row), end: c.container.cross - edge_trail(c.inset, !c.row) }
    for child in t.nodes[n].children {
        let cs = t.nodes[child].style
        if cs.display == None {
            hide(mut t, child)
            continue
        }
        if cs.position != Absolute {
            continue
        }
        let main_edge = justify_edge(c.justify)
        let cross_edge = align_edge(resolve_align(cs.align_self, c.align_items))
        let x_place = if c.row { Place { area: main_area, edge: main_edge } } else { Place { area: cross_area, edge: cross_edge } }
        let y_place = if c.row { Place { area: cross_area, edge: cross_edge } } else { Place { area: main_area, edge: main_edge } }
        place_absolute(mut t, child, area, offset, x_place, y_place, is_scroll(style.overflow_x), is_scroll(style.overflow_y))
    }
}

fn shifted(p: Place, by: f32) -> Place {
    Place { area: Strip { start: p.area.start - by, end: p.area.end - by }, edge: p.edge }
}

fn place_absolute(mut t: Tree, child: i64, area: geometry.Size, offset: geometry.Point, x_place: Place, y_place: Place, scroll_x: bool, scroll_y: bool) {
    let cs = t.nodes[child].style
    let aw = area.width
    let ah = area.height
    let basis_w: f32? = aw
    let basis_h: f32? = ah
    let pb = sum_edges(cs.padding, cs.border)
    let pbw = pb.left + pb.right
    let pbh = pb.top + pb.bottom
    let style_size = Dims { width: resolve(cs.width, basis_w), height: resolve(cs.height, basis_h) }
    let min = Dims {
        width: some(larger(resolve(cs.min_width, basis_w) ?? pbw, pbw))
        height: some(larger(resolve(cs.min_height, basis_h) ?? pbh, pbh))
    }
    let max = Dims { width: resolve(cs.max_width, basis_w), height: resolve(cs.max_height, basis_h) }
    var known = Dims {
        width: opt_clamp(style_size.width, min.width, max.width)
        height: opt_clamp(style_size.height, min.height, max.height)
    }
    let horizontal = OofAxis {
        cb: aw
        first: resolve(cs.inset.left, basis_w)
        last: resolve(cs.inset.right, basis_w)
        margin_first: resolve(cs.margin.left, basis_w)
        margin_last: resolve(cs.margin.right, basis_w)
        place: shifted(x_place, offset.x)
        own: Normal
        inline: true
        scroll: scroll_x
    }
    let vertical = OofAxis {
        cb: ah
        first: resolve(cs.inset.top, basis_h)
        last: resolve(cs.inset.bottom, basis_h)
        margin_first: resolve(cs.margin.top, basis_w)
        margin_last: resolve(cs.margin.bottom, basis_w)
        place: shifted(y_place, offset.y)
        own: own_of(cs.align_self)
        inline: false
        scroll: scroll_y
    }
    let fit = geometry.Size { width: stretch_fit(horizontal), height: stretch_fit(vertical) }
    let space = Space {
        width: Avail.Definite(clamp_to(fit.width, min.width, max.width))
        height: Avail.Definite(clamp_to(fit.height, min.height, max.height))
    }
    let stretch_width = known.width == none && is_stretch_sized(horizontal)
    let stretch_height = known.height == none && is_stretch_sized(vertical)
    if stretch_width {
        known.width = some(fit.width)
        known = Dims {
            width: opt_clamp(known.width, min.width, max.width)
            height: opt_clamp(known.height, min.height, max.height)
        }
    }
    if known.height == none && stretch_height {
        known.height = some(fit.height)
        known = Dims {
            width: opt_clamp(known.width, min.width, max.width)
            height: opt_clamp(known.height, min.height, max.height)
        }
    }
    var size = geometry.Size {}
    match known.width {
        some(w) => {
            match known.height {
                some(h) => {
                    size = geometry.Size { width: w, height: h }
                }
                none => {
                    size = measured_both(mut t, child, known, area, space, min, max)
                }
            }
        }
        none => {
            size = measured_both(mut t, child, known, area, space, min, max)
        }
    }
    let _ = compute_child(mut t, child, Input {
        known: Dims { width: size.width, height: size.height }
        definite: Known {}
        parent: Dims { width: aw, height: ah }
        space
        sizing: ContentSize
        axis: Both
        run: PerformLayout
    })
    let horizontal_margin = resolve_margins(horizontal, size.width)
    let vertical_margin = resolve_margins(vertical, size.height)
    t.nodes[child].size = size
    t.nodes[child].location = geometry.Point {
        x: oof_position(horizontal, size.width, horizontal_margin) + offset.x
        y: oof_position(vertical, size.height, vertical_margin) + offset.y
    }
}

fn measured_both(mut t: Tree, child: i64, known: Dims, area: geometry.Size, space: Space, min: Dims, max: Dims) -> geometry.Size {
    let measured = measure_child(mut t, child, known, Dims { width: area.width, height: area.height }, space, Both)
    geometry.Size {
        width: clamp_to(known.width ?? measured.width, min.width, max.width)
        height: clamp_to(known.height ?? measured.height, min.height, max.height)
    }
}
