/// A cell of state shared by every window of an application. Reading it inside an effect, a memo or a tracked frame makes that reader depend on it, and changing it runs the effects that depend on it and requests a frame.
///
/// A signal is a handle: copies share the cell. It belongs to the green thread that runs the application's windows; another green thread changes it through `post`.
pub struct Signal[T] {
    cell: *Cell[T]
}

struct Cell[T] {
    value: T
    owner: *Shared
    node: *Node
}

/// Returns a new signal holding `value`, shared by the windows of the application `cx` belongs to.
pub fn signal[T](cx: Context, value: T) -> Signal[T] {
    let owner = cx.state.shared
    Signal { cell: new(Cell { value, owner, node: new_node(owner.graph) }) }
}

/// Returns the value `s` holds, and makes the running effect, memo or tracked frame depend on `s`.
pub fn get[T](s: Signal[T]) -> T {
    track(s.cell.node)
    s.cell.value
}

/// Replaces the value `s` holds with `value`, runs the effects that read it, and requests a frame: in every window whose frames are not tracked, and in each tracked window whose last frame read `s` or a memo that changes with it.
pub fn set[T](s: Signal[T], value: T) {
    s.cell.value = value
    s.cell.owner.generation += 1
    changed_source(s.cell.node)
}

/// Replaces the value `s` holds with `f` applied to it, as `set` does.
pub fn update[T](s: Signal[T], f: fn(T) -> T) {
    let next = f(s.cell.value)
    set(s, next)
}
