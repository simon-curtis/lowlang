/// A cell of state shared by every window of an application. Changing it requests a frame in each of them.
///
/// A signal is a handle: copies share the cell. It belongs to the green thread that runs the application's windows; another green thread changes it through `post`.
pub struct Signal[T] {
    cell: *Cell[T]
}

struct Cell[T] {
    value: T
    owner: *Shared
}

/// Returns a new signal holding `value`, shared by the windows of the application `cx` belongs to.
pub fn signal[T](cx: Context, value: T) -> Signal[T] {
    Signal { cell: new(Cell { value, owner: cx.state.shared }) }
}

/// Returns the value `s` holds.
pub fn get[T](s: Signal[T]) -> T {
    s.cell.value
}

/// Replaces the value `s` holds with `value` and requests a frame.
pub fn set[T](s: Signal[T], value: T) {
    s.cell.value = value
    s.cell.owner.generation += 1
}

/// Replaces the value `s` holds with `f` applied to it, as `set` does.
pub fn update[T](s: Signal[T], f: fn(T) -> T) {
    let next = f(s.cell.value)
    set(s, next)
}
