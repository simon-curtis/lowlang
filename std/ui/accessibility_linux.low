import std/atspi
import std/text
import std/ui/platform

struct Attached {
    bridge: atspi.Bridge? = none
}

fn attach_accessibility(cx: Context, application: str) -> Accessibility ! platform.Error {
    let link = new(Attached {})
    let bridge = atspi.connect(application, notifier(cx, link)) catch {
        e => fail platform.Error.Unsupported("the accessibility bus: {e}")
    }
    link.bridge = some(bridge)
    publish_after_frames(cx, bridge)
    Accessibility { release: fn() { atspi.close(bridge) } }
}

fn notifier(cx: Context, link: *Attached) -> fn() {
    let h = handle(cx)
    fn() { post(h, fn() { run_requests(cx, link) }) }
}

fn run_requests(cx: Context, link: *Attached) {
    let bridge = link.bridge ?? return
    for request in atspi.take_actions(bridge) {
        match request {
            Click(key) => click_element(cx, key)
            Focus(key) => set_focus(cx, key)
        }
    }
}

fn publish_after_frames(cx: Context, bridge: atspi.Bridge) {
    on_frame(cx, fn() {
        atspi.update(bridge, window_title(cx), window_focused(cx), nodes_of(elements(cx))) or {}
    })
}

fn nodes_of(elements: ElementInfo[]) -> atspi.Node[] {
    let named: [str: bool] = [:]
    for e in elements {
        if pressable(e.role) {
            named[e.key] = true
        }
    }
    var nodes: atspi.Node[] = []
    for e in elements {
        if !is_part_of(e, named) {
            nodes.push(node_of(e))
        }
    }
    nodes
}

fn is_part_of(e: ElementInfo, named: [str: bool]) -> bool {
    let slash = text.last_index_byte(e.key, '/')
    e.role == Role.Text && slash > 0 && named[e.key[..slash]] != none
}

fn atspi_role(r: Role) -> atspi.Role {
    match r {
        Generic => atspi.Role.Panel
        Button => atspi.Role.Button
        Link => atspi.Role.Link
        Heading => atspi.Role.Heading
        Text => atspi.Role.Label
        TextInput => atspi.Role.Entry
        Image => atspi.Role.Image
        Checkbox => atspi.Role.CheckBox
        List => atspi.Role.List
        ListItem => atspi.Role.ListItem
        Tab => atspi.Role.PageTab
        Menu => atspi.Role.Menu
        MenuItem => atspi.Role.MenuItem
        Dialog => atspi.Role.Dialog
    }
}

fn pressable(r: Role) -> bool {
    match r {
        Button => true
        Link => true
        Checkbox => true
        ListItem => true
        Tab => true
        MenuItem => true
        _ => false
    }
}

fn spoken_text(e: ElementInfo) -> str? {
    match e.role {
        Text => some(e.label)
        Heading => some(e.label)
        TextInput => some(e.text)
        _ => none
    }
}

fn node_of(e: ElementInfo) -> atspi.Node {
    let actionable = pressable(e.role)
    let editable = e.role == Role.TextInput
    atspi.Node {
        key: e.key,
        name: e.label,
        role: atspi_role(e.role),
        x: f64(e.bounds.x),
        y: f64(e.bounds.y),
        width: f64(e.bounds.width),
        height: f64(e.bounds.height),
        visible: e.visible,
        focused: e.focused,
        focusable: actionable || editable,
        actionable,
        editable,
        text: spoken_text(e),
    }
}
