import std/ui/geometry
import std/ui/gpu
import std/ui/platform

/// What `open_window` needs to make a window beside the application's others.
///
/// A context made by `headless` has no system window, so it keeps only `background`, `owner` and `closed`. The Wayland backend ignores `placement` and `taskbar`, as `platform.Options` says.
pub struct WindowOptions {
    /// The window title.
    pub title: str = "Low"
    /// The width of the content, in logical pixels.
    pub width: i64 = 800
    /// The height of the content, in logical pixels.
    pub height: i64 = 600
    /// The smallest content width the user can resize the window to, in logical pixels. Zero means no limit.
    pub min_width: i64 = 0
    /// The smallest content height the user can resize the window to, in logical pixels. Zero means no limit.
    pub min_height: i64 = 0
    /// The colour every frame is cleared to before the elements are drawn.
    pub background: geometry.Color = geometry.rgb(0xffffff)
    /// What the system draws above the content.
    pub titlebar: TitlebarOptions = TitlebarOptions {}
    /// The window this one belongs to. It stays above its owner, minimises with it and closes before it.
    pub owner: Window? = none
    /// Where the window first appears.
    pub placement: Placement = Placement.CentreOnOwner
    /// `true` gives the window its own taskbar button, even when it has an owner.
    pub taskbar: bool = true
    /// `false` shows the window without activating it, so it takes neither the keyboard focus nor the foreground from the program the user is working in. See `platform.Options.activate`.
    pub activate: bool = true
    /// Runs on the UI green thread once the window has closed, with why it closed.
    pub closed: fn(CloseReason) = ignore_closed
}

/// Why a window closed.
pub enum CloseReason {
    /// The user or the program closed it.
    Requested
    /// The error that closed it.
    Failed(Error)
}

/// Where a new window first appears.
pub enum Placement {
    /// Wherever the system puts a new window.
    System
    /// Centred on the owner, kept inside the work area of the owner's monitor. A window with no owner is centred on the main window.
    CentreOnOwner
    /// Centred on the work area of the monitor that holds the main window.
    CentreOnScreen
}

fn ignore_closed(why: CloseReason) {}

fn blank_view() -> Element {
    div()
}

struct Seat {
    window: platform.WindowHandle
    presenter: gpu.PresenterHandle
}

struct Opened {
    state: *State
    seat: Seat? = none
}

struct WindowSlot {
    state: *State
    owner: Window?
    closed: fn(CloseReason)
    render: fn() -> Element
    seat: Seat? = none
    deadline: i64 = 0
    open: bool = true
}

/// A copyable handle to an open window of the application.
pub struct Window {
    slot: *WindowSlot
}

fn register(sh: *Shared, opened: Opened, owner: Window?, closed: fn(CloseReason), render: fn() -> Element) -> Window {
    let st = opened.state
    let deadline = sh.clock() + reveal_deadline_ms
    let w = Window { slot: new(WindowSlot { state: st, owner, closed, render, seat: opened.seat, deadline }) }
    st.window = w
    sh.windows.push(w)
    w
}

fn same_window(a: Window, b: Window) -> bool {
    a.slot == b.slot
}

fn closed_window(st: *State) -> bool {
    match st.window {
        some(w) => !w.slot.open
        none => false
    }
}

fn request_close(st: *State) {
    let w = st.window ?? return
    let main = st.shared.main ?? return
    if same_window(w, main) {
        st.closed = true
        return
    }
    close_window(w)
}

/// Opens a window in the application that `cx` belongs to, and returns once it exists. The window shares the application's signals, keymap, clipboard, posts and clock, and takes the rem size of `cx`.
///
/// In an application that `open` made, the window is a system window that `render` builds the tree of, which `run` draws and presents. It stays invisible until its first frame is presented, or until 500 milliseconds after it opened or `run` started, whichever is later, and it fails with the error that opening the system window or its swapchain returns. The Wayland backend opens one window only, so there it fails with `Platform(Unsupported(detail))`.
///
/// A window of a context made by `headless` has no system window: drive it with `frame` and `dispatch` on `window_context(w)`, and `frame` takes the render function, so `render` is not used. In every context it fails with `Platform(Unsupported(detail))` when `o.owner` has closed or belongs to another application, and when it is called while a frame is being built, since the functions that build a frame have no side effects.
pub fn open_window(cx: Context, o: WindowOptions, render: fn() -> Element) -> Window ! Error {
    let sh = cx.state.shared
    if sh.rendering {
        fail Platform(platform.Error.Unsupported("open_window inside render"))
    }
    match o.owner {
        some(owner) => {
            if !is_open(owner) {
                fail Platform(platform.Error.Unsupported("open_window with an owner that has closed"))
            }
            if owner.slot.state.shared != sh {
                fail Platform(platform.Error.Unsupported("open_window with an owner from another application"))
            }
        }
        none => {}
    }
    let opened = sh.open(sh, o)?
    opened.state.rem = cx.state.rem
    register(sh, opened, o.owner, o.closed, render)
}

fn owned_by(w: Window, owner: Window) -> bool {
    match w.slot.owner {
        some(o) => same_window(o, owner)
        none => false
    }
}

fn closing_order(sh: *Shared, w: Window) -> Window[] {
    var order: Window[] = []
    for c in sh.windows {
        if owned_by(c, w) {
            for owned in closing_order(sh, c) {
                order.push(owned)
            }
        }
    }
    order.push(w)
    order
}

/// Closes `w` and every window it owns, owned windows first, then runs each one's `closed` callback with `Requested`. Closing a window that is already closed does nothing, and so does a call made while a frame is being built. The system windows go before any callback runs. The context of a closed window stays valid and draws nothing.
pub fn close_window(w: Window) {
    close_with(w, CloseReason.Requested)
}

fn close_with(w: Window, why: CloseReason) {
    let sh = w.slot.state.shared
    if !w.slot.open || sh.rendering {
        return
    }
    let order = closing_order(sh, w)
    for c in order {
        c.slot.open = false
        c.slot.state.closed = true
    }
    var remaining: Window[] = []
    for c in sh.windows {
        if c.slot.open {
            remaining.push(c)
        }
    }
    sh.windows = remaining
    for c in order {
        release_seat(c.slot)
    }
    for c in order {
        let reason = if same_window(c, w) { why } else { CloseReason.Requested }
        c.slot.closed(reason)
    }
}

fn release_seat(slot: *WindowSlot) {
    match slot.seat {
        some(seat) => {
            gpu.close_presenter_on(seat.presenter)
            platform.close_on(seat.window)
            slot.seat = none
        }
        none => {}
    }
}

fn open_windows(sh: *Shared) -> Window[] {
    var open: Window[] = []
    for w in sh.windows {
        if w.slot.open {
            open.push(w)
        }
    }
    open
}

fn is_main(w: Window) -> bool {
    match w.slot.state.shared.main {
        some(main) => same_window(w, main)
        none => false
    }
}

fn close_tools(sh: *Shared) {
    for w in open_windows(sh) {
        if !is_main(w) {
            close_window(w)
        }
    }
}

fn close_all(sh: *Shared) {
    close_tools(sh)
    match sh.main {
        some(main) => close_window(main)
        none => {}
    }
}

/// Brings `w` to the front and gives it the keyboard focus, restoring it first when it is minimised, as `platform.activate` does. A window of a context made by `headless`, and a window that has closed, have no system window, so the call does nothing.
pub fn activate_window(w: Window) {
    let seat = w.slot.seat ?? return
    platform.activate(platform.controls_on(seat.window))
}

/// Returns `true` until `w` has closed.
pub fn is_open(w: Window) -> bool {
    w.slot.open
}

/// Returns the context of `w`'s user interface, for focus, scrolling, overlays and actions inside it.
pub fn window_context(w: Window) -> Context {
    Context { state: w.slot.state }
}

/// Returns the first window of the application, the one `open` or `headless` made.
pub fn main_window(cx: Context) -> Window {
    cx.state.shared.main ?? panic("the application has no main window")
}
