import std/ui/geometry
import std/ui/scene

struct Drawing {
    draw: fn(Painter)
}

enum Shape {
    Filled(path: scene.Path)
    Boxed(quad: scene.Quad)
}

struct Painting {
    origin: geometry.Point
    scale: f32
    opacity: f32
    shapes: Shape[] = []
}

/// What the paint function of a `canvas` draws with: the size of the canvas and the shapes drawn so far.
///
/// Every point, rectangle, radius and stroke width a method takes is in logical pixels, and a point is measured from the top left of the canvas's content box. `std/ui` turns them into device pixels, multiplies each colour's alpha by the opacity of the canvas and its parents, and clips the shapes. A painter is a handle: copies draw to the same canvas, and what it is given after the paint function has returned is not drawn.
pub struct Painter {
    /// The width of the canvas's content box in logical pixels.
    pub width: f32
    /// The height of the canvas's content box in logical pixels.
    pub height: f32
    state: *Painting
}

/// Returns a box that calls `paint` each frame it is drawn, with a `Painter` for its content box, and draws the shapes `paint` makes above its background and under its children and border.
///
/// The canvas is an ordinary box: an empty flex row with no size of its own, so `size`, `width`, `height`, `grow` and the other builders size it, `background`, `border`, `padding` and `opacity` apply, and `on_click`, `on_mouse_move`, `hover` and `cursor` work on it as on any element. `canvas_point` turns the window position an event carries into a point of the canvas. Children draw above the shapes, which is how a chart carries text: `std/ui` lays them out in the content box like those of any box.
///
/// Shapes are in logical pixels from the top left of the content box and draw in the order `paint` makes them. They are clipped to the canvas's padding box, so padding leaves room for a stroke that runs along an edge of the content box, and to the clips of the canvas's parents, and they move with the scroll offsets of its parents; a canvas that itself scrolls moves its children and not its shapes. A shape whose colour is transparent once faded is not drawn. `paint` runs while the frame is painted, after layout, and does not run for a canvas that is `invisible` or inside an `invisible` element; it only draws, and a `paint` that sets a signal makes another frame due each time it runs.
///
/// The fills and strokes are the paths of `std/ui/scene` and keep their limits. A polygon is filled as a fan of triangles from its first point with no fill rule, so only a convex outline, or one every point of which the first point sees, fills as drawn; `fill_area` fills the shape under a line, which a fan cannot. A stroke has butt caps and mitred corners that are bevelled when sharp, and where a segment is shorter than the reach of its corner the triangles of a stroke overlap inside the turn, so a translucent stroke is darker there. A translucent polygon whose triangles overlap is darker where they do.
pub fn canvas(paint: fn(Painter)) -> Element {
    Element { extras: new(Extras { drawing: Drawing { draw: paint } }) }
}

/// Returns `position`, a point in logical pixels from the top left of the window as an event carries it, measured from the top left of the content box of the canvas whose key is `key`, its id or its position in the tree such as `"0/1"`, as the last frame placed it, or `none` when the last frame placed no canvas under that key. The point is the one a `Painter` method draws at, and lies outside `0` to the painter's `width` and `height` when `position` is outside the content box.
pub fn canvas_point(cx: Context, key: str, position: geometry.Point) -> geometry.Point? {
    let content = cx.state.canvases[key] ?? return none
    geometry.point(position.x - content.x, position.y - content.y)
}

fn paint_canvas(mut sc: scene.Scene, d: Drawing, padding_box: geometry.Rect, content: geometry.Rect, opacity: f32, scale: f32) {
    let state = new(Painting { origin: geometry.point(content.x, content.y), scale, opacity })
    let draw = d.draw
    draw(Painter { width: content.width, height: content.height, state })
    scene.push_clip(mut sc, geometry.cover(padding_box, scale))
    for s in state.shapes {
        match s {
            Filled(path) => {
                if path.color.a > 0.0 {
                    scene.push_path(mut sc, path)
                }
            }
            Boxed(quad) => {
                if quad.background.a > 0.0 {
                    scene.push_quad(mut sc, quad)
                }
            }
        }
    }
    scene.pop_clip(mut sc)
}

fn device_point(s: *Painting, at: geometry.Point) -> geometry.Point {
    geometry.point((s.origin.x + at.x) * s.scale, (s.origin.y + at.y) * s.scale)
}

fn device_points(s: *Painting, points: geometry.Point[]) -> geometry.Point[] {
    var out: geometry.Point[] = []
    for at in points {
        out.push(device_point(s, at))
    }
    out
}

fn local_curve(s: *Painting, a: geometry.Point, flattened: geometry.Point[], b: geometry.Point) -> geometry.Point[] {
    var out: geometry.Point[] = [a]
    for i in 1..flattened.len - 1 {
        out.push(geometry.point(flattened[i].x / s.scale - s.origin.x, flattened[i].y / s.scale - s.origin.y))
    }
    out.push(b)
    out
}

fn ink(s: *Painting, color: geometry.Color) -> geometry.Color {
    faded(color, s.opacity)
}

fn solid_vertex(at: geometry.Point) -> scene.PathVertex {
    scene.PathVertex { position: at, st: geometry.point(0.0, 1.0) }
}

/// Fills the rectangle `r` with `color`, its edges rounded to the nearest device pixel as those of an element's background are.
pub fn fill_rect(p: Painter, r: geometry.Rect, color: geometry.Color) {
    let s = p.state
    let bounds = geometry.snap(geometry.offset(r, s.origin.x, s.origin.y), s.scale)
    s.shapes.push(Boxed(scene.Quad { bounds, background: ink(s, color) }))
}

/// Fills the circle of `radius` around `center` with `color`.
pub fn fill_circle(p: Painter, center: geometry.Point, radius: f32, color: geometry.Color) {
    let s = p.state
    let middle = device_point(s, center)
    let reach = radius * s.scale
    let bounds = geometry.rect(middle.x - reach, middle.y - reach, 2.0 * reach, 2.0 * reach)
    s.shapes.push(Boxed(scene.Quad { bounds, background: ink(s, color), corner_radii: geometry.corners(reach) }))
}

/// Fills the triangle `a`, `b`, `c` with `color`.
pub fn fill_triangle(p: Painter, a: geometry.Point, b: geometry.Point, c: geometry.Point, color: geometry.Color) {
    fill_polygon(p, [a, b, c], color)
}

/// Fills the outline through `points`, closed from the last back to the first, with `color`. The fill is a fan of triangles from the first point, so it is right for a convex outline and for one where the straight line from the first point to every other point stays inside; any other outline fills areas outside it. Fewer than three points fill nothing.
pub fn fill_polygon(p: Painter, points: geometry.Point[], color: geometry.Color) {
    if points.len < 3 {
        return
    }
    let s = p.state
    var path = scene.path(device_point(s, points[0]), ink(s, color))
    for i in 1..points.len {
        scene.line_to(mut path, device_point(s, points[i]))
    }
    s.shapes.push(Filled(path))
}

/// Fills the area between the line through `points` and the horizontal line at `baseline` with `color`, as an area chart does: each segment fills the quadrilateral down or up to the baseline, and a segment that crosses the baseline fills a triangle on each side of it. The triangles do not overlap while `points` run in one direction along x, so a translucent colour is even. Fewer than two points fill nothing.
pub fn fill_area(p: Painter, points: geometry.Point[], baseline: f32, color: geometry.Color) {
    if points.len < 2 {
        return
    }
    let s = p.state
    var path = scene.path(device_point(s, points[0]), ink(s, color))
    for i in 1..points.len {
        fill_span(s, mut path, points[i - 1], points[i], baseline)
    }
    s.shapes.push(Filled(path))
}

fn fill_span(s: *Painting, mut path: scene.Path, a: geometry.Point, b: geometry.Point, baseline: f32) {
    let below_a = geometry.point(a.x, baseline)
    let below_b = geometry.point(b.x, baseline)
    let rise_a = a.y - baseline
    let rise_b = b.y - baseline
    if rise_a * rise_b < 0.0 {
        let t = rise_a / (rise_a - rise_b)
        let crossing = geometry.point(a.x + (b.x - a.x) * t, baseline)
        push_solid_triangle(s, mut path, a, crossing, below_a)
        push_solid_triangle(s, mut path, crossing, b, below_b)
        return
    }
    push_solid_triangle(s, mut path, a, b, below_b)
    push_solid_triangle(s, mut path, a, below_b, below_a)
}

fn push_solid_triangle(s: *Painting, mut path: scene.Path, a: geometry.Point, b: geometry.Point, c: geometry.Point) {
    scene.push_triangle(mut path, solid_vertex(device_point(s, a)), solid_vertex(device_point(s, b)), solid_vertex(device_point(s, c)))
}

/// Draws the straight line from `a` to `b`, `width` wide, in `color`, with butt caps.
pub fn stroke_line(p: Painter, a: geometry.Point, b: geometry.Point, width: f32, color: geometry.Color) {
    stroke_polyline(p, [a, b], width, color)
}

/// Draws the line through `points`, `width` wide, in `color`, with butt caps and each corner mitred, or bevelled where the mitre would be longer than four half-widths. Where a segment is shorter than the reach of its corner the stroke's triangles overlap inside the turn, so a translucent `color` is darker there. Fewer than two points, or a `width` of zero or less, draw nothing.
pub fn stroke_polyline(p: Painter, points: geometry.Point[], width: f32, color: geometry.Color) {
    let s = p.state
    if points.len < 2 || width <= 0.0 {
        return
    }
    s.shapes.push(Filled(scene.stroke_polyline(device_points(s, points), width * s.scale, ink(s, color))))
}

/// Draws the quadratic curve from `a` to `b` bending towards `ctrl`, `width` wide, in `color`, as `stroke_polyline` draws the points of `quadratic_points`.
pub fn stroke_quadratic(p: Painter, a: geometry.Point, ctrl: geometry.Point, b: geometry.Point, width: f32, color: geometry.Color) {
    stroke_polyline(p, quadratic_points(p, a, ctrl, b), width, color)
}

/// Draws the cubic curve from `a` to `b` with control points `c1` and `c2`, `width` wide, in `color`, as `stroke_polyline` draws the points of `cubic_points`.
pub fn stroke_cubic(p: Painter, a: geometry.Point, c1: geometry.Point, c2: geometry.Point, b: geometry.Point, width: f32, color: geometry.Color) {
    stroke_polyline(p, cubic_points(p, a, c1, c2, b), width, color)
}

/// Returns the points of a line within a tenth of a device pixel of the quadratic curve from `a` to `b` bending towards `ctrl`, from `a` to `b` inclusive, for `fill_polygon`, `fill_area` and `stroke_polyline` to draw a shape with a curved side.
pub fn quadratic_points(p: Painter, a: geometry.Point, ctrl: geometry.Point, b: geometry.Point) -> geometry.Point[] {
    let s = p.state
    local_curve(s, a, scene.flatten_quad(device_point(s, a), device_point(s, ctrl), device_point(s, b)), b)
}

/// Returns the points of a line within a tenth of a device pixel of the cubic curve from `a` to `b` with control points `c1` and `c2`, from `a` to `b` inclusive, for `fill_polygon`, `fill_area` and `stroke_polyline` to draw a shape with a curved side.
pub fn cubic_points(p: Painter, a: geometry.Point, c1: geometry.Point, c2: geometry.Point, b: geometry.Point) -> geometry.Point[] {
    let s = p.state
    local_curve(s, a, scene.flatten_cubic(device_point(s, a), device_point(s, c1), device_point(s, c2), device_point(s, b)), b)
}
