import std/ui/platform

struct Connection {
    inbox: *Inbox
    drop discard_events(inbox)
}

fn discard_events(inbox: *Inbox) {
    inbox.events = []
}

struct Inbox {
    events: platform.Event[] = []
}

struct Link {
    first: platform.WindowHandle
    inbox: *Inbox
}

fn connect() -> Connection ! platform.Error {
    Connection { inbox: new(Inbox {}) }
}

fn open_first(c: Connection, o: platform.Options) -> platform.Window ! platform.Error {
    platform.open(o)?
}

fn link_of(c: Connection, first: platform.WindowHandle) -> Link {
    Link { first, inbox: c.inbox }
}

fn open_beside(l: Link, o: platform.Options) -> platform.Window ! platform.Error {
    fail platform.Error.Unsupported("a window beside another needs a connection that its windows share")
}

fn waker_of_link(l: Link) -> platform.Waker {
    platform.waker_on(l.first)
}

fn wait_link(l: Link, timeout_ms: i64) ! platform.Error {
    let arrived = platform.next_on(l.first, timeout_ms)?
    for e in arrived {
        l.inbox.events.push(e)
    }
}

fn events_link(l: Link, w: platform.WindowHandle) -> platform.Event[] ! platform.Error {
    var events = l.inbox.events
    l.inbox.events = []
    let fresh = platform.next_on(w, 0)?
    for e in fresh {
        events.push(e)
    }
    events
}
