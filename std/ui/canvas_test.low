import std/testing
import std/ui/geometry
import std/ui/scene

struct Tally {
    runs: i64 = 0
    width: f32 = 0.0
    height: f32 = 0.0
    at: geometry.Point? = none
    early: geometry.Point? = none
    points: i64 = 0
    first_x: f32 = 0.0
    last_x: f32 = 0.0
}

fn ink_colour() -> geometry.Color {
    geometry.rgb(0x112233)
}

fn diagonal(p: Painter) {
    p.stroke_line(geometry.point(10.0, 10.0), geometry.point(90.0, 40.0), 4.0, ink_colour())
}

fn level(p: Painter) {
    p.stroke_line(geometry.point(0.0, 20.0), geometry.point(100.0, 20.0), 4.0, ink_colour())
}

fn framed(inner: Element) -> Element {
    div().padding_left(20.0).padding_top(30.0).child(inner)
}

fn inside(outer: geometry.Rect, inner: geometry.Rect) -> bool {
    inner.x >= outer.x - 0.01 && inner.y >= outer.y - 0.01 && geometry.right(inner) <= geometry.right(outer) + 0.01 && geometry.bottom(inner) <= geometry.bottom(outer) + 0.01
}

fn test_a_stroke_lands_inside_the_canvas_at_its_place_in_the_layout(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let sc = shot(cx, fn() -> Element { framed(canvas(diagonal).size(100.0, 50.0)) })
    testing.equal(t, sc.paths.len, 1)
    let path = sc.paths[0]
    testing.equal(t, path.vertices.len, 6)
    testing.is_true(t, inside(geometry.rect(20.0, 30.0, 100.0, 50.0), path.bounds))
    testing.is_true(t, inside(path.bounds, geometry.rect(30.0, 40.0, 80.0, 30.0)))
    testing.equal(t, path.color.r, ink_colour().r)
    testing.equal(t, path.color.a, 1.0)
}

fn test_the_painter_reports_the_content_box_and_draws_from_its_top_left(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let seen = new(Tally {})
    let paint = fn(p: Painter) {
        seen.runs += 1
        seen.width = p.width
        seen.height = p.height
        p.fill_triangle(geometry.point(0.0, 0.0), geometry.point(p.width, 0.0), geometry.point(0.0, p.height), ink_colour())
    }
    let sc = shot(cx, fn() -> Element { framed(canvas(paint).size(100.0, 50.0).padding(5.0).border(2.0, rgb(0x000000))) })
    testing.equal(t, seen.runs, 1)
    testing.equal(t, seen.width, 86.0)
    testing.equal(t, seen.height, 36.0)
    same_rect(t, sc.paths[0].bounds, geometry.rect(27.0, 37.0, 86.0, 36.0))
    testing.equal(t, sc.paths[0].vertices.len, 3)
}

fn test_shapes_are_clipped_to_the_padding_box_of_the_canvas(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let paint = fn(p: Painter) {
        p.stroke_line(geometry.point(-50.0, 10.0), geometry.point(400.0, 10.0), 4.0, ink_colour())
        p.stroke_line(geometry.point(0.0, 50.0), geometry.point(50.0, 50.0), 4.0, ink_colour())
    }
    let sc = shot(cx, fn() -> Element { framed(canvas(paint).size(100.0, 50.0).padding(5.0).border(2.0, rgb(0x000000))) })
    testing.equal(t, sc.paths.len, 1)
    same_rect(t, sc.paths[0].clip, geometry.rect(22.0, 32.0, 96.0, 46.0))
    testing.is_true(t, sc.paths[0].bounds.width > 400.0)
}

fn test_a_clipping_parent_narrows_the_clip_of_the_shapes(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(60.0, 30.0).overflow_hidden().child(canvas(level).size(100.0, 50.0).shrink(0.0))
    }
    let sc = shot(cx, view)
    testing.equal(t, sc.paths.len, 1)
    same_rect(t, sc.paths[0].clip, geometry.rect(0.0, 0.0, 60.0, 30.0))
}

fn scrolled_canvas() -> Element {
    div().id("pane").column().size(100.0, 50.0).overflow_y_scroll().children() {
        tile(0xff0000, 30.0),
        canvas(level).id("chart").height(40.0).shrink(0.0),
        tile(0x0000ff, 30.0),
    }
}

fn test_a_scrolled_parent_moves_the_shapes_and_the_point_of_an_event(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let still = shot(cx, scrolled_canvas)
    testing.equal(t, still.paths.len, 1)
    same_rect(t, still.paths[0].bounds, geometry.rect(0.0, 48.0, 100.0, 4.0))
    same_rect(t, still.paths[0].clip, geometry.rect(0.0, 30.0, 100.0, 20.0))

    scroll_to(cx, "pane", geometry.point(0.0, 25.0))
    let moved = shot(cx, scrolled_canvas)
    testing.equal(t, moved.paths.len, 1)
    same_rect(t, moved.paths[0].bounds, geometry.rect(0.0, 23.0, 100.0, 4.0))
    same_rect(t, moved.paths[0].clip, geometry.rect(0.0, 5.0, 100.0, 40.0))
    let at = canvas_point(cx, "chart", geometry.point(10.0, 25.0)) ?? geometry.point(-1.0, -1.0)
    testing.equal(t, at.x, 10.0)
    testing.equal(t, at.y, 20.0)
}

fn test_opacity_of_the_canvas_and_its_parents_fades_every_shape(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let paint = fn(p: Painter) {
        p.stroke_line(geometry.point(0.0, 5.0), geometry.point(50.0, 5.0), 2.0, geometry.rgba(0xff000080))
        p.fill_rect(geometry.rect(0.0, 20.0, 10.0, 10.0), geometry.rgb(0x00ff00))
        p.fill_polygon([geometry.point(60.0, 0.0), geometry.point(90.0, 0.0), geometry.point(90.0, 30.0), geometry.point(60.0, 30.0)], geometry.rgb(0x0000ff))
        p.fill_area([geometry.point(0.0, 40.0), geometry.point(20.0, 35.0)], 45.0, geometry.rgb(0x0000ff))
        p.fill_circle(geometry.point(40.0, 40.0), 4.0, geometry.rgb(0x00ff00))
    }
    let sc = shot(cx, fn() -> Element { div().opacity(0.5).child(canvas(paint).size(100.0, 50.0).opacity(0.5)) })
    testing.equal(t, sc.paths.len, 3)
    testing.is_true(t, near(sc.paths[0].color.a, 0.25 * 128.0 / 255.0))
    testing.is_true(t, near(sc.paths[1].color.a, 0.25))
    testing.is_true(t, near(sc.paths[2].color.a, 0.25))
    testing.equal(t, sc.quads.len, 2)
    testing.is_true(t, near(sc.quads[0].background.a, 0.25))
    testing.is_true(t, near(sc.quads[1].background.a, 0.25))
}

fn test_shapes_faded_to_nothing_stay_out_of_the_scene(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let paint = fn(p: Painter) {
        level(p)
        p.fill_rect(geometry.rect(0.0, 0.0, 10.0, 10.0), ink_colour())
        p.fill_circle(geometry.point(40.0, 40.0), 4.0, geometry.rgba(0x00ff0000))
    }
    let clear = shot(cx, fn() -> Element { canvas(paint).size(100.0, 50.0).opacity(0.0) })
    testing.equal(t, clear.paths.len + clear.quads.len, 0)
    let solid = shot(cx, fn() -> Element { canvas(paint).size(100.0, 50.0) })
    testing.equal(t, solid.paths.len, 1)
    testing.equal(t, solid.quads.len, 1)
}

fn test_canvas_point_forgets_a_canvas_the_last_frame_did_not_place(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, fn() -> Element { canvas(diagonal).id("chart").size(100.0, 50.0) })
    testing.is_true(t, canvas_point(cx, "chart", geometry.point(1.0, 1.0)) != none)
    shot(cx, fn() -> Element { div().id("chart").size(100.0, 50.0) })
    testing.is_true(t, canvas_point(cx, "chart", geometry.point(1.0, 1.0)) == none)
}

fn test_a_canvas_keeps_its_paint_function_when_it_takes_a_scrollbar(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        canvas(level).id("pane").column().size(100.0, 50.0).overflow_y_scroll().scrollbar(bar_options()).children() {
            tile(0xff0000, 40.0),
            tile(0x0000ff, 40.0),
        }
    }
    let sc = shot(cx, view)
    testing.equal(t, sc.paths.len, 1)
    testing.equal(t, painted(sc, thumb_colour()).len, 1)
}

fn test_a_click_on_the_canvas_reaches_its_handler_with_the_point_inside_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let seen = new(Tally {})
    let view = fn() -> Element {
        framed(canvas(diagonal).id("chart").size(100.0, 50.0).padding(5.0).on_click(fn(c: ClickEvent) {
            seen.runs += 1
            seen.at = canvas_point(cx, "chart", c.position)
        }))
    }
    shot(cx, view)
    click(cx, 10.0, 10.0)
    testing.equal(t, seen.runs, 0)
    click(cx, 65.0, 55.0)
    testing.equal(t, seen.runs, 1)
    let at = seen.at ?? geometry.point(-1.0, -1.0)
    testing.equal(t, at.x, 40.0)
    testing.equal(t, at.y, 20.0)
}

fn test_the_pointer_hovers_a_canvas_and_its_moves_reach_the_handler(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let seen = new(Tally {})
    let view = fn() -> Element {
        canvas(diagonal).id("chart").size(100.0, 50.0).background(rgb(0x0000ff)).hover(fn(v: Visual) -> Visual { v.with_background(rgb(0xff0000)) }).on_mouse_move(fn(m: MouseMoveEvent) {
            seen.runs += 1
            seen.at = canvas_point(cx, "chart", m.position)
        })
    }
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)
    move_to(cx, 30.0, 12.0)
    testing.equal(t, seen.runs, 1)
    let at = seen.at ?? geometry.point(-1.0, -1.0)
    testing.equal(t, at.x, 30.0)
    testing.equal(t, at.y, 12.0)
    testing.is_true(t, frame_due(cx))
    testing.equal(t, shot(cx, view).quads[0].background.r, 1.0)
    move_to(cx, 150.0, 80.0)
    testing.equal(t, seen.runs, 1)
}

fn test_canvas_point_is_none_for_a_key_that_holds_no_canvas(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, fn() -> Element { div().id("box").size(50.0, 50.0).child(canvas(diagonal).size(10.0, 10.0)) })
    testing.is_true(t, canvas_point(cx, "box", geometry.point(1.0, 1.0)) == none)
    testing.is_true(t, canvas_point(cx, "missing", geometry.point(1.0, 1.0)) == none)
    testing.is_true(t, canvas_point(cx, "box/0", geometry.point(1.0, 1.0)) != none)
}

fn test_the_window_scale_multiplies_points_and_widths(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let paint = fn(p: Painter) {
        level(p)
        p.fill_rect(geometry.rect(10.0, 0.0, 20.0, 10.0), ink_colour())
        p.fill_circle(geometry.point(50.0, 30.0), 4.0, ink_colour())
    }
    let sc = frame(cx, fn() -> Element { framed(canvas(paint).size(100.0, 50.0)) }, window(), 2.0)
    same_rect(t, sc.paths[0].bounds, geometry.rect(40.0, 96.0, 200.0, 8.0))
    same_rect(t, sc.paths[0].clip, geometry.rect(40.0, 60.0, 200.0, 100.0))
    same_rect(t, sc.quads[0].bounds, geometry.rect(60.0, 60.0, 40.0, 20.0))
    same_rect(t, sc.quads[1].bounds, geometry.rect(132.0, 112.0, 16.0, 16.0))
    testing.equal(t, sc.quads[1].corner_radii.top_left, 8.0)
}

fn test_a_polygon_fans_from_its_first_point(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let paint = fn(p: Painter) {
        p.fill_polygon([geometry.point(0.0, 0.0), geometry.point(40.0, 0.0), geometry.point(50.0, 20.0), geometry.point(40.0, 40.0), geometry.point(0.0, 40.0)], ink_colour())
        p.fill_polygon([geometry.point(0.0, 0.0), geometry.point(40.0, 0.0)], ink_colour())
    }
    let sc = shot(cx, fn() -> Element { canvas(paint).size(100.0, 50.0) })
    testing.equal(t, sc.paths.len, 1)
    testing.equal(t, sc.paths[0].vertices.len, 9)
    for i in 0..3 {
        testing.equal(t, sc.paths[0].vertices[i * 3].position.x, 0.0)
        testing.equal(t, sc.paths[0].vertices[i * 3].position.y, 0.0)
    }
    same_rect(t, sc.paths[0].bounds, geometry.rect(0.0, 0.0, 50.0, 40.0))
}

fn triangle_area(vs: scene.PathVertex[], first: i64) -> f32 {
    let a = vs[first].position
    let b = vs[first + 1].position
    let c = vs[first + 2].position
    let doubled = (b.x - a.x) * (c.y - a.y) - (c.x - a.x) * (b.y - a.y)
    if doubled < 0.0 { -doubled * 0.5 } else { doubled * 0.5 }
}

fn covered_area(path: scene.Path) -> f32 {
    var total: f32 = 0.0
    for i in 0..path.vertices.len / 3 {
        total += triangle_area(path.vertices, i * 3)
    }
    total
}

fn test_an_area_fills_between_a_line_and_its_baseline_where_a_fan_cannot(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let paint = fn(p: Painter) {
        let line = [geometry.point(0.0, 40.0), geometry.point(20.0, 10.0), geometry.point(40.0, 30.0), geometry.point(60.0, 0.0)]
        p.fill_area(line, 40.0, ink_colour())
        p.fill_area([geometry.point(0.0, 40.0)], 40.0, ink_colour())
    }
    let sc = shot(cx, fn() -> Element { canvas(paint).size(100.0, 50.0) })
    testing.equal(t, sc.paths.len, 1)
    testing.equal(t, sc.paths[0].vertices.len, 18)
    same_rect(t, sc.paths[0].bounds, geometry.rect(0.0, 0.0, 60.0, 40.0))
    testing.is_true(t, near(covered_area(sc.paths[0]), 300.0 + 400.0 + 500.0))
}

fn test_an_area_splits_a_segment_that_crosses_the_baseline(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let paint = fn(p: Painter) {
        p.fill_area([geometry.point(0.0, 10.0), geometry.point(40.0, 30.0)], 20.0, ink_colour())
    }
    let sc = shot(cx, fn() -> Element { canvas(paint).size(100.0, 50.0) })
    let vs = sc.paths[0].vertices
    testing.equal(t, vs.len, 6)
    testing.equal(t, vs[1].position.x, 20.0)
    testing.equal(t, vs[1].position.y, 20.0)
    testing.is_true(t, near(covered_area(sc.paths[0]), 200.0))
}

fn parabola_y(x: f32) -> f32 {
    let along = (x - 10.0) / 80.0
    40.0 - 80.0 * along + 80.0 * along * along
}

fn farthest_from_parabola(points: geometry.Point[]) -> geometry.Point {
    var worst = points[0]
    var gap: f32 = 0.0
    for at in points {
        let off = at.y - parabola_y(at.x)
        let distance = if off < 0.0 { -off } else { off }
        if distance > gap {
            gap = distance
            worst = at
        }
    }
    worst
}

fn test_curves_stroke_along_points_that_start_and_end_on_the_curve(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let seen = new(Tally {})
    let a = geometry.point(10.0, 40.0)
    let b = geometry.point(90.0, 40.0)
    let paint = fn(p: Painter) {
        let bent = p.quadratic_points(a, geometry.point(50.0, 0.0), b)
        let waved = p.cubic_points(a, geometry.point(30.0, 0.0), geometry.point(70.0, 80.0), b)
        seen.points = if bent.len < waved.len { bent.len } else { waved.len }
        seen.early = waved[1]
        seen.at = farthest_from_parabola(bent)
        seen.first_x = bent[0].x + waved[0].x
        seen.last_x = bent[bent.len - 1].x + waved[waved.len - 1].x
        p.stroke_quadratic(a, geometry.point(50.0, 0.0), b, 2.0, ink_colour())
        p.stroke_cubic(a, geometry.point(30.0, 0.0), geometry.point(70.0, 80.0), b, 2.0, ink_colour())
    }
    let sc = shot(cx, fn() -> Element { framed(canvas(paint).size(100.0, 50.0)) })
    testing.is_true(t, seen.points > 8)
    testing.equal(t, seen.first_x, 20.0)
    testing.equal(t, seen.last_x, 180.0)
    let early = seen.early ?? geometry.point(-1.0, 99.0)
    testing.is_true(t, early.x > 10.0 && early.y < 40.0)
    let stray = seen.at ?? geometry.point(-1.0, -1.0)
    testing.is_true(t, near(stray.y, parabola_y(stray.x)))
    testing.equal(t, sc.paths.len, 2)
    testing.is_true(t, inside(geometry.rect(28.0, 48.0, 84.0, 24.0), sc.paths[0].bounds))
    testing.is_true(t, sc.paths[0].vertices.len > 48)
    testing.is_true(t, inside(geometry.rect(28.0, 56.0, 84.0, 28.0), sc.paths[1].bounds))
}

fn kinds_drawn(sc: scene.Scene) -> str {
    var out = ""
    for b in scene.batches(sc) {
        out += match b.kind {
            Quads => "q{b.count}"
            Paths => "p{b.count}"
            _ => "?"
        }
    }
    out
}

fn test_shapes_draw_above_the_background_in_the_order_made_and_under_the_children(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let paint = fn(p: Painter) {
        p.fill_rect(geometry.rect(0.0, 0.0, 50.0, 50.0), rgb(0x00ff00))
        p.stroke_line(geometry.point(0.0, 20.0), geometry.point(50.0, 20.0), 4.0, ink_colour())
        p.fill_circle(geometry.point(25.0, 20.0), 5.0, rgb(0xff0000))
    }
    let view = fn() -> Element {
        canvas(paint).size(100.0, 50.0).background(rgb(0xeeeeee)).child(div().size(40.0, 40.0).background(rgb(0x0000ff)))
    }
    let sc = shot(cx, view)
    testing.equal(t, kinds_drawn(sc), "q2p1q2")
    testing.equal(t, sc.quads[1].background.g, 1.0)
    testing.equal(t, sc.quads[2].background.r, 1.0)
    testing.equal(t, sc.quads[3].background.b, 1.0)
}

fn test_an_invisible_canvas_keeps_its_place_and_does_not_paint(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let seen = new(Tally {})
    let paint = fn(p: Painter) {
        seen.runs += 1
        diagonal(p)
    }
    let hidden = shot(cx, fn() -> Element { div().invisible().child(canvas(paint).id("chart").size(100.0, 50.0)) })
    testing.equal(t, seen.runs, 0)
    testing.equal(t, hidden.paths.len, 0)
    testing.is_true(t, canvas_point(cx, "chart", geometry.point(5.0, 5.0)) != none)
    let shown = shot(cx, fn() -> Element { canvas(paint).id("chart").size(100.0, 50.0) })
    testing.equal(t, seen.runs, 1)
    testing.equal(t, shown.paths.len, 1)
}

fn test_strokes_without_length_or_width_draw_nothing(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let paint = fn(p: Painter) {
        p.stroke_polyline([geometry.point(5.0, 5.0)], 2.0, ink_colour())
        p.stroke_line(geometry.point(5.0, 5.0), geometry.point(50.0, 5.0), 0.0, ink_colour())
        p.stroke_line(geometry.point(5.0, 5.0), geometry.point(5.0, 5.0), 2.0, ink_colour())
    }
    testing.equal(t, shot(cx, fn() -> Element { canvas(paint).size(100.0, 50.0) }).paths.len, 0)
}

fn nested(depth: i64, leaf: Element) -> Element {
    var out = leaf
    for _ in 0..depth {
        out = div().child(out)
    }
    out
}

fn test_a_canvas_draws_at_the_bottom_of_a_tree_sixty_deep(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let sc = shot(cx, fn() -> Element { nested(60, canvas(diagonal).size(100.0, 50.0)) })
    testing.equal(t, sc.paths.len, 1)
}
