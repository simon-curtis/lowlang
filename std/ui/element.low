import std/ui/geometry
import std/ui/layout
import std/ui/platform
import uitext = std/ui/text

/// A shadow cast by an element's border box.
pub struct BoxShadow {
    /// The colour at full coverage.
    pub color: geometry.Color = geometry.rgba(0x00000040)
    /// How far right the shadow sits from the box, in logical pixels.
    pub x: f32 = 0.0
    /// How far down the shadow sits from the box, in logical pixels.
    pub y: f32 = 0.0
    /// The standard deviation of the blur in logical pixels; the shadow reaches three of them beyond its edge.
    pub blur: f32 = 0.0
    /// How far the shadow grows on every side before blurring, in logical pixels. The corner radii stay those of the element.
    pub spread: f32 = 0.0
}

/// How an element looks, apart from its layout.
pub struct Visual {
    /// The colour inside the border.
    pub background: geometry.Color = geometry.Color {}
    /// The colour of the border, whose widths are part of the layout style.
    pub border_color: geometry.Color = geometry.Color {}
    /// The radius of each corner of the border box.
    pub corners: geometry.Corners = geometry.Corners {}
    /// How opaque the element and its children are, `1.0` as drawn and `0.0` invisible. It multiplies the alpha of each colour they draw, so overlapping children show through one another, and it multiplies with the opacity of the element's parents.
    pub opacity: f32 = 1.0
    /// Whether the element is drawn. A hidden element keeps its place in the layout and its hitbox, but it and its children draw nothing, and neither they nor their handlers, cursors or focus stops take part in the pointer and the keyboard.
    pub visible: bool = true
    /// The shadows drawn under the element, first lowest.
    pub shadows: BoxShadow[] = []
    /// The colour of text in the element and its children, or `none` to inherit the parent's.
    pub text_color: geometry.Color? = none
    /// The em size of text in the element and its children in logical pixels, or `none` to inherit the parent's; the root's is one rem.
    pub text_size: f32? = none
    /// The installed font family of text in the element and its children, or `none` to inherit the parent's.
    pub font_family: str? = none
    /// The weight of text in the element and its children, `400` regular and `700` bold, or `none` to inherit the parent's.
    pub font_weight: i64? = none
    /// The slant of text in the element and its children, or `none` to inherit the parent's.
    pub font_style: uitext.FontStyle? = none
    /// The line drawn under or through text in the element and its children, or `none` to inherit the parent's.
    pub decoration: uitext.Decoration? = none
    /// The distance between baselines of text in the element and its children in logical pixels, `0` for 1.618034 times the text size, or `none` to inherit the parent's.
    pub line_height: f32? = none
    /// Whether text in the element and its children breaks lines at the width of its box, or `none` to inherit the parent's.
    pub wrap: bool? = none
    /// How text in the element and its children is shortened where it is wider than its box, or `none` to inherit the parent's.
    pub truncate: uitext.Truncate? = none
    /// Where each line of text in the element and its children sits in its box, or `none` to inherit the parent's.
    pub align: uitext.TextAlign? = none
}

/// A node of the user interface: a box laid out by flexbox, or a run of text.
///
/// Elements are values built with `div` and `text` and changed with the builder functions, each of which returns a changed copy.
pub struct Element {
    style: layout.Style = layout.Style {}
    visual: Visual = Visual {}
    kind: Kind = Box
    content: str = ""
    placeholder: str = ""
    placeholder_color: geometry.Color? = none
    selection_color: geometry.Color? = none
    children: Element[] = []
    id: str = ""
    group: str = ""
    focusable: bool = false
    read_only: bool = false
    masked: bool = false
    listeners: Listener[] = []
    conditionals: Conditional[] = []
    cursor: platform.Cursor? = none
    control_area: platform.WindowControlArea? = none
    picture: uitext.Image? = none
    fit: uitext.Fit = Contain
    gray: bool = false
    rows: Rows? = none
    key_context: KeyContext? = none
    lines: LineSource? = none
    tab_size: i64 = 1
    blank_marks: BlankMarks? = none
    behavior: Behavior = Normal
    deferred: bool = false
    priority: i64 = 0
    anchoring: Anchoring? = none
    extras: *Extras? = none
}

struct Extras {
    scrollbar: ScrollbarOptions? = none
    drawing: Drawing? = none
    label: str = ""
    role: Role? = none
}

fn extras_of(e: Element) -> Extras {
    let held = e.extras ?? return Extras {}
    *held
}

enum Kind {
    Box
    Text
    Field
    TextArea
    Icon
    Picture
    Virtual
}

/// A turn of the mouse wheel.
pub struct ScrollEvent {
    /// Where the pointer was, in logical pixels from the top left of the window.
    pub position: geometry.Point
    /// How far to scroll right, in logical pixels.
    pub dx: f32
    /// How far to scroll down, in logical pixels.
    pub dy: f32
    /// The modifiers held. A scrolling element turns a vertical-only scroll made with Shift alone held into a horizontal one; `dx` and `dy` are the distances as the wheel reported them.
    pub modifiers: platform.Modifiers = platform.Modifiers {}
}

/// A press of a pointer button over an element, as gpui's `MouseDownEvent`.
pub struct MouseDownEvent {
    /// The button pressed.
    pub button: platform.Button = platform.Button.Left
    /// Where the pointer was, in logical pixels from the top left of the window.
    pub position: geometry.Point = geometry.Point {}
    /// The modifiers held.
    pub modifiers: platform.Modifiers = platform.Modifiers {}
    /// How many presses of the button in a row this one makes, `2` for the second press of a double click.
    pub click_count: i64 = 1
}

/// A release of a pointer button over an element, as gpui's `MouseUpEvent`.
pub struct MouseUpEvent {
    /// The button released.
    pub button: platform.Button = platform.Button.Left
    /// Where the pointer was, in logical pixels from the top left of the window.
    pub position: geometry.Point = geometry.Point {}
    /// The modifiers held.
    pub modifiers: platform.Modifiers = platform.Modifiers {}
    /// The click count of the press this release ends.
    pub click_count: i64 = 1
}

/// A move of the pointer over an element, as gpui's `MouseMoveEvent`.
pub struct MouseMoveEvent {
    /// Where the pointer is, in logical pixels from the top left of the window.
    pub position: geometry.Point = geometry.Point {}
    /// The button held down, the last pressed of those held, or `none`.
    pub pressed_button: platform.Button? = none
    /// The modifiers held at the last button or key event.
    pub modifiers: platform.Modifiers = platform.Modifiers {}
}

/// A click: a press and a release of the primary button on one element, or Enter or Space on a focused element, as gpui's `ClickEvent`.
pub struct ClickEvent {
    /// Where the pointer was at the release, in logical pixels from the top left of the window; for a click from the keyboard, the bottom left corner of the element.
    pub position: geometry.Point = geometry.Point {}
    /// The modifiers held at the release, none for a click from the keyboard.
    pub modifiers: platform.Modifiers = platform.Modifiers {}
    /// The click count of the release, `2` for a double click and `3` for a triple click; `1` for a click from the keyboard.
    pub click_count: i64 = 1
    /// `true` when Enter or Space made the click.
    pub keyboard: bool = false
}

enum Listener {
    Click(f: fn(ClickEvent))
    Key(f: fn(platform.KeyEvent) -> bool)
    Scroll(f: fn(ScrollEvent))
    Change(f: fn(str))
    MouseDown(button: platform.Button?, f: fn(MouseDownEvent))
    MouseUp(button: platform.Button?, f: fn(MouseUpEvent))
    MouseDownOut(f: fn(MouseDownEvent))
    MouseUpOut(button: platform.Button?, f: fn(MouseUpEvent))
    MouseMove(f: fn(MouseMoveEvent))
    Action(name: str, f: fn())
    CaptureAction(name: str, f: fn())
    Tooltip(build: fn() -> Element, hoverable: bool)
    ContextMenu(id: str, items: fn() -> MenuItem[])
    DropdownMenu(id: str, items: fn() -> MenuItem[])
    Popover(id: str, content: fn() -> Element)
    Drag(kind: str, value: str, preview: fn(str) -> Element)
    DragMove(kind: str, f: fn(DragMoveEvent))
    Drop(kind: str, f: fn(DropEvent))
    CanDrop(f: fn(DragPayload) -> bool)
}

enum Condition {
    Hovered
    Active
    Focused
    GroupHovered(name: str)
    GroupActive(name: str)
    DragHovered(kind: str)
}

struct Conditional {
    when: Condition
    change: fn(Visual) -> Visual
}

fn listen(e: Element, l: Listener) -> Element {
    var out = e
    out.listeners = e.listeners[0..]
    out.listeners.push(l)
    out
}

fn when(e: Element, c: Condition, f: fn(Visual) -> Visual) -> Element {
    var out = e
    out.conditionals = e.conditionals[0..]
    out.conditionals.push(Conditional { when: c, change: f })
    out
}

/// Returns `e` running `f` when a press and a release of the primary button both land on it, as gpui's `on_click` does. A click reaches the innermost element that has a click handler and that both the press and the release were over, and no other; its `click_count` is that of the release, so a double click runs `f` twice, the second time with a count of two. A focused element with a click handler also runs it, with `keyboard` set, when Enter or Space is pressed and no key handler took the key.
pub fn on_click(e: Element, f: fn(ClickEvent)) -> Element {
    listen(e, Click(f))
}

/// Returns `e` running `f` when `button` is pressed with the pointer over it, as gpui's `on_mouse_down` does. Presses go to the elements under the pointer from the innermost outward until a handler calls `stop_propagation`.
pub fn on_mouse_down(e: Element, button: platform.Button, f: fn(MouseDownEvent)) -> Element {
    listen(e, MouseDown(button, f))
}

/// Returns `e` running `f` when any button is pressed with the pointer over it, as `on_mouse_down` does for one button.
pub fn on_any_mouse_down(e: Element, f: fn(MouseDownEvent)) -> Element {
    listen(e, MouseDown(none, f))
}

/// Returns `e` running `f` when `button` is released with the pointer over it, wherever it was pressed, as gpui's `on_mouse_up` does. Releases go to the elements under the pointer from the innermost outward until a handler calls `stop_propagation`.
pub fn on_mouse_up(e: Element, button: platform.Button, f: fn(MouseUpEvent)) -> Element {
    listen(e, MouseUp(button, f))
}

/// Returns `e` running `f` when any button is pressed with the pointer outside it, as gpui's `on_mouse_down_out` does, which is how a menu or popover closes on a click elsewhere. These handlers run before those of the elements under the pointer.
pub fn on_mouse_down_out(e: Element, f: fn(MouseDownEvent)) -> Element {
    listen(e, MouseDownOut(f))
}

/// Returns `e` running `f` when `button` is released with the pointer outside it, as gpui's `on_mouse_up_out` does.
pub fn on_mouse_up_out(e: Element, button: platform.Button, f: fn(MouseUpEvent)) -> Element {
    listen(e, MouseUpOut(button, f))
}

/// Returns `e` running `f` when the pointer moves over it, as gpui's `on_mouse_move` does. Moves go to every element under the pointer, from the innermost outward until a handler calls `stop_propagation`.
pub fn on_mouse_move(e: Element, f: fn(MouseMoveEvent)) -> Element {
    listen(e, MouseMove(f))
}

/// Returns `e` running `f` when a key is pressed or released while it or an element inside it is focused. Key events go to the focused element and then outward until a handler returns `true`.
pub fn on_key(e: Element, f: fn(platform.KeyEvent) -> bool) -> Element {
    listen(e, Key(f))
}

/// Returns `e` running `f` when the wheel turns with the pointer over it. Wheel events go to the elements under the pointer from the innermost outward, and a scrolling element that moves stops them.
pub fn on_scroll_wheel(e: Element, f: fn(ScrollEvent)) -> Element {
    listen(e, Scroll(f))
}

/// Returns `e`, a `field`, running `f` with the field's new text after each edit: typing, deleting, cutting, pasting and an input method's commit. The field shows the text its element was built with, so `f` is where an application stores it, in a signal that the next frame reads.
pub fn on_change(e: Element, f: fn(str)) -> Element {
    listen(e, Change(f))
}

/// Returns `e` showing `c` while the pointer is over it, or over an element inside it that sets no cursor of its own. Elements that set none show the arrow.
pub fn cursor(e: Element, c: platform.Cursor) -> Element {
    var out = e
    out.cursor = c
    out
}

/// Returns `e` marking the part of the window it covers as `area`, which `window_control_area_at` reports and a window drawn without a system title bar answers the system with, as gpui's `window_control_area` does (`div.rs:581`, `1004`). `Drag` moves the window and maximises it on a double click, `Close`, `Max` and `Min` close, maximise or restore and minimise it on a click, and Windows 11 shows its snap layouts over `Max`. The platform acts on the clicks, so an element with an area needs no `on_click` for them.
///
/// Within an area, an inner element with a click, key, scroll or change handler, or a `field`, or one that is `focusable`, answers for itself and is plain content: a button inside a `Drag` bar still takes its clicks. An inner element with an area of its own answers with that. This rule is `std/ui`'s own: gpui answers from the first window-control hitbox among those under the last mouse move (`window.rs:1133-1146`) and delivers clicks on a button over a `Drag` bar through non-client mouse dispatch (`events.rs:949-990`).
pub fn window_control_area(e: Element, area: platform.WindowControlArea) -> Element {
    var out = e
    out.control_area = area
    out
}

/// Returns `e` able to take keyboard focus: a click on it focuses it, and Tab and Shift+Tab move focus through focusable elements in tree order.
pub fn focusable(e: Element) -> Element {
    var out = e
    out.focusable = true
    out
}

/// Returns `e`, a `field` or a `text_area`, showing its text without letting the user change it; on any other element it has no effect.
///
/// A read-only element keeps focus by click and Tab, selecting with the pointer and with the keyboard, select all, copy, caret movement, scrolling and the drawn caret and selection. It refuses every path that changes text: typed characters, Backspace and Delete, cut, paste, an input method's preedit and commit, and in a text area also Enter, Tab, undo, redo and the actions `text_area.backspace`, `delete`, `delete_word_left`, `delete_word_right`, `new_line`, `tab`, `cut`, `paste`, `undo` and `redo`. A refused key changes neither the text, the caret nor the selection, and the element's `on_change` or `LineSource.edit` is not called. `text_input` reports no caret while a read-only element is focused, so the platform opens no input method composition for it.
///
/// A refused editing key is not consumed: it falls through to the `on_key` handlers of the elements around the element and then to focus movement and click handling, as a key the element does not use does, so Tab moves focus on from a read-only text area and Enter runs the element's `on_click`. `is_action_available` and `available_actions` leave the refused actions out for a focused read-only text area. `capture_action` and `on_action` handlers on the element and around it still run for those actions, so the application can give a refused key a meaning of its own.
pub fn read_only(e: Element) -> Element {
    var out = e
    out.read_only = true
    out
}

/// Returns `e` drawn with `f` applied to its visual while the pointer is over it or over an element inside it.
pub fn hover(e: Element, f: fn(Visual) -> Visual) -> Element {
    when(e, Hovered, f)
}

/// Returns `e` drawn with `f` applied to its visual from a press of the primary button over it until the release.
pub fn active(e: Element, f: fn(Visual) -> Visual) -> Element {
    when(e, Active, f)
}

/// Returns `e` drawn with `f` applied to its visual while it is focused.
pub fn focus(e: Element, f: fn(Visual) -> Visual) -> Element {
    when(e, Focused, f)
}

/// Returns `e` named `name` as a group, which `group_hover` and `group_active` in the elements inside it refer to. A group has a hitbox, so it is hovered and pressed like any element with a handler. Groups nest: an element looks a name up in the innermost group that holds it and has that name, and does not find its own group.
pub fn group(e: Element, name: str) -> Element {
    var out = e
    out.group = name
    out
}

/// Returns `e` drawn with `f` applied to its visual while the pointer is over the hitbox of the innermost group named `name` that holds it, which is within the group's clipped bounds and not only over `e`. With no such group the style never applies.
pub fn group_hover(e: Element, name: str, f: fn(Visual) -> Visual) -> Element {
    when(e, GroupHovered(name), f)
}

/// Returns `e` drawn with `f` applied to its visual from a press of the primary button over the innermost group named `name` that holds it until the release. With no such group the style never applies.
pub fn group_active(e: Element, name: str, f: fn(Visual) -> Visual) -> Element {
    when(e, GroupActive(name), f)
}

/// Returns an empty box: a flex row with no size, no children and nothing drawn.
pub fn div() -> Element {
    Element {}
}

/// Returns a text leaf that wraps `s` to the width it is given.
pub fn text(s: str) -> Element {
    Element { content: s, kind: Text }
}

/// Returns a leaf, 16 by 16 logical pixels, that draws the SVG document `source` in the text colour of the element and its parents.
///
/// The document is one of paths, lines, polylines, polygons, rectangles, circles and ellipses, filled or stroked with round caps and joins and without transforms, as `std/ui/svg` reads it. Only its coverage is kept, so every fill and stroke is drawn in the text colour. A document that does not parse draws nothing. `size`, `width` and `height` change the box it fills.
pub fn icon(source: str) -> Element {
    var out = Element { content: source, kind: Icon }
    out.style.width = Px(16.0)
    out.style.height = Px(16.0)
    out
}

/// Returns a leaf that draws `picture`, a value of `add_image`, in its own colours, fitted into its box with `Contain`.
///
/// A width or height that is not set is the picture's own, in logical pixels, or follows the other side's logical size in the picture's proportions. The picture fills the border box, and the element's background, border and corner radii draw around and under it; the radii also round the picture. `object_fit` and `grayscale` change how it is drawn.
pub fn image(picture: uitext.Image) -> Element {
    Element { kind: Picture, picture }
}

/// Returns `e`, a `field`, drawing a bullet for each grapheme of its text and refusing copy and cut. The text stays the field's value, `on_change` receives it, and the caret, selection, input method, deletion and paste work as in any field; Control with an arrow key or Backspace moves or deletes one grapheme and not a word, and a double click selects all of the text.
pub fn masked(e: Element) -> Element {
    var out = e
    out.masked = true
    out
}

/// Returns `e`, an `image`, drawn with `fit`.
pub fn object_fit(e: Element, fit: uitext.Fit) -> Element {
    var out = e
    out.fit = fit
    out
}

/// Returns `e`, an `image`, drawn with each colour replaced by its luminance.
pub fn grayscale(e: Element) -> Element {
    var out = e
    out.gray = true
    out
}

/// Returns a single-line text field showing `s`, 200 logical pixels wide, that takes focus when clicked and shows the text cursor.
///
/// A focused field edits what it shows: it inserts typed text and an input method's commit at its caret, moves the caret with the arrow keys, Home and End, with Control for a word at a time and with Shift to select, selects with the pointer, deletes with Backspace and Delete, and cuts, copies, pastes and selects all with Control and X, C, V and A. Line breaks are dropped from what is typed or pasted. It does not change `s` itself: `on_change` receives each edit's result, and the application builds the field again with it. A field with a click handler runs it on Enter. With `read_only` it keeps selecting, copying and moving the caret and refuses every edit.
///
/// The field is a leaf; a size, padding, border, background and text colour and size change it like a box. An `id` keeps its caret and selection from one frame to the next wherever the tree puts it. `field_selection` reads the selection and `set_field_selection` and `select_field_text` set it, also in the event that first adds the field to the tree.
pub fn field(s: str) -> Element {
    var out = Element { content: s, kind: Field, focusable: true }
    out.cursor = platform.Cursor.Text
    out.style.width = Px(200.0)
    out
}

/// Returns a `field` whose text is the value of `text`: it shows `get(text)`, so a tracked frame draws it again when the signal changes, and each edit `set`s the signal to the text after it, so the application keeps the text in one place and needs no `on_change`. `on_change` on the result replaces that update.
pub fn field_signal(text: Signal[str]) -> Element {
    field(get(text)).on_change(fn(edited: str) { set(text, edited) })
}

/// Returns `e`, a `field` or a `text_area`, showing `s` in place of its text while the text is empty and no input method composition is showing, as the placeholder of gpui's `examples/input.rs` does. A text area is empty when it holds one line with no text. It is drawn in the element's text style from the start of the content box, clipped like the text, with control characters dropped so that it stays on one line, and is never part of the text: it does not move the caret, take a click's position, scroll the element, reach `on_change` or `LineSource.edit` or change the element's size.
pub fn placeholder(e: Element, s: str) -> Element {
    var out = e
    out.placeholder = s
    out
}

/// Returns `e`, a `field` or a `text_area`, drawing its `placeholder` in `c`; without it the placeholder is black at an alpha of 0.2, the colour `examples/input.rs` of gpui uses (`input.rs:447`). The element's opacity multiplies the alpha as it does for the text.
pub fn placeholder_color(e: Element, c: geometry.Color) -> Element {
    var out = e
    out.placeholder_color = c
    out
}

/// Returns `e`, a `field` or a `text_area`, painting the selection of its focused self in `c`, so a theme's selection colour reaches it; without it the colour is blue at an alpha of 0.4. The element's opacity multiplies the alpha as it does for the text. On any other element it has no effect.
pub fn selection_color(e: Element, c: geometry.Color) -> Element {
    var out = e
    out.selection_color = c
    out
}

/// Returns `e` laying its children out left to right.
pub fn row(e: Element) -> Element {
    var out = e
    out.style.direction = Row
    out
}

/// Returns `e` laying its children out top to bottom.
pub fn column(e: Element) -> Element {
    var out = e
    out.style.direction = Column
    out
}

/// Returns `e` with `px` logical pixels between consecutive children.
pub fn gap(e: Element, px: f32) -> Element {
    var out = e
    out.style.column_gap = px
    out.style.row_gap = px
    out
}

/// Returns `e` with `px` logical pixels of padding on every side.
pub fn padding(e: Element, px: f32) -> Element {
    var out = e
    out.style.padding = geometry.edges(px)
    out
}

/// Returns `e` with `x` logical pixels of padding left and right and `y` above and below.
pub fn padding_xy(e: Element, x: f32, y: f32) -> Element {
    var out = e
    out.style.padding = geometry.Edges { top: y, right: x, bottom: y, left: x }
    out
}

/// Returns `e` with `px` logical pixels of margin on every side.
pub fn margin(e: Element, px: f32) -> Element {
    var out = e
    out.style.margin = layout.Margin { top: Px(px), right: Px(px), bottom: Px(px), left: Px(px) }
    out
}

/// Returns `e` with `px` logical pixels of padding above.
pub fn padding_top(e: Element, px: f32) -> Element {
    var out = e
    out.style.padding.top = px
    out
}

/// Returns `e` with `px` logical pixels of padding right.
pub fn padding_right(e: Element, px: f32) -> Element {
    var out = e
    out.style.padding.right = px
    out
}

/// Returns `e` with `px` logical pixels of padding below.
pub fn padding_bottom(e: Element, px: f32) -> Element {
    var out = e
    out.style.padding.bottom = px
    out
}

/// Returns `e` with `px` logical pixels of padding left.
pub fn padding_left(e: Element, px: f32) -> Element {
    var out = e
    out.style.padding.left = px
    out
}

/// Returns `e` with `px` logical pixels of margin above. A negative `px` pulls `e` over what is above it.
pub fn margin_top(e: Element, px: f32) -> Element {
    var out = e
    out.style.margin.top = Px(px)
    out
}

/// Returns `e` with `px` logical pixels of margin right. A negative `px` pulls what is right of `e` over it.
pub fn margin_right(e: Element, px: f32) -> Element {
    var out = e
    out.style.margin.right = Px(px)
    out
}

/// Returns `e` with `px` logical pixels of margin below. A negative `px` pulls what is below `e` over it.
pub fn margin_bottom(e: Element, px: f32) -> Element {
    var out = e
    out.style.margin.bottom = Px(px)
    out
}

/// Returns `e` with `px` logical pixels of margin left. A negative `px` pulls `e` over what is left of it.
pub fn margin_left(e: Element, px: f32) -> Element {
    var out = e
    out.style.margin.left = Px(px)
    out
}

/// Returns `e` with `x` logical pixels of margin left and right and `y` above and below.
pub fn margin_xy(e: Element, x: f32, y: f32) -> Element {
    var out = e
    out.style.margin = layout.Margin { top: Px(y), right: Px(x), bottom: Px(y), left: Px(x) }
    out
}

/// Returns `e` with an automatic margin above, which takes a share of the free space of the line it sits on.
pub fn margin_top_auto(e: Element) -> Element {
    var out = e
    out.style.margin.top = Auto
    out
}

/// Returns `e` with an automatic margin right, which takes a share of the free space of the line it sits on.
pub fn margin_right_auto(e: Element) -> Element {
    var out = e
    out.style.margin.right = Auto
    out
}

/// Returns `e` with an automatic margin below, which takes a share of the free space of the line it sits on.
pub fn margin_bottom_auto(e: Element) -> Element {
    var out = e
    out.style.margin.bottom = Auto
    out
}

/// Returns `e` with an automatic margin left, which takes a share of the free space of the line it sits on.
pub fn margin_left_auto(e: Element) -> Element {
    var out = e
    out.style.margin.left = Auto
    out
}

/// Returns `e` with automatic margins left and right.
pub fn margin_x_auto(e: Element) -> Element {
    var out = e
    out.style.margin.left = Auto
    out.style.margin.right = Auto
    out
}

/// Returns `e` with automatic margins above and below.
pub fn margin_y_auto(e: Element) -> Element {
    var out = e
    out.style.margin.top = Auto
    out.style.margin.bottom = Auto
    out
}

/// Returns `e` with automatic margins on every side.
pub fn margin_auto(e: Element) -> Element {
    var out = e
    out.style.margin = layout.Margin { top: Auto, right: Auto, bottom: Auto, left: Auto }
    out
}

/// Returns `e` with a border box of `w` by `h` logical pixels.
pub fn size(e: Element, w: f32, h: f32) -> Element {
    var out = e
    out.style.width = Px(w)
    out.style.height = Px(h)
    out
}

/// Returns `e` with a border box `px` logical pixels wide.
pub fn width(e: Element, px: f32) -> Element {
    var out = e
    out.style.width = Px(px)
    out
}

/// Returns `e` with a border box `px` logical pixels high.
pub fn height(e: Element, px: f32) -> Element {
    var out = e
    out.style.height = Px(px)
    out
}

/// Returns `e` with a border box `percent` of its parent's inner width wide, where `50.0` is half of it. Against a parent with no definite width it behaves as the content width.
pub fn width_percent(e: Element, percent: f32) -> Element {
    var out = e
    out.style.width = Percent(percent)
    out
}

/// Returns `e` with a border box `percent` of its parent's inner height high, where `50.0` is half of it. Against a parent with no definite height it behaves as the content height.
pub fn height_percent(e: Element, percent: f32) -> Element {
    var out = e
    out.style.height = Percent(percent)
    out
}

/// Returns `e` as wide as its parent's inner width, as gpui's `w_full` does.
pub fn w_full(e: Element) -> Element {
    e.width_percent(100.0)
}

/// Returns `e` as high as its parent's inner height, as gpui's `h_full` does.
pub fn h_full(e: Element) -> Element {
    e.height_percent(100.0)
}

/// Returns `e` as wide and as high as its parent's inner size, as gpui's `size_full` does.
pub fn size_full(e: Element) -> Element {
    e.width_percent(100.0).height_percent(100.0)
}

/// Returns `e` sharing the free space of its parent's main axis with the other growing children, `factor` to their sum.
pub fn grow(e: Element, factor: f32) -> Element {
    var out = e
    out.style.grow = factor
    out
}

/// Returns `e` giving up `factor` shares of a main axis that is too short for its siblings, weighted by their sizes. A `factor` of zero keeps `e` at its size.
pub fn shrink(e: Element, factor: f32) -> Element {
    var out = e
    out.style.shrink = factor
    out
}

/// Returns `e` with a border box at least `px` logical pixels wide.
pub fn min_width(e: Element, px: f32) -> Element {
    var out = e
    out.style.min_width = Px(px)
    out
}

/// Returns `e` with a border box at least `px` logical pixels high.
pub fn min_height(e: Element, px: f32) -> Element {
    var out = e
    out.style.min_height = Px(px)
    out
}

/// Returns `e` with a border box at most `px` logical pixels wide.
pub fn max_width(e: Element, px: f32) -> Element {
    var out = e
    out.style.max_width = Px(px)
    out
}

/// Returns `e` with a border box at most `px` logical pixels high.
pub fn max_height(e: Element, px: f32) -> Element {
    var out = e
    out.style.max_height = Px(px)
    out
}

/// Returns `e` taking its share of the free space of its parent's main axis from a basis of zero, as gpui's `flex_1` does: `grow` and `shrink` of one and a basis of zero percent, which against a parent without a definite size behaves as the content size.
pub fn flex_1(e: Element) -> Element {
    var out = e
    out.style.grow = 1.0
    out.style.shrink = 1.0
    out.style.basis = Percent(0.0)
    out
}

/// Returns `e` growing and shrinking from its own size: `grow` and `shrink` of one and an automatic basis.
pub fn flex_auto(e: Element) -> Element {
    var out = e
    out.style.grow = 1.0
    out.style.shrink = 1.0
    out.style.basis = Auto
    out
}

/// Returns `e` shrinking but not growing from its own size: `grow` of zero, `shrink` of one and an automatic basis.
pub fn flex_initial(e: Element) -> Element {
    var out = e
    out.style.grow = 0.0
    out.style.shrink = 1.0
    out.style.basis = Auto
    out
}

/// Returns `e` neither growing nor shrinking from its own size.
pub fn flex_none(e: Element) -> Element {
    var out = e
    out.style.grow = 0.0
    out.style.shrink = 0.0
    out.style.basis = Auto
    out
}

/// Returns `e` starting its share of the main axis from `px` logical pixels.
pub fn basis(e: Element, px: f32) -> Element {
    var out = e
    out.style.basis = Px(px)
    out
}

/// Returns `e` starting its share of the main axis from `percent` of its parent's inner main size, where `50.0` is half of it.
pub fn basis_percent(e: Element, percent: f32) -> Element {
    var out = e
    out.style.basis = Percent(percent)
    out
}

/// Returns `e` breaking its children onto further lines when they do not fit its main axis.
pub fn flex_wrap(e: Element) -> Element {
    var out = e
    out.style.wrap = Multi
    out
}

/// Returns `e` leaving the flow of its parent and sitting against the sides of its parent's padding box set by `top`, `right`, `bottom` and `left`.
pub fn absolute(e: Element) -> Element {
    var out = e
    out.style.position = Absolute
    out
}

/// Returns `e` back in the flow of its parent, offset from its place by `top`, `right`, `bottom` and `left`.
pub fn relative(e: Element) -> Element {
    var out = e
    out.style.position = Relative
    out
}

/// Returns `e` with its top edge `px` logical pixels from the top of its place, or of its parent's padding box when absolute.
pub fn top(e: Element, px: f32) -> Element {
    var out = e
    out.style.inset.top = Px(px)
    out
}

/// Returns `e` with its right edge `px` logical pixels from the right of its place, or of its parent's padding box when absolute.
pub fn right(e: Element, px: f32) -> Element {
    var out = e
    out.style.inset.right = Px(px)
    out
}

/// Returns `e` with its bottom edge `px` logical pixels from the bottom of its place, or of its parent's padding box when absolute.
pub fn bottom(e: Element, px: f32) -> Element {
    var out = e
    out.style.inset.bottom = Px(px)
    out
}

/// Returns `e` with its left edge `px` logical pixels from the left of its place, or of its parent's padding box when absolute.
pub fn left(e: Element, px: f32) -> Element {
    var out = e
    out.style.inset.left = Px(px)
    out
}

/// Returns `e` with every side offset by `px` logical pixels.
pub fn inset(e: Element, px: f32) -> Element {
    var out = e
    out.style.inset = layout.Inset { top: Px(px), right: Px(px), bottom: Px(px), left: Px(px) }
    out
}

/// Returns `e` clipping its children to its padding box on both axes.
pub fn overflow_hidden(e: Element) -> Element {
    var out = e
    out.style.overflow_x = Hidden
    out.style.overflow_y = Hidden
    out
}

/// Returns `e` clipping its children to its padding box left and right.
pub fn overflow_x_hidden(e: Element) -> Element {
    var out = e
    out.style.overflow_x = Hidden
    out
}

/// Returns `e` clipping its children to its padding box above and below.
pub fn overflow_y_hidden(e: Element) -> Element {
    var out = e
    out.style.overflow_y = Hidden
    out
}

/// Returns `e` clipping its children to its padding box and scrolling them with the wheel on both axes. It has an `id` so that its offset is kept from one frame to the next wherever the tree puts it.
pub fn overflow_scroll(e: Element) -> Element {
    var out = e
    out.style.overflow_x = Scroll
    out.style.overflow_y = Scroll
    out
}

/// Returns `e` clipping its children to its padding box and scrolling them left and right.
pub fn overflow_x_scroll(e: Element) -> Element {
    var out = e
    out.style.overflow_x = Scroll
    out
}

/// Returns `e` clipping its children to its padding box and scrolling them up and down.
pub fn overflow_y_scroll(e: Element) -> Element {
    var out = e
    out.style.overflow_y = Scroll
    out
}

/// Returns `e` placing its children at the start of the cross axis.
pub fn items_start(e: Element) -> Element {
    var out = e
    out.style.align_items = Start
    out
}

/// Returns `e` centring its children on the cross axis.
pub fn items_center(e: Element) -> Element {
    var out = e
    out.style.align_items = Center
    out
}

/// Returns `e` placing its children at the end of the cross axis.
pub fn items_end(e: Element) -> Element {
    var out = e
    out.style.align_items = End
    out
}

/// Returns `e` centring its children on the main axis.
pub fn justify_center(e: Element) -> Element {
    var out = e
    out.style.justify = Center
    out
}

/// Returns `e` placing its children at the end of the main axis.
pub fn justify_end(e: Element) -> Element {
    var out = e
    out.style.justify = End
    out
}

/// Returns `e` spreading its children along the main axis with the free space between them.
pub fn justify_between(e: Element) -> Element {
    var out = e
    out.style.justify = SpaceBetween
    out
}

/// Returns `e` filled with `c` inside its border.
pub fn background(e: Element, c: geometry.Color) -> Element {
    var out = e
    out.visual.background = c
    out
}

/// Returns `e` with a border `px` logical pixels wide on every side, drawn in `c`.
pub fn border(e: Element, px: f32, c: geometry.Color) -> Element {
    var out = e
    out.style.border = geometry.edges(px)
    out.visual.border_color = c
    out
}

/// Returns `e` with a border `px` logical pixels wide above, drawn in the colour `border` or `border_color` sets.
pub fn border_top(e: Element, px: f32) -> Element {
    var out = e
    out.style.border.top = px
    out
}

/// Returns `e` with a border `px` logical pixels wide right.
pub fn border_right(e: Element, px: f32) -> Element {
    var out = e
    out.style.border.right = px
    out
}

/// Returns `e` with a border `px` logical pixels wide below.
pub fn border_bottom(e: Element, px: f32) -> Element {
    var out = e
    out.style.border.bottom = px
    out
}

/// Returns `e` with a border `px` logical pixels wide left.
pub fn border_left(e: Element, px: f32) -> Element {
    var out = e
    out.style.border.left = px
    out
}

/// Returns `e` with its border drawn in `c`, whatever widths the border has.
pub fn border_color(e: Element, c: geometry.Color) -> Element {
    var out = e
    out.visual.border_color = c
    out
}

/// Returns `e` with every corner of its border box rounded to `px` logical pixels.
pub fn rounded(e: Element, px: f32) -> Element {
    var out = e
    out.visual.corners = geometry.corners(px)
    out
}

/// Returns `e` and its children drawn at `factor` of their opacity, as gpui's `opacity` does: each colour's alpha is multiplied by `factor`, once per primitive and not once per group.
pub fn opacity(e: Element, factor: f32) -> Element {
    var out = e
    out.visual.opacity = factor
    out
}

/// Returns `e` and its children not drawn, as gpui's `invisible` does: `e` keeps its place in the layout and its hitbox, and draws nothing, nor do its children. Its click, key and wheel handlers, cursor and focus stop, and those of its children, do not act while it is hidden.
pub fn invisible(e: Element) -> Element {
    var out = e
    out.visual.visible = false
    out
}

/// Returns `e` drawn, as gpui's `visible` does: the default, which undoes `invisible`.
pub fn visible(e: Element) -> Element {
    var out = e
    out.visual.visible = true
    out
}

/// Returns `e` casting `s` below its border box, after the shadows it already casts.
pub fn shadow(e: Element, s: BoxShadow) -> Element {
    var out = e
    out.visual.shadows = e.visual.shadows[0..]
    out.visual.shadows.push(s)
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, in `c`.
pub fn text_color(e: Element, c: geometry.Color) -> Element {
    var out = e
    out.visual.text_color = c
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, at `px` logical pixels to the em.
pub fn text_size(e: Element, px: f32) -> Element {
    var out = e
    out.visual.text_size = px
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, in the installed font family `name`.
pub fn font_family(e: Element, name: str) -> Element {
    var out = e
    out.visual.font_family = name
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, in the weight `w`, `400` regular and `700` bold.
pub fn font_weight(e: Element, w: i64) -> Element {
    var out = e
    out.visual.font_weight = w
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, in the style `s`.
pub fn font_style(e: Element, s: uitext.FontStyle) -> Element {
    var out = e
    out.visual.font_style = s
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, in italic, as `font_style(e, uitext.FontStyle.Italic)`.
pub fn italic(e: Element) -> Element {
    e.font_style(uitext.FontStyle.Italic)
}

/// Returns `e` drawing the line `d` along its text, and its children's unless they set their own.
pub fn text_decoration(e: Element, d: uitext.Decoration) -> Element {
    var out = e
    out.visual.decoration = d
    out
}

/// Returns `e` drawing a line under its text, and its children's unless they set their own, as `text_decoration(e, uitext.Decoration.Underline)`.
pub fn underline(e: Element) -> Element {
    e.text_decoration(uitext.Decoration.Underline)
}

/// Returns `e` drawing a line through its text, and its children's unless they set their own, as `text_decoration(e, uitext.Decoration.Strikethrough)`.
pub fn strikethrough(e: Element) -> Element {
    e.text_decoration(uitext.Decoration.Strikethrough)
}

/// Returns `e` spacing the baselines of its text, and its children's unless they set their own, `px` logical pixels apart, or 1.618034 times the text size when `px` is `0`.
pub fn line_height(e: Element, px: f32) -> Element {
    var out = e
    out.visual.line_height = px
    out
}

/// Returns `e` breaking its text, and its children's unless they set their own, only at `\n`.
pub fn nowrap(e: Element) -> Element {
    var out = e
    out.visual.wrap = false
    out
}

/// Returns `e` breaking its text, and its children's unless they set their own, at the width of the text's box.
pub fn wrapping(e: Element) -> Element {
    var out = e
    out.visual.wrap = true
    out
}

/// Returns `e` replacing the end of its text, and its children's unless they set their own, with an ellipsis where the text is wider than its box.
pub fn ellipsis(e: Element) -> Element {
    var out = e
    out.visual.truncate = uitext.Truncate.End
    out
}

/// Returns `e` replacing the start of its text, and its children's unless they set their own, with an ellipsis where the text is wider than its box.
pub fn ellipsis_start(e: Element) -> Element {
    var out = e
    out.visual.truncate = uitext.Truncate.Start
    out
}

/// Returns `e` replacing the middle of its text, and its children's unless they set their own, with an ellipsis where the text is wider than its box.
pub fn ellipsis_middle(e: Element) -> Element {
    var out = e
    out.visual.truncate = uitext.Truncate.Middle
    out
}

/// Returns `e` keeping its text on one line, ending it with an ellipsis where it is wider than its box, and clipping its children to its padding box.
pub fn truncate(e: Element) -> Element {
    ellipsis(nowrap(overflow_hidden(e)))
}

/// Returns `e` starting each line of its text, and its children's unless they set their own, at the left edge of the text's box.
pub fn text_left(e: Element) -> Element {
    var out = e
    out.visual.align = uitext.TextAlign.Left
    out
}

/// Returns `e` centring each line of its text, and its children's unless they set their own, in the text's box.
pub fn text_center(e: Element) -> Element {
    var out = e
    out.visual.align = uitext.TextAlign.Center
    out
}

/// Returns `e` ending each line of its text, and its children's unless they set their own, at the right edge of the text's box.
pub fn text_right(e: Element) -> Element {
    var out = e
    out.visual.align = uitext.TextAlign.Right
    out
}

/// Returns `e` named `name`, which keeps its state, such as its scroll offset, from one frame to the next wherever the tree puts it.
pub fn id(e: Element, name: str) -> Element {
    var out = e
    out.id = name
    out
}

/// Returns `e` with `c` added after its other children.
pub fn child(e: Element, c: Element) -> Element {
    var out = e
    out.children = e.children[0..]
    out.children.push(c)
    out
}

/// Returns `e` with `cs` added after its other children, in order. `children()` takes a trailing block of elements.
pub fn children(e: Element, cs: Element[]) -> Element {
    var out = e
    out.children = e.children[0..]
    for c in cs {
        out.children.push(c)
    }
    out
}

/// Returns `v` filled with `c`.
pub fn with_background(v: Visual, c: geometry.Color) -> Visual {
    var out = v
    out.background = c
    out
}

/// Returns `v` with its border drawn in `c`.
pub fn with_border_color(v: Visual, c: geometry.Color) -> Visual {
    var out = v
    out.border_color = c
    out
}

/// Returns `v` drawn at `f` of its opacity, `1.0` as drawn and `0.0` invisible.
pub fn with_opacity(v: Visual, f: f32) -> Visual {
    var out = v
    out.opacity = f
    out
}

/// Returns `v` drawn when `b` is `true` and hidden when it is `false`.
pub fn with_visible(v: Visual, b: bool) -> Visual {
    var out = v
    out.visible = b
    out
}

/// Returns `v` drawing its text in `c`.
pub fn with_text_color(v: Visual, c: geometry.Color) -> Visual {
    var out = v
    out.text_color = c
    out
}
