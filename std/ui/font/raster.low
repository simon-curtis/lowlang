import std/ui/geometry

/// A glyph's coverage at one size, one byte per pixel from `0` to `255`, rows from the top.
pub struct Bitmap {
    /// The number of columns.
    pub width: i64
    /// The number of rows.
    pub height: i64
    /// The distance in pixels from the pen position to the left edge of the first column.
    pub left: i64
    /// The distance in pixels from the baseline down to the top edge of the first row, negative for rows above the baseline.
    pub top: i64
    /// The coverage of each pixel, `width * height` bytes.
    pub coverage: u8[]
}

struct Space {
    scale: f32
    left: f32
    top: f32
}

struct Canvas {
    width: i64
    height: i64
    cells: f32[]
}

struct Walk {
    at: geometry.Point
    control: geometry.Point
    pending: bool
}

const max_side = 2048
const flatness: f32 = 0.05
const max_cubic_depth = 16

/// Returns the coverage of `glyph` with the em square `pixel_size` pixels tall, the pen at the origin of an integer pixel grid.
///
/// The outline is flattened into lines, each of which adds its signed area and cover to the pixels it crosses; a running sum along each row then gives the winding coverage, clamped to full. A quadratic curve is cut into a number of lines that grows with its size, and a cubic curve is halved until the chord of each piece is within 0.05 pixels of it, which the second differences of its control points bound.
///
/// A glyph with no outline, a `pixel_size` that is not positive and a glyph more than 2048 pixels wide or tall give an empty bitmap.
pub fn rasterize(f: Font, glyph: i64, pixel_size: f32) -> Bitmap {
    rasterize_slanted(f, glyph, pixel_size, 0.0)
}

/// Returns the coverage of `glyph` as `rasterize` does, with the outline sheared to the right by `slant` times its height above the baseline, so a `slant` of `0.2` leans the glyph by about 11 degrees. A negative `slant` leans it left.
pub fn rasterize_slanted(f: Font, glyph: i64, pixel_size: f32, slant: f32) -> Bitmap {
    if !(pixel_size > 0.0) {
        return empty_bitmap()
    }
    let shape = sheared(outline(f, glyph), slant)
    let s = scale(f, pixel_size)
    let box = bounds(shape, s)
    let left = i64(floor(box.x))
    let top = i64(floor(box.y))
    let width = ceil_i(box.x + box.width) - left
    let height = ceil_i(box.y + box.height) - top
    if width <= 0 || height <= 0 || width > max_side || height > max_side {
        return empty_bitmap()
    }
    var canvas = Canvas { width, height, cells: __make(width * height + 4) }
    let space = Space { scale: s, left: f32(left), top: f32(top) }
    for c in shape.contours {
        trace(mut canvas, c, space)
    }
    Bitmap { width, height, left, top, coverage: resolve(canvas) }
}

fn sheared(shape: Outline, slant: f32) -> Outline {
    if slant == 0.0 {
        return shape
    }
    var contours: Contour[] = []
    for c in shape.contours {
        var points: Point[] = []
        for p in c.points {
            points.push(Point { x: p.x + slant * p.y, y: p.y, on_curve: p.on_curve })
        }
        contours.push(Contour { points, cubic: c.cubic })
    }
    Outline { contours }
}

fn empty_bitmap() -> Bitmap {
    Bitmap { width: 0, height: 0, left: 0, top: 0, coverage: [] }
}

fn bounds(shape: Outline, s: f32) -> geometry.Rect {
    var x0: f32 = 0.0
    var y0: f32 = 0.0
    var x1: f32 = 0.0
    var y1: f32 = 0.0
    var seen = false
    for c in shape.contours {
        for p in c.points {
            let x = p.x * s
            let y = -p.y * s
            if !seen || x < x0 {
                x0 = x
            }
            if !seen || x > x1 {
                x1 = x
            }
            if !seen || y < y0 {
                y0 = y
            }
            if !seen || y > y1 {
                y1 = y
            }
            seen = true
        }
    }
    geometry.rect(x0, y0, x1 - x0, y1 - y0)
}

fn ceil_i(v: f32) -> i64 {
    let whole = i64(floor(v))
    if f32(whole) < v {
        whole + 1
    } else {
        whole
    }
}

fn pixel(sp: Space, p: Point) -> geometry.Point {
    geometry.point(p.x * sp.scale - sp.left, -p.y * sp.scale - sp.top)
}

fn midpoint(a: geometry.Point, b: geometry.Point) -> geometry.Point {
    geometry.point((a.x + b.x) * 0.5, (a.y + b.y) * 0.5)
}

fn trace(mut cv: Canvas, c: Contour, sp: Space) {
    let n = c.points.len
    if n < 2 {
        return
    }
    if c.cubic {
        trace_cubic(mut cv, c, sp)
        return
    }
    var first = 0
    for first < n && !c.points[first].on_curve {
        first += 1
    }
    var walk = Walk { at: pixel(sp, c.points[0]), control: geometry.point(0.0, 0.0), pending: false }
    var from = 0
    var count = n
    if first < n {
        walk.at = pixel(sp, c.points[first])
        from = first + 1
        count = n - 1
    } else {
        let last = pixel(sp, c.points[n - 1])
        walk.at = midpoint(last, walk.at)
    }
    let start = walk.at
    for k in 0..count {
        let q = c.points[(from + k) % n]
        let target = pixel(sp, q)
        step(mut cv, mut walk, target, q.on_curve)
    }
    if walk.pending {
        curve(mut cv, walk.at, walk.control, start)
    } else {
        line(mut cv, walk.at, start)
    }
}

fn step(mut cv: Canvas, mut walk: Walk, q: geometry.Point, on_curve: bool) {
    if on_curve {
        if walk.pending {
            curve(mut cv, walk.at, walk.control, q)
        } else {
            line(mut cv, walk.at, q)
        }
        walk.at = q
        walk.pending = false
    } else if walk.pending {
        let mid = midpoint(walk.control, q)
        curve(mut cv, walk.at, walk.control, mid)
        walk.at = mid
        walk.control = q
    } else {
        walk.control = q
        walk.pending = true
    }
}

fn curve(mut cv: Canvas, p0: geometry.Point, c: geometry.Point, p2: geometry.Point) {
    let dx = p0.x - 2.0 * c.x + p2.x
    let dy = p0.y - 2.0 * c.y + p2.y
    var n = i64(sqrt(sqrt(dx * dx + dy * dy) / (4.0 * flatness))) + 1
    if n > 64 {
        n = 64
    }
    var previous = p0
    for i in 1..n + 1 {
        let t = f32(i) / f32(n)
        let u = 1.0 - t
        let next = geometry.point(u * u * p0.x + 2.0 * u * t * c.x + t * t * p2.x, u * u * p0.y + 2.0 * u * t * c.y + t * t * p2.y)
        line(mut cv, previous, next)
        previous = next
    }
}

fn trace_cubic(mut cv: Canvas, c: Contour, sp: Space) {
    let n = c.points.len
    let start = pixel(sp, c.points[0])
    var at = start
    var i = 1
    for i < n {
        let q = c.points[i]
        if !q.on_curve && i + 2 < n {
            let end = pixel(sp, c.points[i + 2])
            cubic(mut cv, at, pixel(sp, q), pixel(sp, c.points[i + 1]), end, 0)
            at = end
            i += 3
        } else {
            let target = pixel(sp, q)
            line(mut cv, at, target)
            at = target
            i += 1
        }
    }
    line(mut cv, at, start)
}

fn cubic(mut cv: Canvas, p0: geometry.Point, p1: geometry.Point, p2: geometry.Point, p3: geometry.Point, depth: i64) {
    let ax = p0.x - 2.0 * p1.x + p2.x
    let ay = p0.y - 2.0 * p1.y + p2.y
    let bx = p1.x - 2.0 * p2.x + p3.x
    let by = p1.y - 2.0 * p2.y + p3.y
    let a = ax * ax + ay * ay
    let b = bx * bx + by * by
    let limit = flatness * 4.0 / 3.0
    if depth >= max_cubic_depth || !((if a > b { a } else { b }) > limit * limit) {
        line(mut cv, p0, p3)
        return
    }
    let p01 = midpoint(p0, p1)
    let p12 = midpoint(p1, p2)
    let p23 = midpoint(p2, p3)
    let p012 = midpoint(p01, p12)
    let p123 = midpoint(p12, p23)
    let mid = midpoint(p012, p123)
    cubic(mut cv, p0, p01, p012, mid, depth + 1)
    cubic(mut cv, mid, p123, p23, p3, depth + 1)
}

fn clamp(v: f32, hi: f32) -> f32 {
    if v < 0.0 {
        0.0
    } else if v > hi {
        hi
    } else {
        v
    }
}

fn line(mut cv: Canvas, a: geometry.Point, b: geometry.Point) {
    let w = f32(cv.width)
    let h = f32(cv.height)
    var x0 = clamp(a.x, w)
    var y0 = clamp(a.y, h)
    var x1 = clamp(b.x, w)
    var y1 = clamp(b.y, h)
    if y0 == y1 {
        return
    }
    var dir: f32 = 1.0
    if y0 > y1 {
        dir = -1.0
        let tx = x0
        let ty = y0
        x0 = x1
        y0 = y1
        x1 = tx
        y1 = ty
    }
    let dxdy = (x1 - x0) / (y1 - y0)
    var x = x0
    for row in i64(y0)..ceil_i(y1) {
        let top = if f32(row) > y0 { f32(row) } else { y0 }
        let bottom = if f32(row + 1) < y1 { f32(row + 1) } else { y1 }
        let dy = bottom - top
        let next = x + dxdy * dy
        cover(mut cv, row * cv.width, x, next, dy * dir)
        x = next
    }
}

fn cover(mut cv: Canvas, start: i64, xa: f32, xb: f32, d: f32) {
    let lo = if xa < xb { xa } else { xb }
    let hi = if xa < xb { xb } else { xa }
    let lo_floor = floor(lo)
    let lo_i = i64(lo_floor)
    let hi_i = ceil_i(hi)
    if hi_i <= lo_i + 1 {
        let mid = 0.5 * (xa + xb) - lo_floor
        cv.cells[start + lo_i] += d - d * mid
        cv.cells[start + lo_i + 1] += d * mid
        return
    }
    let inverse = 1.0 / (hi - lo)
    let lo_frac = lo - lo_floor
    let first = 0.5 * inverse * (1.0 - lo_frac) * (1.0 - lo_frac)
    let hi_frac = hi - f32(hi_i) + 1.0
    let last = 0.5 * inverse * hi_frac * hi_frac
    cv.cells[start + lo_i] += d * first
    if hi_i == lo_i + 2 {
        cv.cells[start + lo_i + 1] += d * (1.0 - first - last)
    } else {
        let second = inverse * (1.5 - lo_frac)
        cv.cells[start + lo_i + 1] += d * (second - first)
        for x in lo_i + 2..hi_i - 1 {
            cv.cells[start + x] += d * inverse
        }
        let before_last = second + f32(hi_i - lo_i - 3) * inverse
        cv.cells[start + hi_i - 1] += d * (1.0 - before_last - last)
    }
    cv.cells[start + hi_i] += d * last
}

fn resolve(cv: Canvas) -> u8[] {
    var out: u8[] = __make(cv.width * cv.height)
    var sum: f32 = 0.0
    for i in 0..out.len {
        sum += cv.cells[i]
        let v = if sum < 0.0 { -sum } else { sum }
        out[i] = u8((if v > 1.0 { 1.0 } else { v }) * 255.0 + 0.5)
    }
    out
}
