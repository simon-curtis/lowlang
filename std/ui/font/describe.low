/// A run of consecutive code points, `first` to `last` inclusive.
pub struct Range {
    /// The first code point of the run.
    pub first: u32
    /// The last code point of the run.
    pub last: u32
}

/// A named instance of a variable font: a point in its design space with a style name.
pub struct Instance {
    /// The style name, such as `Bold` or `Light Italic`.
    pub name: str
    /// The weight the instance draws at: its `wght` coordinate, or the face's weight when the font has no weight axis.
    pub weight: i64
    /// Whether the instance is italic: its `ital` coordinate is at least 0.5, or the font has no `ital` axis and either the face is italic or the instance's name has the word `Italic`.
    pub italic: bool
    /// Whether the instance is oblique: its `slnt` coordinate is not 0, or the font has no `slnt` axis and either the face is oblique or the instance's name has the word `Oblique`.
    pub oblique: bool
}

/// What one font of a file says about itself, read from its `name`, `OS/2`, `head`, `fvar` and `cmap` tables without checking its outlines.
pub struct Description {
    /// The family names in English: the typographic family (`name` ID 16) and then the family (`name` ID 1) when it differs, so `Noto Sans` and `Noto Sans SemiBold`. Empty when the font has no `name` table.
    pub families: str[]
    /// The style name in English: the typographic subfamily (`name` ID 17), else the subfamily (`name` ID 2).
    pub style: str
    /// The `OS/2` weight class, `400` for regular and `700` for bold, or `400` when the font has no `OS/2` table.
    pub weight: i64
    /// The `OS/2` width class, from `1` for ultra-condensed through `5` for normal to `9` for ultra-expanded, or `5` when the font has no `OS/2` table.
    pub width: i64
    /// Whether the face is italic: bit 0 of the `OS/2` selection flags, or bit 1 of the `head` style bits when the font has no `OS/2` table.
    pub italic: bool
    /// Whether the face is oblique: bit 9 of the `OS/2` selection flags.
    pub oblique: bool
    /// Whether `parse_face` can read the font's outlines: it has `glyf` and `loca` tables, or the `OTTO` signature and a `CFF ` table, and a `cmap` subtable `parse_face` reads. A font of bitmaps alone, such as a colour emoji font, cannot.
    pub drawable: bool
    /// The code points the `cmap` maps to a glyph other than 0, in ascending runs that neither overlap nor touch.
    pub coverage: Range[]
    /// The named instances, in `fvar` order.
    pub instances: Instance[]
}

struct Name {
    text: str
    rank: i64
}

/// Returns what font `index` of `data` says about itself, as `parse_face` numbers the fonts of a file.
///
/// Names are read from the Windows (platform 3) or Unicode (platform 0) records in UTF-16, preferring US English (language `0x409`), and from the Macintosh Roman records only when there are none, keeping their ASCII bytes. A control character in a name becomes a space. A table that runs past the data is left out, as if the font did not have it. Fails with `Malformed("header")` for an `index` the data does not hold and `Malformed("directory")` for a table directory that runs past it.
pub fn describe(data: str, index: i64) -> Description ! Error {
    let at = face_offset(data, index) ?? fail Malformed("header")
    let dir = directory(data, at)?
    let name = find(dir, "name")
    let os2 = find(dir, "OS/2")
    let typographic = name_text(data, name, 16)
    let family = name_text(data, name, 1)
    var families: str[] = []
    for n in [typographic, family] {
        if n != "" && !has_name(families, n) {
            families.push(n)
        }
    }
    let subfamily = name_text(data, name, 17)
    let selection = table_word(data, os2, 62, 64, -1)
    let head_style = table_word(data, find(dir, "head"), 44, 54, 0)
    let italic = if selection >= 0 { selection & 1 != 0 } else { head_style & 2 != 0 }
    let oblique = selection >= 0 && selection & 512 != 0
    let weight = table_word(data, os2, 4, 6, 400)
    let axes = axis_tags(dir)
    Description {
        families
        style: if subfamily != "" { subfamily } else { name_text(data, name, 2) }
        weight: if weight > 0 { weight } else { 400 }
        width: table_word(data, os2, 6, 8, 5)
        italic
        oblique
        drawable: drawable(dir, data[at..at + 4] == "OTTO")
        coverage: coverage_of(dir)
        instances: read_instances(dir, name, axes, weight, italic, oblique)
    }
}

fn has_name(names: str[], n: str) -> bool {
    for existing in names {
        if existing == n {
            return true
        }
    }
    false
}

fn table_word(data: str, table: Table?, at: i64, need: i64, fallback: i64) -> i64 {
    let t = table ?? return fallback
    if t.length < need {
        return fallback
    }
    be16(data, t.offset + at)
}

fn drawable(dir: Directory, cff_font: bool) -> bool {
    let outlines = if cff_font { find(dir, "CFF ") != none } else { find(dir, "glyf") != none && find(dir, "loca") != none }
    if !outlines {
        return false
    }
    choose_cmap(dir) catch {
        e => return false
    }
    true
}

fn name_text(data: str, table: Table?, id: i64) -> str {
    let t = table ?? return ""
    if t.length < 6 {
        return ""
    }
    let count = be16(data, t.offset + 2)
    let strings = t.offset + be16(data, t.offset + 4)
    let end = t.offset + t.length
    var best = Name { text: "", rank: 0 }
    for i in 0..count {
        let record = t.offset + 6 + 12 * i
        if record + 12 > end || be16(data, record + 6) != id {
            continue
        }
        let rank = name_rank(be16(data, record), be16(data, record + 2), be16(data, record + 4))
        let start = strings + be16(data, record + 10)
        let stop = start + be16(data, record + 8)
        if rank > best.rank && stop <= end {
            best = Name { text: decode_name(data, start, stop, rank >= 2), rank }
        }
    }
    best.text
}

fn name_rank(platform: i64, encoding: i64, language: i64) -> i64 {
    if platform == 3 && (encoding == 1 || encoding == 10) {
        if language == 0x409 { 4 } else { 3 }
    } else if platform == 0 {
        2
    } else if platform == 1 && encoding == 0 && language == 0 {
        1
    } else {
        0
    }
}

fn decode_name(data: str, start: i64, stop: i64, wide: bool) -> str {
    var out: u8[] = []
    if !wide {
        for at in start..stop {
            let b = byte(data, at)
            out.push(u8(if b < 32 { 32 } else if b < 128 { b } else { 63 }))
        }
        return str(out)
    }
    var at = start
    for at + 1 < stop {
        var c = be16(data, at)
        at += 2
        if c >= 0xd800 && c < 0xdc00 && at + 1 < stop {
            let low = be16(data, at)
            if low >= 0xdc00 && low < 0xe000 {
                c = 0x10000 + ((c - 0xd800) << 10) + (low - 0xdc00)
                at += 2
            }
        }
        if c < 32 || (c >= 0xd800 && c < 0xe000) {
            c = 32
        }
        put_utf8(mut out, c)
    }
    str(out)
}

fn put_utf8(mut out: u8[], c: i64) {
    if c < 0x80 {
        out.push(u8(c))
    } else if c < 0x800 {
        out.push(u8(0xc0 | c >> 6))
        out.push(u8(0x80 | c & 63))
    } else if c < 0x10000 {
        out.push(u8(0xe0 | c >> 12))
        out.push(u8(0x80 | c >> 6 & 63))
        out.push(u8(0x80 | c & 63))
    } else {
        out.push(u8(0xf0 | c >> 18))
        out.push(u8(0x80 | c >> 12 & 63))
        out.push(u8(0x80 | c >> 6 & 63))
        out.push(u8(0x80 | c & 63))
    }
}

fn fixed_16_16(data: str, at: i64) -> f32 {
    let v = be32(data, at)
    let signed = if v >= 0x80000000 { v - 0x100000000 } else { v }
    f32(f64(signed) / 65536.0)
}

fn axis_tags(dir: Directory) -> str[] {
    var out: str[] = []
    let t = find(dir, "fvar") ?? return out
    let d = dir.data
    if t.length < 16 {
        return out
    }
    let first = t.offset + be16(d, t.offset + 4)
    let count = be16(d, t.offset + 8)
    let size = be16(d, t.offset + 10)
    if size < 20 || first + count * size > t.offset + t.length {
        return out
    }
    for i in 0..count {
        let at = first + i * size
        out.push(d[at..at + 4])
    }
    out
}

fn axis_value(axes: str[], coordinates: f32[], tag: str) -> f32? {
    for i, a in axes {
        if a == tag {
            return coordinates[i]
        }
    }
    none
}

fn has_word(name: str, word: str) -> bool {
    if word.len > name.len {
        return false
    }
    for at in 0..name.len - word.len + 1 {
        let before = at == 0 || name[at - 1] == ' '
        let after = at + word.len == name.len || name[at + word.len] == ' '
        if before && after && name[at..at + word.len] == word {
            return true
        }
    }
    false
}

fn read_instances(dir: Directory, name: Table?, axes: str[], weight: i64, italic: bool, oblique: bool) -> Instance[] {
    var out: Instance[] = []
    if axes.len == 0 {
        return out
    }
    let t = find(dir, "fvar") ?? return out
    let d = dir.data
    let first = t.offset + be16(d, t.offset + 4) + axes.len * be16(d, t.offset + 10)
    let count = be16(d, t.offset + 12)
    let size = be16(d, t.offset + 14)
    if size < 4 + 4 * axes.len || first + count * size > t.offset + t.length {
        return out
    }
    for i in 0..count {
        let at = first + i * size
        var coordinates: f32[] = []
        for k in 0..axes.len {
            coordinates.push(fixed_16_16(d, at + 4 + 4 * k))
        }
        let style = name_text(d, name, be16(d, at))
        let w = axis_value(axes, coordinates, "wght")
        let ital = axis_value(axes, coordinates, "ital")
        let slnt = axis_value(axes, coordinates, "slnt")
        out.push(Instance {
            name: style
            weight: if w != none { i64((w ?? 0.0) + 0.5) } else { weight }
            italic: if ital != none { (ital ?? 0.0) >= 0.5 } else { italic || has_word(style, "Italic") }
            oblique: if slnt != none { (slnt ?? 0.0) != 0.0 } else { oblique || has_word(style, "Oblique") }
        })
    }
    out
}

fn coverage_of(dir: Directory) -> Range[] {
    var runs: Range[] = []
    let c = choose_cmap(dir) catch {
        e => return runs
    }
    let probe = Font { data: dir.data, glyph_count: 65536, cmap: c.at, cmap_format: c.format }
    if c.format == 12 {
        let groups = c.at + 16
        for i in 0..be32(dir.data, c.at + 12) {
            let at = groups + 12 * i
            let start = be32(dir.data, at)
            let stop = be32(dir.data, at + 4)
            let glyph = be32(dir.data, at + 8)
            if glyph == 0 {
                extend(mut runs, start + 1, stop)
            } else {
                extend(mut runs, start, stop)
            }
        }
        return runs
    }
    let segments = be16(dir.data, c.at + 6) / 2
    let ends = c.at + 14
    let starts = ends + 2 * segments + 2
    let deltas = starts + 2 * segments
    let offsets = deltas + 2 * segments
    for i in 0..segments {
        let stop = least(be16(dir.data, ends + 2 * i), 65534)
        let start = be16(dir.data, starts + 2 * i)
        if be16(dir.data, offsets + 2 * i) != 0 {
            extend_mapped(mut runs, probe, start, stop)
            continue
        }
        let unmapped = (65536 - be16(dir.data, deltas + 2 * i)) & 65535
        if unmapped >= start && unmapped <= stop {
            extend(mut runs, start, unmapped - 1)
            extend(mut runs, unmapped + 1, stop)
        } else {
            extend(mut runs, start, stop)
        }
    }
    runs
}

fn least(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn extend_mapped(mut runs: Range[], probe: Font, start: i64, stop: i64) {
    for cp in start..stop + 1 {
        if glyph_index(probe, u32(cp)) != 0 {
            extend(mut runs, cp, cp)
        }
    }
}

fn extend(mut runs: Range[], start: i64, stop: i64) {
    if stop < start || stop > 0x10ffff {
        return
    }
    let last = runs.len - 1
    if last >= 0 && i64(runs[last].last) + 1 >= start {
        if stop > i64(runs[last].last) {
            runs[last].last = u32(stop)
        }
        return
    }
    if last >= 0 && start < i64(runs[last].first) {
        return
    }
    runs.push(Range { first: u32(start), last: u32(stop) })
}

/// Reports whether `runs`, ascending runs as `Description.coverage` holds them, include `code_point`.
pub fn covers(runs: Range[], code_point: u32) -> bool {
    var lo = 0
    var hi = runs.len
    for lo < hi {
        let mid = (lo + hi) / 2
        if runs[mid].last < code_point {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo < runs.len && runs[lo].first <= code_point
}
