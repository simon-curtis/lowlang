import std/testing

fn test_a_hidden_window_waits_no_longer_than_its_deadline(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let st = cx.state
    let deadline = reveal_deadline_ms
    testing.equal(t, reveal_wait(st, -1, deadline), reveal_deadline_ms)
    testing.equal(t, reveal_wait(st, 100, deadline), 100)
    testing.equal(t, reveal_wait(st, reveal_deadline_ms + 1, deadline), reveal_deadline_ms)
    advance_clock(cx, 200)
    testing.equal(t, reveal_wait(st, -1, deadline), reveal_deadline_ms - 200)
    advance_clock(cx, reveal_deadline_ms)
    testing.equal(t, reveal_wait(st, -1, deadline), 0)
    testing.equal(t, reveal_wait(st, 50, deadline), 0)
}

fn test_a_revealed_window_waits_as_its_timers_say(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let st = cx.state
    st.revealed = true
    testing.equal(t, reveal_wait(st, -1, reveal_deadline_ms), -1)
    testing.equal(t, reveal_wait(st, 40, reveal_deadline_ms), 40)
    advance_clock(cx, reveal_deadline_ms * 2)
    testing.equal(t, reveal_wait(st, -1, reveal_deadline_ms), -1)
}
