import std/slices
import std/ui/geometry
import std/ui/layout
import std/ui/scene

enum Behavior {
    Normal
    BlockMouse
    BlockMouseExceptScroll
}

/// A corner of a rectangle, as gpui's `Corner`.
pub enum Corner {
    /// The corner at the smallest x and y.
    TopLeft
    /// The corner at the largest x and the smallest y.
    TopRight
    /// The corner at the smallest x and the largest y.
    BottomLeft
    /// The corner at the largest x and y.
    BottomRight
}

/// What an anchored element's position is measured from, as gpui's `AnchoredPositionMode`.
pub enum PositionMode {
    /// The position is a point in the window, and without one the element's own place in the layout.
    Window
    /// The position is measured from the element's own place in the layout.
    Local
}

/// How an anchored element that would cross the window's edge is kept inside it, as gpui's `AnchoredFitMode`.
pub enum FitMode {
    /// It moves to the other side of its position along each axis where that keeps it inside, then is pushed back inside.
    SwitchAnchor
    /// It is pushed back inside the window.
    SnapToWindow
    /// It is pushed back inside the window, keeping the margin set by `snap_to_window_with_margin` from the edge it crossed.
    SnapToWindowWithMargin
}

struct Anchoring {
    corner: Corner = TopLeft
    position: geometry.Point? = none
    attach: str = ""
    attach_corner: Corner = BottomLeft
    shift: geometry.Point = geometry.Point {}
    mode: PositionMode = Window
    fit: FitMode = SwitchAnchor
    margin: geometry.Edges = geometry.Edges {}
}

struct DeferredDraw {
    tree: layout.Tree
    laid: Laid
    key_path: str
    walk: Walk
    text: TextStyle
    priority: i64
}

/// Returns `e` stopping the pointer at it: elements under it are neither hovered nor clicked nor scrolled while the pointer is over it, as gpui's `occlude` (`HitboxBehavior::BlockMouse`). A menu, a popover and a dialog's backdrop occlude what they cover.
pub fn occlude(e: Element) -> Element {
    var x = extras_of(e)
    x.behavior = BlockMouse
    with_extras(e, x)
}

/// Returns `e` stopping the pointer at it except for the mouse wheel: elements under it are not hovered or clicked, but a wheel turn over it still scrolls them, as gpui's `block_mouse_except_scroll` (`HitboxBehavior::BlockMouseExceptScroll`).
pub fn block_mouse_except_scroll(e: Element) -> Element {
    var x = extras_of(e)
    x.behavior = BlockMouseExceptScroll
    with_extras(e, x)
}

/// Returns `e` laid out where it stands but drawn, and tested for the pointer, after the rest of the frame, as gpui's `deferred`. It is not clipped by the elements around it, it is drawn over everything drawn in order, and it keeps its place in key dispatch and focus: its handlers and actions reach the elements around it as if it were drawn in place. Deferred elements are drawn in the order of their `priority`, lowest first, and then in tree order; one inside another is drawn after it.
pub fn deferred(e: Element) -> Element {
    var x = extras_of(e)
    x.deferred = true
    with_extras(e, x)
}

/// Returns the deferred element `e` drawn after deferred elements of a lower priority, as gpui's `Deferred::with_priority`. The priority is `0` until this sets it.
pub fn priority(e: Element, n: i64) -> Element {
    var x = extras_of(e)
    x.priority = n
    with_extras(e, x)
}

/// Returns an element taken out of the flow of its parent whose children are moved to its position and kept inside the window, as gpui's `anchored`.
///
/// Its children are placed with their union's corner `anchor` at `position`, or at the element's own place when no position is set, moved by `offset`. Where they would cross the window's edge they are moved to the other side of the position where that fits, and then pushed back inside, unless `snap_to_window` or `snap_to_window_with_margin` sets another way. Wrap it in `deferred` to draw it over the rest of the window.
pub fn anchored() -> Element {
    var out = Element { extras: new(Extras { anchoring: Anchoring {} }) }
    out.style.position = Absolute
    out
}

fn is_anchored(e: Element) -> bool {
    if is_icon(e) || is_picture(e) {
        return false
    }
    let x = e.extras ?? return false
    x.anchoring != none
}

fn anchoring_of(e: Element) -> Anchoring {
    extras_of(e).anchoring ?? Anchoring {}
}

fn with_anchoring(e: Element, a: Anchoring) -> Element {
    var x = extras_of(e)
    x.anchoring = a
    with_extras(e, x)
}

/// Returns the anchored element `e` placing the corner `corner` of its children at its position, as gpui's `Anchored::anchor`. It is `TopLeft` until this sets it.
pub fn anchor(e: Element, corner: Corner) -> Element {
    var a = anchoring_of(e)
    a.corner = corner
    with_anchoring(e, a)
}

/// Returns the anchored element `e` placed at `p`, a point in the window or, with `position_mode(Local)`, from the element's place, as gpui's `Anchored::position`.
pub fn position(e: Element, p: geometry.Point) -> Element {
    var a = anchoring_of(e)
    a.position = p
    a.attach = ""
    with_anchoring(e, a)
}

/// Returns the anchored element `e` placed at the corner `corner` of the element whose key is `key`, as measured in this frame when that element is drawn before `e` is, which it is when `e` is deferred, and as measured in the last frame otherwise.
pub fn attach_to(e: Element, key: str, corner: Corner) -> Element {
    var a = anchoring_of(e)
    a.attach = key
    a.attach_corner = corner
    a.position = none
    with_anchoring(e, a)
}

/// Returns the anchored element `e` moved by `p` from its position, as gpui's `Anchored::offset`. A move to the other side of the position leaves the offset out, as gpui does.
pub fn offset(e: Element, p: geometry.Point) -> Element {
    var a = anchoring_of(e)
    a.shift = p
    with_anchoring(e, a)
}

/// Returns the anchored element `e` measuring its position as `mode` sets, as gpui's `Anchored::position_mode`.
pub fn position_mode(e: Element, mode: PositionMode) -> Element {
    var a = anchoring_of(e)
    a.mode = mode
    with_anchoring(e, a)
}

/// Returns the anchored element `e` pushed back inside the window where it would cross an edge, without moving it to the other side of its position, as gpui's `Anchored::snap_to_window`.
pub fn snap_to_window(e: Element) -> Element {
    var a = anchoring_of(e)
    a.fit = SnapToWindow
    with_anchoring(e, a)
}

/// Returns the anchored element `e` pushed back inside the window where it would cross an edge, `margin` from that edge, as gpui's `Anchored::snap_to_window_with_margin`.
pub fn snap_to_window_with_margin(e: Element, margin: geometry.Edges) -> Element {
    var a = anchoring_of(e)
    a.fit = SnapToWindowWithMargin
    a.margin = margin
    with_anchoring(e, a)
}

/// Returns the border box of the element whose key is `key`, its id or its position such as `"0/1"`, as drawn in the last frame and before any clipping, or `none` when the last frame drew no element with an id, a handler, a `label` or a `role` under that key.
pub fn bounds_of(cx: Context, key: str) -> geometry.Rect? {
    cx.state.rects[key]
}

fn corner_point(r: geometry.Rect, c: Corner) -> geometry.Point {
    match c {
        TopLeft => geometry.point(r.x, r.y)
        TopRight => geometry.point(r.x + r.width, r.y)
        BottomLeft => geometry.point(r.x, r.y + r.height)
        BottomRight => geometry.point(r.x + r.width, r.y + r.height)
    }
}

fn from_corner(c: Corner, origin: geometry.Point, size: geometry.Size) -> geometry.Rect {
    match c {
        TopLeft => geometry.rect(origin.x, origin.y, size.width, size.height)
        TopRight => geometry.rect(origin.x - size.width, origin.y, size.width, size.height)
        BottomLeft => geometry.rect(origin.x, origin.y - size.height, size.width, size.height)
        BottomRight => geometry.rect(origin.x - size.width, origin.y - size.height, size.width, size.height)
    }
}

fn across(c: Corner) -> Corner {
    match c {
        TopLeft => TopRight
        TopRight => TopLeft
        BottomLeft => BottomRight
        BottomRight => BottomLeft
    }
}

fn upright(c: Corner) -> Corner {
    match c {
        TopLeft => BottomLeft
        TopRight => BottomRight
        BottomLeft => TopLeft
        BottomRight => TopRight
    }
}

fn crosses_x(r: geometry.Rect, limits: geometry.Rect) -> bool {
    r.x < limits.x || r.x + r.width > limits.x + limits.width
}

fn crosses_y(r: geometry.Rect, limits: geometry.Rect) -> bool {
    r.y < limits.y || r.y + r.height > limits.y + limits.height
}

fn anchor_point(st: *State, a: Anchoring) -> geometry.Point? {
    if a.attach == "" {
        return a.position
    }
    let r = st.rects[a.attach] ?? (st.last_rects[a.attach] ?? return none)
    corner_point(r, a.attach_corner)
}

fn placed(a: Anchoring, wanted: geometry.Point?, bounds: geometry.Rect, size: geometry.Size, limits: geometry.Rect) -> geometry.Point {
    var origin = geometry.Point {}
    var desired = geometry.Rect {}
    match a.mode {
        Window => {
            origin = wanted ?? geometry.point(bounds.x, bounds.y)
            desired = from_corner(a.corner, geometry.point(origin.x + a.shift.x, origin.y + a.shift.y), size)
        }
        Local => {
            origin = wanted ?? geometry.Point {}
            desired = from_corner(a.corner, geometry.point(bounds.x + origin.x + a.shift.x, bounds.y + origin.y + a.shift.y), size)
        }
    }
    if a.fit == SwitchAnchor {
        var corner = a.corner
        if crosses_x(desired, limits) {
            let switched = from_corner(across(corner), origin, size)
            if !crosses_x(switched, limits) {
                corner = across(corner)
                desired = switched
            }
        }
        if crosses_y(desired, limits) {
            let switched = from_corner(upright(corner), origin, size)
            if !crosses_y(switched, limits) {
                desired = switched
            }
        }
    }
    let edges = if a.fit == SnapToWindowWithMargin { a.margin } else { geometry.Edges {} }
    if desired.x + desired.width > limits.x + limits.width {
        desired.x -= desired.x + desired.width - (limits.x + limits.width) + edges.right
    }
    if desired.x < limits.x {
        desired.x = limits.x + edges.left
    }
    if desired.y + desired.height > limits.y + limits.height {
        desired.y -= desired.y + desired.height - (limits.y + limits.height) + edges.bottom
    }
    if desired.y < limits.y {
        desired.y = limits.y + edges.top
    }
    geometry.point(rounded_px(desired.x - bounds.x), rounded_px(desired.y - bounds.y))
}

fn rounded_px(v: f32) -> f32 {
    if v < 0.0 { -floor(-v + 0.5) } else { floor(v + 0.5) }
}

fn anchored_shift(st: *State, t: layout.Tree, laid: Laid, a: Anchoring, w: Walk) -> geometry.Point {
    if laid.children.len == 0 {
        return geometry.Point {}
    }
    var low = geometry.point(1.0e30, 1.0e30)
    var high = geometry.Point {}
    for c in laid.children {
        let r = geometry.offset(layout.rect(t, c.node), w.shift.x, w.shift.y)
        low = geometry.point(smaller(low.x, r.x), smaller(low.y, r.y))
        high = geometry.point(larger(high.x, r.x + r.width), larger(high.y, r.y + r.height))
    }
    let size = geometry.size(high.x - low.x, high.y - low.y)
    let bounds = geometry.offset(layout.rect(t, laid.node), w.shift.x, w.shift.y)
    let wanted = anchor_point(st, a)
    placed(a, wanted, bounds, size, st.viewport)
}

fn smaller(a: f32, b: f32) -> f32 {
    if a < b { a } else { b }
}

fn defer_draw(st: *State, d: DeferredDraw) {
    st.deferred.push(d)
}

fn next_deferred(st: *State) -> DeferredDraw[] {
    var batch = st.deferred
    st.deferred = []
    slices.sort_stable_by(mut batch, fn(a: DeferredDraw, b: DeferredDraw) -> bool { a.priority < b.priority })
    batch
}

fn prepaint_deferred(st: *State) {
    for st.deferred.len > 0 {
        for d in next_deferred(st) {
            prepaint_element(st, d.tree, d.laid, d.key_path, d.walk)
        }
    }
}

fn paint_deferred(st: *State, mut sc: scene.Scene, scale: f32) {
    for st.deferred.len > 0 {
        for d in next_deferred(st) {
            paint_element(st, d.tree, mut sc, d.laid, d.walk, d.text, scale)
        }
    }
}
