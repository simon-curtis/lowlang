import std/testing
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn thumb_colour() -> geometry.Color {
    geometry.rgb(0xff00ff)
}

fn hot_colour() -> geometry.Color {
    geometry.rgb(0x00ffff)
}

fn track_colour() -> geometry.Color {
    geometry.rgb(0xffff00)
}

fn bar_options() -> ScrollbarOptions {
    ScrollbarOptions { width: 10.0, min_thumb: 8.0, track: track_colour(), thumb: thumb_colour(), hot: hot_colour() }
}

fn five_tiles() -> Element {
    div().id("list").column().size(100.0, 50.0).overflow_y_scroll().scrollbar(bar_options()).children() {
        tile(0xff0000, 30.0),
        tile(0x00ff00, 30.0),
        tile(0x0000ff, 30.0),
        tile(0xff0000, 30.0),
        tile(0x00ff00, 30.0),
    }
}

fn near_to(t: *testing.T, got: f32, want: f32) {
    if !near(got, want) {
        t.error("got {got}, want {want}")
    }
}

fn snapped_to(t: *testing.T, got: f32, want: f32) {
    if got < want - 0.5 || got > want + 0.5 {
        t.error("got {got}, want {want} within a device pixel")
    }
}

fn painted(sc: scene.Scene, c: geometry.Color) -> scene.Quad[] {
    var found: scene.Quad[] = []
    for q in sc.quads {
        if q.background.r == c.r && q.background.g == c.g && q.background.b == c.b && q.background.a > 0.0 {
            found.push(q)
        }
    }
    found
}

fn thumb_of(sc: scene.Scene) -> scene.Quad {
    let found = painted(sc, thumb_colour())
    if found.len != 1 {
        panic("expected one thumb, found {found.len}")
    }
    found[0]
}

fn drag_thumb(cx: Context, from: f32, to: f32) {
    move_to(cx, 95.0, from)
    press(cx, 95.0, from)
    move_to(cx, 95.0, to)
}

fn test_scroll_metrics_report_the_content_box_and_everything_in_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, scroll_column)
    let m = scroll_metrics(cx, "list") ?? ScrollMetrics {}
    testing.equal(t, m.viewport.width, 100.0)
    testing.equal(t, m.viewport.height, 50.0)
    testing.equal(t, m.content.width, 100.0)
    testing.equal(t, m.content.height, 90.0)
}

fn test_scroll_metrics_leave_out_padding_and_border_from_the_viewport(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("padded").column().size(100.0, 50.0).padding(4.0).border(1.0, rgb(0x000000)).overflow_y_scroll().children() {
            tile(0xff0000, 30.0),
            tile(0x00ff00, 30.0),
            tile(0x0000ff, 30.0),
        }
    }
    shot(cx, view)
    let m = scroll_metrics(cx, "padded") ?? ScrollMetrics {}
    testing.equal(t, m.viewport.width, 90.0)
    testing.equal(t, m.viewport.height, 40.0)
    testing.equal(t, m.content.height, 90.0)
}

fn test_content_that_fits_reports_a_content_size_equal_to_the_viewport(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("short").column().size(100.0, 50.0).overflow_y_scroll().child(tile(0xff0000, 20.0))
    }
    shot(cx, view)
    let m = scroll_metrics(cx, "short") ?? ScrollMetrics {}
    testing.equal(t, m.content.height, m.viewport.height)
    testing.equal(t, m.content.width, m.viewport.width)
}

fn test_scroll_metrics_belong_to_scrolling_elements_of_the_last_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let plain_box = fn() -> Element { div().id("box").size(100.0, 50.0) }
    shot(cx, scroll_column)
    testing.is_true(t, scroll_metrics(cx, "nothing") == none)
    shot(cx, plain_box)
    testing.is_true(t, scroll_metrics(cx, "box") == none)
    testing.is_true(t, scroll_metrics(cx, "list") == none)
}

fn test_a_uniform_list_reports_its_whole_height(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let rows = fn(start: i64, end: i64) -> Element[] {
        var out: Element[] = []
        for ix in start..end {
            out.push(div().height(20.0))
        }
        out
    }
    shot(cx, fn() -> Element { uniform_list("u", 100, rows).size(200.0, 100.0) })
    let m = scroll_metrics(cx, "u") ?? ScrollMetrics {}
    testing.equal(t, m.viewport.width, 200.0)
    testing.equal(t, m.viewport.height, 100.0)
    testing.equal(t, m.content.height, 2000.0)
}

fn test_a_list_reports_the_viewport_and_the_items_laid_out(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let state = list_state(cx, 100, ListAlignment.Top, 0.0)
    let rows = fn(ix: i64) -> Element { div().height(25.0) }
    shot(cx, fn() -> Element { list(state, rows).id("l").size(200.0, 100.0) })
    let m = scroll_metrics(cx, "l") ?? ScrollMetrics {}
    testing.equal(t, m.viewport.height, 100.0)
    testing.is_true(t, m.content.height >= 100.0)
}

fn test_the_thumb_is_the_share_of_the_content_the_viewport_shows(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let thumb = thumb_of(shot(cx, five_tiles))
    testing.equal(t, thumb.bounds.x, 90.0)
    testing.equal(t, thumb.bounds.y, 0.0)
    testing.equal(t, thumb.bounds.width, 10.0)
    snapped_to(t, thumb.bounds.height, 50.0 * 50.0 / 150.0)
    testing.equal(t, painted(shot(cx, five_tiles), track_colour()).len, 1)
}

fn test_the_thumb_follows_the_scroll_offset_to_the_end_of_the_track(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, five_tiles)
    scroll_to(cx, "list", geometry.point(0.0, 100.0))
    let thumb = thumb_of(shot(cx, five_tiles))
    snapped_to(t, thumb.bounds.y + thumb.bounds.height, 50.0)
}

fn test_the_thumb_is_never_shorter_than_the_minimum(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("tall").column().size(100.0, 50.0).overflow_y_scroll().scrollbar(ScrollbarOptions { min_thumb: 20.0, thumb: thumb_colour() }).child(tile(0xff0000, 5000.0))
    }
    testing.equal(t, thumb_of(shot(cx, view)).bounds.height, 20.0)
}

fn test_no_bar_is_drawn_when_the_content_fits_or_the_element_does_not_scroll(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let fits = fn() -> Element {
        div().id("short").column().size(100.0, 50.0).overflow_y_scroll().scrollbar(bar_options()).child(tile(0xff0000, 20.0))
    }
    let still = fn() -> Element {
        div().id("still").column().size(100.0, 50.0).scrollbar(bar_options()).child(tile(0xff0000, 200.0))
    }
    testing.equal(t, painted(shot(cx, fits), thumb_colour()).len, 0)
    testing.equal(t, painted(shot(cx, still), thumb_colour()).len, 0)
}

fn test_a_horizontal_bar_runs_along_the_bottom_edge(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("wide").row().size(100.0, 50.0).overflow_x_scroll().scrollbar(bar_options()).children() {
            div().width(300.0).height(20.0).shrink(0.0),
        }
    }
    let thumb = thumb_of(shot(cx, view))
    testing.equal(t, thumb.bounds.y, 40.0)
    testing.equal(t, thumb.bounds.height, 10.0)
    snapped_to(t, thumb.bounds.width, 100.0 * 100.0 / 300.0)
}

fn test_dragging_the_thumb_scrolls_in_proportion(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, five_tiles)
    let free: f32 = 50.0 - 50.0 * 50.0 / 150.0
    drag_thumb(cx, 5.0, 5.0 + free / 2.0)
    near_to(t, scroll_offset(cx, "list").y, 50.0)
    move_to(cx, 95.0, 500.0)
    near_to(t, scroll_offset(cx, "list").y, 100.0)
    move_to(cx, 95.0, -500.0)
    testing.equal(t, scroll_offset(cx, "list").y, 0.0)
}

fn test_a_drag_ends_when_the_button_is_released(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, five_tiles)
    drag_thumb(cx, 5.0, 15.0)
    release(cx, 95.0, 15.0)
    let stopped = scroll_offset(cx, "list").y
    testing.is_true(t, stopped > 0.0)
    move_to(cx, 95.0, 40.0)
    testing.equal(t, scroll_offset(cx, "list").y, stopped)
}

fn test_a_drag_keeps_the_grab_point_inside_the_thumb(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, five_tiles)
    drag_thumb(cx, 10.0, 10.0)
    testing.equal(t, scroll_offset(cx, "list").y, 0.0)
}

fn test_pressing_the_groove_scrolls_by_one_viewport_toward_the_press(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, five_tiles)
    press(cx, 95.0, 45.0)
    testing.equal(t, scroll_offset(cx, "list").y, 50.0)
    release(cx, 95.0, 45.0)
    shot(cx, five_tiles)
    press(cx, 95.0, 2.0)
    testing.equal(t, scroll_offset(cx, "list").y, 0.0)
}

fn test_a_press_on_the_bar_does_not_click_the_element(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = fn() -> Element {
        five_tiles().on_click(fn(e: ClickEvent) { set(clicks, get(clicks) + 1) })
    }
    shot(cx, view)
    click(cx, 95.0, 5.0)
    testing.equal(t, get(clicks), 0)
    click(cx, 20.0, 5.0)
    testing.equal(t, get(clicks), 1)
}

fn test_the_thumb_takes_the_hot_colour_under_the_pointer_and_while_dragged(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, five_tiles)
    testing.equal(t, painted(shot(cx, five_tiles), hot_colour()).len, 0)
    move_to(cx, 95.0, 5.0)
    testing.equal(t, painted(shot(cx, five_tiles), hot_colour()).len, 1)
    press(cx, 95.0, 5.0)
    move_to(cx, 20.0, 40.0)
    testing.equal(t, painted(shot(cx, five_tiles), hot_colour()).len, 1)
    release(cx, 20.0, 40.0)
    testing.equal(t, painted(shot(cx, five_tiles), hot_colour()).len, 0)
}

fn test_an_autohiding_bar_shows_only_while_the_element_is_hovered(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("list").column().size(100.0, 50.0).overflow_y_scroll().scrollbar(ScrollbarOptions { thumb: thumb_colour(), hot: hot_colour(), autohide: true }).children() {
            tile(0xff0000, 100.0),
        }
    }
    testing.equal(t, painted(shot(cx, view), thumb_colour()).len, 0)
    move_to(cx, 20.0, 20.0)
    testing.equal(t, painted(shot(cx, view), thumb_colour()).len, 1)
    press(cx, 95.0, 5.0)
    move_to(cx, 150.0, 5.0)
    testing.equal(t, painted(shot(cx, view), hot_colour()).len, 1)
    release(cx, 150.0, 5.0)
    testing.equal(t, painted(shot(cx, view), thumb_colour()).len, 0)
}

fn test_a_uniform_list_bar_drags_the_list(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let rows = fn(start: i64, end: i64) -> Element[] {
        var out: Element[] = []
        for ix in start..end {
            out.push(div().height(20.0))
        }
        out
    }
    let view = fn() -> Element { uniform_list("u", 100, rows).size(200.0, 100.0).scrollbar(bar_options()) }
    shot(cx, view)
    move_to(cx, 195.0, 2.0)
    press(cx, 195.0, 2.0)
    move_to(cx, 195.0, 52.0)
    testing.is_true(t, scroll_offset(cx, "u").y > 500.0)
}

fn test_a_list_bar_drags_the_list(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let state = list_state(cx, 40, ListAlignment.Top, 400.0)
    let rows = fn(ix: i64) -> Element { div().height(25.0) }
    let view = fn() -> Element { list(state, rows).id("l").size(200.0, 100.0).scrollbar(bar_options()) }
    shot(cx, view)
    let before = logical_scroll_top(state)
    move_to(cx, 195.0, 2.0)
    press(cx, 195.0, 2.0)
    move_to(cx, 195.0, 30.0)
    shot(cx, view)
    testing.is_true(t, logical_scroll_top(state).item_ix > before.item_ix)
}

fn test_two_bars_leave_the_corner_between_them_empty(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("both").size(100.0, 50.0).overflow_scroll().scrollbar(bar_options()).children() {
            div().width(300.0).height(500.0).shrink(0.0),
        }
    }
    let sc = shot(cx, view)
    let tracks = painted(sc, track_colour())
    testing.equal(t, tracks.len, 2)
    testing.equal(t, tracks[0].bounds.height, 40.0)
    testing.equal(t, tracks[1].bounds.width, 90.0)
}

fn area_of(cx: Context, lines: str[]) -> fn() -> Element {
    let src = ta_source(signal(cx, lines))
    fn() -> Element { text_area(src).id("area").size(200.0, 104.0).line_height(13.0).scrollbar(bar_options()) }
}

fn forty_lines() -> str[] {
    var lines: str[] = []
    for n in 0..40 {
        lines.push("line {n}")
    }
    lines
}

fn test_a_text_area_reports_its_content_box_and_every_line(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, area_of(cx, forty_lines()))
    let m = scroll_metrics(cx, "area") ?? ScrollMetrics {}
    testing.equal(t, m.viewport.width, 200.0)
    testing.equal(t, m.viewport.height, 104.0)
    testing.equal(t, m.content.height, 520.0)
    testing.equal(t, m.content.width, 200.0)
}

fn test_a_text_area_bar_drags_the_lines(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = area_of(cx, forty_lines())
    let thumb = thumb_of(shot(cx, view))
    testing.equal(t, thumb.bounds.x, 190.0)
    snapped_to(t, thumb.bounds.height, 104.0 * 104.0 / 520.0)
    move_to(cx, 195.0, 5.0)
    press(cx, 195.0, 5.0)
    move_to(cx, 195.0, 45.0)
    let middle = text_area_top_line(cx, "area")
    testing.is_true(t, middle > 10 && middle < 20)
    move_to(cx, 195.0, 500.0)
    testing.equal(t, text_area_top_line(cx, "area"), 32)
    let held = painted(shot(cx, view), hot_colour())
    testing.equal(t, held.len, 1)
    snapped_to(t, held[0].bounds.y + held[0].bounds.height, 104.0)
    move_to(cx, 195.0, -500.0)
    testing.equal(t, text_area_top_line(cx, "area"), 0)
}

fn test_pressing_a_text_area_groove_scrolls_one_page_and_leaves_the_caret(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = area_of(cx, forty_lines())
    shot(cx, view)
    press(cx, 195.0, 90.0)
    testing.equal(t, text_area_top_line(cx, "area"), 8)
    release(cx, 195.0, 90.0)
    testing.equal(t, text_area_selection(cx, "area").caret.line, 0)
    click(cx, 20.0, 45.0)
    testing.equal(t, text_area_selection(cx, "area").caret.line, 11)
}

fn test_a_text_area_that_fits_draws_no_bar(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    testing.equal(t, painted(shot(cx, area_of(cx, ["one", "two"])), thumb_colour()).len, 0)
}

fn test_a_text_area_with_a_long_line_drags_sideways_along_the_bottom(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = area_of(cx, ["short", "a line that is far wider than the two hundred pixels the area has to show it in"])
    let thumb = thumb_of(shot(cx, view))
    testing.equal(t, thumb.bounds.x, 0.0)
    testing.equal(t, thumb.bounds.y, 94.0)
    let m = scroll_metrics(cx, "area") ?? ScrollMetrics {}
    testing.is_true(t, m.content.width > m.viewport.width)
    move_to(cx, 5.0, 99.0)
    press(cx, 5.0, 99.0)
    move_to(cx, 500.0, 99.0)
    release(cx, 500.0, 99.0)
    let moved = thumb_of(shot(cx, view))
    snapped_to(t, moved.bounds.x + moved.bounds.width, 200.0)
}
