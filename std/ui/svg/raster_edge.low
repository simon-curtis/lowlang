import std/bits
import std/ui/geometry

struct EdgeRec {
    prev: i64 = -1
    next: i64 = -1
    x: i64 = 0
    dx: i64 = 0
    first_y: i64 = 0
    last_y: i64 = 0
    winding: i64 = 0
    kind: i64 = 0
    count: i64 = 0
    cshift: i64 = 0
    dshift: i64 = 0
    cx: i64 = 0
    cy: i64 = 0
    cdx: i64 = 0
    cdy: i64 = 0
    cddx: i64 = 0
    cddy: i64 = 0
    cdddx: i64 = 0
    cdddy: i64 = 0
    clx: i64 = 0
    cly: i64 = 0
}

struct EdgeSeg {
    n: i64
    x0: f32 = 0.0
    y0: f32 = 0.0
    x1: f32 = 0.0
    y1: f32 = 0.0
    x2: f32 = 0.0
    y2: f32 = 0.0
    x3: f32 = 0.0
    y3: f32 = 0.0
}

fn edge_wrap32(v: i64) -> i64 {
    i64(i32(v))
}

fn edge_sat32(x: f32) -> i64 {
    if x != x {
        return 0
    }
    if x >= 2147483648.0 {
        return 2147483647
    }
    if x <= -2147483648.0 {
        return -2147483648
    }
    i64(x)
}

fn edge_shl32(v: i64, s: i64) -> i64 {
    edge_wrap32(v << s)
}

fn edge_round6(n: i64) -> i64 {
    (n + 32) >> 6
}

fn edge_to16(n: i64) -> i64 {
    edge_shl32(n, 10)
}

fn edge_mul16(a: i64, b: i64) -> i64 {
    edge_wrap32((a * b) >> 16)
}

fn edge_div6(a: i64, b: i64) -> i64 {
    let v = (a << 16) / b
    if v < -2147483648 {
        return -2147483648
    }
    if v > 2147483647 {
        return 2147483647
    }
    v
}

fn edge_compute_dy(top: i64, y0: i64) -> i64 {
    edge_shl32(top, 6) + 32 - y0
}

fn edge_abs(v: i64) -> i64 {
    if v < 0 {
        return -v
    }
    v
}

fn edge_cheap_distance(dx_in: i64, dy_in: i64) -> i64 {
    let dx = edge_abs(dx_in)
    let dy = edge_abs(dy_in)
    if dx > dy {
        return dx + (dy >> 1)
    }
    dy + (dx >> 1)
}

fn edge_diff_to_shift(dx: i64, dy: i64, shift_aa: i64) -> i64 {
    var dist = edge_cheap_distance(dx, dy)
    dist = (dist + 16) >> (3 + shift_aa)
    bits.bit_length(u64(dist)) >> 1
}

fn edge_line_new(e: *EdgeRec, ax: f32, ay: f32, bx: f32, by: f32, shift: i64) -> bool {
    let scale: f32 = f32(1 << (shift + 6))
    var x0 = edge_sat32(ax * scale)
    var y0 = edge_sat32(ay * scale)
    var x1 = edge_sat32(bx * scale)
    var y1 = edge_sat32(by * scale)
    var winding = 1
    if y0 > y1 {
        let tx = x0
        x0 = x1
        x1 = tx
        let ty = y0
        y0 = y1
        y1 = ty
        winding = -1
    }
    let top = edge_round6(y0)
    let bottom = edge_round6(y1)
    if top == bottom {
        return false
    }
    let slope = edge_div6(x1 - x0, y1 - y0)
    let dy = edge_compute_dy(top, y0)
    e.kind = 0
    e.x = edge_to16(x0 + edge_mul16(slope, dy))
    e.dx = slope
    e.first_y = top
    e.last_y = bottom - 1
    e.winding = winding
    true
}

fn edge_line_update(e: *EdgeRec, x0_in: i64, y0_in: i64, x1_in: i64, y1_in: i64) -> bool {
    let y0 = y0_in >> 10
    let y1 = y1_in >> 10
    let top = edge_round6(y0)
    let bottom = edge_round6(y1)
    if top == bottom {
        return false
    }
    let x0 = x0_in >> 10
    let x1 = x1_in >> 10
    let slope = edge_div6(x1 - x0, y1 - y0)
    let dy = edge_compute_dy(top, y0)
    e.x = edge_to16(x0 + edge_mul16(slope, dy))
    e.dx = slope
    e.first_y = top
    e.last_y = bottom - 1
    true
}

fn edge_quad_new(e: *EdgeRec, pts: geometry.Point[], at: i64, shift_in: i64) -> bool {
    let scale: f32 = f32(1 << (shift_in + 6))
    var x0 = edge_sat32(pts[at].x * scale)
    var y0 = edge_sat32(pts[at].y * scale)
    let x1 = edge_sat32(pts[at + 1].x * scale)
    let y1 = edge_sat32(pts[at + 1].y * scale)
    var x2 = edge_sat32(pts[at + 2].x * scale)
    var y2 = edge_sat32(pts[at + 2].y * scale)
    var winding = 1
    if y0 > y2 {
        let tx = x0
        x0 = x2
        x2 = tx
        let ty = y0
        y0 = y2
        y2 = ty
        winding = -1
    }
    let top = edge_round6(y0)
    let bottom = edge_round6(y2)
    if top == bottom {
        return false
    }
    let dx = (edge_shl32(x1, 1) - x0 - x2) >> 2
    let dy = (edge_shl32(y1, 1) - y0 - y2) >> 2
    var shift = edge_diff_to_shift(dx, dy, shift_in)
    if shift == 0 {
        shift = 1
    } else if shift > 6 {
        shift = 6
    }
    e.kind = 1
    e.count = 1 << shift
    e.cshift = shift - 1
    e.winding = winding
    var a = edge_shl32(x0 - x1 - x1 + x2, 9)
    var b = edge_to16(x1 - x0)
    e.cx = edge_to16(x0)
    e.cdx = b + (a >> shift)
    e.cddx = a >> (shift - 1)
    a = edge_shl32(y0 - y1 - y1 + y2, 9)
    b = edge_to16(y1 - y0)
    e.cy = edge_to16(y0)
    e.cdy = b + (a >> shift)
    e.cddy = a >> (shift - 1)
    e.clx = edge_to16(x2)
    e.cly = edge_to16(y2)
    edge_quad_update(e)
}

fn edge_quad_update(e: *EdgeRec) -> bool {
    var success = false
    var count = e.count
    var oldx = e.cx
    var oldy = e.cy
    var dx = e.cdx
    var dy = e.cdy
    var newx = 0
    var newy = 0
    let shift = e.cshift
    for {
        count -= 1
        if count > 0 {
            newx = oldx + (dx >> shift)
            dx += e.cddx
            newy = oldy + (dy >> shift)
            dy += e.cddy
        } else {
            newx = e.clx
            newy = e.cly
        }
        success = edge_line_update(e, oldx, oldy, newx, newy)
        oldx = newx
        oldy = newy
        if count == 0 || success {
            break
        }
    }
    e.cx = newx
    e.cy = newy
    e.cdx = dx
    e.cdy = dy
    e.count = count
    success
}

fn edge_cubic_delta_from_line(a: i64, b: i64, c: i64, d: i64) -> i64 {
    let one_third = ((a * 8 - b * 15 + 6 * c + d) * 19) >> 9
    let two_third = ((a + 6 * b - c * 15 + d * 8) * 19) >> 9
    let t1 = edge_abs(one_third)
    let t2 = edge_abs(two_third)
    if t1 > t2 {
        return t1
    }
    t2
}

fn edge_cubic_new(e: *EdgeRec, pts: geometry.Point[], at: i64, shift_in: i64) -> bool {
    let scale: f32 = f32(1 << (shift_in + 6))
    var x0 = edge_sat32(pts[at].x * scale)
    var y0 = edge_sat32(pts[at].y * scale)
    var x1 = edge_sat32(pts[at + 1].x * scale)
    var y1 = edge_sat32(pts[at + 1].y * scale)
    var x2 = edge_sat32(pts[at + 2].x * scale)
    var y2 = edge_sat32(pts[at + 2].y * scale)
    var x3 = edge_sat32(pts[at + 3].x * scale)
    var y3 = edge_sat32(pts[at + 3].y * scale)
    var winding = 1
    if y0 > y3 {
        let tx0 = x0
        x0 = x3
        x3 = tx0
        let tx1 = x1
        x1 = x2
        x2 = tx1
        let ty0 = y0
        y0 = y3
        y3 = ty0
        let ty1 = y1
        y1 = y2
        y2 = ty1
        winding = -1
    }
    let top = edge_round6(y0)
    let bot = edge_round6(y3)
    if top == bot {
        return false
    }
    let ddx = edge_cubic_delta_from_line(x0, x1, x2, x3)
    let ddy = edge_cubic_delta_from_line(y0, y1, y2, y3)
    var shift = edge_diff_to_shift(ddx, ddy, 2) + 1
    if shift > 6 {
        shift = 6
    }
    var up_shift = 6
    var down_shift = shift + up_shift - 10
    if down_shift < 0 {
        down_shift = 0
        up_shift = 10 - shift
    }
    e.kind = 2
    e.count = -(1 << shift)
    e.cshift = shift
    e.dshift = down_shift
    e.winding = winding
    var b = edge_shl32(3 * (x1 - x0), up_shift)
    var c = edge_shl32(3 * (x0 - x1 - x1 + x2), up_shift)
    var d = edge_shl32(x3 + 3 * (x1 - x2) - x0, up_shift)
    e.cx = edge_to16(x0)
    e.cdx = b + (c >> shift) + (d >> (2 * shift))
    e.cddx = 2 * c + ((3 * d) >> (shift - 1))
    e.cdddx = (3 * d) >> (shift - 1)
    b = edge_shl32(3 * (y1 - y0), up_shift)
    c = edge_shl32(3 * (y0 - y1 - y1 + y2), up_shift)
    d = edge_shl32(y3 + 3 * (y1 - y2) - y0, up_shift)
    e.cy = edge_to16(y0)
    e.cdy = b + (c >> shift) + (d >> (2 * shift))
    e.cddy = 2 * c + ((3 * d) >> (shift - 1))
    e.cdddy = (3 * d) >> (shift - 1)
    e.clx = edge_to16(x3)
    e.cly = edge_to16(y3)
    edge_cubic_update(e)
}

fn edge_cubic_update(e: *EdgeRec) -> bool {
    var success = false
    var count = e.count
    var oldx = e.cx
    var oldy = e.cy
    var newx = 0
    var newy = 0
    let ddshift = e.cshift
    let dshift = e.dshift
    for {
        count += 1
        if count < 0 {
            newx = oldx + (e.cdx >> dshift)
            e.cdx += e.cddx >> ddshift
            e.cddx += e.cdddx
            newy = oldy + (e.cdy >> dshift)
            e.cdy += e.cddy >> ddshift
            e.cddy += e.cdddy
        } else {
            newx = e.clx
            newy = e.cly
        }
        if newy < oldy {
            newy = oldy
        }
        success = edge_line_update(e, oldx, oldy, newx, newy)
        oldx = newx
        oldy = newy
        if count == 0 || success {
            break
        }
    }
    e.cx = newx
    e.cy = newy
    e.count = count
    success
}

fn edge_seg_line(a: geometry.Point, b: geometry.Point) -> EdgeSeg {
    EdgeSeg { n: 2, x0: a.x, y0: a.y, x1: b.x, y1: b.y }
}

fn edge_seg_quad(a: geometry.Point, b: geometry.Point, c: geometry.Point) -> EdgeSeg {
    EdgeSeg { n: 3, x0: a.x, y0: a.y, x1: b.x, y1: b.y, x2: c.x, y2: c.y }
}

fn edge_seg_cubic(a: geometry.Point, b: geometry.Point, c: geometry.Point, d: geometry.Point) -> EdgeSeg {
    EdgeSeg { n: 4, x0: a.x, y0: a.y, x1: b.x, y1: b.y, x2: c.x, y2: c.y, x3: d.x, y3: d.y }
}

fn edge_segments(p: Path) -> EdgeSeg[] {
    var out: EdgeSeg[] = []
    var pi = 0
    var move_to = geometry.Point { x: 0.0, y: 0.0 }
    var needs_close = false
    for v in p.verbs {
        match v {
            Move => {
                if needs_close {
                    out.push(edge_seg_line(p.points[pi - 1], move_to))
                    needs_close = false
                }
                move_to = p.points[pi]
                pi += 1
            }
            Close => {
                if needs_close {
                    out.push(edge_seg_line(p.points[pi - 1], move_to))
                    needs_close = false
                }
            }
            Line => {
                needs_close = true
                out.push(edge_seg_line(p.points[pi - 1], p.points[pi]))
                pi += 1
            }
            Quad => {
                needs_close = true
                out.push(edge_seg_quad(p.points[pi - 1], p.points[pi], p.points[pi + 1]))
                pi += 2
            }
            Cubic => {
                needs_close = true
                out.push(edge_seg_cubic(p.points[pi - 1], p.points[pi], p.points[pi + 1], p.points[pi + 2]))
                pi += 3
            }
        }
    }
    if needs_close {
        out.push(edge_seg_line(p.points[pi - 1], move_to))
    }
    out
}

fn edge_pt_finite(x: f32, y: f32) -> bool {
    let m = x * y
    m - m == 0.0
}

fn edge_combine_vertical(edge: *EdgeRec, last: *EdgeRec) -> i64 {
    if last.dx != 0 || edge.x != last.x {
        return 0
    }
    if edge.winding == last.winding {
        if edge.last_y + 1 == last.first_y {
            last.first_y = edge.first_y
            return 1
        } else if edge.first_y == last.last_y + 1 {
            last.last_y = edge.last_y
            return 1
        }
        return 0
    }
    if edge.first_y == last.first_y {
        if edge.last_y == last.last_y {
            return 2
        } else if edge.last_y < last.last_y {
            last.first_y = edge.last_y + 1
            return 1
        }
        last.first_y = last.last_y + 1
        last.last_y = edge.last_y
        last.winding = edge.winding
        return 1
    }
    if edge.last_y == last.last_y {
        if edge.first_y > last.first_y {
            last.last_y = edge.first_y - 1
        } else {
            last.last_y = last.first_y - 1
            last.first_y = edge.first_y
            last.winding = edge.winding
        }
        return 1
    }
    0
}

fn edge_push_line(mut edges: *EdgeRec[], a: geometry.Point, b: geometry.Point, shift: i64) {
    let e = new(EdgeRec {})
    if !edge_line_new(e, a.x, a.y, b.x, b.y, shift) {
        return
    }
    var combine = 0
    if e.dx == 0 && edges.len > 0 {
        let last = edges[edges.len - 1]
        if last.kind == 0 {
            combine = edge_combine_vertical(e, last)
        }
    }
    if combine == 2 {
        edges.pop()
    } else if combine == 0 {
        edges.push(e)
    }
}

fn edge_push_quad(mut edges: *EdgeRec[], pts: geometry.Point[], at: i64, shift: i64) {
    let e = new(EdgeRec {})
    if edge_quad_new(e, pts, at, shift) {
        edges.push(e)
    }
}

fn edge_push_cubic(mut edges: *EdgeRec[], pts: geometry.Point[], at: i64, shift: i64) {
    let e = new(EdgeRec {})
    if edge_cubic_new(e, pts, at, shift) {
        edges.push(e)
    }
}

fn edge_build(p: Path, clip: bool, clip_w: i64, clip_h: i64, shift: i64, mut edges: *EdgeRec[]) -> bool {
    let segs = edge_segments(p)
    for seg in segs {
        if clip {
            let clipped = edge_clip_segment(seg, f32(clip_w), f32(clip_h))
            for c in clipped {
                if c.n == 2 {
                    if !edge_pt_finite(c.x0, c.y0) || !edge_pt_finite(c.x1, c.y1) {
                        return false
                    }
                    edge_push_line(mut edges, geometry.Point { x: c.x0, y: c.y0 }, geometry.Point { x: c.x1, y: c.y1 }, shift)
                } else if c.n == 3 {
                    if !edge_pt_finite(c.x0, c.y0) || !edge_pt_finite(c.x1, c.y1) || !edge_pt_finite(c.x2, c.y2) {
                        return false
                    }
                    let pts = [geometry.Point { x: c.x0, y: c.y0 }, geometry.Point { x: c.x1, y: c.y1 }, geometry.Point { x: c.x2, y: c.y2 }]
                    edge_push_quad(mut edges, pts, 0, shift)
                } else {
                    if !edge_pt_finite(c.x0, c.y0) || !edge_pt_finite(c.x1, c.y1) || !edge_pt_finite(c.x2, c.y2) || !edge_pt_finite(c.x3, c.y3) {
                        return false
                    }
                    let pts = [geometry.Point { x: c.x0, y: c.y0 }, geometry.Point { x: c.x1, y: c.y1 }, geometry.Point { x: c.x2, y: c.y2 }, geometry.Point { x: c.x3, y: c.y3 }]
                    edge_push_cubic(mut edges, pts, 0, shift)
                }
            }
        } else if seg.n == 2 {
            edge_push_line(mut edges, geometry.Point { x: seg.x0, y: seg.y0 }, geometry.Point { x: seg.x1, y: seg.y1 }, shift)
        } else if seg.n == 3 {
            let src = [geometry.Point { x: seg.x0, y: seg.y0 }, geometry.Point { x: seg.x1, y: seg.y1 }, geometry.Point { x: seg.x2, y: seg.y2 }]
            let mono = edge_points(5)
            let count = edge_chop_quad_at_y_extrema(src, mono)
            for i in 0..count + 1 {
                edge_push_quad(mut edges, mono, i * 2, shift)
            }
        } else {
            let src = [geometry.Point { x: seg.x0, y: seg.y0 }, geometry.Point { x: seg.x1, y: seg.y1 }, geometry.Point { x: seg.x2, y: seg.y2 }, geometry.Point { x: seg.x3, y: seg.y3 }]
            let mono = edge_points(10)
            let count = edge_chop_cubic_at_y_extrema(src, mono)
            for i in 0..count + 1 {
                edge_push_cubic(mut edges, mono, i * 3, shift)
            }
        }
    }
    true
}
