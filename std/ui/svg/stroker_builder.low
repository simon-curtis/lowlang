import std/ui/geometry

struct PbBuilder {
    verbs: Verb[]
    points: geometry.Point[]
    last_move: i64
    move_required: bool
}

struct PbRect {
    left: f32
    top: f32
    right: f32
    bottom: f32
}

fn pb_new() -> *PbBuilder {
    new(PbBuilder { verbs: [], points: [], last_move: 0, move_required: true })
}

fn pb_is_empty(b: *PbBuilder) -> bool {
    b.verbs.len == 0
}

fn pb_clear(b: *PbBuilder) {
    b.verbs.truncate(0)
    b.points.truncate(0)
    b.last_move = 0
    b.move_required = true
}

fn pb_move_to(b: *PbBuilder, x: f32, y: f32) {
    if b.verbs.len > 0 && b.verbs[b.verbs.len - 1] == Verb.Move {
        b.points[b.points.len - 1] = geo_pt(x, y)
        return
    }
    b.last_move = b.points.len
    b.move_required = false
    b.verbs.push(Verb.Move)
    b.points.push(geo_pt(x, y))
}

fn pb_inject_move_to(b: *PbBuilder) {
    if !b.move_required {
        return
    }
    if b.last_move < b.points.len {
        let p = b.points[b.last_move]
        pb_move_to(b, p.x, p.y)
    } else {
        pb_move_to(b, 0.0, 0.0)
    }
}

fn pb_line_to(b: *PbBuilder, x: f32, y: f32) {
    pb_inject_move_to(b)
    b.verbs.push(Verb.Line)
    b.points.push(geo_pt(x, y))
}

fn pb_quad_to(b: *PbBuilder, x1: f32, y1: f32, x: f32, y: f32) {
    pb_inject_move_to(b)
    b.verbs.push(Verb.Quad)
    b.points.push(geo_pt(x1, y1))
    b.points.push(geo_pt(x, y))
}

fn pb_cubic_to(b: *PbBuilder, x1: f32, y1: f32, x2: f32, y2: f32, x: f32, y: f32) {
    pb_inject_move_to(b)
    b.verbs.push(Verb.Cubic)
    b.points.push(geo_pt(x1, y1))
    b.points.push(geo_pt(x2, y2))
    b.points.push(geo_pt(x, y))
}

fn pb_close(b: *PbBuilder) {
    if b.verbs.len > 0 {
        if b.verbs[b.verbs.len - 1] != Verb.Close {
            b.verbs.push(Verb.Close)
        }
    }
    b.move_required = true
}

fn pb_last_point(b: *PbBuilder) -> geometry.Point {
    if b.points.len == 0 {
        return geo_zero()
    }
    b.points[b.points.len - 1]
}

fn pb_set_last_point(b: *PbBuilder, p: geometry.Point) {
    if b.points.len == 0 {
        pb_move_to(b, p.x, p.y)
        return
    }
    b.points[b.points.len - 1] = p
}

fn pb_is_zero_length_since(b: *PbBuilder, start: i64) -> bool {
    let count = b.points.len - start
    if count < 2 {
        return true
    }
    let first = b.points[start]
    for i in 1..count {
        if !geo_pt_eq(first, b.points[start + i]) {
            return false
        }
    }
    true
}

fn pb_conic_to(b: *PbBuilder, x1: f32, y1: f32, x: f32, y: f32, weight: f32) {
    if !(weight > 0.0) {
        pb_line_to(b, x, y)
    } else if !geo_finite(weight) {
        pb_line_to(b, x1, y1)
        pb_line_to(b, x, y)
    } else if weight == 1.0 {
        pb_quad_to(b, x1, y1, x, y)
    } else {
        pb_inject_move_to(b)
        let last = pb_last_point(b)
        let quads = geo_conic_to_quads(last, geo_pt(x1, y1), geo_pt(x, y), weight) ?? return
        let count = (quads.len - 1) / 2
        for i in 0..count {
            let p1 = quads[1 + i * 2]
            let p2 = quads[2 + i * 2]
            pb_quad_to(b, p1.x, p1.y, p2.x, p2.y)
        }
    }
}

fn pb_conic_points_to(b: *PbBuilder, p1: geometry.Point, p2: geometry.Point, weight: f32) {
    pb_conic_to(b, p1.x, p1.y, p2.x, p2.y, weight)
}

fn pb_rect(left: f32, top: f32, right: f32, bottom: f32) -> PbRect? {
    if !geo_finite(left) || !geo_finite(top) || !geo_finite(right) || !geo_finite(bottom) {
        return none
    }
    if left <= right && top <= bottom {
        let width = f64(right) - f64(left)
        let height = f64(bottom) - f64(top)
        if width > -3.4028234663852886e38 && width < 3.4028234663852886e38 && height > -3.4028234663852886e38 && height < 3.4028234663852886e38 {
            return PbRect { left, top, right, bottom }
        }
    }
    none
}

fn pb_push_oval(b: *PbBuilder, oval: PbRect) {
    let cx = geo_half(oval.left) + geo_half(oval.right)
    let cy = geo_half(oval.top) + geo_half(oval.bottom)
    let oval_points = [geo_pt(cx, oval.bottom), geo_pt(oval.left, cy), geo_pt(cx, oval.top), geo_pt(oval.right, cy)]
    let rect_points = [geo_pt(oval.right, oval.bottom), geo_pt(oval.left, oval.bottom), geo_pt(oval.left, oval.top), geo_pt(oval.right, oval.top)]
    pb_move_to(b, oval_points[3].x, oval_points[3].y)
    for i in 0..4 {
        pb_conic_points_to(b, rect_points[i], oval_points[i], geo_root_2_over_2)
    }
    pb_close(b)
}

fn pb_push_circle(b: *PbBuilder, x: f32, y: f32, r: f32) {
    let rect = pb_rect(x - r, y - r, (r + r) + (x - r), (r + r) + (y - r)) ?? return
    pb_push_oval(b, rect)
}

fn pb_push_builder(b: *PbBuilder, other: *PbBuilder) {
    if pb_is_empty(other) {
        return
    }
    if b.last_move != 0 {
        b.last_move = b.points.len + other.last_move
    }
    for v in other.verbs {
        b.verbs.push(v)
    }
    for p in other.points {
        b.points.push(p)
    }
}

fn pb_reverse_path_to(b: *PbBuilder, other: *PbBuilder) {
    if pb_is_empty(other) {
        return
    }
    var offset = other.points.len - 1
    var at = other.verbs.len - 1
    for at >= 0 {
        let verb = other.verbs[at]
        at -= 1
        match verb {
            Move => break
            Line => {
                let pt = other.points[offset - 1]
                offset -= 1
                pb_line_to(b, pt.x, pt.y)
            }
            Quad => {
                let pt1 = other.points[offset - 1]
                let pt2 = other.points[offset - 2]
                offset -= 2
                pb_quad_to(b, pt1.x, pt1.y, pt2.x, pt2.y)
            }
            Cubic => {
                let pt1 = other.points[offset - 1]
                let pt2 = other.points[offset - 2]
                let pt3 = other.points[offset - 3]
                offset -= 3
                pb_cubic_to(b, pt1.x, pt1.y, pt2.x, pt2.y, pt3.x, pt3.y)
            }
            Close => {}
        }
    }
}

fn pb_finish(b: *PbBuilder) -> Path ! StrokeError {
    if pb_is_empty(b) {
        fail StrokeError.Unstrokable
    }
    if b.verbs.len == 1 {
        fail StrokeError.Unstrokable
    }
    var min_x = b.points[0].x
    var min_y = b.points[0].y
    var max_x = min_x
    var max_y = min_y
    for p in b.points {
        if !geo_pt_finite(p) {
            fail StrokeError.Unstrokable
        }
        min_x = geo_fmin(min_x, p.x)
        min_y = geo_fmin(min_y, p.y)
        max_x = geo_fmax(max_x, p.x)
        max_y = geo_fmax(max_y, p.y)
    }
    if pb_rect(min_x, min_y, max_x, max_y) == none {
        fail StrokeError.Unstrokable
    }
    Path { verbs: b.verbs, points: b.points }
}
