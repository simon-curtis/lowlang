import std/ui/geometry

enum StrokeType {
    Outer = 1
    Inner = -1
}

enum StrokeResult {
    Split
    Degenerate
    Quad
}

enum StrokeRayKind {
    CtrlPt
    ResultType
}

enum StrokeReduction {
    Dot = 0
    Line = 1
    Quad = 2
    Degenerate = 3
    Degenerate2 = 4
    Degenerate3 = 5
}

struct StrokeQuad {
    quad: GeoQuad
    tangent_start: geometry.Point
    tangent_end: geometry.Point
    start_t: f32
    mid_t: f32
    end_t: f32
    start_set: bool
    end_set: bool
    opposite: bool
}

struct StrokeRay {
    on_p: geometry.Point
    tangent: geometry.Point
}

struct StrokePerp {
    t_pt: geometry.Point
    on_pt: geometry.Point
    tangent: geometry.Point
}

struct StrokeQuadReduction {
    kind: StrokeReduction
    point: geometry.Point
}

struct StrokeCubicReduction {
    kind: StrokeReduction
    points: geometry.Point[]
    tangent_pt: geometry.Point
}

fn stroke_quad_new() -> *StrokeQuad {
    let z = geo_zero()
    new(StrokeQuad {
        quad: GeoQuad { p0: z, p1: z, p2: z }
        tangent_start: z
        tangent_end: z
        start_t: 0.0
        mid_t: 0.0
        end_t: 0.0
        start_set: false
        end_set: false
        opposite: false
    })
}

fn stroke_quad_init(q: *StrokeQuad, start: f32, end: f32) -> bool {
    q.start_t = start
    q.mid_t = geo_clamp01(geo_half(start + end))
    q.end_t = end
    q.start_set = false
    q.end_set = false
    q.start_t < q.mid_t && q.mid_t < q.end_t
}

fn stroke_quad_init_with_start(q: *StrokeQuad, parent: *StrokeQuad) -> bool {
    if !stroke_quad_init(q, parent.start_t, parent.mid_t) {
        return false
    }
    q.quad.p0 = parent.quad.p0
    q.tangent_start = parent.tangent_start
    q.start_set = true
    true
}

fn stroke_quad_init_with_end(q: *StrokeQuad, parent: *StrokeQuad) -> bool {
    if !stroke_quad_init(q, parent.mid_t, parent.end_t) {
        return false
    }
    q.quad.p2 = parent.quad.p2
    q.tangent_end = parent.tangent_end
    q.end_set = true
    true
}

fn stroke_degenerate_vector(v: geometry.Point) -> bool {
    !geo_can_normalize(v)
}

fn stroke_pt_to_line(pt: geometry.Point, line_start: geometry.Point, line_end: geometry.Point) -> f32 {
    let dxy = geo_sub(line_end, line_start)
    let ab0 = geo_sub(pt, line_start)
    let numer = geo_dot(dxy, ab0)
    let denom = geo_dot(dxy, dxy)
    let t = numer / denom
    if t >= 0.0 && t <= 1.0 {
        let hit = geo_pt(line_start.x * (1.0 - t) + line_end.x * t, line_start.y * (1.0 - t) + line_end.y * t)
        return geo_dist_sqd(hit, pt)
    }
    geo_dist_sqd(pt, line_start)
}

fn stroke_points_within_dist(near_pt: geometry.Point, far_pt: geometry.Point, limit: f32) -> bool {
    geo_dist_sqd(near_pt, far_pt) <= limit * limit
}

fn stroke_sharp_angle(quad: GeoQuad) -> bool {
    var smaller = geo_sub(quad.p1, quad.p0)
    var larger = geo_sub(quad.p1, quad.p2)
    let smaller_len = geo_len_sqd(smaller)
    var larger_len = geo_len_sqd(larger)
    if smaller_len > larger_len {
        let swap = smaller
        smaller = larger
        larger = swap
        larger_len = smaller_len
    }
    let scaled = geo_set_length(smaller.x, smaller.y, larger_len)
    if !scaled.ok {
        return false
    }
    geo_dot(scaled.pt, larger) > 0.0
}

fn stroke_pt_in_quad_bounds(quad: GeoQuad, pt: geometry.Point, inv_res_scale: f32) -> bool {
    let x_min = geo_fmin(geo_fmin(quad.p0.x, quad.p1.x), quad.p2.x)
    if pt.x + inv_res_scale < x_min {
        return false
    }
    let x_max = geo_fmax(geo_fmax(quad.p0.x, quad.p1.x), quad.p2.x)
    if pt.x - inv_res_scale > x_max {
        return false
    }
    let y_min = geo_fmin(geo_fmin(quad.p0.y, quad.p1.y), quad.p2.y)
    if pt.y + inv_res_scale < y_min {
        return false
    }
    let y_max = geo_fmax(geo_fmax(quad.p0.y, quad.p1.y), quad.p2.y)
    if pt.y - inv_res_scale > y_max {
        return false
    }
    true
}

fn stroke_intersect_quad_ray(line0: geometry.Point, line1: geometry.Point, quad: GeoQuad) -> f32[] {
    let vec = geo_sub(line1, line0)
    let r0 = (quad.p0.y - line0.y) * vec.x - (quad.p0.x - line0.x) * vec.y
    let r1 = (quad.p1.y - line0.y) * vec.x - (quad.p1.x - line0.x) * vec.y
    let r2 = (quad.p2.y - line0.y) * vec.x - (quad.p2.x - line0.x) * vec.y
    var a = r2
    var b = r1
    let c = r0
    a += c - 2.0 * b
    b -= c
    geo_find_unit_quad_roots(a, 2.0 * b, c)
}

fn stroke_quad_pt(q: GeoQuad, i: i64) -> geometry.Point {
    match i {
        0 => q.p0
        1 => q.p1
        _ => q.p2
    }
}

fn stroke_cubic_pt(c: GeoCubic, i: i64) -> geometry.Point {
    match i {
        0 => c.p0
        1 => c.p1
        2 => c.p2
        _ => c.p3
    }
}

fn stroke_quad_in_line(quad: GeoQuad) -> bool {
    var pt_max: f32 = -1.0
    var outer1 = 0
    var outer2 = 0
    for index in 0..2 {
        for inner in (index + 1)..3 {
            let test_diff = geo_sub(stroke_quad_pt(quad, inner), stroke_quad_pt(quad, index))
            let test_max = geo_fmax(geo_abs(test_diff.x), geo_abs(test_diff.y))
            if pt_max < test_max {
                outer1 = index
                outer2 = inner
                pt_max = test_max
            }
        }
    }
    let mid = outer1 ^ outer2 ^ 3
    let line_slop = pt_max * pt_max * geo_quad_slop
    stroke_pt_to_line(stroke_quad_pt(quad, mid), stroke_quad_pt(quad, outer1), stroke_quad_pt(quad, outer2)) <= line_slop
}

fn stroke_cubic_in_line(cubic: GeoCubic) -> bool {
    var pt_max: f32 = -1.0
    var outer1 = 0
    var outer2 = 0
    for index in 0..3 {
        for inner in (index + 1)..4 {
            let test_diff = geo_sub(stroke_cubic_pt(cubic, inner), stroke_cubic_pt(cubic, index))
            let test_max = geo_fmax(geo_abs(test_diff.x), geo_abs(test_diff.y))
            if pt_max < test_max {
                outer1 = index
                outer2 = inner
                pt_max = test_max
            }
        }
    }
    let mid1 = (1 + (2 >> outer2)) >> outer1
    let mid2 = outer1 ^ outer2 ^ mid1
    let line_slop = pt_max * pt_max * geo_cubic_slop
    let a = stroke_cubic_pt(cubic, outer1)
    let b = stroke_cubic_pt(cubic, outer2)
    stroke_pt_to_line(stroke_cubic_pt(cubic, mid1), a, b) <= line_slop && stroke_pt_to_line(stroke_cubic_pt(cubic, mid2), a, b) <= line_slop
}

fn stroke_check_quad_linear(quad: GeoQuad) -> StrokeQuadReduction {
    let zero = geo_zero()
    let degenerate_ab = stroke_degenerate_vector(geo_sub(quad.p1, quad.p0))
    let degenerate_bc = stroke_degenerate_vector(geo_sub(quad.p2, quad.p1))
    if degenerate_ab && degenerate_bc {
        return StrokeQuadReduction { kind: StrokeReduction.Dot, point: zero }
    }
    if degenerate_ab || degenerate_bc {
        return StrokeQuadReduction { kind: StrokeReduction.Line, point: zero }
    }
    if !stroke_quad_in_line(quad) {
        return StrokeQuadReduction { kind: StrokeReduction.Quad, point: zero }
    }
    let t = geo_find_quad_max_curvature(quad)
    if t == 0.0 || t == 1.0 {
        return StrokeQuadReduction { kind: StrokeReduction.Line, point: zero }
    }
    StrokeQuadReduction { kind: StrokeReduction.Degenerate, point: geo_eval_quad_at(quad, t) }
}

fn stroke_bool_count(v: bool) -> i64 {
    if v {
        return 1
    }
    0
}

fn stroke_check_cubic_linear(cubic: GeoCubic) -> StrokeCubicReduction {
    let zero = geo_zero()
    let reduction = [zero, zero, zero]
    let degenerate_ab = stroke_degenerate_vector(geo_sub(cubic.p1, cubic.p0))
    let degenerate_bc = stroke_degenerate_vector(geo_sub(cubic.p2, cubic.p1))
    let degenerate_cd = stroke_degenerate_vector(geo_sub(cubic.p3, cubic.p2))
    if degenerate_ab && degenerate_bc && degenerate_cd {
        return StrokeCubicReduction { kind: StrokeReduction.Dot, points: reduction, tangent_pt: zero }
    }
    if stroke_bool_count(degenerate_ab) + stroke_bool_count(degenerate_bc) + stroke_bool_count(degenerate_cd) == 2 {
        return StrokeCubicReduction { kind: StrokeReduction.Line, points: reduction, tangent_pt: zero }
    }
    if !stroke_cubic_in_line(cubic) {
        let tangent_pt = if degenerate_ab { cubic.p2 } else { cubic.p1 }
        return StrokeCubicReduction { kind: StrokeReduction.Quad, points: reduction, tangent_pt }
    }
    let t_values = geo_find_cubic_max_curvature(cubic)
    var r_count = 0
    for t in t_values {
        if 0.0 >= t || t >= 1.0 {
            continue
        }
        reduction[r_count] = geo_eval_cubic_pos_at(cubic, t)
        if !geo_pt_eq(reduction[r_count], cubic.p0) && !geo_pt_eq(reduction[r_count], cubic.p3) {
            r_count += 1
        }
    }
    let kind = match r_count {
        0 => StrokeReduction.Line
        1 => StrokeReduction.Degenerate
        2 => StrokeReduction.Degenerate2
        _ => StrokeReduction.Degenerate3
    }
    StrokeCubicReduction { kind, points: reduction, tangent_pt: zero }
}

fn stroke_set_ray_points(s: *StrokeState, tp: geometry.Point, dxy_in: geometry.Point) -> StrokeRay {
    let scaled = geo_set_length(dxy_in.x, dxy_in.y, s.radius)
    let dxy = if scaled.ok { scaled.pt } else { geo_pt(s.radius, 0.0) }
    let axis_flip = f32(s.stroke_type.index)
    let on_p = geo_pt(tp.x + axis_flip * dxy.y, tp.y - axis_flip * dxy.x)
    StrokeRay { on_p, tangent: geo_pt(on_p.x + dxy.x, on_p.y + dxy.y) }
}

fn stroke_quad_perp_ray(s: *StrokeState, quad: GeoQuad, t: f32) -> StrokePerp {
    let tp = geo_eval_quad_at(quad, t)
    var dxy = geo_eval_quad_tangent_at(quad, t)
    if geo_is_zero(dxy) {
        dxy = geo_sub(quad.p2, quad.p0)
    }
    let ray = stroke_set_ray_points(s, tp, dxy)
    StrokePerp { t_pt: tp, on_pt: ray.on_p, tangent: ray.tangent }
}

fn stroke_cubic_perp_ray(s: *StrokeState, cubic: GeoCubic, t: f32) -> StrokePerp {
    let t_pt = geo_eval_cubic_pos_at(cubic, t)
    var dxy = geo_eval_cubic_tangent_at(cubic, t)
    if dxy.x == 0.0 && dxy.y == 0.0 {
        var use_chopped = false
        var chopped: geometry.Point[] = []
        if geo_is_nearly_zero(t) {
            dxy = geo_sub(cubic.p2, cubic.p0)
        } else if geo_is_nearly_zero(1.0 - t) {
            dxy = geo_sub(cubic.p3, cubic.p1)
        } else {
            chopped = geo_chop_cubic_at(cubic, t)
            dxy = geo_sub(chopped[3], chopped[2])
            if dxy.x == 0.0 && dxy.y == 0.0 {
                dxy = geo_sub(chopped[3], chopped[1])
                use_chopped = true
            }
        }
        if dxy.x == 0.0 && dxy.y == 0.0 {
            dxy = if use_chopped { geo_sub(chopped[3], chopped[0]) } else { geo_sub(cubic.p3, cubic.p0) }
        }
    }
    let ray = stroke_set_ray_points(s, t_pt, dxy)
    StrokePerp { t_pt, on_pt: ray.on_p, tangent: ray.tangent }
}

fn stroke_cubic_quad_ends(s: *StrokeState, cubic: GeoCubic, qp: *StrokeQuad) {
    if !qp.start_set {
        let perp = stroke_cubic_perp_ray(s, cubic, qp.start_t)
        qp.quad.p0 = perp.on_pt
        qp.tangent_start = perp.tangent
        qp.start_set = true
    }
    if !qp.end_set {
        let perp = stroke_cubic_perp_ray(s, cubic, qp.end_t)
        qp.quad.p2 = perp.on_pt
        qp.tangent_end = perp.tangent
        qp.end_set = true
    }
}

fn stroke_intersect_ray(s: *StrokeState, kind: StrokeRayKind, qp: *StrokeQuad) -> StrokeResult {
    let start = qp.quad.p0
    let end = qp.quad.p2
    let a_len = geo_sub(qp.tangent_start, start)
    let b_len = geo_sub(qp.tangent_end, end)
    let denom = geo_cross(a_len, b_len)
    if denom == 0.0 || !geo_finite(denom) {
        qp.opposite = geo_dot(a_len, b_len) < 0.0
        return StrokeResult.Degenerate
    }
    qp.opposite = false
    let ab0 = geo_sub(start, end)
    var numer_a = geo_cross(b_len, ab0)
    let numer_b = geo_cross(a_len, ab0)
    if (numer_a >= 0.0) == (numer_b >= 0.0) {
        let dist1 = stroke_pt_to_line(start, end, qp.tangent_end)
        let dist2 = stroke_pt_to_line(end, start, qp.tangent_start)
        if geo_fmax(dist1, dist2) <= s.inv_res_scale_squared {
            return StrokeResult.Degenerate
        }
        return StrokeResult.Split
    }
    numer_a /= denom
    let valid_divide = numer_a > numer_a - 1.0
    if valid_divide {
        if kind == StrokeRayKind.CtrlPt {
            qp.quad.p1 = geo_pt(start.x * (1.0 - numer_a) + qp.tangent_start.x * numer_a, start.y * (1.0 - numer_a) + qp.tangent_start.y * numer_a)
        }
        return StrokeResult.Quad
    }
    qp.opposite = geo_dot(a_len, b_len) < 0.0
    StrokeResult.Degenerate
}

fn stroke_close_enough(s: *StrokeState, stroke: GeoQuad, ray0: geometry.Point, ray1: geometry.Point, qp: *StrokeQuad) -> StrokeResult {
    let stroke_mid = geo_eval_quad_at(stroke, 0.5)
    if stroke_points_within_dist(ray0, stroke_mid, s.inv_res_scale) {
        if stroke_sharp_angle(qp.quad) {
            return StrokeResult.Split
        }
        return StrokeResult.Quad
    }
    if !stroke_pt_in_quad_bounds(stroke, ray0, s.inv_res_scale) {
        return StrokeResult.Split
    }
    let roots = stroke_intersect_quad_ray(ray0, ray1, stroke)
    if roots.len != 1 {
        return StrokeResult.Split
    }
    let quad_pt = geo_eval_quad_at(stroke, roots[0])
    let error = s.inv_res_scale * (1.0 - geo_abs(roots[0] - 0.5) * 2.0)
    if stroke_points_within_dist(ray0, quad_pt, error) {
        if stroke_sharp_angle(qp.quad) {
            return StrokeResult.Split
        }
        return StrokeResult.Quad
    }
    StrokeResult.Split
}

fn stroke_compare_quad_cubic(s: *StrokeState, cubic: GeoCubic, qp: *StrokeQuad) -> StrokeResult {
    stroke_cubic_quad_ends(s, cubic, qp)
    let result = stroke_intersect_ray(s, StrokeRayKind.CtrlPt, qp)
    if result != StrokeResult.Quad {
        return result
    }
    let perp = stroke_cubic_perp_ray(s, cubic, qp.mid_t)
    stroke_close_enough(s, qp.quad, perp.on_pt, perp.t_pt, qp)
}

fn stroke_compare_quad_quad(s: *StrokeState, quad: GeoQuad, qp: *StrokeQuad) -> StrokeResult {
    if !qp.start_set {
        let perp = stroke_quad_perp_ray(s, quad, qp.start_t)
        qp.quad.p0 = perp.on_pt
        qp.tangent_start = perp.tangent
        qp.start_set = true
    }
    if !qp.end_set {
        let perp = stroke_quad_perp_ray(s, quad, qp.end_t)
        qp.quad.p2 = perp.on_pt
        qp.tangent_end = perp.tangent
        qp.end_set = true
    }
    let result = stroke_intersect_ray(s, StrokeRayKind.CtrlPt, qp)
    if result != StrokeResult.Quad {
        return result
    }
    let perp = stroke_quad_perp_ray(s, quad, qp.mid_t)
    stroke_close_enough(s, qp.quad, perp.on_pt, perp.t_pt, qp)
}

fn stroke_add_degenerate_line(s: *StrokeState, qp: *StrokeQuad) {
    let target = if s.stroke_type == StrokeType.Outer { s.outer } else { s.inner }
    pb_line_to(target, qp.quad.p2.x, qp.quad.p2.y)
}

fn stroke_emit_quad(s: *StrokeState, qp: *StrokeQuad) {
    let target = if s.stroke_type == StrokeType.Outer { s.outer } else { s.inner }
    pb_quad_to(target, qp.quad.p1.x, qp.quad.p1.y, qp.quad.p2.x, qp.quad.p2.y)
}

fn stroke_init_quad(s: *StrokeState, stroke_type: StrokeType, start: f32, end: f32, qp: *StrokeQuad) {
    s.stroke_type = stroke_type
    s.found_tangents = false
    stroke_quad_init(qp, start, end)
}

fn stroke_quad_stroke(s: *StrokeState, quad: GeoQuad, qp: *StrokeQuad) -> bool {
    let result = stroke_compare_quad_quad(s, quad, qp)
    if result == StrokeResult.Quad {
        stroke_emit_quad(s, qp)
        return true
    }
    if result == StrokeResult.Degenerate {
        stroke_add_degenerate_line(s, qp)
        return true
    }
    s.recursion_depth += 1
    if s.recursion_depth > 33 {
        return false
    }
    let half = stroke_quad_new()
    let _ = stroke_quad_init_with_start(half, qp)
    if !stroke_quad_stroke(s, quad, half) {
        return false
    }
    let _ = stroke_quad_init_with_end(half, qp)
    if !stroke_quad_stroke(s, quad, half) {
        return false
    }
    s.recursion_depth -= 1
    true
}

fn stroke_tangents_meet(s: *StrokeState, cubic: GeoCubic, qp: *StrokeQuad) -> StrokeResult {
    stroke_cubic_quad_ends(s, cubic, qp)
    stroke_intersect_ray(s, StrokeRayKind.ResultType, qp)
}

fn stroke_cubic_mid_on_line(s: *StrokeState, cubic: GeoCubic, qp: *StrokeQuad) -> bool {
    let perp = stroke_cubic_perp_ray(s, cubic, qp.mid_t)
    let dist = stroke_pt_to_line(perp.on_pt, qp.quad.p0, qp.quad.p2)
    dist < s.inv_res_scale_squared
}

fn stroke_cubic_stroke(s: *StrokeState, cubic: GeoCubic, qp: *StrokeQuad) -> bool {
    if !s.found_tangents {
        let result = stroke_tangents_meet(s, cubic, qp)
        if result != StrokeResult.Quad {
            let ok = stroke_points_within_dist(qp.quad.p0, qp.quad.p2, s.inv_res_scale)
            if (result == StrokeResult.Degenerate || ok) && stroke_cubic_mid_on_line(s, cubic, qp) {
                stroke_add_degenerate_line(s, qp)
                return true
            }
        } else {
            s.found_tangents = true
        }
    }
    if s.found_tangents {
        let result = stroke_compare_quad_cubic(s, cubic, qp)
        if result == StrokeResult.Quad {
            stroke_emit_quad(s, qp)
            return true
        }
        if result == StrokeResult.Degenerate {
            if !qp.opposite {
                stroke_add_degenerate_line(s, qp)
                return true
            }
        }
    }
    if !geo_finite(qp.quad.p2.x) || !geo_finite(qp.quad.p2.x) {
        return false
    }
    s.recursion_depth += 1
    let limit = if s.found_tangents { 78 } else { 15 }
    if s.recursion_depth > limit {
        return false
    }
    let half = stroke_quad_new()
    if !stroke_quad_init_with_start(half, qp) {
        stroke_add_degenerate_line(s, qp)
        s.recursion_depth -= 1
        return true
    }
    if !stroke_cubic_stroke(s, cubic, half) {
        return false
    }
    if !stroke_quad_init_with_end(half, qp) {
        stroke_add_degenerate_line(s, qp)
        s.recursion_depth -= 1
        return true
    }
    if !stroke_cubic_stroke(s, cubic, half) {
        return false
    }
    s.recursion_depth -= 1
    true
}

fn stroke_set_cubic_end_normal(s: *StrokeState, cubic: GeoCubic, normal_ab: geometry.Point, unit_ab: geometry.Point) -> StrokeNormals {
    var ab = geo_sub(cubic.p1, cubic.p0)
    var cd = geo_sub(cubic.p3, cubic.p2)
    var degenerate_ab = stroke_degenerate_vector(ab)
    var degenerate_cb = stroke_degenerate_vector(cd)
    let same = StrokeNormals { ok: true, normal: normal_ab, unit: unit_ab }
    if degenerate_ab && degenerate_cb {
        return same
    }
    if degenerate_ab {
        ab = geo_sub(cubic.p2, cubic.p0)
        degenerate_ab = stroke_degenerate_vector(ab)
    }
    if degenerate_cb {
        cd = geo_sub(cubic.p3, cubic.p1)
        degenerate_cb = stroke_degenerate_vector(cd)
    }
    if degenerate_ab || degenerate_cb {
        return same
    }
    stroke_set_normals2(cd, s.radius)
}
