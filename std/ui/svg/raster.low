import std/slices
import std/ui/geometry

struct BlitState {
    pixels: u8[]
    stride: i64
    curr_iy: i64
    width: i64
    left: i64
    super_left: i64
    curr_y: i64
    top: i64
    offset_x: i64
    runs: i64[]
    alpha: i64[]
}

fn blit_runs_reset(s: *BlitState) {
    s.runs[0] = s.width
    s.runs[s.width] = 0
    s.alpha[0] = 0
}

fn blit_runs_empty(s: *BlitState) -> bool {
    if s.runs[0] == 0 {
        return true
    }
    s.alpha[0] == 0 && s.runs[s.runs[0]] == 0
}

fn blit_break_run(s: *BlitState, base: i64, x_in: i64, count: i64) {
    var x = x_in
    var o = 0
    for x > 0 {
        let n = s.runs[base + o]
        if x < n {
            s.alpha[base + o + x] = s.alpha[base + o]
            s.runs[base + o] = x
            s.runs[base + o + x] = n - x
            break
        }
        o += n
        x -= n
    }
    o = x_in
    x = count
    for {
        let n = s.runs[base + o]
        if x < n {
            s.alpha[base + o + x] = s.alpha[base + o]
            s.runs[base + o] = x
            s.runs[base + o + x] = n - x
            break
        }
        x -= n
        if x == 0 {
            break
        }
        o += n
    }
}

fn blit_runs_add(s: *BlitState, x_in: i64, start_alpha: i64, middle_in: i64, stop_alpha: i64, max_value: i64, offset_x: i64) -> i64 {
    var x = x_in - offset_x
    var o = offset_x
    var last = offset_x
    var middle = middle_in
    if start_alpha != 0 {
        blit_break_run(s, o, x, 1)
        let tmp = s.alpha[o + x] + start_alpha
        s.alpha[o + x] = tmp - (tmp >> 8)
        o += x + 1
        x = 0
    }
    if middle != 0 {
        blit_break_run(s, o, x, middle)
        o += x
        x = 0
        for {
            let a = s.alpha[o] + max_value
            s.alpha[o] = a - (a >> 8)
            let n = s.runs[o]
            o += n
            middle -= n
            if middle == 0 {
                break
            }
        }
        last = o
    }
    if stop_alpha != 0 {
        blit_break_run(s, o, x, 1)
        o += x
        s.alpha[o] = (s.alpha[o] + stop_alpha) & 255
        last = o
    }
    last
}

fn blit_memset(s: *BlitState, x: i64, y: i64, width: i64) {
    let start = y * s.stride + x
    for i in 0..width {
        s.pixels[start + i] = 255
    }
}

fn blit_partial(s: *BlitState, x: i64, y: i64, width: i64, a: i64) {
    let inv255: f32 = 1.0 / 255.0
    let coverage: f32 = f32(a) * inv255
    let c: i64 = i64(coverage * 255.0 + 0.5)
    let start = y * s.stride + x
    for i in 0..width {
        let da = i64(s.pixels[start + i])
        s.pixels[start + i] = u8((da * (255 - c) + 255 * c + 255) >> 8)
    }
}

fn blit_anti_h(s: *BlitState, x0: i64, y: i64) {
    var x = x0
    var ro = 0
    var run = s.runs[0]
    for run != 0 {
        let a = s.alpha[ro]
        if a == 255 {
            blit_memset(s, x, y, run)
        } else if a != 0 {
            blit_partial(s, x, y, run, a)
        }
        x += run
        ro += run
        run = s.runs[ro]
    }
}

fn blit_flush(s: *BlitState) {
    if s.curr_iy >= s.top {
        if !blit_runs_empty(s) {
            blit_anti_h(s, s.left, s.curr_iy)
            blit_runs_reset(s)
            s.offset_x = 0
        }
        s.curr_iy = s.top - 1
    }
}

fn blit_h(s: *BlitState, x_in: i64, y: i64, width_in: i64) {
    let iy = y >> 2
    var x = x_in
    var width = width_in
    if x >= s.super_left {
        x -= s.super_left
    } else {
        width = x + width
        x = 0
    }
    if s.curr_y != y {
        s.offset_x = 0
        s.curr_y = y
    }
    if iy != s.curr_iy {
        blit_flush(s)
        s.curr_iy = iy
    }
    let start = x
    let stop = x + width
    var fb = start & 3
    var fe = stop & 3
    var n = (stop >> 2) - (start >> 2) - 1
    if n < 0 {
        fb = fe - fb
        n = 0
        fe = 0
    } else if fb == 0 {
        n += 1
    } else {
        fb = 4 - fb
    }
    let max_value = 64 - (((y & 3) + 1) >> 2)
    s.offset_x = blit_runs_add(s, x >> 2, fb << 4, n, fe << 4, max_value, s.offset_x)
}

fn scan_remove_edge(edges: *EdgeRec[], i: i64) {
    let prev = edges[i].prev
    let next = edges[i].next
    edges[prev].next = next
    edges[next].prev = prev
}

fn scan_insert_after(edges: *EdgeRec[], i: i64, after: i64) {
    edges[i].prev = after
    edges[i].next = edges[after].next
    let after_next = edges[after].next
    edges[after_next].prev = i
    edges[after].next = i
}

fn scan_backward_insert(edges: *EdgeRec[], i: i64) {
    let x = edges[i].x
    var prev = edges[i].prev
    for prev != 0 {
        if edges[prev].x > x {
            prev = edges[prev].prev
        } else {
            break
        }
    }
    let next = edges[prev].next
    if next != i {
        scan_remove_edge(edges, i)
        scan_insert_after(edges, i, prev)
    }
}

fn scan_backward_insert_start(edges: *EdgeRec[], prev_in: i64, x: i64) -> i64 {
    var prev = prev_in
    for edges[prev].prev >= 0 {
        prev = edges[prev].prev
        if edges[prev].x <= x {
            break
        }
    }
    prev
}

fn scan_insert_new_edges(edges: *EdgeRec[], new_in: i64, curr_y: i64) {
    var new_idx = new_in
    if edges[new_idx].first_y != curr_y {
        return
    }
    let prev_idx = edges[new_idx].prev
    if edges[prev_idx].x <= edges[new_idx].x {
        return
    }
    var start_idx = scan_backward_insert_start(edges, prev_idx, edges[new_idx].x)
    for {
        let next_idx = edges[new_idx].next
        var keep = false
        for {
            let after_idx = edges[start_idx].next
            if after_idx == new_idx {
                keep = true
                break
            }
            if edges[after_idx].x >= edges[new_idx].x {
                break
            }
            start_idx = after_idx
        }
        if !keep {
            scan_remove_edge(edges, new_idx)
            scan_insert_after(edges, new_idx, start_idx)
        }
        start_idx = new_idx
        new_idx = next_idx
        if edges[new_idx].first_y != curr_y {
            break
        }
    }
}

fn scan_walk(edges: *EdgeRec[], start_y: i64, stop_y: i64, right_clip: i64, s: *BlitState) {
    var curr_y = start_y
    for {
        var w = 0
        var left = 0
        var prev_x = edges[0].x
        var ci = edges[0].next
        for edges[ci].first_y <= curr_y {
            let e = edges[ci]
            let x = (e.x + 32768) >> 16
            if w == 0 {
                left = x
            }
            w += e.winding
            if w == 0 {
                let width = x - left
                if width > 0 {
                    blit_h(s, left, curr_y, width)
                }
            }
            let next_idx = e.next
            if e.last_y == curr_y {
                if e.kind == 0 {
                    scan_remove_edge(edges, ci)
                } else if e.kind == 1 {
                    if e.count > 0 && edge_quad_update(e) {
                        let new_x = e.x
                        if new_x < prev_x {
                            scan_backward_insert(edges, ci)
                        } else {
                            prev_x = new_x
                        }
                    } else {
                        scan_remove_edge(edges, ci)
                    }
                } else {
                    if e.count < 0 && edge_cubic_update(e) {
                        let new_x = e.x
                        if new_x < prev_x {
                            scan_backward_insert(edges, ci)
                        } else {
                            prev_x = new_x
                        }
                    } else {
                        scan_remove_edge(edges, ci)
                    }
                }
            } else {
                let new_x = e.x + e.dx
                e.x = new_x
                if new_x < prev_x {
                    scan_backward_insert(edges, ci)
                } else {
                    prev_x = new_x
                }
            }
            ci = next_idx
        }
        if w != 0 {
            let width = right_clip - left
            if width > 0 {
                blit_h(s, left, curr_y, width)
            }
        }
        curr_y += 1
        if curr_y >= stop_y {
            break
        }
        scan_insert_new_edges(edges, ci, curr_y)
    }
}

fn scan_less(a: *EdgeRec, b: *EdgeRec) -> bool {
    if a.first_y == b.first_y {
        return a.x < b.x
    }
    a.first_y < b.first_y
}

fn scan_ceil(x: f32) -> f32 {
    let f = floor(x)
    if f == x {
        return x
    }
    f + 1.0
}

fn scan_fill_impl(p: Path, width: i64, height: i64, ir_top: i64, ir_bottom: i64, contained: bool, s: *BlitState) {
    var edges: *EdgeRec[] = []
    if !edge_build(p, !contained, width, height, 2, mut edges) {
        return
    }
    if edges.len < 2 {
        return
    }
    slices.sort_stable_by(mut edges, scan_less)
    let count = edges.len
    for i in 0..count {
        edges[i].prev = i
        edges[i].next = i + 2
    }
    var all: *EdgeRec[] = []
    all.push(new(EdgeRec { prev: -1, next: 1, x: -2147483648, first_y: -2147483648 }))
    for e in edges {
        all.push(e)
    }
    all.push(new(EdgeRec { prev: count, next: -1, first_y: 2147483647 }))
    var start_y = ir_top << 2
    var stop_y = ir_bottom << 2
    let clip_bottom = height << 2
    if !contained && start_y < 0 {
        start_y = 0
    }
    if !contained && stop_y > clip_bottom {
        stop_y = clip_bottom
    }
    if start_y < 0 || stop_y < 0 {
        return
    }
    scan_walk(all, start_y, stop_y, width << 2, s)
    blit_flush(s)
}

fn scan_short_overflow(v: i64) -> bool {
    v < -8192 || v >= 8192
}

fn fill_path(p: Path, width: i64, height: i64, mut alpha: u8[]) {
    if p.points.len == 0 || width <= 0 || height <= 0 {
        return
    }
    let b = edge_bounds(p.points)
    if !b.ok {
        return
    }
    let limit: f32 = 0.000244140625
    if b.r - b.l <= limit || b.b - b.t <= limit {
        return
    }
    let max_coord: f32 = 3.402823466e+38 * 0.25
    if !(b.l >= -max_coord && b.t >= -max_coord && b.r <= max_coord && b.b <= max_coord) {
        return
    }
    let fl = floor(b.l)
    let ft = floor(b.t)
    let fr = scan_ceil(b.r)
    let fb = scan_ceil(b.b)
    let ir_left = edge_sat32(fl)
    let ir_top = edge_sat32(ft)
    var wd = edge_sat32(scan_ceil(fr - fl))
    var ht = edge_sat32(scan_ceil(fb - ft))
    if wd < 1 {
        wd = 1
    }
    if ht < 1 {
        ht = 1
    }
    let ir_right = ir_left + wd
    let ir_bottom = ir_top + ht
    if ir_right > 2147483647 || ir_bottom > 2147483647 {
        return
    }
    var sl = ir_left
    if sl < 0 {
        sl = 0
    }
    var st = ir_top
    if st < 0 {
        st = 0
    }
    var sr = ir_right
    if sr > width {
        sr = width
    }
    var sb = ir_bottom
    if sb > height {
        sb = height
    }
    if sr - sl <= 0 || sb - st <= 0 {
        return
    }
    if scan_short_overflow(sl) || scan_short_overflow(st) || scan_short_overflow(sr) || scan_short_overflow(sb) {
        return
    }
    let contained = ir_left >= 0 && ir_top >= 0 && ir_right <= width && ir_bottom <= height
    var runs: i64[] = []
    var alphas: i64[] = []
    for i in 0..(sr - sl) + 1 {
        runs.push(0)
        alphas.push(0)
    }
    let s = new(BlitState {
        pixels: alpha,
        stride: width,
        curr_iy: st - 1,
        width: sr - sl,
        left: sl,
        super_left: sl << 2,
        curr_y: (st << 2) - 1,
        top: st,
        offset_x: 0,
        runs: runs,
        alpha: alphas,
    })
    blit_runs_reset(s)
    scan_fill_impl(p, width, height, ir_top, ir_bottom, contained, s)
}
