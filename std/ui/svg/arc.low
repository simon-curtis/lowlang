import std/math

const arc_tolerance = 0.1
const arc_two_pi = 6.283185307179586
const arc_half_pi = 1.5707963267948966
const arc_degrees_to_radians = 0.017453292519943295

struct ArcPoint {
    x: f64
    y: f64
}

fn arc_sample(rx: f64, ry: f64, rotation: f64, angle: f64) -> ArcPoint {
    let u = rx * math.cos(angle)
    let v = ry * math.sin(angle)
    ArcPoint { x: u * math.cos(rotation) - v * math.sin(rotation), y: u * math.sin(rotation) + v * math.cos(rotation) }
}

fn arc_signum(v: f64) -> f64 {
    if v < 0.0 || (v == 0.0 && 1.0 / v < 0.0) {
        return -1.0
    }
    1.0
}

fn arc_max(a: f64, b: f64) -> f64 {
    if a > b {
        return a
    }
    b
}

fn arc_cubics(from: ArcPoint, to: ArcPoint, radius_x: f64, radius_y: f64, degrees: f64, large: bool, sweep: bool) -> f64[]? {
    if math.abs(radius_x) <= 0.00001 || math.abs(radius_y) <= 0.00001 || (from.x == to.x && from.y == to.y) {
        return none
    }
    var rx = math.abs(radius_x)
    var ry = math.abs(radius_y)
    let rotation = degrees * arc_degrees_to_radians
    let turned = math.fmod(rotation, arc_two_pi)
    let sin_phi = math.sin(turned)
    let cos_phi = math.cos(turned)
    let hd_x = (from.x - to.x) * 0.5
    let hd_y = (from.y - to.y) * 0.5
    let hs_x = (from.x + to.x) * 0.5
    let hs_y = (from.y + to.y) * 0.5
    let px = cos_phi * hd_x + sin_phi * hd_y
    let py = -sin_phi * hd_x + cos_phi * hd_y
    let rf = px * px / (rx * rx) + py * py / (ry * ry)
    if rf > 1.0 {
        let scale = sqrt(rf)
        rx = rx * scale
        ry = ry * scale
    }
    let rxry = rx * ry
    let rxpy = rx * py
    let rypx = ry * px
    let sum_of_sq = rxpy * rxpy + rypx * rypx
    let sign_coe = if large == sweep { -1.0 } else { 1.0 }
    let coe = sign_coe * sqrt(math.abs((rxry * rxry - sum_of_sq) / sum_of_sq))
    let transformed_cx = coe * rxpy / ry
    let transformed_cy = -coe * rypx / rx
    let center_x = cos_phi * transformed_cx - sin_phi * transformed_cy + hs_x
    let center_y = sin_phi * transformed_cx + cos_phi * transformed_cy + hs_y
    let start_x = (px - transformed_cx) / rx
    let start_y = (py - transformed_cy) / ry
    let end_x = (-px - transformed_cx) / rx
    let end_y = (-py - transformed_cy) / ry
    let start_angle = math.atan2(start_y, start_x)
    var sweep_angle = math.fmod(math.atan2(end_y, end_x) - start_angle, arc_two_pi)
    if sweep && sweep_angle < 0.0 {
        sweep_angle = sweep_angle + arc_two_pi
    } else if !sweep && sweep_angle > 0.0 {
        sweep_angle = sweep_angle - arc_two_pi
    }
    let sign = arc_signum(sweep_angle)
    let scaled_err = arc_max(rx, ry) / arc_tolerance
    let n_err = arc_max(math.pow(1.1163 * scaled_err, 1.0 / 6.0), 3.999999)
    let count = math.ceil(n_err * math.abs(sweep_angle) * (1.0 / arc_two_pi))
    let angle_step = sweep_angle / count
    let arm_len = (4.0 / 3.0) * math.abs(math.tan(0.25 * angle_step)) * sign
    var angle0 = start_angle
    var p0 = arc_sample(rx, ry, rotation, angle0)
    var out: f64[] = []
    for _ in 0..i64(count) {
        let angle1 = angle0 + angle_step
        let d0 = arc_sample(rx, ry, rotation, angle0 + arc_half_pi)
        let p3 = arc_sample(rx, ry, rotation, angle1)
        let d1 = arc_sample(rx, ry, rotation, angle1 + arc_half_pi)
        out.push(center_x + (p0.x + arm_len * d0.x))
        out.push(center_y + (p0.y + arm_len * d0.y))
        out.push(center_x + (p3.x - arm_len * d1.x))
        out.push(center_y + (p3.y - arm_len * d1.y))
        out.push(center_x + p3.x)
        out.push(center_y + p3.y)
        angle0 = angle1
        p0 = p3
    }
    out
}
