import std/testing

fn at(m: Mask, x: i64, y: i64) -> i64 {
    i64(m.coverage[y * m.width + x])
}

fn icon_of(t: *testing.T, source: str) -> Icon {
    let empty = Icon { width: 1.0, height: 1.0, view_x: 0.0, view_y: 0.0, view_width: 1.0, view_height: 1.0, shapes: [] }
    parse(source) catch { e => testing.must(t, describe(e), empty) }
}

fn failure(source: str) -> str {
    let icon = parse(source) catch { e => return describe(e) }
    "parsed {icon.width}"
}

fn document(body: str) -> str {
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"8\" height=\"8\" viewBox=\"0 0 8 8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{body}</svg>"
}

fn test_a_filled_square_covers_its_pixels_fully(t: *testing.T) {
    let m = render(icon_of(t, document("<rect x=\"2\" y=\"2\" width=\"4\" height=\"4\" fill=\"black\" stroke=\"none\"/>")), 8)
    testing.equal(t, m.width, 8)
    testing.equal(t, m.height, 8)
    testing.equal(t, at(m, 3, 3), 255)
    testing.equal(t, at(m, 1, 3), 0)
    testing.equal(t, at(m, 6, 3), 0)
    testing.equal(t, at(m, 3, 1), 0)
}

fn test_the_mask_scales_with_the_requested_width(t: *testing.T) {
    let m = render(icon_of(t, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"12\" viewBox=\"0 0 24 12\"/>"), 48)
    testing.equal(t, m.width, 48)
    testing.equal(t, m.height, 24)
    testing.equal(t, m.coverage.len, 48 * 24)
}

fn test_a_stroke_is_centred_on_its_path(t: *testing.T) {
    let m = render(icon_of(t, document("<line x1=\"2\" y1=\"4\" x2=\"6\" y2=\"4\"/>")), 8)
    testing.equal(t, at(m, 4, 3), 255)
    testing.equal(t, at(m, 4, 4), 255)
    testing.equal(t, at(m, 4, 2), 0)
    testing.equal(t, at(m, 4, 5), 0)
    testing.equal(t, at(m, 0, 4), 0)
    testing.is_true(t, at(m, 1, 3) > 0 && at(m, 1, 3) < 255)
}

fn test_half_covered_pixels_get_partial_coverage(t: *testing.T) {
    let m = render(icon_of(t, document("<rect x=\"0\" y=\"0\" width=\"8\" height=\"1.5\" fill=\"black\" stroke=\"none\"/>")), 8)
    testing.equal(t, at(m, 3, 0), 255)
    testing.equal(t, at(m, 3, 1), 128)
    testing.equal(t, at(m, 3, 2), 0)
}

fn test_arcs_and_relative_commands_make_a_circle(t: *testing.T) {
    let m = render(icon_of(t, document("<path d=\"M2 4a2 2 0 1 0 4 0a2 2 0 1 0-4 0Z\" fill=\"black\" stroke=\"none\"/>")), 8)
    testing.equal(t, at(m, 4, 4), 255)
    testing.equal(t, at(m, 0, 0), 0)
    testing.equal(t, at(m, 7, 7), 0)
    testing.equal(t, at(m, 3, 4), 255)
}

fn test_shorthand_curves_and_implicit_lineto_parse(t: *testing.T) {
    let m = render(icon_of(t, document("<path d=\"M1 1 7 1 7 7H1V1zM2 2c1 0 2 1 2 2s1 2 2 2\" fill=\"black\" stroke=\"none\"/>")), 8)
    testing.equal(t, at(m, 6, 1), 255)
}

fn test_a_transform_is_rejected(t: *testing.T) {
    testing.equal(t, failure(document("<g transform=\"scale(2)\"><rect width=\"1\" height=\"1\"/></g>")), "unsupported svg feature: transform")
}

fn test_a_butt_capped_stroke_is_rejected(t: *testing.T) {
    let message = failure("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"8\" height=\"8\"><path d=\"M1 1L7 7\" stroke=\"black\"/></svg>")
    testing.contains(t, message, "unsupported svg feature")
}

fn test_malformed_input_is_reported(t: *testing.T) {
    testing.contains(t, failure("<svg"), "malformed svg")
    testing.contains(t, failure("<svg xmlns=\"http://www.w3.org/2000/svg\"/>"), "malformed svg")
    testing.contains(t, failure(document("<path d=\"M1\"/>")), "malformed svg")
    testing.contains(t, failure("<html/>"), "malformed svg")
}
