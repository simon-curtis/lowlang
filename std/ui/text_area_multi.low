import std/slices
import std/ui/geometry
import std/ui/scene
import std/unicode
import strs = std/text

const area_no_x: f32 = -1.0

struct AreaLanding {
    start: TextPosition
    stop: TextPosition
}

fn span_start(s: AreaSel) -> TextPosition {
    if area_before(s.caret, s.anchor) { s.caret } else { s.anchor }
}

fn span_stop(s: AreaSel) -> TextPosition {
    if area_before(s.caret, s.anchor) { s.anchor } else { s.caret }
}

fn span_empty(s: AreaSel) -> bool {
    area_same(s.caret, s.anchor)
}

fn span_less(a: AreaSel, b: AreaSel) -> bool {
    let x = span_start(a)
    let y = span_start(b)
    if area_same(x, y) {
        return area_before(span_stop(a), span_stop(b))
    }
    area_before(x, y)
}

fn span_joins(cur: AreaSel, next: AreaSel) -> bool {
    let reach = span_stop(cur)
    let at = span_start(next)
    if span_empty(cur) || span_empty(next) {
        return !area_before(reach, at)
    }
    area_before(at, reach)
}

fn span_join(cur: AreaSel, next: AreaSel) -> AreaSel {
    let lo = span_start(cur)
    let further = area_before(span_stop(cur), span_stop(next))
    let hi = if further { span_stop(next) } else { span_stop(cur) }
    let source = if further { next } else { cur }
    var out = AreaSel { anchor: lo, caret: hi, x: source.x, newest: cur.newest || next.newest }
    if area_before(source.caret, source.anchor) {
        out.anchor = hi
        out.caret = lo
    }
    out
}

fn area_normalise(sels: AreaSel[]) -> AreaSel[] {
    if sels.len < 2 {
        return sels
    }
    var ordered = true
    var joined = false
    for i in 1..sels.len {
        if span_less(sels[i], sels[i - 1]) {
            ordered = false
            break
        }
        if span_joins(sels[i - 1], sels[i]) {
            joined = true
        }
    }
    if ordered && !joined {
        return sels
    }
    var sorted = sels
    if !ordered {
        sorted = slices.clone(sels)
        slices.sort_by(mut sorted, fn(x: AreaSel, y: AreaSel) -> bool { span_less(x, y) })
    }
    var out: AreaSel[] = []
    var cur = sorted[0]
    for i in 1..sorted.len {
        let next = sorted[i]
        if span_joins(cur, next) {
            cur = span_join(cur, next)
        } else {
            out.push(cur)
            cur = next
        }
    }
    out.push(cur)
    out
}

fn area_primary(a: *AreaState) -> AreaSel {
    AreaSel { anchor: a.anchor, caret: a.caret, x: a.preferred ?? area_no_x, newest: a.newest == 0 }
}

fn area_list(a: *AreaState) -> AreaSel[] {
    var out: AreaSel[] = [area_primary(a)]
    for i, s in a.more {
        var t = s
        t.newest = a.newest == i + 1
        out.push(t)
    }
    out
}

fn area_unflag(mut sels: AreaSel[]) {
    for i in 0..sels.len {
        var s = sels[i]
        s.newest = false
        sels[i] = s
    }
}

fn area_rest(a: *AreaState) -> TextSelection[] {
    var out: TextSelection[] = []
    for s in a.more {
        out.push(TextSelection { anchor: s.anchor, caret: s.caret })
    }
    out
}

fn area_one(a: *AreaState) {
    a.more = []
    a.newest = -1
}

fn area_install(a: *AreaState, sels: AreaSel[]) {
    let merged = area_normalise(sels)
    let first = merged[0]
    a.anchor = first.anchor
    a.caret = first.caret
    a.preferred = if first.x >= 0.0 { some(first.x) } else { none }
    a.more = if merged.len > 1 { merged[1..] } else { [] }
    a.newest = -1
    for i, s in merged {
        if s.newest {
            a.newest = i
        }
    }
}

fn area_restore(a: *AreaState, primary: TextSelection, rest: TextSelection[]) {
    a.anchor = primary.anchor
    a.caret = primary.caret
    area_one(a)
    if rest.len == 0 {
        return
    }
    var sels: AreaSel[] = [AreaSel { anchor: primary.anchor, caret: primary.caret }]
    for s in rest {
        sels.push(AreaSel { anchor: s.anchor, caret: s.caret })
    }
    area_install(a, sels)
}

fn area_fit_all(a: *AreaState, src: LineSource, count: i64) {
    let sels = area_list(a)
    for i in 1..sels.len {
        var s = sels[i]
        s.anchor = area_fit(src, count, s.anchor)
        s.caret = area_fit(src, count, s.caret)
        sels[i] = s
    }
    area_install(a, sels)
}

fn area_touch(st: *State, a: *AreaState) {
    a.open = false
    a.reveal = true
    st.dirty = true
}

fn area_any_selecting(a: *AreaState) -> bool {
    if area_selecting(a) {
        return true
    }
    for s in a.more {
        if !span_empty(s) {
            return true
        }
    }
    false
}

fn area_sel_start(a: *AreaState, i: i64) -> TextPosition {
    if i == 0 { area_start(a) } else { span_start(a.more[i - 1]) }
}

fn area_sel_stop(a: *AreaState, i: i64) -> TextPosition {
    if i == 0 { area_stop(a) } else { span_stop(a.more[i - 1]) }
}

fn area_first_from(a: *AreaState, line: i64) -> i64 {
    var lo = 0
    var hi = a.more.len + 1
    for lo < hi {
        let mid = (lo + hi) / 2
        if area_sel_stop(a, mid).line < line {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

fn paint_bands(mut sc: scene.Scene, a: *AreaState, r: AreaRow, origin: f32, space: f32, tint: geometry.Color, scale: f32) {
    let n = a.more.len + 1
    var j = area_first_from(a, r.line)
    for j < n {
        let lo = area_sel_start(a, j)
        if lo.line > r.line {
            break
        }
        let hi = area_sel_stop(a, j)
        let band = area_selection_rect(lo, hi, a.line_height, r, origin, space)
        match band {
            some(rect) => solid(mut sc, rect, tint, scale)
            none => {}
        }
        j += 1
    }
}

fn paint_more_carets(mut sc: scene.Scene, a: *AreaState, rows: AreaRow[], origin: f32, ink: geometry.Color, scale: f32) {
    if rows.len == 0 {
        return
    }
    let top = rows[0].line
    let bottom = rows[rows.len - 1].line
    var j = area_first_from(a, top)
    if j < 1 {
        j = 1
    }
    let n = a.more.len + 1
    for j < n {
        let s = a.more[j - 1]
        if span_start(s).line > bottom {
            break
        }
        let line = s.caret.line
        let row = area_row_of(rows, line)
        if row >= 0 {
            let r = rows[row]
            let x = snapped(origin + area_x(r.shaped, clamped(s.caret.column, r.text.len)), scale)
            solid(mut sc, geometry.rect(x, r.top, 1.0, a.line_height), ink, scale)
        }
        j += 1
    }
}

fn area_reach(s: AreaSel, to: TextPosition, extend: bool) -> AreaSel {
    if extend {
        return AreaSel { anchor: s.anchor, caret: to }
    }
    AreaSel { anchor: to, caret: to }
}

fn area_move_each(st: *State, a: *AreaState, step: fn(AreaSel) -> AreaSel) {
    let first = step(area_primary(a))
    if a.more.len == 0 {
        a.anchor = first.anchor
        a.caret = first.caret
        a.preferred = if first.x >= 0.0 { some(first.x) } else { none }
        area_touch(st, a)
        return
    }
    var out: AreaSel[] = [first]
    for s in a.more {
        let moved = step(s)
        out.push(moved)
    }
    area_install(a, out)
    area_touch(st, a)
}

fn area_caret_x(st: *State, a: *AreaState, src: LineSource, s: AreaSel) -> f32 {
    if s.x >= 0.0 {
        return s.x
    }
    let text = src.line_text(s.caret.line)
    let shaped = area_shape_line(st, a, src, s.caret.line, text)
    area_x(shaped, clamped(s.caret.column, text.len))
}

fn area_line_target(st: *State, a: *AreaState, src: LineSource, count: i64, from: AreaSel, delta: i64, x: f32) -> TextPosition {
    let walked = area_walk(src, count, from.caret.line, delta)
    if walked.short {
        let edge = if delta < 0 { 0 } else { src.line_text(walked.line).len }
        return area_pos(walked.line, edge)
    }
    let text = src.line_text(walked.line)
    let shaped = area_shape_line(st, a, src, walked.line, text)
    area_pos(walked.line, area_column_at(shaped, x))
}

fn area_add_cursor(st: *State, a: *AreaState, e: Element, delta: i64) {
    let src = area_source(e)
    let count = area_count(src)
    var sels = area_list(a)
    area_unflag(mut sels)
    var out: AreaSel[] = []
    var added = false
    for s in sels {
        let x = area_caret_x(st, a, src, s)
        var kept = s
        kept.x = x
        out.push(kept)
        if area_walk(src, count, s.caret.line, delta).short {
            continue
        }
        let to = area_line_target(st, a, src, count, s, delta, x)
        out.push(AreaSel { anchor: to, caret: to, x: x, newest: true })
        added = true
    }
    if !added {
        return
    }
    area_install(a, out)
    area_touch(st, a)
}

fn area_blank_text(s: str) -> bool {
    for c in s {
        if !unicode.is_space(c) {
            return false
        }
    }
    true
}

fn area_word_at(src: LineSource, at: TextPosition) -> AreaSel? {
    let text = src.line_text(at.line)
    let col = clamped(at.column, text.len)
    var lo = word_start(text, col)
    var hi = word_stop(text, col)
    if area_blank_text(text[lo..hi]) && col > 0 {
        lo = word_start(text, col - 1)
        hi = word_stop(text, col - 1)
    }
    if area_blank_text(text[lo..hi]) {
        return none
    }
    some(AreaSel { anchor: area_pos(at.line, lo), caret: area_pos(at.line, hi) })
}

fn area_newest(sels: AreaSel[]) -> i64 {
    var out = sels.len - 1
    for i, s in sels {
        if s.newest {
            out = i
        }
    }
    out
}

fn area_overlaps(sels: AreaSel[], m: AreaSel) -> bool {
    let start = span_start(m)
    let stop = span_stop(m)
    var lo = 0
    var hi = sels.len
    for lo < hi {
        let mid = (lo + hi) / 2
        if area_before(start, span_stop(sels[mid])) {
            hi = mid
        } else {
            lo = mid + 1
        }
    }
    lo < sels.len && area_before(span_start(sels[lo]), stop)
}

fn area_candidate(text: str, parts: str[], from: i64) -> i64 {
    let head = parts[0]
    if parts.len == 1 {
        if from > text.len {
            return -1
        }
        let at = strs.index(text[from..], head)
        if at < 0 {
            return -1
        }
        return from + at
    }
    let at = text.len - head.len
    if at < from || at < 0 || text[at..] != head {
        return -1
    }
    at
}

fn area_match(src: LineSource, count: i64, parts: str[], text: str, line: i64, col: i64) -> AreaSel? {
    if area_snap(text, col) != col {
        return none
    }
    let n = parts.len
    if n == 1 {
        let stop = col + parts[0].len
        if area_snap(text, stop) != stop {
            return none
        }
        return some(AreaSel { anchor: area_pos(line, col), caret: area_pos(line, stop) })
    }
    let end_line = line + n - 1
    if end_line >= count {
        return none
    }
    for i in 1..n - 1 {
        if src.line_text(line + i) != parts[i] {
            return none
        }
    }
    let tail = parts[n - 1]
    let last = src.line_text(end_line)
    if last.len < tail.len || last[..tail.len] != tail || area_snap(last, tail.len) != tail.len {
        return none
    }
    some(AreaSel { anchor: area_pos(line, col), caret: area_pos(end_line, tail.len) })
}

fn area_next_match(src: LineSource, count: i64, parts: str[], taken: AreaSel[], line: i64, col: i64, last: i64) -> AreaSel? {
    var l = line
    var c = col
    for l <= last && l < count {
        let text = src.line_text(l)
        var at = area_candidate(text, parts, c)
        for at >= 0 {
            let m = area_match(src, count, parts, text, l, at)
            match m {
                some(found) => {
                    if !area_overlaps(taken, found) {
                        return m
                    }
                }
                none => {}
            }
            at = area_candidate(text, parts, at + 1)
        }
        l += 1
        c = 0
    }
    none
}

fn area_next_wrapping(src: LineSource, count: i64, parts: str[], taken: AreaSel[], start: TextPosition, stop: TextPosition) -> AreaSel? {
    let after = area_next_match(src, count, parts, taken, stop.line, stop.column, count - 1)
    match after {
        some(m) => return after
        none => {}
    }
    area_next_match(src, count, parts, taken, 0, 0, start.line)
}

fn area_needle(src: LineSource, sels: AreaSel[], pick: i64) -> AreaSel? {
    let cur = sels[pick]
    if span_empty(cur) {
        return area_word_at(src, cur.caret)
    }
    some(cur)
}

fn area_select_next(st: *State, a: *AreaState, e: Element) {
    let src = area_source(e)
    let count = area_count(src)
    let sels = area_list(a)
    if span_empty(sels[0]) {
        let out = slices.clone(sels)
        var changed = false
        for i in 0..sels.len {
            if !span_empty(sels[i]) {
                continue
            }
            let word = area_word_at(src, sels[i].caret)
            match word {
                some(w) => {
                    out[i] = w
                    changed = true
                }
                none => {}
            }
        }
        if changed {
            area_install(a, out)
            area_touch(st, a)
        }
        return
    }
    let pick = area_newest(sels)
    let cur = sels[pick]
    if span_empty(cur) {
        return
    }
    let start = span_start(cur)
    let stop = span_stop(cur)
    let needle = area_text_between(src, start, stop)
    let parts = strs.split_str(needle, "\n")
    let found = area_next_wrapping(src, count, parts, sels, start, stop)
    match found {
        some(m) => {
            var out = slices.clone(sels)
            area_unflag(mut out)
            var added = m
            added.newest = true
            out.push(added)
            area_install(a, out)
            area_touch(st, a)
        }
        none => {}
    }
}

fn area_select_all_occurrences(st: *State, a: *AreaState, e: Element) {
    let src = area_source(e)
    let count = area_count(src)
    let sels = area_list(a)
    let wanted = area_needle(src, sels, area_newest(sels))
    let cur = wanted ?? return
    let needle = area_text_between(src, span_start(cur), span_stop(cur))
    if needle.len == 0 {
        return
    }
    let parts = strs.split_str(needle, "\n")
    let taken: AreaSel[] = []
    var out: AreaSel[] = []
    var line = 0
    var col = 0
    for {
        let m = area_next_match(src, count, parts, taken, line, col, count - 1)
        match m {
            some(found) => {
                out.push(found)
                line = found.caret.line
                col = found.caret.column
            }
            none => {
                break
            }
        }
    }
    if out.len == 0 {
        return
    }
    area_install(a, out)
    area_touch(st, a)
}

fn area_slot_before(a: TextEdit, b: TextEdit) -> bool {
    if area_same(a.start, b.start) {
        return area_before(a.end, b.end)
    }
    area_before(a.start, b.start)
}

fn area_slots(a: *AreaState, make: fn(i64, AreaSel) -> TextEdit) -> TextEdit[] {
    let head = make(0, area_primary(a))
    var out: TextEdit[] = [head]
    for i, s in a.more {
        let slot = make(i + 1, s)
        out.push(slot)
    }
    out
}

fn area_slot_order(slots: TextEdit[]) -> i64[] {
    var ranked: i64[] = []
    var sorted = true
    for i in 0..slots.len {
        ranked.push(i)
        if i > 0 && area_slot_before(slots[i], slots[i - 1]) {
            sorted = false
        }
    }
    if !sorted {
        slices.sort_by(mut ranked, fn(x: i64, y: i64) -> bool { area_slot_before(slots[x], slots[y]) })
    }
    ranked
}

fn area_landings(edits: TextEdit[]) -> AreaLanding[] {
    var out: AreaLanding[] = []
    var shift_line = 0
    var carried_line = -1
    var shift_column = 0
    for ed in edits {
        let line = ed.start.line + shift_line
        var column = ed.start.column
        if ed.start.line == carried_line {
            column += shift_column
        }
        let start = area_pos(line, column)
        let stop = area_advance(start, ed.text)
        out.push(AreaLanding { start, stop })
        shift_line = stop.line - ed.end.line
        carried_line = ed.end.line
        shift_column = stop.column - ed.end.column
    }
    out
}

fn area_noop(ed: TextEdit) -> bool {
    area_same(ed.start, ed.end) && ed.text.len == 0
}

fn area_apply_all(src: LineSource, batch: TextEdit[]) {
    match src.edit_all {
        some(batched) => batched(batch)
        none => {
            for ed in batch {
                src.edit(ed)
            }
        }
    }
}

fn area_batch_ok(src: LineSource, count: i64, edits: TextEdit[], landings: AreaLanding[], tails: str[], head: str) -> bool {
    let last = edits.len - 1
    let now = area_count(src)
    if now != count + landings[last].stop.line - edits[last].end.line {
        return false
    }
    let first = src.line_text(landings[0].start.line)
    if first.len < landings[0].start.column || first[..landings[0].start.column] != head {
        return false
    }
    for k in 0..edits.len {
        let ed = edits[k]
        if area_noop(ed) {
            continue
        }
        let at = landings[k]
        if at.stop.line >= now {
            return false
        }
        if area_text_between(src, at.start, at.stop) != ed.text {
            return false
        }
        let line = src.line_text(at.stop.line)
        let tail = tails[k]
        let upto = at.stop.column + tail.len
        if line.len < upto || line[at.stop.column..upto] != tail {
            return false
        }
    }
    true
}

fn area_edit_each(st: *State, a: *AreaState, e: Element, slots: TextEdit[], kind: i64, after: TextSelection[]) {
    let src = area_source(e)
    let count = area_count(src)
    let had = area_any_selecting(a)
    let before = TextSelection { anchor: a.anchor, caret: a.caret }
    let before_more = area_rest(a)
    let ranked = area_slot_order(slots)
    var edits: TextEdit[] = []
    var owner: i64[] = []
    for _ in 0..slots.len {
        owner.push(0)
    }
    for k in ranked {
        let s = slots[k]
        let last = edits.len - 1
        if last >= 0 && area_before(s.start, edits[last].end) {
            var merged = edits[last]
            if area_before(merged.end, s.end) {
                merged.end = s.end
            }
            edits[last] = merged
        } else {
            edits.push(s)
        }
        owner[k] = edits.len - 1
    }
    var batch: TextEdit[] = []
    var changes: AreaChange[] = []
    var tails: str[] = []
    for k in 0..edits.len {
        let ed = edits[k]
        let line = src.line_text(ed.end.line)
        var stop = line.len
        if k + 1 < edits.len && edits[k + 1].start.line == ed.end.line {
            stop = edits[k + 1].start.column
        }
        let from = clamped(ed.end.column, line.len)
        tails.push(line[from..clamped(stop, line.len)])
    }
    var k = edits.len - 1
    for k >= 0 {
        let ed = edits[k]
        if !area_noop(ed) {
            let removed = area_text_between(src, ed.start, ed.end)
            batch.push(ed)
            changes.push(AreaChange { start: ed.start, removed, inserted: ed.text })
        }
        k -= 1
    }
    if batch.len == 0 {
        return
    }
    let first_line = src.line_text(edits[0].start.line)
    let head = first_line[..clamped(edits[0].start.column, first_line.len)]
    let landings = area_landings(edits)
    area_apply_all(src, batch)
    if !area_batch_ok(src, count, edits, landings, tails, head) {
        area_abandon_history(a)
        area_sync(a, src)
        a.preferred = none
        a.preedit = ""
        a.preedit_cursor = none
        a.reveal = true
        st.dirty = true
        return
    }
    if after.len > 0 {
        area_restore(a, after[0], after[1..])
        area_sync(a, src)
        a.preferred = none
    } else {
        var carets: AreaSel[] = []
        for i in 0..slots.len {
            let at = landings[owner[i]].stop
            carets.push(AreaSel { anchor: at, caret: at })
        }
        area_install(a, carets)
    }
    a.preedit = ""
    a.preedit_cursor = none
    a.reveal = true
    st.dirty = true
    area_record(st, a, changes, kind, before, before_more, had)
    a.redo = []
}

fn area_click_sel(src: LineSource, count: i64, to: TextPosition, clicks: i64) -> AreaSel {
    if clicks >= 3 {
        let text = src.line_text(to.line)
        let end = if to.line + 1 < count { area_pos(to.line + 1, 0) } else { area_pos(to.line, text.len) }
        return AreaSel { anchor: area_pos(to.line, 0), caret: end }
    }
    if clicks == 2 {
        let text = src.line_text(to.line)
        return AreaSel { anchor: area_pos(to.line, word_start(text, to.column)), caret: area_pos(to.line, word_stop(text, to.column)) }
    }
    AreaSel { anchor: to, caret: to }
}

fn area_add_press(st: *State, a: *AreaState, src: LineSource, count: i64, to: TextPosition, clicks: i64) {
    var picked = area_click_sel(src, count, to, clicks)
    picked.newest = true
    var base = area_list(a)
    area_unflag(mut base)
    var out = area_list(a)
    area_unflag(mut out)
    out.push(picked)
    a.drag_mode = area_drag_add
    a.drag_base = base
    a.drag_from = picked.anchor
    area_install(a, out)
}

fn area_rect_press(st: *State, a: *AreaState, src: LineSource, to: TextPosition) {
    var base: AreaSel[] = []
    if st.modifiers.control {
        base = area_list(a)
        area_unflag(mut base)
    }
    a.drag_mode = area_drag_rect
    a.drag_base = base
    a.drag_from = to
    a.drag_x = st.pointer.x - a.content.x + a.scroll_x
    area_rect_to(st, a, src, to.line, a.drag_x)
}

fn area_rect_to(st: *State, a: *AreaState, src: LineSource, line_b: i64, x_b: f32) {
    var sels = slices.clone(a.drag_base)
    let line_a = a.drag_from.line
    let top = if line_a < line_b { line_a } else { line_b }
    let bottom = if line_a < line_b { line_b } else { line_a }
    let left = if a.drag_x < x_b { a.drag_x } else { x_b }
    let right = if a.drag_x < x_b { x_b } else { a.drag_x }
    let forward = x_b >= a.drag_x
    for line in top..bottom + 1 {
        if area_hidden(src, line) {
            continue
        }
        let text = src.line_text(line)
        let shaped = area_shape_line(st, a, src, line, text)
        let near = area_column_at(shaped, left)
        let far = area_column_at(shaped, right)
        var s = AreaSel { anchor: area_pos(line, if forward { near } else { far }), caret: area_pos(line, if forward { far } else { near }) }
        s.newest = line == line_b
        sels.push(s)
    }
    area_install(a, sels)
    st.dirty = true
}

fn area_drag_extra(st: *State, a: *AreaState, src: LineSource) -> bool {
    if a.drag_mode == area_drag_add {
        let to = area_point(st, a, src, st.pointer.x, st.pointer.y)
        var sels = slices.clone(a.drag_base)
        sels.push(AreaSel { anchor: a.drag_from, caret: to, newest: true })
        area_install(a, sels)
        st.dirty = true
        return true
    }
    if a.drag_mode == area_drag_rect {
        var y = st.pointer.y
        if y > a.content.y + a.content.height - 1.0 {
            y = a.content.y + a.content.height - 1.0
        }
        let to = area_point(st, a, src, st.pointer.x, y)
        area_rect_to(st, a, src, to.line, st.pointer.x - a.content.x + a.scroll_x)
        return true
    }
    false
}
