import std/ui/geometry
import std/ui/layout
import std/ui/platform
import std/ui/scene

const drag_threshold_squared: f32 = 4.0

/// The kind of a drag of files from another program, as gpui's `ExternalPaths`. Such a drag carries no value: its `paths` hold the full paths of the files, and its preview is drawn by the system.
pub const external_paths = "external_paths"

/// What a drag carries: the application's `kind` and `value` for a drag started by `on_drag`, or `external_paths` and the file `paths` for a drag of files from another program.
///
/// Low has no runtime type identity, so where gpui picks the handlers a drag reaches by the Rust type of its value, a drag carries a kind string chosen by the application, and `on_drag_move`, `on_drop` and `drag_over` take the kind they accept. The value is a string: an application keeps larger values in its own state and drags a key to them.
pub struct DragPayload {
    /// The kind the drag was started with.
    pub kind: str
    /// The value the drag was started with, empty for a drag of files.
    pub value: str = ""
    /// The paths of the dragged files, empty for a drag started by `on_drag`.
    pub paths: str[] = []
}

/// A move of the pointer while a drag of a matching kind is active, as gpui's `DragMoveEvent`.
pub struct DragMoveEvent {
    /// Where the pointer is, in logical pixels from the top left of the window.
    pub position: geometry.Point = geometry.Point {}
    /// The border box of the element the handler is on, as drawn in the last frame and before any clipping.
    pub bounds: geometry.Rect = geometry.Rect {}
    /// The modifiers held at the last button or key event.
    pub modifiers: platform.Modifiers = platform.Modifiers {}
    /// What the drag carries.
    pub drag: DragPayload
}

/// A release of a drag over an element that accepts its kind, as gpui's `on_drop` receives it.
pub struct DropEvent {
    /// Where the pointer was, in logical pixels from the top left of the window.
    pub position: geometry.Point = geometry.Point {}
    /// The modifiers held.
    pub modifiers: platform.Modifiers = platform.Modifiers {}
    /// What the drag carried.
    pub drag: DragPayload
}

struct ActiveDrag {
    payload: DragPayload
    preview: fn(str) -> Element
    offset: geometry.Point
    cursor: platform.Cursor?
    external: bool
}

struct DragView {
    tree: layout.Tree
    laid: Laid
    walk: Walk
}

/// Returns `e` starting a drag when the primary button is pressed on it and the pointer then moves more than two logical pixels from the press, as gpui's `on_drag` does (`elements/div.rs:47`, `DRAG_THRESHOLD`). The drag carries `kind` and `value`, and `preview` builds the element drawn over everything else at the pointer, kept the distance from the pointer that the pointer had from the corner of `e` at the move that crossed the threshold, until the button is released. The preview takes no part in hit testing or focus: it is drawn without handlers, hover styles or focus, and is laid out with no limit on its width or height, so its text does not wrap. While the drag is active the pointer shows the `cursor` of `e`, or the arrow when `e` sets none.
///
/// While a drag is active no element is hovered, none is clicked, and no tooltip shows. The press that began it makes no click on `e` or on the elements around it. When several elements under the press have a drag, the innermost starts it. An element has one `on_drag`: with several, the first applies.
pub fn on_drag(e: Element, kind: str, value: str, preview: fn(str) -> Element) -> Element {
    listen(e, Drag(kind, value, preview))
}

/// Returns `e` running `f` for every move of the pointer while a drag of `kind` is active, wherever the pointer is, as gpui's `on_drag_move` does: the handler of an element that is not under the pointer runs too. The move that starts a drag does not run it. A handler that calls `stop_propagation` stops the move reaching the others and the handlers of elements under the pointer.
pub fn on_drag_move(e: Element, kind: str, f: fn(DragMoveEvent)) -> Element {
    listen(e, DragMove(kind, f))
}

/// Returns `e` running `f` when a drag of `kind` is released with the pointer over `e`, whether or not it started on `e`, as gpui's `on_drop` does. The release is offered to every element the pointer is over, from the last recorded to the first, as gpui runs each drop listener in bubble order when its hitbox is hovered (`elements/div.rs:2095`), so an element under a sibling that overlaps it without occluding it still takes the drag. The first with an `on_drop` of that kind takes the drag, even when its `can_drop` refuses it, in which case nothing runs and no other element is offered it. An element that occludes `e` takes the pointer away from it. The drop runs before the `on_mouse_up` handlers of its element, and when it runs `f` it stops propagation, so those and every handler further out are skipped. The drag ends on any button release whether or not an element took it.
pub fn on_drop(e: Element, kind: str, f: fn(DropEvent)) -> Element {
    listen(e, Drop(kind, f))
}

/// Returns `e` refusing the drags `f` returns `false` for, as gpui's `can_drop` does: `on_drop` on `e` does not run for them and `drag_over` does not restyle `e`. An element has one predicate: with several, the last applies, as in gpui where each call replaces the one before.
pub fn can_drop(e: Element, f: fn(DragPayload) -> bool) -> Element {
    listen(e, CanDrop(f))
}

/// Returns `e` drawn with `f` applied to its visual while a drag of `kind` that `can_drop` accepts is over it or over an element inside it, as gpui's `drag_over` does.
pub fn drag_over(e: Element, kind: str, f: fn(Visual) -> Visual) -> Element {
    when(e, DragHovered(kind), f)
}

/// Returns `true` while a drag is active: one `on_drag` started, or one of files from another program.
pub fn dragging(cx: Context) -> bool {
    is_dragging(cx.state)
}

/// Returns what the active drag carries, or `none` when no drag is active.
pub fn drag_payload(cx: Context) -> DragPayload? {
    match cx.state.dragged {
        some(d) => d.payload
        none => none
    }
}

/// Ends the active drag without dropping it, as gpui's `stop_active_drag` does, and returns whether one was active. Escape does not end a drag, as in gpui.
pub fn cancel_drag(cx: Context) -> bool {
    let was = is_dragging(cx.state)
    end_drag(cx.state)
    was
}

fn is_dragging(st: *State) -> bool {
    match st.dragged {
        some(d) => true
        none => false
    }
}

fn end_drag(st: *State) {
    if is_dragging(st) {
        st.dirty = true
    }
    st.dragged = none
    st.drag_view = none
}

fn no_preview(value: str) -> Element {
    div()
}

fn drag_of(e: Element) -> Listener? {
    for l in e.listeners {
        match l {
            Drag(kind, value, preview) => return l
            _ => {}
        }
    }
    none
}

fn begin_drag(st: *State, position: geometry.Point) -> bool {
    if is_dragging(st) || st.held != platform.Button.Left {
        return false
    }
    let dx = position.x - st.press_point.x
    let dy = position.y - st.press_point.y
    if dx * dx + dy * dy <= drag_threshold_squared {
        return false
    }
    var i = st.hitboxes.len - 1
    for i >= 0 {
        let h = st.hitboxes[i]
        if st.pressed[h.key] ?? false {
            match drag_of(h.element) {
                some(l) => {
                    match l {
                        Drag(kind, value, preview) => {
                            let offset = geometry.point(position.x - h.rect.x, position.y - h.rect.y)
                            st.dragged = ActiveDrag { payload: DragPayload { kind, value }, preview, offset, cursor: h.element.cursor, external: false }
                            st.pressed = [:]
                            st.dirty = true
                            return true
                        }
                        _ => {}
                    }
                }
                none => {}
            }
        }
        i -= 1
    }
    false
}

fn run_drag_moves(st: *State, event: MouseMoveEvent) {
    let d = st.dragged ?? return
    var i = 0
    for i < st.hitboxes.len && !st.stopped {
        let h = st.hitboxes[i]
        for l in h.element.listeners {
            match l {
                DragMove(kind, f) => {
                    if kind == d.payload.kind {
                        f(DragMoveEvent { position: event.position, bounds: h.rect, modifiers: event.modifiers, drag: d.payload })
                    }
                }
                _ => {}
            }
        }
        i += 1
    }
}

fn accepts(e: Element, payload: DragPayload) -> bool {
    var i = e.listeners.len - 1
    for i >= 0 {
        match e.listeners[i] {
            CanDrop(f) => return f(payload)
            _ => {}
        }
        i -= 1
    }
    true
}

fn drop_on(st: *State, e: Element, event: MouseUpEvent) {
    let d = st.dragged ?? return
    for l in e.listeners {
        match l {
            Drop(kind, f) => {
                if kind == d.payload.kind {
                    st.dragged = none
                    st.drag_view = none
                    st.dirty = true
                    if accepts(e, d.payload) {
                        f(DropEvent { position: event.position, modifiers: event.modifiers, drag: d.payload })
                        st.stopped = true
                    }
                    return
                }
            }
            _ => {}
        }
    }
}

fn drag_hovers(st: *State, at: i64, kind: str) -> bool {
    let d = st.dragged ?? return false
    st.hits[at] && d.payload.kind == kind && accepts(st.hitboxes[at].element, d.payload)
}

fn file_drag_entered(st: *State, x: f32, y: f32, paths: str[]) {
    if !is_dragging(st) {
        st.dragged = ActiveDrag { payload: DragPayload { kind: external_paths, paths }, preview: no_preview, offset: geometry.point(x, y), cursor: none, external: true }
    }
    file_pointer_moved(st, x, y)
}

fn file_drag_moved(st: *State, x: f32, y: f32) {
    let moved = !st.pointer_inside || x != st.pointer.x || y != st.pointer.y
    if moved {
        file_pointer_moved(st, x, y)
    }
}

fn file_pointer_moved(st: *State, x: f32, y: f32) {
    move_pointer(st, x, y)
    mouse_move(st, MouseMoveEvent { position: st.pointer, pressed_button: platform.Button.Left })
}

fn file_dropped(st: *State, x: f32, y: f32) {
    move_pointer(st, x, y)
    mouse_up(st, platform.ButtonEvent { button: platform.Button.Left, x, y, clicks: 1 })
}

fn file_drag_exited(st: *State) {
    end_drag(st)
    pointer_left(st)
}

fn inert(e: Element) -> Element {
    var out = e
    out.id = ""
    out.listeners = []
    out.conditionals = []
    out.focusable = false
    out.cursor = none
    out.key_context = none
    out.behavior = Normal
    if out.style.overflow_x == Scroll {
        out.style.overflow_x = Hidden
    }
    if out.style.overflow_y == Scroll {
        out.style.overflow_y = Hidden
    }
    if is_field(e) {
        out.kind = Text
    }
    var kids: Element[] = []
    for c in e.children {
        kids.push(inert(c))
    }
    out.children = kids
    out
}

fn prepaint_drag(st: *State, scale: f32) {
    st.drag_view = none
    let d = st.dragged ?? return
    if d.external {
        return
    }
    let e = inert(d.preview(d.payload.value))
    var t = layout.tree(scale)
    let laid = build_laid(st, mut t, e)
    layout.compute(mut t, laid.node, geometry.size(layout.unbounded, layout.unbounded))
    let r = layout.rect(t, laid.node)
    let origin = geometry.point(st.pointer.x - d.offset.x, st.pointer.y - d.offset.y)
    let walk = Walk { parent: -1, clip: st.viewport, shift: geometry.point(origin.x - r.x, origin.y - r.y), text: default_text_style(st), scale }
    prepaint(st, t, laid, "drag", walk)
    prepaint_deferred(st)
    st.drag_view = DragView { tree: t, laid, walk }
}

fn paint_drag(st: *State, mut sc: scene.Scene, scale: f32) {
    let v = st.drag_view ?? return
    paint(st, v.tree, mut sc, v.laid, v.walk, default_text_style(st), scale)
    paint_deferred(st, mut sc, scale)
}
