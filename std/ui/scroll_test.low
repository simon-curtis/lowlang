import std/testing
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn tile(color: u32, px: f32) -> Element {
    div().height(px).shrink(0.0).background(rgb(color))
}

fn scroll_column() -> Element {
    div().id("list").column().size(100.0, 50.0).overflow_y_scroll().children() {
        tile(0xff0000, 30.0),
        tile(0x00ff00, 30.0),
        tile(0x0000ff, 30.0),
    }
}

fn wheel(cx: Context, x: f32, y: f32, dy: f32) {
    dispatch(cx, platform.Event.PointerMoved(x, y))
    dispatch(cx, platform.Event.Scrolled(0.0, dy))
}

fn test_a_scrolling_container_clips_and_keeps_its_children_at_full_size(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let sc = shot(cx, scroll_column)
    testing.equal(t, sc.quads.len, 2)
    testing.equal(t, sc.quads[0].bounds.height, 30.0)
    testing.equal(t, sc.quads[1].bounds.y, 30.0)
    same_rect(t, sc.quads[0].clip, geometry.rect(0.0, 0.0, 200.0, 50.0))
    same_rect(t, sc.quads[1].clip, geometry.rect(0.0, 0.0, 200.0, 50.0))
    testing.equal(t, scroll_offset(cx, "list").y, 0.0)
}

fn test_the_wheel_scrolls_children_and_stops_at_the_ends(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, scroll_column)
    wheel(cx, 10.0, 10.0, 30.0)
    testing.is_true(t, frame_due(cx))
    testing.equal(t, scroll_offset(cx, "list").y, 30.0)
    let sc = shot(cx, scroll_column)
    testing.equal(t, sc.quads.len, 2)
    testing.equal(t, sc.quads[0].bounds.y, 0.0)
    testing.equal(t, sc.quads[1].bounds.y, 30.0)
    wheel(cx, 10.0, 10.0, 500.0)
    testing.equal(t, scroll_offset(cx, "list").y, 40.0)
    wheel(cx, 10.0, 10.0, -500.0)
    testing.equal(t, scroll_offset(cx, "list").y, 0.0)
}

fn test_the_wheel_does_nothing_away_from_the_container(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, scroll_column)
    wheel(cx, 150.0, 10.0, 30.0)
    testing.equal(t, scroll_offset(cx, "list").y, 0.0)
    wheel(cx, 10.0, 80.0, 30.0)
    testing.equal(t, scroll_offset(cx, "list").y, 0.0)
}

fn test_content_that_fits_does_not_scroll(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("short").column().size(100.0, 50.0).overflow_y_scroll().child(tile(0xff0000, 20.0))
    }
    shot(cx, view)
    wheel(cx, 10.0, 10.0, 30.0)
    testing.equal(t, scroll_offset(cx, "short").y, 0.0)
}

fn test_a_horizontal_container_scrolls_along_x(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("strip").row().size(100.0, 50.0).overflow_x_scroll().children() {
            div().width(80.0).shrink(0.0).background(rgb(0xff0000)),
            div().width(80.0).shrink(0.0).background(rgb(0x00ff00)),
        }
    }
    shot(cx, view)
    wheel(cx, 10.0, 10.0, 30.0)
    testing.equal(t, scroll_offset(cx, "strip").y, 0.0)
    dispatch(cx, platform.Event.Scrolled(25.0, 0.0))
    testing.equal(t, scroll_offset(cx, "strip").x, 25.0)
    dispatch(cx, platform.Event.Scrolled(500.0, 0.0))
    testing.equal(t, scroll_offset(cx, "strip").x, 60.0)
    let sc = shot(cx, view)
    testing.equal(t, sc.quads[0].bounds.x, -60.0)
    testing.equal(t, sc.quads[1].bounds.x, 20.0)
}

fn test_a_container_at_its_limit_hands_the_wheel_to_the_next_one_out(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("page").column().size(100.0, 100.0).overflow_y_scroll().children() {
            div().id("inner").column().height(50.0).shrink(0.0).overflow_y_scroll().children() {
                tile(0xff0000, 40.0),
                tile(0x00ff00, 40.0),
            },
            tile(0x0000ff, 100.0),
        }
    }
    shot(cx, view)
    wheel(cx, 10.0, 10.0, 30.0)
    testing.equal(t, scroll_offset(cx, "inner").y, 30.0)
    testing.equal(t, scroll_offset(cx, "page").y, 0.0)
    dispatch(cx, platform.Event.Scrolled(0.0, 30.0))
    testing.equal(t, scroll_offset(cx, "inner").y, 30.0)
    testing.equal(t, scroll_offset(cx, "page").y, 30.0)
}

fn test_on_scroll_wheel_sees_the_event_and_a_moving_container_stops_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let seen = signal[f32](cx, 0.0)
    let at = signal[f32](cx, 0.0)
    let view = fn() -> Element {
        div().id("list").column().size(100.0, 50.0).overflow_y_scroll().on_scroll_wheel(fn(e: ScrollEvent) {
            set(seen, get(seen) + e.dy)
            set(at, e.position.y)
        }).children() {
            tile(0xff0000, 30.0),
            tile(0x00ff00, 30.0),
        }
    }
    shot(cx, view)
    wheel(cx, 10.0, 20.0, 5.0)
    testing.equal(t, get(seen), 5.0)
    testing.equal(t, get(at), 20.0)
    testing.equal(t, scroll_offset(cx, "list").y, 5.0)
}

fn test_scrolled_out_children_do_not_take_the_pointer(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = fn() -> Element {
        div().id("list").column().size(100.0, 50.0).overflow_y_scroll().children() {
            tile(0xff0000, 30.0),
            tile(0x00ff00, 30.0),
            tile(0x0000ff, 30.0).on_click(fn(c: ClickEvent) { set(clicks, get(clicks) + 1) }),
        }
    }
    shot(cx, view)
    dispatch(cx, platform.Event.PointerMoved(10.0, 70.0))
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: 70.0 }))
    dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: 70.0 }))
    testing.equal(t, get(clicks), 0)
    wheel(cx, 10.0, 10.0, 30.0)
    shot(cx, view)
    dispatch(cx, platform.Event.PointerMoved(10.0, 40.0))
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: 40.0 }))
    dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: 40.0 }))
    testing.equal(t, get(clicks), 1)
    dispatch(cx, platform.Event.PointerMoved(10.0, 60.0))
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: 60.0 }))
    dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: 10.0, y: 60.0 }))
    testing.equal(t, get(clicks), 1)
}

fn test_scroll_to_is_kept_within_the_content_by_the_next_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    shot(cx, scroll_column)
    scroll_to(cx, "list", geometry.point(0.0, 500.0))
    testing.is_true(t, frame_due(cx))
    let sc = shot(cx, scroll_column)
    testing.equal(t, scroll_offset(cx, "list").y, 40.0)
    testing.equal(t, sc.quads.len, 2)
    testing.equal(t, sc.quads[1].bounds.y, 20.0)
}

fn test_the_offset_follows_the_id_when_the_tree_moves_the_container(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let lower = signal(cx, false)
    let view = fn() -> Element {
        if get(lower) {
            div().column().children() { tile(0x808080, 10.0), scroll_column() }
        } else {
            div().column().children() { scroll_column(), tile(0x808080, 10.0) }
        }
    }
    shot(cx, view)
    wheel(cx, 10.0, 10.0, 30.0)
    set(lower, true)
    shot(cx, view)
    testing.equal(t, scroll_offset(cx, "list").y, 30.0)
}

fn test_overflow_hidden_clips_without_scrolling(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("box").column().size(100.0, 50.0).overflow_hidden().children() {
            tile(0xff0000, 30.0),
            tile(0x00ff00, 30.0),
        }
    }
    let sc = shot(cx, view)
    same_rect(t, sc.quads[1].clip, geometry.rect(0.0, 0.0, 100.0, 50.0))
    wheel(cx, 10.0, 10.0, 30.0)
    testing.equal(t, scroll_offset(cx, "box").y, 0.0)
}
