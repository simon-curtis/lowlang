import std/testing
import std/ui/geometry
import std/ui/platform

fn to_red(v: Visual) -> Visual {
    v.with_background(rgb(0xff0000))
}

fn shown(v: Visual) -> Visual {
    v.with_visible(true)
}

fn list_row(button: Element) -> Element {
    div().group("row").row().size(200.0, 40.0).items_center().justify_end().child(button)
}

fn delete_button() -> Element {
    div().size(40.0, 30.0).background(rgb(0x0000ff))
}

fn test_group_hover_styles_a_child_while_the_pointer_is_anywhere_over_the_group(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { list_row(delete_button().group_hover("row", to_red)) }
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)

    move_to(cx, 10.0, 10.0)
    let beside = shot(cx, view)
    testing.equal(t, beside.quads[0].background.r, 1.0)
    testing.equal(t, beside.quads[0].background.b, 0.0)

    move_to(cx, 180.0, 20.0)
    testing.equal(t, shot(cx, view).quads[0].background.r, 1.0)

    move_to(cx, 100.0, 80.0)
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)

    move_to(cx, 10.0, 10.0)
    shot(cx, view)
    dispatch(cx, platform.Event.PointerLeft)
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)
}

fn test_a_group_under_an_occluding_element_is_not_group_hovered(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(200.0, 80.0).children() {
            list_row(delete_button().group_hover("row", to_red)),
            div().absolute().top(0.0).left(0.0).size(100.0, 40.0).background(rgb(0x00ff00)).occlude(),
        }
    }
    shot(cx, view)

    move_to(cx, 10.0, 10.0)
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)

    move_to(cx, 120.0, 20.0)
    testing.equal(t, shot(cx, view).quads[0].background.r, 1.0)
}

fn test_a_group_with_no_other_listener_makes_a_frame_due_when_the_pointer_enters_and_leaves(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { list_row(delete_button().group_hover("row", to_red)) }
    shot(cx, view)
    testing.is_false(t, frame_due(cx))

    move_to(cx, 10.0, 10.0)
    testing.is_true(t, frame_due(cx))
    shot(cx, view)

    move_to(cx, 20.0, 12.0)
    testing.is_false(t, frame_due(cx))

    move_to(cx, 100.0, 80.0)
    testing.is_true(t, frame_due(cx))
}

fn test_the_nearest_group_of_a_name_binds_the_style(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().group("g").column().size(200.0, 100.0).children() {
            div().group("g").row().size(200.0, 40.0).child(div().size(20.0, 20.0).background(rgb(0x0000ff)).group_hover("g", to_red)),
            div().size(20.0, 20.0).background(rgb(0x0000ff)).group_hover("g", to_red),
        }
    }
    let rest = shot(cx, view)
    testing.equal(t, rest.quads.len, 2)
    testing.equal(t, rest.quads[0].background.b, 1.0)
    testing.equal(t, rest.quads[1].background.b, 1.0)

    move_to(cx, 100.0, 80.0)
    let outer_only = shot(cx, view)
    testing.equal(t, outer_only.quads[0].background.b, 1.0)
    testing.equal(t, outer_only.quads[1].background.r, 1.0)

    move_to(cx, 100.0, 10.0)
    let inner = shot(cx, view)
    testing.equal(t, inner.quads[0].background.r, 1.0)
    testing.equal(t, inner.quads[1].background.r, 1.0)
}

fn test_a_style_naming_no_enclosing_group_never_applies(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().group("other").column().size(200.0, 100.0).children() {
            div().size(20.0, 20.0).background(rgb(0x0000ff)).group_hover("row", to_red),
            div().group("self").size(20.0, 20.0).background(rgb(0x0000ff)).group_hover("self", to_red),
        }
    }
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    let over = shot(cx, view)
    testing.equal(t, over.quads[0].background.b, 1.0)
    testing.equal(t, over.quads[1].background.b, 1.0)

    move_to(cx, 10.0, 30.0)
    let over_self = shot(cx, view)
    testing.equal(t, over_self.quads[0].background.b, 1.0)
    testing.equal(t, over_self.quads[1].background.b, 1.0)
}

fn test_group_hover_follows_the_clipped_bounds_of_the_group(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let tall_window = geometry.size(200.0, 300.0)
    let view = fn() -> Element {
        let leaf = div().size(20.0, 20.0).background(rgb(0x0000ff)).group_hover("tall", to_red)
        let tall = div().group("tall").size(100.0, 300.0).flex_none().child(leaf)
        div().overflow_hidden().size(100.0, 100.0).child(tall)
    }
    frame(cx, view, tall_window, 1.0)
    move_to(cx, 50.0, 150.0)
    testing.equal(t, frame(cx, view, tall_window, 1.0).quads[0].background.b, 1.0)
    move_to(cx, 50.0, 50.0)
    testing.equal(t, frame(cx, view, tall_window, 1.0).quads[0].background.r, 1.0)
}

fn test_an_invisible_child_draws_while_the_group_is_hovered(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { list_row(delete_button().invisible().group_hover("row", shown)) }
    testing.equal(t, shot(cx, view).quads.len, 0)

    move_to(cx, 10.0, 10.0)
    let over = shot(cx, view)
    testing.equal(t, over.quads.len, 1)
    same_rect(t, over.quads[0].bounds, geometry.rect(160.0, 5.0, 40.0, 30.0))

    move_to(cx, 100.0, 80.0)
    testing.equal(t, shot(cx, view).quads.len, 0)
}

fn test_a_hidden_element_keeps_its_space_and_draws_nothing_below_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().row().children() {
            div().size(30.0, 30.0).background(rgb(0xff0000)).invisible().child(div().size(10.0, 10.0).background(rgb(0x00ff00)).visible()),
            div().size(30.0, 30.0).background(rgb(0x0000ff)),
        }
    }
    let sc = shot(cx, view)
    testing.equal(t, sc.quads.len, 1)
    same_rect(t, sc.quads[0].bounds, geometry.rect(30.0, 0.0, 30.0, 30.0))
}

fn test_hidden_elements_take_no_clicks_and_show_no_cursor(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let button = delete_button().invisible().group_hover("row", shown).on_click(count_up(clicks)).cursor(platform.Cursor.Pointer)
    let view = fn() -> Element { list_row(button) }
    shot(cx, view)

    click(cx, 180.0, 20.0)
    testing.equal(t, get(clicks), 0)
    testing.is_true(t, pointer_cursor(cx) == platform.Cursor.Arrow)

    shot(cx, view)
    click(cx, 180.0, 20.0)
    testing.equal(t, get(clicks), 1)
    testing.is_true(t, pointer_cursor(cx) == platform.Cursor.Pointer)
}

fn test_a_hidden_element_lets_the_pointer_reach_what_it_covers(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let under = signal(cx, 0)
    let over = signal(cx, 0)
    let view = fn() -> Element {
        div().relative().size(100.0, 100.0).children() {
            div().id("under").size(100.0, 100.0).focusable().cursor(platform.Cursor.Pointer).on_click(count_up(under)),
            div().absolute().top(0.0).left(0.0).size(100.0, 100.0).invisible().on_click(count_up(over)),
        }
    }
    shot(cx, view)
    click(cx, 20.0, 20.0)
    testing.equal(t, get(under), 1)
    testing.equal(t, get(over), 0)
    testing.equal(t, focused(cx), "under")
    testing.is_true(t, pointer_cursor(cx) == platform.Cursor.Pointer)
}

fn test_the_children_of_a_hidden_element_are_hidden_with_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = fn() -> Element {
        div().invisible().size(100.0, 100.0).child(div().size(50.0, 50.0).on_click(count_up(clicks)))
    }
    shot(cx, view)
    click(cx, 10.0, 10.0)
    testing.equal(t, get(clicks), 0)
}

fn test_a_hidden_element_does_not_shift_the_hitboxes_after_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = fn() -> Element {
        div().row().children() {
            div().invisible().size(30.0, 30.0).child(div().size(10.0, 10.0).on_click(fn(e: ClickEvent) {})),
            div().size(30.0, 30.0).background(rgb(0x0000ff)).hover(to_red).on_click(count_up(clicks)),
        }
    }
    shot(cx, view)
    move_to(cx, 40.0, 10.0)
    testing.equal(t, shot(cx, view).quads[0].background.r, 1.0)
    click(cx, 40.0, 10.0)
    testing.equal(t, get(clicks), 1)
}

fn test_group_active_applies_only_while_pressed_on_the_group(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element { list_row(delete_button().group_active("row", to_red)) }
    shot(cx, view)

    move_to(cx, 10.0, 10.0)
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)

    press(cx, 10.0, 10.0)
    testing.equal(t, shot(cx, view).quads[0].background.r, 1.0)

    release(cx, 10.0, 10.0)
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)

    press(cx, 100.0, 80.0)
    move_to(cx, 10.0, 10.0)
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)
    release(cx, 10.0, 10.0)

    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Right, x: 10.0, y: 10.0 }))
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)
}

fn test_group_hover_and_hover_apply_in_the_order_they_were_built(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let to_green = fn(v: Visual) -> Visual { v.with_background(rgb(0x00ff00)) }
    let first = fn() -> Element { list_row(delete_button().group_hover("row", to_red).hover(to_green)) }
    let second = fn() -> Element { list_row(delete_button().hover(to_green).group_hover("row", to_red)) }
    shot(cx, first)
    move_to(cx, 180.0, 20.0)
    testing.equal(t, shot(cx, first).quads[0].background.g, 1.0)
    testing.equal(t, shot(cx, second).quads[0].background.r, 1.0)
}

fn test_with_opacity_fades_the_colours_of_the_visual(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let half = fn(v: Visual) -> Visual { v.with_opacity(0.5) }
    let view = fn() -> Element { list_row(delete_button().group_hover("row", half)) }
    testing.equal(t, shot(cx, view).quads[0].background.a, 1.0)
    move_to(cx, 10.0, 10.0)
    testing.equal(t, shot(cx, view).quads[0].background.a, 0.5)
}
