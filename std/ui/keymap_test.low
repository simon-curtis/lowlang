import std/testing
import std/ui/platform

fn bound(keys: str, action: str, context: str) -> KeyBinding {
    key_binding(keys, action, context) catch {
        e => panic("cannot bind {keys}")
    }
}

fn contexts_of(sources: str[]) -> KeyContext[] {
    var out: KeyContext[] = []
    for s in sources {
        let c = parse_key_context(s) catch {
            e => panic("cannot read context {s}")
        }
        out.push(c)
    }
    out
}

fn typed_of(keys: str) -> platform.KeyEvent[] {
    events_of(bound(keys, "x", "").keystrokes)
}

fn found_actions(keymap: KeyBinding[], keys: str, sources: str[]) -> str {
    let m = bindings_for_input(keymap, typed_of(keys), contexts_of(sources))
    var out = if m.pending { "pending" } else { "done" }
    for b in m.bindings {
        out = "{out} {b.action}"
    }
    out
}

fn evaluates(source: str, sources: str[]) -> bool {
    let p = parse_predicate(source) catch {
        e => panic("cannot read predicate {source}")
    }
    let cs = contexts_of(sources)
    holds_in(p, p.root, cs, cs)
}

fn refused(source: str) -> str {
    let p = parse_predicate(source) catch {
        e => {
            return match e {
                InvalidContext(text, reason) => reason
                InvalidKeystroke(text) => "keystroke"
            }
        }
    }
    "accepted {p.terms.len}"
}

fn char_key(text: str, modifiers: platform.Modifiers) -> platform.KeyEvent {
    platform.KeyEvent { key: platform.Key.Character(text), text, modifiers }
}

fn test_bindings_are_enabled_at_the_depth_their_predicate_matches(t: *testing.T) {
    let global = bound("ctrl-a", "alpha", "")
    let pane = bound("ctrl-a", "beta", "pane")
    let full = bound("ctrl-a", "gamma", "editor && mode==full")
    testing.equal(t, depth_of(global.predicate, contexts_of([])), 0)
    testing.equal(t, depth_of(global.predicate, contexts_of(["terminal"])), 1)
    testing.equal(t, depth_of(pane.predicate, contexts_of(["barf x=y"])), -1)
    testing.equal(t, depth_of(pane.predicate, contexts_of(["pane x=y"])), 1)
    testing.equal(t, depth_of(full.predicate, contexts_of(["editor"])), -1)
    testing.equal(t, depth_of(full.predicate, contexts_of(["editor mode=full"])), 1)
}

fn test_a_deeper_context_wins_over_a_later_binding(t: *testing.T) {
    let keymap = [bound("ctrl-a", "beta", "pane"), bound("ctrl-a", "gamma", "editor")]
    testing.equal(t, found_actions(keymap, "ctrl-a", ["pane", "editor"]), "done gamma beta")
    let same = [bound("ctrl-r", "alpha", "Workspace"), bound("ctrl-r", "beta", "Editor")]
    testing.equal(t, found_actions(same, "ctrl-r", ["Workspace", "Editor"]), "done beta alpha")
}

fn test_an_empty_action_unbinds_where_its_predicate_matches(t: *testing.T) {
    let keymap = [
        bound("ctrl-a", "alpha", "editor"),
        bound("ctrl-b", "alpha", "editor"),
        bound("ctrl-a", "", "editor && mode==full"),
        bound("ctrl-b", "", ""),
    ]
    testing.equal(t, found_actions(keymap, "ctrl-a", ["barf"]), "done")
    testing.equal(t, found_actions(keymap, "ctrl-a", ["editor"]), "done alpha")
    testing.equal(t, found_actions(keymap, "ctrl-a", ["editor mode=full"]), "done")
    testing.equal(t, found_actions(keymap, "ctrl-b", ["barf"]), "done")
    let wrong_level = [bound("ctrl-x", "alpha", "editor"), bound("ctrl-x", "", "workspace")]
    testing.equal(t, found_actions(wrong_level, "ctrl-x", ["workspace", "editor"]), "done alpha")
    let deeper = [bound("ctrl-x", "alpha", "workspace"), bound("ctrl-x", "", "editor")]
    testing.equal(t, found_actions(deeper, "ctrl-x", ["workspace", "editor"]), "done")
}

fn test_an_unbound_chord_is_not_pending(t: *testing.T) {
    let keymap = [bound("space w w", "alpha", "workspace"), bound("space w w", "", "editor")]
    testing.equal(t, found_actions(keymap, "space", ["workspace"]), "pending")
    testing.equal(t, found_actions(keymap, "space", ["workspace", "editor"]), "done")
    testing.equal(t, found_actions(keymap, "space w", ["workspace"]), "pending")
    testing.equal(t, found_actions(keymap, "space w w", ["workspace"]), "done alpha")
    testing.equal(t, found_actions(keymap, "space w w", ["workspace", "editor"]), "done")
    let after = [bound("space w w", "alpha", "workspace"), bound("space w w", "", "editor"), bound("space w x", "alpha", "editor")]
    testing.equal(t, found_actions(after, "space", ["workspace", "editor"]), "pending")
}

fn test_a_chord_prefix_and_a_shorter_binding_follow_the_order_added(t: *testing.T) {
    let unbound = [bound("ctrl-w left", "alpha", "editor"), bound("ctrl-w", "", "editor")]
    testing.equal(t, found_actions(unbound, "ctrl-w", ["editor"]), "pending")
    let later = [bound("ctrl-w left", "alpha", "editor"), bound("ctrl-w", "beta", "editor")]
    testing.equal(t, found_actions(later, "ctrl-w", ["editor"]), "done beta")
    let stack = ["Workspace", "Pane", "Editor vim_mode=normal"]
    let enabled = [bound("ctrl-x", "beta", "vim_mode == normal"), bound("ctrl-x 0", "alpha", "Workspace")]
    testing.equal(t, found_actions(enabled, "ctrl-x", stack), "pending beta")
    let overriding = [bound("ctrl-x 0", "alpha", "Workspace"), bound("ctrl-x", "beta", "vim_mode == normal")]
    testing.equal(t, found_actions(overriding, "ctrl-x", stack), "done beta")
}

fn test_key_contexts_read_identifiers_and_pairs(t: *testing.T) {
    let c = contexts_of(["  baz foo   =   bar baz"])[0]
    testing.equal(t, c.entries.len, 2)
    testing.equal(t, c.entries[0].key, "baz")
    testing.equal(t, c.entries[1].key, "foo")
    testing.equal(t, c.entries[1].value ?? "", "bar")
    testing.equal(t, refused("c == !d"), "operands of == and != must be identifiers")
    testing.equal(t, refused("a &&"), "unexpected end")
    testing.equal(t, refused("(a"), "expected a )")
    testing.equal(t, refused("a $"), "unexpected character")
}

fn test_predicates_join_with_gpui_precedence(t: *testing.T) {
    testing.equal(t, evaluates("a || !b && c", ["a"]), true)
    testing.equal(t, evaluates("a || !b && c", ["c"]), true)
    testing.equal(t, evaluates("a || !b && c", ["b c"]), false)
    testing.equal(t, evaluates("a && (b == c || d != e)", ["a b=c"]), true)
    testing.equal(t, evaluates("a && (b == c || d != e)", ["a d=e"]), false)
    testing.equal(t, evaluates("a && (b == c || d != e)", ["a"]), true)
}

fn test_the_child_operator_matches_a_context_inside_another(t: *testing.T) {
    testing.equal(t, evaluates("parent > child", ["parent", "child"]), true)
    testing.equal(t, evaluates("parent > child", ["grandparent", "parent", "child"]), true)
    testing.equal(t, evaluates("parent > child", ["other", "child"]), false)
    testing.equal(t, evaluates("parent > child", ["parent", "other", "child"]), true)
    testing.equal(t, evaluates("parent > child", []), false)
    testing.equal(t, evaluates("parent > child", ["child"]), false)
    testing.equal(t, evaluates("child > child", ["child"]), false)
    testing.equal(t, evaluates("child > child", ["child", "child"]), true)
    testing.equal(t, evaluates("Workspace > Pane > Editor", ["Workspace", "Pane", "Editor"]), true)
    testing.equal(t, evaluates("Pane > (Pane > Editor)", ["Workspace", "Pane", "Editor"]), false)
}

fn test_not_holds_only_when_no_context_matches(t: *testing.T) {
    testing.equal(t, evaluates("!editor", ["workspace"]), true)
    testing.equal(t, evaluates("!editor", ["editor"]), false)
    testing.equal(t, evaluates("!editor", ["editor", "workspace"]), false)
    testing.equal(t, evaluates("!editor", ["workspace", "editor"]), false)
    testing.equal(t, evaluates("!(mode == full)", ["mode=full"]), false)
    testing.equal(t, evaluates("!(mode == full)", ["mode=partial"]), true)
    testing.equal(t, evaluates("!(parent > child)", ["parent", "child"]), false)
    testing.equal(t, evaluates("parent > !child", ["parent", "child"]), false)
    testing.equal(t, evaluates("Pane > !Workspace", ["Pane", "Editor"]), true)
    testing.equal(t, evaluates("Pane > !Workspace", ["Pane", "Workspace"]), false)
    testing.equal(t, evaluates("!!editor", ["editor"]), true)
}

fn test_keystrokes_read_modifiers_and_keys(t: *testing.T) {
    testing.equal(t, binding_text(bound("ctrl-shift-k", "x", "")), "ctrl-shift-k")
    testing.equal(t, binding_text(bound("shift-ctrl-K", "x", "")), "ctrl-shift-k")
    testing.equal(t, binding_text(bound("ctrl-K", "x", "")), "ctrl-shift-k")
    testing.equal(t, binding_text(bound("ctrl--", "x", "")), "ctrl--")
    testing.equal(t, binding_text(bound("-", "x", "")), "-")
    testing.equal(t, binding_text(bound("secondary-s  alt-F4", "x", "")), "ctrl-s alt-f4")
    testing.equal(t, binding_text(bound("cmd-p win-q", "x", "")), "super-p super-q")
    testing.equal(t, rejects("fn-a", ""), true)
    testing.equal(t, rejects("ctrl-", ""), true)
    testing.equal(t, rejects("a-b", ""), true)
    testing.equal(t, rejects("  ", ""), true)
    testing.equal(t, rejects("a", "a &&"), true)
    testing.equal(t, rejects("a", "  "), false)
}

fn rejects(keys: str, context: str) -> bool {
    let b = key_binding(keys, "x", context) catch {
        e => return true
    }
    b.keystrokes.len == 0
}

fn test_typed_keys_match_as_the_keyboard_reports_them(t: *testing.T) {
    let ctrl_shift = platform.Modifiers { control: true, shift: true }
    let shift = platform.Modifiers { shift: true }
    let ctrl = platform.Modifiers { control: true }
    let k = bound("ctrl-shift-k", "x", "").keystrokes[0]
    testing.equal(t, stroke_matches(char_key("K", ctrl_shift), k), true)
    testing.equal(t, stroke_matches(char_key("k", ctrl), k), false)
    let bang = bound("!", "x", "").keystrokes[0]
    testing.equal(t, stroke_matches(char_key("!", shift), bang), true)
    testing.equal(t, stroke_matches(char_key("!", shift), bound("shift-1", "x", "").keystrokes[0]), false)
    let space = bound("space", "x", "").keystrokes[0]
    testing.equal(t, stroke_matches(char_key(" ", platform.Modifiers {}), space), true)
    testing.equal(t, stroke_matches(char_key(" ", platform.Modifiers {}), bound("shift-space", "x", "").keystrokes[0]), false)
    testing.equal(t, stroke_matches(char_key(" ", shift), space), false)
    testing.equal(t, stroke_matches(char_key("-", ctrl), bound("ctrl--", "x", "").keystrokes[0]), true)
    let enter = platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Enter) }
    testing.equal(t, stroke_matches(enter, bound("enter", "x", "").keystrokes[0]), true)
    let f5 = platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Function(5)), modifiers: ctrl }
    testing.equal(t, stroke_matches(f5, bound("ctrl-f5", "x", "").keystrokes[0]), true)
}
