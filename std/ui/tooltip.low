import std/ui/geometry
import std/ui/layout
import std/ui/scene

const tooltip_show_delay_ms = 500
const tooltip_hide_delay_ms = 500

struct TooltipState {
    owner: str = ""
    hoverable: bool = false
    visible: bool = false
    hiding: bool = false
    at: geometry.Point = geometry.Point {}
    timer: i64 = 0
    bounds: geometry.Rect = geometry.Rect {}
    drawn: bool = false
    tree: layout.Tree = layout.tree(1.0)
    laid: Laid? = none
    walk: Walk = Walk { parent: -1, clip: geometry.Rect {}, shift: geometry.Point {} }
}

/// Returns `e` showing the element `build` returns beside the pointer once the pointer has rested on `e` for 500 milliseconds, as gpui's `tooltip` (`elements/div.rs:538`, `TOOLTIP_SHOW_DELAY`). The tooltip appears one pixel below and right of the pointer, or above or left of it where it would cross the window's edge, is drawn over everything else, and is hidden when the pointer leaves `e`, a button is pressed or the wheel turns.
pub fn tooltip(e: Element, build: fn() -> Element) -> Element {
    listen(e, Tooltip(build, false))
}

/// Returns `e` showing a tooltip as `tooltip` does, which stays while the pointer is over the tooltip itself and is hidden 500 milliseconds after the pointer leaves both, as gpui's `hoverable_tooltip` (`HOVERABLE_TOOLTIP_HIDE_DELAY`). A button press does not hide it.
pub fn hoverable_tooltip(e: Element, build: fn() -> Element) -> Element {
    listen(e, Tooltip(build, true))
}

fn tooltip_listener(e: Element) -> Listener? {
    for l in e.listeners {
        match l {
            Tooltip(build, hoverable) => return l
            _ => {}
        }
    }
    none
}

fn has_tooltip(e: Element) -> bool {
    match tooltip_listener(e) {
        some(l) => true
        none => false
    }
}

fn tooltip_target(st: *State) -> i64 {
    var i = topmost(st)
    for i >= 0 {
        if has_tooltip(st.hitboxes[i].element) {
            return i
        }
        i = ancestor_hit(st, st.hitboxes[i].parent)
    }
    -1
}

fn stop_tooltip_timer(st: *State) {
    if st.tip.timer != 0 {
        cancel_timer(st, st.tip.timer)
        st.tip.timer = 0
    }
}

fn hide_tooltip(st: *State) {
    stop_tooltip_timer(st)
    if st.tip.visible {
        st.dirty = true
    }
    st.tip.visible = false
    st.tip.hiding = false
    st.tip.owner = ""
}

fn tooltip_moved(st: *State) {
    tooltip_check(st)
    if st.tip.visible {
        return
    }
    let target = tooltip_target(st)
    if st.tip.timer != 0 {
        if target >= 0 && st.hitboxes[target].key == st.tip.owner {
            return
        }
        hide_tooltip(st)
    }
    if target < 0 {
        return
    }
    st.tip.owner = st.hitboxes[target].key
    st.tip.timer = schedule(st, tooltip_show_delay_ms, fn() { show_tooltip(st) })
}

fn show_tooltip(st: *State) {
    st.tip.timer = 0
    let target = tooltip_target(st)
    if target < 0 || st.hitboxes[target].key != st.tip.owner {
        st.tip.owner = ""
        return
    }
    st.tip.hoverable = match tooltip_listener(st.hitboxes[target].element) {
        some(l) => match l {
            Tooltip(build, hoverable) => hoverable
            _ => false
        }
        none => false
    }
    st.tip.visible = true
    st.tip.hiding = false
    st.tip.drawn = false
    st.tip.at = st.pointer
    st.dirty = true
}

fn tooltip_hovered(st: *State, bounds: geometry.Rect) -> bool {
    if !st.pointer_inside {
        return false
    }
    let at = find(st, st.tip.owner)
    let over_owner = at >= 0 && geometry.contains(st.hitboxes[at].bounds, st.pointer)
    over_owner || (st.tip.hoverable && geometry.contains(bounds, st.pointer))
}

fn tooltip_check(st: *State) {
    if !st.tip.visible {
        return
    }
    if tooltip_hovered(st, st.tip.bounds) {
        if st.tip.hiding {
            stop_tooltip_timer(st)
            st.tip.hiding = false
        }
        return
    }
    if !st.tip.hoverable {
        hide_tooltip(st)
        return
    }
    if !st.tip.hiding {
        st.tip.hiding = true
        st.tip.timer = schedule(st, tooltip_hide_delay_ms, fn() { hide_tooltip(st) })
    }
}

fn tooltip_pressed(st: *State) {
    if st.tip.visible && !st.tip.hoverable {
        hide_tooltip(st)
    }
}

fn tooltip_bounds(at: geometry.Point, size: geometry.Size, window: geometry.Rect) -> geometry.Rect {
    var r = geometry.rect(at.x + 1.0, at.y + 1.0, size.width, size.height)
    if r.x + r.width > window.x + window.width {
        let x = at.x - size.width - 1.0
        r.x = if x >= 0.0 { x } else { 0.0 }
    }
    if r.y + r.height > window.y + window.height {
        let y = at.y - size.height - 1.0
        r.y = if y >= 0.0 { y } else { 0.0 }
    }
    r
}

fn prepaint_tooltip(st: *State, scale: f32) {
    st.tip.drawn = false
    if !st.tip.visible {
        return
    }
    let owner = find(st, st.tip.owner)
    if owner < 0 {
        hide_tooltip(st)
        return
    }
    let build = match tooltip_listener(st.hitboxes[owner].element) {
        some(l) => match l {
            Tooltip(b, hoverable) => b
            _ => return
        }
        none => {
            hide_tooltip(st)
            return
        }
    }
    let e = build()
    var t = layout.tree(scale)
    let laid = build_laid(st, mut t, e)
    layout.compute(mut t, laid.node, geometry.size(layout.unbounded, layout.unbounded))
    let r = layout.rect(t, laid.node)
    let bounds = tooltip_bounds(st.tip.at, geometry.size(r.width, r.height), st.viewport)
    if !st.tip.hoverable && !tooltip_hovered(st, bounds) {
        hide_tooltip(st)
        return
    }
    st.tip.bounds = bounds
    let walk = Walk { parent: owner, clip: st.viewport, shift: geometry.point(bounds.x - r.x, bounds.y - r.y) }
    prepaint(st, t, laid, "tooltip", walk)
    prepaint_deferred(st)
    st.tip.tree = t
    st.tip.laid = laid
    st.tip.walk = walk
    st.tip.drawn = true
}

fn paint_tooltip(st: *State, mut sc: scene.Scene, scale: f32) {
    if !st.tip.drawn {
        return
    }
    let laid = st.tip.laid ?? return
    paint(st, st.tip.tree, mut sc, laid, st.tip.walk, default_text_style(st), scale)
    paint_deferred(st, mut sc, scale)
}

fn build_laid(st: *State, mut t: layout.Tree, e: Element) -> Laid {
    build(st, mut t, e, default_text_style(st))
}
