    ta_expect_range(t, got[1], ta_at(0, 2), ta_at(0, 4))
    ta_ctrl(r, "d", false)
    testing.equal(t, ta_count(r), 2)
}

fn test_select_next_occurrence_matches_text_across_lines(t: *testing.T) {
    let r = ta_open("a\nb\nx\na\nb")
    ta_select(r, ta_at(0, 0), ta_at(1, 1))
    ta_ctrl(r, "d", false)
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 2)
    ta_expect_range(t, got[1], ta_at(3, 0), ta_at(4, 1))
    ta_type(r, "z")
    testing.equal(t, ta_text(r), "z\nx\nz")
}

fn test_select_next_occurrence_ignores_blanks_and_touches_the_word_before_the_caret(t: *testing.T) {
    let r = ta_open("foo  bar")
    ta_put(r, 0, 4)
    ta_ctrl(r, "d", false)
    testing.equal(t, ta_count(r), 1)
    ta_expect_carets(t, r, [ta_at(0, 4)])
    ta_put(r, 0, 8)
    ta_ctrl(r, "d", false)
    ta_expect_range(t, text_area_selection(r.cx, "area"), ta_at(0, 5), ta_at(0, 8))
}

fn test_select_all_occurrences_selects_every_match_and_typing_replaces_them_in_one_step(t: *testing.T) {
    let r = ta_open("foo bar foo\nbaz foo Foo")
    ta_put(r, 0, 9)
    ta_ctrl(r, "d", true)
    testing.equal(t, ta_count(r), 3)
    let got = text_area_selections(r.cx, "area")
    ta_expect_range(t, got[0], ta_at(0, 0), ta_at(0, 3))
    ta_expect_range(t, got[1], ta_at(0, 8), ta_at(0, 11))
    ta_expect_range(t, got[2], ta_at(1, 4), ta_at(1, 7))
    ta_type(r, "q")
    testing.equal(t, ta_text(r), "q bar q\nbaz q Foo")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "foo bar foo\nbaz foo Foo")
    testing.equal(t, ta_count(r), 3)
}

fn test_select_all_occurrences_uses_the_selected_text(t: *testing.T) {
    let r = ta_open("ab ab\nab")
    ta_select(r, ta_at(0, 0), ta_at(0, 2))
    ta_ctrl(r, "d", true)
    testing.equal(t, ta_count(r), 3)
}

fn test_escape_collapses_several_selections_to_the_primary_and_is_consumed(t: *testing.T) {
    let o = ro_open("abc\ndef", false)
    var sels: TextSelection[] = []
    sels.push(ta_range(ta_at(0, 0), ta_at(0, 2)))
    sels.push(ta_range(ta_at(1, 1), ta_at(1, 1)))
    ta_ranges(o.r, sels)
    ta_press(o.r, platform.NamedKey.Escape)
    testing.equal(t, ta_count(o.r), 1)
    ta_expect_range(t, text_area_selection(o.r.cx, "area"), ta_at(0, 0), ta_at(0, 2))
    testing.equal(t, get(o.keys), 0)
}

fn test_escape_with_one_selection_reaches_the_elements_around_the_area(t: *testing.T) {
    let o = ro_open("abc", false)
    ta_put(o.r, 0, 1)
    ta_press(o.r, platform.NamedKey.Escape)
    testing.equal(t, get(o.keys), 1)
    ta_many(o.r, [ta_at(0, 0), ta_at(0, 2)])
    ta_press(o.r, platform.NamedKey.Escape)
    testing.equal(t, get(o.keys), 1)
    ta_press(o.r, platform.NamedKey.Escape)
    testing.equal(t, get(o.keys), 2)
}

fn test_a_click_collapses_the_selections_and_a_control_click_adds_a_caret(t: *testing.T) {
    let r = ta_open("abcd\nefgh\nijkl")
    ta_click(r, ta_width("ab") + 0.1, 13.0, 1)
    ta_frame(r)
    ta_down_with(r, ta_width("ef") + 0.1, 39.0, 1, platform.Modifiers { control: true })
    ta_up_with(r, ta_width("ef") + 0.1, 39.0, platform.Modifiers { control: true })
    ta_frame(r)
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 2)])
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "abZcd\nefZgh\nijkl")
    ta_frame(r)
    ta_click(r, ta_width("ij") + 0.1, 65.0, 1)
    ta_expect_carets(t, r, [ta_at(2, 2)])
}

fn test_a_control_double_click_adds_the_word_and_a_control_drag_extends_the_new_selection(t: *testing.T) {
    let r = ta_open("hello world\nsecond line\nthird")
    ta_put(r, 0, 1)
    let control = platform.Modifiers { control: true }
    ta_down_with(r, 5.0, 39.0, 2, control)
    ta_up_with(r, 5.0, 39.0, control)
    ta_frame(r)
    var got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 2)
    ta_expect_range(t, got[1], ta_at(1, 0), ta_at(1, 6))
    ta_put(r, 0, 1)
    ta_down_with(r, ta_width("se") + 0.1, 39.0, 1, control)
    dispatch(r.cx, platform.Event.PointerMoved(ta_width("th") + 0.1, 65.0))
    ta_up_with(r, ta_width("th") + 0.1, 65.0, control)
    got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 2)
    ta_expect_range(t, got[0], ta_at(0, 1), ta_at(0, 1))
    ta_expect_range(t, got[1], ta_at(1, 2), ta_at(2, 2))
}

fn ta_column_near(r: TaRig, line: i64, width: i64, x: f32) -> i64 {
    var best = 0
    var gap = ta_gap(ta_caret_x_at(r, line, 0), x)
    for c in 1..width + 1 {
        let g = ta_gap(ta_caret_x_at(r, line, c), x)
        if g < gap {
            gap = g
            best = c
        }
    }
    best
}

fn ta_gap(a: f32, b: f32) -> f32 {
    if a < b { b - a } else { a - b }
}

fn test_an_alt_drag_selects_a_column_through_the_columns_a_tab_fills(t: *testing.T) {
    let r = ta_open_tabs("\tab\nabcdefgh\nabcdefgh", 4)
    let left = ta_caret_x_at(r, 0, 1)
    let right = ta_caret_x_at(r, 1, 6)
    testing.is_true(t, right > left)
    let near_second = ta_column_near(r, 1, 8, left)
    let near_third = ta_column_near(r, 2, 8, left)
    let far_first = ta_column_near(r, 0, 3, right)
    ta_many(r, [ta_at(0, 0)])
    let alt = platform.Modifiers { alt: true }
    ta_down_with(r, left, 13.0, 1, alt)
    dispatch(r.cx, platform.Event.PointerMoved(right, 65.0))
    ta_up_with(r, right, 65.0, alt)
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 3)
    ta_expect_range(t, got[0], ta_at(0, 1), ta_at(0, far_first))
    ta_expect_range(t, got[1], ta_at(1, near_second), ta_at(1, 6))
    ta_expect_range(t, got[2], ta_at(2, near_third), ta_at(2, 6))
    testing.is_true(t, got[1].anchor.column > got[0].anchor.column)
}

fn test_an_alt_drag_to_the_left_keeps_the_caret_on_the_left_edge(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef")
    let near = ta_caret_x_at(r, 0, 2)
    let far = ta_caret_x_at(r, 0, 4)
    let alt = platform.Modifiers { alt: true }
    ta_down_with(r, far, 13.0, 1, alt)
    dispatch(r.cx, platform.Event.PointerMoved(near, 39.0))
    ta_up_with(r, near, 39.0, alt)
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 2)
    ta_expect_range(t, got[0], ta_at(0, 4), ta_at(0, 2))
    ta_expect_range(t, got[1], ta_at(1, 4), ta_at(1, 2))
    ta_type(r, "|")
    testing.equal(t, ta_text(r), "ab|ef\nab|ef")
}

fn test_an_alt_drag_through_short_lines_leaves_a_caret_at_each_line_end(t: *testing.T) {
    let r = ta_open("abcdef\nab\nabcdef")
    let col = ta_caret_x_at(r, 0, 4)
    let alt = platform.Modifiers { alt: true }
    ta_down_with(r, col, 13.0, 1, alt)
    dispatch(r.cx, platform.Event.PointerMoved(col, 65.0))
    ta_up_with(r, col, 65.0, alt)
    ta_expect_carets(t, r, [ta_at(0, 4), ta_at(1, 2), ta_at(2, 4)])
}

fn test_a_control_and_alt_drag_keeps_the_selections_it_started_with(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef\nabcdef")
    let at = ta_caret_x_at(r, 0, 3)
    ta_many(r, [ta_at(2, 0)])
    let both = platform.Modifiers { alt: true, control: true }
    ta_down_with(r, at, 13.0, 1, both)
    dispatch(r.cx, platform.Event.PointerMoved(at, 39.0))
    ta_up_with(r, at, 39.0, both)
    ta_expect_carets(t, r, [ta_at(0, 3), ta_at(1, 3), ta_at(2, 0)])
}

fn ta_middle_down(r: TaRig, x: f32, y: f32, mods: platform.Modifiers) {
    dispatch(r.cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Middle, x: x, y: y, clicks: 1, modifiers: mods }))
}

fn ta_middle_up(r: TaRig, x: f32, y: f32, mods: platform.Modifiers) {
    dispatch(r.cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Middle, x: x, y: y, clicks: 1, modifiers: mods }))
}

fn test_a_middle_drag_down_selects_a_column_one_selection_per_line(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef\nabcdef")
    let from = ta_caret_x_at(r, 0, 1)
    let to = ta_caret_x_at(r, 0, 4)
    let none = platform.Modifiers {}
    ta_middle_down(r, from, 13.0, none)
    dispatch(r.cx, platform.Event.PointerMoved(to, 65.0))
    ta_middle_up(r, to, 65.0, none)
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 3)
    ta_expect_range(t, got[0], ta_at(0, 1), ta_at(0, 4))
    ta_expect_range(t, got[1], ta_at(1, 1), ta_at(1, 4))
    ta_expect_range(t, got[2], ta_at(2, 1), ta_at(2, 4))
}

fn test_a_middle_drag_up_selects_a_column_back_to_the_pressed_line(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef\nabcdef")
    let from = ta_caret_x_at(r, 0, 4)
    let to = ta_caret_x_at(r, 0, 1)
    let none = platform.Modifiers {}
    ta_middle_down(r, from, 65.0, none)
    dispatch(r.cx, platform.Event.PointerMoved(to, 13.0))
    ta_middle_up(r, to, 13.0, none)
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 3)
    ta_expect_range(t, got[0], ta_at(0, 4), ta_at(0, 1))
    ta_expect_range(t, got[1], ta_at(1, 4), ta_at(1, 1))
    ta_expect_range(t, got[2], ta_at(2, 4), ta_at(2, 1))
}

fn test_a_middle_drag_selects_a_column_through_the_columns_a_tab_fills(t: *testing.T) {
    let r = ta_open_tabs("\tab\nabcdefgh\nabcdefgh", 4)
    let left = ta_caret_x_at(r, 0, 1)
    let right = ta_caret_x_at(r, 1, 6)
    let near_second = ta_column_near(r, 1, 8, left)
    let near_third = ta_column_near(r, 2, 8, left)
    let far_first = ta_column_near(r, 0, 3, right)
    ta_many(r, [ta_at(0, 0)])
    let none = platform.Modifiers {}
    ta_middle_down(r, left, 13.0, none)
    dispatch(r.cx, platform.Event.PointerMoved(right, 65.0))
    ta_middle_up(r, right, 65.0, none)
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 3)
    ta_expect_range(t, got[0], ta_at(0, 1), ta_at(0, far_first))
    ta_expect_range(t, got[1], ta_at(1, near_second), ta_at(1, 6))
    ta_expect_range(t, got[2], ta_at(2, near_third), ta_at(2, 6))
    testing.is_true(t, got[1].anchor.column > got[0].anchor.column)
}

fn test_a_control_middle_drag_keeps_the_selections_it_started_with(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef\nabcdef")
    let at = ta_caret_x_at(r, 0, 3)
    ta_many(r, [ta_at(2, 0)])
    let held = platform.Modifiers { control: true }
    ta_middle_down(r, at, 13.0, held)
    dispatch(r.cx, platform.Event.PointerMoved(at, 39.0))
    ta_middle_up(r, at, 39.0, held)
    ta_expect_carets(t, r, [ta_at(0, 3), ta_at(1, 3), ta_at(2, 0)])
}

fn test_a_middle_drag_without_control_drops_the_selections_it_started_with(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef\nabcdef")
    let at = ta_caret_x_at(r, 0, 3)
    ta_many(r, [ta_at(2, 0)])
    let none = platform.Modifiers {}
    ta_middle_down(r, at, 13.0, none)
    dispatch(r.cx, platform.Event.PointerMoved(at, 39.0))
    ta_middle_up(r, at, 39.0, none)
    ta_expect_carets(t, r, [ta_at(0, 3), ta_at(1, 3)])
}

fn test_a_middle_press_without_a_move_leaves_one_caret_at_the_press(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef\nabcdef")
    let at = ta_caret_x_at(r, 1, 2)
    ta_many(r, [ta_at(0, 0), ta_at(2, 5)])
    let none = platform.Modifiers {}
    ta_middle_down(r, at, 39.0, none)
    ta_middle_up(r, at, 39.0, none)
    ta_expect_carets(t, r, [ta_at(1, 2)])
    testing.equal(t, ta_text(r), "abcdef\nabcdef\nabcdef")
}

fn test_a_middle_press_takes_focus_and_does_not_paste(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef")
    set_focus(r.cx, "")
    ta_frame(r)
    let none = platform.Modifiers {}
    ta_middle_down(r, 10.0, 13.0, none)
    ta_middle_up(r, 10.0, 13.0, none)
    testing.equal(t, focused(r.cx), "area")
    testing.equal(t, ta_text(r), "abcdef\nabcdef")
}

fn test_a_character_typed_after_a_zero_width_middle_drag_inserts_on_every_line(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef\nabcdef")
    let at = ta_caret_x_at(r, 0, 3)
    let none = platform.Modifiers {}
    ta_middle_down(r, at, 13.0, none)
    dispatch(r.cx, platform.Event.PointerMoved(at, 65.0))
    ta_middle_up(r, at, 65.0, none)
    ta_type(r, "|")
    testing.equal(t, ta_text(r), "abc|def\nabc|def\nabc|def")
}

fn test_a_middle_drag_keeps_tracking_outside_the_area_and_stops_at_the_release(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef\nabcdef\nabcdef\nabcdef\nabcdef")
    let from = ta_caret_x_at(r, 0, 1)
    let none = platform.Modifiers {}
    ta_middle_down(r, from, 13.0, none)
    dispatch(r.cx, platform.Event.PointerMoved(from + 20.0, 400.0))
    let during = text_area_selections(r.cx, "area")
    testing.equal(t, during.len, 4)
    ta_middle_up(r, from + 20.0, 400.0, none)
    dispatch(r.cx, platform.Event.PointerMoved(from, 13.0))
    testing.equal(t, text_area_selections(r.cx, "area").len, 4)
}

fn test_an_alt_press_without_a_move_leaves_one_caret_at_the_press(t: *testing.T) {
    let r = ta_open("abcdef\nabcdef")
    let at = ta_caret_x_at(r, 1, 3)
    ta_many(r, [ta_at(0, 0), ta_at(0, 5)])
    let alt = platform.Modifiers { alt: true }
    ta_down_with(r, at, 39.0, 1, alt)
    ta_up_with(r, at, 39.0, alt)
    ta_expect_carets(t, r, [ta_at(1, 3)])
}

fn test_a_middle_press_still_reaches_the_mouse_down_handlers_of_the_area(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, ["abcdef", "abcdef"])
    let src = ta_source(doc)
    let log = log_of(cx)
    let view = fn() -> Element {
        text_area(src).id("area").size(200.0, 104.0)
            .on_mouse_down(platform.Button.Middle, fn(e: MouseDownEvent) { note(log, "middle down") })
    }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    ta_middle_down(r, 10.0, 13.0, platform.Modifiers {})
    ta_middle_up(r, 10.0, 13.0, platform.Modifiers {})
    testing.equal(t, get(log).len, 1)
    testing.equal(t, text_area_selections(cx, "area").len, 1)
}

fn test_every_caret_and_selection_is_painted(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_many(r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1)])
    let carets = ta_frame(r)
    testing.equal(t, carets.quads.len, 3)
    for q in carets.quads {
        testing.equal(t, q.bounds.width, 1.0)
        testing.equal(t, q.bounds.height, 26.0)
    }
    testing.equal(t, carets.quads[0].bounds.y, 0.0)
    testing.equal(t, carets.quads[1].bounds.y, 26.0)
    testing.equal(t, carets.quads[2].bounds.y, 52.0)
    var sels: TextSelection[] = []
    sels.push(ta_range(ta_at(0, 0), ta_at(0, 2)))
    sels.push(ta_range(ta_at(2, 0), ta_at(2, 1)))
    ta_ranges(r, sels)
    let drawn = ta_frame(r)
    testing.equal(t, drawn.quads.len, 4)
    testing.is_true(t, drawn.quads[0].background.a < 1.0)
    testing.equal(t, drawn.quads[0].bounds.y, 0.0)
    testing.is_true(t, drawn.quads[1].background.a < 1.0)
    testing.equal(t, drawn.quads[1].bounds.y, 52.0)
    testing.equal(t, drawn.quads[2].bounds.width, 1.0)
    testing.equal(t, drawn.quads[3].bounds.width, 1.0)
    testing.equal(t, drawn.quads[3].bounds.y, 52.0)
}

fn test_a_selection_across_lines_paints_each_row_once_among_several(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    var sels: TextSelection[] = []
    sels.push(ta_range(ta_at(0, 1), ta_at(1, 1)))
    sels.push(ta_range(ta_at(1, 2), ta_at(2, 1)))
    ta_ranges(r, sels)
    let drawn = ta_frame(r)
    testing.equal(t, drawn.quads.len, 5)
}

fn test_carets_far_from_the_view_cost_no_more_lines_than_one_caret(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let reads = signal(cx, 0)
    let count = fn() -> i64 { 1000000 }
    let line = fn(i: i64) -> str {
        set(reads, get(reads) + 1)
        "line {i}"
    }
    let edit = fn(ed: TextEdit) {}
    let src = line_source(count, line, edit)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let size = geometry.size(320.0, 240.0)
    frame(cx, view, size, 1.0)
    set_focus(cx, "area")
    frame(cx, view, size, 1.0)
    var sels: TextSelection[] = []
    for n in 0..200 {
        let p = TextPosition { line: n * 4000, column: 2 }
        sels.push(TextSelection { anchor: p, caret: p })
    }
    set_text_area_selections(cx, "area", sels)
    frame(cx, view, size, 1.0)
    set(reads, 0)
    frame(cx, view, size, 1.0)
    testing.is_true(t, get(reads) <= 6)
    testing.equal(t, text_area_selections(cx, "area").len, 200)
    scroll_text_area_to_line(cx, "area", 400000)
    set(reads, 0)
    frame(cx, view, size, 1.0)
    testing.is_true(t, get(reads) <= 6)
}

fn test_a_document_that_shrinks_under_several_selections_clamps_and_merges_them(t: *testing.T) {
    let r = ta_open("a\nb\nlonger")
    ta_many(r, [ta_at(0, 1), ta_at(2, 3)])
    set(r.doc, ["x"])
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "xZ")
    ta_expect_carets(t, r, [ta_at(0, 2)])
}

fn test_a_step_with_several_selections_calls_edit_all_once_last_position_first(t: *testing.T) {
    let b = ta_open_batched("ab\ncd\nef")
    ta_many(b.r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1)])
    ta_type(b.r, "X")
    testing.equal(t, ta_text(b.r), "aXb\ncXd\neXf")
    testing.equal(t, get(b.calls), 1)
    testing.equal(t, get(b.singles), 0)
    let sent = get(b.last)
    testing.equal(t, sent.len, 3)
    ta_expect(t, sent[0].start, 2, 1)
    ta_expect(t, sent[1].start, 1, 1)
    ta_expect(t, sent[2].start, 0, 1)
    ta_ctrl(b.r, "z", false)
    testing.equal(t, ta_text(b.r), "ab\ncd\nef")
    testing.equal(t, get(b.calls), 1)
}

fn test_a_single_selection_never_calls_edit_all(t: *testing.T) {
    let b = ta_open_batched("ab")
    ta_press(b.r, platform.NamedKey.End)
    ta_type(b.r, "X")
    testing.equal(t, ta_text(b.r), "abX")
    testing.equal(t, get(b.calls), 0)
    testing.equal(t, get(b.singles), 1)
}

fn test_edit_all_receives_deletions_with_the_larger_range_first_at_one_start(t: *testing.T) {
    let b = ta_open_batched("ab\ncd")
    ta_many(b.r, [ta_at(0, 2), ta_at(1, 0)])
    ta_press(b.r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(b.r), "acd")
    let sent = get(b.last)
    testing.equal(t, sent.len, 2)
    ta_expect(t, sent[0].start, 0, 2)
    ta_expect(t, sent[1].start, 0, 1)
}

fn test_an_edit_all_that_ignores_the_edits_drops_the_history(t: *testing.T) {
    let b = ta_open_batched("ab\ncd")
    ta_many(b.r, [ta_at(0, 1), ta_at(1, 1)])
    ta_type(b.r, "X")
    testing.equal(t, ta_text(b.r), "aXb\ncXd")
    set(b.mode, 1)
    ta_type(b.r, "Y")
    testing.equal(t, ta_text(b.r), "aXb\ncXd")
    set(b.mode, 0)
    ta_ctrl(b.r, "z", false)
    testing.equal(t, ta_text(b.r), "aXb\ncXd")
    let kept = text_area_selections(b.r.cx, "area")
    testing.is_true(t, kept.len >= 1)
    for s in kept {
        testing.is_true(t, s.caret.line <= 1 && s.caret.column <= 4)
    }
    ta_type(b.r, "Z")
    testing.is_true(t, strs.contains(ta_text(b.r), "Z"))
}

fn test_read_only_keeps_adding_cursors_and_copying_but_refuses_edits(t: *testing.T) {
    let o = ro_open("ab\ncd", true)
    ta_put(o.r, 0, 0)
    ta_chord(o.r, platform.NamedKey.Down, false, true, true)
    testing.equal(t, ta_count(o.r), 2)
    ta_key(o.r, platform.NamedKey.End, true, false)
    ta_ctrl(o.r, "c", false)
    testing.equal(t, clipboard(o.r.cx) ?? "", "ab\ncd")
    ta_type(o.r, "X")
    ta_press(o.r, platform.NamedKey.Backspace)
    ta_press(o.r, platform.NamedKey.Enter)
    set_clipboard(o.r.cx, "1\n2")
    ta_ctrl(o.r, "v", false)
    testing.equal(t, ta_text(o.r), "ab\ncd")
    testing.equal(t, get(o.edits), 0)
    ta_ctrl(o.r, "d", false)
    testing.equal(t, ta_count(o.r), 2)
    ta_press(o.r, platform.NamedKey.Escape)
    testing.equal(t, ta_count(o.r), 1)
}

fn test_the_multi_selection_actions_are_bound_and_available(t: *testing.T) {
    let r = ta_open("ab")
    let names = ["text_area.add_cursor_above", "text_area.add_cursor_below", "text_area.select_next_occurrence", "text_area.select_all_occurrences", "text_area.collapse_selections"]
    let available = available_actions(r.cx)
    for name in names {
        testing.is_true(t, listed(available, name))
        testing.is_true(t, is_action_available(r.cx, name))
        testing.equal(t, bindings_for_action(r.cx, name).len, 1)
    }
    testing.is_false(t, dispatch_action(r.cx, "text_area.collapse_selections"))
}

fn test_the_actions_work_when_dispatched_by_name(t: *testing.T) {
    let r = ta_open("ab ab\nab ab")
    ta_put(r, 0, 1)
    testing.is_true(t, dispatch_action(r.cx, "text_area.select_next_occurrence"))
    testing.is_true(t, dispatch_action(r.cx, "text_area.select_all_occurrences"))
    testing.equal(t, ta_count(r), 4)
    testing.is_true(t, dispatch_action(r.cx, "text_area.collapse_selections"))
    testing.equal(t, ta_count(r), 1)
    testing.is_true(t, dispatch_action(r.cx, "text_area.add_cursor_below"))
    testing.equal(t, ta_count(r), 2)
}

fn ta_caret_at(line: i64, column: i64) -> TextSelection {
    TextSelection { anchor: ta_at(line, column), caret: ta_at(line, column) }
}

fn test_setting_selections_scrolls_to_the_first_in_document_order(t: *testing.T) {
    let r = ta_open(ta_numbered(300))
    set_text_area_selections(r.cx, "area", [ta_caret_at(0, 0), ta_caret_at(250, 0)])
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 0)
}

fn test_revealing_a_selection_scrolls_it_into_view(t: *testing.T) {
    let r = ta_open(ta_numbered(300))
    let added = ta_caret_at(250, 0)
    set_text_area_selections(r.cx, "area", [ta_caret_at(0, 0), added])
    reveal_text_area_selection(r.cx, "area", added)
    ta_frame(r)
    let top = text_area_top_line(r.cx, "area")
    testing.is_true(t, top <= 250 && top > 240)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
    testing.equal(t, text_area_selections(r.cx, "area").len, 2)
}

fn test_revealing_a_selection_scrolls_horizontally_to_its_caret(t: *testing.T) {
    let r = ta_open("short\nthe quick brown fox jumps over the lazy dog and keeps running")
    let far = ta_caret_at(1, 62)
    set_text_area_selections(r.cx, "area", [ta_caret_at(0, 0), far])
    ta_frame(r)
    testing.equal(t, area_state(r.cx.state, "area").scroll_x, 0.0)
    reveal_text_area_selection(r.cx, "area", far)
    ta_frame(r)
    testing.is_true(t, area_state(r.cx.state, "area").scroll_x > 0.0)
}

fn test_a_reveal_applies_to_one_frame(t: *testing.T) {
    let r = ta_open(ta_numbered(300))
    let added = ta_caret_at(250, 0)
    set_text_area_selections(r.cx, "area", [ta_caret_at(0, 0), added])
    reveal_text_area_selection(r.cx, "area", added)
    ta_frame(r)
    scroll_text_area_to_line(r.cx, "area", 100)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 100)
}

fn test_a_key_between_a_reveal_and_the_frame_drops_the_reveal(t: *testing.T) {
    let r = ta_open(ta_numbered(300))
    let added = ta_caret_at(250, 0)
    set_text_area_selections(r.cx, "area", [ta_caret_at(0, 0), added])
    reveal_text_area_selection(r.cx, "area", added)
    ta_press(r, platform.NamedKey.Right)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 0)
}

fn ta_hinted(initial: str, tint: geometry.Color?) -> TaRig {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, strs.split_str(initial, "\n"))
    let src = ta_source(doc)
    let view = fn() -> Element {
        let base = text_area(src).id("area").size(200.0, 104.0).placeholder("Message")
        match tint {
            some(c) => base.placeholder_color(c)
            none => base
        }
    }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    r
}

fn ta_glyphs(s: scene.Scene) -> i64 {
    s.sprites.len + s.subpixel_sprites.len
}

fn test_an_empty_text_area_paints_its_placeholder(t: *testing.T) {
    let r = ta_hinted("", none)
    let s = ta_frame(r)
    testing.is_true(t, ta_glyphs(s) > 0)
    testing.equal(t, s.quads.len, 0)
}

fn test_a_text_area_with_text_paints_no_placeholder(t: *testing.T) {
    let plain = ta_hinted("", none)
    let hinted = ta_frame(plain)
    let typed = ta_hinted("x", none)
    let s = ta_frame(typed)
    testing.equal(t, ta_glyphs(s), 1)
    testing.is_true(t, ta_glyphs(hinted) > ta_glyphs(s))
    let lines = ta_frame(ta_hinted("\n", none))
    testing.equal(t, ta_glyphs(lines), 0)
}

fn test_typing_replaces_a_text_area_placeholder_and_deleting_brings_it_back(t: *testing.T) {
    let r = ta_hinted("", none)
    set_focus(r.cx, "area")
    let empty = ta_glyphs(ta_frame(r))
    ta_type(r, "a")
    testing.equal(t, ta_glyphs(ta_frame(r)), 1)
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_glyphs(ta_frame(r)), empty)
}

fn test_a_composition_hides_a_text_area_placeholder(t: *testing.T) {
    let r = ta_hinted("", none)
    set_focus(r.cx, "area")
    ta_frame(r)
    dispatch(r.cx, platform.Event.Preedit("ab", none))
    testing.equal(t, ta_glyphs(ta_frame(r)), 2)
}

fn test_a_text_area_placeholder_takes_the_placeholder_colour(t: *testing.T) {
    let dim = ta_frame(ta_hinted("", none))
    let red = ta_frame(ta_hinted("", some(rgb(0xff0000))))
    testing.is_true(t, dim.sprites.len > 0)
    testing.is_true(t, red.sprites.len > 0)
    for s in dim.sprites {
        testing.equal(t, s.color.a, 0.2)
    }
    for s in red.sprites {
        testing.equal(t, s.color.r, 1.0)
        testing.equal(t, s.color.a, 1.0)
    }
}

fn test_the_selection_colour_paints_a_text_area_selection(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, ["hello world"])
    let src = ta_source(doc)
    let themed = fn() -> Element { text_area(src).id("area").size(200.0, 104.0).selection_color(rgba(0x10b98180)) }
    let r = TaRig { cx, doc, view: themed }
    ta_frame(r)
    set_focus(cx, "area")
    ta_select(r, ta_at(0, 0), ta_at(0, 5))
    let s = ta_frame(r)
    testing.equal(t, s.quads[0].background.g, rgba(0x10b98180).g)
    testing.equal(t, s.quads[0].background.a, rgba(0x10b98180).a)
}

fn test_a_text_area_selection_is_blue_without_a_selection_colour(t: *testing.T) {
    let r = ta_open("hello world")
    ta_select(r, ta_at(0, 0), ta_at(0, 5))
    let s = ta_frame(r)
    testing.equal(t, s.quads[0].background.b, rgba(0x3b82f666).b)
    testing.equal(t, s.quads[0].background.a, rgba(0x3b82f666).a)
}

fn test_the_top_shift_reports_the_partial_line_scrolled_out_of_view(t: *testing.T) {
    let r = ta_open(ta_numbered(20))
    testing.equal(t, text_area_top_shift(r.cx, "area"), 0.0)
    ta_wheel(r, 0.0, 30.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 1)
    testing.equal(t, text_area_top_shift(r.cx, "area"), 4.0)
}

fn test_resetting_a_text_area_clears_its_selection_and_history(t: *testing.T) {
    let r = ta_open("abc\ndef")
    ta_put(r, 1, 3)
    ta_type(r, "X")
    set_text_area_selections(r.cx, "area", [ta_caret_at(0, 0), ta_caret_at(1, 1)])
    set(r.doc, ["fresh"])
    reset_text_area(r.cx, "area")
    ta_frame(r)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
    ta_expect(t, text_area_selection(r.cx, "area").anchor, 0, 0)
    testing.equal(t, text_area_selections(r.cx, "area").len, 1)
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "fresh")
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "fresh")
}

fn test_resetting_a_text_area_scrolls_it_to_the_top_and_keeps_it_working(t: *testing.T) {
    let r = ta_open(ta_numbered(30))
    scroll_text_area_to_line(r.cx, "area", 12)
    ta_frame(r)
    reset_text_area(r.cx, "area")
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 0)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_type(r, "Z")
    testing.equal(t, strs.split_str(ta_text(r), "\n")[1], "Zline 1")
}

fn ta_insert(line: i64, column: i64, text: str) -> TextEdit {
    TextEdit { start: ta_at(line, column), end: ta_at(line, column), text }
}

fn test_applied_edits_change_the_document_and_undo_as_one_step(t: *testing.T) {
    let r = ta_open("abc\ndef\nghi")
    ta_put(r, 1, 1)
    let edits = [ta_insert(0, 0, "    "), ta_insert(1, 0, "    "), ta_insert(2, 0, "    ")]
    text_area_apply(r.cx, "area", edits, ta_caret_at(2, 5))
    testing.equal(t, ta_text(r), "    abc\n    def\n    ghi")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 5)
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abc\ndef\nghi")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 1)
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "    abc\n    def\n    ghi")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 5)
}

fn test_applied_edits_may_come_in_any_order_and_include_deletions(t: *testing.T) {
    let r = ta_open("one two\nthree")
    let edits = [ta_insert(1, 5, "!"), TextEdit { start: ta_at(0, 0), end: ta_at(0, 4), text: "" }, ta_insert(0, 7, "?")]
    text_area_apply(r.cx, "area", edits, ta_caret_at(0, 0))
    testing.equal(t, ta_text(r), "two?\nthree!")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "one two\nthree")
}

fn test_an_applied_step_keeps_the_typing_before_it_undoable(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    ta_type(r, "b")
    text_area_apply(r.cx, "area", [ta_insert(0, 2, "!")], ta_caret_at(0, 3))
    ta_type(r, "c")
    testing.equal(t, ta_text(r), "ab!c")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab!")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "")
}

fn test_an_applied_step_reaches_an_edit_all_source_as_one_batch(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, ["abc", "def"])
    let batches = signal(cx, 0)
    var src = ta_source(doc)
    src.edit_all = some(fn(edits: TextEdit[]) {
        set(batches, get(batches) + 1)
        for ed in edits {
            ta_apply(doc, ed)
        }
    })
    let r = TaRig { cx, doc, view: fn() -> Element { text_area(src).id("area").size(200.0, 104.0) } }
    ta_frame(r)
    text_area_apply(cx, "area", [ta_insert(0, 0, "x"), ta_insert(1, 0, "y")], ta_caret_at(0, 0))
    testing.equal(t, get(batches), 1)
    testing.equal(t, ta_text(r), "xabc\nydef")
}

fn test_an_invalid_applied_step_changes_nothing(t: *testing.T) {
    let r = ta_open("abc\ndef")
    ta_put(r, 0, 1)
    text_area_apply(r.cx, "area", [ta_insert(5, 0, "x")], ta_caret_at(0, 0))
    text_area_apply(r.cx, "area", [ta_insert(0, 9, "x")], ta_caret_at(0, 0))
    text_area_apply(r.cx, "area", [TextEdit { start: ta_at(0, 2), end: ta_at(0, 1), text: "x" }], ta_caret_at(0, 0))
    let overlapping = [TextEdit { start: ta_at(0, 0), end: ta_at(0, 2), text: "x" }, TextEdit { start: ta_at(0, 1), end: ta_at(0, 3), text: "y" }]
    text_area_apply(r.cx, "area", overlapping, ta_caret_at(0, 0))
    text_area_apply(r.cx, "area", [], ta_caret_at(0, 0))
    text_area_apply(r.cx, "area", [ta_insert(0, 0, "")], ta_caret_at(0, 0))
    testing.equal(t, ta_text(r), "abc\ndef")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
}

fn test_a_read_only_text_area_refuses_an_applied_step(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, ["abc"])
    let src = ta_source(doc)
    let r = TaRig { cx, doc, view: fn() -> Element { text_area(src).id("area").size(200.0, 104.0).read_only() } }
    ta_frame(r)
    text_area_apply(cx, "area", [ta_insert(0, 0, "x")], ta_caret_at(0, 0))
    testing.equal(t, ta_text(r), "abc")
    text_area_apply(cx, "missing", [ta_insert(0, 0, "x")], ta_caret_at(0, 0))
    testing.equal(t, ta_text(r), "abc")
}

fn test_an_applied_step_the_source_ignores_drops_the_history(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, ["abc"])
    let ignoring = line_source(fn() -> i64 { get(doc).len }, fn(i: i64) -> str { get(doc)[i] }, fn(ed: TextEdit) {})
    let r = TaRig { cx, doc, view: fn() -> Element { text_area(ignoring).id("area").size(200.0, 104.0) } }
    ta_frame(r)
    text_area_apply(cx, "area", [ta_insert(0, 0, "x")], ta_caret_at(0, 0))
    testing.equal(t, ta_text(r), "abc")
    testing.equal(t, area_state(cx.state, "area").undo.len, 0)
}

fn test_the_point_of_a_position_is_where_the_area_draws_it(t: *testing.T) {
    let r = ta_open("abcd\nefgh\nijkl")
    let p = text_area_point_of(r.cx, "area", ta_at(1, 2)) ?? geometry.Point {}
    testing.equal(t, p.x, ta_width("ef"))
    testing.equal(t, p.y, 26.0)
    let origin = text_area_point_of(r.cx, "area", ta_at(0, 0)) ?? geometry.Point { x: -1.0, y: -1.0 }
    testing.equal(t, origin.x, 0.0)
    testing.equal(t, origin.y, 0.0)
    let end = text_area_point_of(r.cx, "area", ta_at(2, 99)) ?? geometry.Point {}
    testing.equal(t, end.x, ta_width("ijkl"))
}

fn test_the_point_of_a_position_follows_the_scroll_and_hides_out_of_view_cells(t: *testing.T) {
    let r = ta_open(ta_numbered(20))
    testing.is_true(t, text_area_point_of(r.cx, "area", ta_at(10, 0)) == none)
    testing.is_true(t, text_area_point_of(r.cx, "area", ta_at(20, 0)) == none)
    testing.is_true(t, text_area_point_of(r.cx, "area", ta_at(-1, 0)) == none)
    ta_wheel(r, 0.0, 30.0)
    ta_frame(r)
    let p = text_area_point_of(r.cx, "area", ta_at(1, 0)) ?? geometry.Point {}
    testing.equal(t, p.y, -4.0)
    testing.is_true(t, text_area_point_of(r.cx, "area", ta_at(0, 0)) == none)
}

fn test_the_point_of_a_position_scrolls_with_the_text_horizontally(t: *testing.T) {
    let r = ta_open("the quick brown fox jumps over the lazy dog and keeps running")
    ta_press(r, platform.NamedKey.End)
    ta_frame(r)
    testing.is_true(t, text_area_point_of(r.cx, "area", ta_at(0, 0)) == none)
    let end = text_area_point_of(r.cx, "area", ta_at(0, 61)) ?? geometry.Point {}
    testing.is_true(t, end.x > 0.0 && end.x < 200.0)
}

fn test_the_position_at_a_point_matches_a_click_there(t: *testing.T) {
    let r = ta_open("abcd\nefgh\nijkl")
    let found = text_area_position_at(r.cx, "area", geometry.point(ta_width("ef") + 0.1, 39.0)) ?? ta_at(-1, -1)
    ta_expect(t, found, 1, 2)
    ta_click(r, ta_width("ef") + 0.1, 39.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, found.line, found.column)
    let past = text_area_position_at(r.cx, "area", geometry.point(190.0, 90.0)) ?? ta_at(-1, -1)
    ta_expect(t, past, 2, 4)
    let near = text_area_position_at(r.cx, "area", geometry.point(1.0, 3.0)) ?? ta_at(-1, -1)
    ta_expect(t, near, 0, 0)
}

fn test_the_position_at_a_point_of_an_undrawn_area_is_none(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    testing.is_true(t, text_area_position_at(cx, "area", geometry.point(1.0, 1.0)) == none)
    testing.is_true(t, text_area_point_of(cx, "area", ta_at(0, 0)) == none)
}

fn test_the_point_and_position_queries_leave_the_state_alone(t: *testing.T) {
    let r = ta_open("abcd\nefgh")
    ta_put(r, 1, 1)
    text_area_position_at(r.cx, "area", geometry.point(5.0, 5.0))
    text_area_point_of(r.cx, "area", ta_at(0, 2))
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 1)
}

fn ta_marked(lines: str[], marks: fn(i64) -> TextMark[]) -> scene.Scene {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, lines)
    var src = ta_source(doc)
    src.line_marks = marks
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
}

fn ta_near(got: f32, want: f32) -> bool {
    gap_between(got, want) <= 1.0
}

fn ta_one_mark(start: i64, end: i64, style: MarkStyle) -> fn(i64) -> TextMark[] {
    fn(i: i64) -> TextMark[] {
        if i == 0 { [TextMark { start, end, color: rgb(0xf5c242), style }] } else { [] }
    }
}

fn test_a_run_background_fills_the_run_behind_its_text(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, ["abcdef"])
    var src = ta_source(doc)
    let tint = rgb(0xaaddff)
    src.line_runs = fn(i: i64) -> TextRun[] { [TextRun { start: 2, end: 4, background: tint }] }
    let sc = frame(cx, fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }, geometry.size(320.0, 240.0), 1.0)
    testing.equal(t, sc.quads.len, 1)
    testing.equal(t, sc.quads[0].background.b, tint.b)
    testing.is_true(t, ta_near(sc.quads[0].bounds.x, ta_width("ab")))
    testing.is_true(t, ta_near(sc.quads[0].bounds.width, ta_width("cd")))
    testing.equal(t, sc.quads[0].bounds.height, 26.0)
}

fn test_a_fill_mark_colours_the_stretch_it_covers(t: *testing.T) {
    let sc = ta_marked(["select_name"], ta_one_mark(7, 11, MarkStyle.Fill))
    testing.equal(t, sc.quads.len, 1)
    testing.is_true(t, ta_near(sc.quads[0].bounds.x, ta_width("select_")))
    testing.is_true(t, ta_near(sc.quads[0].bounds.width, ta_width("name")))
    testing.equal(t, sc.quads[0].bounds.y, 0.0)
    testing.equal(t, sc.quads[0].bounds.height, 26.0)
}

fn test_an_underline_mark_is_a_one_pixel_line_at_the_foot_of_the_line(t: *testing.T) {
    let sc = ta_marked(["select_name"], ta_one_mark(7, 11, MarkStyle.Underline))
    testing.equal(t, sc.quads.len, 1)
    testing.is_true(t, ta_near(sc.quads[0].bounds.x, ta_width("select_")))
    testing.is_true(t, ta_near(sc.quads[0].bounds.width, ta_width("name")))
    testing.equal(t, sc.quads[0].bounds.y, 25.0)
    testing.equal(t, sc.quads[0].bounds.height, 1.0)
}

fn test_a_squiggle_mark_is_a_wave_of_one_pixel_quads_under_the_stretch(t: *testing.T) {
    let sc = ta_marked(["select_name"], ta_one_mark(7, 11, MarkStyle.Squiggle))
    let wide = i64(ta_width("name"))
    testing.is_true(t, sc.quads.len >= wide - 1 && sc.quads.len <= wide + 1)
    var low: f32 = 100.0
    var high: f32 = -100.0
    for q in sc.quads {
        testing.equal(t, q.bounds.width, 1.0)
        testing.equal(t, q.bounds.height, 1.0)
        low = if q.bounds.y < low { q.bounds.y } else { low }
        high = if q.bounds.y > high { q.bounds.y } else { high }
    }
    testing.equal(t, low, 23.0)
    testing.equal(t, high, 25.0)
}

fn test_a_squiggle_paints_only_the_columns_inside_the_content_box(t: *testing.T) {
    let long = "the quick brown fox jumps over the lazy dog and keeps running far beyond the box"
    let sc = ta_marked([long], ta_one_mark(0, long.len, MarkStyle.Squiggle))
    testing.is_true(t, sc.quads.len <= 200)
    testing.is_true(t, sc.quads.len >= 198)
}

fn test_a_bar_mark_is_a_line_tall_bar_at_the_end_of_the_stretch(t: *testing.T) {
    let sc = ta_marked(["select_name"], ta_one_mark(7, 11, MarkStyle.Bar))
    testing.equal(t, sc.quads.len, 1)
    testing.is_true(t, ta_near(sc.quads[0].bounds.x, ta_width("select_name")))
    testing.equal(t, sc.quads[0].bounds.width, 1.0)
    testing.equal(t, sc.quads[0].bounds.height, 26.0)
}

fn test_an_empty_mark_draws_a_bar_in_any_style(t: *testing.T) {
    let styles = [MarkStyle.Fill, MarkStyle.Underline, MarkStyle.Squiggle, MarkStyle.Bar]
    for style in styles {
        let sc = ta_marked(["select_name"], ta_one_mark(7, 7, style))
        testing.equal(t, sc.quads.len, 1)
        testing.is_true(t, ta_near(sc.quads[0].bounds.x, ta_width("select_")))
        testing.equal(t, sc.quads[0].bounds.width, 1.0)
        testing.equal(t, sc.quads[0].bounds.height, 26.0)
    }
}

fn test_marks_are_clamped_to_the_line_and_to_cluster_boundaries(t: *testing.T) {
    let past = ta_marked(["abc"], ta_one_mark(1, 99, MarkStyle.Fill))
    testing.equal(t, past.quads.len, 1)
    testing.is_true(t, ta_near(past.quads[0].bounds.width, ta_width("bc")))
    let inside = ta_marked(["éa"], ta_one_mark(1, 3, MarkStyle.Fill))
    testing.equal(t, inside.quads.len, 1)
    testing.equal(t, inside.quads[0].bounds.x, 0.0)
    testing.is_true(t, ta_near(inside.quads[0].bounds.width, ta_width("éa")))
    let backwards = ta_marked(["abc"], ta_one_mark(2, 1, MarkStyle.Fill))
    testing.equal(t, backwards.quads.len, 1)
    testing.equal(t, backwards.quads[0].bounds.width, 1.0)
}

fn test_marks_are_read_for_the_lines_in_view_only(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, strs.split_str(ta_numbered(50), "\n"))
    let asked = signal(cx, 0)
    var src = ta_source(doc)
    src.line_marks = fn(i: i64) -> TextMark[] {
        set(asked, get(asked) + (if i > 5 { 1 } else { 0 }))
        []
    }
    frame(cx, fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }, geometry.size(320.0, 240.0), 1.0)
    testing.equal(t, get(asked), 0)
}

fn test_a_fill_mark_draws_below_the_selection(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, ["select_name"])
    var src = ta_source(doc)
    src.line_marks = fn(i: i64) -> TextMark[] {
        [TextMark { start: 0, end: 6, color: rgb(0xf5c242) }]
    }
    let r = TaRig { cx, doc, view: fn() -> Element { text_area(src).id("area").size(200.0, 104.0) } }
    ta_frame(r)
    set_focus(cx, "area")
    ta_select(r, ta_at(0, 0), ta_at(0, 6))
    let sc = ta_frame(r)
    testing.equal(t, sc.quads[0].background.r, rgb(0xf5c242).r)
    testing.equal(t, sc.quads[0].background.b, rgb(0xf5c242).b)
    var selection = -1
    for i, q in sc.quads {
        if q.background.b > 0.9 && q.background.a < 1.0 {
            selection = i
        }
    }
    testing.is_true(t, selection > 0)
}

struct FoldRig {
    r: TaRig
    fold: Signal[i64[]]
    asked: Signal[i64]
}

fn ta_folded(initial: str, first: i64, last: i64) -> FoldRig {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, strs.split_str(initial, "\n"))
    let fold = signal(cx, [first, last])
    let asked = signal(cx, 0)
    var src = ta_source(doc)
    src.line_hidden = fn(i: i64) -> bool {
        set(asked, get(asked) + 1)
        let span = get(fold)
        i >= span[0] && i <= span[1]
    }
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    set_focus(cx, "area")
    ta_frame(r)
    FoldRig { r, fold, asked }
}

fn ta_glyph_count(r: TaRig) -> i64 {
    ta_glyphs(ta_frame(r))
}

fn test_hidden_lines_take_no_height_and_keep_document_numbers(t: *testing.T) {
    let f = ta_folded(ta_numbered(10), 3, 6)
    let below = text_area_point_of(f.r.cx, "area", ta_at(7, 0)) ?? geometry.Point {}
    testing.equal(t, below.y, 78.0)
    testing.is_true(t, text_area_point_of(f.r.cx, "area", ta_at(4, 0)) == none)
    testing.equal(t, text_area_visible_row(f.r.cx, "area", 2) ?? -1, 2)
    testing.equal(t, text_area_visible_row(f.r.cx, "area", 7) ?? -1, 3)
    testing.is_true(t, text_area_visible_row(f.r.cx, "area", 4) == none)
    testing.is_true(t, text_area_visible_row(f.r.cx, "area", 8) == none)
    let reference = ta_open("line 0\nline 1\nline 2\nline 7")
    testing.equal(t, ta_glyph_count(f.r), ta_glyph_count(reference))
}

fn test_a_click_below_a_fold_lands_on_the_line_drawn_there(t: *testing.T) {
    let f = ta_folded(ta_numbered(10), 3, 6)
    ta_click(f.r, 1.0, 91.0, 1)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 7, 0)
    let found = text_area_position_at(f.r.cx, "area", geometry.point(1.0, 91.0)) ?? ta_at(-1, -1)
    ta_expect(t, found, 7, 0)
    let past = text_area_position_at(f.r.cx, "area", geometry.point(1.0, 500.0)) ?? ta_at(-1, -1)
    ta_expect(t, past, 9, 6)
}

fn test_the_document_end_is_the_last_line_that_is_drawn(t: *testing.T) {
    let f = ta_folded(ta_numbered(10), 8, 9)
    ta_key(f.r, platform.NamedKey.End, false, true)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 7, 6)
    ta_press(f.r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 7, 6)
    let past = text_area_position_at(f.r.cx, "area", geometry.point(1.0, 500.0)) ?? ta_at(-1, -1)
    ta_expect(t, past, 7, 6)
}

fn test_vertical_and_horizontal_moves_skip_hidden_lines(t: *testing.T) {
    let f = ta_folded(ta_numbered(10), 3, 6)
    ta_put(f.r, 2, 2)
    ta_press(f.r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 7, 2)
    ta_press(f.r, platform.NamedKey.Up)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 2, 2)
    ta_press(f.r, platform.NamedKey.End)
    ta_press(f.r, platform.NamedKey.Right)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 7, 0)
    ta_press(f.r, platform.NamedKey.Left)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 2, 6)
    ta_put(f.r, 7, 0)
    ta_key(f.r, platform.NamedKey.Left, false, true)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 2, 6)
}

fn test_moving_up_from_the_first_line_drawn_goes_to_the_start_of_the_document(t: *testing.T) {
    let f = ta_folded(ta_numbered(10), 0, 2)
    ta_put(f.r, 3, 4)
    ta_press(f.r, platform.NamedKey.Up)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 3, 0)
    ta_key(f.r, platform.NamedKey.Home, false, true)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 3, 0)
}

fn test_a_selection_across_a_fold_covers_the_hidden_text(t: *testing.T) {
    let f = ta_folded(ta_numbered(10), 3, 6)
    ta_put(f.r, 2, 0)
    for _ in 0..2 {
        ta_key(f.r, platform.NamedKey.Down, true, false)
    }
    let s = text_area_selection(f.r.cx, "area")
    ta_expect(t, s.anchor, 2, 0)
    ta_expect(t, s.caret, 8, 0)
    ta_ctrl(f.r, "c", false)
    testing.equal(t, clipboard(f.r.cx) ?? "", "line 2\nline 3\nline 4\nline 5\nline 6\nline 7\n")
}

fn test_typing_beside_a_fold_edits_the_document_line(t: *testing.T) {
    let f = ta_folded(ta_numbered(10), 3, 6)
    ta_click(f.r, 1.0, 91.0, 1)
    ta_type(f.r, "X")
    testing.equal(t, strs.split_str(ta_text(f.r), "\n")[7], "Xline 7")
    ta_ctrl(f.r, "z", false)
    testing.equal(t, strs.split_str(ta_text(f.r), "\n")[7], "line 7")
}

fn test_the_wheel_counts_only_the_lines_that_are_drawn(t: *testing.T) {
    let f = ta_folded(ta_numbered(20), 4, 7)
    ta_wheel(f.r, 0.0, 130.0)
    ta_frame(f.r)
    testing.equal(t, text_area_top_line(f.r.cx, "area"), 9)
    testing.equal(t, text_area_top_shift(f.r.cx, "area"), 0.0)
    ta_wheel(f.r, 0.0, -10000.0)
    ta_frame(f.r)
    testing.equal(t, text_area_top_line(f.r.cx, "area"), 0)
    testing.equal(t, text_area_top_shift(f.r.cx, "area"), 0.0)
}

fn test_the_last_view_ends_at_the_last_line_that_is_drawn(t: *testing.T) {
    let f = ta_folded(ta_numbered(20), 15, 18)
    ta_wheel(f.r, 0.0, 10000.0)
    ta_frame(f.r)
    testing.equal(t, text_area_top_line(f.r.cx, "area"), 12)
    let last = text_area_point_of(f.r.cx, "area", ta_at(19, 0)) ?? geometry.Point {}
    testing.equal(t, last.y, 78.0)
}

fn test_a_fold_inside_the_last_view_is_counted_at_the_bottom(t: *testing.T) {
    let f = ta_folded(ta_numbered(20), 17, 19)
    ta_wheel(f.r, 0.0, 10000.0)
    ta_frame(f.r)
    testing.equal(t, text_area_top_line(f.r.cx, "area"), 13)
}

fn test_a_page_key_moves_by_lines_that_are_drawn(t: *testing.T) {
    let f = ta_folded(ta_numbered(20), 1, 4)
    ta_put(f.r, 0, 0)
    ta_press(f.r, platform.NamedKey.PageDown)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 7, 0)
    testing.equal(t, text_area_top_line(f.r.cx, "area"), 7)
    ta_press(f.r, platform.NamedKey.PageUp)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 0, 0)
}

fn test_revealing_a_line_below_a_fold_counts_the_rows_drawn(t: *testing.T) {
    let f = ta_folded(ta_numbered(30), 22, 24)
    set_text_area_selection(f.r.cx, "area", ta_at(25, 0), ta_at(25, 0))
    ta_frame(f.r)
    testing.equal(t, text_area_top_line(f.r.cx, "area"), 19)
}

fn test_a_caret_left_on_a_hidden_line_reveals_the_line_drawn_before_it(t: *testing.T) {
    let f = ta_folded(ta_numbered(30), 22, 24)
    set_text_area_selection(f.r.cx, "area", ta_at(23, 0), ta_at(23, 0))
    ta_frame(f.r)
    testing.equal(t, text_area_top_line(f.r.cx, "area"), 18)
    testing.is_true(t, text_input(f.r.cx) == none)
    ta_press(f.r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(f.r.cx, "area").caret, 25, 0)
}

fn test_a_first_line_hidden_between_frames_moves_to_the_line_drawn_before_it(t: *testing.T) {
    let f = ta_folded(ta_numbered(20), 40, 41)
    scroll_text_area_to_line(f.r.cx, "area", 5)
    ta_frame(f.r)
    testing.equal(t, text_area_top_line(f.r.cx, "area"), 5)
    set(f.fold, [3, 8])
    ta_frame(f.r)
    testing.equal(t, text_area_top_line(f.r.cx, "area"), 2)
    set(f.fold, [0, 2])
    scroll_text_area_to_line(f.r.cx, "area", 1)
    ta_frame(f.r)
    testing.equal(t, text_area_top_line(f.r.cx, "area"), 3)
}

fn test_add_cursor_below_skips_a_fold_and_draws_each_caret_where_its_line_is(t: *testing.T) {
    let f = ta_folded(ta_numbered(10), 3, 6)
    ta_put(f.r, 2, 0)
    ta_chord(f.r, platform.NamedKey.Down, false, true, true)
    ta_expect_carets(t, f.r, [ta_at(2, 0), ta_at(7, 0)])
    ta_chord(f.r, platform.NamedKey.Down, false, true, true)
    ta_expect_carets(t, f.r, [ta_at(2, 0), ta_at(7, 0), ta_at(8, 0)])
    var ys: f32[] = []
    for q in ta_frame(f.r).quads {
        if q.bounds.width == 1.0 {
            ys.push(q.bounds.y)
        }
    }
    testing.equal(t, ys.len, 2)
    testing.is_true(t, ys[0] == 52.0 || ys[1] == 52.0)
    testing.is_true(t, ys[0] == 78.0 || ys[1] == 78.0)
}

fn test_an_alt_drag_across_a_fold_selects_the_lines_that_are_drawn(t: *testing.T) {
    let f = ta_folded(ta_numbered(10), 3, 6)
    let alt = platform.Modifiers { alt: true }
    ta_down_with(f.r, 1.0, 65.0, 1, alt)
    dispatch(f.r.cx, platform.Event.PointerMoved(20.0, 91.0))
    ta_up_with(f.r, 20.0, 91.0, alt)
    let got = text_area_selections(f.r.cx, "area")
    testing.equal(t, got.len, 2)
    testing.equal(t, got[0].caret.line, 2)
    testing.equal(t, got[1].caret.line, 7)
}

fn test_the_visible_row_of_a_line_is_none_without_a_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    testing.is_true(t, text_area_visible_row(cx, "area", 0) == none)
}

fn test_a_document_of_a_million_lines_asks_about_the_lines_in_view_only(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let asked = signal(cx, 0)
    let src = line_source(fn() -> i64 { 1000000 }, fn(i: i64) -> str { "line" }, fn(ed: TextEdit) {})
    var counted = src
    counted.line_hidden = fn(i: i64) -> bool {
        set(asked, get(asked) + 1)
        false
    }
    let view = fn() -> Element { text_area(counted).id("area").size(200.0, 104.0) }
    let r = TaRig { cx, doc: signal(cx, ["x"]), view }
    ta_frame(r)
    set_focus(cx, "area")
    ta_frame(r)
    ta_key(r, platform.NamedKey.End, false, true)
    ta_frame(r)
    ta_wheel(r, 0.0, 5000.0)
    ta_frame(r)
    set_text_area_selection(cx, "area", ta_at(500000, 0), ta_at(500000, 0))
    ta_frame(r)
    testing.equal(t, text_area_top_line(cx, "area"), 500000)
    testing.is_true(t, get(asked) < 500)
}
