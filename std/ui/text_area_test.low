import std/testing
import std/ui/geometry
import std/ui/layout
import std/ui/platform
import std/ui/scene
import std/unicode
import strs = std/text
import uitext = std/ui/text

struct TaRig {
    cx: Context
    doc: Signal[str[]]
    view: fn() -> Element
}

fn ta_apply(doc: Signal[str[]], ed: TextEdit) {
    let lines = get(doc)
    let head = lines[ed.start.line][..ed.start.column]
    let tail = lines[ed.end.line][ed.end.column..]
    let joined = "{head}{ed.text}{tail}"
    let parts = strs.split_str(joined, "\n")
    var out: str[] = []
    for i in 0..ed.start.line {
        out.push(lines[i])
    }
    for p in parts {
        out.push(p)
    }
    let resume = ed.end.line + 1
    for i in resume..lines.len {
        out.push(lines[i])
    }
    set(doc, out)
}

fn ta_source(doc: Signal[str[]]) -> LineSource {
    let count = fn() -> i64 { get(doc).len }
    let line = fn(i: i64) -> str { get(doc)[i] }
    let edit = fn(ed: TextEdit) { ta_apply(doc, ed) }
    line_source(count, line, edit)
}

fn ta_frame(r: TaRig) -> scene.Scene {
    frame(r.cx, r.view, geometry.size(320.0, 240.0), 1.0)
}

fn ta_open(initial: str) -> TaRig {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, strs.split_str(initial, "\n"))
    let src = ta_source(doc)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    set_focus(cx, "area")
    ta_frame(r)
    r
}

fn ta_text(r: TaRig) -> str {
    strs.join(get(r.doc), "\n")
}

fn ta_key(r: TaRig, n: platform.NamedKey, shift: bool, control: bool) {
    let mods = platform.Modifiers { shift: shift, control: control }
    dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(n), modifiers: mods }))
}

fn ta_press(r: TaRig, n: platform.NamedKey) {
    ta_key(r, n, false, false)
}

fn ta_type(r: TaRig, s: str) {
    dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn ta_ctrl(r: TaRig, letter: str, shift: bool) {
    let mods = platform.Modifiers { control: true, shift: shift }
    dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(letter), modifiers: mods }))
}

fn ta_put(r: TaRig, line: i64, column: i64) {
    let p = TextPosition { line, column }
    set_text_area_selection(r.cx, "area", p, p)
    ta_frame(r)
}

fn ta_select(r: TaRig, from: TextPosition, to: TextPosition) {
    set_text_area_selection(r.cx, "area", from, to)
    ta_frame(r)
}

fn ta_at(line: i64, column: i64) -> TextPosition {
    TextPosition { line, column }
}

fn ta_expect(t: *testing.T, got: TextPosition, line: i64, column: i64) {
    testing.equal(t, got.line, line)
    testing.equal(t, got.column, column)
}

fn ta_width(s: str) -> f32 {
    var sys = uitext.default_system()
    uitext.measure(mut sys, s, uitext.Style {}, layout.unbounded).width
}

fn ta_down(r: TaRig, x: f32, y: f32, clicks: i64, shift: bool) {
    let mods = platform.Modifiers { shift: shift }
    dispatch(r.cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: x, y: y, clicks: clicks, modifiers: mods }))
}

fn ta_up(r: TaRig, x: f32, y: f32, clicks: i64) {
    dispatch(r.cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: x, y: y, clicks: clicks }))
}

fn ta_click(r: TaRig, x: f32, y: f32, clicks: i64) {
    ta_down(r, x, y, clicks, false)
    ta_up(r, x, y, clicks)
}

fn ta_wheel(r: TaRig, dx: f32, dy: f32) {
    dispatch(r.cx, platform.Event.PointerMoved(10.0, 10.0))
    dispatch(r.cx, platform.Event.Scrolled(dx, dy))
}

fn ta_numbered(n: i64) -> str {
    var out = ""
    for i in 0..n {
        let gap = if i == 0 { "" } else { "\n" }
        out = "{out}{gap}line {i}"
    }
    out
}

fn test_typing_and_enter_edit_the_document_through_the_source(t: *testing.T) {
    let r = ta_open("ab")
    ta_press(r, platform.NamedKey.End)
    ta_type(r, "X")
    testing.equal(t, ta_text(r), "abX")
    ta_press(r, platform.NamedKey.Enter)
    testing.equal(t, ta_text(r), "abX\n")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_type(r, "c")
    ta_press(r, platform.NamedKey.Left)
    ta_press(r, platform.NamedKey.Enter)
    testing.equal(t, ta_text(r), "abX\n\nc")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 0)
}

fn test_backspace_and_delete_join_lines(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_put(r, 1, 0)
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "abcd\nef")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 2)
    ta_press(r, platform.NamedKey.End)
    ta_press(r, platform.NamedKey.Delete)
    testing.equal(t, ta_text(r), "abcdef")
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "abcef")
}

fn test_control_backspace_and_delete_remove_a_word(t: *testing.T) {
    let r = ta_open("one two\nthree")
    ta_put(r, 0, 7)
    ta_key(r, platform.NamedKey.Backspace, false, true)
    testing.equal(t, ta_text(r), "one \nthree")
    ta_put(r, 0, 0)
    ta_key(r, platform.NamedKey.Delete, false, true)
    testing.equal(t, ta_text(r), " \nthree")
}

fn test_arrows_cross_line_ends_and_collapse_selections(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_put(r, 0, 2)
    ta_press(r, platform.NamedKey.Right)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_press(r, platform.NamedKey.Left)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 2)
    ta_key(r, platform.NamedKey.Right, true, false)
    ta_key(r, platform.NamedKey.Right, true, false)
    let selected = text_area_selection(r.cx, "area")
    ta_expect(t, selected.anchor, 0, 2)
    ta_expect(t, selected.caret, 1, 1)
    ta_press(r, platform.NamedKey.Left)
    let collapsed = text_area_selection(r.cx, "area")
    ta_expect(t, collapsed.anchor, 0, 2)
    ta_expect(t, collapsed.caret, 0, 2)
}

fn test_word_moves_cross_lines(t: *testing.T) {
    let r = ta_open("one two\nthree")
    ta_put(r, 0, 0)
    ta_key(r, platform.NamedKey.Right, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 3)
    ta_key(r, platform.NamedKey.Right, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 7)
    ta_key(r, platform.NamedKey.Right, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_key(r, platform.NamedKey.Left, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 7)
    ta_key(r, platform.NamedKey.Left, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 4)
}

fn test_vertical_moves_keep_the_preferred_column(t: *testing.T) {
    let r = ta_open("abcdef\nab\nabcdef")
    ta_put(r, 0, 4)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 2)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 4)
    ta_press(r, platform.NamedKey.Up)
    ta_press(r, platform.NamedKey.Up)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 4)
    ta_press(r, platform.NamedKey.Up)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
    ta_put(r, 2, 3)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 6)
}

fn test_a_horizontal_move_resets_the_preferred_column(t: *testing.T) {
    let r = ta_open("abcdef\nab\nabcdef")
    ta_put(r, 0, 4)
    ta_press(r, platform.NamedKey.Down)
    ta_press(r, platform.NamedKey.Left)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 1)
}

fn test_shift_vertical_moves_select_across_lines(t: *testing.T) {
    let r = ta_open("abc\ndef\nghi")
    ta_put(r, 0, 1)
    ta_key(r, platform.NamedKey.Down, true, false)
    ta_key(r, platform.NamedKey.Down, true, false)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 1)
    ta_expect(t, s.caret, 2, 1)
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "aZhi")
}

fn test_home_end_and_document_edges(t: *testing.T) {
    let r = ta_open("abc\ndef\nghi")
    ta_put(r, 1, 1)
    ta_press(r, platform.NamedKey.End)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 3)
    ta_press(r, platform.NamedKey.Home)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_key(r, platform.NamedKey.End, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 3)
    ta_key(r, platform.NamedKey.Home, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
    ta_key(r, platform.NamedKey.End, true, true)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 0)
    ta_expect(t, s.caret, 2, 3)
}

fn test_page_keys_move_by_the_rows_in_view_less_one(t: *testing.T) {
    let r = ta_open(ta_numbered(20))
    ta_press(r, platform.NamedKey.PageDown)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 3, 0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 3)
    ta_press(r, platform.NamedKey.PageDown)
    ta_press(r, platform.NamedKey.PageDown)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 9, 0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 9)
    ta_press(r, platform.NamedKey.PageUp)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 6, 0)
    ta_key(r, platform.NamedKey.PageUp, true, false)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 6, 0)
    ta_expect(t, s.caret, 3, 0)
}

fn test_select_all_and_typing_replace_every_line(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_ctrl(r, "a", false)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 0)
    ta_expect(t, s.caret, 2, 2)
    ta_type(r, "z")
    testing.equal(t, ta_text(r), "z")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab\ncd\nef")
    let restored = text_area_selection(r.cx, "area")
    ta_expect(t, restored.anchor, 0, 0)
    ta_expect(t, restored.caret, 2, 2)
}

fn test_a_click_places_the_caret_on_the_line_and_column_under_it(t: *testing.T) {
    let r = ta_open("abcd\nefgh\nijkl")
    ta_click(r, ta_width("ef") + 0.1, 39.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 2)
    ta_frame(r)
    ta_click(r, 190.0, 65.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 4)
    ta_frame(r)
    ta_click(r, 1.0, 3.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
}

fn test_a_double_click_selects_a_word_and_a_triple_click_a_line(t: *testing.T) {
    let r = ta_open("hello world\nsecond\nlast")
    ta_click(r, ta_width("hello wo"), 13.0, 2)
    var s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 6)
    ta_expect(t, s.caret, 0, 11)
    ta_frame(r)
    ta_click(r, 5.0, 39.0, 3)
    s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 1, 0)
    ta_expect(t, s.caret, 2, 0)
    ta_frame(r)
    ta_click(r, 5.0, 65.0, 3)
    s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 2, 0)
    ta_expect(t, s.caret, 2, 4)
}

fn test_dragging_selects_across_lines_and_shift_click_extends(t: *testing.T) {
    let r = ta_open("abcd\nefgh\nijkl")
    ta_down(r, ta_width("ab") + 0.1, 13.0, 1, false)
    dispatch(r.cx, platform.Event.PointerMoved(ta_width("i") + 0.1, 65.0))
    ta_up(r, ta_width("i") + 0.1, 65.0, 1)
    var s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 2)
    ta_expect(t, s.caret, 2, 1)
    ta_frame(r)
    ta_down(r, ta_width("ef") + 0.1, 39.0, 1, true)
    ta_up(r, ta_width("ef") + 0.1, 39.0, 1)
    s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 2)
    ta_expect(t, s.caret, 1, 2)
}

fn test_a_drag_after_a_double_click_keeps_the_word_selected(t: *testing.T) {
    let r = ta_open("hello world\nsecond")
    ta_down(r, ta_width("hello wo"), 13.0, 2, false)
    dispatch(r.cx, platform.Event.PointerMoved(5.0, 39.0))
    ta_up(r, 5.0, 39.0, 2)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 6)
    ta_expect(t, s.caret, 0, 11)
}

fn test_copy_cut_and_paste_keep_line_breaks(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_select(r, ta_at(0, 1), ta_at(2, 1))
    ta_ctrl(r, "c", false)
    testing.equal(t, clipboard(r.cx) ?? "", "b\ncd\ne")
    ta_ctrl(r, "x", false)
    testing.equal(t, ta_text(r), "af")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
    ta_ctrl(r, "v", false)
    testing.equal(t, ta_text(r), "ab\ncd\nef")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 1)
}

fn test_paste_normalises_line_breaks_and_drops_control_characters(t: *testing.T) {
    let r = ta_open("")
    set_clipboard(r.cx, "x\r\ny\rz\u0001w\tq")
    ta_ctrl(r, "v", false)
    testing.equal(t, ta_text(r), "x\ny\nzw\tq")
    ta_type(r, "\n")
    testing.equal(t, ta_text(r), "x\ny\nzw\tq")
}

fn test_tab_inserts_a_tab_character(t: *testing.T) {
    let r = ta_open("ab")
    ta_press(r, platform.NamedKey.Tab)
    testing.equal(t, ta_text(r), "\tab")
}

fn test_unbinding_tab_lets_it_move_focus(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let tab_binding = key_binding("tab", "", "TextArea") catch {
        err => panic("binding")
    }
    bind_keys(cx, [tab_binding])
    let doc = signal(cx, ["ab"])
    let src = ta_source(doc)
    let view = fn() -> Element {
        column(div()).children() {
            text_area(src).id("area").size(200.0, 104.0),
            div().id("next").focusable().size(200.0, 20.0),
        }
    }
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    set_focus(cx, "area")
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "next")
    testing.equal(t, get(doc)[0], "ab")
}

fn test_typing_groups_into_one_undo_step(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    ta_type(r, "b")
    ta_type(r, "c")
    testing.equal(t, ta_text(r), "abc")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "")
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "abc")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 3)
    ta_ctrl(r, "z", false)
    ta_ctrl(r, "z", true)
    testing.equal(t, ta_text(r), "abc")
}

fn test_a_caret_move_ends_the_undo_group(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    ta_type(r, "b")
    ta_press(r, platform.NamedKey.Left)
    ta_type(r, "X")
    testing.equal(t, ta_text(r), "aXb")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "")
}

fn test_a_click_ends_the_undo_group(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    ta_frame(r)
    ta_click(r, 190.0, 13.0, 1)
    ta_type(r, "b")
    testing.equal(t, ta_text(r), "ab")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a")
}

fn test_runs_of_backspace_and_of_delete_group_separately(t: *testing.T) {
    let r = ta_open("abcdef")
    ta_press(r, platform.NamedKey.End)
    ta_press(r, platform.NamedKey.Backspace)
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "abcd")
    ta_press(r, platform.NamedKey.Delete)
    ta_put(r, 0, 0)
    ta_press(r, platform.NamedKey.Delete)
    ta_press(r, platform.NamedKey.Delete)
    testing.equal(t, ta_text(r), "cd")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abcd")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abcdef")
}

fn test_enter_and_paste_are_their_own_undo_steps(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    ta_press(r, platform.NamedKey.Enter)
    ta_type(r, "b")
    ta_type(r, "c")
    set_clipboard(r.cx, "ZZ")
    ta_ctrl(r, "v", false)
    testing.equal(t, ta_text(r), "a\nbcZZ")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a\nbc")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a\n")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "")
}

fn test_a_pause_ends_the_undo_group_and_a_new_edit_drops_the_redo_steps(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    advance_clock(r.cx, 400)
    ta_type(r, "b")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a")
    ta_type(r, "c")
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "ac")
}

fn test_undo_restores_a_cut_selection(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_select(r, ta_at(0, 1), ta_at(1, 1))
    ta_ctrl(r, "x", false)
    testing.equal(t, ta_text(r), "ad")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab\ncd")
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 1)
    ta_expect(t, s.caret, 1, 1)
}

fn test_the_caret_and_a_selection_across_lines_are_painted(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    let plain = ta_frame(r)
    testing.equal(t, plain.quads.len, 1)
    testing.equal(t, plain.quads[0].bounds.width, 1.0)
    testing.equal(t, plain.quads[0].bounds.height, 26.0)
    ta_select(r, ta_at(0, 1), ta_at(2, 1))
    let selected = ta_frame(r)
    testing.equal(t, selected.quads.len, 4)
    testing.is_true(t, selected.quads[0].background.a < 1.0)
    testing.equal(t, selected.quads[0].bounds.y, 0.0)
    testing.equal(t, selected.quads[1].bounds.y, 26.0)
    testing.equal(t, selected.quads[2].bounds.y, 52.0)
    testing.equal(t, selected.quads[1].bounds.x, 0.0)
    testing.is_true(t, selected.quads[1].bounds.width > ta_width("cd"))
    testing.equal(t, selected.quads[3].bounds.width, 1.0)
}

fn test_a_composition_is_shown_at_the_caret_until_it_is_committed(t: *testing.T) {
    let r = ta_open("ab")
    ta_press(r, platform.NamedKey.End)
    let plain = ta_frame(r)
    let start = (text_input(r.cx) ?? platform.Caret {}).x
    dispatch(r.cx, platform.Event.Preedit("ni", platform.TextRange { start: 0, end: 2 }))
    let composing = ta_frame(r)
    testing.equal(t, ta_text(r), "ab")
    testing.is_true(t, composing.sprites.len > plain.sprites.len)
    testing.equal(t, composing.quads.len, plain.quads.len + 1)
    testing.is_true(t, (text_input(r.cx) ?? platform.Caret {}).x > start)
    let word = unicode.encode_rune(0x4f60)
    dispatch(r.cx, platform.Event.Commit(word))
    testing.equal(t, ta_text(r), "ab{word}")
    let committed = ta_frame(r)
    testing.equal(t, committed.quads.len, plain.quads.len)
    dispatch(r.cx, platform.Event.Preedit("", none))
    testing.equal(t, ta_frame(r).sprites.len, committed.sprites.len)
}

fn test_a_commit_replaces_the_selection_and_a_second_line_takes_text(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_select(r, ta_at(0, 1), ta_at(1, 1))
    dispatch(r.cx, platform.Event.Commit("Q"))
    testing.equal(t, ta_text(r), "aQd")
    dispatch(r.cx, platform.Event.Commit("x\ny"))
    testing.equal(t, ta_text(r), "aQx\nyd")
}

fn test_the_view_scrolls_vertically_to_keep_the_caret_in_view(t: *testing.T) {
    let r = ta_open(ta_numbered(20))
    ta_key(r, platform.NamedKey.End, false, true)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 16)
    let caret = text_input(r.cx) ?? platform.Caret {}
    testing.equal(t, caret.y, 78)
    ta_key(r, platform.NamedKey.Home, false, true)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 0)
    testing.equal(t, (text_input(r.cx) ?? platform.Caret {}).y, 0)
    ta_put(r, 5, 0)
    ta_press(r, platform.NamedKey.Down)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 3)
}

fn test_the_view_scrolls_horizontally_to_keep_the_caret_in_view(t: *testing.T) {
    let r = ta_open("the quick brown fox jumps over the lazy dog and keeps running\nshort")
    ta_press(r, platform.NamedKey.End)
    ta_frame(r)
    let caret = text_input(r.cx) ?? platform.Caret {}
    testing.is_true(t, caret.x >= 150 && caret.x <= 200)
    testing.is_true(t, area_state(r.cx.state, "area").scroll_x > 0.0)
    ta_press(r, platform.NamedKey.Home)
    ta_frame(r)
    testing.is_true(t, (text_input(r.cx) ?? platform.Caret {}).x < 2)
    testing.equal(t, area_state(r.cx.state, "area").scroll_x, 0.0)
}

fn test_the_wheel_scrolls_and_stops_at_the_ends(t: *testing.T) {
    let r = ta_open(ta_numbered(20))
    ta_wheel(r, 0.0, 30.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 1)
    testing.equal(t, area_state(r.cx.state, "area").shift, 4.0)
    ta_wheel(r, 0.0, -100.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 0)
    ta_wheel(r, 0.0, 10000.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 16)
    testing.equal(t, area_state(r.cx.state, "area").shift, 0.0)
}

fn test_a_wheel_does_not_move_a_document_that_fits(t: *testing.T) {
    let r = ta_open("a\nb")
    ta_wheel(r, 0.0, 30.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 0)
    testing.equal(t, area_state(r.cx.state, "area").shift, 0.0)
    testing.is_false(t, frame_due(r.cx))
}

fn test_wheeling_away_does_not_pull_the_caret_back_into_view(t: *testing.T) {
    let r = ta_open(ta_numbered(40))
    ta_wheel(r, 0.0, 520.0)
    ta_frame(r)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 20)
    testing.is_true(t, text_input(r.cx) == none)
}

fn test_styled_runs_reach_the_scene(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, ["abcdef", "ghij"])
    var src = ta_source(doc)
    let red = rgb(0xff0000)
    let runs = fn(i: i64) -> TextRun[] {
        if i == 0 { [TextRun { start: 2, end: 4, color: red }, TextRun { start: 4, end: 5, weight: 700 }] } else { [] }
    }
    src.line_runs = runs
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let sc = frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    var tinted = 0
    var plain = 0
    for s in sc.sprites {
        if s.color.r == 1.0 && s.color.g == 0.0 {
            tinted += 1
        } else {
            plain += 1
        }
    }
    testing.equal(t, tinted, 2)
    testing.equal(t, plain, 8)
    let bare = headless(rgb(0xffffff))
    let bare_doc = signal(bare, ["abcdef", "ghij"])
    let bare_src = ta_source(bare_doc)
    let bare_view = fn() -> Element { text_area(bare_src).id("area").size(200.0, 104.0) }
    let reference = frame(bare, bare_view, geometry.size(320.0, 240.0), 1.0)
    testing.equal(t, reference.sprites.len, sc.sprites.len)
}

fn test_a_line_decoration_fills_the_whole_line(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, ["abc", "def", "ghi"])
    var src = ta_source(doc)
    let tint = rgb(0xffeeaa)
    let fill = fn(i: i64) -> geometry.Color? { if i == 1 { tint } else { none } }
    src.line_fill = fill
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let sc = frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    testing.equal(t, sc.quads.len, 1)
    testing.equal(t, sc.quads[0].bounds.x, 0.0)
    testing.equal(t, sc.quads[0].bounds.y, 26.0)
    testing.equal(t, sc.quads[0].bounds.width, 200.0)
    testing.equal(t, sc.quads[0].bounds.height, 26.0)
    testing.equal(t, sc.quads[0].background.r, tint.r)
}

fn test_an_action_can_be_rebound(t: *testing.T) {
    let r = ta_open("ab")
    clear_key_bindings(r.cx)
    let join_line = key_binding("ctrl-j", "text_area.new_line", "TextArea") catch {
        err => panic("binding")
    }
    bind_keys(r.cx, [join_line])
    ta_press(r, platform.NamedKey.Enter)
    testing.equal(t, ta_text(r), "ab")
    ta_ctrl(r, "j", false)
    testing.equal(t, ta_text(r), "\nab")
    ta_press(r, platform.NamedKey.Left)
    testing.equal(t, ta_text(r), "\nab")
}

fn test_the_text_area_context_survives_another_key_context(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, ["ab"])
    let src = ta_source(doc)
    let view = fn() -> Element { text_area(src).id("area").key_context("Editor").size(200.0, 104.0) }
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    set_focus(cx, "area")
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    let save = key_binding("ctrl-s", "editor.save", "Editor && TextArea") catch {
        err => panic("binding")
    }
    bind_keys(cx, [save])
    let saved = signal(cx, 0)
    let wrapped = fn() -> Element {
        let inner = text_area(src).id("area").key_context("Editor").size(200.0, 104.0)
        div().on_action("editor.save", fn() { set(saved, get(saved) + 1) }).child(inner)
    }
    frame(cx, wrapped, geometry.size(320.0, 240.0), 1.0)
    set_focus(cx, "area")
    frame(cx, wrapped, geometry.size(320.0, 240.0), 1.0)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("s"), modifiers: platform.Modifiers { control: true } }))
    testing.equal(t, get(saved), 1)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("x"), text: "x" }))
    testing.equal(t, get(doc)[0], "xab")
}

fn test_an_on_action_handler_runs_before_the_built_in_one(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, ["ab"])
    let src = ta_source(doc)
    let seen = signal(cx, 0)
    let count_up = fn() { set(seen, get(seen) + 1) }
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0).on_action("text_area.backspace", count_up) }
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    set_focus(cx, "area")
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    set_text_area_selection(cx, "area", TextPosition { line: 0, column: 2 }, TextPosition { line: 0, column: 2 })
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Backspace) }))
    testing.equal(t, get(seen), 1)
    testing.equal(t, get(doc)[0], "ab")
}

fn test_the_built_in_actions_are_available_and_dispatchable(t: *testing.T) {
    let r = ta_open("ab\ncd")
    testing.is_true(t, is_action_available(r.cx, "text_area.undo"))
    testing.is_false(t, is_action_available(r.cx, "editor.save"))
    let names = available_actions(r.cx)
    testing.is_true(t, names.len > 30)
    testing.is_true(t, dispatch_action(r.cx, "text_area.select_all"))
    testing.equal(t, text_area_selection(r.cx, "area").caret.line, 1)
    testing.is_false(t, dispatch_action(r.cx, "text_area.unknown"))
}

fn test_a_text_area_without_a_focus_ignores_keys(t: *testing.T) {
    let r = ta_open("ab")
    blur(r.cx)
    ta_frame(r)
    ta_type(r, "x")
    dispatch(r.cx, platform.Event.Commit("y"))
    testing.equal(t, ta_text(r), "ab")
    testing.is_true(t, text_input(r.cx) == none)
}

fn test_only_the_visible_lines_are_read_from_a_huge_document(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let reads = signal(cx, 0)
    let low = signal(cx, 1000000000)
    let high = signal(cx, -1)
    let count = fn() -> i64 { 1000000 }
    let line = fn(i: i64) -> str {
        set(reads, get(reads) + 1)
        if i < get(low) {
            set(low, i)
        }
        if i > get(high) {
            set(high, i)
        }
        "line {i}"
    }
    let edit = fn(ed: TextEdit) {}
    let src = line_source(count, line, edit)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let size = geometry.size(320.0, 240.0)
    frame(cx, view, size, 1.0)
    testing.is_true(t, get(reads) <= 6)
    testing.equal(t, get(low), 0)
    testing.is_true(t, get(high) <= 4)
    set_focus(cx, "area")
    frame(cx, view, size, 1.0)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.End), modifiers: platform.Modifiers { control: true } }))
    set(reads, 0)
    set(low, 1000000000)
    set(high, -1)
    frame(cx, view, size, 1.0)
    testing.is_true(t, get(reads) <= 6)
    testing.equal(t, get(high), 999999)
    testing.is_true(t, get(low) >= 999995)
    let caret = text_input(cx) ?? platform.Caret {}
    testing.is_true(t, text_input(cx) != none)
    testing.is_true(t, caret.y >= 0 && caret.y < 104)
    testing.equal(t, text_area_top_line(cx, "area"), 999996)
    scroll_text_area_to_line(cx, "area", 500000)
    set(reads, 0)
    set(low, 1000000000)
    set(high, -1)
    frame(cx, view, size, 1.0)
    testing.is_true(t, get(reads) <= 6)
    testing.is_true(t, get(low) >= 500000)
    testing.is_true(t, get(high) <= 500004)
    testing.is_true(t, text_input(cx) == none)
    dispatch(cx, platform.Event.PointerMoved(10.0, 10.0))
    dispatch(cx, platform.Event.Scrolled(0.0, 52.0))
    set(reads, 0)
    set(low, 1000000000)
    set(high, -1)
    frame(cx, view, size, 1.0)
    testing.is_true(t, get(low) >= 500002)
    testing.is_true(t, get(high) <= 500006)
}

fn test_a_click_in_a_huge_document_reads_one_line(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let reads = signal(cx, 0)
    let count = fn() -> i64 { 1000000 }
    let line = fn(i: i64) -> str {
        set(reads, get(reads) + 1)
        "line {i}"
    }
    let edit = fn(ed: TextEdit) {}
    let src = line_source(count, line, edit)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let size = geometry.size(320.0, 240.0)
    scroll_text_area_to_line(cx, "area", 700000)
    frame(cx, view, size, 1.0)
    set(reads, 0)
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { x: 5.0, y: 40.0 }))
    testing.equal(t, get(reads), 1)
    testing.equal(t, text_area_selection(cx, "area").caret.line, 700001)
}

struct TaGate {
    rig: TaRig
    mode: Signal[i64]
}

fn ta_gated(initial: str) -> TaGate {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, strs.split_str(initial, "\n"))
    let gate = signal(cx, 0)
    let count = fn() -> i64 { get(doc).len }
    let line = fn(i: i64) -> str { get(doc)[i] }
    let edit = fn(ed: TextEdit) {
        let mode = get(gate)
        if mode == 0 {
            ta_apply(doc, ed)
        } else if mode == 2 {
            ta_apply(doc, TextEdit { start: ed.start, end: ed.end, text: "#" })
        }
    }
    let src = line_source(count, line, edit)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    set_focus(cx, "area")
    ta_frame(r)
    TaGate { rig: r, mode: gate }
}

fn test_a_document_that_shrinks_between_frames_does_not_leave_the_caret_outside_it(t: *testing.T) {
    let r = ta_open("a\nb\nlonger")
    ta_put(r, 2, 5)
    set(r.doc, ["x"])
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "xZ")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 2)
    ta_put(r, 0, 2)
    set(r.doc, ["x", "y", "z"])
    ta_put(r, 2, 1)
    set(r.doc, ["q"])
    ta_frame(r)
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "")
}

fn test_a_line_shortened_under_the_caret_takes_enter_and_typing_at_its_end(t: *testing.T) {
    let r = ta_open("abcdef\nlast")
    ta_press(r, platform.NamedKey.End)
    set(r.doc, ["ab", "last"])
    ta_press(r, platform.NamedKey.Enter)
    testing.equal(t, ta_text(r), "ab\n\nlast")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_put(r, 0, 2)
    set(r.doc, ["a", "", "last"])
    ta_type(r, "Q")
    testing.equal(t, ta_text(r), "aQ\n\nlast")
}

fn test_a_selection_set_past_the_end_of_a_line_is_clamped_before_typing(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_select(r, ta_at(0, 1), ta_at(0, 99))
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 2)
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "aZ\ncd")
    set_text_area_selection(r.cx, "area", ta_at(0, 0), ta_at(7, 3))
    ta_type(r, "Y")
    testing.equal(t, ta_text(r), "Y")
}

fn test_a_column_inside_a_multi_byte_character_moves_to_its_start(t: *testing.T) {
    let r = ta_open("abcdef")
    ta_put(r, 0, 1)
    let accented = unicode.encode_rune(0xe9)
    set(r.doc, ["{accented}a"])
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "Z{accented}a")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
}

fn test_an_ignored_insertion_leaves_the_text_alone_when_undone(t: *testing.T) {
    let g = ta_gated("abcd")
    let r = g.rig
    ta_put(r, 0, 1)
    set(g.mode, 1)
    ta_type(r, "Y")
    testing.equal(t, ta_text(r), "abcd")
    set(g.mode, 0)
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abcd")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
}

fn test_an_altered_edit_drops_the_history_and_keeps_the_caret_in_the_text(t: *testing.T) {
    let g = ta_gated("abcd")
    let r = g.rig
    ta_put(r, 0, 1)
    set(g.mode, 2)
    ta_type(r, "YY")
    testing.equal(t, ta_text(r), "a#bcd")
    set(g.mode, 0)
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a#bcd")
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "a#bcd")
    let caret = text_area_selection(r.cx, "area").caret
    testing.is_true(t, caret.line == 0 && caret.column <= 5)
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "aZ#bcd")
}

fn test_an_ignored_deletion_drops_the_history_too(t: *testing.T) {
    let g = ta_gated("abc")
    let r = g.rig
    ta_type(r, "X")
    set(g.mode, 1)
    ta_press(r, platform.NamedKey.Delete)
    testing.equal(t, ta_text(r), "Xabc")
    set(g.mode, 0)
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "Xabc")
}

fn test_an_ancestor_capture_handler_can_stop_a_text_area_action(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, ["ab"])
    let src = ta_source(doc)
    let captured = signal(cx, 0)
    let bubbled = signal(cx, 0)
    let stop = signal(cx, false)
    let capture = fn() {
        set(captured, get(captured) + 1)
        if get(stop) {
            stop_propagation(cx)
        }
    }
    let bubble = fn() { set(bubbled, get(bubbled) + 1) }
    let view = fn() -> Element {
        let inner = text_area(src).id("area").size(200.0, 104.0)
        div().capture_action("text_area.tab", capture).on_action("text_area.tab", bubble).child(inner)
    }
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    set_focus(cx, "area")
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Tab) }))
    testing.equal(t, get(captured), 1)
    testing.equal(t, get(bubbled), 0)
    testing.equal(t, get(doc)[0], "\tab")
    set(stop, true)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Tab) }))
    testing.equal(t, get(captured), 2)
    testing.equal(t, get(bubbled), 0)
    testing.equal(t, get(doc)[0], "\tab")
}

fn test_a_composition_over_a_multi_line_selection_removes_it_and_shows_at_the_caret(t: *testing.T) {
    let r = ta_open("abc\ndef\nghi\njkl")
    ta_select(r, ta_at(0, 1), ta_at(2, 1))
    dispatch(r.cx, platform.Event.Preedit("zz", platform.TextRange { start: 0, end: 2 }))
    let composing = ta_frame(r)
    testing.equal(t, ta_text(r), "ahi\njkl")
    let reference = ta_open("azzhi\njkl")
    let shown = ta_frame(reference)
    testing.equal(t, composing.sprites.len, shown.sprites.len)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
    testing.equal(t, (text_input(r.cx) ?? platform.Caret {}).x, i64(floor(ta_width("azz"))))
    testing.equal(t, composing.quads.len, 2)
    dispatch(r.cx, platform.Event.Commit("zz"))
    testing.equal(t, ta_text(r), "azzhi\njkl")
}

fn test_a_click_below_the_last_line_goes_to_the_end_and_above_the_box_to_the_start(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, strs.split_str(ta_numbered(20), "\n"))
    let src = ta_source(doc)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 124.0).padding(10.0) }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    ta_click(r, 2.0, 100.0, 1)
    ta_expect(t, text_area_selection(cx, "area").caret, 3, 0)
    ta_frame(r)
    ta_click(r, 2.0, 4.0, 1)
    ta_expect(t, text_area_selection(cx, "area").caret, 0, 0)
    ta_frame(r)
    ta_wheel(r, 0.0, 78.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(cx, "area"), 3)
    ta_click(r, 100.0, 116.0, 1)
    ta_expect(t, text_area_selection(cx, "area").caret, 19, 7)
    ta_frame(r)
    ta_click(r, 100.0, 4.0, 1)
    ta_expect(t, text_area_selection(cx, "area").caret, 0, 0)
    set(doc, ["abcd", "efgh"])
    ta_frame(r)
    ta_click(r, 2.0, 100.0, 1)
    ta_expect(t, text_area_selection(cx, "area").caret, 1, 4)
}

fn test_a_caret_scrolled_out_of_view_horizontally_is_not_reported(t: *testing.T) {
    let r = ta_open("the quick brown fox jumps over the lazy dog and keeps running\nshort")
    ta_frame(r)
    testing.is_true(t, text_input(r.cx) != none)
    ta_wheel(r, 40.0, 0.0)
    ta_frame(r)
    testing.is_true(t, area_state(r.cx.state, "area").scroll_x > 0.0)
    testing.is_true(t, text_input(r.cx) == none)
}

fn test_a_tab_is_shaped_as_a_space(t: *testing.T) {
    let spaced = ta_open("a b")
    let tabbed = ta_open("a\tb")
    ta_press(spaced, platform.NamedKey.End)
    ta_press(tabbed, platform.NamedKey.End)
    let plain = ta_frame(spaced)
    let marked = ta_frame(tabbed)
    testing.equal(t, marked.sprites.len, plain.sprites.len)
    let want = text_input(spaced.cx) ?? platform.Caret {}
    let got = text_input(tabbed.cx) ?? platform.Caret {}
    testing.equal(t, got.x, want.x)
}
