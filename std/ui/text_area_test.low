import std/testing
import std/ui/geometry
import std/ui/layout
import std/ui/platform
import std/ui/scene
import std/unicode
import strs = std/text
import uitext = std/ui/text

struct TaRig {
    cx: Context
    doc: Signal[str[]]
    view: fn() -> Element
}

fn ta_apply(doc: Signal[str[]], ed: TextEdit) {
    let lines = get(doc)
    let head = lines[ed.start.line][..ed.start.column]
    let tail = lines[ed.end.line][ed.end.column..]
    let joined = "{head}{ed.text}{tail}"
    let parts = strs.split_str(joined, "\n")
    var out: str[] = []
    for i in 0..ed.start.line {
        out.push(lines[i])
    }
    for p in parts {
        out.push(p)
    }
    let resume = ed.end.line + 1
    for i in resume..lines.len {
        out.push(lines[i])
    }
    set(doc, out)
}

fn ta_source(doc: Signal[str[]]) -> LineSource {
    let count = fn() -> i64 { get(doc).len }
    let line = fn(i: i64) -> str { get(doc)[i] }
    let edit = fn(ed: TextEdit) { ta_apply(doc, ed) }
    line_source(count, line, edit)
}

fn ta_frame(r: TaRig) -> scene.Scene {
    frame(r.cx, r.view, geometry.size(320.0, 240.0), 1.0)
}

fn ta_open(initial: str) -> TaRig {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, strs.split_str(initial, "\n"))
    let src = ta_source(doc)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    set_focus(cx, "area")
    ta_frame(r)
    r
}

fn ta_text(r: TaRig) -> str {
    strs.join(get(r.doc), "\n")
}

fn ta_key(r: TaRig, n: platform.NamedKey, shift: bool, control: bool) {
    let mods = platform.Modifiers { shift: shift, control: control }
    dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(n), modifiers: mods }))
}

fn ta_press(r: TaRig, n: platform.NamedKey) {
    ta_key(r, n, false, false)
}

fn ta_type(r: TaRig, s: str) {
    dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn ta_ctrl(r: TaRig, letter: str, shift: bool) {
    let mods = platform.Modifiers { control: true, shift: shift }
    dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(letter), modifiers: mods }))
}

fn ta_put(r: TaRig, line: i64, column: i64) {
    let p = TextPosition { line, column }
    set_text_area_selection(r.cx, "area", p, p)
    ta_frame(r)
}

fn ta_select(r: TaRig, from: TextPosition, to: TextPosition) {
    set_text_area_selection(r.cx, "area", from, to)
    ta_frame(r)
}

fn ta_at(line: i64, column: i64) -> TextPosition {
    TextPosition { line, column }
}

fn ta_expect(t: *testing.T, got: TextPosition, line: i64, column: i64) {
    testing.equal(t, got.line, line)
    testing.equal(t, got.column, column)
}

fn ta_width(s: str) -> f32 {
    var sys = uitext.default_system()
    uitext.measure(mut sys, s, uitext.Style {}, layout.unbounded).width
}

fn ta_down(r: TaRig, x: f32, y: f32, clicks: i64, shift: bool) {
    let mods = platform.Modifiers { shift: shift }
    dispatch(r.cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: x, y: y, clicks: clicks, modifiers: mods }))
}

fn ta_up(r: TaRig, x: f32, y: f32, clicks: i64) {
    dispatch(r.cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: x, y: y, clicks: clicks }))
}

fn ta_click(r: TaRig, x: f32, y: f32, clicks: i64) {
    ta_down(r, x, y, clicks, false)
    ta_up(r, x, y, clicks)
}

fn ta_wheel(r: TaRig, dx: f32, dy: f32) {
    dispatch(r.cx, platform.Event.PointerMoved(10.0, 10.0))
    dispatch(r.cx, platform.Event.Scrolled(dx, dy, platform.Modifiers {}))
}

fn ta_numbered(n: i64) -> str {
    var out = ""
    for i in 0..n {
        let gap = if i == 0 { "" } else { "\n" }
        out = "{out}{gap}line {i}"
    }
    out
}

fn test_typing_and_enter_edit_the_document_through_the_source(t: *testing.T) {
    let r = ta_open("ab")
    ta_press(r, platform.NamedKey.End)
    ta_type(r, "X")
    testing.equal(t, ta_text(r), "abX")
    ta_press(r, platform.NamedKey.Enter)
    testing.equal(t, ta_text(r), "abX\n")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_type(r, "c")
    ta_press(r, platform.NamedKey.Left)
    ta_press(r, platform.NamedKey.Enter)
    testing.equal(t, ta_text(r), "abX\n\nc")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 0)
}

fn test_backspace_and_delete_join_lines(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_put(r, 1, 0)
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "abcd\nef")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 2)
    ta_press(r, platform.NamedKey.End)
    ta_press(r, platform.NamedKey.Delete)
    testing.equal(t, ta_text(r), "abcdef")
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "abcef")
}

fn test_control_backspace_and_delete_remove_a_word(t: *testing.T) {
    let r = ta_open("one two\nthree")
    ta_put(r, 0, 7)
    ta_key(r, platform.NamedKey.Backspace, false, true)
    testing.equal(t, ta_text(r), "one \nthree")
    ta_put(r, 0, 0)
    ta_key(r, platform.NamedKey.Delete, false, true)
    testing.equal(t, ta_text(r), " \nthree")
}

fn test_arrows_cross_line_ends_and_collapse_selections(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_put(r, 0, 2)
    ta_press(r, platform.NamedKey.Right)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_press(r, platform.NamedKey.Left)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 2)
    ta_key(r, platform.NamedKey.Right, true, false)
    ta_key(r, platform.NamedKey.Right, true, false)
    let selected = text_area_selection(r.cx, "area")
    ta_expect(t, selected.anchor, 0, 2)
    ta_expect(t, selected.caret, 1, 1)
    ta_press(r, platform.NamedKey.Left)
    let collapsed = text_area_selection(r.cx, "area")
    ta_expect(t, collapsed.anchor, 0, 2)
    ta_expect(t, collapsed.caret, 0, 2)
}

fn test_word_moves_cross_lines(t: *testing.T) {
    let r = ta_open("one two\nthree")
    ta_put(r, 0, 0)
    ta_key(r, platform.NamedKey.Right, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 3)
    ta_key(r, platform.NamedKey.Right, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 7)
    ta_key(r, platform.NamedKey.Right, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_key(r, platform.NamedKey.Left, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 7)
    ta_key(r, platform.NamedKey.Left, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 4)
}

fn test_vertical_moves_keep_the_preferred_column(t: *testing.T) {
    let r = ta_open("abcdef\nab\nabcdef")
    ta_put(r, 0, 4)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 2)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 4)
    ta_press(r, platform.NamedKey.Up)
    ta_press(r, platform.NamedKey.Up)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 4)
    ta_press(r, platform.NamedKey.Up)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
    ta_put(r, 2, 3)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 6)
}

fn test_a_horizontal_move_resets_the_preferred_column(t: *testing.T) {
    let r = ta_open("abcdef\nab\nabcdef")
    ta_put(r, 0, 4)
    ta_press(r, platform.NamedKey.Down)
    ta_press(r, platform.NamedKey.Left)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 1)
}

fn test_shift_vertical_moves_select_across_lines(t: *testing.T) {
    let r = ta_open("abc\ndef\nghi")
    ta_put(r, 0, 1)
    ta_key(r, platform.NamedKey.Down, true, false)
    ta_key(r, platform.NamedKey.Down, true, false)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 1)
    ta_expect(t, s.caret, 2, 1)
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "aZhi")
}

fn test_home_end_and_document_edges(t: *testing.T) {
    let r = ta_open("abc\ndef\nghi")
    ta_put(r, 1, 1)
    ta_press(r, platform.NamedKey.End)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 3)
    ta_press(r, platform.NamedKey.Home)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_key(r, platform.NamedKey.End, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 3)
    ta_key(r, platform.NamedKey.Home, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
    ta_key(r, platform.NamedKey.End, true, true)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 0)
    ta_expect(t, s.caret, 2, 3)
}

fn test_page_keys_move_by_the_rows_in_view_less_one(t: *testing.T) {
    let r = ta_open(ta_numbered(20))
    ta_press(r, platform.NamedKey.PageDown)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 3, 0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 3)
    ta_press(r, platform.NamedKey.PageDown)
    ta_press(r, platform.NamedKey.PageDown)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 9, 0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 9)
    ta_press(r, platform.NamedKey.PageUp)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 6, 0)
    ta_key(r, platform.NamedKey.PageUp, true, false)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 6, 0)
    ta_expect(t, s.caret, 3, 0)
}

fn test_select_all_and_typing_replace_every_line(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_ctrl(r, "a", false)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 0)
    ta_expect(t, s.caret, 2, 2)
    ta_type(r, "z")
    testing.equal(t, ta_text(r), "z")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab\ncd\nef")
    let restored = text_area_selection(r.cx, "area")
    ta_expect(t, restored.anchor, 0, 0)
    ta_expect(t, restored.caret, 2, 2)
}

fn test_a_click_places_the_caret_on_the_line_and_column_under_it(t: *testing.T) {
    let r = ta_open("abcd\nefgh\nijkl")
    ta_click(r, ta_width("ef") + 0.1, 39.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 2)
    ta_frame(r)
    ta_click(r, 190.0, 65.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 4)
    ta_frame(r)
    ta_click(r, 1.0, 3.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
}

fn test_a_double_click_selects_a_word_and_a_triple_click_a_line(t: *testing.T) {
    let r = ta_open("hello world\nsecond\nlast")
    ta_click(r, ta_width("hello wo"), 13.0, 2)
    var s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 6)
    ta_expect(t, s.caret, 0, 11)
    ta_frame(r)
    ta_click(r, 5.0, 39.0, 3)
    s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 1, 0)
    ta_expect(t, s.caret, 2, 0)
    ta_frame(r)
    ta_click(r, 5.0, 65.0, 3)
    s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 2, 0)
    ta_expect(t, s.caret, 2, 4)
}

fn test_dragging_selects_across_lines_and_shift_click_extends(t: *testing.T) {
    let r = ta_open("abcd\nefgh\nijkl")
    ta_down(r, ta_width("ab") + 0.1, 13.0, 1, false)
    dispatch(r.cx, platform.Event.PointerMoved(ta_width("i") + 0.1, 65.0))
    ta_up(r, ta_width("i") + 0.1, 65.0, 1)
    var s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 2)
    ta_expect(t, s.caret, 2, 1)
    ta_frame(r)
    ta_down(r, ta_width("ef") + 0.1, 39.0, 1, true)
    ta_up(r, ta_width("ef") + 0.1, 39.0, 1)
    s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 2)
    ta_expect(t, s.caret, 1, 2)
}

fn test_a_drag_after_a_double_click_keeps_the_word_selected(t: *testing.T) {
    let r = ta_open("hello world\nsecond")
    ta_down(r, ta_width("hello wo"), 13.0, 2, false)
    dispatch(r.cx, platform.Event.PointerMoved(5.0, 39.0))
    ta_up(r, 5.0, 39.0, 2)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 6)
    ta_expect(t, s.caret, 0, 11)
}

fn test_copy_cut_and_paste_keep_line_breaks(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_select(r, ta_at(0, 1), ta_at(2, 1))
    ta_ctrl(r, "c", false)
    testing.equal(t, clipboard(r.cx) ?? "", "b\ncd\ne")
    ta_ctrl(r, "x", false)
    testing.equal(t, ta_text(r), "af")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
    ta_ctrl(r, "v", false)
    testing.equal(t, ta_text(r), "ab\ncd\nef")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 1)
}

fn test_paste_normalises_line_breaks_and_drops_control_characters(t: *testing.T) {
    let r = ta_open("")
    set_clipboard(r.cx, "x\r\ny\rz\u0001w\tq")
    ta_ctrl(r, "v", false)
    testing.equal(t, ta_text(r), "x\ny\nzw\tq")
    ta_type(r, "\n")
    testing.equal(t, ta_text(r), "x\ny\nzw\tq")
}

fn test_tab_inserts_a_tab_character(t: *testing.T) {
    let r = ta_open("ab")
    ta_press(r, platform.NamedKey.Tab)
    testing.equal(t, ta_text(r), "\tab")
}

fn test_unbinding_tab_lets_it_move_focus(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let tab_binding = key_binding("tab", "", "TextArea") catch {
        err => panic("binding")
    }
    bind_keys(cx, [tab_binding])
    let doc = signal(cx, ["ab"])
    let src = ta_source(doc)
    let view = fn() -> Element {
        column(div()).children() {
            text_area(src).id("area").size(200.0, 104.0),
            div().id("next").focusable().size(200.0, 20.0),
        }
    }
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    set_focus(cx, "area")
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "next")
    testing.equal(t, get(doc)[0], "ab")
}

fn test_typing_groups_into_one_undo_step(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    ta_type(r, "b")
    ta_type(r, "c")
    testing.equal(t, ta_text(r), "abc")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "")
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "abc")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 3)
    ta_ctrl(r, "z", false)
    ta_ctrl(r, "z", true)
    testing.equal(t, ta_text(r), "abc")
}

fn test_a_caret_move_ends_the_undo_group(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    ta_type(r, "b")
    ta_press(r, platform.NamedKey.Left)
    ta_type(r, "X")
    testing.equal(t, ta_text(r), "aXb")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "")
}

fn test_a_click_ends_the_undo_group(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    ta_frame(r)
    ta_click(r, 190.0, 13.0, 1)
    ta_type(r, "b")
    testing.equal(t, ta_text(r), "ab")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a")
}

fn test_runs_of_backspace_and_of_delete_group_separately(t: *testing.T) {
    let r = ta_open("abcdef")
    ta_press(r, platform.NamedKey.End)
    ta_press(r, platform.NamedKey.Backspace)
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "abcd")
    ta_press(r, platform.NamedKey.Delete)
    ta_put(r, 0, 0)
    ta_press(r, platform.NamedKey.Delete)
    ta_press(r, platform.NamedKey.Delete)
    testing.equal(t, ta_text(r), "cd")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abcd")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abcdef")
}

fn test_enter_and_paste_are_their_own_undo_steps(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    ta_press(r, platform.NamedKey.Enter)
    ta_type(r, "b")
    ta_type(r, "c")
    set_clipboard(r.cx, "ZZ")
    ta_ctrl(r, "v", false)
    testing.equal(t, ta_text(r), "a\nbcZZ")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a\nbc")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a\n")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "")
}

fn test_a_pause_ends_the_undo_group_and_a_new_edit_drops_the_redo_steps(t: *testing.T) {
    let r = ta_open("")
    ta_type(r, "a")
    advance_clock(r.cx, 400)
    ta_type(r, "b")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a")
    ta_type(r, "c")
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "ac")
}

fn test_undo_restores_a_cut_selection(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_select(r, ta_at(0, 1), ta_at(1, 1))
    ta_ctrl(r, "x", false)
    testing.equal(t, ta_text(r), "ad")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab\ncd")
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 1)
    ta_expect(t, s.caret, 1, 1)
}

fn test_the_caret_and_a_selection_across_lines_are_painted(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    let plain = ta_frame(r)
    testing.equal(t, plain.quads.len, 1)
    testing.equal(t, plain.quads[0].bounds.width, 1.0)
    testing.equal(t, plain.quads[0].bounds.height, 26.0)
    ta_select(r, ta_at(0, 1), ta_at(2, 1))
    let selected = ta_frame(r)
    testing.equal(t, selected.quads.len, 4)
    testing.is_true(t, selected.quads[0].background.a < 1.0)
    testing.equal(t, selected.quads[0].bounds.y, 0.0)
    testing.equal(t, selected.quads[1].bounds.y, 26.0)
    testing.equal(t, selected.quads[2].bounds.y, 52.0)
    testing.equal(t, selected.quads[1].bounds.x, 0.0)
    testing.is_true(t, selected.quads[1].bounds.width > ta_width("cd"))
    testing.equal(t, selected.quads[3].bounds.width, 1.0)
}

fn test_a_composition_is_shown_at_the_caret_until_it_is_committed(t: *testing.T) {
    let r = ta_open("ab")
    ta_press(r, platform.NamedKey.End)
    let plain = ta_frame(r)
    let start = (text_input(r.cx) ?? platform.Caret {}).x
    dispatch(r.cx, platform.Event.Preedit("ni", platform.TextRange { start: 0, end: 2 }))
    let composing = ta_frame(r)
    testing.equal(t, ta_text(r), "ab")
    testing.is_true(t, composing.sprites.len > plain.sprites.len)
    testing.equal(t, composing.quads.len, plain.quads.len + 1)
    testing.is_true(t, (text_input(r.cx) ?? platform.Caret {}).x > start)
    let word = unicode.encode_rune(0x4f60)
    dispatch(r.cx, platform.Event.Commit(word))
    testing.equal(t, ta_text(r), "ab{word}")
    let committed = ta_frame(r)
    testing.equal(t, committed.quads.len, plain.quads.len)
    dispatch(r.cx, platform.Event.Preedit("", none))
    testing.equal(t, ta_frame(r).sprites.len, committed.sprites.len)
}

fn test_a_commit_replaces_the_selection_and_a_second_line_takes_text(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_select(r, ta_at(0, 1), ta_at(1, 1))
    dispatch(r.cx, platform.Event.Commit("Q"))
    testing.equal(t, ta_text(r), "aQd")
    dispatch(r.cx, platform.Event.Commit("x\ny"))
    testing.equal(t, ta_text(r), "aQx\nyd")
}

fn test_the_view_scrolls_vertically_to_keep_the_caret_in_view(t: *testing.T) {
    let r = ta_open(ta_numbered(20))
    ta_key(r, platform.NamedKey.End, false, true)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 16)
    let caret = text_input(r.cx) ?? platform.Caret {}
    testing.equal(t, caret.y, 78)
    ta_key(r, platform.NamedKey.Home, false, true)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 0)
    testing.equal(t, (text_input(r.cx) ?? platform.Caret {}).y, 0)
    ta_put(r, 5, 0)
    ta_press(r, platform.NamedKey.Down)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 3)
}

fn test_the_view_scrolls_horizontally_to_keep_the_caret_in_view(t: *testing.T) {
    let r = ta_open("the quick brown fox jumps over the lazy dog and keeps running\nshort")
    ta_press(r, platform.NamedKey.End)
    ta_frame(r)
    let caret = text_input(r.cx) ?? platform.Caret {}
    testing.is_true(t, caret.x >= 150 && caret.x <= 200)
    testing.is_true(t, area_state(r.cx.state, "area").scroll_x > 0.0)
    ta_press(r, platform.NamedKey.Home)
    ta_frame(r)
    testing.is_true(t, (text_input(r.cx) ?? platform.Caret {}).x < 2)
    testing.equal(t, area_state(r.cx.state, "area").scroll_x, 0.0)
}

fn test_the_wheel_scrolls_and_stops_at_the_ends(t: *testing.T) {
    let r = ta_open(ta_numbered(20))
    ta_wheel(r, 0.0, 30.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 1)
    testing.equal(t, area_state(r.cx.state, "area").shift, 4.0)
    ta_wheel(r, 0.0, -100.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 0)
    ta_wheel(r, 0.0, 10000.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 16)
    testing.equal(t, area_state(r.cx.state, "area").shift, 0.0)
}

fn test_a_wheel_does_not_move_a_document_that_fits(t: *testing.T) {
    let r = ta_open("a\nb")
    ta_wheel(r, 0.0, 30.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 0)
    testing.equal(t, area_state(r.cx.state, "area").shift, 0.0)
    testing.is_false(t, frame_due(r.cx))
}

fn test_wheeling_away_does_not_pull_the_caret_back_into_view(t: *testing.T) {
    let r = ta_open(ta_numbered(40))
    ta_wheel(r, 0.0, 520.0)
    ta_frame(r)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 20)
    testing.is_true(t, text_input(r.cx) == none)
}

fn test_styled_runs_reach_the_scene(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, ["abcdef", "ghij"])
    var src = ta_source(doc)
    let red = rgb(0xff0000)
    let runs = fn(i: i64) -> TextRun[] {
        if i == 0 { [TextRun { start: 2, end: 4, color: red }, TextRun { start: 4, end: 5, weight: 700 }] } else { [] }
    }
    src.line_runs = runs
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let sc = frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    var tinted = 0
    var plain = 0
    for s in sc.sprites {
        if s.color.r == 1.0 && s.color.g == 0.0 {
            tinted += 1
        } else {
            plain += 1
        }
    }
    testing.equal(t, tinted, 2)
    testing.equal(t, plain, 8)
    let bare = headless(rgb(0xffffff))
    let bare_doc = signal(bare, ["abcdef", "ghij"])
    let bare_src = ta_source(bare_doc)
    let bare_view = fn() -> Element { text_area(bare_src).id("area").size(200.0, 104.0) }
    let reference = frame(bare, bare_view, geometry.size(320.0, 240.0), 1.0)
    testing.equal(t, reference.sprites.len, sc.sprites.len)
}

fn test_a_line_decoration_fills_the_whole_line(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, ["abc", "def", "ghi"])
    var src = ta_source(doc)
    let tint = rgb(0xffeeaa)
    let fill = fn(i: i64) -> geometry.Color? { if i == 1 { tint } else { none } }
    src.line_fill = fill
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let sc = frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    testing.equal(t, sc.quads.len, 1)
    testing.equal(t, sc.quads[0].bounds.x, 0.0)
    testing.equal(t, sc.quads[0].bounds.y, 26.0)
    testing.equal(t, sc.quads[0].bounds.width, 200.0)
    testing.equal(t, sc.quads[0].bounds.height, 26.0)
    testing.equal(t, sc.quads[0].background.r, tint.r)
}

fn test_an_action_can_be_rebound(t: *testing.T) {
    let r = ta_open("ab")
    clear_key_bindings(r.cx)
    let join_line = key_binding("ctrl-j", "text_area.new_line", "TextArea") catch {
        err => panic("binding")
    }
    bind_keys(r.cx, [join_line])
    ta_press(r, platform.NamedKey.Enter)
    testing.equal(t, ta_text(r), "ab")
    ta_ctrl(r, "j", false)
    testing.equal(t, ta_text(r), "\nab")
    ta_press(r, platform.NamedKey.Left)
    testing.equal(t, ta_text(r), "\nab")
}

fn test_the_text_area_context_survives_another_key_context(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, ["ab"])
    let src = ta_source(doc)
    let view = fn() -> Element { text_area(src).id("area").key_context("Editor").size(200.0, 104.0) }
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    set_focus(cx, "area")
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    let save = key_binding("ctrl-s", "editor.save", "Editor && TextArea") catch {
        err => panic("binding")
    }
    bind_keys(cx, [save])
    let saved = signal(cx, 0)
    let wrapped = fn() -> Element {
        let inner = text_area(src).id("area").key_context("Editor").size(200.0, 104.0)
        div().on_action("editor.save", fn() { set(saved, get(saved) + 1) }).child(inner)
    }
    frame(cx, wrapped, geometry.size(320.0, 240.0), 1.0)
    set_focus(cx, "area")
    frame(cx, wrapped, geometry.size(320.0, 240.0), 1.0)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("s"), modifiers: platform.Modifiers { control: true } }))
    testing.equal(t, get(saved), 1)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("x"), text: "x" }))
    testing.equal(t, get(doc)[0], "xab")
}

fn test_an_on_action_handler_runs_before_the_built_in_one(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, ["ab"])
    let src = ta_source(doc)
    let seen = signal(cx, 0)
    let count_up = fn() { set(seen, get(seen) + 1) }
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0).on_action("text_area.backspace", count_up) }
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    set_focus(cx, "area")
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    set_text_area_selection(cx, "area", TextPosition { line: 0, column: 2 }, TextPosition { line: 0, column: 2 })
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Backspace) }))
    testing.equal(t, get(seen), 1)
    testing.equal(t, get(doc)[0], "ab")
}

fn test_the_built_in_actions_are_available_and_dispatchable(t: *testing.T) {
    let r = ta_open("ab\ncd")
    testing.is_true(t, is_action_available(r.cx, "text_area.undo"))
    testing.is_false(t, is_action_available(r.cx, "editor.save"))
    let names = available_actions(r.cx)
    testing.is_true(t, names.len > 30)
    testing.is_true(t, dispatch_action(r.cx, "text_area.select_all"))
    testing.equal(t, text_area_selection(r.cx, "area").caret.line, 1)
    testing.is_false(t, dispatch_action(r.cx, "text_area.unknown"))
}

fn test_a_text_area_without_a_focus_ignores_keys(t: *testing.T) {
    let r = ta_open("ab")
    blur(r.cx)
    ta_frame(r)
    ta_type(r, "x")
    dispatch(r.cx, platform.Event.Commit("y"))
    testing.equal(t, ta_text(r), "ab")
    testing.is_true(t, text_input(r.cx) == none)
}

fn test_only_the_visible_lines_are_read_from_a_huge_document(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let reads = signal(cx, 0)
    let low = signal(cx, 1000000000)
    let high = signal(cx, -1)
    let count = fn() -> i64 { 1000000 }
    let line = fn(i: i64) -> str {
        set(reads, get(reads) + 1)
        if i < get(low) {
            set(low, i)
        }
        if i > get(high) {
            set(high, i)
        }
        "line {i}"
    }
    let edit = fn(ed: TextEdit) {}
    let src = line_source(count, line, edit)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let size = geometry.size(320.0, 240.0)
    frame(cx, view, size, 1.0)
    testing.is_true(t, get(reads) <= 6)
    testing.equal(t, get(low), 0)
    testing.is_true(t, get(high) <= 4)
    set_focus(cx, "area")
    frame(cx, view, size, 1.0)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.End), modifiers: platform.Modifiers { control: true } }))
    set(reads, 0)
    set(low, 1000000000)
    set(high, -1)
    frame(cx, view, size, 1.0)
    testing.is_true(t, get(reads) <= 6)
    testing.equal(t, get(high), 999999)
    testing.is_true(t, get(low) >= 999995)
    let caret = text_input(cx) ?? platform.Caret {}
    testing.is_true(t, text_input(cx) != none)
    testing.is_true(t, caret.y >= 0 && caret.y < 104)
    testing.equal(t, text_area_top_line(cx, "area"), 999996)
    scroll_text_area_to_line(cx, "area", 500000)
    set(reads, 0)
    set(low, 1000000000)
    set(high, -1)
    frame(cx, view, size, 1.0)
    testing.is_true(t, get(reads) <= 6)
    testing.is_true(t, get(low) >= 500000)
    testing.is_true(t, get(high) <= 500004)
    testing.is_true(t, text_input(cx) == none)
    dispatch(cx, platform.Event.PointerMoved(10.0, 10.0))
    dispatch(cx, platform.Event.Scrolled(0.0, 52.0, platform.Modifiers {}))
    set(reads, 0)
    set(low, 1000000000)
    set(high, -1)
    frame(cx, view, size, 1.0)
    testing.is_true(t, get(low) >= 500002)
    testing.is_true(t, get(high) <= 500006)
}

fn test_a_click_in_a_huge_document_reads_one_line(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let reads = signal(cx, 0)
    let count = fn() -> i64 { 1000000 }
    let line = fn(i: i64) -> str {
        set(reads, get(reads) + 1)
        "line {i}"
    }
    let edit = fn(ed: TextEdit) {}
    let src = line_source(count, line, edit)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let size = geometry.size(320.0, 240.0)
    scroll_text_area_to_line(cx, "area", 700000)
    frame(cx, view, size, 1.0)
    set(reads, 0)
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { x: 5.0, y: 40.0 }))
    testing.equal(t, get(reads), 1)
    testing.equal(t, text_area_selection(cx, "area").caret.line, 700001)
}

struct TaGate {
    rig: TaRig
    mode: Signal[i64]
}

fn ta_gated(initial: str) -> TaGate {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, strs.split_str(initial, "\n"))
    let gate = signal(cx, 0)
    let count = fn() -> i64 { get(doc).len }
    let line = fn(i: i64) -> str { get(doc)[i] }
    let edit = fn(ed: TextEdit) {
        let mode = get(gate)
        if mode == 0 {
            ta_apply(doc, ed)
        } else if mode == 2 {
            ta_apply(doc, TextEdit { start: ed.start, end: ed.end, text: "#" })
        }
    }
    let src = line_source(count, line, edit)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    set_focus(cx, "area")
    ta_frame(r)
    TaGate { rig: r, mode: gate }
}

fn test_a_document_that_shrinks_between_frames_does_not_leave_the_caret_outside_it(t: *testing.T) {
    let r = ta_open("a\nb\nlonger")
    ta_put(r, 2, 5)
    set(r.doc, ["x"])
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "xZ")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 2)
    ta_put(r, 0, 2)
    set(r.doc, ["x", "y", "z"])
    ta_put(r, 2, 1)
    set(r.doc, ["q"])
    ta_frame(r)
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "")
}

fn test_a_line_shortened_under_the_caret_takes_enter_and_typing_at_its_end(t: *testing.T) {
    let r = ta_open("abcdef\nlast")
    ta_press(r, platform.NamedKey.End)
    set(r.doc, ["ab", "last"])
    ta_press(r, platform.NamedKey.Enter)
    testing.equal(t, ta_text(r), "ab\n\nlast")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 0)
    ta_put(r, 0, 2)
    set(r.doc, ["a", "", "last"])
    ta_type(r, "Q")
    testing.equal(t, ta_text(r), "aQ\n\nlast")
}

fn test_a_selection_set_past_the_end_of_a_line_is_clamped_before_typing(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_select(r, ta_at(0, 1), ta_at(0, 99))
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 2)
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "aZ\ncd")
    set_text_area_selection(r.cx, "area", ta_at(0, 0), ta_at(7, 3))
    ta_type(r, "Y")
    testing.equal(t, ta_text(r), "Y")
}

fn test_a_column_inside_a_multi_byte_character_moves_to_its_start(t: *testing.T) {
    let r = ta_open("abcdef")
    ta_put(r, 0, 1)
    let accented = unicode.encode_rune(0xe9)
    set(r.doc, ["{accented}a"])
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "Z{accented}a")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
}

fn test_an_ignored_insertion_leaves_the_text_alone_when_undone(t: *testing.T) {
    let g = ta_gated("abcd")
    let r = g.rig
    ta_put(r, 0, 1)
    set(g.mode, 1)
    ta_type(r, "Y")
    testing.equal(t, ta_text(r), "abcd")
    set(g.mode, 0)
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abcd")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
}

fn test_an_altered_edit_drops_the_history_and_keeps_the_caret_in_the_text(t: *testing.T) {
    let g = ta_gated("abcd")
    let r = g.rig
    ta_put(r, 0, 1)
    set(g.mode, 2)
    ta_type(r, "YY")
    testing.equal(t, ta_text(r), "a#bcd")
    set(g.mode, 0)
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a#bcd")
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "a#bcd")
    let caret = text_area_selection(r.cx, "area").caret
    testing.is_true(t, caret.line == 0 && caret.column <= 5)
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "aZ#bcd")
}

fn test_an_ignored_deletion_drops_the_history_too(t: *testing.T) {
    let g = ta_gated("abc")
    let r = g.rig
    ta_type(r, "X")
    set(g.mode, 1)
    ta_press(r, platform.NamedKey.Delete)
    testing.equal(t, ta_text(r), "Xabc")
    set(g.mode, 0)
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "Xabc")
}

fn test_an_ancestor_capture_handler_can_stop_a_text_area_action(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, ["ab"])
    let src = ta_source(doc)
    let captured = signal(cx, 0)
    let bubbled = signal(cx, 0)
    let stop = signal(cx, false)
    let capture = fn() {
        set(captured, get(captured) + 1)
        if get(stop) {
            stop_propagation(cx)
        }
    }
    let bubble = fn() { set(bubbled, get(bubbled) + 1) }
    let view = fn() -> Element {
        let inner = text_area(src).id("area").size(200.0, 104.0)
        div().capture_action("text_area.tab", capture).on_action("text_area.tab", bubble).child(inner)
    }
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    set_focus(cx, "area")
    frame(cx, view, geometry.size(320.0, 240.0), 1.0)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Tab) }))
    testing.equal(t, get(captured), 1)
    testing.equal(t, get(bubbled), 0)
    testing.equal(t, get(doc)[0], "\tab")
    set(stop, true)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Tab) }))
    testing.equal(t, get(captured), 2)
    testing.equal(t, get(bubbled), 0)
    testing.equal(t, get(doc)[0], "\tab")
}

fn test_a_composition_over_a_multi_line_selection_removes_it_and_shows_at_the_caret(t: *testing.T) {
    let r = ta_open("abc\ndef\nghi\njkl")
    ta_select(r, ta_at(0, 1), ta_at(2, 1))
    dispatch(r.cx, platform.Event.Preedit("zz", platform.TextRange { start: 0, end: 2 }))
    let composing = ta_frame(r)
    testing.equal(t, ta_text(r), "ahi\njkl")
    let reference = ta_open("azzhi\njkl")
    let shown = ta_frame(reference)
    testing.equal(t, composing.sprites.len, shown.sprites.len)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
    testing.equal(t, (text_input(r.cx) ?? platform.Caret {}).x, i64(floor(ta_width("azz"))))
    testing.equal(t, composing.quads.len, 2)
    dispatch(r.cx, platform.Event.Commit("zz"))
    testing.equal(t, ta_text(r), "azzhi\njkl")
}

fn test_a_click_below_the_last_line_goes_to_the_end_and_above_the_box_to_the_start(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let doc = signal(cx, strs.split_str(ta_numbered(20), "\n"))
    let src = ta_source(doc)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 124.0).padding(10.0) }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    ta_click(r, 2.0, 100.0, 1)
    ta_expect(t, text_area_selection(cx, "area").caret, 3, 0)
    ta_frame(r)
    ta_click(r, 2.0, 4.0, 1)
    ta_expect(t, text_area_selection(cx, "area").caret, 0, 0)
    ta_frame(r)
    ta_wheel(r, 0.0, 78.0)
    ta_frame(r)
    testing.equal(t, text_area_top_line(cx, "area"), 3)
    ta_click(r, 100.0, 116.0, 1)
    ta_expect(t, text_area_selection(cx, "area").caret, 19, 7)
    ta_frame(r)
    ta_click(r, 100.0, 4.0, 1)
    ta_expect(t, text_area_selection(cx, "area").caret, 0, 0)
    set(doc, ["abcd", "efgh"])
    ta_frame(r)
    ta_click(r, 2.0, 100.0, 1)
    ta_expect(t, text_area_selection(cx, "area").caret, 1, 4)
}

fn test_a_caret_scrolled_out_of_view_horizontally_is_not_reported(t: *testing.T) {
    let r = ta_open("the quick brown fox jumps over the lazy dog and keeps running\nshort")
    ta_frame(r)
    testing.is_true(t, text_input(r.cx) != none)
    ta_wheel(r, 40.0, 0.0)
    ta_frame(r)
    testing.is_true(t, area_state(r.cx.state, "area").scroll_x > 0.0)
    testing.is_true(t, text_input(r.cx) == none)
}

fn test_a_tab_is_shaped_as_a_space(t: *testing.T) {
    let spaced = ta_open("a b")
    let tabbed = ta_open("a\tb")
    ta_press(spaced, platform.NamedKey.End)
    ta_press(tabbed, platform.NamedKey.End)
    let plain = ta_frame(spaced)
    let marked = ta_frame(tabbed)
    testing.equal(t, marked.sprites.len, plain.sprites.len)
    let want = text_input(spaced.cx) ?? platform.Caret {}
    let got = text_input(tabbed.cx) ?? platform.Caret {}
    testing.equal(t, got.x, want.x)
}

fn ta_open_with(initial: str, shape: fn(Element) -> Element) -> TaRig {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, strs.split_str(initial, "\n"))
    let src = ta_source(doc)
    let view = fn() -> Element { shape(text_area(src).id("area").size(200.0, 104.0)) }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    set_focus(cx, "area")
    ta_frame(r)
    r
}

fn ta_open_tabs(initial: str, size: i64) -> TaRig {
    ta_open_with(initial, fn(e: Element) -> Element { e.tab_size(size) })
}

fn ta_mark_color() -> geometry.Color {
    rgb(0xff0000)
}

fn ta_caret_mark_color() -> geometry.Color {
    rgb(0x0000ff)
}

fn ta_open_marked(initial: str, size: i64) -> TaRig {
    ta_open_with(initial, fn(e: Element) -> Element { e.tab_size(size).blank_marks(ta_mark_color(), ta_caret_mark_color()) })
}

fn ta_caret_x_at(r: TaRig, line: i64, column: i64) -> f32 {
    ta_put(r, line, column)
    let caret = text_input(r.cx) ?? platform.Caret {}
    f32(caret.x)
}

fn ta_sprites_of(sc: scene.Scene, c: geometry.Color) -> scene.Sprite[] {
    var out: scene.Sprite[] = []
    for s in sc.sprites {
        if s.color.r == c.r && s.color.g == c.g && s.color.b == c.b {
            out.push(s)
        }
    }
    out
}

fn ta_centre(s: scene.Sprite) -> f32 {
    s.bounds.x + s.bounds.width / 2.0
}

fn ta_same_caret_x(t: *testing.T, tabbed: TaRig, at: TextPosition, spaced: TaRig, to: TextPosition) {
    let got = ta_caret_x_at(tabbed, at.line, at.column)
    let want = ta_caret_x_at(spaced, to.line, to.column)
    testing.is_true(t, want > 0.0)
    testing.equal(t, got, want)
}

fn test_a_tab_advances_to_the_next_multiple_of_four_columns(t: *testing.T) {
    let tabbed = ta_open_tabs("\ta\nab\tc\nabc\td\nabcd\te", 4)
    let spaced = ta_open("    a\nab  c\nabc d\nabcd    e")
    ta_same_caret_x(t, tabbed, ta_at(0, 1), spaced, ta_at(0, 4))
    ta_same_caret_x(t, tabbed, ta_at(1, 3), spaced, ta_at(1, 4))
    ta_same_caret_x(t, tabbed, ta_at(2, 4), spaced, ta_at(2, 4))
    ta_same_caret_x(t, tabbed, ta_at(3, 5), spaced, ta_at(3, 8))
    ta_same_caret_x(t, tabbed, ta_at(3, 6), spaced, ta_at(3, 9))
}

fn test_a_tab_advances_to_the_next_multiple_of_five_columns(t: *testing.T) {
    let tabbed = ta_open_tabs("\ta\nabc\td\nabcde\tf\nabcd\te", 5)
    let spaced = ta_open("     a\nabc  d\nabcde     f\nabcd e")
    ta_same_caret_x(t, tabbed, ta_at(0, 1), spaced, ta_at(0, 5))
    ta_same_caret_x(t, tabbed, ta_at(1, 4), spaced, ta_at(1, 5))
    ta_same_caret_x(t, tabbed, ta_at(2, 6), spaced, ta_at(2, 10))
    ta_same_caret_x(t, tabbed, ta_at(3, 5), spaced, ta_at(3, 5))
}

fn test_two_tabs_in_a_row_and_a_tab_after_a_tab_count_expanded_columns(t: *testing.T) {
    let tabbed = ta_open_tabs("\t\ta\nab\t\tc\na\tb\tc", 4)
    let spaced = ta_open("        a\nab      c\na   b   c")
    ta_same_caret_x(t, tabbed, ta_at(0, 2), spaced, ta_at(0, 8))
    ta_same_caret_x(t, tabbed, ta_at(1, 4), spaced, ta_at(1, 8))
    ta_same_caret_x(t, tabbed, ta_at(2, 4), spaced, ta_at(2, 8))
}

fn test_a_tab_size_below_one_is_one_column(t: *testing.T) {
    let flat = ta_open_tabs("a\tb", 0)
    let negative = ta_open_tabs("a\tb", -3)
    let spaced = ta_open("a b")
    ta_same_caret_x(t, flat, ta_at(0, 2), spaced, ta_at(0, 2))
    ta_same_caret_x(t, negative, ta_at(0, 2), spaced, ta_at(0, 2))
}

fn test_a_wider_tab_size_moves_the_text_after_a_tab_right(t: *testing.T) {
    let four = ta_open_tabs("\ta", 4)
    let eight = ta_open_tabs("\ta", 8)
    testing.is_true(t, ta_caret_x_at(eight, 0, 1) > ta_caret_x_at(four, 0, 1))
}

fn test_a_click_inside_a_tab_lands_on_the_nearer_side(t: *testing.T) {
    let r = ta_open_tabs("\tab", 4)
    let span = ta_caret_x_at(r, 0, 1)
    testing.is_true(t, span > 8.0)
    ta_click(r, span * 0.25, 13.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
    ta_frame(r)
    ta_click(r, span * 0.75, 13.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
    ta_frame(r)
    ta_click(r, span + 1.0, 13.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
}

fn test_a_click_after_text_and_a_tab_counts_the_columns_the_tab_filled(t: *testing.T) {
    let r = ta_open_tabs("ab\tcd", 4)
    let start = ta_caret_x_at(r, 0, 2)
    let end = ta_caret_x_at(r, 0, 3)
    testing.is_true(t, end > start)
    ta_click(r, start + (end - start) * 0.25, 13.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 2)
    ta_frame(r)
    ta_click(r, start + (end - start) * 0.75, 13.0, 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 3)
}

fn test_dragging_across_a_tab_selects_to_the_column_under_the_pointer(t: *testing.T) {
    let r = ta_open_tabs("\tab", 4)
    let span = ta_caret_x_at(r, 0, 1)
    ta_down(r, 0.0, 13.0, 1, false)
    dispatch(r.cx, platform.Event.PointerMoved(span + 1.0, 13.0))
    ta_up(r, span + 1.0, 13.0, 1)
    let sel = text_area_selection(r.cx, "area")
    ta_expect(t, sel.anchor, 0, 0)
    ta_expect(t, sel.caret, 0, 1)
}

fn test_up_and_down_keep_the_x_of_a_caret_after_a_tab(t: *testing.T) {
    let r = ta_open_tabs("\tab\n    abc\n\tx", 4)
    ta_put(r, 0, 1)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 4)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 1)
    ta_press(r, platform.NamedKey.Up)
    ta_press(r, platform.NamedKey.Up)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 1)
}

fn test_a_selection_over_a_tab_is_as_wide_as_the_spaces_it_fills(t: *testing.T) {
    let tabbed = ta_open_tabs("a\tb", 4)
    let spaced = ta_open("a   b")
    ta_select(tabbed, ta_at(0, 1), ta_at(0, 2))
    ta_select(spaced, ta_at(0, 1), ta_at(0, 4))
    let got = ta_frame(tabbed)
    let want = ta_frame(spaced)
    testing.equal(t, got.quads[0].bounds.x, want.quads[0].bounds.x)
    testing.equal(t, got.quads[0].bounds.width, want.quads[0].bounds.width)
    testing.is_true(t, got.quads[0].bounds.width > 1.0)
}

fn test_a_line_of_tabs_is_as_wide_as_the_spaces_they_fill(t: *testing.T) {
    let tabbed = ta_open_tabs(strs.repeat("\t", 20), 8)
    let spaced = ta_open(strs.repeat(" ", 160))
    ta_frame(tabbed)
    ta_frame(spaced)
    testing.equal(t, area_state(tabbed.cx.state, "area").widest, area_state(spaced.cx.state, "area").widest)
}

fn test_blank_marks_draw_in_each_blank_cell_and_the_caret_line_has_its_own_colour(t: *testing.T) {
    let r = ta_open_marked("\ta b\n  c", 4)
    let first = ta_frame(r)
    let blue = ta_sprites_of(first, ta_caret_mark_color())
    let red = ta_sprites_of(first, ta_mark_color())
    testing.equal(t, blue.len, 2)
    testing.equal(t, red.len, 2)
    let span = ta_caret_x_at(r, 0, 1)
    let before = ta_caret_x_at(r, 0, 2)
    let after = ta_caret_x_at(r, 0, 3)
    let arrow = blue[0]
    testing.is_true(t, arrow.bounds.x >= -1.0 && arrow.bounds.x < span)
    testing.is_true(t, arrow.bounds.y >= 0.0 && arrow.bounds.y < 26.0)
    let dot = blue[1]
    testing.is_true(t, ta_centre(dot) >= before - 1.0 && ta_centre(dot) <= after + 1.0)
    let cell = ta_caret_x_at(r, 1, 1)
    testing.is_true(t, cell > 0.0)
    for k, s in red {
        let left = f32(k) * cell
        testing.is_true(t, ta_centre(s) > left && ta_centre(s) < left + cell)
        testing.is_true(t, s.bounds.y >= 26.0 && s.bounds.y < 52.0)
    }
}

fn test_the_marks_follow_the_caret_line(t: *testing.T) {
    let r = ta_open_marked("\ta b\n  c", 4)
    ta_put(r, 1, 0)
    let sc = ta_frame(r)
    testing.equal(t, ta_sprites_of(sc, ta_caret_mark_color()).len, 2)
    testing.equal(t, ta_sprites_of(sc, ta_mark_color()).len, 2)
    for s in ta_sprites_of(sc, ta_caret_mark_color()) {
        testing.is_true(t, s.bounds.y >= 26.0 && s.bounds.y < 52.0)
    }
    for s in ta_sprites_of(sc, ta_mark_color()) {
        testing.is_true(t, s.bounds.y >= 0.0 && s.bounds.y < 26.0)
    }
}

fn test_a_tab_arrow_starts_in_the_tabs_first_column_after_text(t: *testing.T) {
    let r = ta_open_marked("ab\tc", 4)
    let sc = ta_frame(r)
    let arrows = ta_sprites_of(sc, ta_caret_mark_color())
    testing.equal(t, arrows.len, 1)
    let start = ta_caret_x_at(r, 0, 2)
    let end = ta_caret_x_at(r, 0, 3)
    testing.is_true(t, arrows[0].bounds.x >= start - 1.0 && arrows[0].bounds.x < end)
}

fn test_marks_change_neither_the_text_nor_the_columns_nor_the_copy(t: *testing.T) {
    let marked = ta_open_marked("a\tb c", 4)
    let bare = ta_open_tabs("a\tb c", 4)
    let drawn = ta_frame(marked)
    let plain = ta_frame(bare)
    testing.equal(t, ta_sprites_of(plain, ta_mark_color()).len + ta_sprites_of(plain, ta_caret_mark_color()).len, 0)
    testing.equal(t, drawn.sprites.len, plain.sprites.len + 2)
    for col in [0, 1, 2, 3, 4, 5] {
        testing.equal(t, ta_caret_x_at(marked, 0, col), ta_caret_x_at(bare, 0, col))
    }
    testing.equal(t, area_state(marked.cx.state, "area").widest, area_state(bare.cx.state, "area").widest)
    ta_ctrl(marked, "a", false)
    ta_ctrl(marked, "c", false)
    testing.equal(t, clipboard(marked.cx) ?? "", "a\tb c")
    testing.equal(t, ta_text(marked), "a\tb c")
}

fn test_marks_are_off_unless_asked_for(t: *testing.T) {
    let r = ta_open("a b\n\tc")
    let sc = ta_frame(r)
    testing.equal(t, sc.sprites.len, 3)
}

fn test_a_no_break_space_is_marked_and_a_letter_is_not(t: *testing.T) {
    let r = ta_open_marked("a\u{00a0}b", 4)
    let sc = ta_frame(r)
    testing.equal(t, ta_sprites_of(sc, ta_caret_mark_color()).len, 1)
    testing.equal(t, sc.sprites.len, 3)
}

struct RoRig {
    r: TaRig
    locked: Signal[bool]
    edits: Signal[i64]
    keys: Signal[i64]
    clicks: Signal[i64]
    tabs: Signal[i64]
}

fn ro_open(initial: str, locked_at_start: bool) -> RoRig {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, strs.split_str(initial, "\n"))
    let locked = signal(cx, locked_at_start)
    let edits = signal(cx, 0)
    let keys = signal(cx, 0)
    let clicks = signal(cx, 0)
    let tabs = signal(cx, 0)
    let inner = ta_source(doc)
    let apply = fn(ed: TextEdit) {
        set(edits, get(edits) + 1)
        inner.edit(ed)
    }
    let counted = line_source(inner.line_count, inner.line_text, apply)
    let seen = fn(k: platform.KeyEvent) -> bool {
        set(keys, get(keys) + 1)
        false
    }
    let clicked = fn(c: ClickEvent) {
        set(clicks, get(clicks) + 1)
    }
    let tabbed = fn() {
        set(tabs, get(tabs) + 1)
    }
    let view = fn() -> Element {
        let area = text_area(counted).id("area").size(200.0, 104.0).on_click(clicked)
        let shown = if get(locked) { area.read_only() } else { area }
        div().on_key(seen).on_action("text_area.tab", tabbed).child(shown)
    }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    set_focus(cx, "area")
    ta_frame(r)
    RoRig { r, locked, edits, keys, clicks, tabs }
}

fn ro_lock(o: RoRig, locked: bool) {
    set(o.locked, locked)
    ta_frame(o.r)
}

fn ro_expect(t: *testing.T, o: RoRig, text: str, want: TextSelection, edits: i64) {
    testing.equal(t, ta_text(o.r), text)
    let s = text_area_selection(o.r.cx, "area")
    ta_expect(t, s.anchor, want.anchor.line, want.anchor.column)
    ta_expect(t, s.caret, want.caret.line, want.caret.column)
    testing.equal(t, get(o.edits), edits)
}

fn ro_refused_count() -> i64 {
    20
}

fn ro_refused(o: RoRig, n: i64) {
    let r = o.r
    match n {
        0 => ta_type(r, "X")
        1 => ta_press(r, platform.NamedKey.Backspace)
        2 => ta_press(r, platform.NamedKey.Delete)
        3 => ta_key(r, platform.NamedKey.Backspace, false, true)
        4 => ta_key(r, platform.NamedKey.Delete, false, true)
        5 => ta_key(r, platform.NamedKey.Backspace, true, false)
        6 => ta_press(r, platform.NamedKey.Enter)
        7 => ta_key(r, platform.NamedKey.Enter, true, false)
        8 => ta_press(r, platform.NamedKey.Tab)
        9 => ta_ctrl(r, "x", false)
        10 => ta_ctrl(r, "v", false)
        11 => ta_ctrl(r, "z", false)
        12 => ta_ctrl(r, "y", false)
        13 => ta_ctrl(r, "z", true)
        14 => dispatch(r.cx, platform.Event.Preedit("ni", platform.TextRange { start: 0, end: 2 }))
        15 => dispatch(r.cx, platform.Event.Commit("Q"))
        16 => dispatch(r.cx, platform.Event.Commit("x\ny"))
        17 => dispatch(r.cx, platform.Event.Preedit("", none))
        18 => ta_type(r, " ")
        _ => ta_type(r, "\t")
    }
    ta_frame(r)
}

fn test_a_read_only_text_area_refuses_every_editing_key_and_input_method_text(t: *testing.T) {
    let o = ro_open("abc\ndef\nghi", true)
    ta_select(o.r, ta_at(0, 1), ta_at(1, 2))
    let want = text_area_selection(o.r.cx, "area")
    set_clipboard(o.r.cx, "clip")
    for n in 0..ro_refused_count() {
        ro_refused(o, n)
        ro_expect(t, o, "abc\ndef\nghi", want, 0)
        testing.equal(t, clipboard(o.r.cx) ?? "", "clip")
        testing.is_true(t, text_input(o.r.cx) == none)
    }
    ta_put(o.r, 1, 1)
    let collapsed = text_area_selection(o.r.cx, "area")
    for n in 0..ro_refused_count() {
        ro_refused(o, n)
        ro_expect(t, o, "abc\ndef\nghi", collapsed, 0)
    }
}

fn test_a_read_only_text_area_refuses_the_editing_actions(t: *testing.T) {
    let o = ro_open("abc\ndef", true)
    ta_select(o.r, ta_at(0, 1), ta_at(1, 1))
    let want = text_area_selection(o.r.cx, "area")
    set_clipboard(o.r.cx, "clip")
    let names = ["text_area.backspace", "text_area.delete", "text_area.delete_word_left", "text_area.delete_word_right", "text_area.new_line", "text_area.cut", "text_area.paste", "text_area.undo", "text_area.redo"]
    for name in names {
        testing.is_false(t, dispatch_action(o.r.cx, name))
        testing.is_false(t, is_action_available(o.r.cx, name))
        ro_expect(t, o, "abc\ndef", want, 0)
    }
    testing.equal(t, clipboard(o.r.cx) ?? "", "clip")
    let available = available_actions(o.r.cx)
    for name in names {
        testing.is_false(t, listed(available, name))
    }
    testing.is_true(t, listed(available, "text_area.copy"))
    testing.is_true(t, listed(available, "text_area.select_all"))
    testing.is_true(t, listed(available, "text_area.left"))
    ro_lock(o, false)
    for name in names {
        testing.is_true(t, is_action_available(o.r.cx, name))
    }
}

fn test_undo_and_redo_are_refused_while_read_only_and_work_again_after(t: *testing.T) {
    let o = ro_open("ab", false)
    ta_press(o.r, platform.NamedKey.End)
    ta_type(o.r, "X")
    testing.equal(t, ta_text(o.r), "abX")
    let after = text_area_selection(o.r.cx, "area")
    ro_lock(o, true)
    ta_ctrl(o.r, "z", false)
    ro_expect(t, o, "abX", after, 1)
    ro_lock(o, false)
    ta_ctrl(o.r, "z", false)
    testing.equal(t, ta_text(o.r), "ab")
    let undone = text_area_selection(o.r.cx, "area")
    ro_lock(o, true)
    ta_ctrl(o.r, "y", false)
    ro_expect(t, o, "ab", undone, 2)
    ro_lock(o, false)
    ta_ctrl(o.r, "y", false)
    testing.equal(t, ta_text(o.r), "abX")
}

fn test_a_read_only_text_area_keeps_keyboard_selection_and_caret_movement(t: *testing.T) {
    let o = ro_open("aaa aaa\naaaaa\naaaa", true)
    let r = o.r
    ta_press(r, platform.NamedKey.Right)
    ta_press(r, platform.NamedKey.Right)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 2)
    ta_press(r, platform.NamedKey.Down)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 2)
    ta_press(r, platform.NamedKey.Up)
    ta_press(r, platform.NamedKey.Home)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
    ta_press(r, platform.NamedKey.End)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 7)
    ta_key(r, platform.NamedKey.End, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 4)
    ta_key(r, platform.NamedKey.Home, false, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
    ta_key(r, platform.NamedKey.Right, true, false)
    ta_key(r, platform.NamedKey.Right, true, false)
    var s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 0)
    ta_expect(t, s.caret, 0, 2)
    ta_key(r, platform.NamedKey.Down, true, false)
    s = text_area_selection(r.cx, "area")
    ta_expect(t, s.caret, 1, 2)
    ta_key(r, platform.NamedKey.End, true, false)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 5)
    ta_press(r, platform.NamedKey.Left)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 0)
    ta_put(r, 0, 0)
    dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Right), modifiers: platform.Modifiers { control: true, shift: true } }))
    s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 0)
    ta_expect(t, s.caret, 0, 3)
    ta_key(r, platform.NamedKey.End, true, true)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 2, 4)
    testing.equal(t, ta_text(r), "aaa aaa\naaaaa\naaaa")
    testing.equal(t, get(o.edits), 0)
}

fn test_a_read_only_text_area_selects_all_and_copies(t: *testing.T) {
    let o = ro_open("one two\nthree\nfour", true)
    let r = o.r
    ta_ctrl(r, "a", false)
    let s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 0)
    ta_expect(t, s.caret, 2, 4)
    testing.equal(t, clipboard(r.cx) ?? "", "")
    ta_ctrl(r, "c", false)
    testing.equal(t, clipboard(r.cx) ?? "", "one two\nthree\nfour")
    set_clipboard(r.cx, "")
    testing.is_true(t, dispatch_action(r.cx, "text_area.copy"))
    testing.equal(t, clipboard(r.cx) ?? "", "one two\nthree\nfour")
    ta_select(r, ta_at(0, 4), ta_at(1, 2))
    ta_ctrl(r, "c", false)
    testing.equal(t, clipboard(r.cx) ?? "", "two\nth")
    set_clipboard(r.cx, "")
    testing.is_true(t, dispatch_action(r.cx, "text_area.select_all"))
    ta_ctrl(r, "c", false)
    testing.equal(t, clipboard(r.cx) ?? "", "one two\nthree\nfour")
    ro_expect(t, o, "one two\nthree\nfour", TextSelection { anchor: ta_at(0, 0), caret: ta_at(2, 4) }, 0)
}

fn test_a_read_only_text_area_keeps_pointer_selection(t: *testing.T) {
    let o = ro_open("hello world\nsecond line\nthird", true)
    let r = o.r
    blur(r.cx)
    ta_frame(r)
    ta_click(r, ta_width("hello"), 13.0, 1)
    testing.equal(t, r.cx.state.focus, "area")
    ta_expect(t, text_area_selection(r.cx, "area").caret, 0, 5)
    ta_frame(r)
    ta_down(r, ta_width("he") + 0.1, 13.0, 1, false)
    dispatch(r.cx, platform.Event.PointerMoved(ta_width("sec") + 0.1, 39.0))
    ta_up(r, ta_width("sec") + 0.1, 39.0, 1)
    var s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 2)
    ta_expect(t, s.caret, 1, 3)
    ta_frame(r)
    ta_click(r, ta_width("hello wo"), 13.0, 2)
    s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 0, 6)
    ta_expect(t, s.caret, 0, 11)
    ta_frame(r)
    ta_click(r, 5.0, 39.0, 3)
    s = text_area_selection(r.cx, "area")
    ta_expect(t, s.anchor, 1, 0)
    ta_expect(t, s.caret, 2, 0)
    ta_ctrl(r, "c", false)
    testing.equal(t, clipboard(r.cx) ?? "", "second line\n")
    testing.equal(t, ta_text(r), "hello world\nsecond line\nthird")
    testing.equal(t, get(o.edits), 0)
}

fn test_a_read_only_text_area_scrolls_and_draws_its_caret_but_opens_no_input_method(t: *testing.T) {
    let o = ro_open(ta_numbered(20), true)
    let r = o.r
    let plain = ta_open(ta_numbered(20))
    testing.is_true(t, text_input(plain.cx) != none)
    testing.is_true(t, text_input(r.cx) == none)
    let locked = ta_frame(r)
    let editable = ta_frame(plain)
    testing.equal(t, locked.quads.len, editable.quads.len)
    testing.equal(t, locked.sprites.len, editable.sprites.len)
    ta_wheel(r, 0.0, 30.0)
    ta_frame(r)
    testing.is_true(t, text_area_top_line(r.cx, "area") > 0)
    ta_key(r, platform.NamedKey.End, false, true)
    ta_frame(r)
    testing.equal(t, text_area_top_line(r.cx, "area"), 16)
    testing.is_true(t, text_input(r.cx) == none)
}

fn test_the_input_method_caret_follows_the_read_only_state(t: *testing.T) {
    let o = ro_open("ab", false)
    testing.is_true(t, text_input(o.r.cx) != none)
    ro_lock(o, true)
    testing.is_true(t, text_input(o.r.cx) == none)
    ro_lock(o, false)
    testing.is_true(t, text_input(o.r.cx) != none)
}

fn test_a_composition_in_progress_is_dropped_when_the_area_becomes_read_only(t: *testing.T) {
    let o = ro_open("ab", false)
    ta_press(o.r, platform.NamedKey.End)
    dispatch(o.r.cx, platform.Event.Preedit("ni", platform.TextRange { start: 0, end: 2 }))
    ta_frame(o.r)
    testing.equal(t, area_state(o.r.cx.state, "area").preedit, "ni")
    ro_lock(o, true)
    testing.equal(t, area_state(o.r.cx.state, "area").preedit, "")
    testing.is_true(t, text_input(o.r.cx) == none)
    dispatch(o.r.cx, platform.Event.Commit("Q"))
    testing.equal(t, ta_text(o.r), "ab")
    testing.equal(t, get(o.edits), 0)
}

fn test_refused_editing_keys_reach_on_key_handlers_of_the_elements_around(t: *testing.T) {
    let o = ro_open("ab", true)
    ta_press(o.r, platform.NamedKey.Backspace)
    testing.equal(t, get(o.keys), 1)
    ta_type(o.r, "x")
    testing.equal(t, get(o.keys), 2)
    ta_ctrl(o.r, "v", false)
    testing.equal(t, get(o.keys), 3)
    ta_press(o.r, platform.NamedKey.Left)
    testing.equal(t, get(o.keys), 3)
    ta_ctrl(o.r, "c", false)
    testing.equal(t, get(o.keys), 3)
    let editable = ro_open("ab", false)
    ta_press(editable.r, platform.NamedKey.End)
    ta_press(editable.r, platform.NamedKey.Backspace)
    ta_type(editable.r, "x")
    testing.equal(t, get(editable.keys), 0)
}

fn test_a_refused_enter_runs_the_click_handler(t: *testing.T) {
    let o = ro_open("ab", true)
    ta_press(o.r, platform.NamedKey.Enter)
    testing.equal(t, get(o.clicks), 1)
    testing.equal(t, ta_text(o.r), "ab")
    let editable = ro_open("ab", false)
    ta_press(editable.r, platform.NamedKey.Enter)
    testing.equal(t, get(editable.clicks), 0)
    testing.equal(t, ta_text(editable.r), "\nab")
}

fn test_tab_moves_focus_through_and_out_of_a_read_only_text_area(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, ["abc"])
    let src = ta_source(doc)
    let view = fn() -> Element {
        let area = text_area(src).id("area").size(200.0, 104.0).read_only()
        let after = div().id("after").focusable().size(20.0, 20.0)
        div().children() {
            area,
            after,
        }
    }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    set_focus(cx, "area")
    ta_frame(r)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Tab) }))
    testing.equal(t, cx.state.focus, "after")
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Tab), modifiers: platform.Modifiers { shift: true } }))
    testing.equal(t, cx.state.focus, "area")
    testing.equal(t, ta_text(r), "abc")
}

fn test_an_ancestor_action_handler_still_runs_for_a_refused_action(t: *testing.T) {
    let o = ro_open("ab", true)
    ta_press(o.r, platform.NamedKey.Tab)
    testing.equal(t, get(o.tabs), 1)
    testing.equal(t, ta_text(o.r), "ab")
}

struct BatchRig {
    r: TaRig
    calls: Signal[i64]
    singles: Signal[i64]
    last: Signal[TextEdit[]]
    mode: Signal[i64]
}

fn ta_chord(r: TaRig, n: platform.NamedKey, shift: bool, control: bool, alt: bool) {
    let mods = platform.Modifiers { shift: shift, control: control, alt: alt }
    dispatch(r.cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(n), modifiers: mods }))
}

fn ta_down_with(r: TaRig, x: f32, y: f32, clicks: i64, mods: platform.Modifiers) {
    dispatch(r.cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Left, x: x, y: y, clicks: clicks, modifiers: mods }))
}

fn ta_up_with(r: TaRig, x: f32, y: f32, mods: platform.Modifiers) {
    dispatch(r.cx, platform.Event.PointerUp(platform.ButtonEvent { button: platform.Button.Left, x: x, y: y, clicks: 1, modifiers: mods }))
}

fn ta_many(r: TaRig, at: TextPosition[]) {
    var sels: TextSelection[] = []
    for p in at {
        sels.push(TextSelection { anchor: p, caret: p })
    }
    set_text_area_selections(r.cx, "area", sels)
    ta_frame(r)
}

fn ta_ranges(r: TaRig, ranges: TextSelection[]) {
    set_text_area_selections(r.cx, "area", ranges)
    ta_frame(r)
}

fn ta_range(from: TextPosition, to: TextPosition) -> TextSelection {
    TextSelection { anchor: from, caret: to }
}

fn ta_expect_carets(t: *testing.T, r: TaRig, want: TextPosition[]) {
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, want.len)
    if got.len != want.len {
        return
    }
    for i in 0..want.len {
        ta_expect(t, got[i].caret, want[i].line, want[i].column)
        ta_expect(t, got[i].anchor, want[i].line, want[i].column)
    }
}

fn ta_expect_range(t: *testing.T, got: TextSelection, anchor: TextPosition, caret: TextPosition) {
    ta_expect(t, got.anchor, anchor.line, anchor.column)
    ta_expect(t, got.caret, caret.line, caret.column)
}

fn ta_count(r: TaRig) -> i64 {
    text_area_selections(r.cx, "area").len
}

fn ta_open_batched(initial: str) -> BatchRig {
    let cx = headless(rgb(0xffffff))
    bind_keys(cx, text_area_bindings())
    let doc = signal(cx, strs.split_str(initial, "\n"))
    let calls = signal(cx, 0)
    let singles = signal(cx, 0)
    let none_sent: TextEdit[] = []
    let last = signal(cx, none_sent)
    let mode = signal(cx, 0)
    let inner = ta_source(doc)
    let one = fn(ed: TextEdit) {
        set(singles, get(singles) + 1)
        ta_apply(doc, ed)
    }
    let all = fn(eds: TextEdit[]) {
        set(calls, get(calls) + 1)
        set(last, eds)
        if get(mode) == 0 {
            for ed in eds {
                ta_apply(doc, ed)
            }
        }
    }
    var src = line_source(inner.line_count, inner.line_text, one)
    src.edit_all = some(all)
    let view = fn() -> Element { text_area(src).id("area").size(200.0, 104.0) }
    let r = TaRig { cx, doc, view }
    ta_frame(r)
    set_focus(cx, "area")
    ta_frame(r)
    BatchRig { r, calls, singles, last, mode }
}

fn test_selections_are_kept_in_document_order_and_overlaps_merge(t: *testing.T) {
    let r = ta_open("abcdef\nghijkl\nmnop")
    var sels: TextSelection[] = []
    sels.push(ta_range(ta_at(2, 1), ta_at(2, 3)))
    sels.push(ta_range(ta_at(0, 4), ta_at(0, 1)))
    sels.push(ta_range(ta_at(0, 2), ta_at(0, 3)))
    sels.push(ta_range(ta_at(1, 0), ta_at(1, 0)))
    set_text_area_selections(r.cx, "area", sels)
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 3)
    ta_expect_range(t, got[0], ta_at(0, 4), ta_at(0, 1))
    ta_expect_range(t, got[1], ta_at(1, 0), ta_at(1, 0))
    ta_expect_range(t, got[2], ta_at(2, 1), ta_at(2, 3))
    ta_expect_range(t, text_area_selection(r.cx, "area"), ta_at(0, 4), ta_at(0, 1))
}

fn test_carets_that_meet_merge_and_touching_ranges_stay_apart(t: *testing.T) {
    let r = ta_open("abcdef")
    ta_many(r, [ta_at(0, 1), ta_at(0, 1), ta_at(0, 3)])
    testing.equal(t, ta_count(r), 2)
    var touching: TextSelection[] = []
    touching.push(ta_range(ta_at(0, 0), ta_at(0, 2)))
    touching.push(ta_range(ta_at(0, 2), ta_at(0, 4)))
    ta_ranges(r, touching)
    testing.equal(t, ta_count(r), 2)
    var caret_at_edge: TextSelection[] = []
    caret_at_edge.push(ta_range(ta_at(0, 0), ta_at(0, 2)))
    caret_at_edge.push(ta_range(ta_at(0, 2), ta_at(0, 2)))
    ta_ranges(r, caret_at_edge)
    testing.equal(t, ta_count(r), 1)
    ta_expect_range(t, text_area_selection(r.cx, "area"), ta_at(0, 0), ta_at(0, 2))
}

fn test_setting_one_selection_drops_the_others_and_an_empty_list_changes_nothing(t: *testing.T) {
    let r = ta_open("abc\ndef")
    ta_many(r, [ta_at(0, 1), ta_at(1, 1)])
    testing.equal(t, ta_count(r), 2)
    let none_given: TextSelection[] = []
    set_text_area_selections(r.cx, "area", none_given)
    testing.equal(t, ta_count(r), 2)
    ta_put(r, 1, 2)
    testing.equal(t, ta_count(r), 1)
    ta_expect(t, text_area_selection(r.cx, "area").caret, 1, 2)
}

fn test_selections_past_the_document_are_moved_inside_it(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_many(r, [ta_at(0, 99), ta_at(9, 9)])
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 2)
    ta_expect(t, got[0].caret, 0, 2)
    ta_expect(t, got[1].caret, 1, 2)
}

fn test_typing_applies_at_every_caret_and_one_undo_restores_them_all(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_many(r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1)])
    ta_type(r, "X")
    testing.equal(t, ta_text(r), "aXb\ncXd\neXf")
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 2), ta_at(2, 2)])
    ta_type(r, "Y")
    testing.equal(t, ta_text(r), "aXYb\ncXYd\neXYf")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab\ncd\nef")
    ta_expect_carets(t, r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1)])
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "aXYb\ncXYd\neXYf")
    ta_expect_carets(t, r, [ta_at(0, 3), ta_at(1, 3), ta_at(2, 3)])
    ta_ctrl(r, "z", false)
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab\ncd\nef")
}

fn test_typing_over_several_selections_replaces_each_and_undo_restores_the_ranges(t: *testing.T) {
    let r = ta_open("abcd\nefgh")
    var sels: TextSelection[] = []
    sels.push(ta_range(ta_at(0, 1), ta_at(0, 3)))
    sels.push(ta_range(ta_at(1, 2), ta_at(1, 0)))
    ta_ranges(r, sels)
    ta_type(r, "Z")
    testing.equal(t, ta_text(r), "aZd\nZgh")
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 1)])
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abcd\nefgh")
    let back = text_area_selections(r.cx, "area")
    testing.equal(t, back.len, 2)
    ta_expect_range(t, back[0], ta_at(0, 1), ta_at(0, 3))
    ta_expect_range(t, back[1], ta_at(1, 2), ta_at(1, 0))
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "aZd\nZgh")
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 1)])
}

fn test_enter_with_two_carets_on_one_line_breaks_the_line_twice(t: *testing.T) {
    let r = ta_open("abcd")
    ta_many(r, [ta_at(0, 1), ta_at(0, 3)])
    ta_press(r, platform.NamedKey.Enter)
    testing.equal(t, ta_text(r), "a\nbc\nd")
    ta_expect_carets(t, r, [ta_at(1, 0), ta_at(2, 0)])
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abcd")
    ta_expect_carets(t, r, [ta_at(0, 1), ta_at(0, 3)])
    ta_ctrl(r, "y", false)
    testing.equal(t, ta_text(r), "a\nbc\nd")
    ta_expect_carets(t, r, [ta_at(1, 0), ta_at(2, 0)])
}

fn test_tab_inserts_a_tab_at_every_caret(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_many(r, [ta_at(0, 1), ta_at(1, 2)])
    ta_press(r, platform.NamedKey.Tab)
    testing.equal(t, ta_text(r), "a\tb\ncd\t")
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 3)])
}

fn test_backspace_and_delete_apply_at_every_caret(t: *testing.T) {
    let r = ta_open("abc\ndef\nghi")
    ta_many(r, [ta_at(0, 2), ta_at(1, 2), ta_at(2, 2)])
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "ac\ndf\ngi")
    ta_expect_carets(t, r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1)])
    ta_press(r, platform.NamedKey.Delete)
    testing.equal(t, ta_text(r), "a\nd\ng")
    ta_expect_carets(t, r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1)])
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ac\ndf\ngi")
    ta_expect_carets(t, r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1)])
}

fn test_delete_at_line_ends_joins_each_following_line(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_many(r, [ta_at(0, 2), ta_at(1, 2), ta_at(2, 2)])
    ta_press(r, platform.NamedKey.Delete)
    testing.equal(t, ta_text(r), "abcdef")
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(0, 4), ta_at(0, 6)])
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab\ncd\nef")
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 2), ta_at(2, 2)])
}

fn test_backspace_at_a_line_start_beside_a_caret_at_the_previous_line_end_merges_the_edits(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_many(r, [ta_at(0, 2), ta_at(1, 0)])
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "acd")
    ta_expect_carets(t, r, [ta_at(0, 1)])
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "ab\ncd")
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 0)])
}

fn test_deleting_a_word_with_two_carets_in_it_removes_it_once(t: *testing.T) {
    let r = ta_open("abcdef ghi")
    ta_many(r, [ta_at(0, 2), ta_at(0, 5)])
    ta_key(r, platform.NamedKey.Backspace, false, true)
    testing.equal(t, ta_text(r), "f ghi")
    ta_expect_carets(t, r, [ta_at(0, 0)])
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abcdef ghi")
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(0, 5)])
}

fn test_a_backspace_in_a_run_with_selections_does_not_group(t: *testing.T) {
    let r = ta_open("abcd\nefgh")
    var sels: TextSelection[] = []
    sels.push(ta_range(ta_at(0, 0), ta_at(0, 1)))
    sels.push(ta_range(ta_at(1, 0), ta_at(1, 1)))
    ta_ranges(r, sels)
    ta_press(r, platform.NamedKey.Backspace)
    testing.equal(t, ta_text(r), "bcd\nfgh")
    ta_press(r, platform.NamedKey.Delete)
    testing.equal(t, ta_text(r), "cd\ngh")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "bcd\nfgh")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "abcd\nefgh")
}

fn test_copy_joins_the_selections_with_line_breaks_and_cut_removes_them(t: *testing.T) {
    let r = ta_open("one two\nthree")
    var sels: TextSelection[] = []
    sels.push(ta_range(ta_at(0, 0), ta_at(0, 3)))
    sels.push(ta_range(ta_at(1, 0), ta_at(1, 5)))
    ta_ranges(r, sels)
    ta_ctrl(r, "c", false)
    testing.equal(t, clipboard(r.cx) ?? "", "one\nthree")
    ta_ctrl(r, "x", false)
    testing.equal(t, ta_text(r), " two\n")
    ta_expect_carets(t, r, [ta_at(0, 0), ta_at(1, 0)])
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "one two\nthree")
    testing.equal(t, ta_count(r), 2)
}

fn test_copy_with_only_empty_selections_leaves_the_clipboard_alone(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_many(r, [ta_at(0, 1), ta_at(1, 1)])
    set_clipboard(r.cx, "keep")
    ta_ctrl(r, "c", false)
    testing.equal(t, clipboard(r.cx) ?? "", "keep")
    ta_ctrl(r, "x", false)
    testing.equal(t, ta_text(r), "ab\ncd")
}

fn test_paste_puts_one_line_at_each_caret_when_the_counts_match(t: *testing.T) {
    let r = ta_open("a\nb\nc")
    ta_many(r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1)])
    set_clipboard(r.cx, "1\n2\n3")
    ta_ctrl(r, "v", false)
    testing.equal(t, ta_text(r), "a1\nb2\nc3")
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 2), ta_at(2, 2)])
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "a\nb\nc")
    ta_expect_carets(t, r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1)])
}

fn test_paste_puts_the_whole_text_at_each_caret_when_the_counts_differ(t: *testing.T) {
    let r = ta_open("a\nb\nc")
    ta_many(r, [ta_at(0, 1), ta_at(2, 1)])
    set_clipboard(r.cx, "1\n2\n3")
    ta_ctrl(r, "v", false)
    testing.equal(t, ta_text(r), "a1\n2\n3\nb\nc1\n2\n3")
    ta_expect_carets(t, r, [ta_at(2, 1), ta_at(6, 1)])
    let plain = ta_open("ab\ncd")
    ta_many(plain, [ta_at(0, 0), ta_at(1, 0)])
    set_clipboard(plain.cx, "xy")
    ta_ctrl(plain, "v", false)
    testing.equal(t, ta_text(plain), "xyab\nxycd")
}

fn test_a_commit_from_the_input_method_goes_to_every_caret(t: *testing.T) {
    let r = ta_open("ab\ncd")
    ta_many(r, [ta_at(0, 1), ta_at(1, 1)])
    dispatch(r.cx, platform.Event.Commit("Q"))
    testing.equal(t, ta_text(r), "aQb\ncQd")
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 2)])
}

fn test_a_composition_with_several_selections_removes_them_and_shows_at_the_first(t: *testing.T) {
    let r = ta_open("abcd\nefgh")
    var sels: TextSelection[] = []
    sels.push(ta_range(ta_at(0, 1), ta_at(0, 3)))
    sels.push(ta_range(ta_at(1, 1), ta_at(1, 3)))
    ta_ranges(r, sels)
    dispatch(r.cx, platform.Event.Preedit("ni", platform.TextRange { start: 0, end: 2 }))
    testing.equal(t, ta_text(r), "ad\neh")
    ta_expect_carets(t, r, [ta_at(0, 1), ta_at(1, 1)])
    let caret = text_input(r.cx) ?? platform.Caret {}
    testing.is_true(t, caret.y < 26)
}

fn test_every_caret_moves_with_the_arrows_and_carets_that_meet_merge(t: *testing.T) {
    let r = ta_open("abc\ndef")
    ta_many(r, [ta_at(0, 1), ta_at(1, 1)])
    ta_press(r, platform.NamedKey.Right)
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 2)])
    ta_press(r, platform.NamedKey.Left)
    ta_press(r, platform.NamedKey.Left)
    ta_expect_carets(t, r, [ta_at(0, 0), ta_at(1, 0)])
    ta_press(r, platform.NamedKey.Left)
    ta_expect_carets(t, r, [ta_at(0, 0), ta_at(0, 3)])
    ta_many(r, [ta_at(0, 0), ta_at(0, 1)])
    ta_press(r, platform.NamedKey.Left)
    ta_expect_carets(t, r, [ta_at(0, 0)])
}

fn test_shift_arrows_extend_every_selection_and_arrows_collapse_each_to_its_edge(t: *testing.T) {
    let r = ta_open("abcdef\nghijkl")
    ta_many(r, [ta_at(0, 1), ta_at(1, 1)])
    ta_key(r, platform.NamedKey.Right, true, false)
    ta_key(r, platform.NamedKey.Right, true, false)
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 2)
    ta_expect_range(t, got[0], ta_at(0, 1), ta_at(0, 3))
    ta_expect_range(t, got[1], ta_at(1, 1), ta_at(1, 3))
    ta_press(r, platform.NamedKey.Left)
    ta_expect_carets(t, r, [ta_at(0, 1), ta_at(1, 1)])
    ta_key(r, platform.NamedKey.Right, true, false)
    ta_press(r, platform.NamedKey.Right)
    ta_expect_carets(t, r, [ta_at(0, 2), ta_at(1, 2)])
}

fn test_word_and_line_moves_apply_to_every_caret(t: *testing.T) {
    let r = ta_open("one two\nthree four")
    ta_many(r, [ta_at(0, 0), ta_at(1, 0)])
    ta_key(r, platform.NamedKey.Right, false, true)
    ta_expect_carets(t, r, [ta_at(0, 3), ta_at(1, 5)])
    ta_press(r, platform.NamedKey.End)
    ta_expect_carets(t, r, [ta_at(0, 7), ta_at(1, 10)])
    ta_press(r, platform.NamedKey.Home)
    ta_expect_carets(t, r, [ta_at(0, 0), ta_at(1, 0)])
    ta_key(r, platform.NamedKey.End, true, false)
    let got = text_area_selections(r.cx, "area")
    ta_expect_range(t, got[0], ta_at(0, 0), ta_at(0, 7))
    ta_expect_range(t, got[1], ta_at(1, 0), ta_at(1, 10))
}

fn test_the_document_edges_merge_every_caret_into_one(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_many(r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1)])
    ta_key(r, platform.NamedKey.End, false, true)
    ta_expect_carets(t, r, [ta_at(2, 2)])
}

fn test_vertical_moves_keep_the_preferred_column_of_each_caret(t: *testing.T) {
    let r = ta_open("abcdef\nab\nabcdef\nxyzxyz\nxy\nxyzxyz")
    ta_many(r, [ta_at(0, 4), ta_at(3, 3)])
    ta_press(r, platform.NamedKey.Down)
    ta_expect_carets(t, r, [ta_at(1, 2), ta_at(4, 2)])
    ta_press(r, platform.NamedKey.Down)
    ta_expect_carets(t, r, [ta_at(2, 4), ta_at(5, 3)])
    ta_press(r, platform.NamedKey.Up)
    ta_press(r, platform.NamedKey.Up)
    ta_expect_carets(t, r, [ta_at(0, 4), ta_at(3, 3)])
}

fn test_carets_moved_onto_one_line_by_an_arrow_merge(t: *testing.T) {
    let r = ta_open("abcdef\nab")
    ta_many(r, [ta_at(0, 5), ta_at(1, 2)])
    ta_press(r, platform.NamedKey.Down)
    ta_expect_carets(t, r, [ta_at(1, 2)])
}

fn test_add_cursor_below_and_above_grow_the_set_one_line_at_a_time(t: *testing.T) {
    let r = ta_open("aaaa\naaaa\naa\naaaa")
    ta_put(r, 0, 3)
    ta_chord(r, platform.NamedKey.Down, false, true, true)
    ta_expect_carets(t, r, [ta_at(0, 3), ta_at(1, 3)])
    ta_chord(r, platform.NamedKey.Down, false, true, true)
    ta_expect_carets(t, r, [ta_at(0, 3), ta_at(1, 3), ta_at(2, 2)])
    ta_chord(r, platform.NamedKey.Down, false, true, true)
    ta_expect_carets(t, r, [ta_at(0, 3), ta_at(1, 3), ta_at(2, 2), ta_at(3, 3)])
    ta_chord(r, platform.NamedKey.Down, false, true, true)
    testing.equal(t, ta_count(r), 4)
    ta_put(r, 3, 1)
    ta_chord(r, platform.NamedKey.Up, false, true, true)
    ta_chord(r, platform.NamedKey.Up, false, true, true)
    ta_expect_carets(t, r, [ta_at(1, 1), ta_at(2, 1), ta_at(3, 1)])
    ta_chord(r, platform.NamedKey.Up, false, true, true)
    ta_chord(r, platform.NamedKey.Up, false, true, true)
    ta_expect_carets(t, r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1), ta_at(3, 1)])
}

fn test_add_cursor_adds_above_each_selection_and_merges_duplicates(t: *testing.T) {
    let r = ta_open("aaa\naaa\naaa\naaa")
    ta_many(r, [ta_at(1, 1), ta_at(2, 1), ta_at(3, 3)])
    ta_chord(r, platform.NamedKey.Up, false, true, true)
    ta_expect_carets(t, r, [ta_at(0, 1), ta_at(1, 1), ta_at(2, 1), ta_at(2, 3), ta_at(3, 3)])
}

fn test_typing_after_add_cursor_inserts_in_each_line(t: *testing.T) {
    let r = ta_open("ab\ncd\nef")
    ta_put(r, 0, 1)
    ta_chord(r, platform.NamedKey.Down, false, true, true)
    ta_chord(r, platform.NamedKey.Down, false, true, true)
    ta_type(r, "-")
    testing.equal(t, ta_text(r), "a-b\nc-d\ne-f")
}

fn test_select_next_occurrence_selects_the_word_at_the_caret_first(t: *testing.T) {
    let r = ta_open("foo bar foo\nbaz foo Foo")
    ta_put(r, 0, 1)
    ta_ctrl(r, "d", false)
    testing.equal(t, ta_count(r), 1)
    ta_expect_range(t, text_area_selection(r.cx, "area"), ta_at(0, 0), ta_at(0, 3))
    ta_put(r, 0, 3)
    ta_ctrl(r, "d", false)
    ta_expect_range(t, text_area_selection(r.cx, "area"), ta_at(0, 0), ta_at(0, 3))
}

fn test_select_next_occurrence_adds_matches_case_sensitively_then_does_nothing(t: *testing.T) {
    let r = ta_open("foo bar foo\nbaz foo Foo")
    ta_put(r, 0, 1)
    ta_ctrl(r, "d", false)
    ta_ctrl(r, "d", false)
    var got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 2)
    ta_expect_range(t, got[1], ta_at(0, 8), ta_at(0, 11))
    ta_ctrl(r, "d", false)
    got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 3)
    ta_expect_range(t, got[2], ta_at(1, 4), ta_at(1, 7))
    ta_ctrl(r, "d", false)
    testing.equal(t, ta_count(r), 3)
    ta_type(r, "qux")
    testing.equal(t, ta_text(r), "qux bar qux\nbaz qux Foo")
    ta_ctrl(r, "z", false)
    testing.equal(t, ta_text(r), "foo bar foo\nbaz foo Foo")
    testing.equal(t, ta_count(r), 3)
}

fn test_select_next_occurrence_wraps_past_the_end_of_the_document(t: *testing.T) {
    let r = ta_open("foo bar foo")
    ta_select(r, ta_at(0, 8), ta_at(0, 11))
    ta_ctrl(r, "d", false)
    let got = text_area_selections(r.cx, "area")
    testing.equal(t, got.len, 2)
    ta_expect_range(t, got[0], ta_at(0, 0), ta_at(0, 3))
    ta_expect_range(t, got[1], ta_at(0, 8), ta_at(0, 11))
    ta_ctrl(r, "d", false)
    testing.equal(t, ta_count(r), 2)
}

fn test_select_next_occurrence_with_a_selected_text_that_occurs_once_does_nothing(t: *testing.T) {
    let r = ta_open("alpha beta")
    ta_select(r, ta_at(0, 6), ta_at(0, 10))
    ta_ctrl(r, "d", false)
    testing.equal(t, ta_count(r), 1)
    ta_expect_range(t, text_area_selection(r.cx, "area"), ta_at(0, 6), ta_at(0, 10))
}

