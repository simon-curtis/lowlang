import std/ui/font
import std/ui/fontconfig

/// Adds the embedded Inter Variable to an empty index, resolves a generic family through an alias, matches weights and slants against its named instances, and picks a face per code point.
fn main() {
    var ix = fontconfig.empty()
    print("faces added: {fontconfig.add(mut ix, font.fallback_file())}")
    ix.config.aliases = [fontconfig.Alias { family: "sans-serif", prefer: ["Inter Variable"] }]
    print("sans-serif tries {fontconfig.families(ix, "sans-serif")}")
    for weight in [100, 350, 400, 450, 650, 1000] {
        let face = fontconfig.find(ix, "sans-serif", weight, 0) ?? continue
        print("weight {weight}: {face.families[0]} {face.style}, instance {face.instance}")
    }
    let italic = fontconfig.find(ix, "Inter Variable", 400, 2) ?? return
    print("italic asked for, upright given: {italic.style}, slant {italic.slant}")
    print("unknown family: {fontconfig.find(ix, "Nowhere", 400, 0) == none}")
    let a = fontconfig.fallback(ix, "Nowhere", 400, 0, 'a') ?? return
    print("U+0061 falls back to {a.families[0]} {a.style}")
    print("U+4E16 falls back to anything: {fontconfig.fallback(ix, "Nowhere", 400, 0, 0x4e16) != none}")
}
