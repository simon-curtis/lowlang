import std/slices
import strs = std/text
import std/ui/font

const cache_header = "low-fontconfig 1"

enum Kind {
    Missing
    Dir
    File
}

struct Folder {
    path: str
    modified: i64
    subdirs: str[]
    faces: Face[]
}

struct Scan {
    cached: [str: Folder]
    folders: Folder[]
    seen: [str: bool]
    rescanned: i64
}

fn cache_path(env: Environment) -> str {
    joined(env.cache_home, "low/fontconfig.cache")
}

fn gather(env: Environment, dirs: str[]) -> Scan {
    let s = new(Scan { cached: read_cache(cache_path(env)), folders: [], seen: [:], rescanned: 0 })
    for d in dirs {
        visit(s, d, 0)
    }
    if s.rescanned > 0 || s.cached.len != s.folders.len {
        write_cache(cache_path(env), cache_text(s.folders))
    }
    *s
}

fn visit(s: *Scan, dir: str, depth: i64) {
    if depth > 32 {
        return
    }
    let stamp = modified(dir) ?? return
    let real = real_path(dir)
    if s.seen[real] != none {
        return
    }
    s.seen[real] = true
    var folder = s.cached[dir] ?? Folder { path: dir, modified: -1, subdirs: [], faces: [] }
    if folder.modified != stamp {
        folder = scan_folder(dir, stamp)
        s.rescanned += 1
    }
    s.folders.push(folder)
    for sub in folder.subdirs {
        visit(s, sub, depth + 1)
    }
}

fn is_font_file(name: str) -> bool {
    let lower = strs.lower(name)
    strs.ends_with(lower, ".ttf") || strs.ends_with(lower, ".otf") || strs.ends_with(lower, ".ttc") || strs.ends_with(lower, ".otc")
}

fn scan_folder(dir: str, stamp: i64) -> Folder {
    var folder = Folder { path: dir, modified: stamp, subdirs: [], faces: [] }
    for name in sorted_names(dir) {
        let path = joined(dir, name)
        let kind = kind_of(path)
        if kind == Kind.Dir {
            folder.subdirs.push(path)
        } else if kind == Kind.File && is_font_file(name) {
            let data = read_file(path) ?? continue
            describe_file(mut folder.faces, path, "", data)
        }
    }
    folder
}

fn describe_file(mut faces: Face[], path: str, data: str, bytes: str) {
    for i in 0..font.face_count(bytes) {
        let d = font.describe(bytes, i) catch {
            e => continue
        }
        if !d.drawable || d.families.len == 0 {
            continue
        }
        add_faces(mut faces, path, data, i, d)
    }
}

fn slant_of(italic: bool, oblique: bool) -> i64 {
    if italic { 2 } else if oblique { 1 } else { 0 }
}

fn add_faces(mut faces: Face[], path: str, data: str, index: i64, d: font.Description) {
    let base = Face { path, index, instance: -1, families: d.families, style: d.style, weight: d.weight, width: d.width, slant: slant_of(d.italic, d.oblique), coverage: d.coverage, data }
    if d.instances.len == 0 {
        faces.push(base)
        return
    }
    for i, inst in d.instances {
        var face = base
        face.instance = i
        face.style = inst.name
        face.weight = inst.weight
        face.slant = slant_of(inst.italic, inst.oblique)
        faces.push(face)
    }
}

fn clean_field(s: str) -> str {
    var out: u8[] = []
    for b in bytes(s) {
        out.push(if b < 32 { u8(32) } else { b })
    }
    str(out)
}

fn coverage_text(runs: font.Range[]) -> str {
    var parts: str[] = []
    for r in runs {
        parts.push(if r.first == r.last { strs.hex(i64(r.first)) } else { "{strs.hex(i64(r.first))}-{strs.hex(i64(r.last))}" })
    }
    strs.join(parts, ",")
}

fn cache_text(folders: Folder[]) -> str {
    var lines: str[] = [cache_header]
    for f in folders {
        lines.push("D\t{clean_field(f.path)}\t{f.modified}")
        for sub in f.subdirs {
            lines.push("S\t{clean_field(sub)}")
        }
        for face in f.faces {
            let families = strs.join(slices.map(face.families, clean_field), "\x1f")
            lines.push("F\t{clean_field(face.path)}\t{face.index}\t{face.instance}\t{face.weight}\t{face.width}\t{face.slant}\t{families}\t{clean_field(face.style)}\t{coverage_text(face.coverage)}")
        }
    }
    lines.push("")
    strs.join(lines, "\n")
}

fn read_cache(path: str) -> [str: Folder] {
    var out: [str: Folder] = [:]
    let text = read_file(path) ?? return out
    let lines = strs.split(text, '\n')
    if lines.len == 0 || lines[0] != cache_header {
        return out
    }
    var current: Folder? = none
    for i in 1..lines.len {
        let fields = strs.split(lines[i], '\t')
        let tag = fields[0]
        if tag == "D" && fields.len == 3 {
            keep(mut out, current)
            current = Folder { path: fields[1], modified: number(fields[2]) ?? return [:], subdirs: [], faces: [] }
        } else if tag == "S" && fields.len == 2 {
            var f = current ?? return [:]
            f.subdirs.push(fields[1])
            current = f
        } else if tag == "F" && fields.len == 10 {
            var f = current ?? return [:]
            f.faces.push(cached_face(fields) ?? return [:])
            current = f
        } else if lines[i] != "" {
            return [:]
        }
    }
    keep(mut out, current)
    out
}

fn keep(mut out: [str: Folder], f: Folder?) {
    let folder = f ?? return
    out[folder.path] = folder
}

fn number(s: str) -> i64? {
    let v = strs.parse_int(s) catch {
        e => return none
    }
    v
}

fn cached_face(fields: str[]) -> Face? {
    let families = strs.split(fields[7], '\x1f')
    if fields[7] == "" {
        return none
    }
    Face {
        path: fields[1]
        index: number(fields[2]) ?? return none
        instance: number(fields[3]) ?? return none
        weight: number(fields[4]) ?? return none
        width: number(fields[5]) ?? return none
        slant: number(fields[6]) ?? return none
        families
        style: fields[8]
        coverage: parse_coverage(fields[9]) ?? return none
        data: ""
    }
}

fn parse_coverage(text: str) -> font.Range[]? {
    var runs: font.Range[] = []
    if text == "" {
        return runs
    }
    for part in strs.split(text, ',') {
        let cut = strs.cut(part, "-")
        let first = strs.parse_radix(cut.before, 16) catch {
            e => return none
        }
        var last = first
        if cut.found {
            last = strs.parse_radix(cut.after, 16) catch {
                e => return none
            }
        }
        runs.push(font.Range { first: u32(first), last: u32(last) })
    }
    runs
}
