import std/testing
import std/ui/font

fn family_index(specs: Spec[]) -> Index {
    var ix = empty()
    for s in specs {
        add(mut ix, fixture_font(s))
    }
    ix
}

fn chosen(ix: Index, family: str, weight: i64, slant: i64) -> str {
    let face = find(ix, family, weight, slant) ?? return "none"
    "{face.families[0]} {face.style}"
}

fn weights(list: i64[]) -> Spec[] {
    var out: Spec[] = []
    for w in list {
        out.push(Spec { family: "Ladder", style: "W{w}", weight: w })
    }
    out
}

fn test_weight_follows_the_css_order(t: *testing.T) {
    let ix = family_index(weights([100, 300, 400, 500, 600, 900]))
    t.equal(chosen(ix, "Ladder", 400, 0), "Ladder W400")
    t.equal(chosen(ix, "Ladder", 450, 0), "Ladder W500")
    t.equal(chosen(ix, "Ladder", 200, 0), "Ladder W100")
    t.equal(chosen(ix, "Ladder", 700, 0), "Ladder W900")
    let gap = family_index(weights([300, 600]))
    t.equal(chosen(gap, "Ladder", 400, 0), "Ladder W300")
    t.equal(chosen(gap, "Ladder", 500, 0), "Ladder W300")
    t.equal(chosen(gap, "Ladder", 550, 0), "Ladder W600")
    t.equal(chosen(gap, "Ladder", 350, 0), "Ladder W300")
    let heavy = family_index(weights([500, 800]))
    t.equal(chosen(heavy, "Ladder", 400, 0), "Ladder W500")
    t.equal(chosen(heavy, "Ladder", 300, 0), "Ladder W500")
}

fn test_slant_falls_back_as_css_says(t: *testing.T) {
    let all = family_index([
        Spec { family: "Slope", style: "Upright" }
        Spec { family: "Slope", style: "Oblique", selection: 512 }
        Spec { family: "Slope", style: "Italic", selection: 1 }
    ])
    t.equal(chosen(all, "Slope", 400, 0), "Slope Upright")
    t.equal(chosen(all, "Slope", 400, 1), "Slope Oblique")
    t.equal(chosen(all, "Slope", 400, 2), "Slope Italic")
    let no_italic = family_index([Spec { family: "Slope", style: "Upright" }, Spec { family: "Slope", style: "Oblique", selection: 512 }])
    t.equal(chosen(no_italic, "Slope", 400, 2), "Slope Oblique")
    let no_oblique = family_index([Spec { family: "Slope", style: "Upright" }, Spec { family: "Slope", style: "Italic", selection: 1 }])
    t.equal(chosen(no_oblique, "Slope", 400, 1), "Slope Italic")
    let slanted = family_index([Spec { family: "Slope", style: "Italic", selection: 1 }, Spec { family: "Slope", style: "Oblique", selection: 512 }])
    t.equal(chosen(slanted, "Slope", 400, 0), "Slope Oblique")
    let upright = family_index([Spec { family: "Slope", style: "Upright" }])
    t.equal(chosen(upright, "Slope", 400, 2), "Slope Upright")
}

fn test_slant_outranks_weight_and_width_outranks_both(t: *testing.T) {
    let ix = family_index([
        Spec { family: "Mix", style: "Bold", weight: 700 }
        Spec { family: "Mix", style: "Light Italic", weight: 300, selection: 1 }
        Spec { family: "Mix", style: "Condensed Italic", weight: 400, width: 3, selection: 1 }
    ])
    t.equal(chosen(ix, "Mix", 700, 2), "Mix Light Italic")
    t.equal(chosen(ix, "Mix", 400, 0), "Mix Bold")
    let widths = family_index([Spec { family: "Wide", style: "Expanded", width: 7 }, Spec { family: "Wide", style: "Condensed", width: 3 }, Spec { family: "Wide", style: "Semi", width: 4 }])
    t.equal(chosen(widths, "Wide", 400, 0), "Wide Semi")
}

fn test_family_names_match_without_case_or_spaces(t: *testing.T) {
    let ix = family_index([Spec { family: "Noto Sans SemiBold", typographic: "Noto Sans", style: "SemiBold", weight: 600 }])
    t.equal(chosen(ix, "noto sans", 600, 0), "Noto Sans SemiBold")
    t.equal(chosen(ix, "NotoSans", 600, 0), "Noto Sans SemiBold")
    t.equal(chosen(ix, "Noto Sans SemiBold", 400, 0), "Noto Sans SemiBold")
    t.equal(chosen(ix, "Noto", 400, 0), "none")
}

fn test_aliases_order_the_family_list(t: *testing.T) {
    var ix = empty()
    ix.config.aliases = [
        Alias { family: "sans-serif", prefer: ["First", "Second"], default: ["Last"] }
        Alias { family: "Second", accept: ["After Second"] }
        Alias { family: "Unrelated", prefer: ["Never"] }
        Alias { family: "First", accept: ["Sans-Serif"] }
    ]
    t.equal_slice(families(ix, "Sans-Serif"), ["First", "Sans-Serif", "Second", "After Second", "Last"])
    t.equal_slice(families(ix, "Plain"), ["Plain"])
}

fn test_find_takes_the_first_family_in_the_list_that_has_a_face(t: *testing.T) {
    var ix = family_index([Spec { family: "Second" }, Spec { family: "Last" }])
    ix.config.aliases = [Alias { family: "sans-serif", prefer: ["First", "Second"], default: ["Last"] }]
    t.equal(chosen(ix, "sans-serif", 400, 0), "Second Regular")
    t.equal(chosen(ix, "Last", 400, 0), "Last Regular")
}

fn test_fallback_picks_a_face_that_has_the_code_point(t: *testing.T) {
    var ix = family_index([
        Spec { family: "Body" }
        Spec { family: "Han Regular", code_points: [0x4e00, 0x4e01] }
        Spec { family: "Han Bold", style: "Bold", weight: 700, code_points: [0x4e00] }
        Spec { family: "Preferred Han", code_points: [0x4e00] }
        Spec { family: "Symbols", code_points: [0x2603] }
    ])
    ix.config.aliases = [Alias { family: "sans-serif", prefer: ["Preferred Han"] }]
    let han = fallback(ix, "Body", 400, 0, 0x4e00) ?? return t.error("no face for U+4E00")
    t.equal(han.families[0], "Preferred Han")
    let other = fallback(ix, "Body", 400, 0, 0x4e01) ?? return t.error("no face for U+4E01")
    t.equal(other.families[0], "Han Regular")
    let snow = fallback(ix, "Body", 400, 0, 0x2603) ?? return t.error("no face for U+2603")
    t.equal(snow.families[0], "Symbols")
    t.is_none(fallback(ix, "Body", 400, 0, 0x1f600))
}

fn test_add_skips_fonts_it_cannot_draw(t: *testing.T) {
    var ix = empty()
    t.equal(add(mut ix, bitmap_only_font("Pictures")), 0)
    t.equal(add(mut ix, "not a font"), 0)
    t.equal(add(mut ix, fixture_font(Spec { family: "Drawn" })), 1)
    t.equal(ix.added.len, 1)
}

fn test_collection_faces_keep_their_index(t: *testing.T) {
    var ix = empty()
    let pair = collection([fixture_font(Spec { family: "Pair One" }), fixture_font(Spec { family: "Pair Two", advance: 700 })])
    t.equal(add(mut ix, pair), 2)
    let second = find(ix, "Pair Two", 400, 0) ?? return t.error("no face for Pair Two")
    t.equal(second.index, 1)
    let f = read_face(second) or return t.error("Pair Two does not parse")
    t.equal(font.advance(f, 1), 700)
}

fn test_named_instances_become_faces(t: *testing.T) {
    var ix = empty()
    let varying = Spec {
        family: "Flex"
        axes: [AxisSpec { tag: "wght", minimum: 100, default: 400, maximum: 900 }, AxisSpec { tag: "ital", minimum: 0, default: 0, maximum: 1 }]
        instances: [
            InstanceSpec { name: "Regular", coordinates: [400, 0] }
            InstanceSpec { name: "Bold", coordinates: [700, 0] }
            InstanceSpec { name: "Bold Italic", coordinates: [700, 1] }
        ]
    }
    t.equal(add(mut ix, fixture_font(varying)), 3)
    let bold = find(ix, "Flex", 700, 0) ?? return t.error("no bold instance")
    t.equal(bold.style, "Bold")
    t.equal(bold.instance, 1)
    let italic = find(ix, "Flex", 700, 2) ?? return t.error("no bold italic instance")
    t.equal(italic.style, "Bold Italic")
    t.equal(italic.slant, 2)
}

fn test_describes_the_embedded_inter(t: *testing.T) {
    let d = font.describe(font.fallback_file(), 0) or return t.error("Inter does not describe")
    t.equal_slice(d.families, ["Inter Variable"])
    t.equal(d.style, "Regular")
    t.equal(d.weight, 400)
    t.is_true(d.drawable)
    t.is_true(font.covers(d.coverage, 'A'))
    t.is_false(font.covers(d.coverage, 0x4e00))
}
