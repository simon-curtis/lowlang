import std/file
import std/os
import paths = std/path
import std/slices
import strs = std/text

/// Returns the environment of this process: `FONTCONFIG_FILE`, or `fonts.conf` in `FONTCONFIG_PATH` or `/etc/fonts`, as the configuration file, `HOME`, and `XDG_CONFIG_HOME`, `XDG_DATA_HOME`, `XDG_DATA_DIRS` and `XDG_CACHE_HOME` or their defaults under the home directory and `/usr/local/share:/usr/share`. Returns `none` on a target with no fontconfig directories, which is every target but Linux.
pub fn environment() -> Environment? {
    let home = os.home_dir() ?? ""
    let config_dir = variable("FONTCONFIG_PATH") ?? "/etc/fonts"
    let named = variable("FONTCONFIG_FILE") ?? "fonts.conf"
    Environment {
        config_file: if named[0] == '/' { named } else { "{config_dir}/{named}" }
        home
        config_home: os.config_dir() ?? ""
        data_home: os.data_dir() ?? ""
        data_dirs: strs.split(variable("XDG_DATA_DIRS") ?? "/usr/local/share:/usr/share", ':')
        cache_home: os.cache_dir() ?? ""
        working_dir: os.getcwd() or ""
    }
}

fn variable(name: str) -> str? {
    let v = os.env(name) ?? return none
    if v == "" { none } else { v }
}

fn kind_of(path: str) -> Kind {
    let info = file.stat(path) catch {
        e => return Kind.Missing
    }
    if info.dir { Kind.Dir } else if info.regular { Kind.File } else { Kind.Missing }
}

fn modified(path: str) -> i64? {
    let info = file.stat(path) catch {
        e => return none
    }
    if info.dir { info.modified } else { none }
}

fn real_path(path: str) -> str {
    file.realpath(path) or path
}

fn sorted_names(dir: str) -> str[] {
    var names = file.list(dir) or []
    slices.sort(mut names)
    names
}

fn read_file(path: str) -> str? {
    let text = file.read_text(path) catch {
        e => return none
    }
    text
}

fn write_cache(path: str, text: str) {
    if path == "" {
        return
    }
    let dir = paths.dir(path)
    file.mkdir_all(dir) catch {
        e => return
    }
    let temp = "{path}.{os.pid()}"
    file.write_text(temp, text) catch {
        e => return
    }
    file.rename(temp, path) catch {
        e => {
            file.remove(temp) or {}
        }
    }
}
