import strs = std/text
import std/ui/font

/// An installed face: one font of a file, or one named instance of a variable font.
pub struct Face {
    /// The file that holds the face, or empty for a face added from memory with `add`.
    pub path: str
    /// The font's index in its file, 0 unless the file is a collection.
    pub index: i64
    /// The named instance of a variable font, counted from 0 in `fvar` order, or -1 for a font that does not vary.
    pub instance: i64
    /// The family names the face answers to, as `font.Description.families` gives them.
    pub families: str[]
    /// The style name, such as `Bold Italic`.
    pub style: str
    /// The weight, `400` for regular and `700` for bold.
    pub weight: i64
    /// The width class, `5` for normal.
    pub width: i64
    /// How the face slants, numbered as `text.FontStyle` is: `0` upright, `1` oblique and `2` italic.
    pub slant: i64
    /// The code points the face draws.
    pub coverage: font.Range[]
    data: str
}

/// The installed faces, found through the fontconfig configuration, and the faces added from memory.
pub struct Index {
    /// The configuration the faces were found through.
    pub config: Config = Config {}
    /// The installed faces: the font directories in configuration order, each followed by its subdirectories, and the files of a directory in byte order of their names.
    pub faces: Face[] = []
    added: Face[] = []
    by_family: [str: i64[]] = [:]
}

/// Returns an index with no installed faces, to which `add` adds faces from memory.
pub fn empty() -> Index {
    Index {}
}

/// Reads the configuration that starts at `env.config_file` (see `read_config`) and returns the faces in its directories and their subdirectories.
///
/// Every file whose name ends in `.ttf`, `.otf`, `.ttc` or `.otc`, in any case, is read, and each font in it that `font.describe` reads, that has a family name and that is `drawable` becomes a face, or one face per named instance for a variable font. Symbolic links are followed, and a directory reached twice is read once.
///
/// The faces are cached in `low/fontconfig.cache` under `env.cache_home`, one record per directory with its modification time in seconds, its subdirectories and its faces. A directory whose time matches its record is not read again, so a font file replaced in place without changing its directory's time keeps its old record. The cache is written again when a directory was read or the set of directories changed. An unreadable or malformed cache is ignored, and a failure to write it is not reported.
pub fn open(env: Environment) -> Index {
    let config = read_config(env)
    let scan = gather(env, config.dirs)
    var faces: Face[] = []
    for folder in scan.folders {
        for face in folder.faces {
            faces.push(face)
        }
    }
    Index { config, faces, added: [], by_family: family_table(faces) }
}

fn family_key(family: str) -> str {
    strs.replace(strs.lower(family), " ", "")
}

fn family_table(faces: Face[]) -> [str: i64[]] {
    var table: [str: i64[]] = [:]
    for i, face in faces {
        for name in face.families {
            let key = family_key(name)
            var list = table[key] ?? []
            if list.len == 0 || list[list.len - 1] != i {
                list.push(i)
            }
            table[key] = list
        }
    }
    table
}

/// Adds the fonts in the file `data` to `ix` as faces that `find` and `fallback` try before the installed ones, and returns how many it added: the `drawable` fonts with a family name, or one face per named instance of a variable font.
pub fn add(mut ix: Index, data: str) -> i64 {
    let before = ix.added.len
    describe_file(mut ix.added, "", data, data)
    ix.added.len - before
}

/// Returns the families to try for `family`, in order: `family` itself, then the configuration's aliases applied in the order they were read.
///
/// An alias applies when the list already holds its family: its `prefer` families go just before that family, its `accept` families just after it and its `default` families at the end. Families compare without regard to ASCII case or spaces, and each appears once, where it first appears.
pub fn families(ix: Index, family: str) -> str[] {
    var list: str[] = [family]
    for a in ix.config.aliases {
        let at = position(list, a.family) ?? continue
        var next: str[] = []
        for i in 0..at {
            next.push(list[i])
        }
        add_all(mut next, a.prefer)
        next.push(list[at])
        add_all(mut next, a.accept)
        for i in at + 1..list.len {
            next.push(list[i])
        }
        add_all(mut next, a.default)
        list = unique(next)
    }
    list
}

fn add_all(mut list: str[], names: str[]) {
    for n in names {
        list.push(n)
    }
}

fn position(list: str[], family: str) -> i64? {
    let key = family_key(family)
    for i, name in list {
        if family_key(name) == key {
            return i
        }
    }
    none
}

fn unique(list: str[]) -> str[] {
    var out: str[] = []
    for name in list {
        if position(out, name) == none {
            out.push(name)
        }
    }
    out
}

/// Returns the face that draws `family` at `weight` and `slant`, or `none` when no face has any family `families(ix, family)` lists.
///
/// The families are tried in order, the added faces before the installed ones for each. Among the faces of the first family that has any, the choice follows the CSS font matching algorithm: the normal width, else the nearest narrower, else the nearest wider; then the slant asked for, an italic falling back to oblique and then upright, an oblique to italic and then upright, and upright to oblique and then italic; then the weight as CSS orders it, so `400` tries up to `500` before lighter weights, a weight under `400` tries lighter ones first and one over `500` heavier ones first. A tie goes to the face found first.
pub fn find(ix: Index, family: str, weight: i64, slant: i64) -> Face? {
    for name in families(ix, family) {
        let best = best_of(ix, name, weight, slant, none) ?? continue
        return best
    }
    none
}

/// Returns the face to draw `code_point` with when the face chosen for `family` does not have it, or `none` when no face has it.
///
/// It is the face `find` would choose among the faces that have the code point, trying the families of `family` and then those of `sans-serif`, and then, when none of those has it, the family of the first face that has it, added faces first.
pub fn fallback(ix: Index, family: str, weight: i64, slant: i64, code_point: u32) -> Face? {
    var names = families(ix, family)
    add_all(mut names, families(ix, "sans-serif"))
    for name in unique(names) {
        let best = best_of(ix, name, weight, slant, code_point) ?? continue
        return best
    }
    for face in ix.added {
        if font.covers(face.coverage, code_point) {
            return best_of(ix, face.families[0], weight, slant, code_point)
        }
    }
    for face in ix.faces {
        if font.covers(face.coverage, code_point) {
            return best_of(ix, face.families[0], weight, slant, code_point)
        }
    }
    none
}

fn best_of(ix: Index, family: str, weight: i64, slant: i64, code_point: u32?) -> Face? {
    let key = family_key(family)
    var best: Face? = none
    var best_rank = 0
    for face in ix.added {
        if has_family(face, key) {
            consider(face, weight, slant, code_point, mut best, mut best_rank)
        }
    }
    if best != none {
        return best
    }
    for i in ix.by_family[key] ?? [] {
        consider(ix.faces[i], weight, slant, code_point, mut best, mut best_rank)
    }
    best
}

fn has_family(face: Face, key: str) -> bool {
    for name in face.families {
        if family_key(name) == key {
            return true
        }
    }
    false
}

fn consider(face: Face, weight: i64, slant: i64, code_point: u32?, mut best: Face?, mut best_rank: i64) {
    match code_point {
        some(c) => {
            if !font.covers(face.coverage, c) {
                return
            }
        }
        none => {}
    }
    let rank = width_rank(face.width) * 100000000 + slant_rank(slant, face.slant) * 10000 + weight_rank(weight, face.weight)
    if best == none || rank < best_rank {
        best = face
        best_rank = rank
    }
}

fn width_rank(width: i64) -> i64 {
    if width == 5 { 0 } else if width < 5 { 5 - width } else { width }
}

fn slant_rank(wanted: i64, slant: i64) -> i64 {
    if wanted == slant {
        0
    } else if wanted == 0 {
        slant
    } else if slant == 0 {
        2
    } else {
        1
    }
}

fn weight_rank(wanted: i64, weight: i64) -> i64 {
    if wanted >= 400 && wanted <= 500 {
        if weight >= wanted && weight <= 500 {
            weight - wanted
        } else if weight < wanted {
            1000 + wanted - weight
        } else {
            2000 + weight
        }
    } else if wanted < 400 {
        if weight <= wanted { wanted - weight } else { 1000 + weight }
    } else if weight >= wanted {
        weight - wanted
    } else {
        1000 + wanted - weight
    }
}

/// Reads `face` from its file, or from the memory it was added from, as `font.parse_face` reads it.
///
/// A named instance is read as its font's default instance, the outlines and metrics the file stores. Fails with `Malformed("header")` when the file cannot be read.
pub fn read_face(face: Face) -> font.Font ! font.Error {
    let data = if face.path == "" { face.data } else { read_file(face.path) ?? fail font.Error.Malformed("header") }
    font.parse_face(data, face.index)?
}
