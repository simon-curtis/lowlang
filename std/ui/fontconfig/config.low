import paths = std/path
import std/slices
import strs = std/text
import std/xml

const max_includes = 64

/// Where `open` looks: the configuration file and the directories the XDG Base Directory specification names, as absolute paths.
pub struct Environment {
    /// The configuration file read first.
    pub config_file: str = ""
    /// The user's home directory, which a leading `~` in a configured path stands for.
    pub home: str = ""
    /// The directory a configured path with `prefix="xdg"` in an `<include>` is relative to: `XDG_CONFIG_HOME`.
    pub config_home: str = ""
    /// The directory a configured path with `prefix="xdg"` in a `<dir>` is relative to: `XDG_DATA_HOME`. Its `fonts` directory is scanned as well.
    pub data_home: str = ""
    /// The shared data directories: `XDG_DATA_DIRS`. The `fonts` directory of each is scanned as well.
    pub data_dirs: str[] = []
    /// The directory the index is cached in: `XDG_CACHE_HOME`, or empty for no cache.
    pub cache_home: str = ""
    /// The directory a relative `<dir>` is relative to.
    pub working_dir: str = ""
}

/// A fontconfig `<alias>`: the families tried before, after and at the end of the list for one family.
pub struct Alias {
    /// The family the alias applies to.
    pub family: str
    /// The families tried before `family`.
    pub prefer: str[] = []
    /// The families tried just after `family`.
    pub accept: str[] = []
    /// The families tried after every other family in the list.
    pub default: str[] = []
}

/// What the fontconfig configuration files say: the font directories and the aliases, in the order they were read.
pub struct Config {
    files: str[] = []
    /// The font directories, each once, in the order they were first named.
    pub dirs: str[] = []
    /// The aliases in the order they were read.
    pub aliases: Alias[] = []
}

struct Reading {
    env: Environment
    config: Config
}

/// Reads the configuration that starts at `env.config_file`, following its `<include>` elements, and adds the `fonts` directories of `env.data_home` and of each of `env.data_dirs`.
///
/// Only `<dir>`, `<include>` and `<alias>` are read; `<match>`, `<selectfont>`, `<cachedir>` and the rest are skipped. A path that starts with `~` is under `env.home`. A `<dir>` with `prefix="xdg"` is under `env.data_home`, and any other relative one under `env.working_dir`, or under the including file's directory for `prefix="relative"`. An `<include>` with `prefix="xdg"` is under `env.config_home`, and any other relative one under the including file's directory. An included directory contributes its files whose names start with an ASCII digit and end in `.conf`, in sorted order. A file that is missing or is not XML is skipped, a file is read once however often it is included, and includes nest at most 64 deep.
pub fn read_config(env: Environment) -> Config {
    let r = new(Reading { env, config: Config {} })
    include_path(r, env.config_file, 0)
    add_dir(r, joined(env.data_home, "fonts"))
    for d in env.data_dirs {
        add_dir(r, joined(d, "fonts"))
    }
    r.config
}

fn joined(dir: str, name: str) -> str {
    if dir == "" { "" } else { paths.join([dir, name]) }
}

fn add_dir(r: *Reading, dir: str) {
    if dir != "" && !slices.contains(r.config.dirs, dir) {
        r.config.dirs.push(dir)
    }
}

fn include_path(r: *Reading, path: str, depth: i64) {
    if path == "" || depth > max_includes {
        return
    }
    let kind = kind_of(path)
    if kind == Kind.Dir {
        for name in sorted_names(path) {
            if name.len > 5 && name[0] >= '0' && name[0] <= '9' && strs.ends_with(name, ".conf") {
                include_file(r, paths.join([path, name]), depth)
            }
        }
    } else if kind == Kind.File {
        include_file(r, path, depth)
    }
}

fn include_file(r: *Reading, path: str, depth: i64) {
    if slices.contains(r.config.files, path) {
        return
    }
    let text = read_file(path) ?? return
    let root = xml.parse(bytes(text)) catch {
        e => return
    }
    r.config.files.push(path)
    let here = paths.dir(path)
    for e in xml.children(root, "*") {
        read_element(r, e, here, depth)
    }
}

fn read_element(r: *Reading, e: *xml.Element, here: str, depth: i64) {
    let name = e.name.local
    if name == "dir" {
        let prefix = xml.attribute(e, "prefix") ?? "default"
        let base = if prefix == "xdg" { r.env.data_home } else if prefix == "relative" { here } else { r.env.working_dir }
        add_dir(r, resolve(r.env, base, strs.trim(xml.text(e))))
    } else if name == "include" {
        let prefix = xml.attribute(e, "prefix") ?? "default"
        let base = if prefix == "xdg" { r.env.config_home } else { here }
        include_path(r, resolve(r.env, base, strs.trim(xml.text(e))), depth + 1)
    } else if name == "alias" {
        read_alias(r, e)
    }
}

fn resolve(env: Environment, base: str, p: str) -> str {
    if p == "" {
        return ""
    }
    if p == "~" || strs.starts_with(p, "~/") {
        return if env.home == "" { "" } else { paths.clean("{env.home}{p[1..]}") }
    }
    if paths.is_absolute(p) {
        return paths.clean(p)
    }
    if base == "" {
        return ""
    }
    paths.join([base, p])
}

fn family_names(e: *xml.Element?) -> str[] {
    var out: str[] = []
    let list = e ?? return out
    for f in xml.children(list, "family") {
        let n = strs.trim(xml.text(f))
        if n != "" {
            out.push(n)
        }
    }
    out
}

fn read_alias(r: *Reading, e: *xml.Element) {
    let first = xml.child(e, "family") ?? return
    let family = strs.trim(xml.text(first))
    if family == "" {
        return
    }
    r.config.aliases.push(Alias {
        family
        prefer: family_names(xml.child(e, "prefer"))
        accept: family_names(xml.child(e, "accept"))
        default: family_names(xml.child(e, "default"))
    })
}
