import std/io

struct Spec {
    family: str
    typographic: str = ""
    style: str = "Regular"
    weight: i64 = 400
    width: i64 = 5
    selection: i64 = 64
    advance: i64 = 500
    code_points: u32[] = []
    axes: AxisSpec[] = []
    instances: InstanceSpec[] = []
}

struct AxisSpec {
    tag: str
    minimum: i64
    default: i64
    maximum: i64
}

struct InstanceSpec {
    name: str
    coordinates: i64[]
}

struct Part {
    tag: str
    data: u8[]
}

fn latin() -> u32[] {
    var out: u32[] = []
    for c in 0x20..0x7f {
        out.push(u32(c))
    }
    out
}

fn put_all(mut out: u8[], more: u8[]) {
    for b in more {
        out.push(b)
    }
}

fn zeros(n: i64) -> u8[] {
    var out: u8[] = []
    for _ in 0..n {
        out.push(0)
    }
    out
}

fn assemble(parts: Part[]) -> u8[] {
    var out: u8[] = []
    io.put_be32(mut out, 65536)
    io.put_be16(mut out, parts.len)
    put_all(mut out, zeros(6))
    var offset = 12 + 16 * parts.len
    for p in parts {
        for i in 0..4 {
            out.push(p.tag[i])
        }
        io.put_be32(mut out, 0)
        io.put_be32(mut out, offset)
        io.put_be32(mut out, p.data.len)
        offset += (p.data.len + 3) / 4 * 4
    }
    for p in parts {
        put_all(mut out, p.data)
        put_all(mut out, zeros((4 - p.data.len % 4) % 4))
    }
    out
}

fn head_table() -> u8[] {
    var b = zeros(54)
    io.set_be16(b, 18, 1000)
    b
}

fn hhea_table() -> u8[] {
    var b = zeros(36)
    io.set_be16(b, 4, 800)
    io.set_be16(b, 6, 65536 - 200)
    io.set_be16(b, 34, 2)
    b
}

fn maxp_table() -> u8[] {
    var b: u8[] = []
    io.put_be32(mut b, 0x5000)
    io.put_be16(mut b, 2)
    b
}

fn hmtx_table(advance: i64) -> u8[] {
    var b: u8[] = []
    io.put_be16(mut b, 0)
    io.put_be16(mut b, 0)
    io.put_be16(mut b, advance)
    io.put_be16(mut b, 0)
    b
}

fn square() -> u8[] {
    var b: u8[] = []
    for v in [1, 0, 0, 400, 600, 3, 0] {
        io.put_be16(mut b, v)
    }
    for _ in 0..4 {
        b.push(1)
    }
    for v in [0, 400, 0, 65536 - 400, 0, 0, 600, 0] {
        io.put_be16(mut b, v)
    }
    b
}

fn glyf_table() -> u8[] {
    square()
}

fn loca_table() -> u8[] {
    var b: u8[] = []
    io.put_be16(mut b, 0)
    io.put_be16(mut b, 0)
    io.put_be16(mut b, square().len / 2)
    b
}

fn cmap_table(code_points: u32[]) -> u8[] {
    var b: u8[] = []
    io.put_be16(mut b, 0)
    io.put_be16(mut b, 1)
    io.put_be16(mut b, 3)
    io.put_be16(mut b, 10)
    io.put_be32(mut b, 12)
    io.put_be16(mut b, 12)
    io.put_be16(mut b, 0)
    io.put_be32(mut b, 16 + 12 * code_points.len)
    io.put_be32(mut b, 0)
    io.put_be32(mut b, code_points.len)
    for c in code_points {
        io.put_be32(mut b, i64(c))
        io.put_be32(mut b, i64(c))
        io.put_be32(mut b, 1)
    }
    b
}

fn os2_table(s: Spec) -> u8[] {
    var b = zeros(86)
    io.set_be16(b, 0, 1)
    io.set_be16(b, 4, s.weight)
    io.set_be16(b, 6, s.width)
    io.set_be16(b, 62, s.selection)
    b
}

fn name_table(names: [i64: str]) -> u8[] {
    var strings: u8[] = []
    var records: u8[] = []
    for id, text in names {
        io.put_be16(mut records, 3)
        io.put_be16(mut records, 1)
        io.put_be16(mut records, 0x409)
        io.put_be16(mut records, id)
        io.put_be16(mut records, 2 * text.len)
        io.put_be16(mut records, strings.len)
        for i in 0..text.len {
            io.put_be16(mut strings, i64(text[i]))
        }
    }
    var b: u8[] = []
    io.put_be16(mut b, 0)
    io.put_be16(mut b, names.len)
    io.put_be16(mut b, 6 + records.len)
    put_all(mut b, records)
    put_all(mut b, strings)
    b
}

fn fvar_table(s: Spec) -> u8[] {
    var b: u8[] = []
    for v in [1, 0, 16, 2, s.axes.len, 20, s.instances.len, 4 + 4 * s.axes.len] {
        io.put_be16(mut b, v)
    }
    for a in s.axes {
        for i in 0..4 {
            b.push(a.tag[i])
        }
        io.put_be32(mut b, a.minimum << 16)
        io.put_be32(mut b, a.default << 16)
        io.put_be32(mut b, a.maximum << 16)
        io.put_be16(mut b, 0)
        io.put_be16(mut b, 0)
    }
    for i, inst in s.instances {
        io.put_be16(mut b, 256 + i)
        io.put_be16(mut b, 0)
        for c in inst.coordinates {
            io.put_be32(mut b, c << 16)
        }
    }
    b
}

fn fixture_font(s: Spec) -> str {
    var names: [i64: str] = [1: s.family, 2: s.style]
    if s.typographic != "" {
        names[16] = s.typographic
    }
    for i, inst in s.instances {
        names[256 + i] = inst.name
    }
    let code_points = if s.code_points.len == 0 { latin() } else { s.code_points }
    var parts = [
        Part { tag: "OS/2", data: os2_table(s) }
        Part { tag: "cmap", data: cmap_table(code_points) }
        Part { tag: "glyf", data: glyf_table() }
        Part { tag: "head", data: head_table() }
        Part { tag: "hhea", data: hhea_table() }
        Part { tag: "hmtx", data: hmtx_table(s.advance) }
        Part { tag: "loca", data: loca_table() }
        Part { tag: "maxp", data: maxp_table() }
        Part { tag: "name", data: name_table(names) }
    ]
    if s.axes.len > 0 {
        parts.push(Part { tag: "fvar", data: fvar_table(s) })
    }
    str(assemble(parts))
}

fn bitmap_only_font(family: str) -> str {
    str(assemble([
        Part { tag: "cmap", data: cmap_table(latin()) }
        Part { tag: "head", data: head_table() }
        Part { tag: "name", data: name_table([1: family, 2: "Regular"]) }
    ]))
}

fn collection(fonts: str[]) -> str {
    var out: u8[] = []
    for i in 0..4 {
        out.push("ttcf"[i])
    }
    io.put_be32(mut out, 65536)
    io.put_be32(mut out, fonts.len)
    var at = 12 + 4 * fonts.len
    for f in fonts {
        io.put_be32(mut out, at)
        at += f.len
    }
    for f in fonts {
        var moved = bytes(f)
        for i in 0..io.be16(moved, 4) {
            let record = 12 + 16 * i
            io.set_be32(moved, record + 8, io.be32(moved, record + 8) + out.len)
        }
        put_all(mut out, moved)
    }
    str(out)
}
