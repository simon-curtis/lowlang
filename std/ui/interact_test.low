import std/testing
import std/ui/platform
import std/ui/scene

fn shot(cx: Context, view: fn() -> Element) -> scene.Scene {
    frame(cx, view, window(), 1.0)
}

fn move_to(cx: Context, x: f32, y: f32) {
    dispatch(cx, platform.Event.PointerMoved(x, y))
}

fn press(cx: Context, x: f32, y: f32) {
    dispatch(cx, platform.Event.PointerDown(platform.Button.Left, x, y))
}

fn release(cx: Context, x: f32, y: f32) {
    dispatch(cx, platform.Event.PointerUp(platform.Button.Left, x, y))
}

fn click(cx: Context, x: f32, y: f32) {
    press(cx, x, y)
    release(cx, x, y)
}

fn key_event(k: platform.Key) -> platform.Event {
    platform.Event.Key(platform.KeyEvent { key: k })
}

fn named(n: platform.NamedKey) -> platform.Event {
    key_event(platform.Key.Named(n))
}

fn tab(shift: bool) -> platform.Event {
    platform.Event.Key(platform.KeyEvent {
        key: platform.Key.Named(platform.NamedKey.Tab)
        modifiers: platform.Modifiers { shift: shift }
    })
}

fn count_up(n: Signal[i64]) -> fn() {
    fn() { set(n, get(n) + 1) }
}

fn test_hover_restyles_and_requests_a_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(50.0, 50.0).background(rgb(0x0000ff)).hover(fn(v: Visual) -> Visual { v.with_background(rgb(0xff0000)) })
    }
    let before = shot(cx, view)
    testing.equal(t, before.quads[0].background.b, 1.0)
    testing.is_false(t, frame_due(cx))

    move_to(cx, 10.0, 10.0)
    testing.is_true(t, frame_due(cx))
    let over = shot(cx, view)
    testing.equal(t, over.quads[0].background.r, 1.0)

    move_to(cx, 20.0, 20.0)
    testing.is_false(t, frame_due(cx))

    move_to(cx, 80.0, 80.0)
    testing.is_true(t, frame_due(cx))
    let away = shot(cx, view)
    testing.equal(t, away.quads[0].background.b, 1.0)

    move_to(cx, 10.0, 10.0)
    shot(cx, view)
    dispatch(cx, platform.Event.PointerLeft)
    testing.is_true(t, frame_due(cx))
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)
}

fn test_click_runs_the_handler_when_press_and_release_land_on_the_element(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = fn() -> Element { div().size(50.0, 50.0).on_click(count_up(clicks)) }
    shot(cx, view)
    click(cx, 10.0, 10.0)
    testing.equal(t, get(clicks), 1)
    click(cx, 80.0, 80.0)
    testing.equal(t, get(clicks), 1)
    press(cx, 10.0, 10.0)
    release(cx, 80.0, 80.0)
    testing.equal(t, get(clicks), 1)
    press(cx, 80.0, 80.0)
    release(cx, 10.0, 10.0)
    testing.equal(t, get(clicks), 1)
    dispatch(cx, platform.Event.PointerDown(platform.Button.Right, 10.0, 10.0))
    dispatch(cx, platform.Event.PointerUp(platform.Button.Right, 10.0, 10.0))
    testing.equal(t, get(clicks), 1)
}

fn test_the_innermost_click_handler_takes_the_click(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let outer = signal(cx, 0)
    let inner = signal(cx, 0)
    let view = fn() -> Element {
        div().size(100.0, 100.0).on_click(count_up(outer)).child(div().size(40.0, 40.0).on_click(count_up(inner)))
    }
    shot(cx, view)
    click(cx, 10.0, 10.0)
    testing.equal(t, get(inner), 1)
    testing.equal(t, get(outer), 0)
    click(cx, 60.0, 60.0)
    testing.equal(t, get(inner), 1)
    testing.equal(t, get(outer), 1)
}

fn test_a_click_reaches_a_handler_behind_a_plain_child(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = fn() -> Element {
        div().size(100.0, 100.0).on_click(count_up(clicks)).child(div().size(40.0, 40.0).background(rgb(0xff0000)))
    }
    shot(cx, view)
    click(cx, 10.0, 10.0)
    testing.equal(t, get(clicks), 1)
}

fn test_active_styles_the_element_while_the_button_is_down(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(50.0, 50.0).background(rgb(0x0000ff)).active(fn(v: Visual) -> Visual { v.with_background(rgb(0x00ff00)) })
    }
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    press(cx, 10.0, 10.0)
    testing.equal(t, shot(cx, view).quads[0].background.g, 1.0)
    release(cx, 10.0, 10.0)
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)
}

fn test_a_click_focuses_a_focusable_element_and_a_click_elsewhere_blurs(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().row().gap(10.0).children() {
            div().id("a").size(40.0, 40.0).focusable(),
            div().id("b").size(40.0, 40.0),
        }
    }
    shot(cx, view)
    click(cx, 10.0, 10.0)
    testing.equal(t, focused(cx), "a")
    click(cx, 70.0, 10.0)
    testing.equal(t, focused(cx), "")
    click(cx, 10.0, 10.0)
    click(cx, 150.0, 90.0)
    testing.equal(t, focused(cx), "")
}

fn test_a_click_on_a_child_focuses_the_focusable_ancestor(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("outer").size(100.0, 100.0).focusable().child(div().size(20.0, 20.0).background(rgb(0xff0000)))
    }
    shot(cx, view)
    click(cx, 5.0, 5.0)
    testing.equal(t, focused(cx), "outer")
}

fn test_focus_styles_the_element(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().id("a").size(40.0, 40.0).background(rgb(0x0000ff)).focusable().focus(fn(v: Visual) -> Visual { v.with_background(rgb(0xffff00)) })
    }
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)
    click(cx, 10.0, 10.0)
    testing.is_true(t, frame_due(cx))
    testing.equal(t, shot(cx, view).quads[0].background.r, 1.0)
    blur(cx)
    testing.equal(t, shot(cx, view).quads[0].background.b, 1.0)
}

fn test_tab_cycles_focus_in_tree_order_and_shift_tab_reverses(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().column().children() {
            div().id("a").size(10.0, 10.0).focusable(),
            div().size(10.0, 10.0),
            div().id("b").size(10.0, 10.0).focusable(),
            div().size(10.0, 10.0).child(div().id("c").size(10.0, 10.0).focusable()),
        }
    }
    shot(cx, view)
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "a")
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "b")
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "c")
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "a")
    dispatch(cx, tab(true))
    testing.equal(t, focused(cx), "c")
    dispatch(cx, tab(true))
    testing.equal(t, focused(cx), "b")
    blur(cx)
    dispatch(cx, tab(true))
    testing.equal(t, focused(cx), "c")
}

fn test_keys_go_to_the_focused_element_and_bubble_until_one_returns_true(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let inner = signal(cx, 0)
    let middle = signal(cx, 0)
    let outer = signal(cx, 0)
    let view = fn() -> Element {
        div().size(100.0, 100.0).on_key(fn(k: platform.KeyEvent) -> bool {
            set(outer, get(outer) + 1)
            true
        }).child(div().id("m").size(80.0, 80.0).on_key(fn(k: platform.KeyEvent) -> bool {
            set(middle, get(middle) + 1)
            false
        }).child(div().id("i").size(40.0, 40.0).focusable().on_key(fn(k: platform.KeyEvent) -> bool {
            set(inner, get(inner) + 1)
            false
        })))
    }
    shot(cx, view)
    dispatch(cx, key_event(platform.Key.Character("x")))
    testing.equal(t, get(inner) + get(middle) + get(outer), 0)
    set_focus(cx, "i")
    dispatch(cx, key_event(platform.Key.Character("x")))
    testing.equal(t, get(inner), 1)
    testing.equal(t, get(middle), 1)
    testing.equal(t, get(outer), 1)
}

fn test_a_handler_that_returns_true_stops_the_key_and_keeps_tab(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let outer = signal(cx, 0)
    let view = fn() -> Element {
        div().size(100.0, 100.0).on_key(fn(k: platform.KeyEvent) -> bool {
            set(outer, get(outer) + 1)
            true
        }).children() {
            div().id("a").size(10.0, 10.0).focusable().on_key(fn(k: platform.KeyEvent) -> bool { true }),
            div().id("b").size(10.0, 10.0).focusable(),
        }
    }
    shot(cx, view)
    set_focus(cx, "a")
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "a")
    testing.equal(t, get(outer), 0)
    set_focus(cx, "b")
    dispatch(cx, tab(false))
    testing.equal(t, get(outer), 1)
    testing.equal(t, focused(cx), "b")
}

fn test_enter_and_space_click_the_focused_element(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let view = fn() -> Element { div().id("button").size(40.0, 40.0).focusable().on_click(count_up(clicks)) }
    shot(cx, view)
    dispatch(cx, named(platform.NamedKey.Enter))
    testing.equal(t, get(clicks), 0)
    set_focus(cx, "button")
    dispatch(cx, named(platform.NamedKey.Enter))
    dispatch(cx, key_event(platform.Key.Character(" ")))
    testing.equal(t, get(clicks), 2)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Enter), pressed: false }))
    testing.equal(t, get(clicks), 2)
}

fn test_focus_follows_an_id_when_the_element_moves(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let swapped = signal(cx, false)
    let view = fn() -> Element {
        let first = div().id("first").size(20.0, 20.0).focusable()
        let second = div().id("second").size(20.0, 20.0).focusable()
        if get(swapped) {
            div().children() { second, first }
        } else {
            div().children() { first, second }
        }
    }
    shot(cx, view)
    set_focus(cx, "second")
    set(swapped, true)
    shot(cx, view)
    testing.equal(t, focused(cx), "second")
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "first")
}

fn test_events_without_a_frame_do_nothing(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    click(cx, 10.0, 10.0)
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "")
}
