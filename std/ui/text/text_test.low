import std/testing
import std/ui/geometry
import std/ui/layout
import std/ui/scene

fn bar() -> str {
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"12\" x2=\"20\" y2=\"12\"/></svg>"
}

fn icon_scene() -> scene.Scene {
    scene.empty(200, 100, geometry.rgb(0x000000))
}

fn test_an_icon_is_one_sprite_on_whole_device_pixels(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    paint_icon(mut sys, mut sc, bar(), geometry.rect(10.2, 10.2, 15.6, 15.6), geometry.rgb(0xffffff), 1.0)
    testing.equal(t, sc.sprites.len, 1)
    testing.equal(t, sc.sprites[0].bounds, geometry.rect(10.0, 10.0, 16.0, 16.0))
}

fn test_an_icon_is_rasterised_at_twice_its_device_size(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    paint_icon(mut sys, mut sc, bar(), geometry.rect(0.0, 0.0, 8.0, 8.0), geometry.rgb(0xffffff), 2.0)
    testing.equal(t, sc.sprites.len, 1)
    testing.equal(t, sc.sprites[0].bounds, geometry.rect(0.0, 0.0, 16.0, 16.0))
    let size = f32(sys.atlases[0].size)
    testing.equal(t, sc.sprites[0].tile.width * size, 32.0)
    testing.equal(t, sc.sprites[0].tile.height * size, 32.0)
}

fn test_an_icon_is_centred_on_its_snapped_bounds(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    paint_icon(mut sys, mut sc, bar(), geometry.rect(20.5, 60.25, 20.0, 20.0), geometry.rgb(0xffffff), 1.0)
    testing.equal(t, sc.sprites[0].bounds, geometry.rect(20.0, 60.0, 20.0, 20.0))
}

fn test_an_icon_is_rasterised_once_per_size(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    paint_icon(mut sys, mut sc, bar(), geometry.rect(0.0, 0.0, 16.0, 16.0), geometry.rgb(0xffffff), 1.0)
    paint_icon(mut sys, mut sc, bar(), geometry.rect(40.0, 40.0, 16.0, 16.0), geometry.rgb(0xff0000), 1.0)
    paint_icon(mut sys, mut sc, bar(), geometry.rect(80.0, 40.0, 24.0, 24.0), geometry.rgb(0xffffff), 1.0)
    testing.equal(t, sc.sprites.len, 3)
    testing.equal(t, sc.sprites[0].tile, sc.sprites[1].tile)
    testing.is_true(t, sc.sprites[0].tile != sc.sprites[2].tile)
}

fn test_a_document_that_does_not_parse_draws_nothing(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    paint_icon(mut sys, mut sc, "<svg", geometry.rect(0.0, 0.0, 16.0, 16.0), geometry.rgb(0xffffff), 1.0)
    testing.equal(t, sc.sprites.len, 0)
}

fn test_an_icon_under_one_device_pixel_draws_nothing(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    paint_icon(mut sys, mut sc, bar(), geometry.rect(0.0, 0.0, 0.4, 16.0), geometry.rgb(0xffffff), 1.0)
    testing.equal(t, sc.sprites.len, 0)
}

fn test_the_icon_coverage_lands_in_the_atlas(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    paint_icon(mut sys, mut sc, bar(), geometry.rect(0.0, 0.0, 16.0, 16.0), geometry.rgb(0xffffff), 1.0)
    let size = f32(sys.atlases[0].size)
    let tile = sc.sprites[0].tile
    let x = i64(tile.x * size) + 16
    let y = i64(tile.y * size) + 16
    testing.equal(t, sys.atlases[0].pixels[(y * sys.atlases[0].size + x) * 4], 255)
    testing.equal(t, sys.atlases[0].pixels[((y - 12) * sys.atlases[0].size + x) * 4], 0)
}

fn test_built_in_fonts_need_no_blend_correction(t: *testing.T) {
    let p = params(default_system())
    testing.equal(t, p.gamma_0, 0.0)
    testing.equal(t, p.gamma_3, 0.0)
    testing.equal(t, p.grayscale_contrast, 0.0)
    testing.equal(t, p.subpixel_contrast, 0.0)
    testing.equal(t, p.bgr, 0)
}

fn test_built_in_fonts_ignore_family_and_weight(t: *testing.T) {
    var sys = default_system()
    let plain = wrap(mut sys, "Hello world", Style { size: 16.0 }, layout.unbounded)
    let named = wrap(mut sys, "Hello world", Style { size: 16.0, family: "No Such Family", weight: 700 }, layout.unbounded)
    testing.equal(t, named.width, plain.width)
    testing.equal(t, named.lines.len, plain.lines.len)
    testing.is_false(t, named.native)
}

fn test_layouts_in_different_styles_are_kept_apart(t: *testing.T) {
    var sys = default_system()
    wrap(mut sys, "Hello", Style { size: 16.0 }, layout.unbounded)
    wrap(mut sys, "Hello", Style { size: 16.0, weight: 700 }, layout.unbounded)
    wrap(mut sys, "Hello", Style { size: 16.0, line_height: 20.0 }, layout.unbounded)
    let italic = wrap(mut sys, "Hello", Style { size: 16.0, font_style: FontStyle.Italic }, layout.unbounded)
    testing.equal(t, cached(sys), 4)
    testing.equal(t, italic.font_style, FontStyle.Italic)
}

fn ink_width(mut sys: System, style: FontStyle) -> f32 {
    var sc = icon_scene()
    let l = wrap(mut sys, "l", Style { size: 32.0, font_style: style }, layout.unbounded)
    paint(mut sys, mut sc, l, geometry.point(10.0, 10.0), geometry.rgb(0xffffff), 1.0)
    sc.sprites[0].bounds.width
}

fn test_built_in_italic_and_oblique_shear_the_upright_glyph_and_keep_its_advance(t: *testing.T) {
    var sys = default_system()
    let upright = ink_width(mut sys, FontStyle.Normal)
    testing.is_true(t, ink_width(mut sys, FontStyle.Italic) > upright + 4.0)
    testing.is_true(t, ink_width(mut sys, FontStyle.Oblique) > upright + 4.0)
    let plain = wrap(mut sys, "Hello", Style { size: 16.0 }, layout.unbounded)
    let slanted = wrap(mut sys, "Hello", Style { size: 16.0, font_style: FontStyle.Italic }, layout.unbounded)
    testing.equal(t, slanted.width, plain.width)
}

fn solid(width: i64, height: i64) -> u8[] {
    var out: u8[] = []
    for i in 0..width * height {
        out.push(200)
        out.push(100)
        out.push(50)
        out.push(255)
    }
    out
}

fn picture(mut sys: System, width: i64, height: i64) -> Image {
    add_image(mut sys, width, height, solid(width, height)) ?? Image { id: -1, width: 0, height: 0 }
}

fn test_a_picture_whose_bytes_do_not_match_its_size_is_refused(t: *testing.T) {
    var sys = default_system()
    testing.is_true(t, add_image(mut sys, 2, 2, [1, 2, 3]) == none)
    testing.is_true(t, add_image(mut sys, 0, 2, []) == none)
    testing.is_true(t, add_image(mut sys, 2, 2, solid(2, 2)) != none)
}

fn test_fit_fill_is_the_box(t: *testing.T) {
    let box = geometry.rect(10.0, 20.0, 200.0, 100.0)
    testing.equal(t, fit_bounds(Fit.Fill, box, 50.0, 50.0), box)
}

fn test_fit_contain_keeps_proportions_inside_the_box_and_centres(t: *testing.T) {
    let box = geometry.rect(0.0, 0.0, 200.0, 200.0)
    testing.equal(t, fit_bounds(Fit.Contain, box, 100.0, 50.0), geometry.rect(0.0, 50.0, 200.0, 100.0))
    testing.equal(t, fit_bounds(Fit.Contain, box, 50.0, 100.0), geometry.rect(50.0, 0.0, 100.0, 200.0))
}

fn test_fit_cover_keeps_proportions_around_the_box_and_centres(t: *testing.T) {
    let box = geometry.rect(0.0, 0.0, 200.0, 200.0)
    testing.equal(t, fit_bounds(Fit.Cover, box, 100.0, 50.0), geometry.rect(-100.0, 0.0, 400.0, 200.0))
}

fn test_fit_scale_down_never_enlarges(t: *testing.T) {
    let box = geometry.rect(0.0, 0.0, 200.0, 200.0)
    testing.equal(t, fit_bounds(Fit.ScaleDown, box, 100.0, 50.0), geometry.rect(50.0, 75.0, 100.0, 50.0))
    testing.equal(t, fit_bounds(Fit.ScaleDown, box, 400.0, 200.0), geometry.rect(0.0, 50.0, 200.0, 100.0))
}

fn test_fit_original_starts_at_the_top_left(t: *testing.T) {
    let box = geometry.rect(5.0, 6.0, 200.0, 200.0)
    testing.equal(t, fit_bounds(Fit.Original, box, 100.0, 50.0), geometry.rect(5.0, 6.0, 100.0, 50.0))
}

fn test_a_picture_is_one_polychrome_sprite_on_snapped_bounds(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    let image = picture(mut sys, 8, 4)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(10.2, 10.2, 15.6, 7.7), geometry.Corners {}, false, 1.0, 1.0)
    testing.equal(t, sc.polychrome_sprites.len, 1)
    testing.equal(t, sc.polychrome_sprites[0].bounds, geometry.rect(10.0, 10.0, 16.0, 8.0))
    let size = f32(sys.atlases[0].size)
    testing.equal(t, sc.polychrome_sprites[0].tile.width * size, 8.0)
    testing.equal(t, sc.polychrome_sprites[0].tile.height * size, 4.0)
}

fn test_a_picture_is_packed_into_the_atlas_once_with_its_own_colours(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    let image = picture(mut sys, 2, 2)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(0.0, 0.0, 10.0, 10.0), geometry.Corners {}, false, 1.0, 1.0)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(20.0, 0.0, 10.0, 10.0), geometry.Corners {}, false, 1.0, 1.0)
    testing.equal(t, sc.polychrome_sprites.len, 2)
    testing.equal(t, sc.polychrome_sprites[0].tile, sc.polychrome_sprites[1].tile)
    let size = sys.atlases[0].size
    let x = i64(sc.polychrome_sprites[0].tile.x * f32(size) + 0.5)
    let y = i64(sc.polychrome_sprites[0].tile.y * f32(size) + 0.5)
    let at = (y * size + x) * 4
    testing.equal(t, sys.atlases[0].pixels[at], 200)
    testing.equal(t, sys.atlases[0].pixels[at + 1], 100)
    testing.equal(t, sys.atlases[0].pixels[at + 2], 50)
    testing.equal(t, sys.atlases[0].pixels[at + 3], 255)
}

fn test_a_packed_picture_is_bordered_by_its_own_edge_pixels(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    let image = picture(mut sys, 3, 2)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(0.0, 0.0, 30.0, 20.0), geometry.Corners {}, false, 1.0, 1.0)
    let size = sys.atlases[0].size
    let x = i64(sc.polychrome_sprites[0].tile.x * f32(size) + 0.5)
    let y = i64(sc.polychrome_sprites[0].tile.y * f32(size) + 0.5)
    for at in [((y - 1) * size + x - 1) * 4, ((y + 2) * size + x + 3) * 4, (y * size + x + 3) * 4] {
        testing.equal(t, sys.atlases[0].pixels[at], 200)
        testing.equal(t, sys.atlases[0].pixels[at + 3], 255)
    }
}

fn test_a_cover_fit_samples_only_the_part_inside_the_box(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    let image = picture(mut sys, 40, 20)
    paint_image(mut sys, mut sc, image, Fit.Cover, geometry.rect(0.0, 0.0, 100.0, 100.0), geometry.Corners {}, false, 1.0, 1.0)
    testing.equal(t, sc.polychrome_sprites[0].bounds, geometry.rect(0.0, 0.0, 100.0, 100.0))
    let size = f32(sys.atlases[0].size)
    testing.equal(t, sc.polychrome_sprites[0].tile.width * size, 20.0)
    testing.equal(t, sc.polychrome_sprites[0].tile.height * size, 20.0)
}

fn test_corner_radii_are_limited_to_half_the_visible_side_then_scaled(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    let image = picture(mut sys, 10, 10)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(0.0, 0.0, 20.0, 10.0), geometry.corners(40.0), false, 1.0, 2.0)
    testing.equal(t, sc.polychrome_sprites[0].corner_radii.top_left, 10.0)
    testing.equal(t, sc.polychrome_sprites[0].corner_radii.bottom_right, 10.0)
}

fn test_grayscale_and_opacity_reach_the_sprite(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    let image = picture(mut sys, 4, 4)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(0.0, 0.0, 8.0, 8.0), geometry.Corners {}, true, 0.5, 1.0)
    testing.equal(t, sc.polychrome_sprites[0].grayscale, 1.0)
    testing.equal(t, sc.polychrome_sprites[0].opacity, 0.5)
}

fn test_a_picture_with_no_visible_area_draws_nothing(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    let image = picture(mut sys, 4, 4)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(0.0, 0.0, 0.0, 8.0), geometry.Corners {}, false, 1.0, 1.0)
    testing.equal(t, sc.polychrome_sprites.len, 0)
}

fn glyph_scene() -> scene.Scene {
    scene.empty(400, 100, geometry.rgb(0x000000))
}

fn paint_word(mut sys: System, mut sc: scene.Scene, word: str, x: f32) {
    paint(mut sys, mut sc, wrap(mut sys, word, Style { size: 16.0 }, layout.unbounded), geometry.point(x, 0.0), geometry.rgb(0xffffff), 1.0)
}

fn textures_of(sc: scene.Scene) -> str {
    var out = ""
    for run in scene.batches(scene.grouped(sc)) {
        out = "{out}{run.texture}"
    }
    out
}

fn test_a_picture_larger_than_the_atlas_limit_is_left_out_and_the_glyphs_after_it_are_kept(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    let image = picture(mut sys, 4095, 1)
    end_frame(mut sys)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(0.0, 0.0, 100.0, 10.0), geometry.Corners {}, false, 1.0, 1.0)
    paint_word(mut sys, mut sc, "Hello", 0.0)
    testing.equal(t, sys.atlases.len, 1)
    testing.equal(t, sys.atlases[0].size, 1024)
    testing.equal(t, sc.polychrome_sprites.len, 0)
    testing.equal(t, sc.sprites.len, 5)
    testing.is_false(t, atlas_grows(sys))
    testing.is_false(t, sys.full)
}

fn test_no_atlas_is_larger_than_the_limit(t: *testing.T) {
    var sys = default_system()
    var sc = icon_scene()
    let image = picture(mut sys, 4094, 1)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(0.0, 0.0, 100.0, 10.0), geometry.Corners {}, false, 1.0, 1.0)
    end_frame(mut sys)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(0.0, 0.0, 100.0, 10.0), geometry.Corners {}, false, 1.0, 1.0)
    for a in sys.atlases {
        testing.is_true(t, a.size <= 4096)
    }
    testing.equal(t, sys.atlases[0].size, 4096)
}

fn test_a_system_with_one_atlas_leaves_an_oversized_picture_out_without_dropping_the_glyphs_after_it(t: *testing.T) {
    var sys = system_with_atlas([], 64)
    var sc = icon_scene()
    let image = picture(mut sys, 100, 1)
    paint_image(mut sys, mut sc, image, Fit.Fill, geometry.rect(0.0, 0.0, 100.0, 10.0), geometry.Corners {}, false, 1.0, 1.0)
    paint_word(mut sys, mut sc, "A", 0.0)
    testing.equal(t, sc.polychrome_sprites.len, 0)
    testing.equal(t, sc.sprites.len, 1)
    testing.equal(t, sys.atlases.len, 1)
}

fn test_a_full_atlas_at_the_limit_gains_an_atlas_and_the_glyphs_drawn_before_it_stay_drawn(t: *testing.T) {
    var sys = sized_system([], 32, 32, 3)
    var sc = glyph_scene()
    paint_word(mut sys, mut sc, "A", 0.0)
    let first = sc.sprites[0].tile
    paint_word(mut sys, mut sc, "VabcAV", 100.0)
    testing.equal(t, sys.atlases.len, 2)
    testing.equal(t, sys.atlases[1].size, 32)
    testing.equal(t, sc.sprites.len, 7)
    testing.is_false(t, sys.full)
    var again = glyph_scene()
    paint_word(mut sys, mut again, "A", 0.0)
    testing.equal(t, again.sprites[0].tile, first)
    testing.equal(t, textures_of(again), "0")
}

fn test_sprites_over_two_atlases_form_one_batch_for_each(t: *testing.T) {
    var sys = sized_system([], 32, 32, 3)
    var sc = glyph_scene()
    paint_word(mut sys, mut sc, "AVabc", 0.0)
    paint_word(mut sys, mut sc, "A", 200.0)
    testing.equal(t, sys.atlases.len, 2)
    testing.equal(t, textures_of(sc), "01")
    testing.equal(t, sc.sprites.len, 6)
}

fn test_a_glyph_keeps_the_atlas_it_was_packed_in_across_frames(t: *testing.T) {
    var sys = sized_system([], 32, 32, 3)
    var sc = glyph_scene()
    paint_word(mut sys, mut sc, "AVabc", 0.0)
    end_frame(mut sys)
    testing.equal(t, sys.atlases.len, 2)
    var next = glyph_scene()
    paint_word(mut sys, mut next, "AVabc", 0.0)
    testing.equal(t, next.sprites.len, 5)
    testing.equal(t, textures_of(next), "01")
}

fn test_at_the_atlas_limit_the_first_atlas_is_cleared_and_the_rest_dropped(t: *testing.T) {
    var sys = sized_system([], 32, 32, 2)
    var sc = glyph_scene()
    paint_word(mut sys, mut sc, "AVabcdefgh", 0.0)
    testing.equal(t, sys.atlases.len, 2)
    testing.is_true(t, sys.full)
    testing.is_true(t, sc.sprites.len < 10)
    testing.is_false(t, atlas_grows(sys))
    end_frame(mut sys)
    testing.equal(t, sys.atlases.len, 1)
    testing.is_false(t, sys.full)
    testing.equal(t, sys.atlases[0].pixels[(1 * 32 + 1) * 4], 0)
    var next = glyph_scene()
    paint_word(mut sys, mut next, "AV", 0.0)
    testing.equal(t, next.sprites.len, 2)
}

fn test_a_system_with_one_atlas_never_adds_one(t: *testing.T) {
    var sys = system_with_atlas([], 32)
    var sc = glyph_scene()
    paint_word(mut sys, mut sc, "AVabc", 0.0)
    testing.equal(t, sys.atlases.len, 1)
    testing.equal(t, sc.sprites.len, 3)
    testing.equal(t, textures_of(sc), "0")
}

fn test_an_atlas_below_the_limit_grows_instead_of_gaining_an_atlas(t: *testing.T) {
    var sys = sized_system([], 32, 128, 3)
    var sc = glyph_scene()
    paint_word(mut sys, mut sc, "AVabc", 0.0)
    testing.equal(t, sys.atlases.len, 1)
    testing.is_true(t, atlas_grows(sys))
    end_frame(mut sys)
    testing.equal(t, sys.atlases.len, 1)
    testing.equal(t, sys.atlases[0].size, 64)
}
