import std/ui/geometry
import std/ui/scene

/// A picture a `System` holds, drawn with `paint_image`.
pub struct Image {
    /// The key of the picture in its system.
    pub id: i64
    /// The width in pixels.
    pub width: i64
    /// The height in pixels.
    pub height: i64
}

/// How a picture sits in the box it is drawn in.
pub enum Fit {
    /// The picture is stretched to the box.
    Fill
    /// The picture is scaled, keeping its proportions, until it fits inside the box, and centred.
    Contain
    /// The picture is scaled, keeping its proportions, until it covers the box, and centred.
    Cover
    /// The picture is scaled down like `Contain` when it is larger than the box in either direction, and otherwise drawn at its own size, centred.
    ScaleDown
    /// The picture is drawn at its own size from the top left of the box.
    Original
}

struct Picture {
    width: i64
    height: i64
    pixels: u8[]
}

struct ImageTile {
    x: i64
    y: i64
    width: i64
    height: i64
}

/// Keeps `rgba`, `width` by `height` pixels of red, green, blue and alpha bytes in rows with straight alpha, not premultiplied, in `sys`, and returns the picture, or `none` when `rgba` is not `width * height * 4` bytes or either size is below one.
///
/// A picture is packed into the atlas the first time `paint_image` draws it, with a one-pixel border. A picture larger than the atlas makes the next `end_frame` grow the atlas to hold it, up to the system's limit.
pub fn add_image(mut sys: System, width: i64, height: i64, rgba: u8[]) -> Image? {
    if width < 1 || height < 1 || rgba.len != width * height * 4 {
        return none
    }
    let side = most(width, height) + 2
    if side <= sys.limit {
        sys.wanted = most(sys.wanted, side)
    }
    let id = sys.next_image
    sys.next_image += 1
    sys.images[id] = Picture { width, height, pixels: rgba }
    Image { id, width, height }
}

/// Returns where a picture of `width` by `height` pixels lies when drawn in `bounds` with `fit`, in the unit of `bounds`.
pub fn fit_bounds(fit: Fit, bounds: geometry.Rect, width: f32, height: f32) -> geometry.Rect {
    let image_ratio = width / height
    let bounds_ratio = bounds.width / bounds.height
    match fit {
        Fill => bounds
        Contain => centred(bounds, contained(bounds, width, height, image_ratio, bounds_ratio))
        ScaleDown => {
            if width > bounds.width || height > bounds.height {
                return centred(bounds, contained(bounds, width, height, image_ratio, bounds_ratio))
            }
            centred(bounds, geometry.size(width, height))
        }
        Cover => {
            let covering = if bounds_ratio > image_ratio {
                geometry.size(bounds.width, height * (bounds.width / width))
            } else {
                geometry.size(width * (bounds.height / height), bounds.height)
            }
            centred(bounds, covering)
        }
        Original => geometry.rect(bounds.x, bounds.y, width, height)
    }
}

fn contained(bounds: geometry.Rect, width: f32, height: f32, image_ratio: f32, bounds_ratio: f32) -> geometry.Size {
    if bounds_ratio > image_ratio {
        return geometry.size(width * (bounds.height / height), bounds.height)
    }
    geometry.size(bounds.width, height * (bounds.width / width))
}

fn centred(bounds: geometry.Rect, s: geometry.Size) -> geometry.Rect {
    geometry.rect(bounds.x + (bounds.width - s.width) / 2.0, bounds.y + (bounds.height - s.height) / 2.0, s.width, s.height)
}

/// Pushes one polychrome sprite onto `sc` that draws `image` fitted into `bounds`, a rectangle in logical pixels, with everything multiplied by `scale`.
///
/// The visible part is the overlap of `bounds` with the fitted picture. Its edges are snapped to device pixels, and the sprite samples the part of the picture it covers, cut to whole picture pixels, with linear filtering. `corners`, in logical pixels, round the visible part and are limited to half its shorter side. `grayscale` replaces each colour with its luminance, and `opacity` multiplies the alpha. A picture wider or taller than the system's atlas limit, less its one-pixel border, is left out on its own. One larger than the atlas is left out on its own until `end_frame` grows the atlas to hold it, and one that does not fit in the room left is left out, and so is every glyph, icon and picture packed after it, until `end_frame` grows or clears the atlas.
pub fn paint_image(mut sys: System, mut sc: scene.Scene, image: Image, fit: Fit, bounds: geometry.Rect, corners: geometry.Corners, grayscale: bool, opacity: f32, scale: f32) {
    let placed = fit_bounds(fit, bounds, f32(image.width), f32(image.height))
    let visible = geometry.intersect(bounds, placed)
    if visible.width <= 0.0 || visible.height <= 0.0 || placed.width <= 0.0 || placed.height <= 0.0 {
        return
    }
    let tile = image_tile(mut sys, image) ?? return
    let snapped = geometry.snap(visible, scale)
    let part = visible_tile(tile, visible, placed)
    let radii = geometry.clamp_corners(corners, visible.width, visible.height)
    let uv = scene.tile(sys.atlas, part.x, part.y, part.width, part.height)
    let sprite = scene.PolychromeSprite {
        bounds: snapped
        tile: uv
        corner_radii: geometry.scale_corners(radii, scale)
        grayscale: if grayscale { 1.0 } else { 0.0 }
        opacity
    }
    scene.push_polychrome_sprite(mut sc, sprite)
}

fn nearest(v: f32) -> i64 {
    i64(floor(v + 0.5))
}

fn visible_tile(tile: ImageTile, visible: geometry.Rect, placed: geometry.Rect) -> ImageTile {
    if visible.x == placed.x && visible.y == placed.y && visible.width == placed.width && visible.height == placed.height {
        return tile
    }
    let x_ratio = (visible.x - placed.x) / placed.width
    let y_ratio = (visible.y - placed.y) / placed.height
    let width_ratio = visible.width / placed.width
    let height_ratio = visible.height / placed.height
    let across = f32(tile.width)
    let down = f32(tile.height)
    let max_x = tile.x + tile.width
    let max_y = tile.y + tile.height
    let origin_x = clamped(tile.x + nearest(x_ratio * across), tile.x, max_x)
    let origin_y = clamped(tile.y + nearest(y_ratio * down), tile.y, max_y)
    let width = most(least(nearest(width_ratio * across), max_x - origin_x), 0)
    let height = most(least(nearest(height_ratio * down), max_y - origin_y), 0)
    ImageTile { x: origin_x, y: origin_y, width, height }
}

fn clamped(v: i64, low: i64, high: i64) -> i64 {
    if v < low { low } else if v > high { high } else { v }
}

fn least(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn most(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn image_tile(mut sys: System, image: Image) -> ImageTile? {
    match sys.image_tiles[image.id] {
        some(known) => return known
        none => {}
    }
    if sys.full {
        return none
    }
    let picture = sys.images[image.id] ?? return none
    let spot = reserve(mut sys, picture.width + 2, picture.height + 2) ?? return none
    scene.write_colors(mut sys.atlas, spot.x + 1, spot.y + 1, picture.width, picture.height, picture.pixels)
    scene.extend_edges(mut sys.atlas, spot.x + 1, spot.y + 1, picture.width, picture.height)
    let tile = ImageTile { x: spot.x + 1, y: spot.y + 1, width: picture.width, height: picture.height }
    sys.image_tiles[image.id] = tile
    tile
}
