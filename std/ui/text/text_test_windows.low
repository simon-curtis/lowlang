import std/testing
import std/ui/geometry
import std/ui/layout
import std/ui/scene

fn native_system(t: *testing.T, subpixel: bool) -> System {
    var sys = default_system()
    testing.require(t, use_system_fonts(mut sys, subpixel))
    sys
}

fn segoe(size: f32) -> Style {
    Style { size, family: "Segoe UI" }
}

fn test_the_system_fonts_switch_the_blend_correction_on(t: *testing.T) {
    let sys = native_system(t, true)
    let p = params(sys)
    testing.is_true(t, p.gamma_0 != 0.0 || p.gamma_1 != 0.0)
    testing.is_true(t, p.grayscale_contrast > 0.0)
}

fn test_a_native_layout_is_marked_and_has_one_glyph_per_letter(t: *testing.T) {
    var sys = native_system(t, true)
    let l = wrap(mut sys, "ABC", segoe(13.0), layout.unbounded)
    testing.is_true(t, l.native)
    testing.equal(t, l.lines.len, 1)
    testing.equal(t, l.lines[0].glyphs.len, 3)
    testing.equal(t, l.lines[0].glyphs[0].x, 0.0)
    testing.is_true(t, l.lines[0].glyphs[2].x > l.lines[0].glyphs[1].x)
    testing.is_true(t, l.lines[0].width > l.lines[0].glyphs[2].x)
}

fn test_baselines_are_one_line_height_apart_and_the_text_is_centred_in_each(t: *testing.T) {
    var sys = native_system(t, true)
    let natural = wrap(mut sys, "A\nA", segoe(13.0), layout.unbounded)
    let tall = wrap(mut sys, "A\nA", Style { size: 13.0, family: "Segoe UI", line_height: 30.0 }, layout.unbounded)
    testing.equal(t, tall.lines[1].y - tall.lines[0].y, 30.0)
    testing.equal(t, tall.height, 60.0)
    let pitch = natural.lines[1].y - natural.lines[0].y
    testing.equal(t, natural.height, pitch * 2.0)
    let extra = tall.lines[0].y - natural.lines[0].y
    testing.close_to(t, f64(extra), f64((30.0 - pitch) / 2.0), 0.001)
}

fn test_a_line_breaks_after_a_space_and_the_space_hangs(t: *testing.T) {
    var sys = native_system(t, true)
    let one = wrap(mut sys, "AAAA", segoe(13.0), layout.unbounded)
    let width = one.width * 1.5
    let l = wrap(mut sys, "AAAA AAAA", segoe(13.0), width)
    testing.equal(t, l.lines.len, 2)
    testing.equal(t, l.lines[0].glyphs.len, 5)
    testing.is_true(t, l.lines[0].end > l.lines[0].width)
    testing.is_true(t, l.lines[0].width <= width)
}

fn test_a_word_wider_than_the_width_breaks_between_glyphs(t: *testing.T) {
    var sys = native_system(t, true)
    let one = wrap(mut sys, "AAAAAAAA", segoe(13.0), layout.unbounded)
    let l = wrap(mut sys, "AAAAAAAA", segoe(13.0), one.width / 2.0)
    testing.is_true(t, l.lines.len > 1)
    testing.is_true(t, l.width <= one.width / 2.0)
}

fn test_text_that_may_not_wrap_stays_on_one_line_at_any_width(t: *testing.T) {
    var sys = native_system(t, true)
    let one = wrap(mut sys, "AAAA AAAA AAAA", segoe(13.0), layout.unbounded)
    let kept = wrap(mut sys, "AAAA AAAA AAAA", Style { size: 13.0, family: "Segoe UI", wrap: false }, one.width / 3.0)
    testing.equal(t, kept.lines.len, 1)
    testing.equal(t, kept.width, one.width)
}

fn test_text_that_fits_is_not_truncated(t: *testing.T) {
    var sys = native_system(t, true)
    let one = wrap(mut sys, "Hello", segoe(13.0), layout.unbounded)
    let style = Style { size: 13.0, family: "Segoe UI", wrap: false, truncate: Truncate.End }
    let l = wrap(mut sys, "Hello", style, one.width + 1.0)
    testing.equal(t, l.lines[0].glyphs.len, 5)
    testing.equal(t, l.width, one.width)
}

fn test_text_that_does_not_fit_ends_in_an_ellipsis_within_the_width(t: *testing.T) {
    var sys = native_system(t, true)
    let text = "A long sentence that does not fit in the box"
    let one = wrap(mut sys, text, segoe(13.0), layout.unbounded)
    let style = Style { size: 13.0, family: "Segoe UI", wrap: false, truncate: Truncate.End }
    let l = wrap(mut sys, text, style, 120.0)
    testing.equal(t, l.lines.len, 1)
    testing.is_true(t, l.lines[0].glyphs.len < one.lines[0].glyphs.len)
    testing.is_true(t, l.width <= 120.0)
    let start = wrap(mut sys, text, Style { size: 13.0, family: "Segoe UI", wrap: false, truncate: Truncate.Start }, 120.0)
    testing.is_true(t, start.width <= 120.0)
    let middle = wrap(mut sys, text, Style { size: 13.0, family: "Segoe UI", wrap: false, truncate: Truncate.Middle }, 120.0)
    testing.is_true(t, middle.width <= 120.0)
    testing.is_true(t, middle.lines[0].glyphs.len < one.lines[0].glyphs.len)
}

fn aligned(mut sys: System, align: TextAlign) -> scene.Scene {
    var sc = scene.empty(300, 100, geometry.rgb(0x000000))
    let l = wrap(mut sys, "AAAA", Style { size: 13.0, family: "Segoe UI", align }, 200.0)
    paint(mut sys, mut sc, l, geometry.point(20.0, 30.0), geometry.rgb(0xffffff), 1.0)
    sc
}

fn test_text_is_centred_and_right_aligned_in_its_width(t: *testing.T) {
    var sys = native_system(t, true)
    let one = wrap(mut sys, "AAAA", segoe(13.0), layout.unbounded)
    let left = aligned(mut sys, TextAlign.Left)
    let centre = aligned(mut sys, TextAlign.Center)
    let right = aligned(mut sys, TextAlign.Right)
    let spare = 200.0 - one.width
    testing.close_to(t, f64(centre.subpixel_sprites[0].bounds.x - left.subpixel_sprites[0].bounds.x), f64(spare / 2.0), 1.0)
    testing.close_to(t, f64(right.subpixel_sprites[0].bounds.x - left.subpixel_sprites[0].bounds.x), f64(spare), 1.0)
}

fn test_an_unknown_family_is_drawn_in_the_default_family(t: *testing.T) {
    var sys = native_system(t, true)
    let named = wrap(mut sys, "Hello", Style { size: 13.0, family: "No Such Family Anywhere" }, layout.unbounded)
    let plain = wrap(mut sys, "Hello", segoe(13.0), layout.unbounded)
    testing.is_true(t, named.native)
    testing.equal(t, named.width, plain.width)
}

fn test_an_empty_text_is_one_empty_line(t: *testing.T) {
    var sys = native_system(t, true)
    let l = wrap(mut sys, "", segoe(13.0), layout.unbounded)
    testing.equal(t, l.lines.len, 1)
    testing.equal(t, l.lines[0].glyphs.len, 0)
    testing.is_true(t, l.height > 0.0)
}

fn painted(mut sys: System, x: f32, y: f32) -> scene.Scene {
    var sc = scene.empty(200, 100, geometry.rgb(0x000000))
    let l = wrap(mut sys, "Ag", segoe(13.0), layout.unbounded)
    paint(mut sys, mut sc, l, geometry.point(x, y), geometry.rgb(0xffffff), 1.0)
    sc
}

fn test_glyphs_are_pushed_as_subpixel_sprites_on_whole_device_pixels(t: *testing.T) {
    var sys = native_system(t, true)
    let sc = painted(mut sys, 20.5, 30.25)
    testing.equal(t, sc.sprites.len, 0)
    testing.equal(t, sc.subpixel_sprites.len, 2)
    for s in sc.subpixel_sprites {
        testing.equal(t, s.bounds.x, floor(s.bounds.x))
        testing.equal(t, s.bounds.y, floor(s.bounds.y))
    }
}

fn test_glyphs_are_pushed_as_grey_sprites_when_subpixel_is_off(t: *testing.T) {
    var sys = native_system(t, false)
    let sc = painted(mut sys, 20.0, 30.0)
    testing.equal(t, sc.subpixel_sprites.len, 0)
    testing.equal(t, sc.sprites.len, 2)
}

fn test_a_quarter_pixel_origin_shares_no_tile_with_a_whole_pixel_origin(t: *testing.T) {
    var sys = native_system(t, true)
    let whole = painted(mut sys, 20.0, 30.0)
    let quarter = painted(mut sys, 20.5, 30.0)
    testing.is_true(t, whole.subpixel_sprites[0].tile.x != quarter.subpixel_sprites[0].tile.x || whole.subpixel_sprites[0].tile.y != quarter.subpixel_sprites[0].tile.y)
}

fn test_the_same_origin_reuses_the_packed_glyphs(t: *testing.T) {
    var sys = native_system(t, true)
    let first = painted(mut sys, 20.0, 30.0)
    let second = painted(mut sys, 20.0, 30.0)
    testing.equal(t, first.subpixel_sprites[0].tile.x, second.subpixel_sprites[0].tile.x)
    testing.equal(t, first.subpixel_sprites[1].tile.y, second.subpixel_sprites[1].tile.y)
}
