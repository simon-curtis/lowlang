import strs = std/text
import std/ui/dwrite
import std/ui/font
import std/ui/geometry
import std/ui/scene
import std/ui/svg

const atlas_size = 1024
const icon_supersample: f32 = 2.0

/// A glyph placed on a line.
pub struct Placed {
    /// The index of the font that draws the glyph: in `System`'s fonts, or in the system's installed faces when the layout is `native`.
    pub font: i64
    /// The glyph in that font.
    pub glyph: i64
    /// The pen position of the glyph from the left edge of its line, in layout pixels.
    pub x: f32
}

/// One line of a layout.
pub struct Line {
    /// The glyphs in order, spaces included.
    pub glyphs: Placed[]
    /// The distance from the top of the layout to the line's baseline, in layout pixels.
    pub y: f32
    /// The distance from the left edge to the end of the last glyph that is not a space, in layout pixels.
    pub width: f32
    /// The distance from the left edge to the pen after the last glyph, spaces included, in layout pixels: where the next glyph would go.
    pub end: f32
}

/// Text broken into lines at one size, in layout pixels.
pub struct Layout {
    /// The lines from the top.
    pub lines: Line[]
    /// The em size in pixels the text was laid out at.
    pub size: f32
    /// The width of the widest line.
    pub width: f32
    /// The height of all lines: the line height times the line count.
    pub height: f32
    /// Whether the glyphs belong to the system's installed fonts, so `paint` rasterises them with the system's text renderer.
    pub native: bool
}

/// How a run of text is drawn.
pub struct Style {
    /// The em size in logical pixels.
    pub size: f32 = 16.0
    /// The installed font family to draw with, or empty for the system's default family. A system that draws with its built-in fonts ignores it.
    pub family: str = ""
    /// The weight of the face: `400` is regular and `700` bold. The installed face nearest the weight draws the text.
    pub weight: i64 = 400
    /// The distance between baselines in logical pixels, or `0` for the face's ascent plus its descent.
    pub line_height: f32 = 0.0
}

struct Tile {
    visible: bool
    stripes: bool
    left: f32
    top: f32
    width: f32
    height: f32
    uv: geometry.Rect
}

struct Shelf {
    y: i64
    height: i64
    next: i64
}

struct Spot {
    x: i64
    y: i64
}

struct Shaped {
    font: i64
    glyph: i64
}

struct Native {
    fonts: *dwrite.Fonts
    rendering: dwrite.Rendering
    subpixel: bool
    spaces: [i64: i64]
    shaped: [str: dwrite.Line]
}

struct Piece {
    glyph: Placed
    space: bool
    end: f32
}

struct Origin {
    whole: i64
    variant: i64
}

/// The fonts, the glyph atlas and the caches that text drawing keeps between calls.
pub struct System {
    fonts: font.Font[]
    /// The atlas the sprites that `paint` pushes sample, for the renderer to upload.
    pub atlas: scene.Atlas
    shelves: Shelf[]
    next_shelf: i64
    full: bool
    tiles: [i64: Tile]
    layouts: [str: Layout]
    native: *Native? = none
    masks: [str: Tile]
}

struct Flow {
    width: f32
    size: f32
    baseline: f32
    height: f32
    glyphs: Placed[]
    pen: f32
    ink: f32
    before: f32
    word: i64
    in_word: bool
    last: Shaped
    lines: Line[]
    widest: f32
}

/// Returns a system that draws with `fonts` in order of preference, or with `font.fallback()` when `fonts` is empty, and a glyph atlas of 1024 pixels square.
pub fn system(fonts: font.Font[]) -> System {
    system_with_atlas(fonts, atlas_size)
}

/// Returns a system with `font.fallback()` as its only font.
pub fn default_system() -> System {
    system([])
}

/// Returns a system like `system` whose atlas is `size` pixels square, so a test can fill it with a few glyphs.
pub fn system_with_atlas(fonts: font.Font[], size: i64) -> System {
    let chosen = if fonts.len == 0 { [font.fallback()] } else { fonts }
    System { fonts: chosen, atlas: scene.atlas(size), shelves: [], next_shelf: 0, full: false, tiles: [:], layouts: [:], masks: [:] }
}

/// Switches `sys` to the system's installed fonts, shaped and rasterised by the system's text renderer, and returns whether it could.
///
/// `subpixel` asks for glyphs with one coverage value per colour stripe of a pixel; the renderer must be able to blend them. A system that could not switch keeps drawing with its built-in fonts. A layout whose family or weight no installed font matches is drawn with the default family, and with the built-in fonts when even that is missing.
pub fn use_system_fonts(mut sys: System, subpixel: bool) -> bool {
    let fonts = dwrite.open() catch {
        e => return false
    }
    let rendering = dwrite.rendering(fonts) catch {
        e => return false
    }
    sys.native = new(Native { fonts, rendering, subpixel, spaces: [:], shaped: [:] })
    true
}

/// Returns the values the renderer needs to blend the glyphs `paint` pushes: the gamma correction and contrast of the system's text, or the identity correction for built-in fonts.
pub fn params(sys: System) -> scene.TextParams {
    let native = sys.native ?? return scene.TextParams {}
    let r = native.rendering
    scene.TextParams {
        gamma_0: r.gamma[0]
        gamma_1: r.gamma[1]
        gamma_2: r.gamma[2]
        gamma_3: r.gamma[3]
        grayscale_contrast: r.grayscale_contrast
        subpixel_contrast: r.subpixel_contrast
        bgr: if r.bgr { u32(1) } else { u32(0) }
    }
}

/// Returns the number of layouts `wrap` holds for the current frame.
pub fn cached(sys: System) -> i64 {
    sys.layouts.len
}

/// Ends a frame: forgets the measured layouts, and when the atlas ran out of room during the frame, clears it and every packed glyph so the next frame packs its own text from the start.
pub fn end_frame(mut sys: System) {
    sys.layouts = [:]
    if sys.full {
        scene.clear(mut sys.atlas)
        sys.tiles = [:]
        sys.masks = [:]
        sys.shelves = []
        sys.next_shelf = 0
        sys.full = false
    }
}

/// Returns `s` laid out in `style` in lines no wider than `width` pixels, or in lines that end only at `\n` when `width` is infinite.
///
/// With the built-in fonts, each code point is drawn by the first font that has it, else by the first font's glyph 0, and advances the pen by the glyph's advance plus the `kern` adjustment to the glyph before it when both come from one font; every line has the first font's ascent, descent and line gap. With the system's fonts, each paragraph is shaped as one run with ligatures and contextual alternates, and every line is `style.line_height` tall with the face's ascent and descent centred in it. A line breaks after a space, so spaces at the end of a line hang past its width, and a word wider than `width` breaks between glyphs. `\n` ends a line, a `\r` is ignored, and a layout always has at least one line.
///
/// The result is kept until `end_frame`, so laying out the same `s`, `style` and `width` again returns it.
pub fn wrap(mut sys: System, s: str, style: Style, width: f32) -> Layout {
    let key = "{style.size}|{style.family}|{style.weight}|{style.line_height}|{width}|{s}"
    match sys.layouts[key] {
        some(cached_layout) => return cached_layout
        none => {}
    }
    let built = lay_out(sys, s, style, width)
    sys.layouts[key] = built
    built
}

/// Returns the size of `s` laid out by `wrap`.
pub fn measure(mut sys: System, s: str, style: Style, width: f32) -> geometry.Size {
    let l = wrap(mut sys, s, style, width)
    geometry.size(l.width, l.height)
}

/// Pushes one sprite onto `sc` for each visible glyph of `l`, tinted `color`, with the layout's top left at `origin` and everything multiplied by `scale`.
///
/// Built-in glyphs are rasterised at `l.size * scale` pixels, rounded to 1/64 pixel, the first time they are drawn, and each glyph's pen position is rounded to a whole device pixel. The system's glyphs are rasterised with the origin at a quarter device pixel horizontally and a whole device pixel vertically, and drawn as subpixel sprites when `use_system_fonts` asked for them. Glyphs are packed into the atlas with a one-pixel empty border. A glyph that does not fit in the atlas is left out, and so is every glyph packed after it until `end_frame`.
pub fn paint(mut sys: System, mut sc: scene.Scene, l: Layout, origin: geometry.Point, color: geometry.Color, scale: f32) {
    if l.native {
        let native = sys.native ?? return
        paint_native(mut sys, native, mut sc, l, origin, color, scale)
        return
    }
    let pixel_size = l.size * scale
    for line in l.lines {
        let baseline = snap((origin.y + line.y) * scale)
        for g in line.glyphs {
            let tile = glyph_tile(mut sys, g, pixel_size) ?? continue
            if tile.visible {
                let x = snap((origin.x + g.x) * scale)
                let bounds = geometry.rect(x + tile.left, baseline + tile.top, tile.width, tile.height)
                scene.push_sprite(mut sc, scene.Sprite { bounds, color, tile: tile.uv })
            }
        }
    }
}

fn snap(v: f32) -> f32 {
    floor(v + 0.5)
}

fn lay_out(sys: System, s: str, style: Style, width: f32) -> Layout {
    match sys.native {
        some(native) => {
            match lay_out_native(native, s, style, width) {
                some(l) => return l
                none => {}
            }
        }
        none => {}
    }
    lay_out_embedded(sys, s, style.size, style.line_height, width)
}

fn lay_out_embedded(sys: System, s: str, size: f32, line_height: f32, width: f32) -> Layout {
    let first = sys.fonts[0]
    let k = font.scale(first, size)
    let natural = f32(first.ascent - first.descent + first.line_gap) * k
    let height = if line_height > 0.0 { line_height } else { natural }
    let ascent = f32(first.ascent) * k + (height - natural) / 2.0
    var flow = Flow {
        width
        size
        baseline: ascent
        height
        glyphs: []
        pen: 0.0
        ink: 0.0
        before: 0.0
        word: 0
        in_word: false
        last: Shaped { font: -1, glyph: 0 }
        lines: []
        widest: 0.0
    }
    for c in s {
        if c == '\n' {
            finish_line(mut flow)
        } else if c != '\r' {
            let shaped = shape(sys, c)
            place(sys, mut flow, c == ' ', shaped)
        }
    }
    finish_line(mut flow)
    Layout { lines: flow.lines, size, width: flow.widest, height: height * f32(flow.lines.len), native: false }
}

fn find_face(fonts: *dwrite.Fonts, family: str, weight: i64) -> i64? {
    let index = dwrite.face(fonts, family, weight) catch {
        e => return none
    }
    index
}

fn native_face(native: *Native, style: Style) -> i64? {
    var found: i64? = none
    if style.family != "" {
        found = find_face(native.fonts, style.family, style.weight)
    }
    if found == none {
        found = find_face(native.fonts, dwrite.default_family(), style.weight)
    }
    let index = found ?? return none
    if native.spaces[index] == none {
        native.spaces[index] = space_glyph(native, index)
    }
    index
}

fn space_glyph(native: *Native, face: i64) -> i64 {
    let line = shape_paragraph(native, face, 16.0, " ") ?? return -1
    if line.runs.len == 0 || line.runs[0].glyphs.len == 0 {
        return -1
    }
    line.runs[0].glyphs[0].id
}

fn shape_paragraph(native: *Native, face: i64, size: f32, s: str) -> dwrite.Line? {
    let key = "{face}|{size}|{s}"
    match native.shaped[key] {
        some(known) => return known
        none => {}
    }
    let line = dwrite.layout(native.fonts, face, s, size) catch {
        e => return none
    }
    if native.shaped.len >= 4096 {
        native.shaped = [:]
    }
    native.shaped[key] = line
    line
}

fn lay_out_native(native: *Native, s: str, style: Style, width: f32) -> Layout? {
    let face = native_face(native, style) ?? return none
    let metrics = shape_paragraph(native, face, style.size, " ") ?? return none
    let natural = metrics.ascent + metrics.descent
    let pitch = if style.line_height > 0.0 { style.line_height } else { natural }
    let top = (pitch - natural) / 2.0 + metrics.ascent
    var lines: Line[] = []
    for paragraph in strs.split(s, '\n') {
        let shaped = shape_paragraph(native, face, style.size, strs.replace(paragraph, "\r", "")) ?? return none
        break_paragraph(pieces(native, shaped), width, mut lines)
    }
    if lines.len == 0 {
        lines.push(cut([], 0, 0))
    }
    var widest: f32 = 0.0
    for i in 0..lines.len {
        lines[i].y = top + pitch * f32(i)
        if lines[i].width > widest {
            widest = lines[i].width
        }
    }
    Layout { lines, size: style.size, width: widest, height: pitch * f32(lines.len), native: true }
}

fn pieces(native: *Native, line: dwrite.Line) -> Piece[] {
    var out: Piece[] = []
    for run in line.runs {
        let space = native.spaces[run.face] ?? -1
        for g in run.glyphs {
            out.push(Piece { glyph: Placed { font: run.face, glyph: g.id, x: g.x }, space: g.id == space, end: 0.0 })
        }
    }
    for i in 0..out.len {
        out[i].end = if i + 1 < out.len { out[i + 1].glyph.x } else { line.width }
    }
    out
}

fn break_paragraph(items: Piece[], width: f32, mut lines: Line[]) {
    var start = 0
    var word = 0
    var in_word = false
    for i in 0..items.len {
        let p = items[i]
        if p.space {
            in_word = false
            continue
        }
        if !in_word {
            word = i
            in_word = true
        }
        if p.end - items[start].glyph.x > width {
            if word > start {
                lines.push(cut(items, start, word))
                start = word
            }
            if i > start && p.end - items[start].glyph.x > width {
                lines.push(cut(items, start, i))
                start = i
                word = i
            }
        }
    }
    lines.push(cut(items, start, items.len))
}

fn cut(items: Piece[], from: i64, to: i64) -> Line {
    if from >= to {
        return Line { glyphs: [], y: 0.0, width: 0.0, end: 0.0 }
    }
    let origin = items[from].glyph.x
    var glyphs: Placed[] = []
    var ink: f32 = 0.0
    for i in from..to {
        let p = items[i]
        glyphs.push(Placed { font: p.glyph.font, glyph: p.glyph.glyph, x: p.glyph.x - origin })
        if !p.space {
            ink = p.end - origin
        }
    }
    Line { glyphs, y: 0.0, width: ink, end: items[to - 1].end - origin }
}

fn shape(sys: System, c: u32) -> Shaped {
    for i, f in sys.fonts {
        let g = font.glyph_index(f, c)
        if g != 0 {
            return Shaped { font: i, glyph: g }
        }
    }
    Shaped { font: 0, glyph: 0 }
}

fn place(sys: System, mut flow: Flow, is_space: bool, shaped: Shaped) {
    let f = sys.fonts[shaped.font]
    let advance = f32(font.advance(f, shaped.glyph)) * font.scale(f, flow.size)
    if is_space {
        add(mut flow, sys, shaped, advance)
        flow.in_word = false
        return
    }
    if !flow.in_word {
        flow.word = flow.glyphs.len
        flow.before = flow.ink
        flow.in_word = true
    }
    if pen_for(sys, flow, shaped) + advance > flow.width {
        if flow.word > 0 {
            move_word(mut flow)
        }
        if flow.glyphs.len > 0 && pen_for(sys, flow, shaped) + advance > flow.width {
            finish_line(mut flow)
            flow.in_word = true
        }
    }
    add(mut flow, sys, shaped, advance)
    flow.ink = flow.pen
}

fn pen_for(sys: System, flow: Flow, shaped: Shaped) -> f32 {
    if flow.last.font == shaped.font {
        let f = sys.fonts[shaped.font]
        flow.pen + f32(font.kern(f, flow.last.glyph, shaped.glyph)) * font.scale(f, flow.size)
    } else {
        flow.pen
    }
}

fn add(mut flow: Flow, sys: System, shaped: Shaped, advance: f32) {
    let x = pen_for(sys, flow, shaped)
    flow.glyphs.push(Placed { font: shaped.font, glyph: shaped.glyph, x })
    flow.pen = x + advance
    flow.last = shaped
}

fn move_word(mut flow: Flow) {
    if flow.word == flow.glyphs.len {
        finish_line(mut flow)
        flow.in_word = true
        return
    }
    let origin = flow.glyphs[flow.word].x
    var carried: Placed[] = []
    for i in flow.word..flow.glyphs.len {
        let g = flow.glyphs[i]
        carried.push(Placed { font: g.font, glyph: g.glyph, x: g.x - origin })
    }
    let kept = flow.glyphs[..flow.word]
    push_line(mut flow, kept, flow.before, origin)
    flow.glyphs = carried
    flow.pen = flow.pen - origin
    flow.ink = flow.pen
    flow.before = 0.0
    flow.word = 0
}

fn finish_line(mut flow: Flow) {
    push_line(mut flow, flow.glyphs, flow.ink, flow.pen)
    flow.glyphs = []
    flow.pen = 0.0
    flow.ink = 0.0
    flow.before = 0.0
    flow.word = 0
    flow.in_word = false
    flow.last = Shaped { font: -1, glyph: 0 }
}

fn push_line(mut flow: Flow, glyphs: Placed[], width: f32, end: f32) {
    let y = flow.baseline + flow.height * f32(flow.lines.len)
    flow.lines.push(Line { glyphs, y, width, end })
    if width > flow.widest {
        flow.widest = width
    }
}

fn tile_key(g: Placed, size_64: i64) -> i64 {
    g.font << 40 | g.glyph << 24 | size_64
}

fn glyph_tile(mut sys: System, g: Placed, pixel_size: f32) -> Tile? {
    let size_64 = i64(pixel_size * 64.0 + 0.5)
    let key = tile_key(g, size_64)
    match sys.tiles[key] {
        some(known) => return known
        none => {}
    }
    if sys.full {
        return none
    }
    let bitmap = font.rasterize(sys.fonts[g.font], g.glyph, f32(size_64) / 64.0)
    if bitmap.width == 0 {
        return remember_blank(mut sys, key)
    }
    let spot = reserve(mut sys, bitmap.width + 2, bitmap.height + 2) ?? return none
    scene.write(mut sys.atlas, spot.x + 1, spot.y + 1, bitmap.width, bitmap.height, bitmap.coverage)
    let uv = scene.tile(sys.atlas, spot.x + 1, spot.y + 1, bitmap.width, bitmap.height)
    let tile = Tile { visible: true, stripes: false, left: f32(bitmap.left), top: f32(bitmap.top), width: f32(bitmap.width), height: f32(bitmap.height), uv }
    sys.tiles[key] = tile
    tile
}

fn remember_blank(mut sys: System, key: i64) -> Tile {
    let blank = Tile { visible: false, stripes: false, left: 0.0, top: 0.0, width: 0.0, height: 0.0, uv: geometry.Rect {} }
    sys.tiles[key] = blank
    blank
}

fn quantize(v: f32, variants: i64) -> Origin {
    let whole = floor(v)
    let steps = i64(geometry.round_half_to_zero((v - whole) * f32(variants)))
    Origin { whole: i64(whole) + steps / variants, variant: steps % variants }
}

fn native_key(g: Placed, size: f32, scale: f32, variant: i64) -> i64 {
    let size_64 = i64(size * 64.0 + 0.5)
    let scale_16 = i64(scale * 16.0 + 0.5)
    1 << 60 | g.font << 44 | g.glyph << 28 | size_64 << 12 | scale_16 << 2 | variant
}

fn native_tile(mut sys: System, native: *Native, g: Placed, size: f32, scale: f32, variant: i64) -> Tile? {
    let key = native_key(g, size, scale, variant)
    match sys.tiles[key] {
        some(known) => return known
        none => {}
    }
    if sys.full {
        return none
    }
    let bitmap = dwrite.rasterize(native.fonts, g.font, g.glyph, size, scale, variant, native.subpixel) catch {
        e => return remember_blank(mut sys, key)
    }
    if bitmap.width == 0 {
        return remember_blank(mut sys, key)
    }
    let spot = reserve(mut sys, bitmap.width + 2, bitmap.height + 2) ?? return none
    if native.subpixel {
        scene.write_stripes(mut sys.atlas, spot.x + 1, spot.y + 1, bitmap.width, bitmap.height, bitmap.pixels)
    } else {
        scene.write(mut sys.atlas, spot.x + 1, spot.y + 1, bitmap.width, bitmap.height, bitmap.pixels)
    }
    let uv = scene.tile(sys.atlas, spot.x + 1, spot.y + 1, bitmap.width, bitmap.height)
    let tile = Tile { visible: true, stripes: native.subpixel, left: f32(bitmap.left), top: f32(bitmap.top), width: f32(bitmap.width), height: f32(bitmap.height), uv }
    sys.tiles[key] = tile
    tile
}

fn paint_native(mut sys: System, native: *Native, mut sc: scene.Scene, l: Layout, origin: geometry.Point, color: geometry.Color, scale: f32) {
    for line in l.lines {
        let down = quantize((origin.y + line.y) * scale, 1)
        for g in line.glyphs {
            let across = quantize((origin.x + g.x) * scale, 4)
            let tile = native_tile(mut sys, native, g, l.size, scale, across.variant) ?? continue
            if !tile.visible {
                continue
            }
            let bounds = geometry.rect(f32(across.whole) + tile.left, f32(down.whole) + tile.top, tile.width, tile.height)
            if tile.stripes {
                scene.push_subpixel_sprite(mut sc, scene.SubpixelSprite { bounds, color, tile: tile.uv })
            } else {
                scene.push_sprite(mut sc, scene.Sprite { bounds, color, tile: tile.uv })
            }
        }
    }
}

/// Pushes one sprite onto `sc` that draws the SVG document `source` in `color` inside `bounds`, a rectangle in logical pixels, with everything multiplied by `scale`.
///
/// The document is rasterised once into an atlas tile at twice the size of `bounds` snapped to device pixels, as coverage only, and the sprite samples that tile with linear filtering. The sprite is centred on the snapped `bounds`, its origin rounded to a whole device pixel and its size rounded up. A document that `svg.parse` rejects, or that does not fit in the atlas, draws nothing; the atlas is cleared at `end_frame` when it ran out of room.
pub fn paint_icon(mut sys: System, mut sc: scene.Scene, source: str, bounds: geometry.Rect, color: geometry.Color, scale: f32) {
    let snapped = geometry.snap(bounds, scale)
    if snapped.width < 1.0 || snapped.height < 1.0 {
        return
    }
    let width = i64(-floor(-(snapped.width * icon_supersample)))
    let height = i64(-floor(-(snapped.height * icon_supersample)))
    let key = "{width}x{height}|{source}"
    let tile = icon_tile(mut sys, source, key, width) ?? return
    if !tile.visible {
        return
    }
    let centre_x = snapped.x + snapped.width / 2.0
    let centre_y = snapped.y + snapped.height / 2.0
    let left = geometry.round_half_to_zero(centre_x - tile.width / icon_supersample / 2.0)
    let top = geometry.round_half_to_zero(centre_y - tile.height / icon_supersample / 2.0)
    let across = -floor(-(tile.width / icon_supersample))
    let down = -floor(-(tile.height / icon_supersample))
    scene.push_sprite(mut sc, scene.Sprite { bounds: geometry.rect(left, top, across, down), color, tile: tile.uv })
}

fn icon_tile(mut sys: System, source: str, key: str, width: i64) -> Tile? {
    match sys.masks[key] {
        some(known) => return known
        none => {}
    }
    if sys.full {
        return none
    }
    let blank = Tile { visible: false, stripes: false, left: 0.0, top: 0.0, width: 0.0, height: 0.0, uv: geometry.Rect {} }
    let icon = svg.parse(source) catch {
        e => {
            sys.masks[key] = blank
            return blank
        }
    }
    let mask = svg.render(icon, width)
    if mask.width == 0 || mask.height == 0 {
        sys.masks[key] = blank
        return blank
    }
    let spot = reserve(mut sys, mask.width + 2, mask.height + 2) ?? return none
    scene.write(mut sys.atlas, spot.x + 1, spot.y + 1, mask.width, mask.height, mask.coverage)
    let uv = scene.tile(sys.atlas, spot.x + 1, spot.y + 1, mask.width, mask.height)
    let tile = Tile { visible: true, stripes: false, left: 0.0, top: 0.0, width: f32(mask.width), height: f32(mask.height), uv }
    sys.masks[key] = tile
    tile
}

fn reserve(mut sys: System, width: i64, height: i64) -> Spot? {
    var best = -1
    for i, shelf in sys.shelves {
        if shelf.height >= height && sys.atlas.size - shelf.next >= width && (best < 0 || shelf.height < sys.shelves[best].height) {
            best = i
        }
    }
    if best >= 0 {
        let x = sys.shelves[best].next
        sys.shelves[best].next += width
        return Spot { x, y: sys.shelves[best].y }
    }
    if width > sys.atlas.size || sys.next_shelf + height > sys.atlas.size {
        sys.full = true
        return none
    }
    let y = sys.next_shelf
    sys.shelves.push(Shelf { y, height, next: width })
    sys.next_shelf += height
    Spot { x: 0, y }
}
