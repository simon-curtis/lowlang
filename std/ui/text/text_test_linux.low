import std/file
import std/io
import std/os
import std/testing
import std/ui/font
import std/ui/geometry
import std/ui/scene

fn table_record(mut out: u8[], tag: str, offset: i64, length: i64) {
    for i in 0..4 {
        out.push(tag[i])
    }
    io.put_be32(mut out, 0)
    io.put_be32(mut out, offset)
    io.put_be32(mut out, length)
}

fn sample_font(family: str, style: str, weight: i64, selection: i64, advance: i64, code_points: u32[]) -> str {
    var head: u8[] = []
    for _ in 0..54 {
        head.push(0)
    }
    io.set_be16(head, 18, 1000)
    var hhea: u8[] = []
    for _ in 0..36 {
        hhea.push(0)
    }
    io.set_be16(hhea, 4, 800)
    io.set_be16(hhea, 6, 65536 - 200)
    io.set_be16(hhea, 34, 2)
    var maxp: u8[] = []
    io.put_be32(mut maxp, 0x5000)
    io.put_be16(mut maxp, 2)
    var hmtx: u8[] = []
    for v in [0, 0, advance, 0] {
        io.put_be16(mut hmtx, v)
    }
    var glyf: u8[] = []
    for v in [1, 0, 0, 400, 600, 3, 0, 257, 257, 0, 400, 0, 65136, 0, 0, 600, 0] {
        io.put_be16(mut glyf, v)
    }
    var loca: u8[] = []
    for v in [0, 0, glyf.len / 2] {
        io.put_be16(mut loca, v)
    }
    var cmap: u8[] = []
    for v in [0, 1, 3, 10, 0, 12, 12, 0] {
        io.put_be16(mut cmap, v)
    }
    io.put_be32(mut cmap, 16 + 12 * code_points.len)
    io.put_be32(mut cmap, 0)
    io.put_be32(mut cmap, code_points.len)
    for c in code_points {
        io.put_be32(mut cmap, i64(c))
        io.put_be32(mut cmap, i64(c))
        io.put_be32(mut cmap, 1)
    }
    var os2: u8[] = []
    for _ in 0..86 {
        os2.push(0)
    }
    io.set_be16(os2, 4, weight)
    io.set_be16(os2, 26, 60)
    io.set_be16(os2, 28, 250)
    io.set_be16(os2, 6, 5)
    io.set_be16(os2, 62, selection)
    var post: u8[] = []
    for _ in 0..32 {
        post.push(0)
    }
    io.set_be16(post, 8, 65536 - 150)
    io.set_be16(post, 10, 40)
    var name: u8[] = []
    for v in [0, 2, 30, 3, 1, 0x409, 1, 2 * family.len, 0, 3, 1, 0x409, 2, 2 * style.len, 2 * family.len] {
        io.put_be16(mut name, v)
    }
    for text in [family, style] {
        for i in 0..text.len {
            io.put_be16(mut name, i64(text[i]))
        }
    }
    let tables = [cmap, glyf, head, hhea, hmtx, loca, maxp, name, os2, post]
    let tags = ["cmap", "glyf", "head", "hhea", "hmtx", "loca", "maxp", "name", "OS/2", "post"]
    var out: u8[] = []
    io.put_be32(mut out, 65536)
    io.put_be16(mut out, tables.len)
    for _ in 0..6 {
        out.push(0)
    }
    var offset = 12 + 16 * tables.len
    for i, data in tables {
        table_record(mut out, tags[i], offset, data.len)
        offset += (data.len + 3) / 4 * 4
    }
    for data in tables {
        for b in data {
            out.push(b)
        }
        for _ in 0..(4 - data.len % 4) % 4 {
            out.push(0)
        }
    }
    str(out)
}

fn ascii() -> u32[] {
    var out: u32[] = []
    for c in 0x20..0x7f {
        out.push(u32(c))
    }
    out
}

fn installed_fixture(t: *testing.T, name: str) -> str {
    let root = file.temp_dir("text-{name}") or panic("temp dir")
    file.mkdir_all("{root}/fonts") or panic("mkdir")
    file.write_text("{root}/fonts.conf", "<fontconfig><dir>{root}/fonts</dir></fontconfig>") or panic("conf")
    file.write_text("{root}/fonts/Upright.ttf", sample_font("Sample", "Regular", 400, 64, 500, ascii())) or panic("font")
    file.write_text("{root}/fonts/Italic.ttf", sample_font("Sample", "Italic", 400, 1, 600, ascii())) or panic("font")
    file.write_text("{root}/fonts/Bold.ttf", sample_font("Sample", "Bold", 700, 32, 700, ascii())) or panic("font")
    file.write_text("{root}/fonts/Plain.ttf", sample_font("Plain", "Regular", 400, 64, 500, ascii())) or panic("font")
    file.write_text("{root}/fonts/Lean.ttf", sample_font("Lean", "Regular", 400, 64, 500, ascii())) or panic("font")
    file.write_text("{root}/fonts/LeanOblique.ttf", sample_font("Lean", "Oblique", 400, 512, 550, ascii())) or panic("font")
    file.write_text("{root}/fonts/Han.ttf", sample_font("Han Fixture", "Regular", 400, 64, 1000, [0x4e16, 0x754c])) or panic("font")
    os.set_env("FONTCONFIG_FILE", "{root}/fonts.conf") or panic("env")
    os.set_env("XDG_CACHE_HOME", "{root}/cache") or panic("env")
    os.set_env("XDG_DATA_HOME", "{root}/data") or panic("env")
    os.set_env("XDG_DATA_DIRS", "{root}/shared") or panic("env")
    root
}

fn fonts_of(l: Layout) -> i64[] {
    var out: i64[] = []
    for g in l.lines[0].glyphs {
        out.push(g.font)
    }
    out
}

fn test_a_family_draws_with_the_installed_face(t: *testing.T) {
    let root = installed_fixture(t, "family")
    var sys = default_system()
    t.is_true(use_system_fonts(mut sys, false))
    let l = wrap(mut sys, "ab", Style { family: "Sample", size: 10.0 }, 1000.0)
    t.equal_slice(fonts_of(l), [1, 1])
    t.equal(l.width, 10.0)
    t.equal(l.height, 10.0)
    t.is_false(sys.fonts[1].slanted)
    file.remove_all(root) or {}
}

fn test_italic_picks_the_installed_italic_face_and_is_not_sheared(t: *testing.T) {
    let root = installed_fixture(t, "italic")
    var sys = default_system()
    use_system_fonts(mut sys, false)
    let l = wrap(mut sys, "ab", Style { family: "Sample", size: 10.0, font_style: FontStyle.Italic }, 1000.0)
    t.equal(l.width, 12.0)
    let face = l.lines[0].glyphs[0].font
    t.is_true(sys.fonts[face].slanted)
    var sc = scene.empty(100, 100, geometry.rgb(0))
    paint(mut sys, mut sc, l, geometry.point(0.0, 0.0), geometry.rgb(0xffffff), 1.0)
    let upright_key = tile_key(l.lines[0].glyphs[0], 640, false)
    t.is_some(sys.tiles[upright_key])
    file.remove_all(root) or {}
}

fn test_a_code_point_the_default_family_lacks_draws_with_an_installed_face(t: *testing.T) {
    let root = installed_fixture(t, "fallback")
    var sys = default_system()
    use_system_fonts(mut sys, false)
    let l = wrap(mut sys, "a世界", Style { size: 10.0 }, 1000.0)
    let fonts = fonts_of(l)
    t.equal(fonts[0], 0)
    t.is_true(fonts[1] > 0)
    t.equal(fonts[2], fonts[1])
    t.equal(font.glyph_index(sys.fonts[fonts[1]].font, 0x4e16), 1)
    file.remove_all(root) or {}
}

fn test_an_unknown_family_draws_with_the_built_in_fonts(t: *testing.T) {
    let root = installed_fixture(t, "unknown")
    var sys = default_system()
    use_system_fonts(mut sys, false)
    let l = wrap(mut sys, "ab", Style { family: "Nowhere", size: 10.0 }, 1000.0)
    t.equal_slice(fonts_of(l), [0, 0])
    t.equal(sys.fonts.len, 1)
    file.remove_all(root) or {}
}

fn test_an_added_font_comes_before_the_installed_family(t: *testing.T) {
    let root = installed_fixture(t, "added")
    var sys = default_system()
    use_system_fonts(mut sys, false)
    t.is_true(add_font(mut sys, sample_font("Sample", "Regular", 400, 64, 250, ascii())))
    t.is_false(add_font(mut sys, "not a font"))
    let l = wrap(mut sys, "ab", Style { family: "Sample", size: 10.0 }, 1000.0)
    t.equal(l.width, 5.0)
    file.remove_all(root) or {}
}

fn test_weight_picks_the_installed_face_nearest_it(t: *testing.T) {
    let root = installed_fixture(t, "weight")
    var sys = default_system()
    use_system_fonts(mut sys, false)
    let regular = wrap(mut sys, "ab", Style { family: "Sample", size: 10.0 }, 1000.0)
    let bold = wrap(mut sys, "ab", Style { family: "Sample", size: 10.0, weight: 700 }, 1000.0)
    let light = wrap(mut sys, "ab", Style { family: "Sample", size: 10.0, weight: 300 }, 1000.0)
    t.equal(regular.width, 10.0)
    t.equal(bold.width, 14.0)
    t.equal(light.width, 10.0)
    t.is_false(sys.fonts[bold.lines[0].glyphs[0].font].slanted)
    file.remove_all(root) or {}
}

fn test_italic_with_no_installed_italic_face_shears_the_upright_one(t: *testing.T) {
    let root = installed_fixture(t, "shear")
    var sys = default_system()
    use_system_fonts(mut sys, false)
    let l = wrap(mut sys, "ab", Style { family: "Plain", size: 10.0, font_style: FontStyle.Italic }, 1000.0)
    t.equal(l.width, 10.0)
    let g = l.lines[0].glyphs[0]
    t.is_true(g.font > 0)
    t.is_false(sys.fonts[g.font].slanted)
    var sc = scene.empty(100, 100, geometry.rgb(0))
    paint(mut sys, mut sc, l, geometry.point(0.0, 0.0), geometry.rgb(0xffffff), 1.0)
    t.is_some(sys.tiles[tile_key(g, 640, true)])
    t.is_none(sys.tiles[tile_key(g, 640, false)])
    file.remove_all(root) or {}
}

fn test_an_installed_oblique_face_answers_oblique_and_italic_unsheared(t: *testing.T) {
    let root = installed_fixture(t, "oblique")
    var sys = default_system()
    use_system_fonts(mut sys, false)
    for style in [FontStyle.Oblique, FontStyle.Italic] {
        let l = wrap(mut sys, "ab", Style { family: "Lean", size: 10.0, font_style: style }, 1000.0)
        t.equal(l.width, 11.0)
        t.is_true(sys.fonts[l.lines[0].glyphs[0].font].slanted)
    }
    let upright = wrap(mut sys, "ab", Style { family: "Lean", size: 10.0 }, 1000.0)
    t.equal(upright.width, 10.0)
    file.remove_all(root) or {}
}

fn test_decoration_strokes_come_from_the_installed_face(t: *testing.T) {
    let root = installed_fixture(t, "stroke")
    var sys = default_system()
    use_system_fonts(mut sys, false)
    let under = wrap(mut sys, "ab", Style { family: "Sample", size: 10.0, decoration: Decoration.Underline }, 1000.0)
    t.close_to(f64(under.stroke.top), -1.5, 0.001)
    t.close_to(f64(under.stroke.thickness), 0.4, 0.001)
    let strike = wrap(mut sys, "ab", Style { family: "Sample", size: 10.0, decoration: Decoration.Strikethrough }, 1000.0)
    t.close_to(f64(strike.stroke.top), 2.5, 0.001)
    t.close_to(f64(strike.stroke.thickness), 0.6, 0.001)
    let builtin = wrap(mut sys, "ab", Style { size: 10.0, decoration: Decoration.Underline }, 1000.0)
    t.not_equal(builtin.stroke.top, under.stroke.top)
    var sc = scene.empty(100, 100, geometry.rgb(0))
    paint(mut sys, mut sc, under, geometry.point(0.0, 0.0), geometry.rgb(0xffffff), 1.0)
    t.equal(sc.underlines.len, 1)
    file.remove_all(root) or {}
}

fn test_subpixel_is_ignored_with_the_installed_faces(t: *testing.T) {
    let root = installed_fixture(t, "subpixel")
    var sys = default_system()
    t.is_true(use_system_fonts(mut sys, true))
    let l = wrap(mut sys, "ab", Style { family: "Sample", size: 10.0 }, 1000.0)
    set_subpixel(mut sys, true)
    var sc = scene.empty(100, 100, geometry.rgb(0))
    paint(mut sys, mut sc, l, geometry.point(0.0, 0.0), geometry.rgb(0xffffff), 1.0)
    t.equal(sc.sprites.len, 2)
    t.equal(sc.subpixel_sprites.len, 0)
    file.remove_all(root) or {}
}
