import std/io
import std/sys

struct Waiting {
    view: sys.FdHandle
}

fn endpoint_path(pid: i64) -> str {
    "\\\\.\\pipe\\low-ui-{pid}"
}

fn listen_endpoint(path: str) -> Endpoint ! io.Error {
    let waiting = new(Waiting { view: sys.wrap(sys.listen_pipe(path, true)?) })
    Endpoint {
        accept: fn() -> io.Stream ! io.Error { accept_client(waiting, path)? }
        close: fn() { sys.close_on(waiting.view) }
    }
}

fn accept_client(waiting: *Waiting, path: str) -> io.Stream ! io.Error {
    let connected = waiting.view
    sys.accept_pipe(connected)?
    waiting.view = sys.wrap(sys.listen_pipe(path, false)?)
    sys.stream_on(connected)
}

fn dial(path: str) -> io.Stream ! io.Error {
    sys.stream_on(sys.wrap(sys.open_pipe(path)?))
}
