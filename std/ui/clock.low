const motion_refresh_ms = 1000

struct Timer {
    id: i64
    due: i64
    period: i64
    run: fn()
}

struct Animation {
    id: i64
    step: fn(i64) -> bool
}

/// Moves the clock of a context made by `headless` forward by `ms` milliseconds and runs the timers of every open window that fall due, and those of `cx` itself when its window has closed, such as the one that ends a chord left waiting for its next keystroke. A context that `open` made reads the system's monotonic clock, which this does not move.
pub fn advance_clock(cx: Context, ms: i64) {
    let sh = cx.state.shared
    sh.manual_ms += ms
    for w in sh.windows {
        if w.slot.open {
            fire_timers(w.slot.state)
        }
    }
    if closed_window(cx.state) {
        fire_timers(cx.state)
    }
}

fn now_ms(st: *State) -> i64 {
    st.shared.clock()
}

/// Returns the context's clock in milliseconds. While a frame is being built it is the time the frame started at, so a tree reads one time throughout and `animate` passes its function the same value. A context made by `headless` reads zero until `advance_clock` moves it.
pub fn now(cx: Context) -> i64 {
    let st = cx.state
    if st.framing {
        return st.frame_ms
    }
    now_ms(st)
}

/// Runs `f` once, `ms` milliseconds from now on the context's clock, on its green thread, and returns an id for `cancel_timer`. A frame is due after it runs.
pub fn after(cx: Context, ms: i64, f: fn()) -> i64 {
    schedule(cx.state, ms, f)
}

/// Runs `f` every `ms` milliseconds, at least one, until `cancel_timer` stops it, and returns its id. The ticks keep their phase, so a clock that moves past several at once, as one `advance_clock` or a stalled loop does, runs `f` once and waits for the next tick after it. `f` may cancel its own timer.
pub fn every(cx: Context, ms: i64, f: fn()) -> i64 {
    add_timer(cx.state, ms, if ms < 1 { 1 } else { ms }, f)
}

/// Stops the timer or the animation that `id` names, whether it has run or not. An id that is not running does nothing.
pub fn cancel_timer(cx: Context, id: i64) {
    unschedule(cx.state, id)
}

/// Calls `f` with the context's clock in milliseconds at the start of each frame until it returns `false`, and keeps frames coming while it runs, so a value that follows the clock moves smoothly whatever else changes. `f` runs before the tree is built, so what it sets is in that frame. Returns an id for `cancel_timer`.
pub fn animate(cx: Context, f: fn(i64) -> bool) -> i64 {
    let st = cx.state
    st.next_timer += 1
    st.animations.push(Animation { id: st.next_timer, step: f })
    st.dirty = true
    st.next_timer
}

/// Returns `true` when the system asks for no animation: `SPI_GETCLIENTAREAANIMATION` on Windows, and on Linux the GNOME `enable-animations` setting read through the settings portal on the session bus, which is `false` without one. The answer is read at most once a second. `set_reduced_motion` overrides it.
pub fn prefers_reduced_motion(cx: Context) -> bool {
    let sh = cx.state.shared
    match sh.motion_override {
        some(on) => return on
        none => {}
    }
    let at = sh.clock()
    if sh.motion_read < 0 || at - sh.motion_read >= motion_refresh_ms {
        sh.motion = sh.system_motion()
        sh.motion_read = at
    }
    sh.motion
}

/// Makes `prefers_reduced_motion` return `on` in every window of the application whatever the system says, as a program with its own animation switch does and a test of both branches needs. `none` hands the answer back to the system.
pub fn set_reduced_motion(cx: Context, on: bool?) {
    cx.state.shared.motion_override = on
}

fn schedule(st: *State, delay_ms: i64, f: fn()) -> i64 {
    add_timer(st, delay_ms, 0, f)
}

fn add_timer(st: *State, delay_ms: i64, period: i64, f: fn()) -> i64 {
    st.next_timer += 1
    st.timers.push(Timer { id: st.next_timer, due: now_ms(st) + delay_ms, period, run: f })
    st.next_timer
}

fn unschedule(st: *State, id: i64) {
    var kept: Timer[] = []
    for t in st.timers {
        if t.id != id {
            kept.push(t)
        }
    }
    st.timers = kept
    var running: Animation[] = []
    for a in st.animations {
        if a.id != id {
            running.push(a)
        }
    }
    st.animations = running
}

fn step_animations(st: *State) {
    let steps = st.animations
    for a in steps {
        if !a.step(st.frame_ms) {
            unschedule(st, a.id)
        }
    }
}

fn fire_timers(st: *State) {
    for {
        let now = now_ms(st)
        var due = -1
        for i, t in st.timers {
            if t.due <= now && (due < 0 || t.due < st.timers[due].due) {
                due = i
            }
        }
        if due < 0 {
            return
        }
        let t = st.timers[due]
        if t.period > 0 {
            st.timers[due].due += (now - t.due) / t.period * t.period + t.period
        } else {
            unschedule(st, t.id)
        }
        t.run()
        st.dirty = true
    }
}

fn wait_ms(st: *State) -> i64 {
    if st.timers.len == 0 {
        return -1
    }
    var soonest = st.timers[0].due
    for t in st.timers {
        if t.due < soonest {
            soonest = t.due
        }
    }
    let left = soonest - now_ms(st)
    if left < 0 { 0 } else { left }
}
