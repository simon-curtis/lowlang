struct Timer {
    id: i64
    due: i64
    run: fn()
}

/// Moves the clock of a context made by `headless` forward by `ms` milliseconds and runs the timers that fall due, such as the one that ends a chord left waiting for its next keystroke. A context that `open` made reads the system's monotonic clock, which this does not move.
pub fn advance_clock(cx: Context, ms: i64) {
    cx.state.manual_ms += ms
    fire_timers(cx.state)
}

fn now_ms(st: *State) -> i64 {
    st.clock()
}

fn schedule(st: *State, delay_ms: i64, f: fn()) -> i64 {
    st.next_timer += 1
    st.timers.push(Timer { id: st.next_timer, due: now_ms(st) + delay_ms, run: f })
    st.next_timer
}

fn cancel_timer(st: *State, id: i64) {
    var kept: Timer[] = []
    for t in st.timers {
        if t.id != id {
            kept.push(t)
        }
    }
    st.timers = kept
}

fn fire_timers(st: *State) {
    for {
        let now = now_ms(st)
        var due = -1
        for i, t in st.timers {
            if t.due <= now && (due < 0 || t.due < st.timers[due].due) {
                due = i
            }
        }
        if due < 0 {
            return
        }
        let t = st.timers[due]
        cancel_timer(st, t.id)
        t.run()
        st.dirty = true
    }
}

fn wait_ms(st: *State) -> i64 {
    if st.timers.len == 0 {
        return -1
    }
    var soonest = st.timers[0].due
    for t in st.timers {
        if t.due < soonest {
            soonest = t.due
        }
    }
    let left = soonest - now_ms(st)
    if left < 0 { 0 } else { left }
}
