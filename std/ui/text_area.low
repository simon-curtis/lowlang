import std/builder
import std/ui/geometry
import std/ui/layout
import std/ui/platform
import std/ui/scene
import std/unicode
import uitext = std/ui/text

const area_group_ms = 300
const area_history_limit = 1000
const kind_other = 0
const kind_typing = 1
const kind_backspace = 2
const kind_delete = 3
const area_drag_caret = 0
const area_drag_add = 1
const area_drag_rect = 2
const tab_code: u32 = 9
const space_code: u32 = 32
const no_break_space: u32 = 160
const line_separator: u32 = 8232
const paragraph_separator: u32 = 8233

/// A place in a document: a line and a byte offset into that line, both counted from zero.
pub struct TextPosition {
    /// The line, `0` for the first.
    pub line: i64 = 0
    /// The byte offset into the line's text, `0` before its first byte and the line's length after its last.
    pub column: i64 = 0
}

/// A replacement of the text from `start` up to `end` with `text`, which a text area asks its `LineSource` to apply.
pub struct TextEdit {
    /// The first position the edit covers.
    pub start: TextPosition
    /// The position after the last one the edit covers; equal to `start` for an insertion.
    pub end: TextPosition
    /// The replacement. Line breaks in it are `\n`, and an empty `text` is a deletion.
    pub text: str
}

/// A stretch of one line drawn in its own colour or weight.
pub struct TextRun {
    /// The offset of the first byte of the run in the line.
    pub start: i64
    /// The offset after the last byte of the run.
    pub end: i64
    /// The colour of the run's text, or `none` for the text colour of the element.
    pub color: geometry.Color? = none
    /// The weight of the run's face, `400` regular and `700` bold, or `none` for the element's weight.
    pub weight: i64? = none
}

/// The document a text area shows and edits, as functions the application provides.
///
/// The application owns the document. A text area reads it through `line_count` and `line_text` and changes it only by calling `edit`, so the functions must read the live document and not a snapshot taken when the element was built: keys, clicks and an input method's text reach the area between frames. `line_text` returns a line without its line break, so a line holds no `\n`.
pub struct LineSource {
    /// Returns the number of lines. A document always has at least one line, so a count below one is read as one empty line.
    pub line_count: fn() -> i64
    /// Returns the text of line `i`, counted from zero and below `line_count`.
    pub line_text: fn(i64) -> str
    /// Applies the `TextEdit` it is given: the text from `start` up to `end` becomes `text` and nothing else in the document changes. The area works out where its caret goes from the edit and keeps the removed text for undo, then reads the document back. When the document differs from what the edit describes, as when the application ignores or alters the edit, the area drops its undo and redo history and keeps its caret within the text the document holds.
    pub edit: fn(TextEdit)
    /// Applies the edits of one step made with more than one selection, called instead of `edit` for that step. The edits come last position first, by `start` and then by `end`, and every position in them is taken from the document as it was before the step, so applying them in the order given keeps each position valid. No two edits overlap, and an insertion at the start of a deletion comes after it. The area reads the document back after the call as it does after `edit`. Undo and redo apply their changes one at a time through `edit`. When it is `none` the area calls `edit` once for each of the edits, in the same order.
    pub edit_all: fn(TextEdit[])? = none
    /// Returns the styled runs of line `i`, in order and not overlapping, or none for a line drawn plain.
    pub line_runs: fn(i64) -> TextRun[]
    /// Returns the colour behind the whole of line `i`, across the area's padding on each side, or `none` for no decoration.
    pub line_fill: fn(i64) -> geometry.Color?
    /// Returns `true` when line `i` is not drawn. A hidden line takes no height, the caret and the vertical, page and horizontal moves skip it, and scrolling, the scroll bar and `text_area_visible_row` count only the lines that are drawn, while every position, edit, selection and `text_area_top_line` keeps the document's line numbers. A selection across a hidden range covers it, and an edit inside one is the application's to refuse. The area asks it only about lines near the view and the caret, and only while `hidden_before` reports a hidden line.
    pub line_hidden: fn(i64) -> bool
    /// Returns how many of the lines before line `i` are hidden, so `hidden_before(line_count())` is the number of hidden lines in all, and `0` while nothing is hidden. It must agree with `line_hidden`: while it returns `0` for every line the area never calls `line_hidden`, and the scroll range and the scroll bar come from it without a pass over the document.
    pub hidden_before: fn(i64) -> i64
}

/// The two ends of a selection: where it was started and where its caret is, either first.
pub struct TextSelection {
    /// The end the selection was started from.
    pub anchor: TextPosition = TextPosition {}
    /// The end that moves, where typing goes.
    pub caret: TextPosition = TextPosition {}
}

struct AreaChange {
    start: TextPosition
    removed: str
    inserted: str
}

struct AreaGroup {
    changes: AreaChange[]
    kind: i64
    before: TextSelection
    before_more: TextSelection[]
    after: TextSelection
    after_more: TextSelection[]
}

struct AreaSel {
    anchor: TextPosition = TextPosition {}
    caret: TextPosition = TextPosition {}
    x: f32 = -1.0
    newest: bool = false
}

struct AreaState {
    caret: TextPosition = TextPosition {}
    anchor: TextPosition = TextPosition {}
    more: AreaSel[] = []
    newest: i64 = -1
    drag_mode: i64 = 0
    drag_base: AreaSel[] = []
    drag_from: TextPosition = TextPosition {}
    drag_x: f32 = 0.0
    preferred: f32? = none
    first: i64 = 0
    shift: f32 = 0.0
    scroll_x: f32 = 0.0
    widest: f32 = 0.0
    reveal: bool = false
    reveal_at: TextPosition? = none
    undo: AreaGroup[] = []
    redo: AreaGroup[] = []
    open: bool = false
    edited_ms: i64 = 0
    preedit: str = ""
    preedit_cursor: platform.TextRange? = none
    content: geometry.Rect = geometry.Rect {}
    line_height: f32 = 0.0
    page: i64 = 1
    style: uitext.Style = uitext.Style {}
    tab_size: i64 = 1
}

struct AreaPiece {
    start: i64
    end: i64
    layout: uitext.Layout
    x: f32
    color: geometry.Color?
    cell: i64
}

struct AreaShaped {
    text: str
    pieces: AreaPiece[]
    width: f32
    tab: i64
    cells: i64
}

struct BlankMarks {
    color: geometry.Color
    caret_line: geometry.Color
}

struct AreaMarks {
    dot: uitext.Layout
    arrow: uitext.Layout
    color: geometry.Color
    caret_line: geometry.Color
}

struct AreaRow {
    line: i64
    text: str
    shaped: AreaShaped
    top: f32
}

struct BindingSpec {
    keys: str
    action: str
}

/// Returns a source over `line_count` and `line_text` that applies edits with `edit`, with no styled runs, no line decorations and no hidden lines. Set `line_runs` and `line_fill` on the result to add them, and `line_hidden` with `hidden_before` to hide lines.
pub fn line_source(line_count: fn() -> i64, line_text: fn(i64) -> str, edit: fn(TextEdit)) -> LineSource {
    LineSource {
        line_count
        line_text
        edit
        edit_all: none
        line_runs: fn(i: i64) -> TextRun[] { [] }
        line_fill: fn(i: i64) -> geometry.Color? { none }
        line_hidden: fn(i: i64) -> bool { false }
        hidden_before: fn(i: i64) -> i64 { 0 }
    }
}

/// Returns a multi-line text editor over `source`, 300 by 200 logical pixels, that takes focus when clicked and shows the text cursor.
///
/// The element is a leaf in the key context `TextArea`. It draws only the lines in view, at a fixed line height, and asks `source` for the text of no others, so a document of a million lines costs the same as one of fifty, and draws none of the lines `line_hidden` reports, provided `hidden_before` counts them. The caret, the selection, the preferred column of vertical moves, the scroll position and the undo history are kept per key, so give the element an `id` to keep them where the tree moves it. The editing keys are actions: the bindings in `text_area_bindings` dispatch the actions named there to the focused area, whose built-in handlers run after the `capture_action` handlers of the elements around it and after the area's own `on_action` handlers, and stop the action, so an element around the area intercepts an editing action with `capture_action`. Dragging with the Alt key or the middle button held selects a column, one selection per line, and Control with the middle button or with Alt keeps the selections already there; a middle press takes focus, pastes nothing and still reaches the `on_mouse_down` handlers for the middle button of the area and its ancestors. Typed text and an input method's text are inserted at the caret. The area does not change the document itself: it calls `source.edit`, and the application's document is what the next frame reads. With `read_only` it shows the document and keeps selection, copy, caret movement and scrolling, but never calls `source.edit` and opens no input method composition. `tab_size` gives a tab its width and `blank_marks` draws spaces and tabs.
pub fn text_area(source: LineSource) -> Element {
    let context = parse_key_context("TextArea") catch {
        err => panic("text_area: cannot read the key context")
    }
    var out = Element { kind: TextArea, focusable: true, lines: source }
    out.cursor = platform.Cursor.Text
    out.style.width = Px(300.0)
    out.style.height = Px(200.0)
    out.key_context = context
    out
}

/// Returns `e`, a `text_area`, advancing each tab character to the next multiple of `n` columns, counted in characters from the start of the line with earlier tabs expanded, so a tab at column 5 in a size of 4 ends at column 8. A size below `1` is read as `1`, which is also the default and draws a tab one column wide, as a space. Shaping, the caret, clicks and drags, selection rectangles and the preferred column of Up and Down all place a column the same way, and the text, `copy` and the edit offsets are unchanged. A tab's span is one position for the caret and a click inside it lands on the nearer edge. On any other element it has no effect.
pub fn tab_size(e: Element, n: i64) -> Element {
    var out = e
    out.tab_size = if n < 1 { 1 } else { n }
    out
}

/// Returns `e`, a `text_area`, drawing `·` over each space and `→` at the first column of each tab, in `color`, or in `caret_line` on the line that holds the caret. A no-break space and the other spaces of the Unicode `White_Space` property that are not line breaks get a `·` too. The marks are drawing only: the text, `copy`, the columns and the widths are unchanged, a `·` is centred in its blank's cell and a `→` starts at the left of the tab's first column. Only the lines in view are marked. On any other element it has no effect.
pub fn blank_marks(e: Element, color: geometry.Color, caret_line: geometry.Color) -> Element {
    var out = e
    out.blank_marks = BlankMarks { color, caret_line }
    out
}

fn binding_specs() -> BindingSpec[] {
    [
        BindingSpec { keys: "left", action: "text_area.left" },
        BindingSpec { keys: "right", action: "text_area.right" },
        BindingSpec { keys: "up", action: "text_area.up" },
        BindingSpec { keys: "down", action: "text_area.down" },
        BindingSpec { keys: "shift-left", action: "text_area.select_left" },
        BindingSpec { keys: "shift-right", action: "text_area.select_right" },
        BindingSpec { keys: "shift-up", action: "text_area.select_up" },
        BindingSpec { keys: "shift-down", action: "text_area.select_down" },
        BindingSpec { keys: "ctrl-left", action: "text_area.word_left" },
        BindingSpec { keys: "ctrl-right", action: "text_area.word_right" },
        BindingSpec { keys: "ctrl-shift-left", action: "text_area.select_word_left" },
        BindingSpec { keys: "ctrl-shift-right", action: "text_area.select_word_right" },
        BindingSpec { keys: "home", action: "text_area.line_start" },
        BindingSpec { keys: "end", action: "text_area.line_end" },
        BindingSpec { keys: "shift-home", action: "text_area.select_line_start" },
        BindingSpec { keys: "shift-end", action: "text_area.select_line_end" },
        BindingSpec { keys: "ctrl-home", action: "text_area.document_start" },
        BindingSpec { keys: "ctrl-end", action: "text_area.document_end" },
        BindingSpec { keys: "ctrl-shift-home", action: "text_area.select_document_start" },
        BindingSpec { keys: "ctrl-shift-end", action: "text_area.select_document_end" },
        BindingSpec { keys: "pageup", action: "text_area.page_up" },
        BindingSpec { keys: "pagedown", action: "text_area.page_down" },
        BindingSpec { keys: "shift-pageup", action: "text_area.select_page_up" },
        BindingSpec { keys: "shift-pagedown", action: "text_area.select_page_down" },
        BindingSpec { keys: "backspace", action: "text_area.backspace" },
        BindingSpec { keys: "shift-backspace", action: "text_area.backspace" },
        BindingSpec { keys: "delete", action: "text_area.delete" },
        BindingSpec { keys: "ctrl-backspace", action: "text_area.delete_word_left" },
        BindingSpec { keys: "ctrl-delete", action: "text_area.delete_word_right" },
        BindingSpec { keys: "enter", action: "text_area.new_line" },
        BindingSpec { keys: "shift-enter", action: "text_area.new_line" },
        BindingSpec { keys: "tab", action: "text_area.tab" },
        BindingSpec { keys: "ctrl-a", action: "text_area.select_all" },
        BindingSpec { keys: "ctrl-c", action: "text_area.copy" },
        BindingSpec { keys: "ctrl-x", action: "text_area.cut" },
        BindingSpec { keys: "ctrl-v", action: "text_area.paste" },
        BindingSpec { keys: "ctrl-z", action: "text_area.undo" },
        BindingSpec { keys: "ctrl-y", action: "text_area.redo" },
        BindingSpec { keys: "ctrl-shift-z", action: "text_area.redo" },
        BindingSpec { keys: "ctrl-alt-up", action: "text_area.add_cursor_above" },
        BindingSpec { keys: "ctrl-alt-down", action: "text_area.add_cursor_below" },
        BindingSpec { keys: "ctrl-d", action: "text_area.select_next_occurrence" },
        BindingSpec { keys: "ctrl-shift-d", action: "text_area.select_all_occurrences" },
        BindingSpec { keys: "escape", action: "text_area.collapse_selections" },
    ]
}

/// Returns the default key bindings of a text area, in the context `TextArea`, for the application to pass to `bind_keys`, as gpui's `examples/input.rs` binds its text input's actions.
///
/// The actions are `text_area.left`, `right`, `up` and `down` and their `select_` forms, `word_left` and `word_right` and their `select_` forms, `line_start` and `line_end` (Home and End), `document_start` and `document_end` (Control with Home and End), `page_up` and `page_down` and their `select_` forms, `backspace`, `delete`, `delete_word_left`, `delete_word_right`, `new_line`, `tab`, `select_all`, `copy`, `cut`, `paste`, `undo` and `redo`.
    ///
    /// Several selections come from `add_cursor_above` and `add_cursor_below` (Control and Alt with Up and Down), which add a caret on the line above or below each selection's caret, `select_next_occurrence` (Control with D), which selects the word at the caret when the primary selection is empty and otherwise adds the next occurrence of the text of the newest selection, and `select_all_occurrences` (Control and Shift with D). `collapse_selections` (Escape) drops every selection but the primary one and does nothing, so that Escape reaches the elements around the area, when there is only one. Bind other keystrokes to them, or bind keystrokes to the empty action to unbind them: with `tab` unbound, Tab moves focus on from the area instead of inserting a tab, and Shift+Tab, which is not bound, moves it back. A `read_only` area handles none of `backspace`, `delete`, `delete_word_left`, `delete_word_right`, `new_line`, `tab`, `cut`, `paste`, `undo` and `redo`, so those keys fall through and Tab moves focus on.
pub fn text_area_bindings() -> KeyBinding[] {
    var out: KeyBinding[] = []
    for s in binding_specs() {
        let b = key_binding(s.keys, s.action, "TextArea") catch {
            err => panic("text_area_bindings: cannot read {s.keys}")
        }
        out.push(b)
    }
    out
}

fn area_action_names() -> str[] {
    var names: str[] = []
    for s in binding_specs() {
        if !listed(names, s.action) {
            names.push(s.action)
        }
    }
    names
}

fn area_edit_action(name: str) -> bool {
    match name {
        "text_area.backspace" => true
        "text_area.delete" => true
        "text_area.delete_word_left" => true
        "text_area.delete_word_right" => true
        "text_area.new_line" => true
        "text_area.tab" => true
        "text_area.cut" => true
        "text_area.paste" => true
        "text_area.undo" => true
        "text_area.redo" => true
        _ => false
    }
}

fn area_refuses(e: Element, name: str) -> bool {
    e.read_only && area_edit_action(name)
}

fn is_text_area(e: Element) -> bool {
    match e.kind {
        TextArea => true
        _ => false
    }
}

fn area_state(st: *State, name: str) -> *AreaState {
    match st.areas[name] {
        some(existing) => return existing
        none => {}
    }
    let created = new(AreaState {})
    st.areas[name] = created
    created
}

/// Returns the primary selection of the text area whose key is `key`, its `id` or its position in the tree, as of the last event: the first of `text_area_selections`.
pub fn text_area_selection(cx: Context, key: str) -> TextSelection {
    let a = area_state(cx.state, key)
    TextSelection { anchor: a.anchor, caret: a.caret }
}

/// Returns every selection of the text area whose key is `key`, in document order and not overlapping, as of the last event. The first is the primary one that scrolling, the input method and `text_area_selection` follow. An area with one selection returns a slice of one.
pub fn text_area_selections(cx: Context, key: str) -> TextSelection[] {
    let a = area_state(cx.state, key)
    var out: TextSelection[] = [TextSelection { anchor: a.anchor, caret: a.caret }]
    for s in a.more {
        out.push(TextSelection { anchor: s.anchor, caret: s.caret })
    }
    out
}

/// Selects from `anchor` to `caret` in the text area whose key is `key`, dropping any other selection, and scrolls it to show the caret in the next frame. Positions outside the document are moved to the nearest grapheme boundary inside it.
pub fn set_text_area_selection(cx: Context, key: str, anchor: TextPosition, caret: TextPosition) {
    let a = area_state(cx.state, key)
    a.anchor = anchor
    a.caret = caret
    area_one(a)
    let at = find(cx.state, key)
    if at >= 0 {
        area_sync(a, area_source(cx.state.hitboxes[at].element))
    }
    a.open = false
    a.preferred = none
    a.reveal = true
    cx.state.dirty = true
}

/// Replaces the selections of the text area whose key is `key` with `selections` and scrolls it to show the first in the next frame. Positions outside the document are moved to the nearest grapheme boundary inside it, selections that overlap, or whose carets meet, are merged, and the result is kept in document order, so the first of `text_area_selections` afterwards is the one that starts first. An empty slice changes nothing.
pub fn set_text_area_selections(cx: Context, key: str, selections: TextSelection[]) {
    if selections.len == 0 {
        return
    }
    let a = area_state(cx.state, key)
    var list: AreaSel[] = []
    for s in selections {
        list.push(AreaSel { anchor: s.anchor, caret: s.caret })
    }
    area_install(a, list)
    let at = find(cx.state, key)
    if at >= 0 {
        area_sync(a, area_source(cx.state.hitboxes[at].element))
    }
    a.open = false
    a.preferred = none
    a.reveal = true
    cx.state.dirty = true
}

/// Scrolls the text area whose key is `key` in the next frame to show the caret of `selection`, as far as it takes, instead of the primary selection's. Call it after `set_text_area_selections` to reveal the selection the application added, whose place in `text_area_selections` the merging may have moved. The next key, click or drag drops the request, which moves no selection and does not focus the area.
pub fn reveal_text_area_selection(cx: Context, key: str, selection: TextSelection) {
    let a = area_state(cx.state, key)
    a.reveal = true
    a.reveal_at = some(selection.caret)
    cx.state.dirty = true
}

/// Returns the first line the text area whose key is `key` shows, which may be only partly in view. It is a document line that `line_hidden` does not hide, as of the last frame.
pub fn text_area_top_line(cx: Context, key: str) -> i64 {
    area_state(cx.state, key).first
}

/// Scrolls the text area whose key is `key` so that line `line` is its first line in view, as far as the end of the document allows. A hidden `line` scrolls to the nearest line above it that is drawn, or below when none is.
pub fn scroll_text_area_to_line(cx: Context, key: str, line: i64) {
    let a = area_state(cx.state, key)
    a.first = if line < 0 { 0 } else { line }
    a.shift = 0.0
    cx.state.dirty = true
}

/// Returns the number of lines that are drawn between the first line in view of the text area whose key is `key` and `line`, so `0` for the first line in view, as of the last frame, or `none` when `line` is hidden, above the first line in view, below the last row drawn or past the document, or when the area was not drawn. A gutter that numbers by document line puts line `line` that many rows below the top, less the scrolled part of the first row, and finds the line in each row by walking from `text_area_top_line` over the lines `line_hidden` does not hide.
pub fn text_area_visible_row(cx: Context, key: str, line: i64) -> i64? {
    let at = find(cx.state, key)
    if at < 0 {
        return none
    }
    let a = area_state(cx.state, key)
    let src = area_source(cx.state.hitboxes[at].element)
    if a.line_height <= 0.0 || line < a.first || line >= area_count(src) || area_hidden(src, line) {
        return none
    }
    let row = area_rows_between(src, a.first, line)
    if f32(row) * a.line_height - a.shift >= a.content.height {
        return none
    }
    some(row)
}

fn area_source(e: Element) -> LineSource {
    match e.lines {
        some(s) => s
        none => line_source(fn() -> i64 { 1 }, fn(i: i64) -> str { "" }, fn(x: TextEdit) {})
    }
}

fn area_count(src: LineSource) -> i64 {
    let n = src.line_count()
    if n < 1 { 1 } else { n }
}

fn area_pos(line: i64, column: i64) -> TextPosition {
    TextPosition { line, column }
}

fn area_before(a: TextPosition, b: TextPosition) -> bool {
    a.line < b.line || (a.line == b.line && a.column < b.column)
}

fn area_same(a: TextPosition, b: TextPosition) -> bool {
    a.line == b.line && a.column == b.column
}

fn area_start(a: *AreaState) -> TextPosition {
    if area_before(a.caret, a.anchor) { a.caret } else { a.anchor }
}

fn area_stop(a: *AreaState) -> TextPosition {
    if area_before(a.caret, a.anchor) { a.anchor } else { a.caret }
}

fn area_selecting(a: *AreaState) -> bool {
    !area_same(a.caret, a.anchor)
}

fn area_settle(a: *AreaState, count: i64) {
    a.caret.line = clamped(a.caret.line, count - 1)
    a.anchor.line = clamped(a.anchor.line, count - 1)
    a.first = clamped(a.first, count - 1)
}

fn area_snap(text: str, column: i64) -> i64 {
    if column <= 0 {
        return 0
    }
    if column >= text.len {
        return text.len
    }
    var start = 0
    for start < text.len {
        let stop = unicode.grapheme_end(text, start)
        if stop > column {
            return start
        }
        start = stop
    }
    text.len
}

fn area_fit(src: LineSource, count: i64, p: TextPosition) -> TextPosition {
    let line = clamped(p.line, count - 1)
    if p.column <= 0 {
        return area_pos(line, 0)
    }
    area_pos(line, area_snap(src.line_text(line), p.column))
}

fn area_sync(a: *AreaState, src: LineSource) {
    let count = area_count(src)
    let caret = area_fit(src, count, a.caret)
    var anchor = caret
    if !area_same(a.anchor, a.caret) {
        anchor = area_fit(src, count, a.anchor)
    }
    a.caret = caret
    a.anchor = anchor
    a.first = clamped(a.first, count - 1)
    a.reveal_at = none
    if a.more.len > 0 {
        area_fit_all(a, src, count)
    }
}

fn area_page_rows(height: f32, line_height: f32) -> i64 {
    if line_height <= 0.0 {
        return 1
    }
    let whole = i64(floor(height / line_height))
    if whole < 1 { 1 } else { whole }
}

fn area_clamp_scroll(a: *AreaState, src: LineSource, count: i64) {
    let lh = a.line_height
    if lh <= 0.0 {
        return
    }
    var first = area_visible_near(src, count, a.first)
    var shift = a.shift
    if first != a.first {
        shift = 0.0
    }
    let height = a.content.height
    let whole = i64(floor(height / lh))
    let rest = height - f32(whole) * lh
    var back = whole - 1
    var last_shift: f32 = 0.0
    if rest > 0.001 {
        back = whole
        last_shift = lh - rest
    }
    if back < 0 {
        back = 0
    }
    let last = area_walk(src, count, area_bottom_line(src, count), -back)
    if last.short {
        last_shift = 0.0
    }
    if first > last.line || (first == last.line && shift > last_shift) {
        first = last.line
        shift = last_shift
    }
    a.first = first
    a.shift = shift
}

fn area_scroll_by(a: *AreaState, src: LineSource, count: i64, dy: f32) {
    let lh = a.line_height
    if lh <= 0.0 {
        return
    }
    let moved = a.shift + dy
    let whole = i64(floor(moved / lh))
    let walked = area_walk(src, count, area_visible_near(src, count, a.first), whole)
    a.first = walked.line
    a.shift = moved - f32(whole) * lh
    if walked.short && whole < 0 {
        a.shift = 0.0
    }
    area_clamp_scroll(a, src, count)
}

fn area_scroll_reach(a: *AreaState, src: LineSource, count: i64) -> geometry.Point {
    geometry.point(larger(a.widest - (a.content.width - 1.0), 0.0), larger(f32(area_rows_before(src, count)) * a.line_height - a.content.height, 0.0))
}

fn area_scroll_set(a: *AreaState, src: LineSource, count: i64, vertical: bool, target: f32) {
    if !vertical {
        a.scroll_x = target
        return
    }
    let lh = a.line_height
    if lh <= 0.0 {
        return
    }
    let whole = i64(floor(target / lh))
    a.first = area_row_line(src, count, whole)
    a.shift = target - f32(whole) * lh
    area_clamp_scroll(a, src, count)
}

fn area_report_scroll(st: *State, a: *AreaState, src: LineSource, at: i64, count: i64) {
    let reach = area_scroll_reach(a, src, count)
    st.hitboxes[at].offset = geometry.point(a.scroll_x, f32(area_rows_before(src, a.first)) * a.line_height + a.shift)
    st.hitboxes[at].scroll_max = reach
    record_scroll_metrics(st, st.hitboxes[at].key, geometry.extent(a.content), reach)
}

fn area_reveal_line(a: *AreaState, src: LineSource, line: i64, count: i64) {
    let lh = a.line_height
    if lh <= 0.0 {
        return
    }
    let target = area_visible_near(src, count, line)
    if target < a.first || (target == a.first && a.shift > 0.0) {
        a.first = target
        a.shift = 0.0
        return
    }
    let height = a.content.height
    let whole = i64(floor(height / lh))
    let seen = area_rows_between(src, a.first, target)
    let bottom = f32(seen + 1) * lh - a.shift
    if bottom <= height + 0.001 {
        return
    }
    let rest = height - f32(whole) * lh
    var above = whole - 1
    var shift: f32 = 0.0
    if rest > 0.001 {
        above = whole
        shift = lh - rest
    }
    if above < 0 {
        above = 0
        shift = 0.0
    }
    let walked = area_walk(src, count, target, -above)
    if walked.short {
        shift = 0.0
    }
    a.first = walked.line
    a.shift = shift
    area_clamp_scroll(a, src, count)
}

fn area_cells(s: str, from: i64, size: i64) -> i64 {
    var at = from
    for c in s {
        if c == tab_code {
            at += size - at % size
        } else {
            at += 1
        }
    }
    at
}

fn area_expand(s: str, from: i64, size: i64) -> str {
    var found = false
    for i in 0..s.len {
        if s[i] == '\t' {
            found = true
        }
    }
    if !found {
        return s
    }
    var out = builder.builder()
    var at = from
    for c in s {
        if c == tab_code {
            let width = size - at % size
            for _ in 0..width {
                builder.write_byte(mut out, ' ')
            }
            at += width
        } else {
            builder.write_char(mut out, c)
            at += 1
        }
    }
    builder.to_str(out)
}

fn area_piece(st: *State, mut sh: AreaShaped, style: uitext.Style, start: i64, stop: i64, color: geometry.Color?) {
    let part = sh.text[start..stop]
    let expanded = area_expand(part, sh.cells, sh.tab)
    let l = uitext.wrap(mut st.shared.text, expanded, style, layout.unbounded)
    sh.pieces.push(AreaPiece { start, end: stop, layout: l, x: sh.width, color, cell: sh.cells })
    sh.width += l.lines[0].end
    sh.cells = area_cells(part, sh.cells, sh.tab)
}

fn area_shape(st: *State, style: uitext.Style, tab: i64, text: str, runs: TextRun[]) -> AreaShaped {
    var out = AreaShaped { text, pieces: [], width: 0.0, tab, cells: 0 }
    var at = 0
    for r in runs {
        let stop = clamped(r.end, text.len)
        let start = if r.start < at { at } else { clamped(r.start, text.len) }
        if stop <= start {
            continue
        }
        if start > at {
            area_piece(st, mut out, style, at, start, none)
        }
        var own = style
        own.weight = r.weight ?? style.weight
        area_piece(st, mut out, own, start, stop, r.color)
        at = stop
    }
    if at < text.len || out.pieces.len == 0 {
        area_piece(st, mut out, style, at, text.len, none)
    }
    out
}

fn area_x(sh: AreaShaped, at: i64) -> f32 {
    for i, p in sh.pieces {
        if at < p.end || i == sh.pieces.len - 1 {
            let inner = match at {
                < p.start => p.start
                > p.end => p.end
                _ => at
            }
            let cell = area_cells(sh.text[p.start..inner], p.cell, sh.tab) - p.cell
            return p.x + glyph_x(p.layout, cell)
        }
    }
    0.0
}

fn area_column_at(sh: AreaShaped, local: f32) -> i64 {
    var best = 0
    var best_gap = gap_between(local, 0.0)
    for p in sh.pieces {
        var at = p.start
        var cell = p.cell
        for at < p.end {
            var stop = unicode.grapheme_end(sh.text, at)
            if stop > p.end {
                stop = p.end
            }
            cell = area_cells(sh.text[at..stop], cell, sh.tab)
            at = stop
            let gap = gap_between(local, p.x + glyph_x(p.layout, cell - p.cell))
            if gap < best_gap {
                best_gap = gap
                best = at
            }
        }
    }
    best
}

fn area_row_text(a: *AreaState, text: str, composing: bool, line: i64) -> str {
    if !composing || line != a.caret.line {
        return text
    }
    let col = clamped(a.caret.column, text.len)
    "{text[..col]}{a.preedit}{text[col..]}"
}

fn area_rows(st: *State, a: *AreaState, src: LineSource, count: i64, composing: bool) -> AreaRow[] {
    var out: AreaRow[] = []
    let lh = a.line_height
    if lh <= 0.0 {
        return out
    }
    let reach = (a.content.height + a.shift) / lh
    let whole = i64(floor(reach))
    let last = if f32(whole) < reach { whole } else { whole - 1 }
    var line = a.first
    var k = 0
    for k <= last && line >= 0 {
        let stored = src.line_text(line)
        let text = area_row_text(a, stored, composing, line)
        var runs: TextRun[] = []
        if !(composing && line == a.caret.line) {
            runs = src.line_runs(line)
        }
        let shaped = area_shape(st, a.style, a.tab_size, text, runs)
        out.push(AreaRow { line, text, shaped, top: a.content.y + f32(k) * lh - a.shift })
        k += 1
        line = area_next_visible(src, count, line, 1)
    }
    out
}

fn area_selection_rect(lo: TextPosition, hi: TextPosition, line_height: f32, r: AreaRow, origin: f32, space: f32) -> geometry.Rect? {
    if r.line < lo.line || r.line > hi.line {
        return none
    }
    let from = if r.line == lo.line { clamped(lo.column, r.text.len) } else { 0 }
    let to = if r.line == hi.line { clamped(hi.column, r.text.len) } else { r.text.len }
    let left = origin + area_x(r.shaped, from)
    var right = origin + area_x(r.shaped, to)
    if r.line < hi.line {
        right += space
    }
    if right <= left {
        return none
    }
    geometry.rect(left, r.top, right - left, line_height)
}

fn area_blank(c: u32) -> bool {
    if c == space_code {
        return true
    }
    if c < no_break_space || c == line_separator || c == paragraph_separator {
        return false
    }
    unicode.is_space(c)
}

fn area_marks(st: *State, a: *AreaState, spec: BlankMarks) -> AreaMarks {
    let dot = uitext.wrap(mut st.shared.text, "·", a.style, layout.unbounded)
    let arrow = uitext.wrap(mut st.shared.text, "→", a.style, layout.unbounded)
    AreaMarks { dot, arrow, color: spec.color, caret_line: spec.caret_line }
}

fn area_mark_cell(st: *State, mut sc: scene.Scene, r: AreaRow, m: AreaMarks, p: AreaPiece, cell: i64, tab: bool, origin: f32, bounds: geometry.Rect, tint: geometry.Color, scale: f32) {
    let left = origin + p.x + glyph_x(p.layout, cell - p.cell)
    let right = origin + p.x + glyph_x(p.layout, cell + 1 - p.cell)
    if right < bounds.x || left > bounds.x + bounds.width {
        return
    }
    let mark = if tab { m.arrow } else { m.dot }
    var x = left
    if !tab {
        x = left + (right - left - mark.lines[0].end) / 2.0
    }
    uitext.paint(mut st.shared.text, mut sc, mark, geometry.point(x, r.top), tint, scale)
}

fn paint_row_marks(st: *State, mut sc: scene.Scene, r: AreaRow, m: AreaMarks, caret_line: bool, origin: f32, bounds: geometry.Rect, opacity: f32, scale: f32) {
    let tint = faded(if caret_line { m.caret_line } else { m.color }, opacity)
    for p in r.shaped.pieces {
        var cell = p.cell
        for c in r.text[p.start..p.end] {
            if c == tab_code {
                area_mark_cell(st, mut sc, r, m, p, cell, true, origin, bounds, tint, scale)
                cell += r.shaped.tab - cell % r.shaped.tab
            } else {
                if area_blank(c) {
                    area_mark_cell(st, mut sc, r, m, p, cell, false, origin, bounds, tint, scale)
                }
                cell += 1
            }
        }
    }
}

fn paint_line_fills(st: *State, mut sc: scene.Scene, src: LineSource, rows: AreaRow[], at: i64, content: geometry.Rect, lh: f32, opacity: f32, scale: f32) {
    let h = st.hitboxes[at]
    let across = geometry.inset(h.rect, h.element.style.border)
    scene.push_clip(mut sc, geometry.cover(geometry.rect(across.x, content.y, across.width, content.height), scale))
    for r in rows {
        let fill = src.line_fill(r.line)
        match fill {
            some(c) => solid(mut sc, geometry.rect(across.x, r.top, across.width, lh), faded(c, opacity), scale)
            none => {}
        }
    }
    scene.pop_clip(mut sc)
}

fn paint_text_area(st: *State, mut sc: scene.Scene, e: Element, at: i64, content: geometry.Rect, own: TextStyle, scale: f32) {
    let name = st.hitboxes[at].key
    let a = area_state(st, name)
    let src = area_source(e)
    let count = area_count(src)
    let lh = own.text.line_height
    a.style = own.text
    a.tab_size = e.tab_size
    a.content = content
    a.line_height = lh
    a.page = area_page_rows(content.height, lh)
    area_settle(a, count)
    if a.more.len > 0 && span_stop(a.more[a.more.len - 1]).line >= count {
        area_sync(a, src)
    }
    area_clamp_scroll(a, src, count)
    var target = a.reveal_at ?? a.caret
    target.line = clamped(target.line, count - 1)
    if a.reveal {
        area_reveal_line(a, src, target.line, count)
    }
    if e.read_only {
        a.preedit = ""
        a.preedit_cursor = none
    }
    let live = name == st.focus
    let composing = live && a.preedit.len > 0
    let rows = area_rows(st, a, src, count, composing)
    var widest: f32 = 0.0
    for r in rows {
        if r.shaped.width > widest {
            widest = r.shaped.width
        }
    }
    a.widest = widest
    var caret_row = -1
    var target_row = -1
    for k, r in rows {
        if r.line == a.caret.line {
            caret_row = k
        }
        if r.line == target.line {
            target_row = k
        }
    }
    var caret_x: f32 = 0.0
    if caret_row >= 0 {
        let r = rows[caret_row]
        var caret_at = clamped(a.caret.column, r.text.len)
        if composing {
            let col = clamped(a.caret.column, r.text.len - a.preedit.len)
            caret_at = col + a.preedit.len
            let inside = a.preedit_cursor
            if inside != none {
                let range = inside ?? platform.TextRange { start: 0, end: 0 }
                caret_at = col + clamped(range.end, a.preedit.len)
            }
        }
        caret_x = area_x(r.shaped, caret_at)
    }
    var target_x = caret_x
    if a.reveal_at != none && target_row >= 0 {
        let r = rows[target_row]
        target_x = area_x(r.shaped, clamped(target.column, r.text.len))
    }
    let room = content.width - 1.0
    let total = larger(widest, larger(caret_x, target_x))
    var scroll = a.scroll_x
    if scroll > total - room {
        scroll = total - room
    }
    if scroll < 0.0 {
        scroll = 0.0
    }
    if a.reveal && target_row >= 0 {
        if target_x - scroll > room {
            scroll = target_x - room
        }
        if target_x < scroll {
            scroll = target_x
        }
    }
    a.scroll_x = scroll
    a.reveal = false
    a.reveal_at = none
    let origin = content.x - scroll
    let space = uitext.measure(mut st.shared.text, " ", a.style, layout.unbounded).width
    let ink = faded(own.color, own.opacity)
    var marks: AreaMarks? = none
    match e.blank_marks {
        some(spec) => {
            marks = area_marks(st, a, spec)
        }
        none => {}
    }
    paint_line_fills(st, mut sc, src, rows, at, content, lh, own.opacity, scale)
    scene.push_clip(mut sc, geometry.cover(content, scale))
    for r in rows {
        if live && !composing {
            paint_bands(mut sc, a, r, origin, space, faded(selection_color(), own.opacity), scale)
        }
        for p in r.shaped.pieces {
            let tint = faded(p.color ?? own.color, own.opacity)
            uitext.paint(mut st.shared.text, mut sc, p.layout, geometry.point(origin + p.x, r.top), tint, scale)
        }
        match marks {
            some(m) => paint_row_marks(st, mut sc, r, m, r.line == a.caret.line, origin, content, own.opacity, scale)
            none => {}
        }
    }
    if caret_row >= 0 {
        let r = rows[caret_row]
        if composing {
            let col = clamped(a.caret.column, r.text.len - a.preedit.len)
            let left = origin + area_x(r.shaped, col)
            let right = origin + area_x(r.shaped, col + a.preedit.len)
            solid(mut sc, geometry.rect(left, r.top + lh - 1.0, right - left, 1.0), ink, scale)
        }
        if live {
            let x = snapped(origin + caret_x, scale)
            solid(mut sc, geometry.rect(x, r.top, 1.0, lh), ink, scale)
            let across = origin + caret_x >= content.x && origin + caret_x < content.x + content.width
            let down = r.top + lh > content.y && r.top < content.y + content.height
            if across && down && !e.read_only {
                st.caret = platform.Caret { x: i64(floor(origin + caret_x)), y: i64(floor(r.top)), width: 0, height: i64(floor(lh + 0.999)) }
            }
        }
    }
    if live && a.more.len > 0 {
        paint_more_carets(mut sc, a, rows, origin, ink, scale)
    }
    scene.pop_clip(mut sc)
    area_report_scroll(st, a, src, at, count)
    paint_bars(st, mut sc, at, own.opacity, scale)
}
