/// Work running on another green thread whose result the context's green thread receives.
///
/// A task is a handle: copies share it. Only the context's green thread reads or changes it.
pub struct Task {
    state: *TaskState
}

struct TaskState {
    cancelled: bool = false
    finished: bool = false
}

/// Runs `work` on a new green thread, then `done` with its result on the context's green thread before the next frame, which it makes due.
pub fn background_spawn[T](cx: Context, work: fn() -> T, done: fn(T)) -> Task {
    spawn_task(handle(cx), work, done)
}

fn spawn_task[T](h: Handle, work: fn() -> T, done: fn(T)) -> Task {
    let task = Task { state: new(TaskState {}) }
    spawn work_then_post(h, task, work, done)
    task
}

/// Runs `work` on a new green thread and sets `s` to its result on the green thread that runs the application's windows, as `background_spawn` does. The result arrives whether or not the window `s` was made in is still open.
pub fn spawn_into[T](s: Signal[T], work: fn() -> T) -> Task {
    let deliver = fn(v: T) { set(s, v) }
    spawn_task(shared_handle(s.cell.owner), work, deliver)
}

/// Stops `t` from delivering its result. The work runs on to its end, and its result is dropped.
pub fn cancel(t: Task) {
    t.state.cancelled = true
}

/// Returns `true` once `t`'s work has returned and its result has reached the context's green thread, whether or not it was cancelled.
pub fn finished(t: Task) -> bool {
    t.state.finished
}

fn work_then_post[T](h: Handle, task: Task, work: fn() -> T, done: fn(T)) {
    let result = work()
    let deliver = fn() {
        task.state.finished = true
        if !task.state.cancelled {
            done(result)
        }
    }
    post(h, deliver)
}
