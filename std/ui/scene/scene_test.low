import std/testing
import std/ui/geometry

fn quad(x: f32, y: f32, w: f32, h: f32) -> Quad {
    Quad { bounds: geometry.rect(x, y, w, h), background: geometry.rgb(0xffffff) }
}

fn shadow(x: f32, y: f32, w: f32, h: f32) -> Shadow {
    Shadow { bounds: geometry.rect(x, y, w, h), color: geometry.rgb(0x000000), sigma: 8.0 }
}

fn test_primitives_that_overlap_keep_the_order_they_were_pushed(t: *testing.T) {
    var s = empty(100, 100, geometry.rgb(0x000000))
    push_quad(mut s, quad(0.0, 0.0, 50.0, 50.0))
    push_shadow(mut s, shadow(10.0, 10.0, 20.0, 20.0))
    push_quad(mut s, quad(20.0, 20.0, 50.0, 50.0))
    let runs = batches(s)
    testing.equal(t, runs.len, 3)
    testing.is_true(t, runs[0].kind == Quads)
    testing.is_true(t, runs[1].kind == Shadows)
    testing.is_true(t, runs[2].kind == Quads)
}

fn test_a_shadow_pushed_after_a_quad_it_does_not_overlap_draws_before_it(t: *testing.T) {
    var s = empty(200, 100, geometry.rgb(0x000000))
    push_quad(mut s, quad(0.0, 0.0, 50.0, 50.0))
    push_shadow(mut s, shadow(100.0, 0.0, 50.0, 50.0))
    let runs = batches(s)
    testing.equal(t, runs.len, 2)
    testing.is_true(t, runs[0].kind == Shadows)
    testing.is_true(t, runs[1].kind == Quads)
}

fn test_primitives_that_only_touch_do_not_overlap(t: *testing.T) {
    var s = empty(200, 100, geometry.rgb(0x000000))
    push_quad(mut s, quad(0.0, 0.0, 50.0, 50.0))
    push_quad(mut s, quad(50.0, 0.0, 50.0, 50.0))
    testing.equal(t, s.quad_order[0], 1)
    testing.equal(t, s.quad_order[1], 1)
}

fn test_a_primitive_is_one_above_the_highest_it_overlaps(t: *testing.T) {
    var s = empty(200, 100, geometry.rgb(0x000000))
    push_quad(mut s, quad(0.0, 0.0, 50.0, 50.0))
    push_quad(mut s, quad(25.0, 0.0, 50.0, 50.0))
    push_quad(mut s, quad(60.0, 0.0, 50.0, 50.0))
    testing.equal(t, s.quad_order[0], 1)
    testing.equal(t, s.quad_order[1], 2)
    testing.equal(t, s.quad_order[2], 3)
}

fn test_a_lower_order_pushed_later_is_placed_before_the_higher_ones(t: *testing.T) {
    var s = empty(300, 100, geometry.rgb(0x000000))
    push_quad(mut s, quad(0.0, 0.0, 50.0, 50.0))
    push_quad(mut s, quad(25.0, 0.0, 50.0, 50.0))
    push_quad(mut s, quad(200.0, 0.0, 50.0, 50.0))
    testing.equal(t, s.quads[0].bounds.x, 0.0)
    testing.equal(t, s.quads[1].bounds.x, 200.0)
    testing.equal(t, s.quads[2].bounds.x, 25.0)
    testing.equal(t, s.quad_order[1], 1)
}

fn test_a_primitive_wholly_outside_the_clip_is_dropped(t: *testing.T) {
    var s = empty(200, 100, geometry.rgb(0x000000))
    push_clip(mut s, geometry.rect(0.0, 0.0, 50.0, 50.0))
    push_quad(mut s, quad(60.0, 0.0, 10.0, 10.0))
    push_quad(mut s, quad(50.0, 0.0, 10.0, 10.0))
    push_quad(mut s, quad(40.0, 0.0, 10.0, 10.0))
    testing.equal(t, s.quads.len, 1)
    testing.equal(t, s.quads[0].bounds.x, 40.0)
}

fn test_order_is_decided_by_the_part_inside_the_clip(t: *testing.T) {
    var s = empty(200, 100, geometry.rgb(0x000000))
    push_clip(mut s, geometry.rect(0.0, 0.0, 50.0, 50.0))
    push_quad(mut s, quad(0.0, 0.0, 100.0, 10.0))
    pop_clip(mut s)
    push_quad(mut s, quad(70.0, 0.0, 10.0, 10.0))
    testing.equal(t, s.quad_order[0], 1)
    testing.equal(t, s.quad_order[1], 1)
}

fn test_a_primitive_inside_another_is_above_it(t: *testing.T) {
    var s = empty(100, 100, geometry.rgb(0x000000))
    push_quad(mut s, quad(0.0, 0.0, 100.0, 100.0))
    push_quad(mut s, quad(10.0, 10.0, 10.0, 10.0))
    testing.equal(t, s.quad_order[0], 1)
    testing.equal(t, s.quad_order[1], 2)
}

fn test_a_primitive_spanning_cells_overlaps_one_in_a_far_cell(t: *testing.T) {
    var s = empty(1000, 1000, geometry.rgb(0x000000))
    push_quad(mut s, quad(900.0, 900.0, 50.0, 50.0))
    push_quad(mut s, quad(0.0, 0.0, 1000.0, 1000.0))
    testing.equal(t, s.quad_order[0], 1)
    testing.equal(t, s.quad_order[1], 2)
}

fn outline(x: f32, y: f32, w: f32, h: f32, width: f32) -> Quad {
    Quad { bounds: geometry.rect(x, y, w, h), border_color: geometry.rgb(0xffffff), border_widths: geometry.edges(width) }
}

fn test_a_quad_with_only_a_border_is_four_strips_around_its_interior(t: *testing.T) {
    var s = empty(100, 100, geometry.rgb(0x000000))
    push_quad(mut s, outline(10.0, 10.0, 80.0, 60.0, 2.0))
    testing.equal(t, s.quads.len, 4)
    testing.equal(t, s.quads[0].clip.height, 3.0)
    testing.equal(t, s.quads[1].clip.y, 67.0)
    testing.equal(t, s.quads[2].clip.width, 3.0)
    testing.equal(t, s.quads[3].clip.x, 87.0)
}

fn test_a_primitive_in_the_interior_of_a_border_only_quad_is_not_above_it(t: *testing.T) {
    var s = empty(100, 100, geometry.rgb(0x000000))
    push_quad(mut s, outline(10.0, 10.0, 80.0, 60.0, 2.0))
    push_shadow(mut s, shadow(20.0, 20.0, 40.0, 20.0))
    testing.equal(t, s.shadow_order[0], 1)
    testing.is_true(t, batches(s)[0].kind == Shadows)
}

fn test_a_quad_with_a_background_is_not_split(t: *testing.T) {
    var s = empty(100, 100, geometry.rgb(0x000000))
    var q = outline(10.0, 10.0, 80.0, 60.0, 2.0)
    q.background = geometry.rgb(0x000000)
    push_quad(mut s, q)
    testing.equal(t, s.quads.len, 1)
}

fn test_a_border_that_fills_the_quad_is_not_split(t: *testing.T) {
    var s = empty(100, 100, geometry.rgb(0x000000))
    push_quad(mut s, outline(10.0, 10.0, 10.0, 10.0, 6.0))
    testing.equal(t, s.quads.len, 1)
}
