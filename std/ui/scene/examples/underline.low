import std/ui/geometry
import std/ui/scene

fn describe(kind: scene.Kind) -> str {
    match kind {
        Shadows => "shadows"
        Quads => "quads"
        Underlines => "underlines"
        Sprites => "sprites"
        SubpixelSprites => "subpixel sprites"
        PolychromeSprites => "polychrome sprites"
    }
}

/// Underlines a highlighted line with a straight and a wavy underline and clips a third, then lists the batches the renderer draws.
fn main() {
    var s = scene.empty(200, 100, geometry.rgb(0xffffff))
    let line = geometry.rect(20.0, 20.0, 120.0, 20.0)

    scene.push_quad(mut s, scene.Quad { bounds: line, background: geometry.rgba(0xffff0040) })
    scene.push_underline(mut s, scene.Underline { bounds: geometry.rect(20.0, 38.0, 120.0, 2.0), color: geometry.rgb(0x000000) })
    scene.push_underline(mut s, scene.Underline {
        bounds: geometry.rect(20.0, 60.0, 120.0, 8.0)
        color: geometry.rgb(0xff0000)
        thickness: 2.0
        wavy: 1.0
    })

    scene.push_clip(mut s, geometry.rect(0.0, 0.0, 60.0, 100.0))
    scene.push_underline(mut s, scene.Underline { bounds: geometry.rect(20.0, 80.0, 120.0, 2.0), color: geometry.rgb(0x0000ff) })
    scene.pop_clip(mut s)

    print("kinds in draw order:")
    for kind in scene.kinds() {
        print("  {describe(kind)}")
    }
    print("batches:")
    for b in scene.batches(s) {
        print("  {describe(b.kind)} from {b.first}, count {b.count}")
    }
    for u in s.underlines {
        print("underline at y={u.bounds.y} clipped to x={u.clip.x} width={u.clip.width}")
    }
}
