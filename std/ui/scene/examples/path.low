import std/ui/geometry
import std/ui/scene

fn describe(kind: scene.Kind) -> str {
    match kind {
        Shadows => "shadows"
        Quads => "quads"
        Paths => "paths"
        Underlines => "underlines"
        Sprites => "sprites"
        SubpixelSprites => "subpixel sprites"
        PolychromeSprites => "polychrome sprites"
    }
}

/// Draws a triangle, a curved bulge and a stroked polyline between two quads, then lists the batches the renderer draws and each path's bounds and clip.
fn main() {
    var s = scene.empty(120, 80, geometry.rgb(0xffffff))
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(0.0, 0.0, 120.0, 80.0), background: geometry.rgb(0xeeeeee) })

    var triangle = scene.path(geometry.point(10.0, 10.0), geometry.rgb(0xff0000))
    scene.line_to(mut triangle, geometry.point(50.0, 10.0))
    scene.line_to(mut triangle, geometry.point(10.0, 50.0))
    scene.push_path(mut s, triangle)

    var bulge = scene.path(geometry.point(60.0, 50.0), geometry.rgb(0x008000))
    scene.curve_to(mut bulge, geometry.point(110.0, 50.0), geometry.point(85.0, 10.0))
    scene.push_path(mut s, bulge)

    let line = [geometry.point(10.0, 70.0), geometry.point(40.0, 56.0), geometry.point(70.0, 72.0), geometry.point(110.0, 60.0)]
    scene.push_clip(mut s, geometry.rect(0.0, 55.0, 90.0, 25.0))
    scene.push_path(mut s, scene.stroke_polyline(line, 4.0, geometry.rgb(0x000000)))
    scene.pop_clip(mut s)

    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(90.0, 0.0, 30.0, 20.0), background: geometry.rgb(0x0000ff) })

    for b in scene.batches(s) {
        print("{describe(b.kind)} from {b.first}, count {b.count}")
    }
    for p in s.paths {
        print("path of {p.vertices.len} vertices, bounds from {i64(p.bounds.x)},{i64(p.bounds.y)} spanning {i64(p.bounds.width)}x{i64(p.bounds.height)}, clip x={p.clip.x} width={p.clip.width}")
    }
}
