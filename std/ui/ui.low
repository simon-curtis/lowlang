import std/time
import std/ui/dwrite
import std/ui/geometry
import std/ui/gpu
import std/ui/platform
import std/ui/scene
import uitext = std/ui/text

/// What `open` needs to make an application window.
pub struct Options {
    /// The window title.
    pub title: str = "Low"
    /// The width of the window's content in logical pixels.
    pub width: i64 = 800
    /// The height of the window's content in logical pixels.
    pub height: i64 = 600
    /// The colour every frame is cleared to before the elements are drawn.
    pub background: geometry.Color = geometry.rgb(0xffffff)
    /// What the system draws above the content.
    pub titlebar: TitlebarOptions = TitlebarOptions {}
}

/// What the system draws above a window's content.
pub struct TitlebarOptions {
    /// `true` hides the system title bar, so the content reaches the top of the window and the program draws its own title bar and caption buttons, marking them with `window_control_area`. `std/ui` draws no caption buttons. Windows keeps the resize borders, the snap layouts, the drag and the maximised frame; the Wayland backend draws the whole window already and ignores it.
    pub appears_transparent: bool = false
}

/// Why an application could not open its window or draw into it.
pub enum Error {
    /// The window could not be opened or serviced.
    Platform(platform.Error)
    /// The GPU could not be opened or could not draw.
    Gpu(gpu.Error)
}

/// A window, the GPU that draws into it and the context of its user interface.
///
/// Releasing an `App` releases the GPU, then the window.
pub struct App {
    gpu: gpu.Gpu
    window: platform.Window
    /// The context the application's signals and frames belong to.
    pub cx: Context
}

const reveal_deadline_ms = 500

/// Opens a window with `o`'s title and size and a GPU that draws into it. The window stays invisible until `run` presents its first frame, so the system never shows it before a frame has been queued for it.
pub fn open(o: Options) -> App ! Error {
    let titlebar = platform.TitlebarOptions { appears_transparent: o.titlebar.appears_transparent }
    using window = platform.open(platform.Options { title: o.title, width: o.width, height: o.height, titlebar, hidden: true }) catch Platform
    let native = platform.native(window)
    using g = gpu.open_for(gpu.Surface { display: native.display, window: native.window }) catch Gpu
    let cx = headless(o.background)
    uitext.use_system_fonts(mut cx.state.text, gpu.supports_subpixel(g) && dwrite.subpixel_enabled())
    let waker = platform.waker(window)
    let st = cx.state
    st.wake = fn() { platform.wake(waker) }
    let controls = platform.controls(window)
    st.minimize = fn() { platform.minimize(controls) }
    st.zoom = fn() { platform.toggle_maximize(controls) }
    let area_at = fn(x: f32, y: f32) -> platform.WindowControlArea? { window_control_area_at(cx, x, y) }
    platform.set_hit_test(window, area_at)
    st.clock = fn() -> i64 { time.monotonic() / 1000000 }
    let clip = platform.clipboard(window)
    st.copy = fn(s: str) {
        st.memory = s
        platform.write_clipboard(clip, s) or {}
    }
    st.paste = fn() -> str? {
        platform.read_clipboard(clip) catch {
            e => st.memory
        }
    }
    App { gpu: g, window, cx }
}

fn same_caret(a: platform.Caret?, b: platform.Caret?) -> bool {
    if a == none || b == none {
        return a == none && b == none
    }
    let x = a ?? platform.Caret {}
    let y = b ?? platform.Caret {}
    x.x == y.x && x.y == y.y && x.width == y.width && x.height == y.height
}

fn sync_window(app: App) {
    let st = app.cx.state
    if !same_caret(st.caret, st.applied_caret) {
        platform.set_text_input(app.window, st.caret)
        st.applied_caret = st.caret
    }
    let shape = pointer_cursor(app.cx)
    if shape != st.applied_cursor {
        platform.set_cursor(app.window, shape)
        st.applied_cursor = shape
    }
}

fn reveal(app: App) {
    let st = app.cx.state
    if !st.revealed {
        st.revealed = true
        platform.show(app.window)
    }
}

fn reveal_wait(st: *State, wait: i64, deadline: i64) -> i64 {
    if st.revealed {
        return wait
    }
    let left = deadline - now_ms(st)
    let remaining = if left < 0 { 0 } else { left }
    if wait < 0 || remaining < wait { remaining } else { wait }
}

/// Runs the window until it is closed: waits for events, dispatches them, and when a frame is due builds the tree `render` returns, lays it out, paints it and presents it.
///
/// The window becomes visible once the first `present` returns without error, even when that call had nothing to present because the swapchain has no area. A window with no frame to draw, such as one with no area, becomes visible 500 milliseconds after `run` starts, so it never stays hidden. A first `present` that fails ends `run` with the error and leaves the window hidden.
pub fn run(app: App, render: fn() -> Element) ! Error {
    let st = app.cx.state
    let deadline = now_ms(st) + reveal_deadline_ms
    for !st.closed {
        let drawable = st.dirty && st.width > 0.0 && st.height > 0.0
        let wait = if drawable { 0 } else { reveal_wait(st, wait_ms(st), deadline) }
        let events = platform.next(app.window, wait) catch Platform
        for e in events {
            dispatch(app.cx, e)
        }
        drain(st)
        fire_timers(st)
        if st.dirty && !st.closed && st.width > 0.0 && st.height > 0.0 {
            let size = geometry.size(st.width, st.height)
            let sc = frame(app.cx, render, size, st.scale)
            gpu.present(app.gpu, sc, mut st.text.atlas) catch Gpu
            reveal(app)
        }
        if now_ms(st) >= deadline {
            reveal(app)
        }
        sync_window(app)
    }
}

/// Draws `s`, a scene that `frame` returned for `cx`, into the offscreen target `t`, uploading the glyphs it needs.
pub fn draw(cx: Context, g: gpu.Gpu, t: gpu.Target, s: scene.Scene) ! gpu.Error {
    gpu.render(g, t, s, mut cx.state.text.atlas)?
}

/// Returns the opaque colour written as `0xRRGGBB`.
pub fn rgb(hex: u32) -> geometry.Color {
    geometry.rgb(hex)
}

/// Returns the colour written as `0xRRGGBBAA`.
pub fn rgba(hex: u32) -> geometry.Color {
    geometry.rgba(hex)
}
