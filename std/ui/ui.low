import std/time
import std/ui/dwrite
import std/ui/geometry
import std/ui/gpu
import std/ui/platform
import std/ui/scene
import uitext = std/ui/text

/// What `open` needs to make an application window.
pub struct Options {
    /// The window title.
    pub title: str = "Low"
    /// The width of the window's content in logical pixels.
    pub width: i64 = 800
    /// The height of the window's content in logical pixels.
    pub height: i64 = 600
    /// The colour every frame is cleared to before the elements are drawn.
    pub background: geometry.Color = geometry.rgb(0xffffff)
    /// What the system draws above the content.
    pub titlebar: TitlebarOptions = TitlebarOptions {}
    /// `false` shows the window without activating it, so it takes neither the keyboard focus nor the foreground from the program the user is working in. See `platform.Options.activate`.
    pub activate: bool = true
    /// The colour of the window's one-pixel border, and `none` keeps the system's. Its alpha is ignored. See `platform.Options.border`.
    pub border: geometry.Color? = none
    /// The frames of the window's icon, and `none` keeps the system's. See `set_window_icon`. On Windows the window has the icon before it is first shown, and frames that cannot make an icon leave the system's, so a program that must know calls `set_window_icon` after `open`. The Wayland backend ignores it.
    pub icon: IconFrame[]? = none
}

/// What the system draws above a window's content.
pub struct TitlebarOptions {
    /// `true` hides the system title bar, so the content reaches the top of the window and the program draws its own title bar and caption buttons, marking them with `window_control_area`. `std/ui` draws no caption buttons. Windows keeps the resize borders, the snap layouts, the drag and the maximised frame; the Wayland backend draws the whole window already and ignores it.
    pub appears_transparent: bool = false
}

/// Why an application could not open its window or draw into it.
pub enum Error {
    /// The window could not be opened or serviced.
    Platform(platform.Error)
    /// The GPU could not be opened or could not draw.
    Gpu(gpu.Error)
}

/// The application's windows, the GPU that draws into them and the context of the user interface.
///
/// Releasing an `App` closes every window it still has, further windows before the main one and owned windows before their owners, then releases the GPU and the connection to the windowing system.
pub struct App {
    /// The context the application's signals and frames belong to.
    pub cx: Context
    device: gpu.Device
    connection: Connection
    drop close_all(cx.state.shared)
}

const reveal_deadline_ms = 500

/// How glyphs of the installed fonts are rasterised.
pub enum TextSmoothing {
    /// Subpixel when the GPU can blend it and the system draws with ClearType, greyscale otherwise.
    System
    /// One coverage value per colour stripe of a pixel, when the GPU can blend it; greyscale otherwise.
    Subpixel
    /// One coverage value per pixel.
    Greyscale
}

/// Switches how glyphs are rasterised from the next frame on, and clears the cached glyphs. It applies to every window of the application, which becomes due for a frame. A headless context and a platform that draws with the built-in fonts keep their glyphs.
pub fn set_text_smoothing(cx: Context, mode: TextSmoothing) {
    let sh = cx.state.shared
    let subpixel = match mode {
        System => sh.subpixel_capable && dwrite.subpixel_enabled()
        Subpixel => sh.subpixel_capable
        Greyscale => false
    }
    uitext.set_subpixel(mut sh.text, subpixel)
    sh.generation += 1
}

/// Opens a window with `o`'s title and size and a GPU that draws into it. The window stays invisible until `run` presents its first frame, so the system never shows it before a frame has been queued for it. `open_window` opens further windows in the same application.
pub fn open(o: Options) -> App ! Error {
    using connection = connect() catch Platform
    let titlebar = platform.TitlebarOptions { appears_transparent: o.titlebar.appears_transparent }
    let first_options = platform.Options { title: o.title, width: o.width, height: o.height, titlebar, hidden: true, activate: o.activate, border: platform_border(o.border), icon: platform_icon(o.icon) }
    using var window = open_first(connection, first_options) catch Platform
    let first = window.handle
    let surface = surface_of(first)
    using device = gpu.open_device(surface) catch Gpu
    let view = device.handle
    using var presenter = gpu.presenter_on(view, surface) catch Gpu
    let link = link_of(connection, first)
    let cx = headless(o.background)
    let st = cx.state
    let sh = st.shared
    st.title = o.title
    let main = main_window(cx)
    let seat = Seat { window: platform.detach(mut window), presenter: gpu.detach_presenter(mut presenter) }
    main.slot.seat = some(seat)
    sh.open = fn(shared: *Shared, w: WindowOptions) -> Opened ! Error { open_beside_window(shared, link, view, w)? }
    sh.subpixel_capable = gpu.supports_subpixel_on(view)
    uitext.use_system_fonts(mut sh.text, sh.subpixel_capable && dwrite.subpixel_enabled())
    let waker = waker_of_link(link)
    sh.wake = fn() { platform.wake(waker) }
    sh.wait = fn(timeout_ms: i64) ! platform.Error { wait_link(link, timeout_ms)? }
    sh.events = fn(w: platform.WindowHandle) -> platform.Event[] ! platform.Error { events_link(link, w)? }
    bind_window(cx, first)
    sh.clock = fn() -> i64 { time.monotonic() / 1000000 }
    sh.system_motion = platform.prefers_reduced_motion
    let clip = platform.clipboard_on(first)
    sh.copy = fn(s: str) {
        sh.memory = s
        platform.write_clipboard(clip, s) or {}
    }
    sh.paste = fn() -> str? {
        platform.read_clipboard(clip) catch {
            e => sh.memory
        }
    }
    App { cx, device, connection }
}

fn surface_of(w: platform.WindowHandle) -> gpu.Surface {
    let native = platform.native_on(w)
    gpu.Surface { display: native.display, window: native.window }
}

fn bind_window(cx: Context, handle: platform.WindowHandle) {
    let st = cx.state
    let controls = platform.controls_on(handle)
    st.minimize = fn() { platform.minimize(controls) }
    st.zoom = fn() { platform.toggle_maximize(controls) }
    let area_at = fn(x: f32, y: f32) -> platform.WindowControlArea? { window_control_area_at(cx, x, y) }
    platform.set_hit_test_on(handle, area_at)
}

fn platform_placement(p: Placement) -> platform.Placement {
    match p {
        System => platform.Placement.System
        CentreOnOwner => platform.Placement.CentreOnOwner
        CentreOnScreen => platform.Placement.CentreOnScreen
    }
}

fn owner_handle(o: WindowOptions) -> platform.WindowHandle? {
    let owner = o.owner ?? return none
    let seat = owner.slot.seat ?? return none
    some(seat.window)
}

fn platform_options(o: WindowOptions) -> platform.Options {
    platform.Options {
        title: o.title
        width: o.width
        height: o.height
        titlebar: platform.TitlebarOptions { appears_transparent: o.titlebar.appears_transparent }
        hidden: true
        min_width: o.min_width
        min_height: o.min_height
        owner: owner_handle(o)
        placement: platform_placement(o.placement)
        activate: o.activate
        taskbar: o.taskbar
        border: platform_border(o.border)
        icon: platform_icon(o.icon)
    }
}

fn platform_icon(frames: IconFrame[]?) -> platform.IconFrame[]? {
    let given = frames ?? return none
    some(platform_frames(given))
}

fn platform_frames(frames: IconFrame[]) -> platform.IconFrame[] {
    var out: platform.IconFrame[] = []
    for frame in frames {
        out.push(platform.IconFrame { size: frame.size, png: frame.png })
    }
    out
}

fn platform_border(border: geometry.Color?) -> u32? {
    let c = border ?? return none
    some(geometry.rgb_of(c))
}

fn open_beside_window(sh: *Shared, link: Link, device: gpu.DeviceHandle, o: WindowOptions) -> Opened ! Error {
    let options = platform_options(o)
    using var window = open_beside(link, options) catch Platform
    let handle = window.handle
    let surface = surface_of(handle)
    using var presenter = gpu.presenter_on(device, surface) catch Gpu
    let st = new_state(sh, o.background)
    st.title = o.title
    bind_window(Context { state: st }, handle)
    let seat = Seat { window: platform.detach(mut window), presenter: gpu.detach_presenter(mut presenter) }
    Opened { state: st, seat: some(seat) }
}

fn same_caret(a: platform.Caret?, b: platform.Caret?) -> bool {
    if a == none || b == none {
        return a == none && b == none
    }
    let x = a ?? platform.Caret {}
    let y = b ?? platform.Caret {}
    x.x == y.x && x.y == y.y && x.width == y.width && x.height == y.height
}

fn sync_window(w: Window) {
    let seat = w.slot.seat ?? return
    let cx = window_context(w)
    let st = cx.state
    if !same_caret(st.caret, st.applied_caret) {
        platform.set_text_input_on(seat.window, st.caret)
        st.applied_caret = st.caret
    }
    let shape = pointer_cursor(cx)
    if shape != st.applied_cursor {
        platform.set_cursor_on(seat.window, shape)
        st.applied_cursor = shape
    }
}

fn reveal(w: Window) {
    let st = w.slot.state
    let seat = w.slot.seat ?? return
    if !st.revealed {
        st.revealed = true
        platform.show_on(seat.window)
    }
}

fn reveal_wait(st: *State, wait: i64, deadline: i64) -> i64 {
    if st.revealed {
        return wait
    }
    let left = deadline - now_ms(st)
    let remaining = if left < 0 { 0 } else { left }
    if wait < 0 || remaining < wait { remaining } else { wait }
}

fn shortest(a: i64, b: i64) -> i64 {
    if a < 0 {
        return b
    }
    if b < 0 {
        return a
    }
    if a < b { a } else { b }
}

fn wait_for(windows: Window[]) -> i64 {
    var wait: i64 = -1
    for w in windows {
        let st = w.slot.state
        let drawable = due(st) && st.width > 0.0 && st.height > 0.0
        let each = if drawable { 0 } else { reveal_wait(st, wait_ms(st), w.slot.deadline) }
        wait = shortest(wait, each)
    }
    wait
}

fn fail_window(w: Window, e: Error) ! Error {
    if is_main(w) {
        fail e
    }
    close_with(w, CloseReason.Failed(e))
}

fn receive(sh: *Shared, w: Window) ! Error {
    let seat = w.slot.seat ?? return
    let events = sh.events(seat.window) catch Platform
    let cx = window_context(w)
    for e in events {
        dispatch(cx, e)
    }
}

fn present_window(sh: *Shared, w: Window) ! Error {
    let slot = w.slot
    let st = slot.state
    let seat = slot.seat ?? return
    let cx = window_context(w)
    if !due(st) || closed(cx) || st.width <= 0.0 || st.height <= 0.0 {
        return
    }
    let size = geometry.size(st.width, st.height)
    let sc = frame(cx, slot.render, size, st.scale)
    gpu.present_to_on(seat.presenter, sc, mut sh.text.atlas) catch Gpu
    reveal(w)
}

fn serve(sh: *Shared, w: Window) ! Error {
    if !w.slot.open {
        return
    }
    present_window(sh, w) catch {
        e => {
            fail_window(w, e)?
            return
        }
    }
    if now_ms(w.slot.state) >= w.slot.deadline {
        reveal(w)
    }
    sync_window(w)
}

/// Runs the application until its main window is closed or `quit` is called: waits for events, dispatches them to the window they are for, and when a window has a frame due builds the tree its render function returns, lays it out, paints it and presents it. `render` builds the main window's tree; `open_window` gives each further window its own.
///
/// A window becomes visible once its first `present` returns without error, even when that call had nothing to present because the swapchain has no area. A window with no frame to draw, such as one with no area, becomes visible 500 milliseconds after it opened or after `run` started, whichever is later, so it never stays hidden. A first `present` that fails on the main window ends `run` with the error and leaves the window hidden. On a further window it closes that window and passes the error to its `closed` callback as `Failed`, and the other windows keep running; so does an error that servicing its events returns. A `CloseRequested` event closes a further window, as `close_window` does, and ends `run` on the main window. Before `run` returns, whether by closing or by error, it closes every further window, owned windows before their owners, and runs each one's `closed` callback.
pub fn run(app: App, render: fn() -> Element) ! Error {
    let cx = app.cx
    let sh = cx.state.shared
    let main = main_window(cx)
    main.slot.render = render
    let started = now_ms(cx.state)
    for w in open_windows(sh) {
        w.slot.deadline = started + reveal_deadline_ms
    }
    defer close_tools(sh)
    for !closed(cx) {
        let windows = open_windows(sh)
        sh.wait(wait_for(windows)) catch Platform
        for w in windows {
            if w.slot.open {
                receive(sh, w) catch {
                    e => fail_window(w, e)?
                }
            }
        }
        drain(sh)
        for w in windows {
            if w.slot.open {
                fire_timers(w.slot.state)
            }
        }
        for w in windows {
            serve(sh, w)?
        }
    }
}

/// Draws `s`, a scene that `frame` returned for `cx`, into the offscreen target `t`, uploading the glyphs it needs.
pub fn draw(cx: Context, g: gpu.Gpu, t: gpu.Target, s: scene.Scene) ! gpu.Error {
    gpu.render(g, t, s, mut cx.state.shared.text.atlas)?
}

/// Returns the opaque colour written as `0xRRGGBB`.
pub fn rgb(hex: u32) -> geometry.Color {
    geometry.rgb(hex)
}

/// Returns the colour written as `0xRRGGBBAA`.
pub fn rgba(hex: u32) -> geometry.Color {
    geometry.rgba(hex)
}
