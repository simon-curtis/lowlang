import std/ui/platform

/// Stops the pointer event being dispatched from reaching the handlers of elements further out, as gpui's `stop_propagation` does. A mouse down, mouse up or mouse move handler calls it; outside one it does nothing.
pub fn stop_propagation(cx: Context) {
    cx.state.stopped = true
}

fn hold_button(st: *State, b: platform.Button) {
    drop_button(st, b)
    st.buttons.push(b)
}

fn drop_button(st: *State, b: platform.Button) {
    var kept: platform.Button[] = []
    for held in st.buttons {
        if held != b {
            kept.push(held)
        }
    }
    st.buttons = kept
}

fn pressed_button(st: *State) -> platform.Button? {
    if st.buttons.len == 0 {
        return none
    }
    st.buttons[st.buttons.len - 1]
}

fn matches(wanted: platform.Button?, b: platform.Button) -> bool {
    match wanted {
        some(w) => w == b
        none => true
    }
}

fn run_mouse_down(st: *State, event: MouseDownEvent) {
    st.stopped = false
    for i, h in st.hitboxes {
        if !st.inside[i] {
            run_down_out(h.element, event)
        }
    }
    var i = topmost(st)
    for i >= 0 && !st.stopped {
        let h = st.hitboxes[i]
        run_downs(h.element, event)
        i = ancestor_hit(st, h.parent)
    }
    st.stopped = false
}

fn run_down_out(e: Element, event: MouseDownEvent) {
    for l in e.listeners {
        match l {
            MouseDownOut(f) => f(event)
            _ => {}
        }
    }
}

fn run_downs(e: Element, event: MouseDownEvent) {
    for l in e.listeners {
        match l {
            MouseDown(button, f) => {
                if matches(button, event.button) {
                    f(event)
                }
            }
            _ => {}
        }
    }
}

fn run_mouse_up(st: *State, event: MouseUpEvent) {
    st.stopped = false
    for i, h in st.hitboxes {
        if !st.hits[i] {
            run_up_out(h.element, event)
        }
    }
    var i = topmost(st)
    for i >= 0 && !st.stopped {
        let h = st.hitboxes[i]
        run_ups(h.element, event)
        i = ancestor_hit(st, h.parent)
    }
    st.stopped = false
}

fn run_up_out(e: Element, event: MouseUpEvent) {
    for l in e.listeners {
        match l {
            MouseUpOut(button, f) => {
                if matches(button, event.button) {
                    f(event)
                }
            }
            _ => {}
        }
    }
}

fn run_ups(e: Element, event: MouseUpEvent) {
    for l in e.listeners {
        match l {
            MouseUp(button, f) => {
                if matches(button, event.button) {
                    f(event)
                }
            }
            _ => {}
        }
    }
}

fn mouse_move(st: *State) {
    let event = MouseMoveEvent { position: st.pointer, pressed_button: pressed_button(st), modifiers: st.modifiers }
    st.stopped = false
    var i = topmost(st)
    for i >= 0 && !st.stopped {
        let h = st.hitboxes[i]
        run_moves(h.element, event)
        i = ancestor_hit(st, h.parent)
    }
    st.stopped = false
}

fn run_moves(e: Element, event: MouseMoveEvent) {
    for l in e.listeners {
        match l {
            MouseMove(f) => f(event)
            _ => {}
        }
    }
}
