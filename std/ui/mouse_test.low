import std/testing
import std/ui/layout
import std/ui/platform
import uitext = std/ui/text

fn button_down(cx: Context, b: platform.Button, x: f32, y: f32, clicks: i64) {
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: b, x, y, clicks }))
}

fn button_up(cx: Context, b: platform.Button, x: f32, y: f32, clicks: i64) {
    dispatch(cx, platform.Event.PointerUp(platform.ButtonEvent { button: b, x, y, clicks }))
}

fn left_click(cx: Context, x: f32, y: f32, clicks: i64) {
    button_down(cx, platform.Button.Left, x, y, clicks)
    button_up(cx, platform.Button.Left, x, y, clicks)
}

fn log_of(cx: Context) -> Signal[str[]] {
    let empty: str[] = []
    signal(cx, empty)
}

fn note(log: Signal[str[]], s: str) {
    var lines = get(log)[0..]
    lines.push(s)
    set(log, lines)
}

fn joined(lines: str[]) -> str {
    var out = ""
    for line in lines {
        out = "{out}{line}\n"
    }
    out
}

fn button_text(b: platform.Button) -> str {
    match b {
        Left => "left"
        Right => "right"
        Middle => "middle"
        Navigate(direction) => {
            match direction {
                Back => "back"
                Forward => "forward"
            }
        }
        Other(code) => "other{code}"
    }
}

fn test_mouse_down_runs_only_for_its_button(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        div().size(50.0, 50.0)
            .on_mouse_down(platform.Button.Right, fn(e: MouseDownEvent) { note(log, "right down {e.position.x} {e.position.y}") })
            .on_mouse_up(platform.Button.Right, fn(e: MouseUpEvent) { note(log, "right up") })
            .on_mouse_down(platform.Button.Middle, fn(e: MouseDownEvent) { note(log, "middle down") })
            .on_mouse_down(platform.Button.Navigate(platform.NavigationDirection.Back), fn(e: MouseDownEvent) { note(log, "back down") })
    }
    frame(cx, view, window(), 1.0)
    button_down(cx, platform.Button.Left, 10.0, 12.0, 1)
    button_up(cx, platform.Button.Left, 10.0, 12.0, 1)
    button_down(cx, platform.Button.Right, 10.0, 12.0, 1)
    button_up(cx, platform.Button.Right, 10.0, 12.0, 1)
    button_down(cx, platform.Button.Middle, 10.0, 12.0, 1)
    button_down(cx, platform.Button.Navigate(platform.NavigationDirection.Forward), 10.0, 12.0, 1)
    button_down(cx, platform.Button.Navigate(platform.NavigationDirection.Back), 10.0, 12.0, 1)
    button_down(cx, platform.Button.Right, 80.0, 80.0, 1)
    testing.equal(t, joined(get(log)), joined(["right down 10 12", "right up", "middle down", "back down"]))
}

fn test_any_mouse_down_sees_every_button_and_its_modifiers(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        div().size(50.0, 50.0).on_any_mouse_down(fn(e: MouseDownEvent) { note(log, "{button_text(e.button)} {e.click_count} {e.modifiers.control}") })
    }
    frame(cx, view, window(), 1.0)
    button_down(cx, platform.Button.Left, 10.0, 10.0, 1)
    button_down(cx, platform.Button.Right, 10.0, 10.0, 2)
    dispatch(cx, platform.Event.PointerDown(platform.ButtonEvent { button: platform.Button.Middle, x: 10.0, y: 10.0, modifiers: platform.Modifiers { control: true } }))
    testing.equal(t, joined(get(log)), joined(["left 1 false", "right 2 false", "middle 1 true"]))
}

fn test_mouse_down_bubbles_outward_until_stopped(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let stop = signal(cx, false)
    let inner = fn(e: MouseDownEvent) {
        note(log, "inner")
        if get(stop) {
            stop_propagation(cx)
        }
    }
    let view = fn() -> Element {
        let child = div().size(40.0, 40.0).on_any_mouse_down(inner)
        div().size(100.0, 100.0).on_any_mouse_down(fn(e: MouseDownEvent) { note(log, "outer") }).child(child)
    }
    frame(cx, view, window(), 1.0)
    button_down(cx, platform.Button.Right, 10.0, 10.0, 1)
    testing.equal(t, joined(get(log)), joined(["inner", "outer"]))
    set(stop, true)
    button_down(cx, platform.Button.Right, 10.0, 10.0, 1)
    testing.equal(t, joined(get(log)), joined(["inner", "outer", "inner"]))
    button_down(cx, platform.Button.Right, 60.0, 60.0, 1)
    testing.equal(t, joined(get(log)), joined(["inner", "outer", "inner", "outer"]))
}

fn test_down_out_and_up_out_run_for_presses_elsewhere(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        div().column().size(200.0, 200.0).children() {
            div().size(40.0, 40.0)
                .on_mouse_down_out(fn(e: MouseDownEvent) { note(log, "down out {button_text(e.button)}") })
                .on_mouse_up_out(platform.Button.Left, fn(e: MouseUpEvent) { note(log, "up out") }),
            div().size(40.0, 40.0).on_any_mouse_down(fn(e: MouseDownEvent) { note(log, "down on second") }),
        }
    }
    frame(cx, view, window(), 1.0)
    left_click(cx, 10.0, 10.0, 1)
    testing.equal(t, get(log).len, 0)
    left_click(cx, 10.0, 50.0, 1)
    testing.equal(t, joined(get(log)), joined(["down out left", "down on second", "up out"]))
    button_down(cx, platform.Button.Right, 150.0, 150.0, 1)
    button_up(cx, platform.Button.Right, 150.0, 150.0, 1)
    testing.equal(t, joined(get(log)), joined(["down out left", "down on second", "up out", "down out right"]))
}

fn test_click_reports_the_click_count_of_the_release(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        div().size(50.0, 50.0).on_click(fn(e: ClickEvent) { note(log, "{e.click_count} {e.keyboard} {e.position.x} {e.position.y}") })
    }
    frame(cx, view, window(), 1.0)
    left_click(cx, 10.0, 20.0, 1)
    left_click(cx, 10.0, 20.0, 2)
    left_click(cx, 11.0, 20.0, 3)
    testing.equal(t, joined(get(log)), joined(["1 false 10 20", "2 false 10 20", "3 false 11 20"]))
}

fn test_a_keyboard_click_is_marked_and_placed_at_the_bottom_left(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        div().padding(10.0).child(div().id("b").size(30.0, 20.0).focusable().on_click(fn(e: ClickEvent) { note(log, "{e.click_count} {e.keyboard} {e.position.x} {e.position.y}") }))
    }
    frame(cx, view, window(), 1.0)
    set_focus(cx, "b")
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Enter) }))
    testing.equal(t, joined(get(log)), joined(["1 true 10 30"]))
}

fn test_right_and_middle_presses_neither_click_nor_activate(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let view = fn() -> Element {
        div().size(50.0, 50.0)
            .on_click(fn(e: ClickEvent) { note(log, "click") })
            .active(fn(v: Visual) -> Visual { v.with_background(rgb(0xff0000)) })
    }
    frame(cx, view, window(), 1.0)
    button_down(cx, platform.Button.Right, 10.0, 10.0, 1)
    let held = frame(cx, view, window(), 1.0)
    testing.equal(t, held.quads.len, 0)
    button_up(cx, platform.Button.Right, 10.0, 10.0, 1)
    button_down(cx, platform.Button.Middle, 10.0, 10.0, 1)
    button_up(cx, platform.Button.Middle, 10.0, 10.0, 1)
    testing.equal(t, get(log).len, 0)
}

fn test_mouse_move_reports_the_held_button(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let log = log_of(cx)
    let moved = fn(e: MouseMoveEvent) {
        let held = match e.pressed_button {
            some(b) => button_text(b)
            none => "none"
        }
        note(log, "{e.position.x} {held}")
    }
    let view = fn() -> Element { div().size(50.0, 50.0).on_mouse_move(moved) }
    frame(cx, view, window(), 1.0)
    dispatch(cx, platform.Event.PointerMoved(5.0, 5.0))
    dispatch(cx, platform.Event.PointerMoved(5.0, 5.0))
    button_down(cx, platform.Button.Right, 6.0, 5.0, 1)
    dispatch(cx, platform.Event.PointerMoved(7.0, 5.0))
    button_up(cx, platform.Button.Right, 7.0, 5.0, 1)
    dispatch(cx, platform.Event.PointerMoved(8.0, 5.0))
    dispatch(cx, platform.Event.PointerMoved(80.0, 5.0))
    testing.equal(t, joined(get(log)), joined(["5 none", "7 right", "8 none"]))
}

fn test_a_double_click_selects_a_word_and_a_triple_click_the_field(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let text = signal(cx, "hello brave world")
    let view = fn() -> Element {
        field(get(text)).id("f").width(300.0).on_change(fn(s: str) { set(text, s) })
    }
    frame(cx, view, window(), 1.0)
    let x = field_x(cx, "hello brave world", 8)
    left_click(cx, x, 8.0, 1)
    left_click(cx, x, 8.0, 2)
    frame(cx, view, window(), 1.0)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("X"), text: "X" }))
    testing.equal(t, get(text), "hello X world")
    frame(cx, view, window(), 1.0)
    left_click(cx, x, 8.0, 3)
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("Y"), text: "Y" }))
    testing.equal(t, get(text), "Y")
}

fn field_x(cx: Context, s: str, at: i64) -> f32 {
    let fs = field_state(cx.state, "f")
    fs.origin + x_of(uitext.wrap(mut cx.state.shared.text, s, fs.style, layout.unbounded), s, at)
}
