import std/file
import std/image
import std/io
import uitext = std/ui/text

fn png_rgba(data: u8[]) -> image.Image ! io.Error {
    image.convert(image.decode_png(data)?, Rgba8)
}

/// Decodes the PNG in `data` and keeps its pixels in the context as `add_image` does, returning the picture for `image`.
///
/// Every PNG color type, bit depth and interlacing is accepted. Palette, gray and 16-bit samples are widened or rounded to 8-bit red, green, blue and alpha, with straight alpha, and a `tRNS` chunk becomes alpha. Gamma, chromaticity and color profile chunks are ignored, so a picture is drawn with its samples as stored.
///
/// Fails as `image.decode_png` does.
pub fn add_png(cx: Context, data: u8[]) -> uitext.Image ! io.Error {
    let rgba = png_rgba(data)?
    match add_image(cx, rgba.width, rgba.height, rgba.pixels) {
        some(picture) => picture
        none => fail Invalid
    }
}

/// Reads the file at `path` and keeps it in the context as `add_png` does.
///
/// Fails as `file.read_file` and `add_png` do.
pub fn add_png_file(cx: Context, path: str) -> uitext.Image ! io.Error {
    add_png(cx, file.read_file(path)?)?
}
