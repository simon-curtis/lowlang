import std/atspi
import std/dbus
import std/net
import std/testing

const access_guid = "0123456789abcdef0123456789abcdef"
const access_window = "/org/a11y/atspi/accessible/window"

fn access_accept(h: net.ConnHandle, ready: chan[*dbus.ConnectionHandle]) {
    ready <- dbus.accept_over_handle(h, dbus.ServerAuth { guid: access_guid }) or panic("accept")
}

fn access_form(clicks: Signal[i64]) -> Element {
    div().column().size(200.0, 200.0).children() {
        text("Settings").role(Role.Heading),
        div().id("save").size(80.0, 30.0).on_click(fn(e: ClickEvent) { set(clicks, get(clicks) + 1) }).child(text("Save")),
        field("abc").id("name").width(100.0),
    }
}

fn access_ask(t: *testing.T, client: *dbus.ConnectionHandle, path: str, interface: str, member: str, args: dbus.Value[]) -> dbus.Value[] {
    let reply = dbus.call_on(client, dbus.method_call("", path, interface, member, args)) catch {
        e => {
            t.fatal("{member} on {path}: {e}")
            return []
        }
    }
    reply.body
}

fn access_children(t: *testing.T, client: *dbus.ConnectionHandle) -> str[] {
    var paths: str[] = []
    let body = access_ask(t, client, access_window, "org.a11y.atspi.Accessible", "GetChildren", [])
    for item in dbus.array_of(body[0]) or [] {
        let fields = dbus.fields_of(item) or []
        paths.push(dbus.string_of(fields[1]) or "?")
    }
    paths
}

fn access_name(t: *testing.T, client: *dbus.ConnectionHandle, path: str) -> str {
    let name = dbus.get_property_on(client, "", path, "org.a11y.atspi.Accessible", "Name") or dbus.Value.String("?")
    dbus.string_of(name) or "?"
}

fn access_role(t: *testing.T, client: *dbus.ConnectionHandle, path: str) -> i64 {
    let body = access_ask(t, client, path, "org.a11y.atspi.Accessible", "GetRole", [])
    i64(dbus.uint_of(body[0]) or 0)
}

fn test_a_frame_publishes_its_elements_and_the_bridge_presses_and_focuses_them(t: *testing.T) {
    using var pair = net.socketpair() or {
        t.fatal("socket pair")
        return
    }
    let near = net.detach(mut pair.first)
    let far = net.detach(mut pair.second)
    let ready = chan[*dbus.ConnectionHandle](1)
    spawn access_accept(far, ready)
    let client = dbus.connect_over_handle(near, false) or {
        t.fatal("connect")
        return
    }
    let server = match <-ready {
        some(h) => h
        none => {
            t.fatal("the peer did not accept")
            return
        }
    }
    let cx = headless(rgb(0xffffff))
    let clicks = signal(cx, 0)
    let link = new(Attached {})
    let bridge = atspi.serve(server, "demo", notifier(cx, link)) or {
        t.fatal("serve")
        return
    }
    link.bridge = some(bridge)
    publish_after_frames(cx, bridge)
    set_title(cx, "Settings")
    shot(cx, fn() -> Element { access_form(clicks) })

    let items = access_children(t, client)
    testing.equal(t, items.len, 3)
    testing.equal(t, access_name(t, client, access_window), "Settings")
    testing.equal(t, access_name(t, client, items[0]), "Settings")
    testing.equal(t, access_role(t, client, items[0]), 83)
    testing.equal(t, access_name(t, client, items[1]), "Save")
    testing.equal(t, access_role(t, client, items[1]), 43)
    testing.equal(t, access_role(t, client, items[2]), 79)

    let typed = access_ask(t, client, items[2], "org.a11y.atspi.Text", "GetText", [dbus.Value.Int32(0), dbus.Value.Int32(-1)])
    testing.equal(t, dbus.string_of(typed[0]) or "?", "abc")
    let heading = access_ask(t, client, items[0], "org.a11y.atspi.Text", "GetText", [dbus.Value.Int32(0), dbus.Value.Int32(-1)])
    testing.equal(t, dbus.string_of(heading[0]) or "?", "Settings")

    let pressed = access_ask(t, client, items[1], "org.a11y.atspi.Action", "DoAction", [dbus.Value.Int32(0)])
    testing.equal(t, dbus.bool_of(pressed[0]) or false, true)
    let grabbed = access_ask(t, client, items[2], "org.a11y.atspi.Component", "GrabFocus", [])
    testing.equal(t, dbus.bool_of(grabbed[0]) or false, true)
    testing.equal(t, get(clicks), 0)
    shot(cx, fn() -> Element { access_form(clicks) })
    testing.equal(t, get(clicks), 1)
    testing.equal(t, focused(cx), "name")
    dbus.shutdown_on(client)
    dbus.shutdown_on(server)
}
