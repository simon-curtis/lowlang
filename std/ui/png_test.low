import std/file
import std/hash
import std/image
import std/io
import std/slices
import std/testing
import std/text

const suite = "testdata/ui_png"

fn suite_names(t: *testing.T) -> str[] {
    var names: str[] = []
    let entries = file.read_dir_info(suite) catch {
        e => {
            t.fatal("list {suite}: {e}")
            return names
        }
    }
    for entry in entries {
        if text.ends_with(entry.name, ".png") {
            names.push(entry.name)
        }
    }
    slices.sort(mut names)
    names
}

fn outcome(cx: Context, data: u8[]) -> str {
    let picture = add_png(cx, data) catch {
        e => return "error {e}"
    }
    let rgba = png_rgba(data) catch {
        e => return "error {e}"
    }
    "{picture.width} {picture.height} {hash.crc32(rgba.pixels)}"
}

fn test_the_png_suite_decodes_as_a_reference_decoder_does(t: *testing.T) {
    let cx = headless(rgb(0x000000))
    var report = ""
    for name in suite_names(t) {
        let data = file.read_file("{suite}/{name}") catch {
            e => {
                t.fatal("read {name}: {e}")
                return
            }
        }
        report = "{report}{name} {outcome(cx, data)}\n"
    }
    testing.golden(t, "ui_png/suite", report)
}

fn straight(rgba: u8[]) -> image.Image {
    image.from_pixels(2, 1, Rgba8, rgba) catch {
        _ => image.create(0, 0, Rgba8)
    }
}

fn test_a_picture_keeps_straight_alpha(t: *testing.T) {
    let source = straight([200, 100, 50, 128, 10, 20, 30, 0])
    let rgba = png_rgba(image.encode_png(source)) catch {
        e => {
            t.fatal("decode: {e}")
            return
        }
    }
    testing.equal_slice(t, rgba.pixels, source.pixels)
}

fn test_data_that_is_not_a_png_is_unsupported(t: *testing.T) {
    let cx = headless(rgb(0x000000))
    let gif = bytes("GIF89a")
    add_png(cx, gif) catch {
        e => {
            testing.equal(t, e, io.Error.Unsupported)
            return
        }
    }
    t.error("add_png accepted a GIF")
}

fn test_a_truncated_png_is_malformed(t: *testing.T) {
    let cx = headless(rgb(0x000000))
    let png = image.encode_png(straight([1, 2, 3, 4, 5, 6, 7, 8]))
    add_png(cx, png[..png.len - 5]) catch {
        e => {
            testing.equal(t, e, io.Error.Malformed)
            return
        }
    }
    t.error("add_png accepted a truncated PNG")
}

fn test_a_png_file_is_added_by_path(t: *testing.T) {
    let cx = headless(rgb(0x000000))
    let picture = add_png_file(cx, "{suite}/basn6a16.png") catch {
        e => {
            t.fatal("add_png_file: {e}")
            return
        }
    }
    testing.equal(t, picture.width, 32)
    testing.equal(t, picture.height, 32)
}

fn test_a_missing_png_file_is_not_found(t: *testing.T) {
    let cx = headless(rgb(0x000000))
    add_png_file(cx, "{suite}/absent.png") catch {
        e => {
            testing.equal(t, e, io.Error.NotFound)
            return
        }
    }
    t.error("add_png_file found a missing file")
}
