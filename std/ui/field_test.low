import std/testing
import std/ui/geometry
import std/ui/layout
import std/ui/platform
import std/unicode
import uitext = std/ui/text

fn editor(value: Signal[str]) -> fn() -> Element {
    fn() -> Element {
        column(div()).children() {
            field(get(value)).id("name").width(150.0).height(30.0).on_change(fn(s: str) { set(value, s) }),
            div().height(40.0),
        }
    }
}

fn text_width(s: str) -> f32 {
    var sys = uitext.default_system()
    uitext.measure(mut sys, s, uitext.Style {}, layout.unbounded).width
}

fn focused_editor(cx: Context, initial: str) -> Signal[str] {
    let value = signal(cx, initial)
    shot(cx, editor(value))
    click(cx, 149.0, 5.0)
    value
}

fn type_text(cx: Context, s: str) {
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn chord(cx: Context, letter: str) {
    dispatch(cx, platform.Event.Key(platform.KeyEvent {
        key: platform.Key.Character(letter)
        modifiers: platform.Modifiers { control: true }
    }))
}

fn stroke(cx: Context, n: platform.NamedKey, shift: bool, control: bool) {
    dispatch(cx, platform.Event.Key(platform.KeyEvent {
        key: platform.Key.Named(n)
        modifiers: platform.Modifiers { shift: shift, control: control }
    }))
}

fn test_typing_inserts_at_the_caret_and_reports_the_text(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "")
    type_text(cx, "a")
    type_text(cx, "b")
    testing.equal(t, get(value), "ab")
    shot(cx, editor(value))
    type_text(cx, "c")
    testing.equal(t, get(value), "abc")
    stroke(cx, platform.NamedKey.Left, false, false)
    type_text(cx, "X")
    testing.equal(t, get(value), "abXc")
}

fn test_backspace_delete_and_shift_selection_edit_the_text(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "hello")
    stroke(cx, platform.NamedKey.Backspace, false, false)
    testing.equal(t, get(value), "hell")
    stroke(cx, platform.NamedKey.Home, false, false)
    stroke(cx, platform.NamedKey.Delete, false, false)
    testing.equal(t, get(value), "ell")
    stroke(cx, platform.NamedKey.End, false, false)
    stroke(cx, platform.NamedKey.Left, true, false)
    stroke(cx, platform.NamedKey.Left, true, false)
    type_text(cx, "Z")
    testing.equal(t, get(value), "eZ")
}

fn test_a_collapsing_arrow_moves_to_the_edge_of_the_selection(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "abcd")
    chord(cx, "a")
    stroke(cx, platform.NamedKey.Left, false, false)
    type_text(cx, "<")
    testing.equal(t, get(value), "<abcd")
    chord(cx, "a")
    stroke(cx, platform.NamedKey.Right, false, false)
    type_text(cx, ">")
    testing.equal(t, get(value), "<abcd>")
}

fn test_cut_copy_and_paste_use_the_clipboard(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "abc")
    testing.equal(t, clipboard(cx) ?? "", "")
    chord(cx, "a")
    chord(cx, "x")
    testing.equal(t, get(value), "")
    testing.equal(t, clipboard(cx) ?? "", "abc")
    chord(cx, "v")
    chord(cx, "V")
    testing.equal(t, get(value), "abcabc")
    chord(cx, "a")
    chord(cx, "c")
    type_text(cx, "!")
    testing.equal(t, get(value), "!")
    testing.equal(t, clipboard(cx) ?? "", "abcabc")
}

fn test_text_with_line_breaks_is_typed_and_pasted_on_one_line(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "")
    type_text(cx, "\n")
    testing.equal(t, get(value), "")
    set_clipboard(cx, "a\nb\r\nc")
    chord(cx, "v")
    testing.equal(t, get(value), "abc")
}

fn test_control_moves_and_deletes_by_word(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "one two")
    stroke(cx, platform.NamedKey.Left, false, true)
    type_text(cx, "x")
    testing.equal(t, get(value), "one xtwo")
    stroke(cx, platform.NamedKey.End, false, false)
    stroke(cx, platform.NamedKey.Backspace, false, true)
    testing.equal(t, get(value), "one ")
    stroke(cx, platform.NamedKey.Home, false, false)
    stroke(cx, platform.NamedKey.Delete, false, true)
    testing.equal(t, get(value), " ")
}

fn test_the_caret_moves_by_graphemes(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let accent = unicode.encode_rune(0x301)
    let value = focused_editor(cx, "ae{accent}b")
    stroke(cx, platform.NamedKey.Left, false, false)
    stroke(cx, platform.NamedKey.Left, false, false)
    stroke(cx, platform.NamedKey.Backspace, false, false)
    testing.equal(t, get(value), "e{accent}b")
    stroke(cx, platform.NamedKey.Right, false, false)
    stroke(cx, platform.NamedKey.Backspace, false, false)
    testing.equal(t, get(value), "b")
}

fn test_a_click_places_the_caret_at_the_nearest_boundary(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "abcd")
    shot(cx, editor(value))
    click(cx, text_width("ab") + 0.1, 5.0)
    type_text(cx, "X")
    testing.equal(t, get(value), "abXcd")
    shot(cx, editor(value))
    click(cx, text_width("abXc") - 0.1, 5.0)
    type_text(cx, "Y")
    testing.equal(t, get(value), "abXcYd")
}

fn test_dragging_selects_and_typing_replaces_the_selection(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "abcd")
    shot(cx, editor(value))
    press(cx, 0.2, 5.0)
    move_to(cx, text_width("abc") + 0.1, 5.0)
    release(cx, text_width("abc") + 0.1, 5.0)
    type_text(cx, "Z")
    testing.equal(t, get(value), "Zd")
}

fn test_the_selection_and_the_caret_are_painted_over_the_text(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "abc")
    let view = editor(value)
    testing.equal(t, shot(cx, view).quads.len, 0)
    click(cx, 149.0, 5.0)
    let caret = shot(cx, view)
    testing.equal(t, caret.quads.len, 1)
    testing.equal(t, caret.quads[0].bounds.width, 1.0)
    chord(cx, "a")
    let selected = shot(cx, view)
    testing.equal(t, selected.quads.len, 2)
    testing.equal(t, selected.quads[0].bounds.width, floor(selected.quads[0].bounds.width))
    testing.equal(t, selected.quads[0].bounds.x, floor(selected.quads[0].bounds.x))
    testing.is_true(t, gap_between(selected.quads[0].bounds.width, text_width("abc")) < 1.0)
    testing.is_true(t, selected.quads[0].background.a < 1.0)
    testing.is_true(t, gap_between(selected.quads[1].bounds.x, text_width("abc")) <= 0.5)
}

fn test_a_composition_is_shown_until_the_input_method_commits_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "ab")
    let view = editor(value)
    let plain = shot(cx, view)
    let start = (text_input(cx) ?? platform.Caret {}).x
    dispatch(cx, platform.Event.Preedit("ni", platform.TextRange { start: 0, end: 2 }))
    let composing = shot(cx, view)
    testing.equal(t, get(value), "ab")
    testing.is_true(t, composing.sprites.len > plain.sprites.len)
    let moved = (text_input(cx) ?? platform.Caret {}).x
    testing.is_true(t, moved > start)
    let word = unicode.encode_rune(0x4f60)
    dispatch(cx, platform.Event.Commit(word))
    testing.equal(t, get(value), "ab{word}")
    let committed = shot(cx, view)
    dispatch(cx, platform.Event.Preedit("x", none))
    testing.equal(t, shot(cx, view).sprites.len, committed.sprites.len + 1)
    dispatch(cx, platform.Event.Preedit("", none))
    testing.equal(t, shot(cx, view).sprites.len, committed.sprites.len)
}

fn test_a_commit_replaces_the_selection(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "abc")
    chord(cx, "a")
    dispatch(cx, platform.Event.Commit("Q"))
    testing.equal(t, get(value), "Q")
}

fn test_input_without_a_focused_field_is_ignored(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "abc")
    shot(cx, editor(value))
    type_text(cx, "x")
    dispatch(cx, platform.Event.Commit("y"))
    dispatch(cx, platform.Event.Preedit("z", none))
    testing.equal(t, get(value), "abc")
}

fn test_key_releases_and_shortcut_letters_insert_nothing(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "abc")
    dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character("x"), text: "x", pressed: false }))
    chord(cx, "q")
    testing.equal(t, get(value), "abc")
}

fn test_text_input_follows_the_focus(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "ab")
    let view = editor(value)
    shot(cx, view)
    testing.is_true(t, text_input(cx) == none)
    click(cx, 149.0, 5.0)
    shot(cx, view)
    let caret = text_input(cx) ?? platform.Caret {}
    testing.is_true(t, text_input(cx) != none)
    testing.equal(t, caret.x, i64(floor(text_width("ab"))))
    testing.is_true(t, caret.height > 0)
    click(cx, 10.0, 60.0)
    shot(cx, view)
    testing.is_true(t, text_input(cx) == none)
}

fn test_the_pointer_shows_the_cursor_of_the_element_under_it(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        column(div()).children() {
            field("abc").height(30.0),
            div().height(30.0).cursor(platform.Cursor.Pointer),
            div().height(30.0),
        }
    }
    shot(cx, view)
    testing.is_true(t, pointer_cursor(cx) == platform.Cursor.Arrow)
    move_to(cx, 10.0, 10.0)
    testing.is_true(t, pointer_cursor(cx) == platform.Cursor.Text)
    move_to(cx, 10.0, 45.0)
    testing.is_true(t, pointer_cursor(cx) == platform.Cursor.Pointer)
    move_to(cx, 10.0, 75.0)
    testing.is_true(t, pointer_cursor(cx) == platform.Cursor.Arrow)
    dispatch(cx, platform.Event.PointerLeft)
    testing.is_true(t, pointer_cursor(cx) == platform.Cursor.Arrow)
}

fn test_a_cursor_on_a_parent_covers_its_children(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let view = fn() -> Element {
        div().size(100.0, 100.0).cursor(platform.Cursor.Crosshair).child(div().size(20.0, 20.0))
    }
    shot(cx, view)
    move_to(cx, 10.0, 10.0)
    testing.is_true(t, pointer_cursor(cx) == platform.Cursor.Crosshair)
}

fn test_tab_leaves_a_field_and_enter_runs_its_click_handler(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let submits = signal(cx, 0)
    let view = fn() -> Element {
        column(div()).children() {
            field("a").id("a").height(30.0).on_click(count_up(submits)),
            field("b").id("b").height(30.0),
        }
    }
    shot(cx, view)
    click(cx, 5.0, 5.0)
    testing.equal(t, focused(cx), "a")
    testing.equal(t, get(submits), 1)
    dispatch(cx, named(platform.NamedKey.Enter))
    testing.equal(t, get(submits), 2)
    dispatch(cx, tab(false))
    testing.equal(t, focused(cx), "b")
}

fn test_the_field_scrolls_to_keep_the_caret_in_view(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let long = "the quick brown fox jumps over the lazy dog"
    let value = signal(cx, long)
    let view = fn() -> Element { field(get(value)).id("long").width(60.0).height(30.0) }
    shot(cx, view)
    click(cx, 5.0, 5.0)
    shot(cx, view)
    testing.is_true(t, (text_input(cx) ?? platform.Caret {}).x < 5)
    stroke(cx, platform.NamedKey.End, false, false)
    shot(cx, view)
    let caret = text_input(cx) ?? platform.Caret {}
    testing.is_true(t, caret.x >= 50 && caret.x <= 60)
    stroke(cx, platform.NamedKey.Home, false, false)
    shot(cx, view)
    testing.is_true(t, (text_input(cx) ?? platform.Caret {}).x < 5)
}

fn selection_of(cx: Context, key: str) -> str {
    let s = field_selection(cx, key)
    "{s.anchor},{s.caret}"
}

fn test_select_field_text_on_a_shown_field_makes_typing_replace_the_text(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "hello")
    select_field_text(cx, "name")
    testing.equal(t, selection_of(cx, "name"), "0,5")
    type_text(cx, "X")
    testing.equal(t, get(value), "X")
    shot(cx, editor(value))
    select_field_text(cx, "name")
    shot(cx, editor(value))
    type_text(cx, "Y")
    testing.equal(t, get(value), "Y")
}

fn find_view(cx: Context, open: Signal[bool], value: Signal[str]) -> fn() -> Element {
    fn() -> Element {
        let opener = div().id("opener").height(30.0).on_click(fn(c: ClickEvent) {
            set(open, true)
            set_focus(cx, "find")
            select_field_text(cx, "find")
        })
        let bar = if get(open) {
            field(get(value)).id("find").width(150.0).height(30.0).on_change(fn(s: str) { set(value, s) })
        } else {
            div().height(30.0)
        }
        column(div()).children() { opener, bar }
    }
}

fn test_select_all_in_the_event_that_adds_the_field_selects_its_text_in_the_next_frame(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let open = signal(cx, false)
    let value = signal(cx, "previous")
    let view = find_view(cx, open, value)
    shot(cx, view)
    click(cx, 5.0, 5.0)
    testing.is_true(t, get(open))
    testing.equal(t, focused(cx), "find")
    shot(cx, view)
    testing.equal(t, selection_of(cx, "find"), "0,8")
    testing.equal(t, focused(cx), "find")
    type_text(cx, "next")
    testing.equal(t, get(value), "next")
}

fn test_a_request_made_with_a_change_of_text_resolves_against_the_new_text(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "ab")
    set(value, "longer text")
    select_field_text(cx, "name")
    shot(cx, editor(value))
    testing.equal(t, selection_of(cx, "name"), "0,11")
    set(value, "xy")
    set_field_selection(cx, "name", 1, 100)
    shot(cx, editor(value))
    testing.equal(t, selection_of(cx, "name"), "1,2")
}

fn test_focus_and_select_all_work_in_either_order(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "abc")
    let view = fn() -> Element {
        column(div()).children() {
            field(get(value)).id("first").height(30.0).on_change(fn(s: str) { set(value, s) }),
            field("other").id("second").height(30.0),
        }
    }
    shot(cx, view)
    set_focus(cx, "first")
    select_field_text(cx, "first")
    shot(cx, view)
    testing.equal(t, focused(cx), "first")
    testing.equal(t, selection_of(cx, "first"), "0,3")
    type_text(cx, "1")
    testing.equal(t, get(value), "1")
    set_focus(cx, "second")
    shot(cx, view)
    select_field_text(cx, "first")
    set_focus(cx, "first")
    shot(cx, view)
    testing.equal(t, focused(cx), "first")
    testing.equal(t, selection_of(cx, "first"), "0,1")
    type_text(cx, "2")
    testing.equal(t, get(value), "2")
}

fn test_a_click_after_select_all_places_the_caret_as_before(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "abcd")
    shot(cx, editor(value))
    set_focus(cx, "name")
    select_field_text(cx, "name")
    shot(cx, editor(value))
    click(cx, text_width("ab") + 0.1, 5.0)
    testing.equal(t, selection_of(cx, "name"), "2,2")
    type_text(cx, "X")
    testing.equal(t, get(value), "abXcd")
}

fn test_offsets_past_the_end_are_clamped_and_negative_offsets_start_at_zero(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "hello")
    set_field_selection(cx, "name", 2, 100)
    testing.equal(t, selection_of(cx, "name"), "2,5")
    set_field_selection(cx, "name", -4, 3)
    shot(cx, editor(value))
    testing.equal(t, selection_of(cx, "name"), "0,3")
    type_text(cx, "Z")
    testing.equal(t, get(value), "Zlo")
}

fn test_offsets_inside_a_grapheme_move_to_the_nearest_boundary(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let accent = unicode.encode_rune(0x301)
    let value = focused_editor(cx, "ae{accent}b")
    set_field_selection(cx, "name", 2, 3)
    shot(cx, editor(value))
    testing.equal(t, selection_of(cx, "name"), "1,4")
    let face = unicode.encode_rune(0x1f600)
    set(value, "a{face}b")
    shot(cx, editor(value))
    set_field_selection(cx, "name", 2, 4)
    shot(cx, editor(value))
    testing.equal(t, selection_of(cx, "name"), "1,5")
    type_text(cx, "-")
    testing.equal(t, get(value), "a-b")
}

fn test_copy_after_select_all_puts_the_whole_text_on_the_clipboard(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = focused_editor(cx, "hello world")
    select_field_text(cx, "name")
    chord(cx, "c")
    testing.equal(t, clipboard(cx) ?? "", "hello world")
    testing.equal(t, get(value), "hello world")
}

fn test_a_selection_request_scrolls_the_caret_into_view(t: *testing.T) {
    let cx = headless(rgb(0xffffff))
    let value = signal(cx, "the quick brown fox jumps over the lazy dog")
    let view = fn() -> Element { field(get(value)).id("long").width(60.0).height(30.0) }
    shot(cx, view)
    click(cx, 5.0, 5.0)
    shot(cx, view)
    testing.is_true(t, (text_input(cx) ?? platform.Caret {}).x < 5)
    select_field_text(cx, "long")
    shot(cx, view)
    let caret = text_input(cx) ?? platform.Caret {}
    testing.is_true(t, caret.x >= 50 && caret.x <= 60)
    set_field_selection(cx, "long", 0, 0)
    shot(cx, view)
    testing.is_true(t, (text_input(cx) ?? platform.Caret {}).x < 5)
}
