import std/text

/// A command-line parsing failure, naming the flag involved.
pub enum Error {
    /// The argument names a flag that is not in the specs.
    Unknown(name: str)
    /// A flag that takes a value is the last argument and has none.
    Missing(name: str)
    /// The value is not valid for the flag: a boolean flag given something other than `true` or `false`, or a value that `number` cannot parse as an integer.
    Invalid(name: str, value: str)
}

/// The definition of one flag.
pub struct Spec {
    /// The flag name without leading dashes, used as `--name` or `-name`.
    pub name: str
    /// A short description shown by `usage`.
    pub help: str = ""
    /// Whether the flag is a switch that takes no separate value.
    ///
    /// A switch is `true` when given as `--name` and can be set explicitly as `--name=true` or `--name=false`.
    pub boolean: bool = false
    /// The value reported when the flag is not given.
    pub fallback: str = ""
}

/// The values and positional arguments found by `parse`.
pub struct Parsed {
    values: [str: str] = [:]
    /// The arguments that are not flags, in order, followed by everything after a `--` argument.
    pub rest: []str = []
}

fn find(specs: []Spec, name: str) -> Spec? {
    for s in specs {
        if s.name == name {
            return s
        }
    }
    none
}

/// Parses `args` against `specs`.
///
/// `args` does not include the program name. A flag is written `--name` or `-name`, with the value either joined as `--name=value` or as the next argument; a switch takes no next argument. An argument that does not start with `-`, and a lone `-`, is positional. `--` ends flag parsing and every later argument is positional. Flags and positional arguments can be interleaved, and a flag given more than once keeps its last value. Fails with `Unknown`, `Missing` or `Invalid` for the first problem found.
pub fn parse(specs: []Spec, args: []str) -> Parsed ! Error {
    var values: [str: str] = [:]
    for s in specs {
        values[s.name] = s.fallback
    }
    var rest: []str = []
    var i = 0
    for i < args.len {
        let arg = args[i]
        i += 1
        if arg == "--" {
            for j in i..args.len {
                push(mut rest, args[j])
            }
            break
        }
        if !text.starts_with(arg, "-") || arg == "-" {
            push(mut rest, arg)
            continue
        }
        var name = text.trim_prefix(text.trim_prefix(arg, "-"), "-")
        var value = ""
        var inline = false
        let eq = text.index_byte(name, '=')
        if eq >= 0 {
            value = name[eq + 1..]
            name = name[..eq]
            inline = true
        }
        let spec = find(specs, name) ?? fail Unknown(name)
        if spec.boolean {
            if !inline {
                value = "true"
            }
            if value != "true" && value != "false" {
                fail Invalid(name, value)
            }
        } else if !inline {
            if i >= args.len {
                fail Missing(name)
            }
            value = args[i]
            i += 1
        }
        values[name] = value
    }
    Parsed { values: values, rest: rest }
}

/// Returns the value of the flag `name` as a string.
///
/// Returns the flag's fallback if it was not given, and an empty string if `name` is not in the specs.
pub fn get(p: Parsed, name: str) -> str {
    p.values[name] ?? ""
}

/// Returns whether the value of the flag `name` is `true`.
pub fn enabled(p: Parsed, name: str) -> bool {
    get(p, name) == "true"
}

/// Returns the value of the flag `name` parsed as an integer.
///
/// Fails with `Invalid` if the value, including an empty fallback, is not an integer.
pub fn number(p: Parsed, name: str) -> i64 ! Error {
    let raw = get(p, name)
    text.parse_int(raw) or fail Invalid(name, raw)
}

/// Returns help text for `specs`, one line per flag in the order given.
///
/// Each line has the form `  --name value  help (default fallback)`: switches omit `value`, the help part is omitted when empty, and the default part appears only for non-switch flags with a non-empty fallback.
pub fn usage(specs: []Spec) -> str {
    var out: []u8 = []
    for s in specs {
        text.append(mut out, "  --{s.name}")
        if !s.boolean {
            text.append(mut out, " value")
        }
        if s.help.len > 0 {
            text.append(mut out, "  {s.help}")
        }
        if s.fallback.len > 0 && !s.boolean {
            text.append(mut out, " (default {s.fallback})")
        }
        push(mut out, '\n')
    }
    str(out)
}
