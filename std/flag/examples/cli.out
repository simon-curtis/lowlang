usage:
  --port value  port to listen on (default 8080)
  --host value  address to bind (default localhost)
  --verbose  log every request
  --workers value  number of workers (default 1)

localhost:8080 workers=1 verbose=false files=[]
0.0.0.0:9090 workers=1 verbose=true files=["a.txt", "b.txt"]
localhost:8080 workers=4 verbose=false files=["serve", "--port"]
