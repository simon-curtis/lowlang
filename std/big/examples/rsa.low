import std/big

/// Builds a toy RSA key from two Mersenne primes, encrypts a three byte message with the public exponent and decrypts it with the inverse exponent.
fn main() ! big.Error {
    let p = big.parse("170141183460469231731687303715884105727", 10)?
    let q = big.parse("618970019642690137449562111", 10)?
    let n = big.mul(p, q)
    let phi = big.mul(big.sub(p, big.one()), big.sub(q, big.one()))
    let e = big.from_i64(65537)
    let d = big.mod_inverse(e, phi)?

    print("p is prime: {big.is_probable_prime(p, 20)}")
    print("q is prime: {big.is_probable_prime(q, 20)}")
    print("modulus: {big.to_str(n, 10)}")
    print("modulus bits: {big.bit_len(n)}")

    let message = big.from_bytes(bytes("low"))
    let cipher = big.modpow(message, e, n)?
    print("ciphertext: {big.to_str(cipher, 16)}")
    let plain = big.modpow(cipher, d, n)?
    print("decrypted: {str(big.to_bytes(plain))}")
}
