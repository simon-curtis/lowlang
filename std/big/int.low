/// The error type of the fallible `big` functions.
pub enum Error {
    /// The input contains no digits.
    Empty
    /// The input has a character at byte offset `at` that is not a digit of the base, or a misplaced `_` separator.
    BadDigit(at: i64)
    /// The base is outside the range 2 to 36.
    BadBase
    /// The divisor or modulus is zero.
    DivideByZero
    /// The value does not fit the requested type or size.
    Overflow
    /// The value has no modular inverse because it shares a factor with the modulus.
    NoInverse
    /// The operation is undefined for a negative value.
    Negative
    /// The operation requires a value greater than zero.
    NotPositive
}

/// An arbitrary-precision signed integer.
///
/// Stored as a sign and a magnitude of 32-bit limbs. Zero is never negative. An `Int` is a value: every operation returns a new `Int` and leaves its arguments unchanged. Operations are not constant time.
pub struct Int {
    neg: bool
    mag: []u32
}

/// The quotient and remainder of a division.
pub struct DivMod {
    /// The quotient. Its rounding depends on the division that produced it.
    pub quotient: Int
    /// The remainder, satisfying `quotient * divisor + remainder == dividend`. Its sign depends on the division that produced it.
    pub remainder: Int
}

fn make_int(neg: bool, mag: []u32) -> Int {
    let m = trim(mag)
    Int { neg: neg && m.len > 0, mag: m }
}

/// Returns the integer `0`.
pub fn zero() -> Int {
    let none: []u32 = []
    Int { neg: false, mag: none }
}

/// Returns the integer `1`.
pub fn one() -> Int {
    Int { neg: false, mag: [1] }
}

/// Returns `v` as an `Int`.
pub fn from_u64(v: u64) -> Int {
    Int { neg: false, mag: limbs_from_u64(v) }
}

/// Returns `v` as an `Int`, including `i64` minimum.
pub fn from_i64(v: i64) -> Int {
    let bits = u64(v)
    if v < 0 {
        return Int { neg: true, mag: limbs_from_u64(0 - bits) }
    }
    Int { neg: false, mag: limbs_from_u64(bits) }
}

/// Returns `a` as an `i64`.
///
/// Fails with `Overflow` when `a` is outside the range of `i64`.
pub fn to_i64(a: Int) -> i64 ! Error {
    if a.mag.len > 2 {
        fail Overflow
    }
    let v = limbs_to_u64(a.mag)
    if a.neg {
        if v > 0x8000000000000000 {
            fail Overflow
        }
        return i64(0 - v)
    }
    if v > 0x7FFFFFFFFFFFFFFF {
        fail Overflow
    }
    i64(v)
}

/// Returns `a` as a `u64`.
///
/// Fails with `Overflow` when `a` is negative or larger than `u64` can hold.
pub fn to_u64(a: Int) -> u64 ! Error {
    if a.neg || a.mag.len > 2 {
        fail Overflow
    }
    limbs_to_u64(a.mag)
}

/// Returns `-1`, `0` or `1` for a negative, zero or positive `a`.
pub fn sign(a: Int) -> i64 {
    if a.mag.len == 0 {
        return 0
    }
    if a.neg { -1 } else { 1 }
}

/// Returns `true` when `a` is zero.
pub fn is_zero(a: Int) -> bool {
    a.mag.len == 0
}

/// Returns `true` when `a` is less than zero.
pub fn is_negative(a: Int) -> bool {
    a.neg
}

/// Returns `true` when `a` is odd, whatever its sign.
pub fn is_odd(a: Int) -> bool {
    a.mag.len > 0 && a.mag[0] & 1 == 1
}

/// Returns `true` when `a` is even. Zero is even.
pub fn is_even(a: Int) -> bool {
    !is_odd(a)
}

/// Returns `-a`. The negation of zero is zero.
pub fn neg(a: Int) -> Int {
    Int { neg: !a.neg && a.mag.len > 0, mag: a.mag }
}

/// Returns the absolute value of `a`.
pub fn abs(a: Int) -> Int {
    Int { neg: false, mag: a.mag }
}

/// Compares `a` with `b` and returns `-1` when `a < b`, `0` when they are equal and `1` when `a > b`.
pub fn cmp(a: Int, b: Int) -> i64 {
    if a.neg != b.neg {
        return if a.neg { -1 } else { 1 }
    }
    let c = limbs_cmp(a.mag, b.mag)
    if a.neg { -c } else { c }
}

/// Returns `true` when `a` and `b` are the same integer.
pub fn equal(a: Int, b: Int) -> bool {
    cmp(a, b) == 0
}

/// Returns `a + b`.
///
/// Costs time linear in the number of limbs.
pub fn add(a: Int, b: Int) -> Int {
    if a.neg == b.neg {
        return make_int(a.neg, limbs_add(a.mag, b.mag))
    }
    let c = limbs_cmp(a.mag, b.mag)
    if c == 0 {
        return zero()
    }
    if c > 0 {
        return make_int(a.neg, limbs_sub(a.mag, b.mag))
    }
    make_int(b.neg, limbs_sub(b.mag, a.mag))
}

/// Returns `a - b`.
///
/// Costs time linear in the number of limbs.
pub fn sub(a: Int, b: Int) -> Int {
    add(a, neg(b))
}

/// Returns `a * b`.
///
/// Uses schoolbook multiplication for small operands and Karatsuba once the shorter operand reaches 32 limbs.
pub fn mul(a: Int, b: Int) -> Int {
    make_int(a.neg != b.neg, limbs_mul(a.mag, b.mag))
}

/// Returns `a * a`.
pub fn square(a: Int) -> Int {
    make_int(false, limbs_mul(a.mag, a.mag))
}

/// Divides `a` by `b`, truncating the quotient toward zero.
///
/// The remainder takes the sign of `a`. Fails with `DivideByZero` when `b` is zero. Costs time proportional to the product of the quotient and divisor limb counts.
pub fn divmod(a: Int, b: Int) -> DivMod ! Error {
    if b.mag.len == 0 {
        fail DivideByZero
    }
    let qr = limbs_divmod(a.mag, b.mag)
    DivMod {
        quotient: make_int(a.neg != b.neg, qr.q),
        remainder: make_int(a.neg, qr.r),
    }
}

/// Divides `a` by `b`, rounding the quotient toward negative infinity.
///
/// A non-zero remainder takes the sign of `b`. Fails with `DivideByZero` when `b` is zero.
pub fn divmod_floor(a: Int, b: Int) -> DivMod ! Error {
    let t = divmod(a, b)?
    if t.remainder.mag.len > 0 && t.remainder.neg != b.neg {
        return DivMod { quotient: sub(t.quotient, one()), remainder: add(t.remainder, b) }
    }
    t
}

/// Divides `a` by `b` so the remainder is never negative.
///
/// The remainder is in `0..|b|`. Fails with `DivideByZero` when `b` is zero.
pub fn divmod_euclid(a: Int, b: Int) -> DivMod ! Error {
    let t = divmod(a, b)?
    if !t.remainder.neg {
        return t
    }
    if b.neg {
        return DivMod { quotient: add(t.quotient, one()), remainder: sub(t.remainder, b) }
    }
    DivMod { quotient: sub(t.quotient, one()), remainder: add(t.remainder, b) }
}

/// Returns the quotient of `a` divided by `b`, truncated toward zero.
///
/// Fails with `DivideByZero` when `b` is zero.
pub fn quo(a: Int, b: Int) -> Int ! Error {
    divmod(a, b)?.quotient
}

/// Returns the remainder of `a` divided by `b`, which takes the sign of `a`.
///
/// Fails with `DivideByZero` when `b` is zero.
pub fn rem(a: Int, b: Int) -> Int ! Error {
    divmod(a, b)?.remainder
}

/// Returns `a` modulo `b` as a value in `0..|b|`.
///
/// Fails with `DivideByZero` when `b` is zero.
pub fn modulo(a: Int, b: Int) -> Int ! Error {
    divmod_euclid(a, b)?.remainder
}

/// Returns `a` raised to the power `e` by repeated squaring.
///
/// `pow(a, 0)` is `1` for every `a`, including zero.
pub fn pow(a: Int, e: u64) -> Int {
    var result = one()
    var base = a
    var n = e
    for n > 0 {
        if n & 1 == 1 {
            result = mul(result, base)
        }
        n >>= 1
        if n > 0 {
            base = square(base)
        }
    }
    result
}

/// Returns the number of bits in the magnitude of `a`, or `0` for zero.
pub fn bit_len(a: Int) -> i64 {
    limbs_bit_len(a.mag)
}

/// Returns the number of trailing zero bits in the magnitude of `a`, or `0` for zero.
pub fn trailing_zeros(a: Int) -> i64 {
    limbs_trailing_zeros(a.mag)
}

/// Returns bit `i` of `a`, counting from the least significant bit.
///
/// A negative `a` is read in two's complement, so its bits above `bit_len` are all set. Returns `false` when `i` is negative.
pub fn bit(a: Int, i: i64) -> bool {
    if i < 0 {
        return false
    }
    if !a.neg {
        return limbs_bit(a.mag, i)
    }
    !limbs_bit(limbs_sub(a.mag, [1]), i)
}

/// Returns `a` shifted left by `n` bits, which multiplies it by `2^n`.
///
/// A negative `n` shifts right.
pub fn shl(a: Int, n: i64) -> Int {
    if n < 0 {
        return shr(a, -n)
    }
    Int { neg: a.neg, mag: limbs_shl(a.mag, n) }
}

/// Returns `a` shifted right by `n` bits.
///
/// The shift is arithmetic: the result is `a / 2^n` rounded toward negative infinity, so `shr(-1, n)` is `-1`. A negative `n` shifts left.
pub fn shr(a: Int, n: i64) -> Int {
    if n < 0 {
        return shl(a, -n)
    }
    if !a.neg {
        return make_int(false, limbs_shr(a.mag, n))
    }
    let shifted = limbs_shr(limbs_sub(a.mag, [1]), n)
    make_int(true, limbs_add(shifted, [1]))
}

fn twos_complement(a: Int, n: i64) -> []u32 {
    let out = limbs_pad(a.mag, n)
    if !a.neg {
        return out
    }
    var carry: u64 = 1
    for i in 0..n {
        let s = u64(~out[i]) + carry
        out[i] = u32(s)
        carry = s >> 32
    }
    out
}

fn from_twos_complement(x: []u32) -> Int {
    let negative = x[x.len - 1] & 0x80000000 != 0
    if !negative {
        return make_int(false, x)
    }
    let out: []u32 = __make(x.len)
    var carry: u64 = 1
    for i in 0..x.len {
        let s = u64(~x[i]) + carry
        out[i] = u32(s)
        carry = s >> 32
    }
    make_int(true, out)
}

fn bitwise(a: Int, b: Int, op: fn(u32, u32) -> u32) -> Int {
    let n = (if a.mag.len > b.mag.len { a.mag.len } else { b.mag.len }) + 1
    let x = twos_complement(a, n)
    let y = twos_complement(b, n)
    let out: []u32 = __make(n)
    for i in 0..n {
        out[i] = op(x[i], y[i])
    }
    from_twos_complement(out)
}

/// Returns the bitwise and of `a` and `b` with two's complement semantics for negative values.
pub fn bit_and(a: Int, b: Int) -> Int {
    bitwise(a, b, fn(x: u32, y: u32) -> u32 { x & y })
}

/// Returns the bitwise or of `a` and `b` with two's complement semantics for negative values.
pub fn bit_or(a: Int, b: Int) -> Int {
    bitwise(a, b, fn(x: u32, y: u32) -> u32 { x | y })
}

/// Returns the bitwise exclusive or of `a` and `b` with two's complement semantics for negative values.
pub fn bit_xor(a: Int, b: Int) -> Int {
    bitwise(a, b, fn(x: u32, y: u32) -> u32 { x ^ y })
}

/// Returns the bitwise complement of `a`, which is `-a - 1`.
pub fn bit_not(a: Int) -> Int {
    sub(neg(a), one())
}

/// Returns the non-negative integer whose big-endian bytes are `data`.
///
/// Leading zero bytes are ignored and empty input gives zero.
pub fn from_bytes(data: []u8) -> Int {
    let out: []u32 = __make((data.len + 3) / 4)
    for i in 0..data.len {
        let pos = data.len - 1 - i
        out[i / 4] |= u32(data[pos]) << (8 * (i % 4))
    }
    make_int(false, out)
}

/// Returns the big-endian bytes of the magnitude of `a`, without leading zeros.
///
/// Zero gives an empty slice. The sign is not encoded.
pub fn to_bytes(a: Int) -> []u8 {
    let size = (limbs_bit_len(a.mag) + 7) / 8
    let out: []u8 = __make(size)
    fill_bytes(a, out)
    out
}

/// Returns the big-endian bytes of `a` left-padded with zeros to exactly `size` bytes.
///
/// Fails with `Overflow` when `a` is negative or needs more than `size` bytes.
pub fn to_bytes_sized(a: Int, size: i64) -> []u8 ! Error {
    if a.neg || (limbs_bit_len(a.mag) + 7) / 8 > size {
        fail Overflow
    }
    let out: []u8 = __make(size)
    fill_bytes(a, out)
    out
}

fn fill_bytes(a: Int, out: []u8) {
    for i in 0..out.len {
        let limb = i / 4
        if limb < a.mag.len {
            out[out.len - 1 - i] = u8(a.mag[limb] >> (8 * (i % 4)))
        }
    }
}

