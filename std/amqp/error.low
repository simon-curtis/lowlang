/// The error type of the amqp module, returned by the codec, connecting, channel calls, publishing and consuming.
pub enum Error {
    /// The broker could not be reached.
    Connect
    /// The connection or channel is closed by this client.
    Closed
    /// A connect, handshake, call or wait exceeded its time limit, or the broker stopped sending heartbeats.
    Timeout
    /// The broker sent a frame or method that is not valid at this point of the protocol, or answered with a protocol header of another version.
    Protocol
    /// The bytes are not a valid AMQP 0-9-1 frame, method, content header or field table.
    Malformed
    /// A frame, a field or a message body is larger than the connection or the protocol allows.
    TooLarge
    /// The TLS handshake failed.
    Tls
    /// The broker offers none of the authentication mechanisms the options allow, or a method the call needs.
    Unsupported
    /// An argument is out of range, such as an empty exchange name for a declare or a count below `1`.
    Argument
    /// The broker refused the credentials, or asked for a challenge round the mechanism does not have. `message` is the broker's text or a description.
    Auth(message: str)
    /// The broker closed the connection with `connection.close`. `code` is the reply code, such as `320` for `CONNECTION_FORCED`, and `text` the broker's reply text.
    ConnectionClosed(code: i64, text: str)
    /// The broker closed the channel with `channel.close`. `code` is the reply code, such as `404` for `NOT_FOUND` or `406` for `PRECONDITION_FAILED`, and `text` the broker's reply text.
    ChannelClosed(code: i64, text: str)
    /// The broker refused a confirmed publish with `basic.nack`.
    Nacked
    /// Every channel number the broker allows is in use.
    Exhausted
}
