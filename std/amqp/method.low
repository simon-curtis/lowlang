import std/io
import std/text

/// An AMQP 0-9-1 method: the connection, channel, exchange, queue, basic, confirm and tx methods the client sends and receives, with RabbitMQ's `exchange.bind`, `exchange.unbind`, `basic.nack`, `confirm.select`, `connection.blocked` and `connection.unblocked`.
///
/// The reserved fields of the specification are written as zero and empty and ignored when decoding. The `no-wait` bit is not a field except on `BasicCancel`: it is written clear and ignored when decoding.
pub enum Method {
    /// `connection.start`: the broker's protocol version, properties, and the space separated mechanisms and locales it offers.
    ConnectionStart(major: i64, minor: i64, properties: Field[], mechanisms: str, locales: str)
    /// `connection.start-ok`: the client's properties, chosen mechanism, first authentication response and locale.
    ConnectionStartOk(properties: Field[], mechanism: str, response: u8[], locale: str)
    /// `connection.secure`: an authentication challenge.
    ConnectionSecure(challenge: u8[])
    /// `connection.secure-ok`: the answer to a challenge.
    ConnectionSecureOk(response: u8[])
    /// `connection.tune`: the broker's limits, with `0` meaning no limit or no heartbeat.
    ConnectionTune(channel_max: i64, frame_max: i64, heartbeat: i64)
    /// `connection.tune-ok`: the limits the client accepts.
    ConnectionTuneOk(channel_max: i64, frame_max: i64, heartbeat: i64)
    /// `connection.open`: opens the virtual host.
    ConnectionOpen(virtual_host: str)
    /// `connection.open-ok`.
    ConnectionOpenOk
    /// `connection.close`: a reply code and text, and the class and method that caused it, `0` when none.
    ConnectionClose(code: i64, text: str, class_id: i64, method_id: i64)
    /// `connection.close-ok`.
    ConnectionCloseOk
    /// `connection.blocked`: the broker stops reading publishes, for the reason given.
    ConnectionBlocked(reason: str)
    /// `connection.unblocked`: the broker reads publishes again.
    ConnectionUnblocked
    /// `channel.open`.
    ChannelOpen
    /// `channel.open-ok`.
    ChannelOpenOk
    /// `channel.flow`: asks the peer to pause or resume sending content.
    ChannelFlow(active: bool)
    /// `channel.flow-ok`.
    ChannelFlowOk(active: bool)
    /// `channel.close`: a reply code and text, and the class and method that caused it, `0` when none.
    ChannelClose(code: i64, text: str, class_id: i64, method_id: i64)
    /// `channel.close-ok`.
    ChannelCloseOk
    /// `exchange.declare`.
    ExchangeDeclare(exchange: str, kind: str, passive: bool, durable: bool, auto_delete: bool, internal: bool, arguments: Field[])
    /// `exchange.declare-ok`.
    ExchangeDeclareOk
    /// `exchange.delete`.
    ExchangeDelete(exchange: str, if_unused: bool)
    /// `exchange.delete-ok`.
    ExchangeDeleteOk
    /// `exchange.bind`, a RabbitMQ extension that routes one exchange to another.
    ExchangeBind(destination: str, source: str, routing_key: str, arguments: Field[])
    /// `exchange.bind-ok`.
    ExchangeBindOk
    /// `exchange.unbind`.
    ExchangeUnbind(destination: str, source: str, routing_key: str, arguments: Field[])
    /// `exchange.unbind-ok`.
    ExchangeUnbindOk
    /// `queue.declare`: an empty name asks the broker to name the queue.
    QueueDeclare(queue: str, passive: bool, durable: bool, exclusive: bool, auto_delete: bool, arguments: Field[])
    /// `queue.declare-ok`: the queue name and its message and consumer counts.
    QueueDeclareOk(queue: str, messages: i64, consumers: i64)
    /// `queue.bind`.
    QueueBind(queue: str, exchange: str, routing_key: str, arguments: Field[])
    /// `queue.bind-ok`.
    QueueBindOk
    /// `queue.unbind`.
    QueueUnbind(queue: str, exchange: str, routing_key: str, arguments: Field[])
    /// `queue.unbind-ok`.
    QueueUnbindOk
    /// `queue.purge`.
    QueuePurge(queue: str)
    /// `queue.purge-ok`: the number of messages removed.
    QueuePurgeOk(messages: i64)
    /// `queue.delete`.
    QueueDelete(queue: str, if_unused: bool, if_empty: bool)
    /// `queue.delete-ok`: the number of messages deleted with the queue.
    QueueDeleteOk(messages: i64)
    /// `basic.qos`: a prefetch size in bytes and count, `0` for none, per consumer or, with `global`, per channel.
    BasicQos(prefetch_size: i64, prefetch_count: i64, global: bool)
    /// `basic.qos-ok`.
    BasicQosOk
    /// `basic.consume`: an empty `consumer_tag` asks the broker to choose one.
    BasicConsume(queue: str, consumer_tag: str, no_local: bool, no_ack: bool, exclusive: bool, arguments: Field[])
    /// `basic.consume-ok`: the consumer tag in use.
    BasicConsumeOk(consumer_tag: str)
    /// `basic.cancel`: sent by either side; `no_wait` asks the receiver to send no `basic.cancel-ok`.
    BasicCancel(consumer_tag: str, no_wait: bool)
    /// `basic.cancel-ok`.
    BasicCancelOk(consumer_tag: str)
    /// `basic.publish`: followed by a content header and body frames.
    BasicPublish(exchange: str, routing_key: str, mandatory: bool, immediate: bool)
    /// `basic.return`: the broker returns an unroutable message, followed by its content.
    BasicReturn(code: i64, text: str, exchange: str, routing_key: str)
    /// `basic.deliver`: a message for a consumer, followed by its content.
    BasicDeliver(consumer_tag: str, delivery_tag: i64, redelivered: bool, exchange: str, routing_key: str)
    /// `basic.get`.
    BasicGet(queue: str, no_ack: bool)
    /// `basic.get-ok`: a message from the queue, followed by its content, and how many messages remain.
    BasicGetOk(delivery_tag: i64, redelivered: bool, exchange: str, routing_key: str, messages: i64)
    /// `basic.get-empty`.
    BasicGetEmpty
    /// `basic.ack`: acknowledges a delivery or, with `multiple`, every delivery up to its tag; the broker sends it too to confirm a publish.
    BasicAck(delivery_tag: i64, multiple: bool)
    /// `basic.reject`.
    BasicReject(delivery_tag: i64, requeue: bool)
    /// `basic.nack`, a RabbitMQ extension of `basic.reject` for several deliveries; the broker sends it to report a publish it could not take.
    BasicNack(delivery_tag: i64, multiple: bool, requeue: bool)
    /// `basic.recover`.
    BasicRecover(requeue: bool)
    /// `basic.recover-ok`.
    BasicRecoverOk
    /// `confirm.select`: puts the channel in publisher confirm mode.
    ConfirmSelect
    /// `confirm.select-ok`.
    ConfirmSelectOk
    /// `tx.select`.
    TxSelect
    /// `tx.select-ok`.
    TxSelectOk
    /// `tx.commit`.
    TxCommit
    /// `tx.commit-ok`.
    TxCommitOk
    /// `tx.rollback`.
    TxRollback
    /// `tx.rollback-ok`.
    TxRollbackOk
}

fn pack(bits: bool[]) -> u8 {
    var b = 0
    for i, on in bits {
        if on {
            b = b | (1 << i)
        }
    }
    u8(b)
}

fn bit(v: i64, i: i64) -> bool {
    v & (1 << i) != 0
}

fn head(class_id: i64, method_id: i64) -> u8[] {
    var out: u8[] = []
    io.put_be16(mut out, class_id)
    io.put_be16(mut out, method_id)
    out
}

fn closing(class_id: i64, method_id: i64, code: i64, reply: str, cause_class: i64, cause_method: i64) -> u8[] ! Error {
    var out = head(class_id, method_id)
    io.put_be16(mut out, code)
    put_short_string(mut out, reply)?
    io.put_be16(mut out, cause_class)
    io.put_be16(mut out, cause_method)
    out
}

fn put_names(mut out: u8[], names: str[]) ! Error {
    for n in names {
        put_short_string(mut out, n)?
    }
}

fn exchange_pair(method_id: i64, destination: str, source: str, key: str, args: Field[], has_no_wait: bool) -> u8[] ! Error {
    var out = head(40, method_id)
    io.put_be16(mut out, 0)
    put_names(mut out, [destination, source, key])?
    if has_no_wait {
        out.push(0)
    }
    put_table(mut out, args)?
    out
}

fn queue_binding(method_id: i64, queue: str, exchange: str, key: str, args: Field[], has_no_wait: bool) -> u8[] ! Error {
    var out = head(50, method_id)
    io.put_be16(mut out, 0)
    put_names(mut out, [queue, exchange, key])?
    if has_no_wait {
        out.push(0)
    }
    put_table(mut out, args)?
    out
}

fn tune(method_id: i64, channel_max: i64, frame_max: i64, heartbeat: i64) -> u8[] ! Error {
    if channel_max < 0 || channel_max > 65535 || frame_max < 0 || frame_max > 4294967295 || heartbeat < 0 || heartbeat > 65535 {
        fail Argument
    }
    var out = head(10, method_id)
    io.put_be16(mut out, channel_max)
    io.put_be32(mut out, frame_max)
    io.put_be16(mut out, heartbeat)
    out
}

fn encode_connection(m: Method) -> u8[]? ! Error {
    match m {
        ConnectionStart(major, minor, properties, mechanisms, locales) => {
            var out = head(10, 10)
            out.push(u8(major))
            out.push(u8(minor))
            put_table(mut out, properties)?
            put_long_string(mut out, mechanisms)
            put_long_string(mut out, locales)
            some(out)
        }
        ConnectionStartOk(properties, mechanism, response, locale) => {
            var out = head(10, 11)
            put_table(mut out, properties)?
            put_short_string(mut out, mechanism)?
            put_long_bytes(mut out, response)
            put_short_string(mut out, locale)?
            some(out)
        }
        ConnectionSecure(challenge) => {
            var out = head(10, 20)
            put_long_bytes(mut out, challenge)
            some(out)
        }
        ConnectionSecureOk(response) => {
            var out = head(10, 21)
            put_long_bytes(mut out, response)
            some(out)
        }
        ConnectionTune(channel_max, frame_max, heartbeat) => some(tune(30, channel_max, frame_max, heartbeat)?)
        ConnectionTuneOk(channel_max, frame_max, heartbeat) => some(tune(31, channel_max, frame_max, heartbeat)?)
        ConnectionOpen(virtual_host) => {
            var out = head(10, 40)
            put_short_string(mut out, virtual_host)?
            out.push(0)
            out.push(0)
            some(out)
        }
        ConnectionOpenOk => {
            var out = head(10, 41)
            out.push(0)
            some(out)
        }
        ConnectionClose(code, reply, class_id, method_id) => some(closing(10, 50, code, reply, class_id, method_id)?)
        ConnectionCloseOk => some(head(10, 51))
        ConnectionBlocked(reason) => {
            var out = head(10, 60)
            put_short_string(mut out, reason)?
            some(out)
        }
        ConnectionUnblocked => some(head(10, 61))
        _ => none
    }
}

fn encode_channel(m: Method) -> u8[]? ! Error {
    match m {
        ChannelOpen => {
            var out = head(20, 10)
            out.push(0)
            some(out)
        }
        ChannelOpenOk => {
            var out = head(20, 11)
            put_long_string(mut out, "")
            some(out)
        }
        ChannelFlow(active) => {
            var out = head(20, 20)
            out.push(pack([active]))
            some(out)
        }
        ChannelFlowOk(active) => {
            var out = head(20, 21)
            out.push(pack([active]))
            some(out)
        }
        ChannelClose(code, reply, class_id, method_id) => some(closing(20, 40, code, reply, class_id, method_id)?)
        ChannelCloseOk => some(head(20, 41))
        _ => none
    }
}

fn encode_exchange(m: Method) -> u8[]? ! Error {
    match m {
        ExchangeDeclare(exchange, kind, passive, durable, auto_delete, internal, arguments) => {
            var out = head(40, 10)
            io.put_be16(mut out, 0)
            put_names(mut out, [exchange, kind])?
            out.push(pack([passive, durable, auto_delete, internal, false]))
            put_table(mut out, arguments)?
            some(out)
        }
        ExchangeDeclareOk => some(head(40, 11))
        ExchangeDelete(exchange, if_unused) => {
            var out = head(40, 20)
            io.put_be16(mut out, 0)
            put_short_string(mut out, exchange)?
            out.push(pack([if_unused, false]))
            some(out)
        }
        ExchangeDeleteOk => some(head(40, 21))
        ExchangeBind(destination, source, key, arguments) => some(exchange_pair(30, destination, source, key, arguments, true)?)
        ExchangeBindOk => some(head(40, 31))
        ExchangeUnbind(destination, source, key, arguments) => some(exchange_pair(40, destination, source, key, arguments, true)?)
        ExchangeUnbindOk => some(head(40, 51))
        _ => none
    }
}

fn encode_queue(m: Method) -> u8[]? ! Error {
    match m {
        QueueDeclare(queue, passive, durable, exclusive, auto_delete, arguments) => {
            var out = head(50, 10)
            io.put_be16(mut out, 0)
            put_short_string(mut out, queue)?
            out.push(pack([passive, durable, exclusive, auto_delete, false]))
            put_table(mut out, arguments)?
            some(out)
        }
        QueueDeclareOk(queue, messages, consumers) => {
            var out = head(50, 11)
            put_short_string(mut out, queue)?
            io.put_be32(mut out, messages)
            io.put_be32(mut out, consumers)
            some(out)
        }
        QueueBind(queue, exchange, key, arguments) => some(queue_binding(20, queue, exchange, key, arguments, true)?)
        QueueBindOk => some(head(50, 21))
        QueueUnbind(queue, exchange, key, arguments) => some(queue_binding(50, queue, exchange, key, arguments, false)?)
        QueueUnbindOk => some(head(50, 51))
        QueuePurge(queue) => {
            var out = head(50, 30)
            io.put_be16(mut out, 0)
            put_short_string(mut out, queue)?
            out.push(0)
            some(out)
        }
        QueuePurgeOk(messages) => {
            var out = head(50, 31)
            io.put_be32(mut out, messages)
            some(out)
        }
        QueueDelete(queue, if_unused, if_empty) => {
            var out = head(50, 40)
            io.put_be16(mut out, 0)
            put_short_string(mut out, queue)?
            out.push(pack([if_unused, if_empty, false]))
            some(out)
        }
        QueueDeleteOk(messages) => {
            var out = head(50, 41)
            io.put_be32(mut out, messages)
            some(out)
        }
        _ => none
    }
}

fn encode_basic_consuming(m: Method) -> u8[]? ! Error {
    match m {
        BasicQos(size, count, global) => {
            var out = head(60, 10)
            io.put_be32(mut out, size)
            io.put_be16(mut out, count)
            out.push(pack([global]))
            some(out)
        }
        BasicQosOk => some(head(60, 11))
        BasicConsume(queue, tag, no_local, no_ack, exclusive, arguments) => {
            var out = head(60, 20)
            io.put_be16(mut out, 0)
            put_names(mut out, [queue, tag])?
            out.push(pack([no_local, no_ack, exclusive, false]))
            put_table(mut out, arguments)?
            some(out)
        }
        BasicConsumeOk(tag) => {
            var out = head(60, 21)
            put_short_string(mut out, tag)?
            some(out)
        }
        BasicCancel(tag, no_wait) => {
            var out = head(60, 30)
            put_short_string(mut out, tag)?
            out.push(pack([no_wait]))
            some(out)
        }
        BasicCancelOk(tag) => {
            var out = head(60, 31)
            put_short_string(mut out, tag)?
            some(out)
        }
        BasicGet(queue, no_ack) => {
            var out = head(60, 70)
            io.put_be16(mut out, 0)
            put_short_string(mut out, queue)?
            out.push(pack([no_ack]))
            some(out)
        }
        BasicGetEmpty => {
            var out = head(60, 72)
            out.push(0)
            some(out)
        }
        _ => none
    }
}

fn encode_basic_content(m: Method) -> u8[]? ! Error {
    match m {
        BasicPublish(exchange, key, mandatory, immediate) => {
            var out = head(60, 40)
            io.put_be16(mut out, 0)
            put_names(mut out, [exchange, key])?
            out.push(pack([mandatory, immediate]))
            some(out)
        }
        BasicReturn(code, reply, exchange, key) => {
            var out = head(60, 50)
            io.put_be16(mut out, code)
            put_names(mut out, [reply, exchange, key])?
            some(out)
        }
        BasicDeliver(tag, delivery_tag, redelivered, exchange, key) => {
            var out = head(60, 60)
            put_short_string(mut out, tag)?
            io.put_be64(mut out, delivery_tag)
            out.push(pack([redelivered]))
            put_names(mut out, [exchange, key])?
            some(out)
        }
        BasicGetOk(delivery_tag, redelivered, exchange, key, messages) => {
            var out = head(60, 71)
            io.put_be64(mut out, delivery_tag)
            out.push(pack([redelivered]))
            put_names(mut out, [exchange, key])?
            io.put_be32(mut out, messages)
            some(out)
        }
        _ => none
    }
}

fn encode_basic_settling(m: Method) -> u8[]? ! Error {
    match m {
        BasicAck(delivery_tag, multiple) => {
            var out = head(60, 80)
            io.put_be64(mut out, delivery_tag)
            out.push(pack([multiple]))
            some(out)
        }
        BasicReject(delivery_tag, requeue) => {
            var out = head(60, 90)
            io.put_be64(mut out, delivery_tag)
            out.push(pack([requeue]))
            some(out)
        }
        BasicRecover(requeue) => {
            var out = head(60, 110)
            out.push(pack([requeue]))
            some(out)
        }
        BasicRecoverOk => some(head(60, 111))
        BasicNack(delivery_tag, multiple, requeue) => {
            var out = head(60, 120)
            io.put_be64(mut out, delivery_tag)
            out.push(pack([multiple, requeue]))
            some(out)
        }
        ConfirmSelect => {
            var out = head(85, 10)
            out.push(0)
            some(out)
        }
        ConfirmSelectOk => some(head(85, 11))
        TxSelect => some(head(90, 10))
        TxSelectOk => some(head(90, 11))
        TxCommit => some(head(90, 20))
        TxCommitOk => some(head(90, 21))
        TxRollback => some(head(90, 30))
        TxRollbackOk => some(head(90, 31))
        _ => none
    }
}

/// Returns the payload of the method frame for `m`: the class and method identifiers and the arguments.
///
/// Fails with `TooLarge` for a string argument over 255 bytes and `Argument` for a number that does not fit its field.
pub fn encode_method(m: Method) -> u8[] ! Error {
    let encoders = [encode_connection, encode_channel, encode_exchange, encode_queue, encode_basic_consuming, encode_basic_content, encode_basic_settling]
    for encode in encoders {
        match encode(m)? {
            some(out) => {
                return out
            }
            none => {}
        }
    }
    fail Argument
}

fn arguments(c: *Cursor) -> Field[] ! Error {
    take_table(c, 0)?
}

fn end(c: *Cursor) ! Error {
    if left(c) > 0 {
        fail Malformed
    }
}

fn decode_closing(c: *Cursor) -> Method ! Error {
    let code = take_u16(c)?
    let reply = take_short_string(c)?
    let class_id = take_u16(c)?
    let method_id = take_u16(c)?
    end(c)?
    Method.ConnectionClose(code, reply, class_id, method_id)
}

fn decode_connection(method_id: i64, c: *Cursor) -> Method ! Error {
    match method_id {
        10 => {
            let major = take_u8(c)?
            let minor = take_u8(c)?
            let properties = arguments(c)?
            let mechanisms = take_long_string(c)?
            let locales = take_long_string(c)?
            Method.ConnectionStart(major, minor, properties, mechanisms, locales)
        }
        11 => {
            let properties = arguments(c)?
            let mechanism = take_short_string(c)?
            let response = take_long_bytes(c)?
            let locale = take_short_string(c)?
            Method.ConnectionStartOk(properties, mechanism, response, locale)
        }
        20 => Method.ConnectionSecure(take_long_bytes(c)?)
        21 => Method.ConnectionSecureOk(take_long_bytes(c)?)
        30 => {
            let channel_max = take_u16(c)?
            let frame_max = take_u32(c)?
            let heartbeat = take_u16(c)?
            Method.ConnectionTune(channel_max, frame_max, heartbeat)
        }
        31 => {
            let channel_max = take_u16(c)?
            let frame_max = take_u32(c)?
            let heartbeat = take_u16(c)?
            Method.ConnectionTuneOk(channel_max, frame_max, heartbeat)
        }
        40 => {
            let host = take_short_string(c)?
            take_short_string(c)?
            take_u8(c)?
            Method.ConnectionOpen(host)
        }
        41 => {
            take_short_string(c)?
            Method.ConnectionOpenOk
        }
        50 => decode_closing(c)?
        51 => Method.ConnectionCloseOk
        60 => Method.ConnectionBlocked(take_short_string(c)?)
        61 => Method.ConnectionUnblocked
        _ => fail Malformed
    }
}

fn decode_channel(method_id: i64, c: *Cursor) -> Method ! Error {
    match method_id {
        10 => {
            take_short_string(c)?
            Method.ChannelOpen
        }
        11 => {
            take_long_bytes(c)?
            Method.ChannelOpenOk
        }
        20 => Method.ChannelFlow(bit(take_u8(c)?, 0))
        21 => Method.ChannelFlowOk(bit(take_u8(c)?, 0))
        40 => {
            let closed = decode_closing(c)?
            match closed {
                ConnectionClose(code, reply, class_id, cause) => Method.ChannelClose(code, reply, class_id, cause)
                _ => fail Malformed
            }
        }
        41 => Method.ChannelCloseOk
        _ => fail Malformed
    }
}

fn decode_exchange(method_id: i64, c: *Cursor) -> Method ! Error {
    match method_id {
        10 => {
            take_u16(c)?
            let exchange = take_short_string(c)?
            let kind = take_short_string(c)?
            let flags = take_u8(c)?
            let args = arguments(c)?
            Method.ExchangeDeclare(exchange, kind, bit(flags, 0), bit(flags, 1), bit(flags, 2), bit(flags, 3), args)
        }
        11 => Method.ExchangeDeclareOk
        20 => {
            take_u16(c)?
            let exchange = take_short_string(c)?
            let flags = take_u8(c)?
            Method.ExchangeDelete(exchange, bit(flags, 0))
        }
        21 => Method.ExchangeDeleteOk
        30 => {
            take_u16(c)?
            let destination = take_short_string(c)?
            let source = take_short_string(c)?
            let key = take_short_string(c)?
            take_u8(c)?
            Method.ExchangeBind(destination, source, key, arguments(c)?)
        }
        31 => Method.ExchangeBindOk
        40 => {
            take_u16(c)?
            let destination = take_short_string(c)?
            let source = take_short_string(c)?
            let key = take_short_string(c)?
            take_u8(c)?
            Method.ExchangeUnbind(destination, source, key, arguments(c)?)
        }
        51 => Method.ExchangeUnbindOk
        _ => fail Malformed
    }
}

fn decode_queue(method_id: i64, c: *Cursor) -> Method ! Error {
    match method_id {
        10 => {
            take_u16(c)?
            let queue = take_short_string(c)?
            let flags = take_u8(c)?
            let args = arguments(c)?
            Method.QueueDeclare(queue, bit(flags, 0), bit(flags, 1), bit(flags, 2), bit(flags, 3), args)
        }
        11 => {
            let queue = take_short_string(c)?
            let messages = take_u32(c)?
            let consumers = take_u32(c)?
            Method.QueueDeclareOk(queue, messages, consumers)
        }
        20 => {
            take_u16(c)?
            let queue = take_short_string(c)?
            let exchange = take_short_string(c)?
            let key = take_short_string(c)?
            take_u8(c)?
            Method.QueueBind(queue, exchange, key, arguments(c)?)
        }
        21 => Method.QueueBindOk
        30 => {
            take_u16(c)?
            let queue = take_short_string(c)?
            take_u8(c)?
            Method.QueuePurge(queue)
        }
        31 => Method.QueuePurgeOk(take_u32(c)?)
        40 => {
            take_u16(c)?
            let queue = take_short_string(c)?
            let flags = take_u8(c)?
            Method.QueueDelete(queue, bit(flags, 0), bit(flags, 1))
        }
        41 => Method.QueueDeleteOk(take_u32(c)?)
        50 => {
            take_u16(c)?
            let queue = take_short_string(c)?
            let exchange = take_short_string(c)?
            let key = take_short_string(c)?
            Method.QueueUnbind(queue, exchange, key, arguments(c)?)
        }
        51 => Method.QueueUnbindOk
        _ => fail Malformed
    }
}

fn decode_basic(method_id: i64, c: *Cursor) -> Method ! Error {
    match method_id {
        10 => {
            let size = take_u32(c)?
            let count = take_u16(c)?
            Method.BasicQos(size, count, bit(take_u8(c)?, 0))
        }
        11 => Method.BasicQosOk
        20 => {
            take_u16(c)?
            let queue = take_short_string(c)?
            let tag = take_short_string(c)?
            let flags = take_u8(c)?
            Method.BasicConsume(queue, tag, bit(flags, 0), bit(flags, 1), bit(flags, 2), arguments(c)?)
        }
        21 => Method.BasicConsumeOk(take_short_string(c)?)
        30 => {
            let tag = take_short_string(c)?
            Method.BasicCancel(tag, bit(take_u8(c)?, 0))
        }
        31 => Method.BasicCancelOk(take_short_string(c)?)
        40 => {
            take_u16(c)?
            let exchange = take_short_string(c)?
            let key = take_short_string(c)?
            let flags = take_u8(c)?
            Method.BasicPublish(exchange, key, bit(flags, 0), bit(flags, 1))
        }
        50 => {
            let code = take_u16(c)?
            let reply = take_short_string(c)?
            let exchange = take_short_string(c)?
            Method.BasicReturn(code, reply, exchange, take_short_string(c)?)
        }
        60 => {
            let tag = take_short_string(c)?
            let delivery_tag = take_i64(c)?
            let redelivered = bit(take_u8(c)?, 0)
            let exchange = take_short_string(c)?
            Method.BasicDeliver(tag, delivery_tag, redelivered, exchange, take_short_string(c)?)
        }
        70 => {
            take_u16(c)?
            let queue = take_short_string(c)?
            Method.BasicGet(queue, bit(take_u8(c)?, 0))
        }
        71 => {
            let delivery_tag = take_i64(c)?
            let redelivered = bit(take_u8(c)?, 0)
            let exchange = take_short_string(c)?
            let key = take_short_string(c)?
            Method.BasicGetOk(delivery_tag, redelivered, exchange, key, take_u32(c)?)
        }
        72 => {
            take_short_string(c)?
            Method.BasicGetEmpty
        }
        80 => {
            let delivery_tag = take_i64(c)?
            Method.BasicAck(delivery_tag, bit(take_u8(c)?, 0))
        }
        90 => {
            let delivery_tag = take_i64(c)?
            Method.BasicReject(delivery_tag, bit(take_u8(c)?, 0))
        }
        110 => Method.BasicRecover(bit(take_u8(c)?, 0))
        111 => Method.BasicRecoverOk
        120 => {
            let delivery_tag = take_i64(c)?
            let flags = take_u8(c)?
            Method.BasicNack(delivery_tag, bit(flags, 0), bit(flags, 1))
        }
        _ => fail Malformed
    }
}

fn decode_confirm(method_id: i64, c: *Cursor) -> Method ! Error {
    match method_id {
        10 => {
            take_u8(c)?
            Method.ConfirmSelect
        }
        11 => Method.ConfirmSelectOk
        _ => fail Malformed
    }
}

fn decode_tx(method_id: i64) -> Method ! Error {
    match method_id {
        10 => Method.TxSelect
        11 => Method.TxSelectOk
        20 => Method.TxCommit
        21 => Method.TxCommitOk
        30 => Method.TxRollback
        31 => Method.TxRollbackOk
        _ => fail Malformed
    }
}

/// Decodes the payload of a method frame.
///
/// Fails with `Malformed` for a class or method this module does not know, a payload that is cut short and a payload with bytes left over.
pub fn decode_method(payload: u8[]) -> Method ! Error {
    let c = cursor(payload)
    let class_id = take_u16(c)?
    let method_id = take_u16(c)?
    let m = match class_id {
        10 => decode_connection(method_id, c)?
        20 => decode_channel(method_id, c)?
        40 => decode_exchange(method_id, c)?
        50 => decode_queue(method_id, c)?
        60 => decode_basic(method_id, c)?
        85 => decode_confirm(method_id, c)?
        90 => decode_tx(method_id)?
        _ => fail Malformed
    }
    end(c)?
    m
}
