import std/base58
import std/text

fn verify(address: str) {
    let payload = base58.decode_check(address) catch {
        BadCharacter(at) => {
            print("{address}: bad character at {at}")
            return
        }
        BadChecksum => {
            print("{address}: checksum mismatch")
            return
        }
        TooShort => {
            print("{address}: too short")
            return
        }
    }
    print("{address}: version {payload[0]}, hash {text.encode_hex(payload[1..])}")
}

/// Encodes a version byte and a 20-byte hash with a checksum, then verifies the address and three corrupted copies.
fn main() {
    let payload = text.decode_hex("0077bff20c60e522dfaa3350c39b030a5d004e839a") or bytes("")
    let address = base58.encode_check(payload)
    print(address)

    verify(address)
    verify("1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN3")
    verify("1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN0")
    verify("11")

    let plain = base58.encode(payload)
    print(plain)
    let flickr = base58.encode_flickr(payload)
    print(flickr)
    let back = base58.decode_flickr(flickr) or bytes("")
    print(text.encode_hex(back))
}
