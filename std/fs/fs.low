extern "c" {
    fn open(path: ptr[u8], flags: i32, mode: i32) -> i32
    fn read(fd: i32, buf: ptr, n: i64) -> i64
    fn write(fd: i32, buf: ptr, n: i64) -> i64
    fn close(fd: i32) -> i32
    fn unlink(path: ptr[u8]) -> i32
    fn mkdir(path: ptr[u8], mode: i32) -> i32
    fn rmdir(path: ptr[u8]) -> i32
    fn rename(from: ptr[u8], to: ptr[u8]) -> i32
    fn access(path: ptr[u8], mode: i32) -> i32
    fn opendir(path: ptr[u8]) -> ptr
    fn readdir(dir: ptr) -> ptr[u8]
    fn closedir(dir: ptr) -> i32
    fn malloc(n: i64) -> ptr
    fn realloc(p: ptr, n: i64) -> ptr
    fn free(p: ptr)
    fn errno_location() -> ptr[i32] = "__errno_location"
}

pub enum FsError {
    NotFound
    Denied
    Exists
    IsDirectory
    NotDirectory
    NotEmpty
    Other(i64)
}

struct Buffer {
    data: ptr
    drop free(data)
}

struct Descriptor {
    fd: i32
    drop close(fd)
}

struct Directory {
    handle: ptr
    drop closedir(handle)
}

fn errno() -> i64 {
    i64(load(errno_location()))
}

fn failure() -> FsError {
    match errno() {
        == 2 => NotFound
        == 1 || == 13 => Denied
        == 17 => Exists
        == 21 => IsDirectory
        == 20 => NotDirectory
        == 39 => NotEmpty
        _ => Other(errno())
    }
}

fn interrupted() -> bool {
    errno() == 4
}

fn opened(path: str, flags: i32) -> Descriptor ! FsError {
    for {
        let fd = open(cstr(path), flags, 420)
        if fd >= 0 {
            return Descriptor { fd: fd }
        }
        if !interrupted() {
            fail failure()
        }
    }
}

pub fn read_file(path: str) -> str ! FsError {
    using file = opened(path, 524288)?
    var size = 65536
    var total = 0
    using var buffer = Buffer { data: malloc(size) }
    for {
        if total == size {
            size *= 2
            buffer.data = realloc(buffer.data, size)
        }
        let bytes: ptr[u8] = buffer.data
        let window = view(bytes, size)
        let at = pin(window[total..size])
        let n = read(file.fd, at, size - total)
        unpin(at)
        if n == 0 {
            return str(window[0..total])
        }
        if n > 0 {
            total += n
        } else if !interrupted() {
            fail failure()
        }
    }
}

fn written(path: str, data: str, flags: i32) ! FsError {
    using file = opened(path, flags)?
    var done = 0
    for done < data.len {
        let at = pin(data[done..data.len])
        let n = write(file.fd, at, data.len - done)
        unpin(at)
        if n > 0 {
            done += n
        } else if !interrupted() {
            fail failure()
        }
    }
}

pub fn write_file(path: str, data: str) ! FsError {
    written(path, data, 524865)?
}

pub fn append_file(path: str, data: str) ! FsError {
    written(path, data, 525377)?
}

pub fn exists(path: str) -> bool {
    access(cstr(path), 0) == 0
}

pub fn remove(path: str) ! FsError {
    if unlink(cstr(path)) != 0 {
        fail failure()
    }
}

pub fn make_dir(path: str) ! FsError {
    if mkdir(cstr(path), 493) != 0 {
        fail failure()
    }
}

pub fn remove_dir(path: str) ! FsError {
    if rmdir(cstr(path)) != 0 {
        fail failure()
    }
}

pub fn rename_path(from: str, to: str) ! FsError {
    if rename(cstr(from), cstr(to)) != 0 {
        fail failure()
    }
}

fn entry_name(entry: ptr[u8]) -> str {
    let record = view(entry, 275)
    var end = 19
    for record[end] != 0 {
        end += 1
    }
    str(record[19..end])
}

pub fn list_dir(path: str) -> []str ! FsError {
    let handle = opendir(cstr(path))
    if handle == null {
        fail failure()
    }
    using dir = Directory { handle: handle }
    var names: []str = []
    for {
        let entry = readdir(dir.handle)
        if entry == null {
            return names
        }
        let name = entry_name(entry)
        if name != "." && name != ".." {
            push(mut names, name)
        }
    }
}
