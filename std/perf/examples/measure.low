import std/io
import std/os
import std/perf
import std/process

fn work() {
    var total = 0
    for step in 0..20000000 {
        total += step % 7
    }
    print("work done: {total}")
}

fn instructions_of(pid: i64) -> perf.Counter? {
    let counter = perf.counter(pid, perf.instructions()) or return none
    counter
}

fn counted(counter: perf.Counter?) -> i64 {
    perf.count(counter ?? return -1) or -1
}

/// Starts itself held, opens an instruction counter on the stopped process, lets it run and reports what it used: the counter where the machine counts instructions for this user, and the processor time and peak memory everywhere.
fn main() ! io.Error {
    if os.args().len > 1 {
        work()
        return
    }

    let command = perf.held(process.command(os.executable()?, ["work"]))?
    using child = process.start(command)?
    let pid = child.handle.pid
    perf.await_held(pid)?
    let counter = instructions_of(pid)
    perf.release(pid)?
    for !perf.exited(pid) {
        sleep(1)
    }

    let instructions = counted(counter)
    let used = perf.usage(pid) ?? fail Invalid
    print("instructions counted or refused: {instructions > 20000000 || instructions == -1}")
    print("used processor time: {used.user + used.kernel > 0}")
    print("peak resident memory: {used.peak_resident > 0}")
    print("ended well: {process.success(process.wait(child)?)}")
}
