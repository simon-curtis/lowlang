import std/dbus
import std/portal

/// Builds the `OpenFile` call that asks the desktop portal for an image file, and prints where it goes, the signature of its body and the filters it carries.
fn main() ! dbus.Error {
    let dialog = portal.FileDialog {
        title: "Open picture",
        multiple: true,
        filters: [portal.FileFilter { name: "Images", globs: ["*.png", "*.jpg"], mime_types: ["image/gif"] }],
    }
    let call = portal.open_file_call(dialog, "picker1")
    print("{call.destination} {call.interface}.{call.member}")
    print("signature {dbus.values_signature(call.body)?}")
    print("request {portal.request_path(":1.42", "picker1")}")
    let options = dbus.dict_of(call.body[2])?
    print("options {options.len}")
}
