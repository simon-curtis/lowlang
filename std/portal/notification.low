import std/dbus

const notification_interface = "org.freedesktop.portal.Notification"

/// How urgent a notification is.
pub enum Priority {
    /// Shown quietly.
    Low
    /// The default.
    Normal
    /// Shown prominently.
    High
    /// Shown until the user acts, even when the user does not want to be disturbed.
    Urgent
}

/// A button on a notification.
pub struct NotificationButton {
    /// The text on the button.
    pub label: str
    /// The action name `action_invoked` reports when the user presses it.
    pub action: str
}

/// A notification for `add_notification`.
pub struct Notification {
    /// The title.
    pub title: str
    /// The body text.
    pub body: str = ""
    /// The icon's name in the user's icon theme, or empty for none.
    pub icon_name: str = ""
    /// How urgent it is.
    pub priority: Priority = Priority.Normal
    /// The action reported when the user activates the notification itself, or empty for none.
    pub default_action: str = ""
    /// The buttons below the body.
    pub buttons: NotificationButton[] = []
}

fn priority_name(p: Priority) -> str {
    match p {
        Low => "low"
        Normal => "normal"
        High => "high"
        Urgent => "urgent"
    }
}

fn button_value(b: NotificationButton) -> dbus.Value {
    dbus.dict(["label": dbus.Value.String(b.label), "action": dbus.Value.String(b.action)])
}

fn notification_value(n: Notification) -> dbus.Value {
    let entries: [str: dbus.Value] = ["title": dbus.Value.String(n.title)]
    if n.body.len > 0 {
        entries["body"] = dbus.Value.String(n.body)
    }
    if n.icon_name.len > 0 {
        entries["icon"] = dbus.Value.Struct([dbus.Value.String("themed"), dbus.variant(dbus.strings([n.icon_name]))])
    }
    entries["priority"] = dbus.Value.String(priority_name(n.priority))
    if n.default_action.len > 0 {
        entries["default-action"] = dbus.Value.String(n.default_action)
    }
    if n.buttons.len > 0 {
        var buttons: dbus.Value[] = []
        for b in n.buttons {
            buttons.push(button_value(b))
        }
        entries["buttons"] = dbus.Value.Array("a{{sv}}", buttons)
    }
    dbus.dict(entries)
}

/// Returns the `AddNotification` method call that shows `n` under the application-chosen `id`, which `add_notification` sends.
pub fn add_notification_call(id: str, n: Notification) -> dbus.Message {
    dbus.method_call(portal_name, portal_path, notification_interface, "AddNotification", [dbus.Value.String(id), notification_value(n)])
}

/// Shows `n` under `id`, replacing the notification that has that `id`.
///
/// Fails with `Remote` when the portal rejects it and with `Timeout` after `p.timeout_ms`.
pub fn add_notification(p: Portal, id: str, n: Notification) ! dbus.Error {
    dbus.call_with_on(p.handle, add_notification_call(id, n), dbus.CallOptions { timeout: p.timeout_ms })?
}

/// Withdraws the notification `id`.
///
/// Fails as `add_notification` does.
pub fn remove_notification(p: Portal, id: str) ! dbus.Error {
    let ask = dbus.method_call(portal_name, portal_path, notification_interface, "RemoveNotification", [dbus.Value.String(id)])
    dbus.call_with_on(p.handle, ask, dbus.CallOptions { timeout: p.timeout_ms })?
}

/// A press of a notification's button or of the notification itself, from the `ActionInvoked` signal.
pub struct ActionInvoked {
    /// The `id` the notification was added under.
    pub id: str
    /// The `action` of the button, or the notification's `default_action`.
    pub action: str
}

/// Returns the stream of `ActionInvoked` signals, which `action_invoked` reads.
///
/// End the stream with `dbus.unsubscribe_on`. Fails as `dbus.subscribe_on` does.
pub fn watch_actions(p: Portal) -> *dbus.Subscription ! dbus.Error {
    dbus.subscribe_on(p.handle, dbus.signal_rule(portal_path, notification_interface, "ActionInvoked"))?
}

/// Returns the action the `ActionInvoked` signal `m` reports.
///
/// Fails with `Malformed` when `m` does not start with an id and an action.
pub fn action_invoked(m: dbus.Message) -> ActionInvoked ! dbus.Error {
    if m.body.len < 2 {
        fail dbus.Error.Malformed("ActionInvoked carries {m.body.len} values, not an id and an action")
    }
    ActionInvoked { id: dbus.string_of(m.body[0])?, action: dbus.string_of(m.body[1])? }
}
