import std/cancel
import std/dbus

const open_uri_interface = "org.freedesktop.portal.OpenURI"

/// How `open_uri` asks the portal to open a link.
pub struct UriRequest {
    /// The window the request belongs to, as `FileDialog.parent_window` says, or empty for none.
    pub parent_window: str = ""
    /// Whether the application the link opens in may write to a file the link names.
    pub writable: bool = false
    /// Whether the portal always asks the user which application opens the link.
    pub ask: bool = false
    /// The handle token of the request, or empty to take a fresh one.
    pub token: str = ""
    /// Cancelling it closes the request and fails the call with `Cancelled`.
    pub cancel: *cancel.Token? = none
}

/// Returns the `OpenURI` method call for `uri` and `r` with the handle token `token`, which `open_uri` sends.
pub fn open_uri_call(uri: str, r: UriRequest, token: str) -> dbus.Message {
    var options: [str: dbus.Value] = ["handle_token": dbus.Value.String(token)]
    if r.writable {
        options["writable"] = dbus.Value.Boolean(true)
    }
    if r.ask {
        options["ask"] = dbus.Value.Boolean(true)
    }
    dbus.method_call(portal_name, portal_path, open_uri_interface, "OpenURI", [dbus.Value.String(r.parent_window), dbus.Value.String(uri), dbus.dict(options)])
}

/// Asks the portal to open `uri` in the application the user has chosen for it and waits for the portal's answer.
///
/// Returns `false` when the user closes the application chooser. Fails with `Cancelled` when `r.cancel` is cancelled, with `Remote` when the portal rejects the request or reports a failure, and with the errors of `request` otherwise.
pub fn open_uri(p: Portal, uri: str, r: UriRequest) -> bool ! dbus.Error {
    let token = fresh_token(p, r.token)
    let response = request(p, open_uri_call(uri, r, token), token, r.cancel)?
    match response.code {
        0 => true
        1 => false
        _ => fail refused(response)
    }
}
