import std/dbus
import std/file
import std/testing
import std/text

fn hex_of(data: u8[]) -> str {
    var out: u8[] = []
    for b in data {
        text.append_hex(mut out, i64(b), 2, false)
    }
    str(out)
}

fn fixture(t: *testing.T, name: str) -> str {
    let contents = file.read_text("testdata/portal/{name}.hex") catch {
        e => {
            t.fatal("read {name}.hex: {e}")
            return ""
        }
    }
    text.trim(contents)
}

fn body_hex(t: *testing.T, m: dbus.Message) -> str {
    let encoded = dbus.encode(m.body, dbus.ByteOrder.Little) catch {
        e => {
            t.fatal("encode {m.member}: {e}")
            return ""
        }
    }
    hex_of(encoded.data)
}

fn images() -> FileFilter {
    FileFilter { name: "Images", globs: ["*.png", "*.jpg"], mime_types: ["image/gif"] }
}

fn plain_text() -> FileFilter {
    FileFilter { name: "Text", mime_types: ["text/plain"] }
}

fn test_open_file_marshals_as_jeepney_does(t: *testing.T) {
    let call = open_file_call(FileDialog {
        parent_window: "wayland:abc123",
        title: "Open picture",
        accept_label: "Choose",
        multiple: true,
        filters: [images(), plain_text()],
        current_filter: some(plain_text()),
        current_folder: "/home/me/pictures",
    }, "low1")
    testing.equal(t, body_hex(t, call), fixture(t, "open_file"))
    testing.equal(t, call.destination, "org.freedesktop.portal.Desktop")
    testing.equal(t, call.path, "/org/freedesktop/portal/desktop")
    testing.equal(t, call.interface, "org.freedesktop.portal.FileChooser")
    testing.equal(t, call.member, "OpenFile")
}

fn test_save_file_marshals_as_jeepney_does(t: *testing.T) {
    let call = save_file_call(FileDialog {
        parent_window: "x11:2a00007",
        title: "Save as",
        modal: false,
        multiple: true,
        directory: true,
        filters: [plain_text()],
        current_name: "notes.txt",
        current_folder: "/tmp",
        current_file: "/tmp/notes.txt",
    }, "low2")
    testing.equal(t, body_hex(t, call), fixture(t, "save_file"))
    testing.equal(t, call.member, "SaveFile")
}

fn test_open_uri_marshals_as_jeepney_does(t: *testing.T) {
    let call = open_uri_call("https://example.org/a b", UriRequest { writable: true, ask: true }, "low3")
    testing.equal(t, body_hex(t, call), fixture(t, "open_uri"))
    testing.equal(t, call.interface, "org.freedesktop.portal.OpenURI")
}

fn test_read_marshals_as_jeepney_does(t: *testing.T) {
    let call = read_setting_call("org.freedesktop.appearance", "color-scheme")
    testing.equal(t, body_hex(t, call), fixture(t, "read_setting"))
    testing.equal(t, call.interface, "org.freedesktop.portal.Settings")
}

fn test_add_notification_marshals_as_jeepney_does(t: *testing.T) {
    let call = add_notification_call("mail-1", Notification {
        title: "New mail",
        body: "Three messages",
        icon_name: "mail-unread",
        priority: Priority.High,
        default_action: "open",
        buttons: [NotificationButton { label: "Reply", action: "reply" }, NotificationButton { label: "Archive", action: "archive" }],
    })
    testing.equal(t, body_hex(t, call), fixture(t, "add_notification"))
    testing.equal(t, call.interface, "org.freedesktop.portal.Notification")
}

fn test_a_request_path_follows_the_specification(t: *testing.T) {
    testing.equal(t, request_path(":1.42", "token"), "/org/freedesktop/portal/desktop/request/1_42/token")
}

fn reply_of(body: dbus.Value[]) -> dbus.Message {
    dbus.Message { kind: dbus.MessageType.MethodReturn, body }
}

fn nested(v: dbus.Value) -> dbus.Value {
    dbus.variant(dbus.variant(v))
}

fn test_the_portal_nests_a_setting_in_two_variants(t: *testing.T) {
    let on = dbus.bool_of(setting_of(reply_of([nested(dbus.Value.Boolean(true))])) or panic("on")) or panic("on bool")
    let off = dbus.bool_of(setting_of(reply_of([nested(dbus.Value.Boolean(false))])) or panic("off")) or panic("off bool")
    testing.is_true(t, on)
    testing.is_false(t, off)
}

fn test_one_variant_is_enough(t: *testing.T) {
    let v = setting_of(reply_of([dbus.variant(dbus.Value.String("x"))])) or panic("one")
    testing.equal(t, dbus.string_of(v) or "", "x")
}

fn test_a_reply_with_no_value_fails(t: *testing.T) {
    setting_of(reply_of([])) catch {
        e => return
    }
    t.error("a reply with no value was accepted")
}

fn test_the_color_scheme_follows_the_specification(t: *testing.T) {
    testing.equal(t, scheme_of(dbus.Value.UInt32(0)) or ColorScheme.Light, ColorScheme.NoPreference)
    testing.equal(t, scheme_of(dbus.Value.UInt32(1)) or ColorScheme.Light, ColorScheme.Dark)
    testing.equal(t, scheme_of(dbus.Value.UInt32(2)) or ColorScheme.Dark, ColorScheme.Light)
}

fn rgb_of(r: f64, g: f64, b: f64) -> dbus.Value {
    dbus.Value.Struct([dbus.Value.Double(r), dbus.Value.Double(g), dbus.Value.Double(b)])
}

fn test_an_accent_colour_outside_the_unit_range_is_none(t: *testing.T) {
    let set = accent_of(rgb_of(0.25, 0.5, 1.0)) or panic("set")
    testing.equal(t, (set ?? AccentColor { r: 0.0, g: 0.0, b: 0.0 }).g, 0.5)
    testing.is_true(t, (accent_of(rgb_of(-1.0, -1.0, -1.0)) or panic("unset")) == none)
}

fn test_a_setting_change_reads_its_namespace_key_and_value(t: *testing.T) {
    let m = dbus.Message {
        kind: dbus.MessageType.Signal,
        body: [dbus.Value.String("org.freedesktop.appearance"), dbus.Value.String("color-scheme"), dbus.variant(dbus.Value.UInt32(1))],
    }
    let change = setting_change(m) or panic("change")
    testing.equal(t, change.namespace, "org.freedesktop.appearance")
    testing.equal(t, change.key, "color-scheme")
    testing.equal(t, dbus.uint_of(change.value) or 99, 1)
}

fn test_a_response_reads_its_code_and_results(t: *testing.T) {
    let m = dbus.Message {
        kind: dbus.MessageType.Signal,
        body: [dbus.Value.UInt32(1), dbus.dict(["uris": dbus.strings(["file:///a"])])],
    }
    let r = parse_response(m) or panic("response")
    testing.equal(t, r.code, 1)
    testing.is_true(t, r.results["uris"] != none)
}

fn test_a_selection_reads_its_uris_and_filter(t: *testing.T) {
    let filter = filter_value(images())
    let r = Response { code: 0, results: ["uris": dbus.strings(["file:///a.png", "file:///b.png"]), "current_filter": filter] }
    let s = selection_of(r) or panic("selection")
    testing.equal_slice(t, s.uris, ["file:///a.png", "file:///b.png"])
    let chosen = s.filter ?? FileFilter { name: "" }
    testing.equal(t, chosen.name, "Images")
    testing.equal_slice(t, chosen.globs, ["*.png", "*.jpg"])
    testing.equal_slice(t, chosen.mime_types, ["image/gif"])
}

fn test_an_action_reads_its_id_and_action(t: *testing.T) {
    let m = dbus.Message {
        kind: dbus.MessageType.Signal,
        body: [dbus.Value.String("mail-1"), dbus.Value.String("reply"), dbus.Value.Array("v", [])],
    }
    let a = action_invoked(m) or panic("action")
    testing.equal(t, a.id, "mail-1")
    testing.equal(t, a.action, "reply")
}
