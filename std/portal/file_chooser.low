import std/cancel
import std/dbus

const file_chooser_interface = "org.freedesktop.portal.FileChooser"
const glob_pattern = 0
const mime_pattern = 1

/// A file type the file chooser offers: a name and the patterns that select it.
pub struct FileFilter {
    /// The name shown to the user.
    pub name: str
    /// Glob patterns such as `*.png`.
    pub globs: str[] = []
    /// MIME types such as `image/png`.
    pub mime_types: str[] = []
}

/// What a file chooser dialog looks like and where it starts.
///
/// `multiple` and `directory` apply to `open_file`; `current_name` and `current_file` apply to `save_file`.
pub struct FileDialog {
    /// The window the dialog belongs to, as the portal names it: `x11:` and the window id in hexadecimal, `wayland:` and an exported toplevel handle, or empty for none.
    pub parent_window: str = ""
    /// The dialog's title.
    pub title: str = ""
    /// The text of the confirm button, or empty for the portal's own.
    pub accept_label: str = ""
    /// Whether the dialog blocks its parent.
    pub modal: bool = true
    /// Whether `open_file` lets the user choose more than one file.
    pub multiple: bool = false
    /// Whether `open_file` chooses folders.
    pub directory: bool = false
    /// The file types the user can choose between.
    pub filters: FileFilter[] = []
    /// The filter selected at first, one of `filters` or another.
    pub current_filter: FileFilter? = none
    /// The file name `save_file` suggests.
    pub current_name: str = ""
    /// The folder the dialog opens in, as a path.
    pub current_folder: str = ""
    /// The file `save_file` suggests, as a path, for a name in `current_folder` that exists.
    pub current_file: str = ""
    /// The handle token of the request, or empty to take a fresh one. A token holds letters, digits and underscores.
    pub token: str = ""
    /// Cancelling it closes the dialog and fails the call with `Cancelled`.
    pub cancel: *cancel.Token? = none
}

/// What the user chose in a file chooser dialog.
pub struct Selection {
    /// The chosen files or folders as `file://` URIs.
    pub uris: str[]
    /// The filter selected when the dialog closed, when the portal reports one.
    pub filter: FileFilter?
}

fn filter_value(f: FileFilter) -> dbus.Value {
    var patterns: dbus.Value[] = []
    for glob in f.globs {
        patterns.push(dbus.Value.Struct([dbus.Value.UInt32(u32(glob_pattern)), dbus.Value.String(glob)]))
    }
    for mime in f.mime_types {
        patterns.push(dbus.Value.Struct([dbus.Value.UInt32(u32(mime_pattern)), dbus.Value.String(mime)]))
    }
    dbus.Value.Struct([dbus.Value.String(f.name), dbus.Value.Array("(us)", patterns)])
}

fn path_bytes(path: str) -> dbus.Value {
    var data = bytes(path)
    data.push(0)
    dbus.Value.Bytes(data)
}

fn dialog_options(d: FileDialog, token: str, saving: bool) -> [str: dbus.Value] {
    var options: [str: dbus.Value] = ["handle_token": dbus.Value.String(token), "modal": dbus.Value.Boolean(d.modal)]
    if d.accept_label.len > 0 {
        options["accept_label"] = dbus.Value.String(d.accept_label)
    }
    if !saving {
        options["multiple"] = dbus.Value.Boolean(d.multiple)
        options["directory"] = dbus.Value.Boolean(d.directory)
    }
    if d.filters.len > 0 {
        var filters: dbus.Value[] = []
        for f in d.filters {
            filters.push(filter_value(f))
        }
        options["filters"] = dbus.Value.Array("(sa(us))", filters)
    }
    match d.current_filter {
        some(f) => { options["current_filter"] = filter_value(f) }
        none => {}
    }
    if saving && d.current_name.len > 0 {
        options["current_name"] = dbus.Value.String(d.current_name)
    }
    if d.current_folder.len > 0 {
        options["current_folder"] = path_bytes(d.current_folder)
    }
    if saving && d.current_file.len > 0 {
        options["current_file"] = path_bytes(d.current_file)
    }
    options
}

fn dialog_call(member: str, d: FileDialog, token: str, saving: bool) -> dbus.Message {
    dbus.method_call(portal_name, portal_path, file_chooser_interface, member, [
        dbus.Value.String(d.parent_window),
        dbus.Value.String(d.title),
        dbus.dict(dialog_options(d, token, saving)),
    ])
}

/// Returns the `OpenFile` method call for `d` with the handle token `token`, which `open_file` sends.
pub fn open_file_call(d: FileDialog, token: str) -> dbus.Message {
    dialog_call("OpenFile", d, token, false)
}

/// Returns the `SaveFile` method call for `d` with the handle token `token`, which `save_file` sends.
pub fn save_file_call(d: FileDialog, token: str) -> dbus.Message {
    dialog_call("SaveFile", d, token, true)
}

fn filter_of(v: dbus.Value) -> FileFilter ! dbus.Error {
    let fields = dbus.fields_of(v)?
    if fields.len != 2 {
        fail dbus.Error.Malformed("a filter has {fields.len} fields, not two")
    }
    var filter = FileFilter { name: dbus.string_of(fields[0])? }
    for item in dbus.array_of(fields[1])? {
        let pattern = dbus.fields_of(item)?
        if pattern.len != 2 {
            fail dbus.Error.Malformed("a filter pattern has {pattern.len} fields, not two")
        }
        let text = dbus.string_of(pattern[1])?
        if i64(dbus.uint_of(pattern[0])?) == glob_pattern {
            filter.globs.push(text)
        } else {
            filter.mime_types.push(text)
        }
    }
    filter
}

fn selection_of(r: Response) -> Selection ! dbus.Error {
    var uris: str[] = []
    match r.results["uris"] {
        some(v) => {
            for item in dbus.array_of(v)? {
                uris.push(dbus.string_of(item)?)
            }
        }
        none => {}
    }
    let filter: FileFilter? = match r.results["current_filter"] {
        some(v) => some(filter_of(v)?)
        none => none
    }
    Selection { uris, filter }
}

fn choose(p: Portal, ask: dbus.Message, token: str, stop: *cancel.Token?) -> Selection? ! dbus.Error {
    let r = request(p, ask, token, stop)?
    match r.code {
        0 => some(selection_of(r)?)
        1 => none
        _ => fail refused(r)
    }
}

/// Shows the portal's open dialog for `d` and waits for the user.
///
/// Returns `none` when the user closes the dialog without choosing. Fails with `Cancelled` when `d.cancel` is cancelled, with `Remote` when the portal rejects the request or reports a failure, and with the errors of `request` otherwise.
pub fn open_file(p: Portal, d: FileDialog) -> Selection? ! dbus.Error {
    let token = fresh_token(p, d.token)
    choose(p, open_file_call(d, token), token, d.cancel)?
}

/// Shows the portal's save dialog for `d` and waits for the user.
///
/// Fails and returns `none` as `open_file` does.
pub fn save_file(p: Portal, d: FileDialog) -> Selection? ! dbus.Error {
    let token = fresh_token(p, d.token)
    choose(p, save_file_call(d, token), token, d.cancel)?
}
