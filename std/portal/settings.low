import std/dbus

const settings_interface = "org.freedesktop.portal.Settings"
const appearance = "org.freedesktop.appearance"
const gnome_interface = "org.gnome.desktop.interface"

/// The colour scheme the user prefers, as `org.freedesktop.appearance` `color-scheme` says.
pub enum ColorScheme {
    /// The user has no preference.
    NoPreference
    /// The user prefers a dark appearance.
    Dark
    /// The user prefers a light appearance.
    Light
}

/// The user's accent colour, each channel from `0.0` to `1.0` in sRGB.
pub struct AccentColor {
    /// The red channel.
    pub r: f64
    /// The green channel.
    pub g: f64
    /// The blue channel.
    pub b: f64
}

/// A setting that changed, from the `SettingChanged` signal.
pub struct SettingChange {
    /// The namespace of the setting, such as `org.freedesktop.appearance`.
    pub namespace: str
    /// The key of the setting within its namespace.
    pub key: str
    /// The new value, unwrapped from its variants.
    pub value: dbus.Value
}

fn plain(v: dbus.Value) -> dbus.Value ! dbus.Error {
    var inner = v
    for {
        match inner {
            Variant(next) => { inner = *next }
            _ => return inner
        }
    }
}

/// Returns the `Read` method call for the setting `key` of `namespace`, which `read_setting` sends.
pub fn read_setting_call(namespace: str, key: str) -> dbus.Message {
    dbus.method_call(portal_name, portal_path, settings_interface, "Read", [dbus.Value.String(namespace), dbus.Value.String(key)])
}

/// Returns the value of the setting `key` in `namespace`, unwrapped from its variants.
///
/// Waits at most `p.timeout_ms`. Fails with `Remote` when the portal has no such setting, with `Timeout` when it does not answer in time, and with `Malformed` when the reply is not one value.
pub fn read_setting(p: Portal, namespace: str, key: str) -> dbus.Value ! dbus.Error {
    setting_of(dbus.call_with_on(p.handle, read_setting_call(namespace, key), dbus.CallOptions { timeout: p.timeout_ms })?)?
}

fn setting_of(reply: dbus.Message) -> dbus.Value ! dbus.Error {
    if reply.body.len != 1 {
        fail dbus.Error.Malformed("the settings portal answered with {reply.body.len} values")
    }
    plain(reply.body[0])?
}

fn scheme_of(v: dbus.Value) -> ColorScheme ! dbus.Error {
    match dbus.uint_of(v)? {
        1 => ColorScheme.Dark
        2 => ColorScheme.Light
        _ => ColorScheme.NoPreference
    }
}

/// Returns the user's colour scheme preference.
///
/// Fails as `read_setting` does, and with `Marshal` when the value is not an unsigned integer.
pub fn color_scheme(p: Portal) -> ColorScheme ! dbus.Error {
    scheme_of(read_setting(p, appearance, "color-scheme")?)?
}

fn accent_of(v: dbus.Value) -> AccentColor? ! dbus.Error {
    let channels = dbus.fields_of(v)?
    if channels.len != 3 {
        fail dbus.Error.Malformed("an accent colour has {channels.len} channels, not three")
    }
    let r = dbus.double_of(channels[0])?
    let g = dbus.double_of(channels[1])?
    let b = dbus.double_of(channels[2])?
    if r < 0.0 || r > 1.0 || g < 0.0 || g > 1.0 || b < 0.0 || b > 1.0 {
        return none
    }
    some(AccentColor { r, g, b })
}

/// Returns the user's accent colour, or `none` when the user has none, which the portal reports as a channel outside `0.0` to `1.0`.
///
/// Fails as `read_setting` does, and with `Marshal` when the value is not three doubles.
pub fn accent_color(p: Portal) -> AccentColor? ! dbus.Error {
    accent_of(read_setting(p, appearance, "accent-color")?)?
}

/// Returns whether the user has animations enabled, from the `enable-animations` setting of `org.gnome.desktop.interface`, which is the reduced motion preference turned around.
///
/// Fails as `read_setting` does, and with `Marshal` when the value is not a boolean.
pub fn animations_enabled(p: Portal) -> bool ! dbus.Error {
    dbus.bool_of(read_setting(p, gnome_interface, "enable-animations")?)?
}

/// Returns the stream of `SettingChanged` signals for `namespace`, or for every namespace when it is empty.
///
/// Read each signal with `setting_change`, and end the stream with `dbus.unsubscribe_on`. Fails as `dbus.subscribe_on` does.
pub fn watch_settings(p: Portal, namespace: str) -> *dbus.Subscription ! dbus.Error {
    let rule = dbus.signal_rule(portal_path, settings_interface, "SettingChanged")
    if namespace.len > 0 {
        rule.args[0] = namespace
    }
    dbus.subscribe_on(p.handle, rule)?
}

/// Returns the change the `SettingChanged` signal `m` reports.
///
/// Fails with `Malformed` when `m` does not carry a namespace, a key and a value.
pub fn setting_change(m: dbus.Message) -> SettingChange ! dbus.Error {
    if m.body.len != 3 {
        fail dbus.Error.Malformed("SettingChanged carries {m.body.len} values, not three")
    }
    SettingChange { namespace: dbus.string_of(m.body[0])?, key: dbus.string_of(m.body[1])?, value: plain(m.body[2])? }
}
