import std/io
import std/text

struct Header {
    format: Format
    ino: i64
    mode: i64
    uid: i64
    gid: i64
    nlink: i64
    mtime: i64
    size: i64
    dev_major: i64
    dev_minor: i64
    rdev_major: i64
    rdev_minor: i64
    name_size: i64
    check: i64
    length: i64
}

const newc_length = 110
const odc_length = 76
const trailer = "TRAILER!!!"

fn padding(n: i64) -> i64 {
    (4 - n % 4) % 4
}

fn digit(c: u8, base: i64) -> i64 ! io.Error {
    var d = 99
    if c >= '0' && c <= '9' {
        d = i64(c - '0')
    } else if c >= 'A' && c <= 'F' {
        d = i64(c - 'A') + 10
    } else if c >= 'a' && c <= 'f' {
        d = i64(c - 'a') + 10
    }
    if d >= base {
        fail Malformed
    }
    d
}

fn number(b: []u8, at: i64, width: i64, base: i64) -> i64 ! io.Error {
    var v = 0
    for i in at..at + width {
        v = v * base + digit(b[i], base)?
    }
    v
}

fn parse_magic(magic: []u8) -> Format ! io.Error {
    let text = str(magic)
    if text == "070701" {
        return Newc
    }
    if text == "070702" {
        return Crc
    }
    if text == "070707" {
        return Odc
    }
    let word = io.uint_be(magic, 0, 2)
    if word == 0xC771 || word == 0x71C7 {
        fail Unsupported
    }
    fail Malformed
}

fn parse_newc(format: Format, b: []u8) -> Header ! io.Error {
    Header {
        format
        ino: number(b, 0, 8, 16)?
        mode: number(b, 8, 8, 16)?
        uid: number(b, 16, 8, 16)?
        gid: number(b, 24, 8, 16)?
        nlink: number(b, 32, 8, 16)?
        mtime: number(b, 40, 8, 16)?
        size: number(b, 48, 8, 16)?
        dev_major: number(b, 56, 8, 16)?
        dev_minor: number(b, 64, 8, 16)?
        rdev_major: number(b, 72, 8, 16)?
        rdev_minor: number(b, 80, 8, 16)?
        name_size: number(b, 88, 8, 16)?
        check: number(b, 96, 8, 16)?
        length: newc_length
    }
}

fn parse_odc(b: []u8) -> Header ! io.Error {
    let dev = number(b, 0, 6, 8)?
    let rdev = number(b, 36, 6, 8)?
    Header {
        format: Odc
        ino: number(b, 6, 6, 8)?
        mode: number(b, 12, 6, 8)?
        uid: number(b, 18, 6, 8)?
        gid: number(b, 24, 6, 8)?
        nlink: number(b, 30, 6, 8)?
        mtime: number(b, 42, 11, 8)?
        size: number(b, 59, 11, 8)?
        dev_major: dev >> 8
        dev_minor: dev & 0xFF
        rdev_major: rdev >> 8
        rdev_minor: rdev & 0xFF
        name_size: number(b, 53, 6, 8)?
        check: 0
        length: odc_length
    }
}

fn kind_of(mode: i64) -> Kind ! io.Error {
    let kinds: []Kind = [File, Dir, Symlink, Char, Block, Fifo, Socket]
    let format = mode & 0o170000
    for k in kinds {
        if type_bits(k) == format {
            return k
        }
    }
    fail Malformed
}

fn type_bits(kind: Kind) -> i64 {
    match kind {
        File => 0o100000
        Dir => 0o040000
        Symlink => 0o120000
        Char => 0o020000
        Block => 0o060000
        Fifo => 0o010000
        Socket => 0o140000
    }
}

fn fits(v: i64, width: i64, base: i64) -> bool {
    var limit = 1
    for _ in 0..width {
        limit *= base
    }
    v >= 0 && v < limit
}

fn put_number(mut out: []u8, v: i64, width: i64, base: i64) ! io.Error {
    if !fits(v, width, base) {
        fail TooLarge
    }
    let digits = "0123456789ABCDEF"
    let at = out.len
    for _ in 0..width {
        push(mut out, '0')
    }
    var x = v
    var i = at + width - 1
    for i >= at {
        out[i] = digits[x % base]
        x = x / base
        i -= 1
    }
}

fn put_name(mut out: []u8, name: str) {
    text.append(mut out, name)
    push(mut out, 0)
}

fn put_header(h: Header, name: str) -> []u8 ! io.Error {
    var out: []u8 = []
    match h.format {
        Odc => {
            text.append(mut out, "070707")
            put_number(mut out, h.dev_major << 8 | h.dev_minor, 6, 8)?
            put_number(mut out, h.ino, 6, 8)?
            put_number(mut out, h.mode, 6, 8)?
            put_number(mut out, h.uid, 6, 8)?
            put_number(mut out, h.gid, 6, 8)?
            put_number(mut out, h.nlink, 6, 8)?
            put_number(mut out, h.rdev_major << 8 | h.rdev_minor, 6, 8)?
            put_number(mut out, h.mtime, 11, 8)?
            put_number(mut out, name.len + 1, 6, 8)?
            put_number(mut out, h.size, 11, 8)?
        }
        _ => {
            text.append(mut out, if h.format == Crc { "070702" } else { "070701" })
            put_number(mut out, h.ino, 8, 16)?
            put_number(mut out, h.mode, 8, 16)?
            put_number(mut out, h.uid, 8, 16)?
            put_number(mut out, h.gid, 8, 16)?
            put_number(mut out, h.nlink, 8, 16)?
            put_number(mut out, h.mtime, 8, 16)?
            put_number(mut out, h.size, 8, 16)?
            put_number(mut out, h.dev_major, 8, 16)?
            put_number(mut out, h.dev_minor, 8, 16)?
            put_number(mut out, h.rdev_major, 8, 16)?
            put_number(mut out, h.rdev_minor, 8, 16)?
            put_number(mut out, name.len + 1, 8, 16)?
            put_number(mut out, h.check, 8, 16)?
        }
    }
    put_name(mut out, name)
    if h.format != Odc {
        for _ in 0..padding(out.len) {
            push(mut out, 0)
        }
    }
    out
}
