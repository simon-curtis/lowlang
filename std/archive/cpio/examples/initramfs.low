import std/archive/cpio
import std/compress/deflate
import std/io

/// Packs a small root file system as a gzip-compressed `newc` archive, the layout of a Linux initramfs, then lists it back. Hard links share one inode, and `newc` stores their data once, on the last name.
fn main() ! io.Error {
    let w = cpio.writer(Newc)
    w.add_dir("bin", 0o755)?
    w.add_links(cpio.Entry { name: "", mode: 0o755 }, ["bin/busybox", "bin/sh", "bin/ls"], bytes("ELF busybox"))?
    w.add_symlink("init", "bin/sh")?
    w.add_file("etc.conf", bytes("hostname=lowbox\n"), 0o644)?
    w.finish()?

    let image = deflate.gzip_compress(w.output(), 9)
    let archive = deflate.gzip_decompress(image, 1 << 20)?

    for e in cpio.list(archive)? {
        match e.kind {
            Dir => print("{e.name} directory")
            Symlink => print("{e.name} -> {e.link}")
            _ => print("{e.name} {e.size} bytes, {e.nlink} link(s)")
        }
    }

    let r = cpio.bytes_reader(archive)
    for {
        let e = r.next()? ?? break
        if e.name == "etc.conf" {
            print(str(r.read_entry()?))
        }
    }
}
