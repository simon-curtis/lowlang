import std/file
import std/io
import std/path
import std/slices
import std/sys
import std/text

/// A file opened exclusively for writing by `create`.
///
/// Dropping it closes the file descriptor.
pub struct Output {
    fd: sys.Fd
}

fn probe(path: str) -> file.Info? ! io.Error {
    let info = file.lstat(path) catch {
        NotFound => return none
        e => fail e
    }
    some(info)
}

/// Returns `name` normalised with `path.clean`, or fails when an archive entry of that name is not safe to extract.
///
/// Fails with `Malformed` for an empty name, and with `Denied` for an absolute name, a name containing a NUL byte or a name with a `..` segment.
pub fn clean_name(name: str) -> str ! io.Error {
    if name.len == 0 {
        fail Malformed
    }
    if path.is_absolute(name) || text.index_byte(name, 0) >= 0 {
        fail Denied
    }
    for part in text.split(name, '/') {
        if part == ".." {
            fail Denied
        }
    }
    path.clean(name)
}

fn confine(dir: str) ! io.Error {
    match probe(dir)? {
        none => file.mkdir_mode(dir, 0o755)?
        some(info) => {
            if info.link {
                fail Denied
            }
            if !info.dir {
                fail NotDir
            }
        }
    }
}

/// Returns the filesystem path of the archive entry `name` below `root`.
///
/// `name` is checked with `clean_name`, and a name that cleans to `.` resolves to `root`. Each missing parent directory below `root` is created with mode `0o755`, filtered by the process umask. A parent that is a symbolic link fails with `Denied` and one that is any other non-directory fails with `NotDir`, so a path never passes through a link below `root`. The final component is neither created nor checked.
pub fn resolve(root: str, name: str) -> str ! io.Error {
    let rel = clean_name(name)?
    if rel == "." {
        return root
    }
    let parts = text.split(rel, '/')
    var at = root
    for i in 0..parts.len - 1 {
        at = "{at}/{parts[i]}"
        confine(at)?
    }
    "{at}/{parts[parts.len - 1]}"
}

fn remove_existing(target: str, info: file.Info) ! io.Error {
    if info.dir {
        fail IsDir
    }
    file.remove(target)?
}

fn clear(target: str) ! io.Error {
    match probe(target)? {
        none => {}
        some(info) => remove_existing(target, info)?
    }
}

/// Creates the directory `target` with the permission bits `mode`.
///
/// An existing directory is kept and its mode is not changed. Any other existing object, including a symbolic link, is removed first. `mode` is masked to `0o777` and always includes `0o700` so extraction can write into the directory; the process umask applies.
pub fn make_dir(target: str, mode: i64) ! io.Error {
    match probe(target)? {
        none => {}
        some(info) => {
            if info.dir {
                return
            }
            remove_existing(target, info)?
        }
    }
    file.mkdir_mode(target, mode & 0o777 | 0o700)?
}

/// Creates `target` exclusively for writing and returns the open `Output`.
///
/// An existing file or symbolic link at `target` is removed first and an existing directory fails with `IsDir`. The file is created with `O_EXCL` and `O_NOFOLLOW`, so a link that appears in between is never followed. `mode` is masked to `0o777`, which drops the setuid, setgid and sticky bits, and the process umask applies. An interrupted open is retried.
pub fn create(target: str, mode: i64) -> Output ! io.Error {
    clear(target)?
    let opened = sys.open(target, sys.Open.FreshNoFollow, mode & 0o777)?
    Output { fd: sys.adopt(opened) }
}

/// Writes all of `data` to `o`.
///
/// Partial and interrupted writes are repeated until every byte is written. Fails with the error of the first write that fails.
pub fn put(o: Output, data: []u8) ! io.Error {
    sys.write_all_on(o.fd.handle, data)?
}

/// Creates `target` as `create` does, writes `data` to it and closes it.
pub fn write_file(target: str, data: []u8, mode: i64) ! io.Error {
    using out = create(target, mode)?
    put(out, data)?
}

/// Creates a symbolic link at `target` that points to `to`.
///
/// An existing file or symbolic link at `target` is removed first and an existing directory fails with `IsDir`. `to` is stored as given and is not validated.
pub fn symlink(target: str, to: str) ! io.Error {
    clear(target)?
    file.symlink(to, target)?
}

/// Creates `target` as a hard link to the existing file `source`.
///
/// An existing file or symbolic link at `target` is removed first and an existing directory fails with `IsDir`.
pub fn hardlink(target: str, source: str) ! io.Error {
    clear(target)?
    file.link(source, target)?
}

/// Sets the modification time of `target` to `seconds` since the Unix epoch and leaves the access time unchanged.
///
/// A final symbolic link is not followed; the link itself is stamped.
pub fn set_mtime(target: str, seconds: i64) ! io.Error {
    sys.set_times(target, none, some(seconds), false)?
}

/// A modification time to apply to the path `path` once an extraction has placed every entry.
pub struct Stamp {
    /// The filesystem path to stamp.
    pub path: str
    /// The modification time in seconds since the Unix epoch.
    pub mtime: i64
}

/// Sets the modification time of every stamp with `set_mtime`, last stamp first, so a directory is stamped after the entries below it.
pub fn apply_stamps(stamps: []Stamp) ! io.Error {
    var i = stamps.len - 1
    for i >= 0 {
        set_mtime(stamps[i].path, stamps[i].mtime)?
        i -= 1
    }
}

/// Creates `target` as `create` does and fills it with the chunks `read` produces until it returns `0`.
///
/// `read` fills a buffer it is given and returns the count. Fails with the error of `read` or of the filesystem.
pub fn write_from(target: str, mode: i64, read: fn([]u8) -> i64 ! io.Error) ! io.Error {
    using out = create(target, mode)?
    let chunk = io.buffer(65536)
    for {
        let n = read(chunk)?
        if n == 0 {
            break
        }
        put(out, chunk[..n])?
    }
}

/// An object below a directory found by `walk`.
pub struct Item {
    /// The path relative to the walked directory, with `/` separators.
    pub name: str
    /// The path of the object, joined to the walked directory.
    pub full: str
    /// What `lstat` reports for the object.
    pub info: file.Info
}

/// Returns every object below `root` in sorted depth-first order, each directory before its children.
///
/// `root` itself is not an item and symbolic links are not followed. Fails with the error of the filesystem call that failed.
pub fn walk(root: str) -> []Item ! io.Error {
    var items: []Item = []
    collect(root, "", mut items)?
    items
}

fn collect(root: str, rel: str, mut items: []Item) ! io.Error {
    let here = if rel.len == 0 { root } else { "{root}/{rel}" }
    var names = file.list(here)?
    names |> slices.sort()
    for name in names {
        let child = if rel.len == 0 { name } else { "{rel}/{name}" }
        let full = "{root}/{child}"
        let info = file.lstat(full)?
        push(mut items, Item { name: child, full, info })
        if info.dir {
            collect(root, child, mut items)?
        }
    }
}

/// A source of archive bytes that counts what it takes against a budget.
pub struct Input {
    /// The stream the bytes come from.
    pub source: *io.Reader
    /// A buffer for discarding data.
    pub scratch: []u8
    total: i64
    consumed: i64
}

/// Returns an `Input` over `source` that accepts at most `total` bytes through `charge`.
pub fn input(source: *io.Reader, total: i64) -> *Input {
    new(Input { source, scratch: io.buffer(8192), total, consumed: 0 })
}

/// Counts `n` bytes against the budget of the input.
///
/// Fails with `TooLarge` when they would exceed it.
pub fn charge(budget: *Input, n: i64) ! io.Error {
    if n > budget.total - budget.consumed {
        fail TooLarge
    }
    budget.consumed += n
}

/// Reads and discards `n` bytes from `budget`.
///
/// Fails with `Eof` when the source ends first.
pub fn skip(budget: *Input, n: i64) ! io.Error {
    var rest = n
    for rest > 0 {
        let want = if rest < budget.scratch.len { rest } else { budget.scratch.len }
        let got = io.read_some(budget.source, budget.scratch[..want])?
        if got == 0 {
            fail Eof
        }
        rest -= got
    }
}

/// Prepares `root` as the destination of an extraction.
///
/// A missing `root` is created together with its missing parents, each by `make_dir` with mode `0o755`. An existing directory or symbolic link is accepted as it is. Any other existing object fails with `NotDir`.
pub fn make_root(root: str) ! io.Error {
    match probe(root)? {
        none => {
            for i in 1..root.len {
                if root[i] == '/' {
                    make_dir(root[..i], 0o755)?
                }
            }
            make_dir(root, 0o755)?
        }
        some(info) => {
            if !info.dir && !info.link {
                fail NotDir
            }
        }
    }
}
