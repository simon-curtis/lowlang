import std/io
import std/slices
import std/text

struct Header {
    name: str
    mode: i64
    uid: i64
    gid: i64
    size: i64
    mtime: i64
    flag: u8
    link: str
}

struct Pending {
    name: str? = none
    link: str? = none
    size: i64? = none
    mtime: i64? = none
    uid: i64? = none
    gid: i64? = none
}

fn cstring(field: []u8) -> str {
    var end = 0
    for end < field.len && field[end] != 0 {
        end += 1
    }
    str(field[..end])
}

fn is_zero(block: []u8) -> bool {
    block.all(fn(b) b == 0)
}

fn blank(c: u8) -> bool {
    c == ' ' || c == 0
}

fn parse_octal(field: []u8) -> i64 ! io.Error {
    var i = 0
    for i < field.len && blank(field[i]) {
        i += 1
    }
    var v = 0
    for i < field.len && field[i] >= '0' && field[i] <= '7' {
        v = v << 3 | i64(field[i] - '0')
        i += 1
    }
    for i < field.len {
        if !blank(field[i]) {
            fail Malformed
        }
        i += 1
    }
    v
}

fn parse_base256(field: []u8) -> i64 ! io.Error {
    let negative = field[0] & 0x40 != 0
    var v = 0
    for i in 0..field.len {
        var c = field[i]
        if negative {
            c ^= 0xFF
        }
        if i == 0 {
            c &= 0x7F
        }
        if v >> 55 != 0 {
            fail TooLarge
        }
        v = v << 8 | i64(c)
    }
    if negative {
        return -v - 1
    }
    v
}

fn parse_number(field: []u8) -> i64 ! io.Error {
    if field[0] & 0x80 != 0 {
        return parse_base256(field)?
    }
    parse_octal(field)?
}

fn checksum_matches(block: []u8) -> bool {
    var unsigned = 0
    var signed = 0
    for i in 0..block.len {
        let b = if i >= 148 && i < 156 { ' ' } else { block[i] }
        unsigned += i64(b)
        signed += if b >= 128 { i64(b) - 256 } else { i64(b) }
    }
    let stored = parse_octal(block[148..156]) or return false
    stored == unsigned || stored == signed
}

fn has_prefix_field(block: []u8) -> bool {
    str(block[257..262]) == "ustar" && block[262] == 0
}

fn parse_header(block: []u8) -> Header ! io.Error {
    if !checksum_matches(block) {
        fail Malformed
    }
    var name = cstring(block[0..100])
    if has_prefix_field(block) {
        let prefix = cstring(block[345..500])
        if prefix.len > 0 {
            name = "{prefix}/{name}"
        }
    }
    Header {
        name
        mode: parse_number(block[100..108])?
        uid: parse_number(block[108..116])?
        gid: parse_number(block[116..124])?
        size: parse_number(block[124..136])?
        mtime: parse_number(block[136..148])?
        flag: block[156]
        link: cstring(block[157..257])
    }
}

fn kind_of(flag: u8, name: str) -> Kind {
    if flag == '1' {
        return Hardlink
    }
    if flag == '2' {
        return Symlink
    }
    if flag == '5' {
        return Dir
    }
    if flag == 0 || flag == '0' || flag == '7' {
        return if text.ends_with(name, "/") { Dir } else { File }
    }
    Other
}

fn header_only(kind: Kind) -> bool {
    match kind {
        File => false
        Other => false
        _ => true
    }
}

fn parse_decimal(value: str) -> i64 ! io.Error {
    text.parse_int(value) or fail Malformed
}

fn parse_time(value: str) -> i64 ! io.Error {
    let dot = text.index_byte(value, '.')
    if dot < 0 {
        return parse_decimal(value)?
    }
    parse_decimal(value[..dot])?
}

fn apply_record(key: str, value: str, mut p: Pending) ! io.Error {
    if key == "path" {
        p.name = value
    } else if key == "linkpath" {
        p.link = value
    } else if key == "size" {
        p.size = parse_decimal(value)?
    } else if key == "mtime" {
        p.mtime = parse_time(value)?
    } else if key == "uid" {
        p.uid = parse_decimal(value)?
    } else if key == "gid" {
        p.gid = parse_decimal(value)?
    }
}

fn parse_pax(body: []u8, mut p: Pending) ! io.Error {
    var at = 0
    for at < body.len {
        var length = 0
        var i = at
        for i < body.len && body[i] >= '0' && body[i] <= '9' {
            length = length * 10 + i64(body[i] - '0')
            if length > body.len {
                fail Malformed
            }
            i += 1
        }
        if i == at || i >= body.len || body[i] != ' ' || at + length > body.len || at + length <= i + 1 {
            fail Malformed
        }
        let stop = at + length
        if body[stop - 1] != '\n' {
            fail Malformed
        }
        let record = str(body[i + 1..stop - 1])
        let eq = text.index_byte(record, '=')
        if eq <= 0 {
            fail Malformed
        }
        apply_record(record[..eq], record[eq + 1..], mut p)?
        at = stop
    }
}
