import std/archive/zip
import std/hash
import std/io
import std/text

struct Capture {
    data: u8[]
}

fn capture(into: *Capture) -> io.Stream {
    io.Stream {
        read: fn(buf) -> i64 ! io.Error { fail Unsupported }
        write: fn(data) -> i64 ! io.Error {
            io.append(mut into.data, data)
            data.len
        }
        close: fn() {}
    }
}

/// Writes a log into a zip archive one line at a time through a stream writer, shows that the compressed bytes reach the sink before the entry ends and that other writes are refused while it is open, then reads the archive back and checks the log against a running checksum.
fn main() ! io.Error {
    let sink = new(Capture { data: [] })
    let w = zip.stream_writer(capture(sink))
    let entry = w.begin_entry(zip.Entry { name: "logs/app.log" })?

    let expected = hash.crc32_new()
    var total = 0
    for i in 0..5000 {
        let line = "2026-01-05 12:00:{text.pad_left("{i % 60}", 2, '0')} GET /api/items/{i % 17} 200\n"
        entry.write_entry(bytes(line))?
        hash.crc32_update(expected, bytes(line))
        total += line.len
    }
    print("compressed bytes already at the sink: {sink.data.len > 1000}")

    w.add_file("notes.txt", bytes("not yet"), Stored) catch {
        Invalid => print("add refused while the entry is open")
        _ => return
    }
    w.finish() catch {
        Invalid => print("finish refused while the entry is open")
        _ => return
    }

    entry.end_entry()?
    w.add_file("notes.txt", bytes("after the log"), Stored)?
    w.finish()?

    let a = zip.open(sink.data)?
    for e in a.entries {
        print("{e.name} {e.size} bytes, descriptor {e.flags & 8 != 0}, smaller than a tenth {e.compressed < e.size / 10}")
    }
    let log = a.read_entry("logs/app.log")?
    print("log size matches: {log.len == total}")
    print("log checksum matches: {hash.crc32(log) == hash.crc32_sum(expected)}")
}
