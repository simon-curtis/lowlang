import std/archive/zip
import std/io
import std/slices
import std/text

/// Bundles a report and a logo into a zip archive in memory, lists its entries, reads one back and shows a corrupted entry being rejected.
fn main() ! io.Error {
    let w = zip.writer()
    w.add_dir("report")?
    w.add_file("report/summary.txt", bytes(text.repeat("revenue up 12%, costs flat\n", 20)), Deflate)?
    w.add_file("report/logo.bin", bytes("LOGO"), Stored)?
    w.finish()?
    let data = w.output()

    let a = zip.open(data)?
    for e in a.entries {
        match e.kind {
            Dir => print("{e.name} directory")
            _ => print("{e.name} {e.size} bytes stored in {e.compressed}")
        }
    }

    let summary = a.read_entry("report/summary.txt")?
    print("summary starts: {str(summary[..26])}")
    print("missing entry: {a.find("report/missing.txt") == none}")

    let logo = a.find("report/logo.bin") ?? fail NotFound
    var damaged = slices.clone(data)
    let body = logo.offset + 30 + io.le16(data, logo.offset + 26) + io.le16(data, logo.offset + 28)
    damaged[body] = 'X'
    let bad = zip.open(damaged)?
    let _ = bad.read_entry("report/logo.bin") catch {
        Malformed => {
            print("logo.bin fails its checksum")
            return
        }
        _ => return
    }
    print("logo.bin read back")
}
