import std/mdns
import std/net
import std/net/dns

fn main() {
    let name = mdns.random_name()
    let hosts = [mdns.Host { name, ip: [192, 0, 2, 7] }]
    print("random name in .local: {mdns.is_local(name)}")

    let querier = net.parse_addr("192.0.2.50:5353") or return
    let reply = mdns.respond(hosts, mdns.query(name, dns.type_a), querier) ?? return
    print("multicast answer goes to {net.format(reply.to)}")
    let ip = mdns.answer(reply.data, name) ?? return
    print("{name.len}-byte name resolves to {net.format_ip(ip)}")

    let other_port = net.parse_addr("192.0.2.50:40000") or return
    let direct = mdns.respond(hosts, mdns.query(name, dns.type_a), other_port) ?? return
    print("one-shot answer goes to {net.format(direct.to)}")
    print("no answer for AAAA: {mdns.respond(hosts, mdns.query(name, dns.type_aaaa), querier) == none}")
}
