import std/serde
import std/yaml

struct Step {
    name: str
    run: str
    needs: []str
    retries: i64 = 0
}

struct Pipeline {
    name: str
    parallel: bool
    steps: []Step
    env: [str: str]
}

fn problem(e: serde.Error) -> str {
    match e {
        Syntax(at, message) => message
        Mismatch(expected, at) => "expected {expected}"
        Missing(field) => "missing {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "out of range"
        TooDeep => "nested too deeply"
        TooLarge => "too large"
    }
}

/// Reads a typed pipeline from YAML, writes it back and reports the errors of bad input.
fn main() {
    let source = "name: release\nparallel: false\nenv:\n  MODE: prod\n  DEBUG: \"yes\"\nsteps:\n  - name: build\n    run: make all\n    needs: []\n  - name: test\n    run: make test\n    needs: [build]\n    retries: 2\n"
    let pipeline = yaml.deserialize[Pipeline](source) catch {
        e => {
            print("read failed: {problem(e)}")
            return
        }
    }
    print("{pipeline.name} has {pipeline.steps.len} steps")
    for step in pipeline.steps {
        print("  {step.name}: {step.run}, needs {step.needs.len}, retries {step.retries}")
    }

    let rendered = yaml.serialize(pipeline) catch {
        e => {
            print("write failed: {problem(e)}")
            return
        }
    }
    print(rendered)

    let missing = yaml.deserialize[Pipeline]("name: x\nparallel: true\nenv: {{}}\n") catch {
        e => {
            print("missing steps: {problem(e)}")
            return
        }
    }
    print(missing.name)
}
