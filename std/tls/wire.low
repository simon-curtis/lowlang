import std/io

struct Cursor {
    data: []u8
    at: i64
}

fn cursor(data: []u8) -> *Cursor {
    new(Cursor { data, at: 0 })
}

fn left(c: *Cursor) -> i64 {
    c.data.len - c.at
}

fn take(c: *Cursor, n: i64) -> []u8 ! io.Error {
    if n < 0 || left(c) < n {
        fail Malformed
    }
    let out = c.data[c.at..c.at + n]
    c.at += n
    out
}

fn u8_of(c: *Cursor) -> i64 ! io.Error {
    i64(take(c, 1)?[0])
}

fn u16_of(c: *Cursor) -> i64 ! io.Error {
    io.be16(take(c, 2)?, 0)
}

fn u24_of(c: *Cursor) -> i64 ! io.Error {
    io.be24(take(c, 3)?, 0)
}

fn vector8(c: *Cursor) -> []u8 ! io.Error {
    let n = u8_of(c)?
    take(c, n)
}

fn vector16(c: *Cursor) -> []u8 ! io.Error {
    let n = u16_of(c)?
    take(c, n)
}

fn vector24(c: *Cursor) -> []u8 ! io.Error {
    let n = u24_of(c)?
    take(c, n)
}

fn end(c: *Cursor) ! io.Error {
    if left(c) != 0 {
        fail Malformed
    }
}

fn put_vector8(mut out: []u8, data: []u8) {
    push(mut out, u8(data.len))
    io.append(mut out, data)
}

fn put_vector16(mut out: []u8, data: []u8) {
    io.put_be16(mut out, data.len)
    io.append(mut out, data)
}

fn put_vector24(mut out: []u8, data: []u8) {
    io.put_be24(mut out, data.len)
    io.append(mut out, data)
}

fn put_extension(mut out: []u8, kind: i64, body: []u8) {
    io.put_be16(mut out, kind)
    put_vector16(mut out, body)
}

struct Extension {
    kind: i64
    body: []u8
}

fn extensions(c: *Cursor) -> []Extension ! io.Error {
    let all = cursor(vector16(c)?)
    var out: []Extension = []
    var seen: [i64: bool] = [:]
    for left(all) > 0 {
        let kind = u16_of(all)?
        if seen[kind] ?? false {
            fail Malformed
        }
        seen[kind] = true
        push(mut out, Extension { kind, body: vector16(all)? })
    }
    out
}

fn find(list: []Extension, kind: i64) -> []u8? {
    for e in list {
        if e.kind == kind {
            return e.body
        }
    }
    none
}

fn u16_list(data: []u8) -> []i64 ! io.Error {
    let c = cursor(data)
    let inner = cursor(vector16(c)?)
    end(c)?
    var out: []i64 = []
    for left(inner) > 0 {
        push(mut out, u16_of(inner)?)
    }
    out
}

fn put_u16_list(mut out: []u8, values: []i64) {
    var body: []u8 = []
    for v in values {
        io.put_be16(mut body, v)
    }
    put_vector16(mut out, body)
}
