import std/crypto
import std/crypto/hash
import std/crypto/x509
import std/io
import std/net
import std/slices
import std/time

struct ServerHello {
    hello_version: i64
    random: []u8
    session_id: []u8
    code: i64
    exts: []Extension
}

struct Hello13 {
    retry: bool
    suite: Suite
    group: i64
    key: []u8
    cookie: []u8
}

struct Offer {
    random: []u8
    session_id: []u8
    suites: []i64
    groups: []i64
    parameters: []u8?
}

struct Reply {
    shares: []Share
    transcript: []u8
    message: Message
    hello: ServerHello
}

struct Done13 {
    protocol: str
    group: i64
    suite: Suite
    chain: []x509.Certificate
    peer_parameters: []u8
}

fn offered_suites(config: Config) -> []i64 {
    var out: []i64 = []
    for code in config.cipher_suites {
        let usable = suite_of(code) != none && offers13(config) || suite12_of(code) != none && offers12(config)
        if usable && !slices.contains(out, code) {
            push(mut out, code)
        }
    }
    out
}

fn offered_groups(config: Config) -> []i64 {
    var out: []i64 = []
    for g in config.groups {
        let usable = supported_group(g) && (offers13(config) || g != x25519_mlkem768)
        if usable && !slices.contains(out, g) {
            push(mut out, g)
        }
    }
    out
}

fn client_hello(config: Config, offer: Offer, shares: []Share, cookie: []u8) -> []u8 {
    var body: []u8 = []
    io.put_be16(mut body, 0x0303)
    io.append(mut body, offer.random)
    put_vector8(mut body, offer.session_id)
    put_u16_list(mut body, offer.suites)
    put_vector8(mut body, [0])
    var exts: []u8 = []
    let literal_ip: []u8 = net.parse_ip(config.server_name) or []
    if config.server_name.len > 0 && literal_ip.len == 0 {
        var name: []u8 = [0]
        put_vector16(mut name, bytes(config.server_name))
        var list: []u8 = []
        put_vector16(mut list, name)
        put_extension(mut exts, 0, list)
    }
    if offers13(config) {
        var listed: []u8 = [3, 4]
        if offers12(config) {
            io.append(mut listed, [3, 3])
        }
        var versions: []u8 = []
        put_vector8(mut versions, listed)
        put_extension(mut exts, 43, versions)
    }
    var groups: []u8 = []
    put_u16_list(mut groups, offer.groups)
    put_extension(mut exts, 10, groups)
    var schemes: []u8 = []
    put_u16_list(mut schemes, x509.signature_schemes())
    put_extension(mut exts, 13, schemes)
    if offers13(config) {
        var entries: []u8 = []
        for s in shares {
            io.put_be16(mut entries, s.group)
            put_vector16(mut entries, s.public)
        }
        var key_share: []u8 = []
        put_vector16(mut key_share, entries)
        put_extension(mut exts, 51, key_share)
    }
    if config.alpn.len > 0 {
        var names: []u8 = []
        for p in config.alpn {
            put_vector8(mut names, bytes(p))
        }
        var alpn: []u8 = []
        put_vector16(mut alpn, names)
        put_extension(mut exts, 16, alpn)
    }
    if offers12(config) {
        put_extension(mut exts, 11, [1, 0])
        put_extension(mut exts, 23, [])
        put_extension(mut exts, 0xFF01, [0])
    }
    if cookie.len > 0 {
        var body_cookie: []u8 = []
        put_vector16(mut body_cookie, cookie)
        put_extension(mut exts, 44, body_cookie)
    }
    match offer.parameters {
        some(parameters) => {
            put_extension(mut exts, 57, parameters)
        }
        none => {}
    }
    put_vector16(mut body, exts)
    handshake_message(1, body)
}

fn parse_server_hello(body: []u8) -> ServerHello ! io.Error {
    let c = cursor(body)
    let hello_version = u16_of(c)?
    let random = take(c, 32)?
    let session_id = vector8(c)?
    let code = u16_of(c)?
    if u8_of(c)? != 0 {
        fail Malformed
    }
    var exts: []Extension = []
    if left(c) > 0 {
        exts = extensions(c)?
    }
    end(c)?
    ServerHello { hello_version, random, session_id, code, exts }
}

fn downgrade_sentinel(last: u8) -> []u8 {
    [0x44, 0x4F, 0x57, 0x4E, 0x47, 0x52, 0x44, last]
}

fn negotiate_version(c: *Channel, config: Config, hello: ServerHello) -> i64 ! io.Error {
    match find(hello.exts, 43) {
        some(selected) => {
            if selected.len != 2 || io.be16(selected, 0) != 0x0304 || !offers13(config) || hello.hello_version != 0x0303 {
                fail abort(c, 47, Unsupported)
            }
            return 0x0304
        }
        none => {}
    }
    if hello.hello_version != 0x0303 || !offers12(config) {
        fail abort(c, 70, Unsupported)
    }
    let tail = hello.random[24..]
    if offers13(config) && (hash.equal(tail, downgrade_sentinel(1)) || hash.equal(tail, downgrade_sentinel(0))) {
        fail abort(c, 47, Invalid)
    }
    0x0303
}

fn hello13(c: *Channel, offer: Offer, hello: ServerHello) -> Hello13 ! io.Error {
    let suite = match suite_of(hello.code) {
        some(found) => found
        none => fail abort(c, 47, Unsupported)
    }
    if !slices.contains(offer.suites, hello.code) {
        fail abort(c, 47, Unsupported)
    }
    let retry = hash.equal(hello.random, retry_random())
    let share = match find(hello.exts, 51) {
        some(found) => found
        none => fail abort(c, 109, Malformed)
    }
    let sc = cursor(share)
    let group = u16_of(sc)?
    var key: []u8 = []
    if !retry {
        key = vector16(sc)?
    }
    end(sc)?
    var cookie: []u8 = []
    match find(hello.exts, 44) {
        some(raw) => {
            let cc = cursor(raw)
            cookie = vector16(cc)?
        }
        none => {}
    }
    Hello13 { retry, suite, group, key, cookie }
}

fn negotiated_protocol(c: *Channel, config: Config, exts: []Extension) -> str ! io.Error {
    match find(exts, 16) {
        some(raw) => {
            let ac = cursor(raw)
            let list = cursor(vector16(ac)?)
            end(ac)?
            let name = str(vector8(list)?)
            end(list)?
            for p in config.alpn {
                if p == name {
                    return name
                }
            }
            fail abort(c, 47, Malformed)
        }
        none => {
            if is_quic(c) {
                fail abort(c, 120, Unsupported)
            }
            ""
        }
    }
}

fn peer_parameters(c: *Channel, exts: []Extension) -> []u8 ! io.Error {
    if !is_quic(c) {
        return []
    }
    match find(exts, 57) {
        some(raw) => {
            if raw.len > max_parameters {
                fail abort(c, 47, Malformed)
            }
            raw
        }
        none => fail abort(c, 109, Malformed)
    }
}

fn expect_message(c: *Channel, kind: i64) -> Message ! io.Error {
    let m = read_handshake(c)?
    if m.kind != kind {
        send_alert(c, 10)
        fail Malformed
    }
    m
}

fn verify_server(config: Config, chain: []x509.Certificate) ! io.Error {
    if chain.len == 0 {
        fail Invalid
    }
    if !config.verify {
        return
    }
    let roots = if config.roots.len > 0 { config.roots } else { x509.system_roots() }
    x509.verify_chain(chain[0], chain[1..], roots, config.server_name, time.now())?
}

fn checked_server(c: *Channel, config: Config, chain: []x509.Certificate) ! io.Error {
    verify_server(config, chain) or fail abort(c, 42, Invalid)
}

/// Performs a TLS client handshake over `s` and returns the established session.
///
/// Offers the versions, cipher suites and groups of `config` (TLS 1.3, RFC 8446, and TLS 1.2, RFC 5246 with ECDHE key exchange and AEAD suites) and blocks the green thread until the handshake completes. Unless `config.verify` is `false`, the server certificate chain is verified with `x509.verify_chain` against `config.roots`, or the system roots when that list is empty, for the host `config.server_name`. A certificate failure sends a `bad_certificate` alert and fails with `Invalid`. A client certificate is never sent; a certificate request is answered with an empty certificate list.
///
/// Fails with `Invalid` for an unusable `config` (a version range outside TLS 1.2 to 1.3, no usable cipher suite or group) or a failed verification, with `Unsupported` when the server selects nothing the client offered, with `Malformed` for protocol violations and with `Eof`, `Refused` or the stream's error when the connection ends. A failed handshake does not close `s`. When it succeeds, closing or dropping the `Session` also closes `s`.
pub fn client(s: io.Stream, config: Config) -> Session ! io.Error {
    let h = client_handle(s, config)?
    Session { handle: h }
}

/// Performs a TLS client handshake over `s` and returns the copyable `SessionHandle`.
///
/// Behaves as `client`, but the result is not dropped automatically: the caller closes it with `close_on`. Use it to move a session between green threads.
pub fn client_handle(s: io.Stream, config: Config) -> *SessionHandle ! io.Error {
    let offer = Offer {
        random: crypto.random(32)
        session_id: crypto.random(32)
        suites: offered_suites(config)
        groups: offered_groups(config)
        parameters: none
    }
    if !versions_valid(config) || offer.suites.len == 0 || offer.groups.len == 0 {
        fail Invalid
    }
    let c = channel(s)
    c.plaintext_version = 0x0301
    let reply = greet(c, config, offer)?
    if c.version == 0x0303 {
        var transcript = reply.transcript
        io.append(mut transcript, reply.message.raw)
        return client12(c, config, offer, transcript, reply.hello)
    }
    let done = client13(c, config, offer, reply)?
    session(c, done.protocol, done.group, done.suite, suite_code(done.suite), done.chain)
}

fn greet(c: *Channel, config: Config, offer: Offer) -> Reply ! io.Error {
    var shares: []Share = []
    if offers13(config) {
        let first_group = offer.groups[0]
        push(mut shares, client_share(first_group)?)
        if first_group == x25519_mlkem768 && slices.contains(offer.groups, group_x25519) {
            push(mut shares, client_share(group_x25519)?)
        }
    }
    let first = client_hello(config, offer, shares, [])
    write_record(c, 22, first)?
    c.plaintext_version = 0x0303
    let m = expect_message(c, 2)?
    let hello = parse_server_hello(m.body) or fail abort(c, 50, Malformed)
    c.version = negotiate_version(c, config, hello)?
    var transcript: []u8 = []
    io.append(mut transcript, first)
    Reply { shares, transcript, message: m, hello }
}

fn client13(c: *Channel, config: Config, offer: Offer, reply: Reply) -> Done13 ! io.Error {
    var shares = reply.shares
    var transcript = reply.transcript
    var m = reply.message
    var echoed = reply.hello.session_id
    var hello = hello13(c, offer, reply.hello)?
    if hello.retry {
        if !slices.contains(offer.groups, hello.group) {
            fail abort(c, 47, Unsupported)
        }
        for s in shares {
            if s.group == hello.group {
                fail abort(c, 47, Malformed)
            }
        }
        transcript = message_hash(suite_hash(hello.suite), transcript)
        io.append(mut transcript, m.raw)
        shares = [client_share(hello.group)?]
        let second = client_hello(config, offer, shares, hello.cookie)
        io.append(mut transcript, second)
        write_record(c, 22, second)?
        m = expect_message(c, 2)?
        let again = parse_server_hello(m.body) or fail abort(c, 50, Malformed)
        if negotiate_version(c, config, again)? != 0x0304 {
            fail abort(c, 47, Malformed)
        }
        echoed = again.session_id
        hello = hello13(c, offer, again)?
        if hello.retry {
            fail abort(c, 10, Malformed)
        }
    }
    io.append(mut transcript, m.raw)
    if !hash.equal(echoed, offer.session_id) {
        fail abort(c, 47, Malformed)
    }
    var secret: []u8 = []
    for s in shares {
        if s.group == hello.group {
            secret = client_secret(s, hello.key) or fail abort(c, 47, Invalid)
        }
    }
    if secret.len == 0 {
        fail abort(c, 47, Malformed)
    }
    let k = schedule(hello.suite, secret, transcript)
    set_read_key(c, hello.suite, k.server_handshake)?
    let ee = expect_message(c, 8)?
    let ec = cursor(ee.body)
    let ee_exts = extensions(ec) or fail abort(c, 50, Malformed)
    end(ec)?
    let protocol = negotiated_protocol(c, config, ee_exts)?
    let parameters = peer_parameters(c, ee_exts)?
    io.append(mut transcript, ee.raw)
    var next = read_handshake(c)?
    var requested = false
    var request_context: []u8 = []
    if next.kind == 13 {
        requested = true
        request_context = vector8(cursor(next.body))?
        io.append(mut transcript, next.raw)
        next = read_handshake(c)?
    }
    if next.kind != 11 {
        fail abort(c, 10, Malformed)
    }
    let chain = parse_certificates(next.body) or fail abort(c, 50, Malformed)
    io.append(mut transcript, next.raw)
    checked_server(c, config, chain)?
    let cv = expect_message(c, 15)?
    let vc = cursor(cv.body)
    let scheme = u16_of(vc)?
    let signature = vector16(vc)?
    end(vc)?
    let content = verify_content(k.hash, transcript)
    if !x509.verify_signature(chain[0].public_key, scheme, content, signature, x509.SignatureRules.Tls13) {
        fail abort(c, 51, Invalid)
    }
    io.append(mut transcript, cv.raw)
    let fin = expect_message(c, 20)?
    if !hash.equal(fin.body, finished(k, k.server_handshake, transcript)) {
        fail abort(c, 51, Invalid)
    }
    io.append(mut transcript, fin.raw)
    let client_app = derive_secret(k.hash, k.master, "c ap traffic", transcript)
    let server_app = derive_secret(k.hash, k.master, "s ap traffic", transcript)
    set_write_key(c, hello.suite, k.client_handshake)?
    var flight: []u8 = []
    if requested {
        let empty = certificate_message(request_context, [])
        io.append(mut transcript, empty)
        io.append(mut flight, empty)
    }
    io.append(mut flight, handshake_message(20, finished(k, k.client_handshake, transcript)))
    write_record(c, 22, flight)?
    set_write_key(c, hello.suite, client_app)?
    set_read_key(c, hello.suite, server_app)?
    Done13 { protocol, group: hello.group, suite: hello.suite, chain, peer_parameters: parameters }
}

/// Connects to `host` and `port` over TCP and performs a TLS client handshake.
///
/// `config.server_name` defaults to `host` when empty, which sets both the SNI sent and the name the certificate is checked against. The TCP connection is closed if the handshake fails. Fails as `client` does for a failed handshake, and with the error of `net.dial` when the connection cannot be made. Blocks the green thread.
pub fn dial(host: str, port: i64, config: Config) -> Session ! io.Error {
    using var conn = net.dial(host, port)?
    var named = config
    if named.server_name.len == 0 {
        named.server_name = host
    }
    let h = client_handle(net.stream(conn), named)?
    net.detach(mut conn)
    Session { handle: h }
}
