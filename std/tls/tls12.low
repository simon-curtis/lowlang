import std/crypto/hash
import std/crypto/x509
import std/io

/// Returns the cipher of the TLS 1.2 ECDHE suite `code`: `0xC02B` and `0xC02F` for `Aes128Gcm`, `0xC02C` and `0xC030` for `Aes256Gcm`, `0xCCA9` and `0xCCA8` for `ChaCha20Poly1305`, and `none` for any other code.
///
/// The PRF hash of the suite is `suite_hash` of the result.
pub fn suite12_of(code: i64) -> Suite? {
    if code == 0xC02B || code == 0xC02F {
        return Aes128Gcm
    }
    if code == 0xC02C || code == 0xC030 {
        return Aes256Gcm
    }
    if code == 0xCCA9 || code == 0xCCA8 {
        return ChaCha20Poly1305
    }
    none
}

fn signs_with_ecdsa(code: i64) -> bool {
    code == 0xC02B || code == 0xC02C || code == 0xCCA9
}

fn suite_scheme(code: i64, scheme: i64) -> bool {
    let wanted = if signs_with_ecdsa(code) { x509.Authentication.ByEcdsa } else { x509.Authentication.ByRsa }
    x509.authentication(scheme) == wanted
}

/// Returns `length` bytes of the TLS 1.2 PRF (RFC 5246 section 5) over `secret`, `label` and `seed` with the HMAC of `h`.
pub fn prf(h: hash.Algorithm, secret: u8[], label: str, seed: u8[], length: i64) -> u8[] {
    var labelled: u8[] = bytes(label)
    io.append(mut labelled, seed)
    var out: u8[] = []
    var a = hash.hmac(h, secret, labelled)
    for out.len < length {
        var input: u8[] = []
        io.append(mut input, a)
        io.append(mut input, labelled)
        io.append(mut out, hash.hmac(h, secret, input))
        a = hash.hmac(h, secret, a)
    }
    out[..length]
}

/// Returns the 48-byte extended master secret (RFC 7627) of `premaster`, where `transcript` holds the handshake messages up to and including the ClientKeyExchange.
pub fn extended_master_secret(h: hash.Algorithm, premaster: u8[], transcript: u8[]) -> u8[] {
    let session_hash = hash.sum(h, transcript)
    prf(h, premaster, "extended master secret", session_hash, 48)
}

/// Returns the 12-byte Finished `verify_data` over `transcript` with `label`, `"client finished"` or `"server finished"`.
pub fn verify_data(h: hash.Algorithm, master: u8[], label: str, transcript: u8[]) -> u8[] {
    let digest = hash.sum(h, transcript)
    prf(h, master, label, digest, 12)
}

/// The record protection keys and fixed IVs of a TLS 1.2 AEAD suite (RFC 5246 section 6.3).
pub struct KeyBlock12 {
    /// The client write key.
    pub client_key: u8[]
    /// The server write key.
    pub server_key: u8[]
    /// The client write IV: 4 bytes of salt for the AES-GCM suites and the 12-byte nonce mask for ChaCha20-Poly1305.
    pub client_iv: u8[]
    /// The server write IV, of the same length as `client_iv`.
    pub server_iv: u8[]
}

/// Expands `master` into the key block of `s` with the PRF label `"key expansion"` over the server random followed by the client random.
pub fn key_block12(s: Suite, master: u8[], client_random: u8[], server_random: u8[]) -> KeyBlock12 {
    let h = suite_hash(s)
    let size = key_size(s)
    let fixed = match s {
        ChaCha20Poly1305 => 12
        _ => 4
    }
    var seed: u8[] = []
    io.append(mut seed, server_random)
    io.append(mut seed, client_random)
    let block = prf(h, master, "key expansion", seed, 2 * size + 2 * fixed)
    let ivs = 2 * size
    KeyBlock12 {
        client_key: block[..size]
        server_key: block[size..ivs]
        client_iv: block[ivs..ivs + fixed]
        server_iv: block[ivs + fixed..ivs + 2 * fixed]
    }
}

struct Keys12 {
    client: *Protection
    server: *Protection
}

fn protection12(s: Suite, key: u8[], fixed: u8[]) -> *Protection ! io.Error {
    let iv: u8[] = __make(12)
    io.copy(iv, fixed)
    let empty: u8[] = []
    new(Protection { cipher: cipher(s, key)?, iv, seq: 0, secret: empty, suite: s, explicit: fixed.len == 4 })
}

fn keys12(s: Suite, master: u8[], client_random: u8[], server_random: u8[]) -> Keys12 ! io.Error {
    let block = key_block12(s, master, client_random, server_random)
    let client = protection12(s, block.client_key, block.client_iv)?
    let server = protection12(s, block.server_key, block.server_iv)?
    Keys12 { client, server }
}
