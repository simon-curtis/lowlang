import std/crypto/aead
import std/crypto/hash
import std/io
import std/text

/// The authenticated cipher of a negotiated cipher suite.
///
/// The TLS 1.3 key schedule uses SHA-384 with `Aes256Gcm` and SHA-256 with the others. The TLS 1.2 suites map onto the same values by their cipher.
pub enum Suite {
    /// AES-128-GCM with a 16-byte key, `TLS_AES_128_GCM_SHA256` in TLS 1.3.
    Aes128Gcm
    /// AES-256-GCM with a 32-byte key, `TLS_AES_256_GCM_SHA384` in TLS 1.3.
    Aes256Gcm
    /// ChaCha20-Poly1305 (RFC 8439) with a 32-byte key, `TLS_CHACHA20_POLY1305_SHA256` in TLS 1.3.
    ChaCha20Poly1305
}

/// Returns the TLS 1.3 cipher suite code of `s`: `0x1301`, `0x1302` or `0x1303` for `Aes128Gcm`, `Aes256Gcm` and `ChaCha20Poly1305`.
pub fn suite_code(s: Suite) -> i64 {
    match s {
        Aes128Gcm => 0x1301
        Aes256Gcm => 0x1302
        ChaCha20Poly1305 => 0x1303
    }
}

/// Returns the cipher of the TLS 1.3 suite `code`, `0x1301`, `0x1302` or `0x1303`, and `none` for any other code.
pub fn suite13_of(code: i64) -> Suite? {
    match code {
        0x1301 => Aes128Gcm
        0x1302 => Aes256Gcm
        0x1303 => ChaCha20Poly1305
        _ => none
    }
}

/// Returns the hash of the TLS 1.3 key schedule for `s`: SHA-384 for `Aes256Gcm` and SHA-256 for the others.
pub fn suite_hash(s: Suite) -> hash.Algorithm {
    match s {
        Aes256Gcm => hash.sha384()
        _ => hash.sha256()
    }
}

/// Returns the key length of `s` in bytes: 16 for `Aes128Gcm` and 32 for the others.
pub fn key_size(s: Suite) -> i64 {
    match s {
        Aes128Gcm => 16
        _ => 32
    }
}

/// Returns the AEAD of `s` keyed with `key`.
///
/// Fails with `Invalid` for a key length the cipher does not take: 16 or 32 bytes for AES-GCM, 32 for ChaCha20-Poly1305.
pub fn cipher(s: Suite, key: u8[]) -> aead.Aead ! io.Error {
    match s {
        ChaCha20Poly1305 => aead.chacha20_poly1305(key)
        _ => aead.aes_gcm(key)
    }
}

/// Returns `length` bytes of HKDF-Expand-Label (RFC 8446 section 7.1) over `secret` with `label`, which gets the `tls13 ` prefix, and `context`.
///
/// QUIC derives its packet protection keys with it (RFC 9001 section 5.1).
pub fn expand_label(h: hash.Algorithm, secret: u8[], label: str, context: u8[], length: i64) -> u8[] {
    expand_label_with(h, "tls13 ", secret, label, context, length)
}

/// Returns HKDF-Expand-Label as `expand_label` does, with `prefix` in place of `tls13 `.
///
/// DTLS 1.3 uses the prefix `dtls13` (RFC 9147 section 5.9).
pub fn expand_label_with(h: hash.Algorithm, prefix: str, secret: u8[], label: str, context: u8[], length: i64) -> u8[] {
    var info: u8[] = []
    io.put_be16(mut info, length)
    info.push(u8(prefix.len + label.len))
    text.append(mut info, prefix)
    text.append(mut info, label)
    info.push(u8(context.len))
    io.append(mut info, context)
    hash.hkdf_expand(h, secret, info, length)
}

struct Protection {
    cipher: aead.Aead
    iv: u8[]
    seq: u64
    secret: u8[]
    suite: Suite
    explicit: bool
}

fn protection(s: Suite, secret: u8[]) -> *Protection ! io.Error {
    let h = suite_hash(s)
    let key = expand_label(h, secret, "key", [], key_size(s))
    let iv = expand_label(h, secret, "iv", [], 12)
    new(Protection { cipher: cipher(s, key)?, iv, seq: 0, secret, suite: s, explicit: false })
}

fn updated(p: *Protection) -> *Protection ! io.Error {
    let h = suite_hash(p.suite)
    protection(p.suite, expand_label(h, p.secret, "traffic upd", [], h.size))
}

fn nonce(p: *Protection) -> u8[] {
    let out: u8[] = __make(12)
    io.copy(out, p.iv)
    for i in 0..8 {
        out[11 - i] = out[11 - i] ^ u8(p.seq >> (8 * i))
    }
    p.seq += 1
    out
}

/// The secrets of one TLS 1.3 handshake without a pre-shared key (RFC 8446 section 7.1).
pub struct KeySchedule {
    /// The hash of the cipher suite.
    pub hash: hash.Algorithm
    /// The HKDF label prefix: `tls13 `, or `dtls13` for DTLS 1.3.
    pub prefix: str
    /// The master secret that the application traffic secrets and the exporter secret derive from.
    pub master: u8[]
    /// The client handshake traffic secret.
    pub client_handshake: u8[]
    /// The server handshake traffic secret.
    pub server_handshake: u8[]
}

fn schedule(s: Suite, shared: u8[], transcript: u8[]) -> *KeySchedule {
    key_schedule(s, "tls13 ", shared, transcript)
}

/// Returns the key schedule of suite `s` for the ECDHE secret `shared`, with the handshake traffic secrets over `transcript`, the handshake messages from the ClientHello to the ServerHello.
pub fn key_schedule(s: Suite, prefix: str, shared: u8[], transcript: u8[]) -> *KeySchedule {
    let h = suite_hash(s)
    let zeros: u8[] = __make(h.size)
    let early = hash.hkdf_extract(h, zeros, zeros)
    let empty: u8[] = []
    let k = new(KeySchedule { hash: h, prefix, master: [], client_handshake: [], server_handshake: [] })
    let handshake = hash.hkdf_extract(h, derive_secret(k, early, "derived", empty), shared)
    k.master = hash.hkdf_extract(h, derive_secret(k, handshake, "derived", empty), zeros)
    k.client_handshake = derive_secret(k, handshake, "c hs traffic", transcript)
    k.server_handshake = derive_secret(k, handshake, "s hs traffic", transcript)
    k
}

/// Returns Derive-Secret (RFC 8446 section 7.1) of `secret` with `label` over the hash of `transcript`, under the hash and prefix of `k`.
pub fn derive_secret(k: *KeySchedule, secret: u8[], label: str, transcript: u8[]) -> u8[] {
    expand_label_with(k.hash, k.prefix, secret, label, hash.sum(k.hash, transcript), k.hash.size)
}

/// Returns the Finished verify data for the traffic secret `base` over `transcript` (RFC 8446 section 4.4.4).
pub fn finished_mac(k: *KeySchedule, base: u8[], transcript: u8[]) -> u8[] {
    let key = expand_label_with(k.hash, k.prefix, base, "finished", [], k.hash.size)
    hash.hmac(k.hash, key, hash.sum(k.hash, transcript))
}

/// Returns `length` bytes of the TLS 1.3 exporter (RFC 8446 section 7.5) for `label` and `context` from `exporter_master`, the `exp master` secret of `k`.
pub fn export_secret(k: *KeySchedule, exporter_master: u8[], label: str, context: u8[], length: i64) -> u8[] {
    let empty: u8[] = []
    let secret = derive_secret(k, exporter_master, label, empty)
    expand_label_with(k.hash, k.prefix, secret, "exporter", hash.sum(k.hash, context), length)
}
