import std/crypto/aead
import std/crypto/hash
import std/io
import std/text

/// The authenticated cipher of a negotiated cipher suite.
///
/// The TLS 1.3 key schedule uses SHA-384 with `Aes256Gcm` and SHA-256 with the others. The TLS 1.2 suites map onto the same values by their cipher.
pub enum Suite {
    /// AES-128-GCM with a 16-byte key, `TLS_AES_128_GCM_SHA256` in TLS 1.3.
    Aes128Gcm
    /// AES-256-GCM with a 32-byte key, `TLS_AES_256_GCM_SHA384` in TLS 1.3.
    Aes256Gcm
    /// ChaCha20-Poly1305 (RFC 8439) with a 32-byte key, `TLS_CHACHA20_POLY1305_SHA256` in TLS 1.3.
    ChaCha20Poly1305
}

/// Returns the TLS 1.3 cipher suite code of `s`: `0x1301`, `0x1302` or `0x1303` for `Aes128Gcm`, `Aes256Gcm` and `ChaCha20Poly1305`.
pub fn suite_code(s: Suite) -> i64 {
    match s {
        Aes128Gcm => 0x1301
        Aes256Gcm => 0x1302
        ChaCha20Poly1305 => 0x1303
    }
}

fn suite_of(code: i64) -> Suite? {
    match code {
        0x1301 => Aes128Gcm
        0x1302 => Aes256Gcm
        0x1303 => ChaCha20Poly1305
        _ => none
    }
}

/// Returns the hash of the TLS 1.3 key schedule for `s`: SHA-384 for `Aes256Gcm` and SHA-256 for the others.
pub fn suite_hash(s: Suite) -> hash.Algorithm {
    match s {
        Aes256Gcm => hash.sha384()
        _ => hash.sha256()
    }
}

/// Returns the key length of `s` in bytes: 16 for `Aes128Gcm` and 32 for the others.
pub fn key_size(s: Suite) -> i64 {
    match s {
        Aes128Gcm => 16
        _ => 32
    }
}

/// Returns the AEAD of `s` keyed with `key`.
///
/// Fails with `Invalid` for a key length the cipher does not take: 16 or 32 bytes for AES-GCM, 32 for ChaCha20-Poly1305.
pub fn cipher(s: Suite, key: []u8) -> aead.Aead ! io.Error {
    match s {
        ChaCha20Poly1305 => aead.chacha20_poly1305(key)
        _ => aead.aes_gcm(key)
    }
}

/// Returns `length` bytes of HKDF-Expand-Label (RFC 8446 section 7.1) over `secret` with `label`, which gets the `tls13 ` prefix, and `context`.
///
/// QUIC derives its packet protection keys with it (RFC 9001 section 5.1).
pub fn expand_label(h: hash.Algorithm, secret: []u8, label: str, context: []u8, length: i64) -> []u8 {
    var info: []u8 = []
    io.put_be16(mut info, length)
    push(mut info, u8(6 + label.len))
    text.append(mut info, "tls13 ")
    text.append(mut info, label)
    push(mut info, u8(context.len))
    io.append(mut info, context)
    hash.hkdf_expand(h, secret, info, length)
}

fn derive_secret(h: hash.Algorithm, secret: []u8, label: str, transcript: []u8) -> []u8 {
    expand_label(h, secret, label, hash.sum(h, transcript), h.size)
}

struct Protection {
    cipher: aead.Aead
    iv: []u8
    seq: u64
    secret: []u8
    suite: Suite
    explicit: bool
}

fn protection(s: Suite, secret: []u8) -> *Protection ! io.Error {
    let h = suite_hash(s)
    let key = expand_label(h, secret, "key", [], key_size(s))
    let iv = expand_label(h, secret, "iv", [], 12)
    new(Protection { cipher: cipher(s, key)?, iv, seq: 0, secret, suite: s, explicit: false })
}

fn updated(p: *Protection) -> *Protection ! io.Error {
    let h = suite_hash(p.suite)
    protection(p.suite, expand_label(h, p.secret, "traffic upd", [], h.size))
}

fn nonce(p: *Protection) -> []u8 {
    let out: []u8 = __make(12)
    io.copy(out, p.iv)
    for i in 0..8 {
        out[11 - i] = out[11 - i] ^ u8(p.seq >> (8 * i))
    }
    p.seq += 1
    out
}

struct Schedule {
    hash: hash.Algorithm
    master: []u8
    client_handshake: []u8
    server_handshake: []u8
}

fn schedule(s: Suite, shared: []u8, transcript: []u8) -> *Schedule {
    let h = suite_hash(s)
    let zeros: []u8 = __make(h.size)
    let early = hash.hkdf_extract(h, zeros, zeros)
    let empty: []u8 = []
    let handshake = hash.hkdf_extract(h, derive_secret(h, early, "derived", empty), shared)
    let master = hash.hkdf_extract(h, derive_secret(h, handshake, "derived", empty), zeros)
    new(Schedule {
        hash: h
        master
        client_handshake: derive_secret(h, handshake, "c hs traffic", transcript)
        server_handshake: derive_secret(h, handshake, "s hs traffic", transcript)
    })
}

fn finished(k: *Schedule, base: []u8, transcript: []u8) -> []u8 {
    let key = expand_label(k.hash, base, "finished", [], k.hash.size)
    hash.hmac(k.hash, key, hash.sum(k.hash, transcript))
}
