import std/crypto/ecdsa
import std/crypto/mlkem
import std/crypto/x25519
import std/io

/// The TLS named group code `0x11EC`, the `X25519MLKEM768` hybrid of X25519 and ML-KEM-768.
///
/// The client share is the 1184-byte ML-KEM-768 encapsulation key followed by the 32-byte X25519 public key, and the server share is the 1088-byte ML-KEM ciphertext followed by the 32-byte X25519 public key. The shared secret is the 32-byte ML-KEM secret followed by the 32-byte X25519 secret. It is offered with TLS 1.3 only.
pub const x25519_mlkem768 = 0x11EC

/// The TLS named group code `0x001D` for `x25519` (RFC 7748, RFC 8446 section 4.2.7).
pub const group_x25519 = 0x001D

/// The TLS named group code `0x0017` for `secp256r1`, the NIST P-256 curve.
pub const group_p256 = 0x0017

/// The TLS named group code `0x0018` for `secp384r1`, the NIST P-384 curve.
pub const group_p384 = 0x0018

fn supported_group(g: i64) -> bool {
    g == x25519_mlkem768 || g == group_x25519 || g == group_p256 || g == group_p384
}

/// An ephemeral key exchange key pair for one named group.
pub struct Share {
    /// The named group code the pair belongs to.
    pub group: i64
    private: u8[]
    decapsulation: u8[]
    /// The public value to send: a 32-byte X25519 key or an uncompressed SEC 1 point.
    pub public: u8[]
}

fn curve(g: i64) -> ecdsa.Curve {
    if g == group_p384 { P384 } else { P256 }
}

/// Returns a fresh ephemeral key pair for the named group `g`.
///
/// Fails with `Invalid` for a group other than `group_x25519`, `group_p256`, `group_p384` and `x25519_mlkem768`.
pub fn ephemeral_share(g: i64) -> Share ! io.Error {
    if g == x25519_mlkem768 {
        let keys = mlkem.generate(Kem768)
        let private = x25519.generate()
        var public: u8[] = []
        io.append(mut public, keys.encapsulation)
        io.append(mut public, x25519.public_key(private))
        return Share { group: g, private, decapsulation: keys.decapsulation, public }
    }
    if g == group_x25519 {
        let private = x25519.generate()
        return Share { group: g, private, decapsulation: [], public: x25519.public_key(private) }
    }
    let private = ecdsa.generate(curve(g))
    Share { group: g, private, decapsulation: [], public: ecdsa.public_key(curve(g), private)? }
}

/// Returns the shared secret of the key pair `s` and the peer's public value `peer`.
///
/// Fails with `Invalid` when `peer` is not a valid public value of the group.
pub fn shared_secret(s: Share, peer: u8[]) -> u8[] ! io.Error {
    if s.group == x25519_mlkem768 {
        if peer.len != 1088 + 32 {
            fail Invalid
        }
        var secret: u8[] = []
        io.append(mut secret, mlkem.decapsulate(Kem768, s.decapsulation, peer[..1088])?)
        io.append(mut secret, x25519.shared(s.private, peer[1088..])?)
        return secret
    }
    if s.group == group_x25519 {
        return x25519.shared(s.private, peer)
    }
    ecdsa.ecdh(curve(s.group), s.private, peer)
}

struct Exchanged {
    public: u8[]
    secret: u8[]
}

fn server_exchange(g: i64, client: u8[]) -> Exchanged ! io.Error {
    if g == x25519_mlkem768 {
        if client.len != 1184 + 32 {
            fail Invalid
        }
        let sealed = mlkem.encapsulate(Kem768, client[..1184])?
        let private = x25519.generate()
        var public: u8[] = []
        io.append(mut public, sealed.ciphertext)
        io.append(mut public, x25519.public_key(private))
        var secret: u8[] = []
        io.append(mut secret, sealed.shared)
        io.append(mut secret, x25519.shared(private, client[1184..])?)
        return Exchanged { public, secret }
    }
    if g == group_x25519 {
        let private = x25519.generate()
        return Exchanged { public: x25519.public_key(private), secret: x25519.shared(private, client)? }
    }
    let private = ecdsa.generate(curve(g))
    Exchanged { public: ecdsa.public_key(curve(g), private)?, secret: ecdsa.ecdh(curve(g), private, client)? }
}
