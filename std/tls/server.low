import std/crypto
import std/crypto/hash
import std/crypto/x509
import std/io
import std/slices

struct KeyShareEntry {
    group: i64
    key: []u8
}

struct ClientHello {
    hello_version: i64
    random: []u8
    session_id: []u8
    suites: []i64
    compressions: []u8
    exts: []Extension
    versions: []i64
    groups: []i64
    shares: []KeyShareEntry
    schemes: []i64
    protocols: []str
}

fn parse_client_hello(body: []u8) -> ClientHello ! io.Error {
    let c = cursor(body)
    let hello_version = u16_of(c)?
    let random = take(c, 32)?
    let session_id = vector8(c)?
    if session_id.len > 32 {
        fail Malformed
    }
    let suites_raw = cursor(vector16(c)?)
    var suites: []i64 = []
    for left(suites_raw) > 0 {
        push(mut suites, u16_of(suites_raw)?)
    }
    let compressions = vector8(c)?
    var exts: []Extension = []
    if left(c) > 0 {
        exts = extensions(c)?
    }
    end(c)?
    var versions: []i64 = []
    match find(exts, 43) {
        some(raw) => {
            let vc = cursor(raw)
            let list = cursor(vector8(vc)?)
            end(vc)?
            for left(list) > 0 {
                push(mut versions, u16_of(list)?)
            }
        }
        none => {}
    }
    var groups: []i64 = []
    match find(exts, 10) {
        some(raw) => {
            groups = u16_list(raw)?
        }
        none => {}
    }
    var schemes: []i64 = []
    match find(exts, 13) {
        some(raw) => {
            schemes = u16_list(raw)?
        }
        none => {}
    }
    var shares: []KeyShareEntry = []
    match find(exts, 51) {
        some(raw) => {
            let sc = cursor(raw)
            let list = cursor(vector16(sc)?)
            for left(list) > 0 {
                let group = u16_of(list)?
                push(mut shares, KeyShareEntry { group, key: vector16(list)? })
            }
        }
        none => {}
    }
    var protocols: []str = []
    match find(exts, 16) {
        some(raw) => {
            let ac = cursor(raw)
            let list = cursor(vector16(ac)?)
            for left(list) > 0 {
                push(mut protocols, str(vector8(list)?))
            }
        }
        none => {}
    }
    ClientHello { hello_version, random, session_id, suites, compressions, exts, versions, groups, shares, schemes, protocols }
}

fn server_hello(random: []u8, session_id: []u8, suite: Suite, group: i64, key: []u8, retry: bool) -> []u8 {
    var body: []u8 = []
    io.put_be16(mut body, 0x0303)
    io.append(mut body, random)
    put_vector8(mut body, session_id)
    io.put_be16(mut body, suite_code(suite))
    push(mut body, 0)
    var exts: []u8 = []
    put_extension(mut exts, 43, [3, 4])
    var share: []u8 = []
    io.put_be16(mut share, group)
    if !retry {
        put_vector16(mut share, key)
    }
    put_extension(mut exts, 51, share)
    put_vector16(mut body, exts)
    handshake_message(2, body)
}

fn choose_suite(preferred: []i64, offered: []i64) -> Suite? {
    for code in preferred {
        let suite = suite_of(code)
        if suite != none && slices.contains(offered, code) {
            return suite
        }
    }
    none
}

fn choose_scheme(candidates: []i64, offered: []i64) -> i64 {
    for s in candidates {
        if slices.contains(offered, s) {
            return s
        }
    }
    -1
}

fn share_of(hello: ClientHello, group: i64) -> KeyShareEntry? {
    for s in hello.shares {
        if s.group == group {
            return s
        }
    }
    none
}

fn preferred_group(hello: ClientHello, groups: []i64) -> i64 {
    for g in groups {
        let shared = match share_of(hello, g) {
            some(_) => true
            none => false
        }
        if supported_group(g) && (shared || slices.contains(hello.groups, g)) {
            return g
        }
    }
    -1
}

fn alpn_extension(mut exts: []u8, protocol: str) {
    if protocol.len == 0 {
        return
    }
    var names: []u8 = []
    put_vector8(mut names, bytes(protocol))
    var alpn: []u8 = []
    put_vector16(mut alpn, names)
    put_extension(mut exts, 16, alpn)
}

fn encrypted_extensions(c: *Channel, protocol: str) -> []u8 {
    var exts: []u8 = []
    alpn_extension(mut exts, protocol)
    match c.quic {
        some(t) => {
            put_extension(mut exts, 57, t.parameters)
        }
        none => {}
    }
    var body: []u8 = []
    put_vector16(mut body, exts)
    handshake_message(8, body)
}

fn choose_protocol(offered: []str, supported: []str) -> str {
    for p in supported {
        for o in offered {
            if o == p {
                return p
            }
        }
    }
    ""
}

fn refuse(c: *Channel, description: i64) -> io.Error {
    abort(c, description, Unsupported)
}

fn choose_version(config: Config, hello: ClientHello) -> i64 {
    if hello.versions.len > 0 {
        if offers13(config) && slices.contains(hello.versions, 0x0304) {
            return 0x0304
        }
        if offers12(config) && slices.contains(hello.versions, 0x0303) {
            return 0x0303
        }
        return -1
    }
    if offers12(config) && hello.hello_version >= 0x0303 {
        return 0x0303
    }
    -1
}

/// Performs a TLS server handshake over `s` and returns the established session.
///
/// Requires `config.certificates` and `config.key`. Accepts TLS 1.3 and TLS 1.2 within the version range of `config`. The cipher suite is the first in `config.cipher_suites` that the client also offers and that suits the key; the group is the first in `config.groups` the client supports, with a HelloRetryRequest when the client sent no share for it; the signature scheme must be one the client offers and the key allows (RSA keys sign with PSS in TLS 1.3). The first protocol in `config.alpn` that the client also offers is selected. Client certificates are not requested.
///
/// Blocks the green thread until the handshake completes. Fails with `Invalid` when the key or certificates are missing or the version range is unusable, with `Unsupported` when no version, suite, group or scheme is shared and with `Malformed` or `Invalid` for protocol violations. A failed handshake does not close `s`. When it succeeds, closing or dropping the `Session` also closes `s`.
pub fn server(s: io.Stream, config: Config) -> Session ! io.Error {
    let h = server_handle(s, config)?
    Session { handle: h }
}

/// Performs a TLS server handshake over `s` and returns the copyable `SessionHandle`.
///
/// Behaves as `server`, but the result is not dropped automatically: the caller closes it with `close_on`. Use it to hand a session to a green thread.
pub fn server_handle(s: io.Stream, config: Config) -> *SessionHandle ! io.Error {
    let key = match config.key {
        some(k) => k
        none => fail Invalid
    }
    if config.certificates.len == 0 || !versions_valid(config) {
        fail Invalid
    }
    let c = channel(s)
    let m = expect_message(c, 1)?
    let hello = parse_client_hello(m.body) or fail abort(c, 50, Malformed)
    let version = choose_version(config, hello)
    if version < 0 {
        fail refuse(c, 70)
    }
    if slices.contains(hello.suites, 0x5600) && version < config.max_version {
        fail refuse(c, 86)
    }
    c.version = version
    if version == 0x0303 {
        return server12(c, config, key, hello, m.raw)
    }
    let done = server13(c, config, key, hello, m.raw)?
    session(c, done.protocol, done.group, done.suite, suite_code(done.suite), done.chain)
}

fn check_quic_hello(c: *Channel, hello: ClientHello) ! io.Error {
    if !is_quic(c) {
        return
    }
    if hello.session_id.len > 0 {
        fail refuse(c, 47)
    }
    let _ = peer_parameters(c, hello.exts)?
}

fn require_protocol(c: *Channel, protocol: str) ! io.Error {
    if is_quic(c) && protocol.len == 0 {
        fail refuse(c, 120)
    }
}

fn server13(c: *Channel, config: Config, key: x509.PrivateKey, first_hello: ClientHello, first: []u8) -> Done13 ! io.Error {
    check_quic_hello(c, first_hello)?
    var hello = first_hello
    var transcript = first
    let suite = match choose_suite(config.cipher_suites, hello.suites) {
        some(found) => found
        none => fail refuse(c, 40)
    }
    let candidates = x509.signing_schemes(key, x509.SignatureRules.Tls13)
    let scheme = choose_scheme(candidates, hello.schemes)
    if scheme < 0 {
        fail refuse(c, 40)
    }
    let group = preferred_group(hello, config.groups)
    if group < 0 {
        fail refuse(c, 40)
    }
    var share = share_of(hello, group)
    let offered = match share {
        some(_) => true
        none => false
    }
    if !offered {
        let retry = server_hello(retry_random(), hello.session_id, suite, group, [], true)
        transcript = message_hash(suite_hash(suite), transcript)
        io.append(mut transcript, retry)
        write_record(c, 22, retry)?
        write_record(c, 20, [1])?
        let m = expect_message(c, 1)?
        hello = parse_client_hello(m.body) or fail abort(c, 50, Malformed)
        check_quic_hello(c, hello)?
        io.append(mut transcript, m.raw)
        share = share_of(hello, group)
    }
    let entry = match share {
        some(e) => e
        none => fail refuse(c, 47)
    }
    let exchanged = server_exchange(entry.group, entry.key) or fail refuse(c, 47)
    let protocol = choose_protocol(hello.protocols, config.alpn)
    require_protocol(c, protocol)?
    let reply = server_hello(crypto.random(32), hello.session_id, suite, entry.group, exchanged.public, false)
    io.append(mut transcript, reply)
    write_record(c, 22, reply)?
    write_record(c, 20, [1])?
    let k = schedule(suite, exchanged.secret, transcript)
    set_write_key(c, suite, k.server_handshake)?
    set_read_key(c, suite, k.client_handshake)?
    var flight: []u8 = []
    let ee = encrypted_extensions(c, protocol)
    io.append(mut transcript, ee)
    io.append(mut flight, ee)
    let cert = certificate_message([], config.certificates)
    io.append(mut transcript, cert)
    io.append(mut flight, cert)
    var cv_body: []u8 = []
    io.put_be16(mut cv_body, scheme)
    let content = verify_content(k.hash, transcript)
    let signature = x509.sign(key, scheme, content, x509.SignatureRules.Tls13)?
    put_vector16(mut cv_body, signature)
    let cv = handshake_message(15, cv_body)
    io.append(mut transcript, cv)
    io.append(mut flight, cv)
    let fin = handshake_message(20, finished(k, k.server_handshake, transcript))
    io.append(mut transcript, fin)
    io.append(mut flight, fin)
    write_record(c, 22, flight)?
    let client_app = derive_secret(k.hash, k.master, "c ap traffic", transcript)
    let server_app = derive_secret(k.hash, k.master, "s ap traffic", transcript)
    let client_fin = expect_message(c, 20)?
    if !hash.equal(client_fin.body, finished(k, k.client_handshake, transcript)) {
        fail abort(c, 51, Invalid)
    }
    set_write_key(c, suite, server_app)?
    set_read_key(c, suite, client_app)?
    let parameters = peer_parameters(c, hello.exts)?
    Done13 { protocol, group: entry.group, suite, chain: [], peer_parameters: parameters }
}
