import std/io

struct BmpMask {
    mask: i64
    shift: i64
    bits: i64
}

fn bmp_mask(mask: i64) -> BmpMask {
    if mask == 0 {
        return BmpMask { mask: 0, shift: 0, bits: 0 }
    }
    var shift = 0
    for (mask >> shift) & 1 == 0 {
        shift += 1
    }
    var bits = 0
    for (mask >> (shift + bits)) & 1 == 1 {
        bits += 1
    }
    BmpMask { mask, shift, bits }
}

fn bmp_channel(m: BmpMask, v: i64) -> u8 {
    if m.bits == 0 {
        return 0
    }
    let raw = (v & m.mask) >> m.shift
    if m.bits >= 8 {
        return u8(raw >> (m.bits - 8))
    }
    var out = raw << (8 - m.bits)
    var filled = m.bits
    for filled < 8 {
        out = out | out >> filled
        filled *= 2
    }
    u8(out)
}

fn bmp_signature(data: []u8) -> bool {
    starts_with(data, 0, "BM")
}

fn bmp_decode(data: []u8, max_pixels: i64) -> Image ! io.Error {
    if data.len < 26 {
        fail Malformed
    }
    let bits_at = io.le32(data, 10)
    let header = io.le32(data, 14)
    if header < 12 || 14 + header > data.len {
        fail Malformed
    }
    var width = 0
    var height = 0
    var bpp = 0
    var compression = 0
    var used = 0
    if header == 12 {
        width = io.le16(data, 18)
        height = io.le16(data, 20)
        bpp = io.le16(data, 24)
    } else {
        if header < 40 {
            fail Malformed
        }
        width = bmp_signed(io.le32(data, 18))
        height = bmp_signed(io.le32(data, 22))
        bpp = io.le16(data, 28)
        compression = io.le32(data, 30)
        used = io.le32(data, 46)
    }
    if bpp != 1 && bpp != 2 && bpp != 4 && bpp != 8 && bpp != 16 && bpp != 24 && bpp != 32 {
        fail Unsupported
    }
    if compression == 1 && bpp != 8 || compression == 2 && bpp != 4 || (compression == 3 || compression == 6) && bpp < 16 {
        fail Malformed
    }
    let top_down = height < 0
    if top_down {
        height = -height
    }
    var red = 0
    var green = 0
    var blue = 0
    var alpha = 0
    let masks_at = 14 + header
    if compression == 3 || compression == 6 {
        if header >= 52 {
            red = io.le32(data, 54)
            green = io.le32(data, 58)
            blue = io.le32(data, 62)
            if header >= 56 {
                alpha = io.le32(data, 66)
            }
        } else {
            let n = if compression == 6 { 16 } else { 12 }
            if masks_at + n > data.len {
                fail Malformed
            }
            red = io.le32(data, masks_at)
            green = io.le32(data, masks_at + 4)
            blue = io.le32(data, masks_at + 8)
            if compression == 6 {
                alpha = io.le32(data, masks_at + 12)
            }
        }
    } else if compression == 0 && bpp == 16 {
        red = 0x7C00
        green = 0x3E0
        blue = 0x1F
    } else if compression == 0 && bpp == 32 {
        red = 0xFF0000
        green = 0xFF00
        blue = 0xFF
    } else if compression != 0 && compression != 1 && compression != 2 {
        fail Unsupported
    }
    let row_bytes = (width * bpp + 31) / 32 * 4
    if compression == 0 && bpp == 32 && bmp_any_alpha(data, bits_at, row_bytes, width, height) {
        alpha = 0xFF000000
    }
    let format = if alpha != 0 { Format.Rgba8 } else { Format.Rgb8 }
    let img = checked_create(width, height, format, max_pixels)?
    var palette: []u8 = []
    if bpp <= 8 {
        palette = bmp_palette(data, masks_at, header, bpp, used, bits_at)?
    }
    if compression == 1 || compression == 2 {
        let indices = bmp_rle(data, bits_at, width, height, compression == 2)?
        for y in 0..height {
            let row = if top_down { y } else { height - 1 - y }
            for x in 0..width {
                bmp_put_index(img, x, row, palette, i64(indices[y * width + x]))
            }
        }
        return img
    }
    if bits_at < 0 || bits_at + row_bytes * (height - 1) + (width * bpp + 7) / 8 > data.len {
        fail Malformed
    }
    let mr = bmp_mask(red)
    let mg = bmp_mask(green)
    let mb = bmp_mask(blue)
    let ma = bmp_mask(alpha)
    let bppo = bytes_per_pixel(format)
    let out = img.pixels
    for y in 0..height {
        let src = bits_at + (if top_down { y } else { height - 1 - y }) * row_bytes
        var d = y * img.stride
        if bpp <= 8 {
            let per = 8 / bpp
            let low = (1 << bpp) - 1
            for x in 0..width {
                let byte = i64(data[src + x / per])
                let index = byte >> (8 - bpp - (x % per) * bpp) & low
                bmp_put_index(img, x, y, palette, index)
            }
        } else if bpp == 24 && compression == 0 {
            for x in 0..width {
                let s = src + x * 3
                out[d] = data[s + 2]
                out[d + 1] = data[s + 1]
                out[d + 2] = data[s]
                d += bppo
            }
        } else {
            let step = bpp / 8
            for x in 0..width {
                let s = src + x * step
                var v = io.le16(data, s)
                if step == 3 {
                    v = v | i64(data[s + 2]) << 16
                } else if step == 4 {
                    v = io.le32(data, s)
                }
                out[d] = bmp_channel(mr, v)
                out[d + 1] = bmp_channel(mg, v)
                out[d + 2] = bmp_channel(mb, v)
                if alpha != 0 {
                    out[d + 3] = bmp_channel(ma, v)
                }
                d += bppo
            }
        }
    }
    img
}

fn bmp_any_alpha(data: []u8, at: i64, row_bytes: i64, width: i64, height: i64) -> bool {
    if at < 0 || width <= 0 || height <= 0 || at + row_bytes * height > data.len {
        return false
    }
    for y in 0..height {
        let row = at + y * row_bytes
        for x in 0..width {
            if data[row + x * 4 + 3] != 0 {
                return true
            }
        }
    }
    false
}

fn bmp_signed(v: i64) -> i64 {
    if v >= 0x80000000 { v - 0x100000000 } else { v }
}

fn bmp_palette(data: []u8, at: i64, header: i64, bpp: i64, used: i64, limit: i64) -> []u8 ! io.Error {
    let entry = if header == 12 { 3 } else { 4 }
    let full = 1 << bpp
    let count = if used > 0 && used <= full { used } else { full }
    let palette: []u8 = __make(full * 3)
    let end = if limit > at && limit <= data.len { limit } else { data.len }
    for i in 0..count {
        let s = at + i * entry
        if s + 3 > end {
            if i == 0 {
                fail Malformed
            }
            break
        }
        palette[i * 3] = data[s + 2]
        palette[i * 3 + 1] = data[s + 1]
        palette[i * 3 + 2] = data[s]
    }
    palette
}

fn bmp_put_index(img: Image, x: i64, y: i64, palette: []u8, index: i64) {
    let d = y * img.stride + x * bytes_per_pixel(img.format)
    let p = index * 3
    img.pixels[d] = palette[p]
    img.pixels[d + 1] = palette[p + 1]
    img.pixels[d + 2] = palette[p + 2]
}

fn bmp_rle(data: []u8, at: i64, width: i64, height: i64, nibbles: bool) -> []u8 ! io.Error {
    let indices: []u8 = __make(width * height)
    var p = at
    var x = 0
    var y = 0
    for y < height {
        if p + 2 > data.len {
            fail Malformed
        }
        let n = i64(data[p])
        let v = data[p + 1]
        p += 2
        if n > 0 {
            for k in 0..n {
                if x < width {
                    indices[y * width + x] = if !nibbles { v } else if k % 2 == 0 { v >> 4 } else { v & 15 }
                }
                x += 1
            }
        } else if v == 0 {
            x = 0
            y += 1
        } else if v == 1 {
            break
        } else if v == 2 {
            if p + 2 > data.len {
                fail Malformed
            }
            x += i64(data[p])
            y += i64(data[p + 1])
            p += 2
        } else {
            let count = i64(v)
            let size = if nibbles { (count + 1) / 2 } else { count }
            if p + size > data.len {
                fail Malformed
            }
            for k in 0..count {
                let b = if nibbles { data[p + k / 2] } else { data[p + k] }
                if x < width {
                    indices[y * width + x] = if !nibbles { b } else if k % 2 == 0 { b >> 4 } else { b & 15 }
                }
                x += 1
            }
            p += (size + 1) / 2 * 2
        }
    }
    indices
}

/// Encodes `img` as an uncompressed bottom-up BMP.
///
/// An image with an alpha channel is written as 32 bits per pixel with a 108-byte header and bit fields; any other image is written as 24 bits per pixel with a 40-byte header. Images are converted to `Rgba8` or `Rgb8` first, so 16-bit samples are reduced to 8 bits and gray becomes equal red, green and blue.
pub fn encode_bmp(img: Image) -> []u8 {
    let alpha = has_alpha(img.format)
    let format = if alpha { Format.Rgba8 } else { Format.Rgb8 }
    let src = if img.format == format { img } else { convert(img, format) }
    let bpp = if alpha { 4 } else { 3 }
    let header = if alpha { 108 } else { 40 }
    let row_bytes = (src.width * bpp + 3) / 4 * 4
    let bits_at = 14 + header
    let size = bits_at + row_bytes * src.height
    let out: []u8 = __make(size)
    out[0] = 'B'
    out[1] = 'M'
    io.set_le32(out, 2, size)
    io.set_le32(out, 10, bits_at)
    io.set_le32(out, 14, header)
    io.set_le32(out, 18, src.width)
    io.set_le32(out, 22, src.height)
    io.set_le16(out, 26, 1)
    io.set_le16(out, 28, bpp * 8)
    io.set_le32(out, 30, if alpha { 3 } else { 0 })
    io.set_le32(out, 34, row_bytes * src.height)
    io.set_le32(out, 38, 2835)
    io.set_le32(out, 42, 2835)
    if alpha {
        io.set_le32(out, 54, 0xFF0000)
        io.set_le32(out, 58, 0xFF00)
        io.set_le32(out, 62, 0xFF)
        io.set_le32(out, 66, 0xFF000000)
        io.set_le32(out, 70, 0x73524742)
    }
    for y in 0..src.height {
        var s = (src.height - 1 - y) * src.stride
        var d = bits_at + y * row_bytes
        for _ in 0..src.width {
            out[d] = src.pixels[s + 2]
            out[d + 1] = src.pixels[s + 1]
            out[d + 2] = src.pixels[s]
            if alpha {
                out[d + 3] = src.pixels[s + 3]
            }
            s += bpp
            d += bpp
        }
    }
    out
}
