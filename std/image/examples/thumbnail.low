import std/image
import std/io

fn photo() -> image.Image {
    let img = image.create(64, 32, Rgb8)
    for y in 0..32 {
        for x in 0..64 {
            image.set(img, x, y, image.Rgba { r: u8(x * 4), g: u8(y * 8), b: 128, a: 255 })
        }
    }
    img
}

fn describe(label: str, img: image.Image) {
    let c = image.get(img, 0, 0)
    print("{label}: {img.width}x{img.height} {img.format} top-left=({c.r}, {c.g}, {c.b})")
}

/// Turns a sideways camera image upright, scales it to a thumbnail, crops a square and converts it to gray.
fn main() {
    let sideways = image.rotate270(photo())
    describe("stored", sideways)

    let upright = image.orient(sideways, 6)
    describe("upright", upright)

    let thumb = image.resize(upright, 16, 32, Bilinear)
    describe("thumbnail", thumb)

    let square = image.crop(thumb, 0, 8, 16, 16)
    describe("square", square)

    let gray = image.convert(square, Gray8)
    describe("gray", gray)
    print("gray bytes: {gray.pixels.len}, stride {gray.stride}")

    let overlay = image.create(4, 4, Rgba8)
    image.fill_rect(overlay, 0, 0, 4, 4, image.Rgba { r: 255, g: 255, b: 255, a: 128 })
    let canvas = image.convert(square, Rgba8)
    image.blend(canvas, overlay, 6, 6)
    let inside = image.get(canvas, 7, 7)
    let outside = image.get(canvas, 2, 2)
    print("blended: ({inside.r}, {inside.g}, {inside.b}) outside: ({outside.r}, {outside.g}, {outside.b})")
}
