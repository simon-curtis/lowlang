import std/io

fn qoi_hash(r: u8, g: u8, b: u8, a: u8) -> i64 {
    (i64(r) * 3 + i64(g) * 5 + i64(b) * 7 + i64(a) * 11) % 64
}

fn qoi_signature(data: []u8) -> bool {
    starts_with(data, 0, "qoif")
}

fn qoi_decode(data: []u8, max_pixels: i64) -> Image ! io.Error {
    if data.len < 22 {
        fail Malformed
    }
    let width = io.be32(data, 4)
    let height = io.be32(data, 8)
    let count = i64(data[12])
    if count != 3 && count != 4 {
        fail Malformed
    }
    let format = if count == 3 { Format.Rgb8 } else { Format.Rgba8 }
    let img = checked_create(width, height, format, max_pixels)?
    let out = img.pixels
    let index: []u8 = __make(256)
    var r: u8 = 0
    var g: u8 = 0
    var b: u8 = 0
    var a: u8 = 255
    var p = 14
    var run = 0
    let end = data.len - 8
    var o = 0
    for o < out.len {
        if run > 0 {
            run -= 1
        } else {
            if p >= end {
                fail Malformed
            }
            let op = data[p]
            p += 1
            if op == 0xFE {
                if p + 3 > end {
                    fail Malformed
                }
                r = data[p]
                g = data[p + 1]
                b = data[p + 2]
                p += 3
            } else if op == 0xFF {
                if p + 4 > end {
                    fail Malformed
                }
                r = data[p]
                g = data[p + 1]
                b = data[p + 2]
                a = data[p + 3]
                p += 4
            } else if op >> 6 == 0 {
                let at = i64(op) * 4
                r = index[at]
                g = index[at + 1]
                b = index[at + 2]
                a = index[at + 3]
            } else if op >> 6 == 1 {
                r += (op >> 4 & 3) - 2
                g += (op >> 2 & 3) - 2
                b += (op & 3) - 2
            } else if op >> 6 == 2 {
                if p >= end {
                    fail Malformed
                }
                let dg = (op & 0x3F) - 32
                let next = data[p]
                p += 1
                g += dg
                r += dg + (next >> 4) - 8
                b += dg + (next & 15) - 8
            } else {
                run = i64(op & 0x3F)
            }
            let at = qoi_hash(r, g, b, a) * 4
            index[at] = r
            index[at + 1] = g
            index[at + 2] = b
            index[at + 3] = a
        }
        out[o] = r
        out[o + 1] = g
        out[o + 2] = b
        if count == 4 {
            out[o + 3] = a
        }
        o += count
    }
    img
}

/// Encodes `img` as QOI, with 4 channels when the image has an alpha channel and 3 otherwise.
///
/// The image is converted to `Rgba8` or `Rgb8` first, so 16-bit samples are reduced to 8 bits. The color space byte is `0`.
pub fn encode_qoi(img: Image) -> []u8 {
    let alpha = has_alpha(img.format)
    let format = if alpha { Format.Rgba8 } else { Format.Rgb8 }
    let src = if img.format == format { img } else { convert(img, format) }
    let count = if alpha { 4 } else { 3 }
    let pixels = src.width * src.height
    let out: []u8 = __make(14 + pixels * (count + 1) + 8)
    out[0] = 'q'
    out[1] = 'o'
    out[2] = 'i'
    out[3] = 'f'
    io.set_be32(out, 4, src.width)
    io.set_be32(out, 8, src.height)
    out[12] = u8(count)
    out[13] = 0
    let index: []u8 = __make(256)
    var pr: u8 = 0
    var pg: u8 = 0
    var pb: u8 = 0
    var pa: u8 = 255
    var run = 0
    var o = 14
    for y in 0..src.height {
        var s = y * src.stride
        for x in 0..src.width {
            let r = src.pixels[s]
            let g = src.pixels[s + 1]
            let b = src.pixels[s + 2]
            let a: u8 = if alpha { src.pixels[s + 3] } else { 255 }
            s += count
            if r == pr && g == pg && b == pb && a == pa {
                run += 1
                if run == 62 {
                    out[o] = 0xC0 | u8(run - 1)
                    o += 1
                    run = 0
                }
                continue
            }
            if run > 0 {
                out[o] = 0xC0 | u8(run - 1)
                o += 1
                run = 0
            }
            let at = qoi_hash(r, g, b, a) * 4
            if index[at] == r && index[at + 1] == g && index[at + 2] == b && index[at + 3] == a {
                out[o] = u8(at / 4)
                o += 1
            } else {
                index[at] = r
                index[at + 1] = g
                index[at + 2] = b
                index[at + 3] = a
                if a == pa {
                    let dr = i64(r) - i64(pr)
                    let dg = i64(g) - i64(pg)
                    let db = i64(b) - i64(pb)
                    let wr = qoi_wrap(dr)
                    let wg = qoi_wrap(dg)
                    let wb = qoi_wrap(db)
                    let rg = qoi_wrap(wr - wg)
                    let bg = qoi_wrap(wb - wg)
                    if wr >= -2 && wr <= 1 && wg >= -2 && wg <= 1 && wb >= -2 && wb <= 1 {
                        out[o] = 0x40 | u8(wr + 2) << 4 | u8(wg + 2) << 2 | u8(wb + 2)
                        o += 1
                    } else if wg >= -32 && wg <= 31 && rg >= -8 && rg <= 7 && bg >= -8 && bg <= 7 {
                        out[o] = 0x80 | u8(wg + 32)
                        out[o + 1] = u8(rg + 8) << 4 | u8(bg + 8)
                        o += 2
                    } else {
                        out[o] = 0xFE
                        out[o + 1] = r
                        out[o + 2] = g
                        out[o + 3] = b
                        o += 4
                    }
                } else {
                    out[o] = 0xFF
                    out[o + 1] = r
                    out[o + 2] = g
                    out[o + 3] = b
                    out[o + 4] = a
                    o += 5
                }
            }
            pr = r
            pg = g
            pb = b
            pa = a
        }
    }
    if run > 0 {
        out[o] = 0xC0 | u8(run - 1)
        o += 1
    }
    out[o + 7] = 1
    out[..o + 8]
}

fn qoi_wrap(d: i64) -> i64 {
    let v = d & 0xFF
    if v >= 128 { v - 256 } else { v }
}
