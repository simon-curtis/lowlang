import std/testing
import std/text

struct PathCase {
    input: str
    want: str
}

struct AbsoluteCase {
    input: str
    want: bool
}

struct JoinCase {
    parts: str[]
    want: str
}

fn path_case_name(c: PathCase) -> str {
    text.quote(c.input)
}

fn absolute_case_name(c: AbsoluteCase) -> str {
    text.quote(c.input)
}

fn join_case_name(c: JoinCase) -> str {
    text.quote(text.join(c.parts, "|"))
}

fn test_volume(t: *testing.T) {
    let cases = [
        PathCase { input: "a\\b", want: "" }
        PathCase { input: "\\a", want: "" }
        PathCase { input: "1:\\a", want: "" }
        PathCase { input: "C:", want: "C:" }
        PathCase { input: "c:/a", want: "c:" }
        PathCase { input: "C:a", want: "C:" }
        PathCase { input: "\\\\server", want: "\\\\server" }
        PathCase { input: "\\\\server\\share\\a", want: "\\\\server\\share" }
        PathCase { input: "//server/share/a", want: "//server/share" }
        PathCase { input: "\\\\?\\C:\\a", want: "\\\\?\\C:" }
        PathCase { input: "\\\\?\\UNC\\server\\share\\a", want: "\\\\?\\UNC\\server\\share" }
        PathCase { input: "\\\\.\\pipe", want: "\\\\.\\" }
    ]
    t.table_of(cases, path_case_name, fn(st, c) {
        st.equal(volume(c.input), c.want)
    })
}

fn test_is_absolute(t: *testing.T) {
    let cases = [
        AbsoluteCase { input: "", want: false }
        AbsoluteCase { input: "C:\\data\\scripts\\query.sql", want: true }
        AbsoluteCase { input: "c:/a", want: true }
        AbsoluteCase { input: "C:\\", want: true }
        AbsoluteCase { input: "C:", want: false }
        AbsoluteCase { input: "C:x", want: false }
        AbsoluteCase { input: "\\x", want: false }
        AbsoluteCase { input: "/x", want: false }
        AbsoluteCase { input: "x", want: false }
        AbsoluteCase { input: "\\\\server\\share\\x.sql", want: true }
        AbsoluteCase { input: "\\\\server\\share", want: true }
        AbsoluteCase { input: "\\\\?\\C:\\a", want: true }
    ]
    t.table_of(cases, absolute_case_name, fn(st, c) {
        st.equal(is_absolute(c.input), c.want)
    })
}

fn test_clean(t: *testing.T) {
    let cases = [
        PathCase { input: "C:\\data\\..\\scripts", want: "C:\\scripts" }
        PathCase { input: "c:/a//b/./c/", want: "c:\\a\\b\\c" }
        PathCase { input: "C:\\..", want: "C:\\" }
        PathCase { input: "C:\\", want: "C:\\" }
        PathCase { input: "C:", want: "C:." }
        PathCase { input: "C:a\\..", want: "C:." }
        PathCase { input: "C:..\\a", want: "C:..\\a" }
        PathCase { input: "\\a\\..\\..", want: "\\" }
        PathCase { input: "a/b\\c", want: "a\\b\\c" }
        PathCase { input: "\\\\server\\share", want: "\\\\server\\share" }
        PathCase { input: "\\\\server\\share\\..", want: "\\\\server\\share\\" }
        PathCase { input: "//server/share/a/../b", want: "\\\\server\\share\\b" }
        PathCase { input: "\\\\?\\C:\\a\\..\\b", want: "\\\\?\\C:\\b" }
    ]
    t.table_of(cases, path_case_name, fn(st, c) {
        st.equal(clean(c.input), c.want)
    })
}

fn test_join(t: *testing.T) {
    let cases = [
        JoinCase { parts: ["C:\\data", "query.sql"], want: "C:\\data\\query.sql" }
        JoinCase { parts: ["C:", "x"], want: "C:x" }
        JoinCase { parts: ["C:", "\\x"], want: "C:\\x" }
        JoinCase { parts: ["C:", "", "x", "y"], want: "C:x\\y" }
        JoinCase { parts: ["C:\\", "x"], want: "C:\\x" }
        JoinCase { parts: ["\\\\server\\share", "x"], want: "\\\\server\\share\\x" }
        JoinCase { parts: ["a/b", "c"], want: "a\\b\\c" }
        JoinCase { parts: ["\\", "x"], want: "\\x" }
        JoinCase { parts: ["/", "/x"], want: "\\x" }
        JoinCase { parts: ["a\\", "\\\\b"], want: "a\\b" }
    ]
    t.table_of(cases, join_case_name, fn(st, c) {
        st.equal(join(c.parts), c.want)
    })
}

fn test_base(t: *testing.T) {
    let cases = [
        PathCase { input: "C:\\data\\scripts\\query.sql", want: "query.sql" }
        PathCase { input: "C:\\data\\", want: "data" }
        PathCase { input: "a/b\\c", want: "c" }
        PathCase { input: "C:x", want: "x" }
        PathCase { input: "C:\\", want: "\\" }
        PathCase { input: "C:", want: "\\" }
        PathCase { input: "\\\\server\\share", want: "\\" }
        PathCase { input: "\\\\server\\share\\x.sql", want: "x.sql" }
    ]
    t.table_of(cases, path_case_name, fn(st, c) {
        st.equal(base(c.input), c.want)
    })
}

fn test_dir(t: *testing.T) {
    let cases = [
        PathCase { input: "C:\\data\\scripts\\query.sql", want: "C:\\data\\scripts" }
        PathCase { input: "C:\\x", want: "C:\\" }
        PathCase { input: "C:\\", want: "C:\\" }
        PathCase { input: "C:x", want: "C:." }
        PathCase { input: "C:a\\b", want: "C:a" }
        PathCase { input: "\\x", want: "\\" }
        PathCase { input: "a/b\\c", want: "a\\b" }
        PathCase { input: "\\\\server\\share", want: "\\\\server\\share" }
        PathCase { input: "\\\\server\\share\\x.sql", want: "\\\\server\\share\\" }
    ]
    t.table_of(cases, path_case_name, fn(st, c) {
        st.equal(dir(c.input), c.want)
    })
}

fn test_ext_and_stem_stop_at_backslash(t: *testing.T) {
    t.equal(ext("C:\\data\\scripts\\query.sql"), ".sql")
    t.equal(ext("a.b\\c"), "")
    t.equal(stem("C:\\data\\query.sql"), "query")
}

fn test_backslash_separates(t: *testing.T) {
    testing.error_if(t, !is_separator('\\'), "\\ is not a separator")
}
