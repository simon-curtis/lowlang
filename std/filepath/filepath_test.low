import std/path
import std/testing
import std/text

fn slash_inputs() -> str[] {
    [
        "", ".", "./", "..", "/", "/./", "/..", "/../a", "/a/../..", "/a/b", "/a//b/./c/",
        "a", "a/", "a//", "./a", "a//b", "a/./b", "a/b/", "a/../b", "a/..", "a/b/../../c",
        "../a", "../..", "a/../../b", "../a/..", "...", "a/.../..", ".hidden", "a.tar.gz",
        "dir/.profile", "archive/", "/var/log/syslog.1.gz", "plain"
    ]
}

fn native(p: str) -> str {
    text.replace(p, "/", separator())
}

fn test_matches_path_without_a_volume(t: *testing.T) {
    t.table_of(slash_inputs(), text.quote, fn(st, p) {
        st.equal(clean(p), native(path.clean(p)))
        st.equal(dir(p), native(path.dir(p)))
        st.equal(base(p), native(path.base(p)))
        st.equal(ext(p), path.ext(p))
        st.equal(stem(p), native(path.stem(p)))
        st.equal(join([p, "x"]), native(path.join([p, "x"])))
        st.equal(volume(p), "")
    })
}

fn test_join_skips_empty_parts(t: *testing.T) {
    t.equal(join([]), "")
    t.equal(join(["", ""]), "")
    t.equal(join(["a", "", "b"]), native("a/b"))
    t.equal(join(["a", "/b"]), native("a/b"))
}

fn test_slash_separates(t: *testing.T) {
    testing.error_if(t, !is_separator('/'), "/ is not a separator")
    testing.error_if(t, is_separator('a'), "a is a separator")
}
