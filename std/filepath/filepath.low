import std/text

/// Returns `true` when `c` separates path segments on the target: `/`, and on Windows `\` as well.
pub fn is_separator(c: u8) -> bool {
    c == '/' || c == separator()[0]
}

/// Returns the volume that starts `p` as written, or the empty string when it has none.
///
/// Only Windows has volumes: a drive (`C:`), a share (`\\server\share`), or a device prefix (`\\?\C:`, `\\?\UNC\server\share`, or `\\?\` and `\\.\` alone).
pub fn volume(p: str) -> str {
    p[..volume_length(p)]
}

fn is_share(p: str, length: i64) -> bool {
    length >= 2 && is_separator(p[0]) && is_separator(p[1])
}

fn segments(p: str) -> str[] {
    var parts: str[] = []
    var start = 0
    for i in 0..p.len {
        if is_separator(p[i]) {
            parts.push(p[start..i])
            start = i + 1
        }
    }
    parts.push(p[start..])
    parts
}

/// Returns `true` when `p` names the same file whatever the current directory and drive.
///
/// On Linux that is a path that starts with `/`. On Windows it is a share or device path, or a drive followed by a separator: `C:\x` is absolute, while `C:x` (relative to the current directory of drive `C`) and `\x` (relative to the current drive) are not. The empty string is not absolute.
pub fn is_absolute(p: str) -> bool {
    let length = volume_length(p)
    if is_share(p, length) {
        return true
    }
    let rooted = length < p.len && is_separator(p[length])
    rooted && (length > 0 || !has_volumes())
}

/// Returns the shortest equivalent of `p` by lexical processing alone, without touching the file system, written with the target's separator.
///
/// The volume is kept. Repeated separators and `.` segments are dropped and a `..` removes the segment before it. A leading `..` is kept in a path that does not start with a separator after its volume, and dropped in one that does. A trailing separator is removed. An empty result is the separator for a rooted path, the share for a bare share, and `"."` after any other volume or none: `clean("C:")` is `"C:."`.
pub fn clean(p: str) -> str {
    if p.len == 0 {
        return "."
    }
    let length = volume_length(p)
    let prefix = text.replace(p[..length], "/", separator())
    let rooted = length < p.len && is_separator(p[length])
    var kept: str[] = []
    for part in segments(p[length..]) {
        if part.len == 0 || part == "." {
            continue
        }
        if part == ".." {
            if kept.len > 0 && kept[kept.len - 1] != ".." {
                kept.pop()
                continue
            }
            if rooted {
                continue
            }
        }
        kept.push(part)
    }
    let body = text.join(kept, separator())
    if rooted {
        return "{prefix}{separator()}{body}"
    }
    if body.len > 0 {
        return "{prefix}{body}"
    }
    if is_share(p, length) {
        return prefix
    }
    "{prefix}."
}

fn trim_separators(p: str) -> str {
    var start = 0
    for start < p.len && is_separator(p[start]) {
        start += 1
    }
    p[start..]
}

fn is_bare_drive(pieces: str[]) -> bool {
    if pieces.len != 1 {
        return false
    }
    let only = pieces[0]
    volume_length(only) == only.len && !is_share(only, only.len)
}

/// Joins the non-empty `parts` with the target's separator and returns the cleaned result.
///
/// Empty parts are skipped. Leading separators of a later part are dropped, so later absolute parts do not replace earlier ones and two parts never meet as a share prefix: `join(["\", "x"])` is `"\x"`. A part that follows a bare drive is appended as it is, so `join(["C:", "x"])` is `"C:x"`. Returns the empty string, not `"."`, when no part is non-empty.
pub fn join(parts: str[]) -> str {
    var pieces: str[] = []
    for part in parts {
        let drive = is_bare_drive(pieces)
        let rest = if pieces.len == 0 || drive { part } else { trim_separators(part) }
        if rest.len == 0 {
            continue
        }
        if pieces.len > 0 && !drive {
            let previous = pieces[pieces.len - 1]
            if !is_separator(previous[previous.len - 1]) {
                pieces.push(separator())
            }
        }
        pieces.push(rest)
    }
    if pieces.len == 0 {
        return ""
    }
    clean(text.join(pieces, ""))
}

/// Returns the last segment of `p` after trailing separators are removed.
///
/// Returns `"."` for the empty string and the target's separator when `p` holds only a volume and separators.
pub fn base(p: str) -> str {
    if p.len == 0 {
        return "."
    }
    var end = p.len
    for end > 0 && is_separator(p[end - 1]) {
        end -= 1
    }
    let length = volume_length(p[..end])
    var start = end
    for start > length && !is_separator(p[start - 1]) {
        start -= 1
    }
    if start == end {
        return separator()
    }
    p[start..end]
}

/// Returns `p` without its last segment, cleaned. The last segment is the one `base` returns, so trailing separators are removed first.
///
/// The volume is kept. Returns `"."` when neither a volume nor a separator precedes the last segment, and the root for a path directly under it.
pub fn dir(p: str) -> str {
    let length = volume_length(p)
    var end = p.len
    for end > length + 1 && is_separator(p[end - 1]) {
        end -= 1
    }
    var slash = end - 1
    for slash >= length && !is_separator(p[slash]) {
        slash -= 1
    }
    match length {
        <= slash => clean(p[..slash + 1])
        0 => "."
        _ => clean(p[..length])
    }
}

/// Returns the extension of the last segment of `p`, including the leading dot, or the empty string when it has none.
///
/// The extension starts at the last `.` in the final segment, so `"a.tar.gz"` gives `".gz"` and a name that starts with a dot such as `".profile"` gives the whole name. A path that ends in a separator has no extension.
pub fn ext(p: str) -> str {
    var i = p.len - 1
    for i >= 0 && !is_separator(p[i]) {
        if p[i] == '.' {
            return p[i..]
        }
        i -= 1
    }
    ""
}

/// Returns the last segment of `p` without its extension.
///
/// The segment is taken as `base` returns it and the suffix as `ext` returns it from that segment.
pub fn stem(p: str) -> str {
    let name = base(p)
    text.trim_suffix(name, ext(name))
}
