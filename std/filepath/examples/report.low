import std/filepath

/// Builds a report path with the target's separator and takes it apart again.
fn main() {
    let report = filepath.join(["reports", "2026", "drafts", "..", "q3.final.csv"])
    print("base: {filepath.base(report)}")
    print("stem: {filepath.stem(report)}")
    print("ext: {filepath.ext(report)}")
    print("parent: {filepath.base(filepath.dir(report))}")
    print("absolute: {filepath.is_absolute(report)}")
    print("volume: {filepath.volume(report).len}")
    print("cleaned twice: {filepath.clean(report) == report}")
}
