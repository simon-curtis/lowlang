import std/text

fn separator() -> str {
    "\\"
}

fn has_volumes() -> bool {
    true
}

fn is_drive(p: str, at: i64) -> bool {
    if at + 2 > p.len || p[at + 1] != ':' {
        return false
    }
    let letter = p[at] | 0x20
    letter >= 'a' && letter <= 'z'
}

fn component_end(p: str, from: i64) -> i64 {
    var end = from
    for end < p.len && !is_separator(p[end]) {
        end += 1
    }
    end
}

fn share_end(p: str, at: i64) -> i64 {
    let server = component_end(p, at)
    if server >= p.len {
        return p.len
    }
    component_end(p, server + 1)
}

fn device_end(p: str) -> i64 {
    if is_drive(p, 4) {
        return 6
    }
    if p.len >= 8 && is_separator(p[7]) && text.equal_fold(p[4..7], "UNC") {
        return share_end(p, 8)
    }
    4
}

fn volume_length(p: str) -> i64 {
    if p.len >= 2 && is_separator(p[0]) && is_separator(p[1]) {
        let device = p.len >= 4 && (p[2] == '?' || p[2] == '.') && is_separator(p[3])
        if device {
            return device_end(p)
        }
        return share_end(p, 2)
    }
    if is_drive(p, 0) {
        return 2
    }
    0
}
