import std/cancel
import std/header
import std/http/qpack
import std/io
import std/net
import std/quic
import std/text

/// Accepts QUIC connections from `l` and serves each on its own green thread over HTTP/3, calling `handler` for every request.
///
/// Blocks until accepting fails and returns that error, which is `NotConnected` once the listener is closed. The listener's `config.tls.alpn` should be `["h3"]`; a connection that negotiated another protocol is closed with `H3_GENERAL_PROTOCOL_ERROR`. Each request stream runs on its own green thread, and a connection runs at most the listener's `config.max_streams` handlers at a time: the next request stream is not accepted until one of them has returned and written its response, so the QUIC stream credit of the peer stays held back meanwhile. A request that is malformed is answered by resetting its stream with `H3_MESSAGE_ERROR` and the handler is not called; a field section over 64 KiB is answered with `431`; a protocol violation on a connection closes that connection with the matching HTTP/3 error code. `Request.token` is cancelled when the response is complete, when a write of the response fails because the client stopped or reset the stream, and when the connection ends; a client that stops the stream while the handler is still running is not noticed until the handler's response is written. The server sends no push, accepts no extended `CONNECT` and no HTTP datagrams, and uses only the static QPACK table for the field sections it sends. Errors on one connection never reach the caller.
///
/// The default `Limits` apply, shared by the connections of this call. A request stream is reset with `H3_EXCESSIVE_LOAD` when its header section takes longer than `head_timeout`, when its body arrives below `body_rate` over `body_timeout` or grows past `max_body`, and when the client takes longer than `write_timeout` for 64 KiB of the response; a body past `max_bodies`, which counts every byte of an HTTP/3 body, is reset with `H3_REQUEST_REJECTED`. A connection is closed with `H3_EXCESSIVE_LOAD` when it opens no request within `head_timeout` of being accepted or has had no request open for `idle_timeout`. At `max_connections`, which is 4096 when the field is zero, a new connection displaces the one that has had no request open the longest, then the one that has waited longest to open its first, then, among the connections whose handlers have all returned and that only send their responses, the one that has sent the fewest bytes a second over the last 4 to 8 seconds, then the one longest with nothing but responses that have a `stream` in progress. It is itself closed with `H3_EXCESSIVE_LOAD` while every connection has a handler running. `max_connections_per_address` applies as it does to `serve`. Past `handler_timeout` the token of a request is cancelled, and a connection with a handler running is never displaced.
pub fn serve_quic(l: quic.Listener, handler: fn(Request) -> Response) ! io.Error {
    serve_quic_on(l.handle, handler)?
}

/// Serves HTTP/3 as `serve_quic` does, accepting from a `ListenerHandle`.
pub fn serve_quic_on(l: *quic.ListenerHandle, handler: fn(Request) -> Response) ! io.Error {
    serve_quic_with(l, Limits {}, handler)?
}

/// Serves HTTP/3 as `serve_quic_on` does, under `limits` in place of the defaults.
pub fn serve_quic_with(l: *quic.ListenerHandle, limits: Limits, handler: fn(Request) -> Response) ! io.Error {
    var held = untimed(limits)
    held.head_timeout = limits.head_timeout
    held.idle_timeout = limits.idle_timeout
    if held.max_connections <= 0 {
        held.max_connections = most_derived_connections
    }
    let connections = watchdog(held)
    defer stop(connections)
    spawn patrol(connections)
    let requests = watchdog(limits)
    requests.allowance = 0
    defer stop(requests)
    spawn patrol(requests)
    let server = H3Server { requests, handler, max_handlers: l.config.max_streams }
    for {
        let h = quic.accept_handle(l)?
        match admit(connections, net.format_ip(h.remote.ip), fn() { quic.close_on(h, h3_excessive_load, "") }) {
            some(pace) => {
                spawn serve_h3(h, pace, server)
            }
            none => {
                spawn refuse_h3(h)
            }
        }
    }
}

struct H3Server {
    requests: *Watchdog
    handler: fn(Request) -> Response
    max_handlers: i64
}

struct H3Session {
    c: *H3
    server: H3Server
    pace: *Pace
    lock: chan[bool]
    open: i64
    running: i64
    streams: i64
    slots: chan[bool]
}

enum RequestPhase {
    Start
    Body
    Done
}

enum ReadStep {
    More
    Complete
    Abandoned
}

struct InboundRequest {
    pace: *Pace
    load: *Pace
    returned: bool
    streamed: bool
    id: i64
    phase: RequestPhase
    fields: header.Header[]
    body: u8[]
}

fn refuse_h3(h: *quic.ConnectionHandle) {
    using owner = quic.adopt(h)
    quic.close_on(h, h3_excessive_load, "")
}

fn serve_h3(h: *quic.ConnectionHandle, pace: *Pace, server: H3Server) {
    using owner = quic.adopt(h)
    using watch = Watch { pace }
    if h.protocol != "h3" {
        quic.close_on(h, h3_general_protocol_error, "")
        return
    }
    let c = open_h3(h, false) catch {
        _ => return
    }
    spawn watch_peer_streams(c)
    let capacity = if server.max_handlers < 1 { 1 } else { server.max_handlers }
    accept_requests(new(H3Session { c, server, pace, lock: chan[bool](1), open: 0, running: 0, streams: 0, slots: chan[bool](capacity) }))
    cancel.cancel(c.token)
}

fn watch_peer_streams(c: *H3) {
    accept_uni(c)
    cancel.cancel(c.token)
}

fn accept_requests(n: *H3Session) {
    let gone = cancel.done(n.c.token)
    for {
        select {
            n.slots <- true => {}
            <-gone => return
        }
        let s = quic.accept_stream_on(n.c.handle) catch {
            _ => {
                <-n.slots
                return
            }
        }
        request_opened(n)
        spawn serve_request(n, s)
    }
}

fn request_opened(n: *H3Session) {
    n.lock <- true
    n.open += 1
    n.running += 1
    unbound(some(n.pace))
    <-n.lock
}

fn request_returned(n: *H3Session, p: *InboundRequest, streamed: bool) {
    n.lock <- true
    p.returned = true
    p.streamed = streamed
    n.running -= 1
    if streamed {
        n.streams += 1
    }
    quiesce(n)
    <-n.lock
}

fn quiesce(n: *H3Session) {
    if n.running > 0 {
        return
    }
    if n.streams > 0 {
        flowing(some(n.pace))
    } else {
        sending(some(n.pace))
    }
}

fn request_closed(n: *H3Session, p: *InboundRequest) {
    n.lock <- true
    n.open -= 1
    if !p.returned {
        n.running -= 1
    }
    if p.streamed {
        n.streams -= 1
    }
    if n.open == 0 {
        resting(some(n.pace))
    } else {
        quiesce(n)
    }
    <-n.lock
    <-n.slots
}

fn serve_request(n: *H3Session, s: quic.Stream) {
    let c = n.c
    let token = cancel.child(c.token)
    defer cancel.cancel(token)
    using watch = Watch { pace: enrol(n.server.requests, "", fn() { abort_stream(c, s, h3_excessive_load) }) }
    let r = io.reader(quic.stream(s))
    let p = new(InboundRequest { pace: watch.pace, load: n.pace, returned: false, streamed: false, id: s.id, phase: Start, fields: [], body: [] })
    defer request_closed(n, p)
    for {
        match read_step(c, s, r, p) {
            More => {}
            Complete => break
            Abandoned => return
        }
    }
    working(some(p.pace), token)
    free_body(some(p.pace), p.body.len)
    answer(n, s, p, token)
}

fn interrupted(c: *H3, s: quic.Stream, e: io.Error) -> ReadStep {
    match e {
        Reset => {
            quic.reset(s, h3_request_cancelled)
            abandon_section(c, s.id)
        }
        Malformed => close_with(c, h3_frame_error)
        _ => {}
    }
    Abandoned
}

fn read_step(c: *H3, s: quic.Stream, r: *io.Reader, p: *InboundRequest) -> ReadStep {
    let head = read_h3_head(r) catch {
        e => return interrupted(c, s, e)
    }
    let h = match head {
        some(x) => x
        none => return Complete
    }
    if h.kind == h3_frame_data {
        return step_data(c, s, r, p, h.length)
    }
    if h.kind == h3_frame_headers {
        return step_headers(c, s, r, p, h.length)
    }
    if unexpected_on_request(h.kind) {
        close_with(c, h3_frame_unexpected)
        return Abandoned
    }
    skip_h3(r, h.length) catch {
        e => return interrupted(c, s, e)
    }
    More
}

fn step_data(c: *H3, s: quic.Stream, r: *io.Reader, p: *InboundRequest, length: i64) -> ReadStep {
    if p.phase != Body {
        close_with(c, h3_frame_unexpected)
        return Abandoned
    }
    if p.body.len + length > p.pace.limits.max_body {
        abort_stream(c, s, h3_excessive_load)
        return Abandoned
    }
    read_h3_data(r, length, mut p.body, some(p.pace)) catch {
        NoSpace => {
            abort_stream(c, s, h3_request_rejected)
            return Abandoned
        }
        e => return interrupted(c, s, e)
    }
    More
}

fn step_headers(c: *H3, s: quic.Stream, r: *io.Reader, p: *InboundRequest, length: i64) -> ReadStep {
    if p.phase == Done {
        close_with(c, h3_frame_unexpected)
        return Abandoned
    }
    let block = read_h3_block(r, length, h3_max_field_section) catch {
        TooLarge => {
            close_with(c, h3_excessive_load)
            return Abandoned
        }
        e => return interrupted(c, s, e)
    }
    let fields = decode_fields(c, s.id, block, chan[bool]()) catch {
        TooLarge => return oversized_section(c, s, p)
        _ => return Abandoned
    }
    if p.phase == Start {
        if !valid_h3_request(fields) {
            abort_stream(c, s, h3_message_error)
            return Abandoned
        }
        p.fields = fields
        p.phase = Body
        stalling(some(p.pace))
        return More
    }
    if !valid_h3_trailers(fields) {
        abort_stream(c, s, h3_message_error)
        return Abandoned
    }
    p.phase = Done
    More
}

fn oversized_section(c: *H3, s: quic.Stream, p: *InboundRequest) -> ReadStep {
    let denied = response(431, status_text(431))
    send_response(c, paced_h3(s, p), "GET", denied, cancel.token()) catch {
        _ => {}
    }
    quic.stop(s, h3_no_error)
    abandon_section(c, s.id)
    Abandoned
}

fn answer(n: *H3Session, s: quic.Stream, p: *InboundRequest, token: *cancel.Token) {
    let c = n.c
    if p.phase == Start || !h3_length_matches(p.fields, p.body.len) {
        abort_stream(c, s, h3_message_error)
        return
    }
    var req = request_of(p.fields, p.body, Http3) catch {
        _ => {
            abort_stream(c, s, h3_message_error)
            return
        }
    }
    req.remote = c.remote
    req.token = token
    let produced = traced(n.server.handler, req)
    let outgoing = unstreamed(req.method, produced, token)
    request_returned(n, p, streaming(outgoing))
    send_response(c, paced_h3(s, p), req.method, outgoing, token) catch {
        _ => {}
    }
}

struct H3Sink {
    stream: quic.Stream
    pace: *Pace
    load: *Pace
}

fn paced_h3(stream: quic.Stream, p: *InboundRequest) -> H3Sink {
    H3Sink { stream, pace: p.pace, load: p.load }
}

fn write_paced(k: H3Sink, data: u8[]) ! io.Error {
    var rest = data
    for rest.len > 0 {
        let piece = if rest.len > write_piece { rest[..write_piece] } else { rest }
        k.pace.busy = due(k.pace.limits.write_timeout)
        quic.write(k.stream, piece) catch {
            e => {
                k.pace.busy = 0
                fail e
            }
        }
        k.pace.busy = 0
        tally(k.load, piece.len)
        rest = rest[piece.len..]
    }
}

fn send_response(c: *H3, s: H3Sink, method: str, resp: Response, token: *cancel.Token) ! io.Error {
    var body = resp.body
    if bodiless(method, resp.status) {
        body = []
    }
    let chunks = resp.stream
    var fields: header.Header[] = [header.Header { name: ":status", value: "{resp.status}" }]
    for h in resp.headers {
        let name = text.lower(h.name)
        if !connection_specific(name) && !pseudo_name(name) {
            fields.push(header.Header { name, value: h.value })
        }
    }
    if !header.has(resp.headers, "content-length") && !streaming(resp) {
        fields.push(header.Header { name: "content-length", value: "{body.len}" })
    }
    var out: u8[] = []
    put_h3_frame(mut out, h3_frame_headers, qpack.encode(c.encoder, fields))
    if body.len > 0 {
        put_h3_head(mut out, h3_frame_data, body.len)
    }
    write_paced(s, out)?
    if body.len > 0 {
        write_paced(s, body)?
    }
    match chunks {
        some(channel) => relay_chunks(s, channel, token)?
        none => {}
    }
    var trailers: header.Header[] = []
    for h in resp.trailers {
        let name = text.lower(h.name)
        if !connection_specific(name) && !pseudo_name(name) {
            trailers.push(header.Header { name, value: h.value })
        }
    }
    if trailers.len > 0 {
        var tail: u8[] = []
        put_h3_frame(mut tail, h3_frame_headers, qpack.encode(c.encoder, trailers))
        write_paced(s, tail)?
    }
    quic.finish(s.stream)?
}

fn relay_chunks(s: H3Sink, chunks: chan[u8[]], token: *cancel.Token) ! io.Error {
    let gone = cancel.done(token)
    for {
        select {
            part = <-chunks => match part {
                some(data) => send_chunk(s, data)?
                none => break
            }
            <-gone => break
        }
    }
}

fn send_chunk(s: H3Sink, data: u8[]) ! io.Error {
    if data.len == 0 {
        return
    }
    var head: u8[] = []
    put_h3_head(mut head, h3_frame_data, data.len)
    write_paced(s, head)?
    write_paced(s, data)?
}
