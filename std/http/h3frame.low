import std/header
import std/io
import std/quic/wire
import std/text

struct H3Head {
    kind: i64
    length: i64
}

struct H3Setting {
    id: i64
    value: i64
}

const h3_frame_data = 0x00
const h3_frame_headers = 0x01
const h3_frame_cancel_push = 0x03
const h3_frame_settings = 0x04
const h3_frame_push_promise = 0x05
const h3_frame_goaway = 0x07
const h3_frame_max_push_id = 0x0d

fn h3_frame_reserved_http2(kind: i64) -> bool {
    kind == 0x02 || kind == 0x06 || kind == 0x08 || kind == 0x09
}

const h3_stream_control = 0x00
const h3_stream_push = 0x01
const h3_stream_qpack_encoder = 0x02
const h3_stream_qpack_decoder = 0x03
const h3_setting_qpack_capacity = 0x01
const h3_setting_max_field_section = 0x06
const h3_setting_qpack_blocked = 0x07

fn h3_reserved_setting(id: i64) -> bool {
    id >= 0x02 && id <= 0x05
}

const h3_no_error = 0x100
const h3_general_protocol_error = 0x101
const h3_internal_error = 0x102
const h3_stream_creation_error = 0x103
const h3_closed_critical_stream = 0x104
const h3_frame_unexpected = 0x105
const h3_frame_error = 0x106
const h3_excessive_load = 0x107
const h3_id_error = 0x108
const h3_settings_error = 0x109
const h3_missing_settings = 0x10a
const h3_request_rejected = 0x10b
const h3_request_cancelled = 0x10c
const h3_request_incomplete = 0x10d
const h3_message_error = 0x10e
const h3_connect_error = 0x10f
const h3_version_fallback = 0x110
const h3_max_field_section = 65536
const h3_max_control_frame = 16384
const h3_max_settings = 64
const h3_max_uni_streams = 16
const h3_qpack_capacity = 4096
const h3_qpack_blocked = 16
const h3_read_chunk = 16384
const h3_block_chunk = 4096

fn h3_failure_code(e: io.Error) -> i64 {
    match e {
        TooLarge => h3_excessive_load
        Malformed => h3_frame_error
        Invalid => h3_settings_error
        _ => 0
    }
}

fn read_h3_varint(r: *io.Reader) -> i64 ! io.Error {
    let first = i64(io.read_byte(r)?)
    let size = 1 << (first >> 6)
    var v = first & 0x3f
    for i in 1..size {
        let b = io.read_byte(r) catch {
            Eof => fail Malformed
            e => fail e
        }
        v = v << 8 | i64(b)
    }
    v
}

fn read_h3_head(r: *io.Reader) -> H3Head? ! io.Error {
    let kind = read_h3_varint(r) catch {
        Eof => return none
        e => fail e
    }
    let length = read_h3_varint(r) catch {
        Eof => fail Malformed
        e => fail e
    }
    some(H3Head { kind, length })
}

fn h3_scratch(left: i64, chunk: i64) -> []u8 {
    io.buffer(if left < chunk { left } else { chunk })
}

fn read_h3_block(r: *io.Reader, length: i64, limit: i64) -> []u8 ! io.Error {
    if length > limit {
        fail TooLarge
    }
    var out: []u8 = []
    if length == 0 {
        return out
    }
    let scratch = h3_scratch(length, h3_block_chunk)
    var left = length
    for left > 0 {
        let want = if left < scratch.len { left } else { scratch.len }
        let n = io.read_some(r, scratch[..want])?
        if n == 0 {
            fail Malformed
        }
        io.append(mut out, scratch[..n])
        left -= n
    }
    out
}

fn skip_h3(r: *io.Reader, length: i64) ! io.Error {
    if length == 0 {
        return
    }
    let scratch = h3_scratch(length, h3_block_chunk)
    var left = length
    for left > 0 {
        let want = if left < scratch.len { left } else { scratch.len }
        let n = io.read_some(r, scratch[..want])?
        if n == 0 {
            fail Malformed
        }
        left -= n
    }
}

fn read_h3_data(r: *io.Reader, length: i64, mut body: []u8) ! io.Error {
    if length == 0 {
        return
    }
    let scratch = h3_scratch(length, h3_read_chunk)
    var left = length
    for left > 0 {
        let want = if left < scratch.len { left } else { scratch.len }
        let n = io.read_some(r, scratch[..want])?
        if n == 0 {
            fail Malformed
        }
        io.append(mut body, scratch[..n])
        left -= n
    }
}

fn put_h3_head(mut out: []u8, kind: i64, length: i64) {
    wire.put_varint(mut out, kind)
    wire.put_varint(mut out, length)
}

fn put_h3_frame(mut out: []u8, kind: i64, payload: []u8) {
    put_h3_head(mut out, kind, payload.len)
    io.append(mut out, payload)
}

fn put_h3_settings(mut out: []u8) {
    var payload: []u8 = []
    wire.put_varint(mut payload, h3_setting_qpack_capacity)
    wire.put_varint(mut payload, h3_qpack_capacity)
    wire.put_varint(mut payload, h3_setting_qpack_blocked)
    wire.put_varint(mut payload, h3_qpack_blocked)
    wire.put_varint(mut payload, h3_setting_max_field_section)
    wire.put_varint(mut payload, h3_max_field_section)
    put_h3_frame(mut out, h3_frame_settings, payload)
}

fn put_h3_control_start(mut out: []u8) {
    wire.put_varint(mut out, h3_stream_control)
    put_h3_settings(mut out)
}

fn parse_h3_settings(payload: []u8) -> []H3Setting ! io.Error {
    let c = wire.cursor(payload)
    var out: []H3Setting = []
    var seen: [i64: bool] = [:]
    for wire.left(c) > 0 {
        let id = wire.varint(c)?
        let value = wire.varint(c)?
        if out.len >= h3_max_settings {
            fail TooLarge
        }
        if h3_reserved_setting(id) || (seen[id] ?? false) {
            fail Invalid
        }
        seen[id] = true
        push(mut out, H3Setting { id, value })
    }
    out
}

fn parse_h3_varint_payload(payload: []u8) -> i64 ! io.Error {
    let c = wire.cursor(payload)
    let v = wire.varint(c)?
    if wire.left(c) != 0 {
        fail Malformed
    }
    v
}

fn lowercase_fields(fields: []header.Header) -> bool {
    for h in fields {
        if h.name != text.lower(h.name) {
            return false
        }
    }
    true
}

fn pseudo_name(name: str) -> bool {
    name.len > 0 && name[0] == ':'
}

fn textual_fields(fields: []header.Header) -> bool {
    for h in fields {
        let name = if pseudo_name(h.name) { h.name[1..] } else { h.name }
        if !header.token(name) || !header.valid_value(h.value) {
            return false
        }
    }
    true
}

fn connection_free(fields: []header.Header) -> bool {
    for h in fields {
        if connection_specific(h.name) {
            return false
        }
    }
    true
}

fn valid_h3_request(fields: []header.Header) -> bool {
    lowercase_fields(fields) && textual_fields(fields) && valid_request(fields)
}

fn valid_h3_trailers(fields: []header.Header) -> bool {
    lowercase_fields(fields) && textual_fields(fields) && !has_pseudo(fields) && connection_free(fields)
}

fn valid_h3_response(fields: []header.Header) -> bool {
    var statuses = 0
    var regular = false
    for h in fields {
        if pseudo_name(h.name) {
            if regular || h.name != ":status" || statuses > 0 {
                return false
            }
            statuses += 1
        } else {
            regular = true
        }
    }
    statuses == 1 && lowercase_fields(fields) && textual_fields(fields) && connection_free(fields)
}

fn h3_length_matches(fields: []header.Header, received: i64) -> bool {
    for declared in header.values(fields, "content-length") {
        if declared != "{received}" {
            return false
        }
    }
    true
}
