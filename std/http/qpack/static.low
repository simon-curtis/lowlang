import std/header

/// Returns the QPACK static table of RFC 9204 appendix A: 99 field lines indexed from 0.
///
/// Field lines whose value the RFC leaves empty have an empty `value`. The slice is built on each call.
pub fn static_table() -> []header.Header {
    [
        header.Header { name: ":authority", value: "" },
        header.Header { name: ":path", value: "/" },
        header.Header { name: "age", value: "0" },
        header.Header { name: "content-disposition", value: "" },
        header.Header { name: "content-length", value: "0" },
        header.Header { name: "cookie", value: "" },
        header.Header { name: "date", value: "" },
        header.Header { name: "etag", value: "" },
        header.Header { name: "if-modified-since", value: "" },
        header.Header { name: "if-none-match", value: "" },
        header.Header { name: "last-modified", value: "" },
        header.Header { name: "link", value: "" },
        header.Header { name: "location", value: "" },
        header.Header { name: "referer", value: "" },
        header.Header { name: "set-cookie", value: "" },
        header.Header { name: ":method", value: "CONNECT" },
        header.Header { name: ":method", value: "DELETE" },
        header.Header { name: ":method", value: "GET" },
        header.Header { name: ":method", value: "HEAD" },
        header.Header { name: ":method", value: "OPTIONS" },
        header.Header { name: ":method", value: "POST" },
        header.Header { name: ":method", value: "PUT" },
        header.Header { name: ":scheme", value: "http" },
        header.Header { name: ":scheme", value: "https" },
        header.Header { name: ":status", value: "103" },
        header.Header { name: ":status", value: "200" },
        header.Header { name: ":status", value: "304" },
        header.Header { name: ":status", value: "404" },
        header.Header { name: ":status", value: "503" },
        header.Header { name: "accept", value: "*/*" },
        header.Header { name: "accept", value: "application/dns-message" },
        header.Header { name: "accept-encoding", value: "gzip, deflate, br" },
        header.Header { name: "accept-ranges", value: "bytes" },
        header.Header { name: "access-control-allow-headers", value: "cache-control" },
        header.Header { name: "access-control-allow-headers", value: "content-type" },
        header.Header { name: "access-control-allow-origin", value: "*" },
        header.Header { name: "cache-control", value: "max-age=0" },
        header.Header { name: "cache-control", value: "max-age=2592000" },
        header.Header { name: "cache-control", value: "max-age=604800" },
        header.Header { name: "cache-control", value: "no-cache" },
        header.Header { name: "cache-control", value: "no-store" },
        header.Header { name: "cache-control", value: "public, max-age=31536000" },
        header.Header { name: "content-encoding", value: "br" },
        header.Header { name: "content-encoding", value: "gzip" },
        header.Header { name: "content-type", value: "application/dns-message" },
        header.Header { name: "content-type", value: "application/javascript" },
        header.Header { name: "content-type", value: "application/json" },
        header.Header { name: "content-type", value: "application/x-www-form-urlencoded" },
        header.Header { name: "content-type", value: "image/gif" },
        header.Header { name: "content-type", value: "image/jpeg" },
        header.Header { name: "content-type", value: "image/png" },
        header.Header { name: "content-type", value: "text/css" },
        header.Header { name: "content-type", value: "text/html; charset=utf-8" },
        header.Header { name: "content-type", value: "text/plain" },
        header.Header { name: "content-type", value: "text/plain;charset=utf-8" },
        header.Header { name: "range", value: "bytes=0-" },
        header.Header { name: "strict-transport-security", value: "max-age=31536000" },
        header.Header { name: "strict-transport-security", value: "max-age=31536000; includesubdomains" },
        header.Header { name: "strict-transport-security", value: "max-age=31536000; includesubdomains; preload" },
        header.Header { name: "vary", value: "accept-encoding" },
        header.Header { name: "vary", value: "origin" },
        header.Header { name: "x-content-type-options", value: "nosniff" },
        header.Header { name: "x-xss-protection", value: "1; mode=block" },
        header.Header { name: ":status", value: "100" },
        header.Header { name: ":status", value: "204" },
        header.Header { name: ":status", value: "206" },
        header.Header { name: ":status", value: "302" },
        header.Header { name: ":status", value: "400" },
        header.Header { name: ":status", value: "403" },
        header.Header { name: ":status", value: "421" },
        header.Header { name: ":status", value: "425" },
        header.Header { name: ":status", value: "500" },
        header.Header { name: "accept-language", value: "" },
        header.Header { name: "access-control-allow-credentials", value: "FALSE" },
        header.Header { name: "access-control-allow-credentials", value: "TRUE" },
        header.Header { name: "access-control-allow-headers", value: "*" },
        header.Header { name: "access-control-allow-methods", value: "get" },
        header.Header { name: "access-control-allow-methods", value: "get, post, options" },
        header.Header { name: "access-control-allow-methods", value: "options" },
        header.Header { name: "access-control-expose-headers", value: "content-length" },
        header.Header { name: "access-control-request-headers", value: "content-type" },
        header.Header { name: "access-control-request-method", value: "get" },
        header.Header { name: "access-control-request-method", value: "post" },
        header.Header { name: "alt-svc", value: "clear" },
        header.Header { name: "authorization", value: "" },
        header.Header { name: "content-security-policy", value: "script-src 'none'; object-src 'none'; base-uri 'none'" },
        header.Header { name: "early-data", value: "1" },
        header.Header { name: "expect-ct", value: "" },
        header.Header { name: "forwarded", value: "" },
        header.Header { name: "if-range", value: "" },
        header.Header { name: "origin", value: "" },
        header.Header { name: "purpose", value: "prefetch" },
        header.Header { name: "server", value: "" },
        header.Header { name: "timing-allow-origin", value: "*" },
        header.Header { name: "upgrade-insecure-requests", value: "1" },
        header.Header { name: "user-agent", value: "" },
        header.Header { name: "x-forwarded-for", value: "" },
        header.Header { name: "x-frame-options", value: "deny" },
        header.Header { name: "x-frame-options", value: "sameorigin" },
    ]
}
