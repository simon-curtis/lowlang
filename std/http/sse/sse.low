import std/text

/// A server-sent event.
///
/// `format` writes it to the wire and `parse` and `feed` read it back.
pub struct Event {
    /// The event identifier a client echoes in `last-event-id` when it reconnects. `none` writes no `id` field. Line breaks and zero bytes are removed when written. A parsed event carries the latest identifier the stream set.
    pub id: str? = none
    /// The event name. `none`, or a name that is empty once line breaks are removed, leaves the event unnamed.
    pub event: str? = none
    /// The event payload. When written, each line becomes a `data` field, and lines may end in `\n`, `\r` or `\r\n`. A parsed event joins its `data` lines with `\n`.
    pub data: str = ""
    /// The reconnection delay in milliseconds. Not written when `none` or negative.
    pub retry: i64? = none
}

fn without_breaks(s: str, drop_nul: bool) -> str {
    var out: []u8 = []
    for i in 0..s.len {
        let c = s[i]
        if c == '\r' || c == '\n' || drop_nul && c == 0 {
            continue
        }
        push(mut out, c)
    }
    str(out)
}

fn split_lines(s: str) -> []str {
    var out: []str = []
    var start = 0
    var i = 0
    for i < s.len {
        let c = s[i]
        if c == '\n' || c == '\r' {
            push(mut out, s[start..i])
            if c == '\r' && i + 1 < s.len && s[i + 1] == '\n' {
                i += 1
            }
            start = i + 1
        }
        i += 1
    }
    push(mut out, s[start..])
    out
}

fn field(mut out: []u8, name: str, value: str) {
    if value.len == 0 {
        text.append(mut out, "{name}:\n")
    } else {
        text.append(mut out, "{name}: {value}\n")
    }
}

/// Returns the wire text of `e`: its `id`, `event`, `retry` and `data` fields in that order, each ending in a newline, followed by a blank line.
///
/// An event with empty data and no name has no fields and is only the blank line, which clients ignore. An empty-data event with a name writes an empty `data` field so that it is dispatched.
pub fn format(e: Event) -> str {
    var out: []u8 = []
    match e.id {
        some(id) => field(mut out, "id", without_breaks(id, true))
        none => {}
    }
    var named = false
    match e.event {
        some(name) => {
            let cleaned = without_breaks(name, false)
            named = cleaned.len > 0
            if named {
                field(mut out, "event", cleaned)
            }
        }
        none => {}
    }
    match e.retry {
        some(ms) => {
            if ms >= 0 {
                text.append(mut out, "retry: {ms}\n")
            }
        }
        none => {}
    }
    if e.data.len > 0 {
        for line in split_lines(e.data) {
            field(mut out, "data", line)
        }
    } else if named {
        text.append(mut out, "data:\n")
    }
    text.append(mut out, "\n")
    str(out)
}

/// Returns `note` as an event stream comment: one line beginning with `:` for each line of `note`, followed by a blank line.
///
/// Clients ignore comments.
pub fn comment(note: str) -> str {
    var out: []u8 = []
    for line in split_lines(note) {
        if line.len == 0 {
            text.append(mut out, ":\n")
        } else {
            text.append(mut out, ": {line}\n")
        }
    }
    text.append(mut out, "\n")
    str(out)
}

/// Returns the comment that keeps an idle stream open.
pub fn keepalive() -> str {
    comment("keepalive")
}
