import std/header
import std/http
import std/io
import std/net

fn handle(req: http.Request) -> http.Response {
    if req.path == "/login" {
        return http.Response {
            status: 303
            headers: [
                header.Header { name: "set-cookie", value: "session=abc123; Path=/; HttpOnly" }
                header.Header { name: "location", value: "/profile" }
            ]
            body: []
        }
    }
    if req.path == "/profile" {
        let cookie = header.get(req.headers, "cookie") ?? ""
        if cookie == "session=abc123" {
            return http.response(200, "signed in as ada")
        }
        return http.response(401, "sign in first")
    }
    http.response(404, "")
}

/// Signs in through a redirect and shows the cookie jar carrying the session to the next request.
fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let listening = l.handle
    spawn fn() { http.serve_on(listening, handle) or {} }()
    let origin = "http://127.0.0.1:{l.handle.addr.port}"

    let anonymous = http.client().build()
    let denied = anonymous.get("{origin}/profile") or return
    print("anonymous: {denied.status} {http.text(denied)}")

    let browser = http.client().with_cookies().with_redirects(3).build()
    let resp = browser.get("{origin}/login") or return
    print("after login: {resp.status} {http.text(resp)}")
    print("ended at {resp.url[origin.len..]}")
    print("jar sends: {http.cookies_for(browser, "{origin}/anything")}")

    let again = browser.get("{origin}/profile") or return
    print("later: {again.status} {http.text(again)}")
    net.close_listener(l)
}
