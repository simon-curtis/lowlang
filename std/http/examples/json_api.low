import std/header
import std/http
import std/io
import std/json
import std/net

struct Note {
    title: str
    done: bool
}

struct Store {
    notes: []Note
}

fn json_response(status: i64, body: str) -> http.Response {
    http.Response { status, headers: [header.Header { name: "content-type", value: "application/json" }], body: bytes(body) }
}

fn handle(store: *Store, req: http.Request) -> http.Response {
    if req.path == "/notes" && req.method == "POST" {
        let note = json.deserialize[Note](req.body) or return http.response(400, "bad note")
        push(mut store.notes, note)
        return json_response(201, json.serialize(note))
    }
    if req.path == "/notes" && req.method == "GET" {
        return json_response(200, json.serialize(store.notes))
    }
    http.response(404, "no route {req.method} {req.path}")
}

/// Serves a notes API on a loopback port and drives it with the HTTP client.
fn main() ! io.Error {
    let store = new(Store { notes: [] })
    using l = net.listen("127.0.0.1", 0)?
    let handler = fn(req: http.Request) -> http.Response { handle(store, req) }
    let listening = l.handle
    spawn fn() { http.serve_on(listening, handler) or {} }()

    let client = http.client().with_base_url("http://127.0.0.1:{l.handle.addr.port}").with_timeout(5000).build()
    for title in ["write docs", "ship"] {
        let created = client.request("POST", "/notes").with_json(Note { title, done: false }).send() or return
        print("{created.status} {http.text(created)}")
    }
    let listed = client.get("/notes") or return
    let notes = http.json[[]Note](listed) or return
    print("{listed.status} {http.header_value(listed, "content-type") ?? "-"} {notes.len} notes")
    for n in notes {
        print("- {n.title}")
    }
    let missing = client.get("/nothing") or return
    print("{missing.status} {http.text(missing)}")
    net.close_listener(l)
}
