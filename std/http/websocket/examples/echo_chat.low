import std/http
import std/http/websocket
import std/io
import std/net
import std/text

fn handle(req: http.Request) -> http.Response {
    using ws = websocket.accept(req) or return http.response(400, "expected a websocket handshake")
    for {
        let m = websocket.receive(ws) or break
        if m.text {
            websocket.send_text(ws, "echo: {text.upper(str(m.data))}") or break
        } else {
            websocket.send_binary(ws, m.data) or break
        }
    }
    http.upgraded()
}

/// Upgrades a loopback connection to a WebSocket and exchanges text and binary messages with an echo handler.
fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let listening = l.handle
    spawn fn() { http.serve_on(listening, handle) or {} }()

    using ws = websocket.dial("ws://127.0.0.1:{l.handle.addr.port}/chat")?
    for word in ["hello", "low"] {
        websocket.send_text(ws, word)?
        let reply = websocket.receive(ws)?
        print(str(reply.data))
    }
    websocket.ping(ws, bytes("alive"))?
    websocket.send_binary(ws, [1, 2, 3])?
    let blob = websocket.receive(ws)?
    print("binary {blob.data.len} bytes, first {blob.data[0]}, text {blob.text}")
    websocket.close(ws, 1000)?
    net.close_listener(l)
}
