import std/base64
import std/crypto
import std/crypto/hash
import std/header
import std/http
import std/io
import std/text
import std/unicode

/// The state of one WebSocket connection: the reader over the connection, which side it is, and whether it has been closed.
///
/// A `*SocketHandle` can be shared between tasks and passed to the `_on` functions, which exist so a connection can be used without an owning `Socket`.
pub struct SocketHandle {
    reader: *io.Reader
    client: bool
    closed: bool
}

/// An open WebSocket connection that closes itself.
///
/// Dropping a `Socket` sends a close frame with code `1000` and waits for the peer's close, unless it was detached. Use `detach` to keep the connection open past the end of the scope.
pub struct Socket {
    /// The shared connection state, for use with the `_on` functions.
    pub handle: *SocketHandle
    detached: bool = false
    drop {
        if !detached {
            close_on(handle, 1000) or {}
        }
    }
}

/// Returns a `Socket` that owns `h` and closes it on drop.
pub fn adopt(h: *SocketHandle) -> Socket {
    Socket { handle: h }
}

/// Stops `s` closing its connection on drop and returns its handle.
///
/// The caller becomes responsible for calling `close_on`.
pub fn detach(mut s: Socket) -> *SocketHandle {
    s.detached = true
    s.handle
}

/// A complete message received from the peer.
pub struct Message {
    /// `true` for a text message, whose `data` is valid UTF-8, and `false` for a binary one.
    pub text: bool
    /// The message payload with fragments joined.
    pub data: []u8
}

struct Frame {
    fin: bool
    op: i64
    payload: []u8
}

const guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
const max_message = 1 << 24

fn accept_key(key: str) -> str {
    base64.encode(hash.sum(hash.sha1(), bytes("{key}{guid}")))
}

fn stream(ws: *SocketHandle) -> io.Stream {
    io.reader_stream(ws.reader)
}

/// Completes the server side of the WebSocket handshake for `req` and returns the open connection.
///
/// `req` must be a `GET` that has `upgrade: websocket`, a `connection` header with the `upgrade` token, `sec-websocket-version: 13` and a `sec-websocket-key` that decodes to 16 bytes. `http.upgrade` writes the `101 Switching Protocols` response to the connection. The `origin` header, subprotocols and extensions are not examined.
///
/// Fails with `Unsupported` when `req` has no connection to take over, as on HTTP/2 and HTTP/3, and with `Malformed` when a handshake requirement is not met. Write failures are returned as they occur. After using the socket, return `upgraded()` from the handler.
///
/// ```low
/// import std/http
/// import ws = std/http/websocket
///
/// fn echo(req: http.Request) -> http.Response {
///     using s = ws.accept(req) or return http.response(400, "bad handshake")
///     for {
///         let m = ws.receive(s) or break
///         ws.send_text(s, str(m.data)) or break
///     }
///     http.upgraded()
/// }
/// ```
pub fn accept(req: http.Request) -> Socket ! io.Error {
    if req.version == http.Version.Http2 || req.version == http.Version.Http3 {
        fail Unsupported
    }
    let upgrade = header.get(req.headers, "upgrade") ?? ""
    let connection = header.get(req.headers, "connection") ?? ""
    let version = header.get(req.headers, "sec-websocket-version") ?? ""
    let key = header.get(req.headers, "sec-websocket-key") ?? ""
    let nonce = base64.decode(key) or fail Malformed
    if req.method != "GET" || !text.has_token(upgrade, "websocket") || !text.has_token(connection, "upgrade") {
        fail Malformed
    }
    if version != "13" || nonce.len != 16 {
        fail Malformed
    }
    let r = http.upgrade(req, [
        header.Header { name: "upgrade", value: "websocket" }
        header.Header { name: "connection", value: "Upgrade" }
        header.Header { name: "sec-websocket-accept", value: accept_key(key) }
    ])?
    Socket { handle: new(SocketHandle { reader: r, client: false, closed: false }) }
}

/// Connects to a `ws` or `wss` URL, performs the client handshake and returns the open connection.
///
/// Messages the client sends are masked as the protocol requires. Fails with `Unsupported` for any other scheme, with the error from `parse_url` for a bad URL, with the connection or TLS error when connecting fails, and with `Refused` when the handshake cannot be completed or the server does not answer `101` with the expected `sec-websocket-accept`.
pub fn dial(url: str) -> Socket ! io.Error {
    let u = http.parse_url(url)?
    if u.scheme != "ws" && u.scheme != "wss" {
        fail Unsupported
    }
    using var c = http.connect(u, ["http/1.1"])?
    let s = c.stream
    let key = base64.encode(crypto.random(16))
    var req = http.new_request("GET", u.target)
    req.authority = http.authority(u)
    req.headers = [
        header.Header { name: "upgrade", value: "websocket" }
        header.Header { name: "connection", value: "Upgrade" }
        header.Header { name: "sec-websocket-key", value: key }
        header.Header { name: "sec-websocket-version", value: "13" }
    ]
    let r = io.reader(s)
    let resp = handshake(r, req) or fail Refused
    let accepted = header.get(resp.headers, "sec-websocket-accept") ?? ""
    if resp.status != 101 || accepted != accept_key(key) {
        fail Refused
    }
    http.detach(mut c)
    Socket { handle: new(SocketHandle { reader: r, client: true, closed: false }) }
}

fn handshake(r: *io.Reader, req: http.Request) -> http.Response ! io.Error {
    http.write_request(io.reader_stream(r), req)?
    http.read_response(r, "GET")
}

fn read_frame(ws: *SocketHandle) -> Frame ! io.Error {
    let b0 = i64(io.read_byte(ws.reader)?)
    let b1 = i64(io.read_byte(ws.reader)?)
    let masked = b1 & 0x80 != 0
    let op = b0 & 0xF
    if b0 & 0x70 != 0 || masked == ws.client || (op > 2 && op < 8) || op > 10 {
        fail Malformed
    }
    var size = b1 & 0x7F
    if size == 126 {
        size = io.be16(io.read_exact(ws.reader, 2)?, 0)
    } else if size == 127 {
        size = io.be64(io.read_exact(ws.reader, 8)?, 0)
    }
    let fin = b0 & 0x80 != 0
    if op >= 8 && (size > 125 || !fin) {
        fail Malformed
    }
    if size < 0 || size > max_message {
        fail TooLarge
    }
    var key: []u8 = []
    if masked {
        key = io.read_exact(ws.reader, 4)?
    }
    let payload = io.read_exact(ws.reader, size)?
    if masked {
        for i in 0..size {
            payload[i] = payload[i] ^ key[i % 4]
        }
    }
    Frame { fin, op, payload }
}

fn write_frame(ws: *SocketHandle, op: i64, payload: []u8) ! io.Error {
    var out: []u8 = []
    push(mut out, u8(0x80 | op))
    let mask: u8 = if ws.client { 0x80 } else { 0 }
    if payload.len < 126 {
        push(mut out, mask | u8(payload.len))
    } else if payload.len < 65536 {
        push(mut out, mask | 126)
        io.put_be16(mut out, payload.len)
    } else {
        push(mut out, mask | 127)
        io.put_be64(mut out, payload.len)
    }
    if !ws.client {
        io.append(mut out, payload)
        return io.write_all(stream(ws), out)
    }
    let key = crypto.random(4)
    io.append(mut out, key)
    for i, b in payload {
        push(mut out, b ^ key[i % 4])
    }
    io.write_all(stream(ws), out)?
}

fn valid_text(data: []u8) -> bool {
    let view = __str_view(data)
    unicode.utf8_valid(view)
}

fn violation(ws: *SocketHandle, code: i64) -> io.Error {
    var payload: []u8 = []
    io.put_be16(mut payload, code)
    write_frame(ws, 8, payload) or {}
    ws.closed = true
    Malformed
}

/// Blocks until a complete message arrives and returns it.
///
/// Fragments are joined into one `Message` of at most 16 MiB. Ping frames are answered with a pong and pong frames are skipped, so neither is returned. When the peer sends a close frame the close is echoed and the call fails with `Eof`.
///
/// A protocol violation, such as a bad frame, a text message that is not UTF-8 or a message over the size limit, sends a close frame with code `1002`, `1007` or `1009` and fails with `Malformed`. A connection that ends fails with `Eof`, and any other read failure with `Reset`. Fails with `NotConnected` once the socket is closed.
pub fn receive(ws: Socket) -> Message ! io.Error {
    receive_on(ws.handle)
}

/// Receives a message from `ws` as `receive` does.
pub fn receive_on(ws: *SocketHandle) -> Message ! io.Error {
    if ws.closed {
        fail NotConnected
    }
    next_message(ws)
}

fn next_message(ws: *SocketHandle) -> Message ! io.Error {
    var data: []u8 = []
    var kind = -1
    for {
        let f = read_frame(ws) catch {
            Malformed => fail violation(ws, 1002)
            TooLarge => fail violation(ws, 1009)
            Eof => fail Eof
            _ => fail Reset
        }
        if f.op == 9 {
            write_frame(ws, 10, f.payload)?
            continue
        }
        if f.op == 10 {
            continue
        }
        if f.op == 8 {
            if f.payload.len == 1 || f.payload.len > 1 && !valid_text(f.payload[2..]) {
                fail violation(ws, 1002)
            }
            if !ws.closed {
                ws.closed = true
                write_frame(ws, 8, if f.payload.len >= 2 { f.payload[..2] } else { [] })?
            }
            fail Eof
        }
        if f.op == 0 && kind < 0 || f.op != 0 && kind >= 0 {
            fail violation(ws, 1002)
        }
        if f.op != 0 {
            kind = f.op
        }
        if data.len + f.payload.len > max_message {
            fail violation(ws, 1009)
        }
        io.append(mut data, f.payload)
        if f.fin {
            if kind == 1 && !valid_text(data) {
                fail violation(ws, 1007)
            }
            return Message { text: kind == 1, data }
        }
    }
}

/// Sends `message` as one text frame.
///
/// Fails with `NotConnected` once the socket is closed, or with the write error.
pub fn send_text(ws: Socket, message: str) ! io.Error {
    send_text_on(ws.handle, message)
}

/// Sends a text frame on `ws` as `send_text` does.
pub fn send_text_on(ws: *SocketHandle, message: str) ! io.Error {
    send_frame(ws, 1, bytes(message))
}

/// Sends `data` as one binary frame.
///
/// Fails with `NotConnected` once the socket is closed, or with the write error.
pub fn send_binary(ws: Socket, data: []u8) ! io.Error {
    send_binary_on(ws.handle, data)
}

/// Sends a binary frame on `ws` as `send_binary` does.
pub fn send_binary_on(ws: *SocketHandle, data: []u8) ! io.Error {
    send_frame(ws, 2, data)
}

/// Sends a ping frame carrying `data`, which the protocol limits to 125 bytes.
///
/// The peer's pong is skipped by `receive`. Fails with `NotConnected` once the socket is closed, or with the write error.
pub fn ping(ws: Socket, data: []u8) ! io.Error {
    ping_on(ws.handle, data)
}

/// Sends a ping frame on `ws` as `ping` does.
pub fn ping_on(ws: *SocketHandle, data: []u8) ! io.Error {
    send_frame(ws, 9, data)
}

fn send_frame(ws: *SocketHandle, op: i64, payload: []u8) ! io.Error {
    if ws.closed {
        fail NotConnected
    }
    write_frame(ws, op, payload)?
}

/// Closes the connection with the status `code`.
///
/// Sends a close frame with `code` unless one has been exchanged already, then reads and discards messages until the peer's close frame or an error, and releases the connection; a client side closes its stream. Blocks until then. Normal closure is `1000`. Fails with the write error when the close frame cannot be sent, and the connection is still released.
pub fn close(ws: Socket, code: i64) ! io.Error {
    close_on(ws.handle, code)
}

/// Closes `ws` with `code` as `close` does.
pub fn close_on(ws: *SocketHandle, code: i64) ! io.Error {
    farewell(ws, code) catch {
        e => {
            release(ws)
            fail e
        }
    }
    release(ws)
}

fn farewell(ws: *SocketHandle, code: i64) ! io.Error {
    if ws.closed {
        return
    }
    ws.closed = true
    var payload: []u8 = []
    io.put_be16(mut payload, code)
    write_frame(ws, 8, payload)?
    for {
        next_message(ws) or break
    }
}

fn release(ws: *SocketHandle) {
    if ws.client {
        stream(ws).close()
    }
}
