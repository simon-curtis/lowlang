import std/header
import std/net
import std/sync
import std/text
import std/time/clock
import std/time/date
import std/time/timestamp

/// The `SameSite` attribute of a cookie.
///
/// The jar records the value and returns it from `jar_cookies`; it does not use it to withhold cookies from requests.
pub enum SameSite {
    /// The cookie has no `SameSite` attribute, or its value is not `Strict`, `Lax` or `None`.
    Unset
    /// `SameSite=None`.
    NoRestriction
    /// `SameSite=Lax`.
    Lax
    /// `SameSite=Strict`.
    Strict
}

/// A cookie: the form a `CookieJar` stores, `request_cookies` returns and `set_cookie` and `format_set_cookie` write.
///
/// A response cookie needs only `name` and `value`; the other fields default to a session cookie for `/` that is `HttpOnly`, `Secure` and `SameSite=Lax`.
pub struct Cookie {
    /// The cookie name, trimmed of surrounding whitespace and never empty.
    pub name: str
    /// The cookie value, trimmed of surrounding whitespace and otherwise as sent. It is written as given, with no escaping.
    pub value: str
    /// The host the cookie belongs to: the host of the request that set it, or the lowercased `Domain` attribute without its leading dot. Empty on a cookie written without a `Domain` attribute, which `format_set_cookie` then omits.
    pub domain: str = ""
    /// `true` when the cookie had no `Domain` attribute and is sent only to exactly `domain`; `false` when it is also sent to subdomains of `domain`, except when the request host is an IP address. `format_set_cookie` writes `Domain` only when this is `false` and `domain` is not empty.
    pub host_only: bool = true
    /// The `Path` attribute when it starts with `/`; otherwise the default path, which is the request target up to its last `/`, or `/`.
    pub path: str = "/"
    /// The expiry time in milliseconds since the Unix epoch.
    ///
    /// A cookie with neither `Max-Age` nor `Expires` is a session cookie and holds `0x7FFFFFFFFFFFFFFF`, so it never expires on its own. `Max-Age` takes precedence over `Expires`.
    pub expires: i64 = 0x7FFFFFFFFFFFFFFF
    /// The `Max-Age` attribute in seconds as parsed from or written to a `Set-Cookie` header. A negative value, the default, means the attribute is absent and makes a session cookie; `0` deletes the cookie.
    pub max_age: i64 = -1
    /// `true` when the cookie has the `Secure` attribute and is sent only to `https` and `wss` URLs.
    pub secure: bool = true
    /// `true` when the cookie has the `HttpOnly` attribute. The jar records it and does not otherwise act on it.
    pub http_only: bool = true
    /// The `SameSite` attribute of the cookie. `Unset` omits it when written.
    pub same_site: SameSite = Lax
    /// A logical timestamp from the jar's internal counter, set when the cookie is first stored and kept when a later `Set-Cookie` replaces the cookie. It orders cookies of equal path length in a `Cookie` header and is not a time of day.
    pub created: i64 = 0
    /// A logical timestamp from the jar's internal counter, updated whenever the cookie is stored or included in a header. The jar evicts the lowest value first when it is full.
    pub accessed: i64 = 0
}

struct JarState {
    lock: sync.Mutex
    cookies: []Cookie
    tick: i64
    clock: clock.Clock
}

fn jar_now(s: *JarState) -> i64 {
    timestamp.unix_millis(clock.now(s.clock))
}

/// An in-memory store of cookies that follows the `Set-Cookie` and `Cookie` rules of RFC 6265.
///
/// Copies of a `CookieJar` share one store, and the store is safe to use from several tasks. The jar holds at most 4096 bytes of name and value per cookie, 1024 bytes per attribute value, 50 cookies per domain and 3000 cookies in total; storing past a limit evicts the least recently accessed cookie. Expired cookies are discarded on the next read or write.
///
/// A client uses a jar through `with_cookie_jar`, or a private one through `with_cookies`.
pub struct CookieJar {
    state: *JarState
}

/// Returns a new, empty `CookieJar` that reads the time from the operating system.
pub fn cookie_jar() -> CookieJar {
    cookie_jar_on(clock.system())
}

/// Returns a new, empty `CookieJar` that reads the time of `c`, which decides when its cookies expire.
pub fn cookie_jar_on(c: clock.Clock) -> CookieJar {
    CookieJar { state: new(JarState { lock: sync.mutex(), cookies: [], tick: 0, clock: c }) }
}

const session_expiry = 0x7FFFFFFFFFFFFFFF
const max_cookie_bytes = 4096
const max_attribute_bytes = 1024
const max_cookies_per_domain = 50
const max_cookies = 3000

fn cookie_delimiter(c: u8) -> bool {
    c == 0x09 || c >= 0x20 && c <= 0x2F || c >= 0x3B && c <= 0x40 || c >= 0x5B && c <= 0x60 || c >= 0x7B && c <= 0x7E
}

fn date_tokens(s: str) -> []str {
    var tokens: []str = []
    var start = -1
    for i in 0..s.len {
        if cookie_delimiter(s[i]) {
            if start >= 0 {
                push(mut tokens, s[start..i])
                start = -1
            }
        } else if start < 0 {
            start = i
        }
    }
    if start >= 0 {
        push(mut tokens, s[start..])
    }
    tokens
}

fn leading_digits(s: str, low: i64, high: i64) -> i64 {
    var n = 0
    var count = 0
    for count < s.len && s[count] >= '0' && s[count] <= '9' {
        n = n * 10 + i64(s[count] - '0')
        count += 1
    }
    if count < low || count > high {
        return -1
    }
    n
}

fn time_of_day(token: str) -> i64 {
    let parts = text.split(token, ':')
    if parts.len != 3 {
        return -1
    }
    let h = leading_digits(parts[0], 1, 2)
    let m = leading_digits(parts[1], 1, 2)
    let s = leading_digits(parts[2], 1, 2)
    if h < 0 || m < 0 || s < 0 || parts[0].len > 2 || parts[1].len > 2 {
        return -1
    }
    if h > 23 || m > 59 || s > 59 {
        return -2
    }
    h * 3600 + m * 60 + s
}

fn month_of(token: str) -> i64 {
    if token.len < 3 {
        return -1
    }
    let names = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
    for i, name in names {
        if text.equal_fold(token[..3], name) {
            return i + 1
        }
    }
    -1
}

fn parse_cookie_date(s: str) -> i64? {
    var seconds = -1
    var day = -1
    var month = -1
    var year = -1
    for token in date_tokens(s) {
        if seconds == -1 {
            let t = time_of_day(token)
            if t == -2 {
                return none
            }
            if t >= 0 {
                seconds = t
                continue
            }
        }
        if day < 0 {
            let d = leading_digits(token, 1, 2)
            if d >= 0 && token.len <= 2 {
                day = d
                continue
            }
        }
        if month < 0 {
            let m = month_of(token)
            if m > 0 {
                month = m
                continue
            }
        }
        if year < 0 {
            let y = leading_digits(token, 2, 4)
            if y >= 0 {
                year = y
            }
        }
    }
    if year >= 70 && year <= 99 {
        year += 1900
    } else if year >= 0 && year <= 69 {
        year += 2000
    }
    if seconds < 0 || day < 1 || day > 31 || month < 0 || year < 1601 {
        return none
    }
    let first = date.of(year, month, 1) or return none
    (date.epoch_days(first) + day - 1) * 86400 + seconds
}

fn default_path(target: str) -> str {
    let path = path_of(target)
    if path.len == 0 || path[0] != '/' {
        return "/"
    }
    let slash = text.last_index_byte(path, '/')
    if slash == 0 { "/" } else { path[..slash] }
}

fn domain_match(host: str, domain: str) -> bool {
    if host == domain {
        return true
    }
    if !text.ends_with(host, domain) || host.len <= domain.len || host[host.len - domain.len - 1] != '.' {
        return false
    }
    !ip_literal(host)
}

fn ip_literal(host: str) -> bool {
    let parsed = net.parse_ip(host) or return false
    parsed.len > 0
}

fn path_match(path: str, cookie_path: str) -> bool {
    if path == cookie_path {
        return true
    }
    if !text.starts_with(path, cookie_path) {
        return false
    }
    cookie_path[cookie_path.len - 1] == '/' || path[cookie_path.len] == '/'
}

fn same_site_of(value: str) -> SameSite {
    match value {
        "strict" => Strict
        "lax" => Lax
        "none" => NoRestriction
        _ => Unset
    }
}

fn max_age_expiry(value: str, now: i64) -> i64? {
    let negative = value.len > 0 && value[0] == '-'
    let digits = if negative { value[1..] } else { value }
    if digits.len == 0 || digits.len > 12 {
        return none
    }
    let n = text.parse_uint(digits, 10) or -1
    if n < 0 {
        return none
    }
    if negative || n == 0 { 0 } else { now + n * 1000 }
}

fn max_age_seconds(value: str) -> i64 {
    if value[0] == '-' {
        return 0
    }
    text.parse_uint(value, 10) or 0
}

fn prefix_allows(c: Cookie, u: Url) -> bool {
    if text.starts_with_fold(c.name, "__secure-") {
        return c.secure
    }
    if text.starts_with_fold(c.name, "__host-") {
        return c.secure && c.host_only && c.path == "/"
    }
    true
}

fn parse_set_cookie(u: Url, line: str, now: i64) -> Cookie? {
    let parts = text.split(line, ';')
    let pair = parts[0]
    let eq = text.index_byte(pair, '=')
    if eq < 0 {
        return none
    }
    let name = text.trim(pair[..eq])
    let value = text.trim(pair[eq + 1..])
    if name.len == 0 || name.len + value.len > max_cookie_bytes {
        return none
    }
    var c = Cookie {
        name
        value
        domain: u.host
        host_only: true
        path: default_path(u.target)
        expires: session_expiry
        max_age: -1
        secure: false
        http_only: false
        same_site: Unset
        created: 0
        accessed: 0
    }
    var max_age_seen = false
    for attr in parts[1..] {
        let at = text.index_byte(attr, '=')
        let key = text.lower(text.trim(if at >= 0 { attr[..at] } else { attr }))
        let attribute = text.trim(if at >= 0 { attr[at + 1..] } else { "" })
        if attribute.len > max_attribute_bytes {
            continue
        }
        if key == "max-age" {
            match max_age_expiry(attribute, now) {
                some(t) => {
                    max_age_seen = true
                    c.expires = t
                    c.max_age = max_age_seconds(attribute)
                }
                none => {}
            }
        } else if key == "expires" && !max_age_seen {
            match parse_cookie_date(attribute) {
                some(t) => {
                    c.expires = t * 1000
                }
                none => {}
            }
        } else if key == "domain" {
            let d = text.lower(if attribute.len > 0 && attribute[0] == '.' { attribute[1..] } else { attribute })
            if d.len == 0 {
                continue
            }
            if !domain_match(u.host, d) {
                return none
            }
            c.domain = d
            c.host_only = false
        } else if key == "path" {
            c.path = if attribute.len > 0 && attribute[0] == '/' { attribute } else { default_path(u.target) }
        } else if key == "secure" {
            c.secure = true
        } else if key == "httponly" {
            c.http_only = true
        } else if key == "samesite" {
            c.same_site = same_site_of(text.lower(attribute))
        }
    }
    if c.secure && !secure_scheme(u.scheme) || !prefix_allows(c, u) {
        return none
    }
    c
}

fn live_cookies(cookies: []Cookie, now: i64) -> []Cookie {
    var live: []Cookie = []
    for c in cookies {
        if c.expires > now {
            push(mut live, c)
        }
    }
    live
}

fn oldest_index(cookies: []Cookie, domain: str) -> i64 {
    var found = -1
    for i, c in cookies {
        if (domain.len == 0 || c.domain == domain) && (found < 0 || c.accessed < cookies[found].accessed) {
            found = i
        }
    }
    found
}

fn without_index(cookies: []Cookie, skip: i64) -> []Cookie {
    var kept: []Cookie = []
    for i, c in cookies {
        if i != skip {
            push(mut kept, c)
        }
    }
    kept
}

fn count_domain(cookies: []Cookie, domain: str) -> i64 {
    var n = 0
    for c in cookies {
        if c.domain == domain {
            n += 1
        }
    }
    n
}

fn trim_jar(s: *JarState, domain: str) {
    if count_domain(s.cookies, domain) > max_cookies_per_domain {
        s.cookies = without_index(s.cookies, oldest_index(s.cookies, domain))
    }
    if s.cookies.len > max_cookies {
        s.cookies = without_index(s.cookies, oldest_index(s.cookies, ""))
    }
}

fn keep_cookie(s: *JarState, u: Url, c: Cookie, now: i64) -> bool {
    let current = live_cookies(s.cookies, now)
    var fresh = c
    s.tick += 1
    fresh.created = s.tick
    fresh.accessed = s.tick
    var kept: []Cookie = []
    for old in current {
        if old.name == c.name && old.domain == c.domain && old.path == c.path {
            if old.secure && !secure_scheme(u.scheme) {
                s.cookies = current
                return false
            }
            fresh.created = old.created
        } else {
            push(mut kept, old)
        }
    }
    let stored = c.expires > now
    if stored {
        push(mut kept, fresh)
    }
    s.cookies = kept
    trim_jar(s, c.domain)
    stored
}

fn store_cookies(j: CookieJar, u: Url, headers: []header.Header) {
    let now = jar_now(j.state)
    let s = j.state
    sync.lock(s.lock)
    defer sync.unlock(s.lock)
    for h in headers {
        if !text.equal_fold(h.name, "set-cookie") {
            continue
        }
        match parse_set_cookie(u, h.value, now) {
            some(c) => {
                keep_cookie(s, u, c, now)
            }
            none => {}
        }
    }
}

fn cookie_header(j: CookieJar, u: Url) -> str {
    let now = jar_now(j.state)
    let secure = secure_scheme(u.scheme)
    let path = path_of(u.target)
    let s = j.state
    var chosen: []Cookie = []
    sync.lock(s.lock)
    s.cookies = live_cookies(s.cookies, now)
    s.tick += 1
    for i, c in s.cookies {
        let host_ok = if c.host_only { u.host == c.domain } else { domain_match(u.host, c.domain) }
        if host_ok && path_match(path, c.path) && (!c.secure || secure) {
            s.cookies[i].accessed = s.tick
            push(mut chosen, c)
        }
    }
    sync.unlock(s.lock)
    for i in 1..chosen.len {
        var k = i
        for k > 0 && cookie_before(chosen[k], chosen[k - 1]) {
            let t = chosen[k]
            chosen[k] = chosen[k - 1]
            chosen[k - 1] = t
            k -= 1
        }
    }
    var parts: []str = []
    for c in chosen {
        push(mut parts, "{c.name}={c.value}")
    }
    text.join(parts, "; ")
}

fn cookie_before(a: Cookie, b: Cookie) -> bool {
    if a.path.len != b.path.len {
        return a.path.len > b.path.len
    }
    a.created < b.created
}

/// Stores the cookie described by a `Set-Cookie` header value, as received in a response from `url`.
///
/// Returns `true` when the cookie is now in the jar. Returns `false`, leaving the jar unchanged, when `url` does not parse, when the value has no `=` or an empty name, when the name and value exceed 4096 bytes, when `Domain` does not cover the host of `url`, when `Secure` is set for a URL that is not `https` or `wss`, when a `__Secure-` or `__Host-` prefix rule is broken, or when the cookie would replace a `Secure` cookie from a URL that is not secure. A cookie that is already expired (`Max-Age` of `0` or less, or a past `Expires`) deletes the matching cookie and returns `false`.
pub fn jar_set(j: CookieJar, url: str, set_cookie: str) -> bool {
    let u = parse_url(url) or return false
    let now = jar_now(j.state)
    let c = match parse_set_cookie(u, set_cookie, now) {
        some(c) => c
        none => return false
    }
    let s = j.state
    sync.lock(s.lock)
    defer sync.unlock(s.lock)
    keep_cookie(s, u, c, now)
}

/// Returns the value of the `Cookie` header for a request to `url`.
///
/// The value is the matching `name=value` pairs joined by `; `. A cookie matches when its domain and path match the URL and, for a `Secure` cookie, the scheme is `https` or `wss`. Cookies with longer paths come first, then older cookies. Returns an empty string when `url` does not parse or no cookie matches.
pub fn jar_header(j: CookieJar, url: str) -> str {
    let u = parse_url(url) or return ""
    cookie_header(j, u)
}

/// Returns a copy of every unexpired cookie in the jar, in storage order. Changing the returned slice does not change the jar.
pub fn jar_cookies(j: CookieJar) -> []Cookie {
    let s = j.state
    sync.lock(s.lock)
    s.cookies = live_cookies(s.cookies, jar_now(j.state))
    var copy: []Cookie = []
    for c in s.cookies {
        push(mut copy, c)
    }
    sync.unlock(s.lock)
    copy
}

/// Removes every cookie from the jar.
pub fn jar_clear(j: CookieJar) {
    let s = j.state
    sync.lock(s.lock)
    s.cookies = []
    sync.unlock(s.lock)
}

fn same_site_text(s: SameSite) -> str {
    match s {
        Unset => ""
        NoRestriction => "None"
        Lax => "Lax"
        Strict => "Strict"
    }
}

/// Returns the value of a `Set-Cookie` header for `c`.
///
/// The attributes are written in the order `Path`, `Domain`, `Max-Age`, `HttpOnly`, `Secure` and `SameSite`. `Domain` is left out for a host-only cookie, `Max-Age` for a negative `max_age`, and `SameSite` for `Unset`. The name and value are written as given.
pub fn format_set_cookie(c: Cookie) -> str {
    var parts: []str = ["{c.name}={c.value}", "Path={c.path}"]
    if !c.host_only && c.domain.len > 0 {
        push(mut parts, "Domain={c.domain}")
    }
    if c.max_age >= 0 {
        push(mut parts, "Max-Age={c.max_age}")
    }
    if c.http_only {
        push(mut parts, "HttpOnly")
    }
    if c.secure {
        push(mut parts, "Secure")
    }
    if c.same_site != Unset {
        push(mut parts, "SameSite={same_site_text(c.same_site)}")
    }
    text.join(parts, "; ")
}

/// Appends a `set-cookie` header for `c` to `headers`, keeping any earlier cookie of the same name.
pub fn set_cookie(mut headers: []header.Header, c: Cookie) {
    header.add(mut headers, "set-cookie", format_set_cookie(c))
}

/// Returns the cookies sent in the `cookie` headers of a request as a map of names to values.
///
/// Every `cookie` header is read. Values are kept as sent, without decoding, and a repeated name keeps its last value.
pub fn request_cookies(headers: []header.Header) -> [str: str] {
    var out: [str: str] = [:]
    for h in headers {
        if !text.equal_fold(h.name, "cookie") {
            continue
        }
        for part in text.split(h.value, ';') {
            let pair = text.trim(part)
            let eq = text.index_byte(pair, '=')
            if eq > 0 {
                out[pair[..eq]] = pair[eq + 1..]
            }
        }
    }
    out
}
