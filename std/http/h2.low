import std/cancel
import std/header
import std/io
import std/slices
import std/text

struct Exchange {
    id: i64
    fields: header.Header[]
    trailers: bool
    block: u8[]
    ends: bool
    body: u8[]
    held: i64
    due: i64
    fresh: i64
    received: bool
    window: i64
    out: u8[]
    tail: header.Header[]
    queued: bool
    open: bool
    token: *cancel.Token?
    inbox: chan[u8[]]?
    waiting: u8[][]
    duplex: bool
    answered: bool
    parked: chan[bool]?
}

struct Credit {
    id: i64
    n: i64
}

const high_water = 262144
const linger_ms = 1000
const max_continuations = 128
const reset_budget = 200
const reset_refill_ms = 50
const quiet_ms = 3600000

struct Peer {
    stream: io.Stream
    reader: *io.Reader
    decoder: *Hpack
    statics: header.Header[]
    exchanges: [i64: *Exchange]
    dropped: [i64: bool]
    window: i64
    initial: i64
    frame_size: i64
    last: i64
    pending: i64
    continuations: i64
    resets: i64
    reset_at: i64
    pace: *Pace?
    swept: i64
    owing: i64
    behind: i64
    accrued: i64
    settled: bool
    outstanding: i64
    running: [i64: i64]
    late: [i64: bool]
    failure: i64
    code: i64
    duplex: bool
    draining: bool
    credits: chan[Credit]
    complete: fn(*Peer, *Exchange) ! io.Error
}

fn new_peer(s: io.Stream, r: *io.Reader, duplex: bool, pace: *Pace?, complete: fn(*Peer, *Exchange) ! io.Error) -> *Peer {
    new(Peer {
        stream: s
        reader: r
        decoder: new_hpack(4096)
        statics: static_table()
        exchanges: [:]
        dropped: [:]
        window: default_window
        initial: default_window
        frame_size: default_frame_size
        last: 0
        pending: 0
        continuations: 0
        resets: 0
        reset_at: 0
        pace
        swept: 0
        owing: 0
        behind: 0
        accrued: 0
        settled: false
        outstanding: 0
        running: [:]
        late: [:]
        failure: 0
        code: 0
        duplex
        draining: false
        credits: chan[Credit](256)
        complete
    })
}

fn new_exchange(p: *Peer, id: i64) -> *Exchange {
    let e = new(Exchange {
        id
        fields: []
        trailers: false
        block: []
        ends: false
        body: []
        held: 0
        due: 0
        fresh: 0
        received: false
        window: p.initial
        out: []
        tail: []
        queued: false
        open: false
        token: none
        inbox: none
        waiting: []
        duplex: false
        answered: false
        parked: none
    })
    p.exchanges[id] = e
    e
}

fn abandon_all(p: *Peer) {
    for _, e in p.exchanges {
        abandon(p, e)
    }
}

fn abandon(p: *Peer, e: *Exchange) {
    match e.token {
        some(t) => cancel.cancel(t)
        none => {}
    }
    drain_exchange(p, e)
}

fn notify_parked(e: *Exchange) {
    match e.parked {
        some(c) => {
            notify(c)
            e.parked = none
        }
        none => {}
    }
}

fn handed(p: *Peer, e: *Exchange) {
    free_body(p.pace, e.held)
    e.held = 0
    e.due = 0
}

fn drain_exchange(p: *Peer, e: *Exchange) {
    handed(p, e)
    notify_parked(e)
    var lost = 0
    for chunk in e.waiting {
        lost += chunk.len
    }
    e.waiting = []
    match e.inbox {
        some(box) => {
            for {
                let more: u8[]? = select {
                    c = <-box => c
                    else => none
                }
                match more {
                    some(chunk) => { lost += chunk.len }
                    none => break
                }
            }
            close(box)
            e.inbox = none
        }
        none => {}
    }
    if lost > 0 {
        credit(p, 0, lost) or {}
    }
}

fn feed(e: *Exchange) {
    let box = match e.inbox {
        some(b) => b
        none => return
    }
    for e.waiting.len > 0 {
        let taken = select {
            box <- e.waiting[0] => true
            else => false
        }
        if !taken {
            return
        }
        e.waiting = e.waiting[1..]
    }
    if e.received {
        close(box)
        e.inbox = none
    }
}

fn on_credit(p: *Peer, c: Credit) ! io.Error {
    match p.exchanges[c.id] {
        some(e) => {
            feed(e)
            credit(p, if e.received { 0 } else { e.id }, c.n)?
        }
        none => credit(p, 0, c.n)?
    }
}

fn protocol(p: *Peer, code: i64) -> io.Error {
    p.code = code
    go_away(p)
    Malformed
}

fn least(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn framing(p: *Peer, fault: Fault) -> io.Error {
    match fault {
        BadSize => protocol(p, error_frame_size)
        BadFrame => protocol(p, error_protocol)
    }
}

fn unpad(p: *Peer, f: Frame) -> u8[] ! io.Error {
    unpadded(f) catch {
        fault => fail framing(p, fault)
    }
}

fn credit(p: *Peer, stream: i64, n: i64) ! io.Error {
    if n == 0 {
        return
    }
    var out: u8[] = []
    put_window_update(mut out, 0, n)
    if stream > 0 {
        put_window_update(mut out, stream, n)
    }
    io.write_all(p.stream, out)?
}

fn on_settings(p: *Peer, f: Frame) ! io.Error {
    if f.stream != 0 || (f.flags & flag_ack != 0 && f.payload.len != 0) || f.payload.len % 6 != 0 {
        fail protocol(p, error_frame_size)
    }
    if f.flags & flag_ack != 0 {
        return
    }
    p.settled = true
    let settings = settings_of(f)
    for s in settings {
        let fault = setting_fault(s)
        if fault != 0 {
            fail protocol(p, fault)
        }
    }
    for s in settings {
        if s.id == setting_initial_window {
            for _, e in p.exchanges {
                e.window += s.value - p.initial
            }
            p.initial = s.value
        }
        if s.id == setting_max_frame_size {
            p.frame_size = s.value
        }
    }
    var ack: u8[] = []
    put_settings_ack(mut ack)
    io.write_all(p.stream, ack)?
}

fn on_window(p: *Peer, f: Frame) ! io.Error {
    if f.payload.len != 4 {
        fail protocol(p, error_frame_size)
    }
    let n = io.be32(f.payload, 0) & window_limit
    if f.stream == 0 {
        if n == 0 {
            fail protocol(p, error_protocol)
        }
        p.window += n
        if p.window > window_limit {
            fail protocol(p, error_flow_control)
        }
        return
    }
    match p.exchanges[f.stream] {
        some(e) => {
            if n == 0 {
                reset(p, e.id, error_protocol)?
                return
            }
            e.window += n
            if e.window > window_limit {
                reset(p, e.id, error_flow_control)?
            }
        }
        none => {
            if idle(p, f.stream) {
                fail protocol(p, error_protocol)
            }
        }
    }
}

fn charge(p: *Peer) ! io.Error {
    let refill = (now_ms() - p.reset_at) / reset_refill_ms
    p.reset_at += refill * reset_refill_ms
    p.resets = p.resets - least(p.resets, refill) + 1
    if p.resets > reset_budget {
        fail protocol(p, error_enhance_your_calm)
    }
}

fn reset(p: *Peer, id: i64, code: i64) ! io.Error {
    if code != 0 {
        charge(p)?
    }
    var out: u8[] = []
    put_reset(mut out, id, code)
    io.write_all(p.stream, out)?
    match p.exchanges[id] {
        some(e) => drain_exchange(p, e)
        none => {}
    }
    p.exchanges.delete(id)
    p.dropped[id] = true
}

fn idle(p: *Peer, id: i64) -> bool {
    id > p.last
}

fn opened(p: *Peer, id: i64) -> *Exchange ! io.Error {
    match p.exchanges[id] {
        some(e) => return e
        none => {}
    }
    if id % 2 == 0 {
        fail protocol(p, error_protocol)
    }
    if !idle(p, id) {
        fail protocol(p, error_stream_closed)
    }
    p.last = id
    new_exchange(p, id)
}

fn valid_request(fields: header.Header[]) -> bool {
    var seen: [str: bool] = [:]
    var regular = false
    var method = ""
    for h in fields {
        if h.name.len > 0 && h.name[0] == ':' {
            let known = h.name == ":method" || h.name == ":scheme" || h.name == ":authority" || h.name == ":path"
            if regular || !known || (seen[h.name] ?? false) || (h.name == ":path" && h.value.len == 0) {
                return false
            }
            seen[h.name] = true
            if h.name == ":method" {
                method = h.value
            }
            continue
        }
        regular = true
        if connection_specific(h.name) || (h.name == "te" && h.value != "trailers") {
            return false
        }
    }
    if method == "CONNECT" {
        return seen[":authority"] ?? false
    }
    method.len > 0 && (seen[":scheme"] ?? false) && (seen[":path"] ?? false)
}

fn has_pseudo(fields: header.Header[]) -> bool {
    fields.any(fn(h) h.name.len > 0 && h.name[0] == ':')
}

fn on_headers(p: *Peer, f: Frame) ! io.Error {
    if f.stream == 0 {
        fail protocol(p, error_protocol)
    }
    let block = header_block(f) catch {
        fault => fail framing(p, fault)
    }
    let e = opened(p, f.stream)?
    if e.received {
        fail protocol(p, error_stream_closed)
    }
    e.block = []
    io.append(mut e.block, block)
    e.ends = f.flags & flag_end_stream != 0
    if f.flags & flag_end_headers == 0 {
        p.pending = f.stream
        p.continuations = 0
        return
    }
    finish_block(p, e)?
}

fn on_continuation(p: *Peer, f: Frame) ! io.Error {
    if p.pending == 0 || f.stream != p.pending {
        fail protocol(p, error_protocol)
    }
    let ending = f.flags & flag_end_headers != 0
    p.continuations += 1
    if p.continuations > max_continuations || (f.payload.len == 0 && !ending) {
        fail protocol(p, error_enhance_your_calm)
    }
    let e = p.exchanges[f.stream] ?? new_exchange(p, f.stream)
    io.append(mut e.block, f.payload)
    if e.block.len > max_header_block {
        fail protocol(p, error_enhance_your_calm)
    }
    if ending {
        p.pending = 0
        finish_block(p, e)?
    }
}

fn on_reset(p: *Peer, f: Frame) ! io.Error {
    if f.stream == 0 || idle(p, f.stream) {
        fail protocol(p, error_protocol)
    }
    if f.payload.len != 4 {
        fail protocol(p, error_frame_size)
    }
    let e = match p.exchanges[f.stream] {
        some(e) => e
        none => return
    }
    if !e.queued && !e.answered {
        charge(p)?
    }
    abandon(p, e)
    p.exchanges.delete(f.stream)
}

fn finish_block(p: *Peer, e: *Exchange) ! io.Error {
    let fields = decode(p.decoder, e.block) catch {
        TooLarge => fail protocol(p, error_enhance_your_calm)
        _ => fail protocol(p, error_compression)
    }
    e.block = []
    if e.trailers {
        if !e.ends {
            fail protocol(p, error_protocol)
        }
        if has_pseudo(fields) {
            reset(p, e.id, error_protocol)?
            return
        }
    } else {
        for h in fields {
            if h.name != text.lower(h.name) {
                reset(p, e.id, error_protocol)?
                return
            }
        }
        if !valid_request(fields) {
            reset(p, e.id, error_protocol)?
            return
        }
        if p.exchanges.len > 100 || p.draining {
            reset(p, e.id, error_refused_stream)?
            return
        }
        e.fields = fields
        e.trailers = true
        if p.duplex {
            e.duplex = true
            e.inbox = some(chan[u8[]](16))
            p.complete(p, e)?
        } else if !e.ends {
            e.due = body_due(p.pace)
        }
    }
    if e.ends {
        end_remote(p, e)?
    }
}

fn end_remote(p: *Peer, e: *Exchange) ! io.Error {
    e.received = true
    if e.duplex {
        feed(e)
        if e.answered {
            forget(p, e)
        }
        return
    }
    let declared = header.get(e.fields, "content-length") ?? ""
    if declared.len > 0 && declared != "{e.body.len}" {
        reset(p, e.id, error_protocol)?
        return
    }
    handed(p, e)
    p.complete(p, e)?
}

fn on_data(p: *Peer, f: Frame) ! io.Error {
    if f.stream == 0 {
        fail protocol(p, error_protocol)
    }
    let data = unpad(p, f)?
    match p.exchanges[f.stream] {
        some(e) => {
            if e.received || !e.trailers {
                fail protocol(p, error_stream_closed)
            }
            if e.duplex {
                let last = f.flags & flag_end_stream != 0
                let padding = f.payload.len - data.len
                if padding > 0 {
                    credit(p, if last { 0 } else { e.id }, padding)?
                }
                if data.len > 0 {
                    e.waiting.push(data)
                    feed(e)
                }
                if last {
                    end_remote(p, e)?
                }
                return
            }
            if e.body.len + data.len > body_limit(p.pace) {
                reset(p, e.id, error_enhance_your_calm)?
                credit(p, 0, f.payload.len)?
                return
            }
            hold_body(p.pace, data.len) or {
                reset(p, e.id, error_refused_stream)?
                credit(p, 0, f.payload.len)?
                return
            }
            e.held += data.len
            advance(p, e, data.len)
            io.append(mut e.body, data)
            let ends = f.flags & flag_end_stream != 0
            credit(p, if ends { 0 } else { e.id }, f.payload.len)?
            if ends {
                end_remote(p, e)?
            }
        }
        none => {
            if idle(p, f.stream) {
                fail protocol(p, error_protocol)
            }
            if !(p.dropped[f.stream] ?? false) {
                fail protocol(p, error_stream_closed)
            }
            credit(p, 0, f.payload.len)?
        }
    }
}

fn on_frame(p: *Peer, f: Frame) ! io.Error {
    if p.pending != 0 && f.kind != frame_continuation {
        fail protocol(p, error_protocol)
    }
    if !p.settled && f.kind != frame_settings {
        fail protocol(p, error_protocol)
    }
    if f.kind == frame_data {
        on_data(p, f)?
    } else if f.kind == frame_headers {
        on_headers(p, f)?
    } else if f.kind == frame_priority {
        if f.stream == 0 {
            fail protocol(p, error_protocol)
        }
        if f.payload.len != 5 {
            fail protocol(p, error_frame_size)
        }
        if io.be32(f.payload, 0) & window_limit == f.stream {
            reset(p, f.stream, error_protocol)?
        }
    } else if f.kind == frame_reset {
        on_reset(p, f)?
    } else if f.kind == frame_settings {
        on_settings(p, f)?
    } else if f.kind == frame_push_promise {
        fail protocol(p, error_protocol)
    } else if f.kind == frame_ping {
        if f.stream != 0 || f.payload.len != 8 {
            fail protocol(p, error_frame_size)
        }
        if f.flags & flag_ack == 0 {
            var ack: u8[] = []
            put_ping_ack(mut ack, f.payload)
            io.write_all(p.stream, ack)?
        }
    } else if f.kind == frame_goaway {
        if f.stream != 0 {
            fail protocol(p, error_protocol)
        }
    } else if f.kind == frame_window_update {
        on_window(p, f)?
    } else if f.kind == frame_continuation {
        on_continuation(p, f)?
    }
}

fn header_frames(p: *Peer, mut out: u8[], id: i64, fields: header.Header[], ends: bool) {
    put_headers(mut out, p.statics, p.frame_size, id, fields, ends)
}

fn queue(p: *Peer, e: *Exchange, fields: header.Header[], body: u8[], trailers: header.Header[]) ! io.Error {
    var out: u8[] = []
    header_frames(p, mut out, e.id, fields, body.len == 0 && trailers.len == 0 && !e.open)
    if body.len == 0 && trailers.len > 0 && !e.open {
        header_frames(p, mut out, e.id, trailers, true)
    }
    io.write_all(p.stream, out)?
    e.out = body
    e.tail = trailers
    e.queued = true
    if body.len == 0 && !e.open {
        sent(p, e)?
    }
}

fn forget(p: *Peer, e: *Exchange) {
    drain_exchange(p, e)
    p.exchanges.delete(e.id)
}

fn sent(p: *Peer, e: *Exchange) ! io.Error {
    e.answered = true
    if e.received {
        forget(p, e)
        return
    }
    if e.duplex {
        reset(p, e.id, 0)?
    }
}

fn owe(p: *Peer, owing: i64, taken: i64) {
    if owing == 0 || p.owing == 0 {
        p.behind = 0
        p.accrued = now_ms()
    } else if taken >= p.behind {
        p.behind = 0
    } else {
        p.behind -= taken
    }
    p.owing = owing
}

fn fall_behind(p: *Peer, pace: *Pace, now: i64) ! io.Error {
    if p.owing == 0 || pace.limits.write_timeout <= 0 {
        return
    }
    p.behind += p.owing * write_piece * (now - p.accrued) / pace.limits.write_timeout
    p.accrued = now
    if p.behind > p.owing * write_piece {
        fail protocol(p, error_enhance_your_calm)
    }
}

fn flush(p: *Peer) ! io.Error {
    var out: u8[] = []
    var finished: *Exchange[] = []
    var owing = 0
    var taken = 0
    for _, e in p.exchanges {
        for e.queued && e.out.len > 0 && p.window > 0 && e.window > 0 {
            let n = least(least(e.out.len, p.frame_size), least(p.window, e.window))
            let last = n == e.out.len && !e.open
            put_frame(mut out, frame_data, if last && e.tail.len == 0 { flag_end_stream } else { 0 }, e.id, e.out[..n])
            e.out = e.out[n..]
            p.window -= n
            e.window -= n
            taken += n
            if last {
                if e.tail.len > 0 {
                    header_frames(p, mut out, e.id, e.tail, true)
                }
                finished.push(e)
            }
        }
        if e.out.len <= high_water {
            notify_parked(e)
        }
        if e.queued && !e.open && e.out.len > 0 {
            owing += 1
        }
    }
    owe(p, owing, taken)
    io.write_all(p.stream, out)?
    for e in finished {
        e.queued = false
        sent(p, e)?
    }
}

fn advance(p: *Peer, e: *Exchange, n: i64) {
    let pace = match p.pace {
        some(found) => found
        none => return
    }
    e.fresh += n
    let share = quota(pace.limits)
    if e.fresh >= share {
        e.fresh %= share
        e.due = due(pace.limits.body_timeout)
        pace.since = now_ms()
    }
}

fn expire(p: *Peer) ! io.Error {
    let pace = match p.pace {
        some(found) => found
        none => return
    }
    let now = now_ms()
    if now - p.swept < pace.dog.interval {
        return
    }
    p.swept = now
    var late: i64[] = []
    for id, e in p.exchanges {
        if e.due != 0 && now >= e.due {
            late.push(id)
        }
    }
    for id in late {
        reset(p, id, error_enhance_your_calm)?
    }
    fall_behind(p, pace, now)?
    overrun_handlers(p, pace.limits.handler_timeout, now)
}

fn overrun_handlers(p: *Peer, limit: i64, now: i64) {
    if limit <= 0 {
        return
    }
    for id, started in p.running {
        if now - started < limit || p.late[id] != none {
            continue
        }
        p.late[id] = true
        let e = p.exchanges[id] ?? continue
        match e.token {
            some(token) => cancel.cancel(token)
            none => {}
        }
    }
}

fn occupy(p: *Peer) {
    if p.running.len == 0 && !p.duplex {
        flowing(p.pace)
    } else if p.running.len > 0 && p.late.len == p.running.len {
        lagging(p.pace, p.running.len)
    } else {
        unbound(p.pace)
    }
}

fn go_away(p: *Peer) {
    var out: u8[] = []
    put_goaway(mut out, p.last, p.code)
    io.write_all(p.stream, out) or {}
}

enum ReplyPart {
    Whole
    Chunk
    End
}

struct Reply {
    id: i64
    method: str
    response: Response
    phase: ReplyPart = Whole
    chunk: u8[] = []
    tail: header.Header[] = []
    acks: chan[bool]? = none
}

fn pump(p: *Peer, frames: chan[Frame]) {
    for {
        let f = read_frame(p.reader) catch {
            TooLarge => {
                p.failure = error_frame_size
                close(frames)
                return
            }
            _ => {
                close(frames)
                return
            }
        }
        frames <- f
    }
}

fn linger(frames: chan[Frame]) {
    let deadline = now_ms() + linger_ms
    for {
        let left = deadline - now_ms()
        if left <= 0 {
            return
        }
        select {
            f = <-frames => match f {
                some(_) => {}
                none => return
            }
            after(left) => return
        }
    }
}

fn respond(handler: fn(Request) -> Response, req: Request, id: i64, replies: chan[Reply]) {
    let produced = traced(handler, req)
    let response = unstreamed(req.method, produced, req.token)
    match response.stream {
        some(chunks) => relay(response, chunks, req, id, replies)
        none => {
            cancel.cancel(req.token)
            replies <- Reply { id, method: req.method, response }
        }
    }
}

fn relay(response: Response, chunks: chan[u8[]], req: Request, id: i64, replies: chan[Reply]) {
    replies <- Reply { id, method: req.method, response }
    let gone = cancel.done(req.token)
    let acks = chan[bool](1)
    for {
        select {
            part = <-chunks => match part {
                some(data) => {
                    select {
                        replies <- Reply { id, method: req.method, response, phase: Chunk, chunk: data, acks: some(acks) } => {}
                        <-gone => break
                    }
                    select {
                        <-acks => {}
                        <-gone => break
                    }
                }
                none => break
            }
            <-gone => break
        }
    }
    let tail = response.finish()
    cancel.cancel(req.token)
    replies <- Reply { id, method: req.method, response, phase: End, tail }
}

fn take_chunk(p: *Peer, reply: Reply) {
    let acks = match reply.acks {
        some(a) => a
        none => return
    }
    match p.exchanges[reply.id] {
        some(e) => {
            io.append(mut e.out, reply.chunk)
            if e.out.len > high_water {
                e.parked = some(acks)
            } else {
                notify(acks)
            }
        }
        none => notify(acks)
    }
}

fn trailer_fields(trailers: header.Header[]) -> header.Header[] {
    var out: header.Header[] = []
    for h in trailers {
        let name = text.lower(h.name)
        if !connection_specific(name) && name.len > 0 && name[0] != ':' {
            out.push(header.Header { name, value: h.value })
        }
    }
    out
}

fn finished(p: *Peer, id: i64) {
    p.running.delete(id)
    p.late.delete(id)
}

fn end_stream(p: *Peer, reply: Reply) ! io.Error {
    p.outstanding -= 1
    finished(p, reply.id)
    let e = match p.exchanges[reply.id] {
        some(e) => e
        none => return
    }
    e.open = false
    for h in trailer_fields(reply.tail) {
        e.tail.push(h)
    }
    if e.out.len > 0 {
        return
    }
    var out: u8[] = []
    if e.tail.len > 0 {
        header_frames(p, mut out, e.id, e.tail, true)
    } else {
        put_frame(mut out, frame_data, flag_end_stream, e.id, [])
    }
    io.write_all(p.stream, out)?
    e.queued = false
    sent(p, e)?
}

fn deliver(p: *Peer, reply: Reply) ! io.Error {
    match reply.phase {
        Chunk => {
            take_chunk(p, reply)
            return
        }
        End => {
            end_stream(p, reply)?
            return
        }
        Whole => {}
    }
    let resp = reply.response
    if !streaming(resp) {
        p.outstanding -= 1
        finished(p, reply.id)
    } else if !p.duplex {
        finished(p, reply.id)
    }
    let e = match p.exchanges[reply.id] {
        some(e) => e
        none => return
    }
    e.open = streaming(resp)
    var fields: header.Header[] = [header.Header { name: ":status", value: "{resp.status}" }]
    for h in resp.headers {
        if !connection_specific(text.lower(h.name)) {
            fields.push(h)
        }
    }
    var body = resp.body
    if bodiless(reply.method, resp.status) {
        body = []
    }
    if !header.has(resp.headers, "content-length") && !e.open {
        fields.push(header.Header { name: "content-length", value: "{body.len}" })
    }
    queue(p, e, fields, body, trailer_fields(resp.trailers))?
}

fn pass_over(p: *Peer, reply: Reply) {
    match reply.phase {
        Chunk => match reply.acks {
            some(acks) => notify(acks)
            none => {}
        }
        End => finished(p, reply.id)
        Whole => if !p.duplex || !streaming(reply.response) {
            finished(p, reply.id)
        }
    }
}

fn outlast(p: *Peer, replies: chan[Reply]) {
    for p.running.len > 0 {
        match <-replies {
            some(reply) => pass_over(p, reply)
            none => return
        }
    }
}

fn on_input(p: *Peer, f: Frame?) -> bool ! io.Error {
    match f {
        some(frame) => {
            on_frame(p, frame)?
            true
        }
        none => {
            if p.failure != 0 {
                fail protocol(p, p.failure)
            }
            false
        }
    }
}

fn serve_h2(s: io.Stream, r: *io.Reader, remote: str, mode: chan[bool]?, pace: *Pace?, handler: fn(Request) -> Response) ! io.Error {
    let replies = chan[Reply](128)
    let complete = fn(p: *Peer, e: *Exchange) ! io.Error {
        var req = request_of(e.fields, e.body, Http2) or {
            reset(p, e.id, error_protocol)?
            return
        }
        req.remote = remote
        match e.inbox {
            some(box) => {
                let id = e.id
                let gone = cancel.done(req.token)
                req.upload = some(Upload {
                    chunks: box
                    credit: fn(n: i64) {
                        select {
                            p.credits <- Credit { id, n } => {}
                            <-gone => {}
                        }
                    }
                    token: req.token
                })
            }
            none => {}
        }
        p.outstanding += 1
        p.running[e.id] = now_ms()
        e.token = some(req.token)
        spawn respond(handler, req, e.id, replies)
    }
    let p = new_peer(s, r, mode != none, pace, complete)
    var drain: chan[bool] = match mode {
        some(c) => c
        none => chan[bool]()
    }
    defer outlast(p, replies)
    defer abandon_all(p)
    var out: u8[] = []
    put_initial_settings(mut out, true)
    io.write_all(s, out)?
    let frames = chan[Frame](16)
    spawn pump(p, frames)
    var reading = true
    var fresh = true
    for reading || p.outstanding > 0 {
        expire(p)?
        flush(p)?
        if p.outstanding > 0 {
            occupy(p)
        } else if p.pending != 0 {
            repose(pace, phase_heading, false)
        } else if p.owing > 0 {
            sending(pace)
        } else {
            repose(pace, if p.exchanges.len > 0 { phase_receiving } else { phase_resting }, fresh)
        }
        fresh = p.outstanding > 0
        if p.draining && p.outstanding == 0 && p.exchanges.len == 0 {
            if reading {
                linger(frames)
            }
            return
        }
        if !reading {
            select {
                reply = <-replies => match reply {
                    some(x) => deliver(p, x)?
                    none => return
                }
                <-p.credits => {}
            }
            continue
        }
        let sweep = match pace {
            some(found) => if p.exchanges.len > 0 || p.running.len > 0 { found.dog.interval } else { quiet_ms }
            none => quiet_ms
        }
        select {
            <-drain => {
                p.draining = true
                drain = chan[bool]()
                var out: u8[] = []
                put_goaway(mut out, p.last, 0)
                io.write_all(p.stream, out)?
            }
            f = <-frames => {
                fresh = true
                reading = on_input(p, f)?
                if !reading {
                    abandon_all(p)
                }
            }
            reply = <-replies => match reply {
                some(x) => deliver(p, x)?
                none => {}
            }
            c = <-p.credits => match c {
                some(x) => on_credit(p, x)?
                none => {}
            }
            after(sweep) => {}
        }
    }
    flush(p)?
}
