import std/cancel
import std/header
import std/io
import std/slices
import std/text

struct Exchange {
    id: i64
    fields: []header.Header
    trailers: bool
    block: []u8
    ends: bool
    body: []u8
    received: bool
    window: i64
    out: []u8
    tail: []header.Header
    queued: bool
    open: bool
    token: *cancel.Token?
}

struct Peer {
    stream: io.Stream
    reader: *io.Reader
    decoder: *Hpack
    statics: []header.Header
    exchanges: [i64: *Exchange]
    dropped: [i64: bool]
    window: i64
    initial: i64
    frame_size: i64
    last: i64
    pending: i64
    settled: bool
    outstanding: i64
    failure: i64
    code: i64
    complete: fn(*Peer, *Exchange) ! io.Error
}

fn new_peer(s: io.Stream, r: *io.Reader, complete: fn(*Peer, *Exchange) ! io.Error) -> *Peer {
    new(Peer {
        stream: s
        reader: r
        decoder: new_hpack(4096)
        statics: static_table()
        exchanges: [:]
        dropped: [:]
        window: default_window
        initial: default_window
        frame_size: default_frame_size
        last: 0
        pending: 0
        settled: false
        outstanding: 0
        failure: 0
        code: 0
        complete
    })
}

fn new_exchange(p: *Peer, id: i64) -> *Exchange {
    let e = new(Exchange {
        id
        fields: []
        trailers: false
        block: []
        ends: false
        body: []
        received: false
        window: p.initial
        out: []
        tail: []
        queued: false
        open: false
        token: none
    })
    p.exchanges[id] = e
    e
}

fn abandon_all(p: *Peer) {
    for _, e in p.exchanges {
        abandon(some(e))
    }
}

fn abandon(e: *Exchange?) {
    match e {
        some(x) => match x.token {
            some(t) => cancel.cancel(t)
            none => {}
        }
        none => {}
    }
}

fn protocol(p: *Peer, code: i64) -> io.Error {
    p.code = code
    go_away(p)
    Malformed
}

fn least(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn framing(p: *Peer, fault: Fault) -> io.Error {
    match fault {
        BadSize => protocol(p, error_frame_size)
        BadFrame => protocol(p, error_protocol)
    }
}

fn unpad(p: *Peer, f: Frame) -> []u8 ! io.Error {
    unpadded(f) catch {
        fault => fail framing(p, fault)
    }
}

fn credit(p: *Peer, stream: i64, n: i64) ! io.Error {
    if n == 0 {
        return
    }
    var out: []u8 = []
    put_window_update(mut out, 0, n)
    if stream > 0 {
        put_window_update(mut out, stream, n)
    }
    io.write_all(p.stream, out)?
}

fn on_settings(p: *Peer, f: Frame) ! io.Error {
    if f.stream != 0 || (f.flags & flag_ack != 0 && f.payload.len != 0) || f.payload.len % 6 != 0 {
        fail protocol(p, error_frame_size)
    }
    if f.flags & flag_ack != 0 {
        return
    }
    p.settled = true
    let settings = settings_of(f)
    for s in settings {
        let fault = setting_fault(s)
        if fault != 0 {
            fail protocol(p, fault)
        }
    }
    for s in settings {
        if s.id == setting_initial_window {
            for _, e in p.exchanges {
                e.window += s.value - p.initial
            }
            p.initial = s.value
        }
        if s.id == setting_max_frame_size {
            p.frame_size = s.value
        }
    }
    var ack: []u8 = []
    put_settings_ack(mut ack)
    io.write_all(p.stream, ack)?
}

fn on_window(p: *Peer, f: Frame) ! io.Error {
    if f.payload.len != 4 {
        fail protocol(p, error_frame_size)
    }
    let n = io.be32(f.payload, 0) & window_limit
    if f.stream == 0 {
        if n == 0 {
            fail protocol(p, error_protocol)
        }
        p.window += n
        if p.window > window_limit {
            fail protocol(p, error_flow_control)
        }
        return
    }
    match p.exchanges[f.stream] {
        some(e) => {
            if n == 0 {
                reset(p, e.id, error_protocol)?
                return
            }
            e.window += n
            if e.window > window_limit {
                reset(p, e.id, error_flow_control)?
            }
        }
        none => {
            if idle(p, f.stream) {
                fail protocol(p, error_protocol)
            }
        }
    }
}

fn reset(p: *Peer, id: i64, code: i64) ! io.Error {
    var out: []u8 = []
    put_reset(mut out, id, code)
    io.write_all(p.stream, out)?
    delete(mut p.exchanges, id)
    p.dropped[id] = true
}

fn idle(p: *Peer, id: i64) -> bool {
    id > p.last
}

fn opened(p: *Peer, id: i64) -> *Exchange ! io.Error {
    match p.exchanges[id] {
        some(e) => return e
        none => {}
    }
    if id % 2 == 0 {
        fail protocol(p, error_protocol)
    }
    if !idle(p, id) {
        fail protocol(p, error_stream_closed)
    }
    p.last = id
    new_exchange(p, id)
}

fn valid_request(fields: []header.Header) -> bool {
    var seen: [str: bool] = [:]
    var regular = false
    var method = ""
    for h in fields {
        if h.name.len > 0 && h.name[0] == ':' {
            let known = h.name == ":method" || h.name == ":scheme" || h.name == ":authority" || h.name == ":path"
            if regular || !known || (seen[h.name] ?? false) || (h.name == ":path" && h.value.len == 0) {
                return false
            }
            seen[h.name] = true
            if h.name == ":method" {
                method = h.value
            }
            continue
        }
        regular = true
        if connection_specific(h.name) || (h.name == "te" && h.value != "trailers") {
            return false
        }
    }
    if method == "CONNECT" {
        return seen[":authority"] ?? false
    }
    method.len > 0 && (seen[":scheme"] ?? false) && (seen[":path"] ?? false)
}

fn has_pseudo(fields: []header.Header) -> bool {
    fields.any(fn(h) h.name.len > 0 && h.name[0] == ':')
}

fn on_headers(p: *Peer, f: Frame) ! io.Error {
    if f.stream == 0 {
        fail protocol(p, error_protocol)
    }
    let block = header_block(f) catch {
        fault => fail framing(p, fault)
    }
    let e = opened(p, f.stream)?
    if e.received {
        fail protocol(p, error_stream_closed)
    }
    e.block = []
    io.append(mut e.block, block)
    e.ends = f.flags & flag_end_stream != 0
    if f.flags & flag_end_headers == 0 {
        p.pending = f.stream
        return
    }
    finish_block(p, e)?
}

fn on_continuation(p: *Peer, f: Frame) ! io.Error {
    if p.pending == 0 || f.stream != p.pending {
        fail protocol(p, error_protocol)
    }
    let e = p.exchanges[f.stream] ?? new_exchange(p, f.stream)
    io.append(mut e.block, f.payload)
    if e.block.len > max_header_block {
        fail protocol(p, error_enhance_your_calm)
    }
    if f.flags & flag_end_headers != 0 {
        p.pending = 0
        finish_block(p, e)?
    }
}

fn finish_block(p: *Peer, e: *Exchange) ! io.Error {
    let fields = decode(p.decoder, e.block) catch {
        TooLarge => fail protocol(p, error_enhance_your_calm)
        _ => fail protocol(p, error_compression)
    }
    e.block = []
    if e.trailers {
        if !e.ends {
            fail protocol(p, error_protocol)
        }
        if has_pseudo(fields) {
            reset(p, e.id, error_protocol)?
            return
        }
    } else {
        for h in fields {
            if h.name != text.lower(h.name) {
                reset(p, e.id, error_protocol)?
                return
            }
        }
        if !valid_request(fields) {
            reset(p, e.id, error_protocol)?
            return
        }
        if p.exchanges.len > 100 {
            reset(p, e.id, error_refused_stream)?
            return
        }
        e.fields = fields
        e.trailers = true
    }
    if e.ends {
        end_remote(p, e)?
    }
}

fn end_remote(p: *Peer, e: *Exchange) ! io.Error {
    e.received = true
    let declared = header.get(e.fields, "content-length") ?? ""
    if declared.len > 0 && declared != "{e.body.len}" {
        reset(p, e.id, error_protocol)?
        return
    }
    p.complete(p, e)?
}

fn on_data(p: *Peer, f: Frame) ! io.Error {
    if f.stream == 0 {
        fail protocol(p, error_protocol)
    }
    let data = unpad(p, f)?
    match p.exchanges[f.stream] {
        some(e) => {
            if e.received || !e.trailers {
                fail protocol(p, error_stream_closed)
            }
            if e.body.len + data.len > max_body {
                reset(p, e.id, error_enhance_your_calm)?
                credit(p, 0, f.payload.len)?
                return
            }
            io.append(mut e.body, data)
            let ends = f.flags & flag_end_stream != 0
            credit(p, if ends { 0 } else { e.id }, f.payload.len)?
            if ends {
                end_remote(p, e)?
            }
        }
        none => {
            if idle(p, f.stream) {
                fail protocol(p, error_protocol)
            }
            if !(p.dropped[f.stream] ?? false) {
                fail protocol(p, error_stream_closed)
            }
            credit(p, 0, f.payload.len)?
        }
    }
}

fn on_frame(p: *Peer, f: Frame) ! io.Error {
    if p.pending != 0 && f.kind != frame_continuation {
        fail protocol(p, error_protocol)
    }
    if !p.settled && f.kind != frame_settings {
        fail protocol(p, error_protocol)
    }
    if f.kind == frame_data {
        on_data(p, f)?
    } else if f.kind == frame_headers {
        on_headers(p, f)?
    } else if f.kind == frame_priority {
        if f.stream == 0 {
            fail protocol(p, error_protocol)
        }
        if f.payload.len != 5 {
            fail protocol(p, error_frame_size)
        }
        if io.be32(f.payload, 0) & window_limit == f.stream {
            reset(p, f.stream, error_protocol)?
        }
    } else if f.kind == frame_reset {
        if f.stream == 0 || idle(p, f.stream) {
            fail protocol(p, error_protocol)
        }
        if f.payload.len != 4 {
            fail protocol(p, error_frame_size)
        }
        abandon(p.exchanges[f.stream])
        delete(mut p.exchanges, f.stream)
    } else if f.kind == frame_settings {
        on_settings(p, f)?
    } else if f.kind == frame_push_promise {
        fail protocol(p, error_protocol)
    } else if f.kind == frame_ping {
        if f.stream != 0 || f.payload.len != 8 {
            fail protocol(p, error_frame_size)
        }
        if f.flags & flag_ack == 0 {
            var ack: []u8 = []
            put_ping_ack(mut ack, f.payload)
            io.write_all(p.stream, ack)?
        }
    } else if f.kind == frame_goaway {
        if f.stream != 0 {
            fail protocol(p, error_protocol)
        }
    } else if f.kind == frame_window_update {
        on_window(p, f)?
    } else if f.kind == frame_continuation {
        on_continuation(p, f)?
    }
}

fn header_frames(p: *Peer, mut out: []u8, id: i64, fields: []header.Header, ends: bool) {
    put_headers(mut out, p.statics, p.frame_size, id, fields, ends)
}

fn queue(p: *Peer, e: *Exchange, fields: []header.Header, body: []u8, trailers: []header.Header) ! io.Error {
    var out: []u8 = []
    header_frames(p, mut out, e.id, fields, body.len == 0 && trailers.len == 0 && !e.open)
    if body.len == 0 && trailers.len > 0 {
        header_frames(p, mut out, e.id, trailers, true)
    }
    io.write_all(p.stream, out)?
    e.out = body
    e.tail = trailers
    e.queued = true
    if body.len == 0 && !e.open {
        sent(p, e)
    }
}

fn sent(p: *Peer, e: *Exchange) {
    if e.received {
        delete(mut p.exchanges, e.id)
    }
}

fn flush(p: *Peer) ! io.Error {
    var out: []u8 = []
    var finished: []*Exchange = []
    for _, e in p.exchanges {
        for e.queued && e.out.len > 0 && p.window > 0 && e.window > 0 {
            let n = least(least(e.out.len, p.frame_size), least(p.window, e.window))
            let last = n == e.out.len && !e.open
            put_frame(mut out, frame_data, if last && e.tail.len == 0 { flag_end_stream } else { 0 }, e.id, e.out[..n])
            e.out = e.out[n..]
            p.window -= n
            e.window -= n
            if last {
                if e.tail.len > 0 {
                    header_frames(p, mut out, e.id, e.tail, true)
                }
                push(mut finished, e)
            }
        }
    }
    io.write_all(p.stream, out)?
    for e in finished {
        e.queued = false
        sent(p, e)
    }
}

fn go_away(p: *Peer) {
    var out: []u8 = []
    put_goaway(mut out, p.last, p.code)
    io.write_all(p.stream, out) or {}
}

enum ReplyPart {
    Whole
    Chunk
    End
}

struct Reply {
    id: i64
    method: str
    response: Response
    phase: ReplyPart = Whole
    chunk: []u8 = []
}

fn pump(p: *Peer, frames: chan[Frame]) {
    for {
        let f = read_frame(p.reader) catch {
            TooLarge => {
                p.failure = error_frame_size
                close(frames)
                return
            }
            _ => {
                close(frames)
                return
            }
        }
        frames <- f
    }
}

fn respond(handler: fn(Request) -> Response, req: Request, id: i64, replies: chan[Reply]) {
    let produced = traced(handler, req)
    let response = unstreamed(req.method, produced, req.token)
    match response.stream {
        some(chunks) => relay(response, chunks, req, id, replies)
        none => {
            cancel.cancel(req.token)
            replies <- Reply { id, method: req.method, response }
        }
    }
}

fn relay(response: Response, chunks: chan[[]u8], req: Request, id: i64, replies: chan[Reply]) {
    replies <- Reply { id, method: req.method, response }
    let gone = cancel.done(req.token)
    for {
        select {
            part = <-chunks => match part {
                some(data) => {
                    select {
                        replies <- Reply { id, method: req.method, response, phase: Chunk, chunk: data } => {}
                        <-gone => break
                    }
                }
                none => break
            }
            <-gone => break
        }
    }
    cancel.cancel(req.token)
    replies <- Reply { id, method: req.method, response, phase: End }
}

fn take_chunk(p: *Peer, reply: Reply) {
    match p.exchanges[reply.id] {
        some(e) => io.append(mut e.out, reply.chunk)
        none => {}
    }
}

fn end_stream(p: *Peer, reply: Reply) ! io.Error {
    p.outstanding -= 1
    let e = match p.exchanges[reply.id] {
        some(e) => e
        none => return
    }
    e.open = false
    if e.out.len > 0 {
        return
    }
    var out: []u8 = []
    put_frame(mut out, frame_data, flag_end_stream, e.id, [])
    io.write_all(p.stream, out)?
    e.queued = false
    sent(p, e)
}

fn deliver(p: *Peer, reply: Reply) ! io.Error {
    match reply.phase {
        Chunk => {
            take_chunk(p, reply)
            return
        }
        End => {
            end_stream(p, reply)?
            return
        }
        Whole => {}
    }
    let resp = reply.response
    if !streaming(resp) {
        p.outstanding -= 1
    }
    let e = match p.exchanges[reply.id] {
        some(e) => e
        none => return
    }
    e.open = streaming(resp)
    var fields: []header.Header = [header.Header { name: ":status", value: "{resp.status}" }]
    for h in resp.headers {
        if !connection_specific(text.lower(h.name)) {
            push(mut fields, h)
        }
    }
    var body = resp.body
    if bodiless(reply.method, resp.status) {
        body = []
    }
    if !header.has(resp.headers, "content-length") && !e.open {
        push(mut fields, header.Header { name: "content-length", value: "{body.len}" })
    }
    var trailers: []header.Header = []
    for h in resp.trailers {
        let name = text.lower(h.name)
        if !connection_specific(name) && name.len > 0 && name[0] != ':' {
            push(mut trailers, header.Header { name, value: h.value })
        }
    }
    queue(p, e, fields, body, trailers)?
}

fn on_input(p: *Peer, f: Frame?) -> bool ! io.Error {
    match f {
        some(frame) => {
            on_frame(p, frame)?
            true
        }
        none => {
            if p.failure != 0 {
                fail protocol(p, p.failure)
            }
            false
        }
    }
}

fn serve_h2(s: io.Stream, r: *io.Reader, remote: str, handler: fn(Request) -> Response) ! io.Error {
    let replies = chan[Reply](128)
    let complete = fn(p: *Peer, e: *Exchange) ! io.Error {
        var req = request_of(e.fields, e.body, Http2) or {
            reset(p, e.id, error_protocol)?
            return
        }
        req.remote = remote
        p.outstanding += 1
        e.token = some(req.token)
        spawn respond(handler, req, e.id, replies)
    }
    let p = new_peer(s, r, complete)
    defer abandon_all(p)
    var out: []u8 = []
    put_initial_settings(mut out, true)
    io.write_all(s, out)?
    let frames = chan[Frame](16)
    spawn pump(p, frames)
    var reading = true
    for reading || p.outstanding > 0 {
        flush(p)?
        if !reading {
            match <-replies {
                some(reply) => deliver(p, reply)?
                none => return
            }
            continue
        }
        select {
            f = <-frames => {
                reading = on_input(p, f)?
                if !reading {
                    abandon_all(p)
                }
            }
            reply = <-replies => match reply {
                some(x) => deliver(p, x)?
                none => {}
            }
        }
    }
    flush(p)?
}
