import std/atomic
import std/math
import std/sync

struct Limits {
    max_body: i64
    timeout_ms: i64
}

struct Stats {
    requests: atomic.Int
    rejected: atomic.Int
    largest: atomic.Int
    first: atomic.Flag
    firsts: atomic.Int
    limits: atomic.Value[Limits]
}

fn serve(worker: i64, stats: Stats, group: sync.WaitGroup) {
    for i in 0..100 {
        let size = worker * 100 + i
        stats.requests.add_int(1)
        stats.largest.update_int(fn(seen: i64) -> i64 { math.max(seen, size) })
        if stats.first.set() {
            stats.firsts.add_int(1)
        }
        if size > stats.limits.load_value().max_body {
            stats.rejected.add_int(1)
        }
    }
    group.done()
}

/// Eight workers share request counters, a first-request flag and a limits value that is replaced as a whole.
fn main() {
    let stats = Stats {
        requests: atomic.int(0),
        rejected: atomic.int(0),
        largest: atomic.int(0),
        first: atomic.flag(),
        firsts: atomic.int(0),
        limits: atomic.value(Limits { max_body: 512, timeout_ms: 3000 })
    }
    let group = sync.wait_group()
    for worker in 0..8 {
        group.add(1)
        spawn serve(worker, stats, group)
    }
    group.wait()
    print("requests {stats.requests.load_int()}, rejected {stats.rejected.load_int()}")
    print("largest body {stats.largest.load_int()}")
    print("first request claimed {stats.firsts.load_int()} time")

    let seen = stats.limits.snapshot_value()
    let old = stats.limits.swap_value(Limits { max_body: 1024, timeout_ms: 1500 })
    let now = stats.limits.load_value()
    print("limits {old.max_body} bytes {old.timeout_ms} ms -> {now.max_body} bytes {now.timeout_ms} ms")
    print("update from the old snapshot applied: {stats.limits.compare_and_swap_value(seen, old)}")

    let drained = stats.requests.swap_int(0)
    print("drained {drained}, now {stats.requests.load_int()}")
}
