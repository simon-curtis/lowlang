import std/log
import std/os
import std/text
import std/time/datetime
import std/time/timestamp
import std/unicode

/// The facility of a syslog message, which names the kind of program that produced it (RFC 5424 table 1). Its index is the facility code.
pub enum Facility {
    /// Kernel messages.
    Kernel = 0
    /// User-level messages.
    User = 1
    /// Mail system.
    Mail = 2
    /// System daemons.
    Daemon = 3
    /// Security and authorization messages.
    Auth = 4
    /// Messages generated internally by the syslog daemon.
    Syslogd = 5
    /// Line printer subsystem.
    Printer = 6
    /// Network news subsystem.
    News = 7
    /// UUCP subsystem.
    Uucp = 8
    /// Clock daemon.
    Clock = 9
    /// Security and authorization messages, second code.
    AuthPrivate = 10
    /// FTP daemon.
    Ftp = 11
    /// NTP subsystem.
    Ntp = 12
    /// Log audit.
    Audit = 13
    /// Log alert.
    LogAlert = 14
    /// Clock daemon, second code.
    Cron = 15
    /// Local use 0.
    Local0 = 16
    /// Local use 1.
    Local1 = 17
    /// Local use 2.
    Local2 = 18
    /// Local use 3.
    Local3 = 19
    /// Local use 4.
    Local4 = 20
    /// Local use 5.
    Local5 = 21
    /// Local use 6.
    Local6 = 22
    /// Local use 7.
    Local7 = 23
}

/// The severity of a syslog message (RFC 5424 table 2). Its index is the severity code, and a smaller code is more severe.
pub enum Severity {
    /// The system is unusable.
    Emergency = 0
    /// Action must be taken immediately.
    Alert = 1
    /// Critical conditions.
    Critical = 2
    /// Error conditions.
    Error = 3
    /// Warning conditions.
    Warning = 4
    /// Normal but significant conditions.
    Notice = 5
    /// Informational messages.
    Info = 6
    /// Debug-level messages.
    Debug = 7
}

/// One `name="value"` pair of a structured data element.
pub struct Param {
    /// The parameter name. `format` replaces each byte outside printable ASCII and each of `=`, `]` and `"` with `_` and keeps at most 32 bytes; an empty name becomes `_`.
    pub name: str
    /// The parameter value, which `format` writes with `"`, `\` and `]` escaped as RFC 5424 section 6.3.3 requires and with each invalid UTF-8 byte written as U+FFFD.
    pub value: str
}

/// A structured data element: an identifier and its parameters.
pub struct Element {
    /// The SD-ID, such as `exampleSDID@32473`. `format` sanitises it as it does a parameter name.
    pub id: str
    /// The parameters in the order they are written.
    pub params: Param[]
}

/// A syslog message as RFC 5424 section 6 lays it out.
pub struct Message {
    /// The facility, giving the high bits of the priority value. Defaults to `User`.
    pub facility: Facility = User
    /// The severity, giving the low three bits of the priority value. Defaults to `Info`.
    pub severity: Severity = Info
    /// The time in nanoseconds since the Unix epoch, written in UTC with the fraction trimmed of trailing zeros and cut to microseconds, or the nil value `-` when `none`.
    pub timestamp: i64? = none
    /// The HOSTNAME field. An empty value is written as `-`; other values are sanitised to printable ASCII and cut to 255 bytes.
    pub hostname: str = ""
    /// The APP-NAME field. An empty value is written as `-`; other values are sanitised to printable ASCII and cut to 48 bytes.
    pub app_name: str = ""
    /// The PROCID field. An empty value is written as `-`; other values are sanitised to printable ASCII and cut to 128 bytes.
    pub procid: str = ""
    /// The MSGID field. An empty value is written as `-`; other values are sanitised to printable ASCII and cut to 32 bytes.
    pub msgid: str = ""
    /// The structured data elements. None are written as `-`.
    pub data: Element[] = []
    /// The free-form MSG. It is left out when empty.
    pub text: str = ""
    /// Whether the text is preceded by the UTF-8 byte order mark `EF BB BF` that RFC 5424 section 6.4 uses to declare the text UTF-8.
    pub bom: bool = false
}

fn printable(c: u8) -> bool {
    c > 32 && c < 127
}

fn field(value: str, limit: i64) -> str {
    if value.len == 0 {
        return "-"
    }
    var out: u8[] = []
    for i in 0..value.len {
        if out.len == limit {
            break
        }
        let c = value[i]
        let kept: u8 = if printable(c) { c } else { '_' }
        out.push(kept)
    }
    __str_view(out)
}

fn sd_name(value: str) -> str {
    var out: u8[] = []
    for i in 0..value.len {
        if out.len == 32 {
            break
        }
        let c = value[i]
        let kept: u8 = if printable(c) && c != '=' && c != ']' && c != '"' { c } else { '_' }
        out.push(kept)
    }
    if out.len == 0 {
        return "_"
    }
    __str_view(out)
}

fn append_escaped(mut out: u8[], value: str) {
    let clean = unicode.utf8_to_valid(value)
    for i in 0..clean.len {
        let c = clean[i]
        if c == '"' || c == '\\' || c == ']' {
            out.push('\\')
        }
        out.push(c)
    }
}

fn append_data(mut out: u8[], data: Element[]) {
    if data.len == 0 {
        out.push('-')
        return
    }
    for e in data {
        text.append(mut out, "[{sd_name(e.id)}")
        for p in e.params {
            text.append(mut out, " {sd_name(p.name)}=\"")
            append_escaped(mut out, p.value)
            out.push('"')
        }
        out.push(']')
    }
}

fn micros_text(micros: i64) -> str {
    if micros == 0 {
        return ""
    }
    var digits = text.pad_left("{micros}", 6, '0')
    for digits[digits.len - 1] == '0' {
        digits = digits[..digits.len - 1]
    }
    ".{digits}"
}

fn rfc3339(nanos: i64) -> str {
    let ts = timestamp.from_unix_nanos(nanos)
    let dt = datetime.from_civil_seconds(timestamp.unix_seconds(ts), 0) or return "-"
    let micros = timestamp.subsec_nanos(ts) / 1000
    let fraction = micros_text(micros)
    let date = "{text.pad_left("{datetime.year(dt)}", 4, '0')}-{text.pad_left("{datetime.month_number(dt)}", 2, '0')}-{text.pad_left("{datetime.day(dt)}", 2, '0')}"
    let clock = "{text.pad_left("{datetime.hour(dt)}", 2, '0')}:{text.pad_left("{datetime.minute(dt)}", 2, '0')}:{text.pad_left("{datetime.second(dt)}", 2, '0')}"
    "{date}T{clock}{fraction}Z"
}

/// Returns the RFC 5424 text of `m`: `<PRI>1 TIMESTAMP HOSTNAME APP-NAME PROCID MSGID STRUCTURED-DATA[ MSG]`.
///
/// The header fields are written as `Message` describes, so the result always follows the grammar. The MSG is written as given, after the byte order mark when `bom` is set.
pub fn format(m: Message) -> u8[] {
    var out: u8[] = []
    let priority = m.facility.index * 8 + m.severity.index
    let stamp = match m.timestamp {
        some(t) => rfc3339(t)
        none => "-"
    }
    text.append(mut out, "<{priority}>1 {stamp} {field(m.hostname, 255)} {field(m.app_name, 48)} {field(m.procid, 128)} {field(m.msgid, 32)} ")
    append_data(mut out, m.data)
    if m.text.len > 0 {
        out.push(' ')
        if m.bom {
            append_bom(mut out)
        }
        text.append(mut out, m.text)
    }
    out
}

fn append_bom(mut out: u8[]) {
    out.push(0xEF)
    out.push(0xBB)
    out.push(0xBF)
}

/// Returns the severity that `level` maps to: `Debug` to `Debug`, `Info` to `Info`, `Warn` to `Warning` and `Error` to `Error`.
pub fn severity_of(level: log.Level) -> Severity {
    match level {
        Debug => Debug
        Info => Info
        Warn => Warning
        Error => Error
    }
}

fn attr_param(a: log.Attr) -> Param {
    match a {
        Str(key, value) => Param { name: key, value }
        Int(key, value) => Param { name: key, value: "{value}" }
        Float(key, value) => Param { name: key, value: "{value}" }
        Bool(key, value) => Param { name: key, value: "{value}" }
    }
}

fn ascii(s: str) -> bool {
    for i in 0..s.len {
        if s[i] >= 0x80 {
            return false
        }
    }
    true
}

fn host_name() -> str {
    os.hostname() or "-"
}

/// Returns the message that `config` makes of `r`.
///
/// The severity comes from `severity_of`, the timestamp from the record, and the facility, host name, application name, process id and message id from `config`; an empty host name is the system's and an empty process id is the process's. The text is the record's message, after `prefix: ` when the record has a prefix, and carries the byte order mark when it holds non-ASCII text that is valid UTF-8. The record's attributes become one structured data element named `config.sd_id`, in order.
pub fn message(config: Config, r: log.Record) -> Message {
    var params: Param[] = []
    for a in r.attrs {
        params.push(attr_param(a))
    }
    var data: Element[] = []
    if params.len > 0 {
        data.push(Element { id: config.sd_id, params })
    }
    let body = if r.prefix.len > 0 { "{r.prefix}: {r.message}" } else { r.message }
    Message {
        facility: config.facility
        severity: severity_of(r.level)
        timestamp: r.time
        hostname: if config.hostname.len > 0 { config.hostname } else { host_name() }
        app_name: config.app_name
        procid: if config.procid.len > 0 { config.procid } else { "{os.pid()}" }
        msgid: config.msgid
        data
        text: body
        bom: !ascii(body) && unicode.utf8_valid(body)
    }
}
