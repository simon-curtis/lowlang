import std/io
import std/log
import std/log/syslog
import std/net

fn receive_text(s: net.Socket) -> str {
    let buf = io.buffer(2048)
    let p = net.receive_from(s, buf) or return "receive failed"
    str(buf[..p.size])
}

/// Sends log records to a syslog collector over UDP and prints the RFC 5424 messages it receives.
fn main() ! io.Error {
    using collector = net.bind_udp("127.0.0.1", 0)?
    net.set_receive_timeout(collector, 2000)

    let config = syslog.Config {
        transport: syslog.Transport.Udp("127.0.0.1", collector.handle.addr.port)
        facility: Local4
        hostname: "web-1"
        app_name: "checkout"
        procid: "4021"
        msgid: "ORDER"
    }
    using sender = syslog.open(config)
    let clock = fn() -> i64 { 1065910455003000000 }
    let base = log.Logger { level: Debug, prefix: "orders", timestamps: true, clock }
    let logger = syslog.attach(base, sender)

    log.info_with(logger, "order placed", [log.int_attr("id", 1042), log.str_attr("customer", "o'brien")])
    print(receive_text(collector))
    log.error(logger, "payment declined")
    print(receive_text(collector))
    log.warn_with(logger, "stock low", [log.str_attr("sku", "a]b")])
    print(receive_text(collector))
}
