import std/io
import std/log
import std/text

/// One field of a journal entry: an upper-case name and a value that can hold any bytes.
pub struct Field {
    /// The field name: 1 to 64 bytes of `A` to `Z`, `0` to `9` and `_`, not starting with `_` or a digit.
    pub name: str
    /// The field value. A value with a newline is written in the binary form of the native protocol, so it may also hold NUL and any other byte.
    pub value: str
}

/// Returns whether `name` is a valid journal field name: 1 to 64 bytes of `A` to `Z`, `0` to `9` and `_`, not starting with `_` or a digit.
pub fn valid_name(name: str) -> bool {
    if name.len == 0 || name.len > 64 {
        return false
    }
    let first = name[0]
    if first == '_' || first >= '0' && first <= '9' {
        return false
    }
    for i in 0..name.len {
        let c = name[i]
        if !(c >= 'A' && c <= 'Z') && !(c >= '0' && c <= '9') && c != '_' {
            return false
        }
    }
    true
}

fn has_newline(value: str) -> bool {
    text.index_byte(value, '\n') >= 0
}

fn append_field(mut out: u8[], f: Field) {
    text.append(mut out, f.name)
    if has_newline(f.value) {
        out.push('\n')
        io.put_le64(mut out, f.value.len)
        text.append(mut out, f.value)
        out.push('\n')
        return
    }
    out.push('=')
    text.append(mut out, f.value)
    out.push('\n')
}

/// Returns the payload of a datagram for the journal's native protocol (systemd's `JOURNAL_NATIVE_PROTOCOL`) carrying `fields`.
///
/// A field whose value has no newline is written as `NAME=value` and a newline. A field whose value has a newline is written as the name, a newline, the length of the value as a 64-bit little-endian integer, the value and a newline. A field whose name is not valid is left out.
pub fn encode(fields: Field[]) -> u8[] {
    var out: u8[] = []
    for f in fields {
        if valid_name(f.name) {
            append_field(mut out, f)
        }
    }
    out
}

/// Returns the journal priority that `level` maps to, which is the syslog severity: `Debug` is 7, `Info` 6, `Warn` 4 and `Error` 3.
pub fn priority_of(level: log.Level) -> i64 {
    match level {
        Debug => 7
        Info => 6
        Warn => 4
        Error => 3
    }
}

fn reserved(name: str) -> bool {
    name == "PRIORITY" || name == "MESSAGE" || name == "SYSLOG_IDENTIFIER"
}

/// Returns the field name for the attribute key `key`: the key in upper case with each byte outside `A` to `Z`, `0` to `9` and `_` turned into `_`, cut to 64 bytes, after leading `_` and digit bytes are removed.
///
/// Returns `none` when nothing remains or the name is `PRIORITY`, `MESSAGE` or `SYSLOG_IDENTIFIER`, which the destination sets itself.
pub fn field_name(key: str) -> str? {
    var out: u8[] = []
    let upper = text.upper(key)
    for i in 0..upper.len {
        let c = upper[i]
        let kept: u8 = if c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' { c } else { '_' }
        if out.len == 0 && (kept == '_' || kept >= '0' && kept <= '9') {
            continue
        }
        if out.len == 64 {
            break
        }
        out.push(kept)
    }
    let name = str(out)
    if name.len == 0 || reserved(name) {
        return none
    }
    some(name)
}

fn attr_field(a: log.Attr) -> Field? {
    match a {
        Str(key, value) => named(key, value)
        Int(key, value) => named(key, "{value}")
        Float(key, value) => named(key, "{value}")
        Bool(key, value) => named(key, "{value}")
    }
}

fn named(key: str, value: str) -> Field? {
    let name = field_name(key) ?? return none
    some(Field { name, value })
}

/// Returns the fields for the record `r`: `PRIORITY` from `priority_of`, `MESSAGE`, `SYSLOG_IDENTIFIER` when `identifier` is not empty, and one field for each attribute named by `field_name`, in order.
///
/// The message is the record's message, after `prefix: ` when the record has a prefix. An attribute `code_file` or `code_line` becomes `CODE_FILE` or `CODE_LINE`, which the journal shows as the source location.
pub fn fields(identifier: str, r: log.Record) -> Field[] {
    var out: Field[] = []
    out.push(Field { name: "PRIORITY", value: "{priority_of(r.level)}" })
    let body = if r.prefix.len > 0 { "{r.prefix}: {r.message}" } else { r.message }
    out.push(Field { name: "MESSAGE", value: body })
    if identifier.len > 0 {
        out.push(Field { name: "SYSLOG_IDENTIFIER", value: identifier })
    }
    for a in r.attrs {
        match attr_field(a) {
            some(f) => out.push(f)
            none => {}
        }
    }
    out
}
