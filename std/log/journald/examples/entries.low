import std/file
import std/io
import std/log
import std/log/journald
import std/net
import std/text

fn receive_text(s: net.Socket) -> str {
    let buf = io.buffer(2048)
    let p = net.receive_from(s, buf) or return "receive failed"
    text.quote(str(buf[..p.size]))
}

/// Sends log records to a journal socket and prints the datagrams it receives, which a real journal reads from `/run/systemd/journal/socket`.
fn main() ! io.Error {
    let dir = file.temp_dir("lowjournal")?
    defer file.remove_all(dir) or {}
    let path = "{dir}/journal.sock"
    using journal_socket = net.bind_unix_datagram(path)?
    net.set_receive_timeout(journal_socket, 2000)

    using journal = journald.open(journald.Config { path, identifier: "checkout" })
    let logger = journald.attach(log.Logger { level: Debug, prefix: "orders" }, journal)

    log.info_with(logger, "order placed", [log.int_attr("order_id", 1042), log.str_attr("code_file", "orders.low")])
    print(receive_text(journal_socket))
    log.error(logger, "payment failed\nretrying")
    print(receive_text(journal_socket))

    let fields = [journald.Field { name: "MESSAGE", value: "started" }, journald.Field { name: "PRIORITY", value: "6" }, journald.Field { name: "lower", value: "left out" }]
    journald.send(journal, fields)?
    print(receive_text(journal_socket))
}
