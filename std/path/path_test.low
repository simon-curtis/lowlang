import std/testing
import std/text

struct PathCase {
    input: str
    want: str
}

struct JoinCase {
    parts: []str
    want: str
}

struct MatchCase {
    pattern: str
    name: str
    want: bool
}

struct AbsoluteCase {
    input: str
    want: bool
}

fn path_case_name(c: PathCase) -> str {
    text.quote(c.input)
}

fn join_case_name(c: JoinCase) -> str {
    text.quote(text.join(c.parts, "|"))
}

fn match_case_name(c: MatchCase) -> str {
    "{text.quote(c.pattern)} {text.quote(c.name)}"
}

fn absolute_case_name(c: AbsoluteCase) -> str {
    text.quote(c.input)
}

fn test_is_absolute(t: *testing.T) {
    let cases = [
        AbsoluteCase { input: "", want: false }
        AbsoluteCase { input: "/", want: true }
        AbsoluteCase { input: "//", want: true }
        AbsoluteCase { input: "/a", want: true }
        AbsoluteCase { input: "a", want: false }
        AbsoluteCase { input: "./a", want: false }
        AbsoluteCase { input: "../a", want: false }
        AbsoluteCase { input: " /a", want: false }
    ]
    t.table_of(cases, absolute_case_name, fn(st, c) {
        st.equal(is_absolute(c.input), c.want)
    })
}

fn test_clean(t: *testing.T) {
    let cases = [
        PathCase { input: "", want: "." }
        PathCase { input: ".", want: "." }
        PathCase { input: "./", want: "." }
        PathCase { input: "..", want: ".." }
        PathCase { input: "/", want: "/" }
        PathCase { input: "//", want: "/" }
        PathCase { input: "/./", want: "/" }
        PathCase { input: "a", want: "a" }
        PathCase { input: "a/", want: "a" }
        PathCase { input: "a//", want: "a" }
        PathCase { input: "./a", want: "a" }
        PathCase { input: "a//b", want: "a/b" }
        PathCase { input: "a/./b", want: "a/b" }
        PathCase { input: "a/b/", want: "a/b" }
        PathCase { input: "a/../b", want: "b" }
        PathCase { input: "a/..", want: "." }
        PathCase { input: "a/b/../../c", want: "c" }
        PathCase { input: "a/b/../..", want: "." }
        PathCase { input: "../a", want: "../a" }
        PathCase { input: "../..", want: "../.." }
        PathCase { input: "../../a", want: "../../a" }
        PathCase { input: "a/../..", want: ".." }
        PathCase { input: "a/../../b", want: "../b" }
        PathCase { input: "../a/..", want: ".." }
        PathCase { input: "/..", want: "/" }
        PathCase { input: "/../a", want: "/a" }
        PathCase { input: "/a/../..", want: "/" }
        PathCase { input: "/a/b", want: "/a/b" }
        PathCase { input: "/a//b/./c/", want: "/a/b/c" }
        PathCase { input: "...", want: "..." }
        PathCase { input: "a/.../..", want: "a" }
        PathCase { input: ".hidden", want: ".hidden" }
    ]
    t.table_of(cases, path_case_name, fn(st, c) {
        st.equal(clean(c.input), c.want)
    })
}

fn test_clean_is_idempotent(t: *testing.T) {
    let inputs = ["", "a//b/../c/", "../../a/./b", "/../a/", "//x/./y//", "a/b/c/../../.."]
    for input in inputs {
        let once = clean(input)
        t.equal(clean(once), once)
    }
}

fn test_join(t: *testing.T) {
    let cases = [
        JoinCase { parts: [], want: "" }
        JoinCase { parts: ["", ""], want: "" }
        JoinCase { parts: ["a"], want: "a" }
        JoinCase { parts: ["a", "b"], want: "a/b" }
        JoinCase { parts: ["a", "", "b"], want: "a/b" }
        JoinCase { parts: ["", "a"], want: "a" }
        JoinCase { parts: ["a", ""], want: "a" }
        JoinCase { parts: ["a", "/b"], want: "a/b" }
        JoinCase { parts: ["/a", "b"], want: "/a/b" }
        JoinCase { parts: ["a/", "/b"], want: "a/b" }
        JoinCase { parts: ["a", "b/"], want: "a/b" }
        JoinCase { parts: ["a", "."], want: "a" }
        JoinCase { parts: ["."], want: "." }
        JoinCase { parts: ["/"], want: "/" }
        JoinCase { parts: ["/", "a"], want: "/a" }
        JoinCase { parts: ["a", "..", "b"], want: "b" }
        JoinCase { parts: ["a/b", "../c"], want: "a/c" }
        JoinCase { parts: ["..", "a"], want: "../a" }
        JoinCase { parts: ["a", "b", "c", "d"], want: "a/b/c/d" }
        JoinCase { parts: ["/", ".."], want: "/" }
    ]
    t.table_of(cases, join_case_name, fn(st, c) {
        st.equal(join(c.parts), c.want)
    })
}

fn test_base(t: *testing.T) {
    let cases = [
        PathCase { input: "", want: "." }
        PathCase { input: "/", want: "/" }
        PathCase { input: "///", want: "/" }
        PathCase { input: ".", want: "." }
        PathCase { input: "..", want: ".." }
        PathCase { input: "a", want: "a" }
        PathCase { input: "a/", want: "a" }
        PathCase { input: "a//", want: "a" }
        PathCase { input: "/a", want: "a" }
        PathCase { input: "a/b", want: "b" }
        PathCase { input: "a/b/", want: "b" }
        PathCase { input: "a//b", want: "b" }
        PathCase { input: "/a/b//", want: "b" }
        PathCase { input: "a/b.c", want: "b.c" }
        PathCase { input: "../a", want: "a" }
    ]
    t.table_of(cases, path_case_name, fn(st, c) {
        st.equal(base(c.input), c.want)
    })
}

fn test_dir(t: *testing.T) {
    let cases = [
        PathCase { input: "", want: "." }
        PathCase { input: "a", want: "." }
        PathCase { input: ".", want: "." }
        PathCase { input: "..", want: "." }
        PathCase { input: "/", want: "/" }
        PathCase { input: "//", want: "/" }
        PathCase { input: "/a", want: "/" }
        PathCase { input: "//a", want: "/" }
        PathCase { input: "a/b", want: "a" }
        PathCase { input: "a//b", want: "a" }
        PathCase { input: "a/./b", want: "a" }
        PathCase { input: "a/b/c", want: "a/b" }
        PathCase { input: "/a/b", want: "/a" }
        PathCase { input: "./a", want: "." }
        PathCase { input: "../a", want: ".." }
        PathCase { input: "a/../b", want: "." }
    ]
    t.table_of(cases, path_case_name, fn(st, c) {
        st.equal(dir(c.input), c.want)
    })
}

fn test_ext(t: *testing.T) {
    let cases = [
        PathCase { input: "", want: "" }
        PathCase { input: "a", want: "" }
        PathCase { input: "a.low", want: ".low" }
        PathCase { input: "a.tar.gz", want: ".gz" }
        PathCase { input: ".profile", want: ".profile" }
        PathCase { input: "a.", want: "." }
        PathCase { input: "dir/a.low", want: ".low" }
        PathCase { input: "dir.d/a", want: "" }
        PathCase { input: "dir.d/", want: "" }
        PathCase { input: "a.low/", want: "" }
        PathCase { input: "/", want: "" }
        PathCase { input: "/a.b/c", want: "" }
        PathCase { input: "a/.hidden", want: ".hidden" }
    ]
    t.table_of(cases, path_case_name, fn(st, c) {
        st.equal(ext(c.input), c.want)
    })
}

fn test_stem(t: *testing.T) {
    let cases = [
        PathCase { input: "a", want: "a" }
        PathCase { input: "a.low", want: "a" }
        PathCase { input: "a.tar.gz", want: "a.tar" }
        PathCase { input: "dir/a.low", want: "a" }
        PathCase { input: "dir.d/a", want: "a" }
        PathCase { input: "dir.d/a.low", want: "a" }
        PathCase { input: ".profile", want: "" }
        PathCase { input: "a/", want: "a" }
        PathCase { input: "a.low/", want: "a" }
        PathCase { input: "a.", want: "a" }
    ]
    t.table_of(cases, path_case_name, fn(st, c) {
        st.equal(stem(c.input), c.want)
    })
}

fn test_base_and_dir_recompose(t: *testing.T) {
    let inputs = ["a/b", "/a/b", "a/b/c.low", "/a", "a"]
    for input in inputs {
        let rebuilt = join([dir(input), base(input)])
        t.equal(rebuilt, clean(input))
    }
}

fn test_matches(t: *testing.T) {
    let cases = [
        MatchCase { pattern: "", name: "", want: true }
        MatchCase { pattern: "", name: "a", want: false }
        MatchCase { pattern: "a", name: "", want: false }
        MatchCase { pattern: "a", name: "a", want: true }
        MatchCase { pattern: "a", name: "b", want: false }
        MatchCase { pattern: "a", name: "ab", want: false }
        MatchCase { pattern: "ab", name: "a", want: false }
        MatchCase { pattern: "*", name: "", want: true }
        MatchCase { pattern: "*", name: "abc", want: true }
        MatchCase { pattern: "*", name: ".hidden", want: true }
        MatchCase { pattern: "*", name: "a/b", want: false }
        MatchCase { pattern: "**", name: "ab", want: true }
        MatchCase { pattern: "a*", name: "a", want: true }
        MatchCase { pattern: "a*", name: "abc", want: true }
        MatchCase { pattern: "a*", name: "ba", want: false }
        MatchCase { pattern: "*c", name: "abc", want: true }
        MatchCase { pattern: "*c", name: "abd", want: false }
        MatchCase { pattern: "a*c", name: "ac", want: true }
        MatchCase { pattern: "a*c", name: "abbbc", want: true }
        MatchCase { pattern: "a*c", name: "abd", want: false }
        MatchCase { pattern: "*a*", name: "bab", want: true }
        MatchCase { pattern: "*ab", name: "aab", want: true }
        MatchCase { pattern: "*ab", name: "aabx", want: false }
        MatchCase { pattern: "a*a*a", name: "aaaa", want: true }
        MatchCase { pattern: "a*b", name: "a/b", want: false }
        MatchCase { pattern: "*.low", name: "x.low", want: true }
        MatchCase { pattern: "*.low", name: ".low", want: true }
        MatchCase { pattern: "*.low", name: "x.lowx", want: false }
        MatchCase { pattern: "?", name: "a", want: true }
        MatchCase { pattern: "?", name: "", want: false }
        MatchCase { pattern: "?", name: "ab", want: false }
        MatchCase { pattern: "?", name: "/", want: false }
        MatchCase { pattern: "a?c", name: "abc", want: true }
        MatchCase { pattern: "a?c", name: "ac", want: false }
        MatchCase { pattern: "[abc]", name: "b", want: true }
        MatchCase { pattern: "[abc]", name: "d", want: false }
        MatchCase { pattern: "[a-c]", name: "b", want: true }
        MatchCase { pattern: "[a-c]", name: "d", want: false }
        MatchCase { pattern: "[a-cx-z]", name: "y", want: true }
        MatchCase { pattern: "[!a-c]", name: "d", want: true }
        MatchCase { pattern: "[!a-c]", name: "b", want: false }
        MatchCase { pattern: "[^a]", name: "a", want: false }
        MatchCase { pattern: "[^a]", name: "b", want: true }
        MatchCase { pattern: "[]a]", name: "]", want: true }
        MatchCase { pattern: "[]a]", name: "a", want: true }
        MatchCase { pattern: "[]a]", name: "b", want: false }
        MatchCase { pattern: "[a", name: "a", want: false }
        MatchCase { pattern: "a[", name: "a", want: false }
        MatchCase { pattern: "[/]", name: "/", want: false }
        MatchCase { pattern: "\\*", name: "*", want: true }
        MatchCase { pattern: "\\*", name: "a", want: false }
        MatchCase { pattern: "\\?", name: "?", want: true }
        MatchCase { pattern: "\\[a]", name: "[a]", want: true }
        MatchCase { pattern: "a/b", name: "a/b", want: true }
        MatchCase { pattern: "a/b", name: "a/c", want: false }
        MatchCase { pattern: "a/*", name: "a/b", want: true }
        MatchCase { pattern: "a/*", name: "a/b/c", want: false }
        MatchCase { pattern: "*/b", name: "a/b", want: true }
        MatchCase { pattern: "*/*", name: "a/b", want: true }
        MatchCase { pattern: "a*b/c", name: "axxb/c", want: true }
        MatchCase { pattern: "a/b", name: "ab", want: false }
    ]
    t.table_of(cases, match_case_name, fn(st, c) {
        st.equal(matches(c.pattern, c.name), c.want)
    })
}
