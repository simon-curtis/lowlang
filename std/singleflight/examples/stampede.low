import std/atomic
import std/singleflight
import std/sync
import std/time/clock
import std/time/duration
import std/time/timestamp

struct Profile {
    user: str
    plan: str
}

fn load_profile(g: singleflight.Group[str, Profile], user: str, queries: atomic.Int, waiting: i64) -> Profile {
    queries.add_int(1)
    for g.followers(user) < waiting {
        sleep(1)
    }
    Profile { user, plan: "team" }
}

fn request(g: singleflight.Group[str, Profile], user: str, queries: atomic.Int, waiting: i64, shared: atomic.Int, group: sync.WaitGroup) {
    let result = g.do_shared(user, fn() -> Profile { load_profile(g, user, queries, waiting) })
    if result.shared {
        shared.add_int(1)
    }
    group.done()
}

/// Ten requests for one profile share a single database query, and an expiring value refreshes only once its time to live passes.
fn main() {
    let g = singleflight.group[str, Profile]()
    let queries = atomic.int(0)
    let shared = atomic.int(0)
    let group = sync.wait_group()
    for i in 0..10 {
        group.add(1)
        spawn request(g, "ada", queries, 9, shared, group)
    }
    group.wait()
    print("10 requests ran {queries.load_int()} query, {shared.load_int()} callers saw a shared result, {g.pending()} in flight")

    let again = g.do("ada", fn() -> Profile { load_profile(g, "ada", queries, 0) })
    print("a later request ran a new query: {queries.load_int()} total, plan {again.plan}")

    let time = clock.manual(timestamp.epoch())
    let refreshes = atomic.int(0)
    let rates = singleflight.expiring(duration.seconds(30), time.clock(), fn() -> i64 {
        refreshes.add_int(1)
    })
    print("first fetch {rates.fetch()}, cached {rates.cached() ?? 0}")
    time.advance(duration.seconds(29))
    print("after 29 s fetch {rates.fetch()}")
    time.advance(duration.seconds(2))
    print("after 31 s cached {rates.cached() ?? -1}, fetch {rates.fetch()}")
    rates.invalidate()
    print("invalidated cached {rates.cached() ?? -1}, fetch {rates.fetch()}, refreshes {rates.refresh_count()}")
}
