import std/os
import std/path
import std/text

/// One `key = value` line of a configuration file.
pub struct Setting {
    /// The key as `section.name` or `section.subsection.name`, with the section and the name in lower case and the subsection as written.
    pub key: str
    /// The value with quotes and escapes removed; `true` for a key written without `=`.
    pub value: str
}

/// The settings of one or more configuration files, in the order Git reads them, so a later setting overrides an earlier one.
pub struct Config {
    /// Every setting in reading order.
    pub settings: Setting[]
}

/// Returns the last value of `key`, or `none` when no file sets it.
///
/// The section and the name of `key` are compared without regard to case and the subsection exactly.
pub fn get(c: Config, key: str) -> str? {
    let want = normal_key(key)
    var found: str? = none
    for s in c.settings {
        if s.key == want {
            found = some(s.value)
        }
    }
    found
}

/// Returns every value of `key` in reading order.
pub fn get_all(c: Config, key: str) -> str[] {
    let want = normal_key(key)
    var found: str[] = []
    for s in c.settings {
        if s.key == want {
            found.push(s.value)
        }
    }
    found
}

/// Returns `key` with its section and name in lower case and its subsection as written.
pub fn normal_key(key: str) -> str {
    let first = text.index_byte(key, '.')
    let last = text.last_index_byte(key, '.')
    if first < 0 {
        return text.lower(key)
    }
    "{text.lower(key[..first])}{key[first..last]}{text.lower(key[last..])}"
}

/// Parses the text of a configuration file. `origin` names it in errors and is the directory that a relative `include.path` is read from.
///
/// `include.path` files are read in place, up to ten deep, and a missing one is skipped as Git does. `includeIf` sections are ignored.
/// Fails with `Malformed` for a line that is neither a section header, a setting, a comment nor blank.
pub fn parse_config(source: str, origin: str) -> Config ! Error {
    var settings: Setting[] = []
    parse_into(source, origin, 0, mut settings)?
    Config { settings }
}

struct ConfigParser {
    src: str
    at: i64
    origin: str
    line: i64
}

fn parse_into(source: str, origin: str, depth: i64, mut out: Setting[]) ! Error {
    let p = new(ConfigParser { src: source, at: 0, origin, line: 1 })
    var section = ""
    for p.at < p.src.len {
        p.skip_blank()
        if p.at >= p.src.len {
            break
        }
        let c = p.src[p.at]
        if c == '\n' {
            p.at += 1
            p.line += 1
            continue
        }
        if c == '#' || c == ';' {
            p.skip_line()
            continue
        }
        if c == '[' {
            section = p.header()?
            continue
        }
        if section == "" {
            fail p.bad()
        }
        let s = p.setting(section)?
        out.push(s)
        if s.key == "include.path" && depth < 10 {
            include(s.value, origin, depth, mut out)?
        }
    }
}

fn include(value: str, origin: str, depth: i64, mut out: Setting[]) ! Error {
    var location = expand_home(value)
    if !path.is_absolute(location) {
        location = path.join([path.dir(origin), location])
    }
    let data = read_optional(location)? ?? return
    parse_into(str(data), location, depth + 1, mut out)?
}

fn expand_home(value: str) -> str {
    let rest = text.strip_prefix(value, "~/") ?? return value
    path.join([home(), rest])
}

fn home() -> str {
    os.env("HOME") ?? os.home_dir() ?? ""
}

fn bad(p: *ConfigParser) -> Error {
    Malformed("configuration {p.origin} line {p.line}")
}

fn skip_blank(p: *ConfigParser) {
    for p.at < p.src.len && (p.src[p.at] == ' ' || p.src[p.at] == '\t' || p.src[p.at] == '\r') {
        p.at += 1
    }
}

fn skip_line(p: *ConfigParser) {
    for p.at < p.src.len && p.src[p.at] != '\n' {
        p.at += 1
    }
}

fn name_byte(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '.' || c == '_'
}

fn header(p: *ConfigParser) -> str ! Error {
    p.at += 1
    let start = p.at
    for p.at < p.src.len && name_byte(p.src[p.at]) {
        p.at += 1
    }
    let name = p.src[start..p.at]
    if name.len == 0 {
        fail p.bad()
    }
    var section = text.lower(name)
    p.skip_blank()
    if p.at < p.src.len && p.src[p.at] == '"' {
        p.at += 1
        var sub: u8[] = []
        for {
            if p.at >= p.src.len || p.src[p.at] == '\n' {
                fail p.bad()
            }
            let c = p.src[p.at]
            p.at += 1
            if c == '"' {
                break
            }
            if c == '\\' && p.at < p.src.len {
                sub.push(p.src[p.at])
                p.at += 1
                continue
            }
            sub.push(c)
        }
        section = "{section}.{str(sub)}"
    }
    if p.at >= p.src.len || p.src[p.at] != ']' {
        fail p.bad()
    }
    p.at += 1
    section
}

fn setting(p: *ConfigParser, section: str) -> Setting ! Error {
    let start = p.at
    for p.at < p.src.len && (name_byte(p.src[p.at]) && p.src[p.at] != '.') {
        p.at += 1
    }
    let name = p.src[start..p.at]
    if name.len == 0 {
        fail p.bad()
    }
    let key = "{section}.{text.lower(name)}"
    p.skip_blank()
    if p.at >= p.src.len || p.src[p.at] == '\n' || p.src[p.at] == '#' || p.src[p.at] == ';' {
        p.skip_line()
        return Setting { key, value: "true" }
    }
    if p.src[p.at] != '=' {
        fail p.bad()
    }
    p.at += 1
    p.skip_blank()
    Setting { key, value: p.value()? }
}

fn value(p: *ConfigParser) -> str ! Error {
    var out: u8[] = []
    var quoted = false
    var kept = 0
    for p.at < p.src.len {
        let c = p.src[p.at]
        if c == '\n' {
            if quoted {
                fail p.bad()
            }
            break
        }
        p.at += 1
        if !quoted && (c == '#' || c == ';') {
            p.skip_line()
            break
        }
        if c == '"' {
            quoted = !quoted
            kept = out.len
            continue
        }
        if c == '\\' {
            if p.at >= p.src.len {
                fail p.bad()
            }
            let e = p.src[p.at]
            p.at += 1
            match e {
                '\n' => {
                    p.line += 1
                    continue
                }
                'n' => out.push('\n')
                't' => out.push('\t')
                'b' => {
                    if out.len > 0 {
                        out.pop()
                    }
                }
                '"' => out.push('"')
                '\\' => out.push('\\')
                '\r' => {
                    if p.at < p.src.len && p.src[p.at] == '\n' {
                        p.at += 1
                        p.line += 1
                        continue
                    }
                    fail p.bad()
                }
                _ => fail p.bad()
            }
            kept = out.len
            continue
        }
        out.push(c)
        if quoted || (c != ' ' && c != '\t' && c != '\r') {
            kept = out.len
        }
    }
    if quoted {
        fail p.bad()
    }
    str(out[..kept])
}

fn read_config_file(location: str, mut out: Setting[]) ! Error {
    let data = read_optional(location)? ?? return
    parse_into(str(data), location, 0, mut out)?
}

/// Returns the settings of the system, global and command line levels that every repository on this machine starts from.
///
/// The system file is `GIT_CONFIG_SYSTEM`, or `/etc/gitconfig`, and is skipped when `GIT_CONFIG_NOSYSTEM` is set. The global files are `GIT_CONFIG_GLOBAL` when it is set, and otherwise `git/config` under `XDG_CONFIG_HOME` (or `~/.config`) followed by `~/.gitconfig`. The command line level is the `GIT_CONFIG_COUNT`, `GIT_CONFIG_KEY_<n>` and `GIT_CONFIG_VALUE_<n>` variables, which come last.
/// Fails with `Malformed` when a file does not parse and with `Io` when one exists but cannot be read.
pub fn user_config() -> Config ! Error {
    layered("")
}

fn layered(local: str) -> Config ! Error {
    var settings: Setting[] = []
    if os.env("GIT_CONFIG_NOSYSTEM") == none {
        read_config_file(os.env("GIT_CONFIG_SYSTEM") ?? "/etc/gitconfig", mut settings)?
    }
    match os.env("GIT_CONFIG_GLOBAL") {
        some(global) => {
            if global != "" && global != "/dev/null" {
                read_config_file(global, mut settings)?
            }
        }
        none => {
            let xdg = os.env("XDG_CONFIG_HOME") ?? path.join([home(), ".config"])
            read_config_file(path.join([xdg, "git", "config"]), mut settings)?
            read_config_file(path.join([home(), ".gitconfig"]), mut settings)?
        }
    }
    if local != "" {
        read_config_file(local, mut settings)?
    }
    environment_settings(mut settings)?
    Config { settings }
}

fn environment_settings(mut out: Setting[]) ! Error {
    let counted = os.env("GIT_CONFIG_COUNT") ?? return
    let count = text.parse_int(counted) or fail Malformed("GIT_CONFIG_COUNT {counted}")
    for i in 0..count {
        let key = os.env("GIT_CONFIG_KEY_{i}") ?? fail Malformed("GIT_CONFIG_KEY_{i}, which is missing")
        let value = os.env("GIT_CONFIG_VALUE_{i}") ?? fail Malformed("GIT_CONFIG_VALUE_{i}, which is missing")
        out.push(Setting { key: normal_key(key), value })
    }
}
