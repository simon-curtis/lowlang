import std/file
import std/git
import std/text

fn scratch() -> str ! git.Error {
    file.temp_dir("git-history-") catch {
        e => fail Io("a temporary directory", e)
    }
}

fn commit_notes(r: *git.Repository, who: git.Signature, notes: str[]) -> str ! git.Error {
    var parents: str[] = []
    for i, body in notes {
        let blob = git.write_object(r, Blob, bytes(body))?
        let tree = git.write_tree(r, [git.TreeEntry { name: "notes.txt", mode: File, id: blob }])?
        let commit = git.write_commit(r, git.Commit { tree, parents, author: who, committer: who, message: "note {i + 1}\n" })?
        parents = [commit]
    }
    git.set_ref(r, "refs/heads/main", parents[0])?
    parents[0]
}

/// Writes two commits and an annotated tag into a new repository, lists its references, walks the history and exports the tagged tree.
fn main() ! git.Error {
    let dir = scratch()?
    defer file.remove_all(dir) or {}
    let r = git.init("{dir}/notes.git", true)?
    let who = git.Signature { name: "Ada", email: "ada@example.com", time: 1700000000 }
    let head = commit_notes(r, who, ["first\n", "second\n"])?
    let first = git.read_commit(r, head)?.parents[0]
    let tag = git.write_tag(r, git.TagInfo { object: first, kind: Commit, name: "v1.0.0", tagger: who, message: "first release\n" })?
    git.set_ref(r, "refs/tags/v1.0.0", tag)?

    for ref in git.refs(r, "refs/")? {
        let peeled = if ref.peeled == "" { "" } else { " -> {ref.peeled[..7]}" }
        print("{ref.name} {ref.id[..7]}{peeled}")
    }
    var at = git.resolve(r, "main")?
    for at != "" {
        let c = git.read_commit(r, at)?
        print("{at[..7]} {text.trim(c.message)}")
        at = if c.parents.len == 0 { "" } else { c.parents[0] }
    }
    git.export(r, "v1.0.0", "{dir}/out")?
    let exported = file.read_text("{dir}/out/notes.txt") catch {
        e => fail Io("{dir}/out/notes.txt", e)
    }
    print("v1.0.0 notes.txt: {text.trim(exported)}")
}
