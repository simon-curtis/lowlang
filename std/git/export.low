import std/archive
import std/path
import std/text

/// One path of a tree as `export` writes it.
pub struct ExportEntry {
    /// The path below the export root, with `/` between components.
    pub path: str
    /// The type: a directory, a file, an executable file, a symbolic link or a submodule, which is exported as an empty directory.
    pub mode: Mode
    /// The id of the tree, blob or submodule commit.
    pub id: str
}

/// Returns the paths `export` writes for `rev` in `r`, directories before their contents, in tree order.
///
/// The `.gitattributes` files of the tree apply as `git archive` applies them: a path with `export-ignore` set is left out, with everything below it. A path that sets `export-subst`, `ident`, `working-tree-encoding` or `eol=crlf` fails with `Unsupported`, because `git archive` would rewrite its bytes. Attributes from the user's or the repository's own attribute files are not read.
/// Fails with `Malformed` for a tree entry named `.git` in any letter case, and as `read_tree` does.
pub fn export_entries(r: *Repository, rev: str) -> ExportEntry[] ! Error {
    let root = r.peel(r.resolve(rev)?, Tree)?
    var out: ExportEntry[] = []
    var rules: AttrRule[] = []
    r.walk_export(root, "", rules, mut out)?
    out
}

fn walk_export(r: *Repository, tree: str, prefix: str, inherited: AttrRule[], mut out: ExportEntry[]) ! Error {
    let entries = r.read_tree(tree)?
    var rules: AttrRule[] = []
    for rule in inherited {
        rules.push(rule)
    }
    for e in entries {
        if e.name == ".gitattributes" && (e.mode == File || e.mode == Executable) {
            let blob = r.read(e.id)?
            for rule in parse_attributes(str(blob.data), prefix) {
                rules.push(rule)
            }
        }
    }
    for e in entries {
        if text.equal_fold(e.name, ".git") {
            fail Malformed("tree {tree}, which holds an entry named {e.name}")
        }
        let location = if prefix == "" { e.name } else { "{prefix}/{e.name}" }
        let dir = e.mode == Dir || e.mode == Submodule
        match attribute(rules, location, dir, "export-ignore") {
            Set => continue
            _ => {}
        }
        if !dir {
            check_rewrites(rules, location)?
        }
        out.push(ExportEntry { path: location, mode: e.mode, id: e.id })
        if e.mode == Dir {
            r.walk_export(e.id, location, rules, mut out)?
        }
    }
}

fn check_rewrites(rules: AttrRule[], location: str) ! Error {
    for name in ["export-subst", "ident", "working-tree-encoding"] {
        match attribute(rules, location, false, name) {
            Set => fail Unsupported("{location}, whose .gitattributes sets {name}")
            Value(_) => fail Unsupported("{location}, whose .gitattributes sets {name}")
            _ => {}
        }
    }
    match attribute(rules, location, false, "eol") {
        Value(v) => {
            if v == "crlf" {
                fail Unsupported("{location}, whose .gitattributes sets eol=crlf")
            }
        }
        _ => {}
    }
}

/// Writes the files of `rev` in `r` below `dir`, as `git archive` followed by extracting the archive would: the paths of `export_entries`, files with mode `0o644`, executables with `0o755`, submodules as empty directories and symbolic links last, so no file is written through one.
///
/// `dir` is created when missing. A file already in `dir` is replaced.
/// Fails as `export_entries` does, and with `Io` when a path cannot be written.
pub fn export(r: *Repository, rev: str, dir: str) ! Error {
    let entries = r.export_entries(rev)?
    make_dirs(dir)?
    var links: ExportEntry[] = []
    for e in entries {
        let target = path.join([dir, e.path])
        match e.mode {
            Symlink => links.push(e)
            _ => r.write_entry(e, target)?
        }
    }
    for e in links {
        let target = path.join([dir, e.path])
        let to = str(r.read(e.id)?.data)
        archive.symlink(target, to) catch {
            err => fail Io(target, err)
        }
    }
}

fn write_entry(r: *Repository, e: ExportEntry, target: str) ! Error {
    let mode = if e.mode == Executable { 0o755 } else { 0o644 }
    if e.mode == Dir || e.mode == Submodule {
        archive.make_dir(target, 0o755) catch {
            err => fail Io(target, err)
        }
        return
    }
    let data = r.read(e.id)?.data
    archive.write_file(target, data, mode) catch {
        err => fail Io(target, err)
    }
}
