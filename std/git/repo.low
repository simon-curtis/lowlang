import std/file
import std/path
import std/slices
import std/text

/// An open repository: where its files are and the packs read so far.
pub struct Repository {
    /// The directory that holds `HEAD`: `.git` of a work tree, the repository of a bare one, or the directory under `.git/worktrees` of a linked work tree.
    pub git_dir: str
    /// The directory that holds `objects`, `refs` and `config`, which every work tree of the repository shares.
    pub common_dir: str
    /// The directory of the checked out files, or `""` for a bare repository.
    pub work_tree: str
    packs: *Pack[]
    packs_read: bool
    cache: *BaseCache
}

/// Opens the repository at `location`: a work tree whose `.git` is a directory or a `gitdir:` file, a `.git` directory, or a bare repository.
///
/// Fails with `NotFound` when `location` is none of these, and with `Unsupported` for a repository format newer than version 1 or one that names an object format other than `sha1`.
pub fn open(location: str) -> *Repository ! Error {
    let dot = path.join([location, ".git"])
    if file.is_dir(dot) {
        return open_git_dir(dot, location)
    }
    if file.is_file(dot) {
        return open_git_dir(linked_dir(dot)?, location)
    }
    if is_git_dir(location) {
        return open_git_dir(location, "")
    }
    fail NotFound("repository {location}")
}

/// Opens the repository that holds `location`, looking in `location` and then in each directory above it.
///
/// `location` is made absolute first, so a relative path finds a repository above the current directory.
/// Fails with `Io` when `location` cannot be resolved, with `NotFound` when no directory up to the root holds one, and otherwise as `open` does.
pub fn discover(location: str) -> *Repository ! Error {
    var dir = file.realpath(location) catch {
        e => fail Io(location, e)
    }
    for {
        if file.exists(path.join([dir, ".git"])) || is_git_dir(dir) {
            return open(dir)
        }
        let parent = path.dir(dir)
        if parent == dir {
            fail NotFound("repository at or above {location}")
        }
        dir = parent
    }
}

fn is_git_dir(dir: str) -> bool {
    file.is_file(path.join([dir, "HEAD"])) && (file.is_dir(path.join([dir, "objects"])) || file.is_file(path.join([dir, "commondir"])))
}

fn linked_dir(dot: str) -> str ! Error {
    let content = text.trim(str(read_bytes(dot)?))
    let target = text.strip_prefix(content, "gitdir: ") ?? fail Malformed("gitdir file {dot}")
    if path.is_absolute(target) {
        return target
    }
    path.join([path.dir(dot), target])
}

fn open_git_dir(git_dir: str, work_tree: str) -> *Repository ! Error {
    var common = git_dir
    match read_optional(path.join([git_dir, "commondir"]))? {
        some(data) => {
            let named = text.trim(str(data))
            common = if path.is_absolute(named) { named } else { path.clean(path.join([git_dir, named])) }
        }
        none => {}
    }
    let r = new(Repository { git_dir, common_dir: common, work_tree, packs: [], packs_read: false, cache: base_cache() })
    check_format(r)?
    r
}

fn check_format(r: *Repository) ! Error {
    let data = read_optional(path.join([r.common_dir, "config"]))? ?? return
    let c = parse_config(str(data), path.join([r.common_dir, "config"]))?
    let version = get(c, "core.repositoryformatversion") ?? "0"
    if version != "0" && version != "1" {
        fail Unsupported("repository format version {version}")
    }
    let format = get(c, "extensions.objectformat") ?? "sha1"
    if text.lower(format) != "sha1" {
        fail Unsupported("object format {format}")
    }
    if version == "0" {
        return
    }
    for s in c.settings {
        let name = text.strip_prefix(s.key, "extensions.") ?? continue
        if name == "refstorage" && text.lower(s.value) != "files" {
            fail Unsupported("reference storage {s.value}")
        }
        if !slices.contains(["objectformat", "refstorage", "worktreeconfig", "preciousobjects", "partialclone", "noop"], name) {
            fail Unsupported("repository extension {name}")
        }
    }
}

/// Returns the settings that apply to `r`: the system, global, repository and command line levels in that order.
///
/// Fails as `user_config` does, and with `Malformed` when the repository's own `config` does not parse.
pub fn repo_config(r: *Repository) -> Config ! Error {
    layered(path.join([r.common_dir, "config"]))
}

/// Creates an empty repository at `location` and opens it: bare when `bare` is `true`, and otherwise a work tree with a `.git` directory.
///
/// `HEAD` names `refs/heads/main`. An existing repository is opened unchanged, as `git init` leaves one.
/// Fails with `Io` when a directory or file cannot be created.
pub fn init(location: str, bare: bool) -> *Repository ! Error {
    let git_dir = if bare { location } else { path.join([location, ".git"]) }
    if is_git_dir(git_dir) {
        return open(location)
    }
    for dir in ["objects/info", "objects/pack", "refs/heads", "refs/tags", "info"] {
        make_dirs(path.join([git_dir, dir]))?
    }
    let bare_text = if bare { "true" } else { "false" }
    write_new(path.join([git_dir, "config"]), "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = {bare_text}\n")?
    write_new(path.join([git_dir, "HEAD"]), "ref: refs/heads/main\n")?
    write_new(path.join([git_dir, "description"]), "Unnamed repository; edit this file 'description' to name the repository.\n")?
    open(location)
}

fn make_dirs(dir: str) ! Error {
    file.mkdir_all(dir) catch {
        e => fail Io(dir, e)
    }
}

fn write_new(location: str, content: str) ! Error {
    file.write_text(location, content) catch {
        e => fail Io(location, e)
    }
}

fn objects_dir(r: *Repository) -> str {
    path.join([r.common_dir, "objects"])
}
