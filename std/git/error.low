import std/file
import std/io

/// Why a repository operation failed.
pub enum Error {
    /// A file of the repository could not be read or written: its path and the cause.
    Io(path: str, cause: io.Error)
    /// The repository, object or reference named by `what` does not exist.
    NotFound(what: str)
    /// The data named by `what` is not well formed.
    Malformed(what: str)
    /// The repository or its data uses a feature this module does not implement, named by `what`.
    Unsupported(what: str)
    /// An argument is not valid, as `what` says.
    Invalid(what: str)
}

/// Returns a one-line description of `e`.
pub fn message(e: Error) -> str {
    match e {
        Io(path, cause) => "{path}: {cause}"
        NotFound(what) => "{what} not found"
        Malformed(what) => "malformed {what}"
        Unsupported(what) => "unsupported {what}"
        Invalid(what) => what
    }
}

fn read_bytes(location: str) -> u8[] ! Error {
    file.read_file(location) catch {
        e => fail Io(location, e)
    }
}

fn read_optional(location: str) -> u8[]? ! Error {
    let data = file.read_file(location) catch {
        e => match e {
            NotFound => return none
            NotDir => return none
            _ => fail Io(location, e)
        }
    }
    some(data)
}
