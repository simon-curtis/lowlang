import std/git
import std/io

/// Why talking to a remote repository failed.
pub enum Error {
    /// The local repository failed.
    Repo(cause: git.Error)
    /// The connection, a pipe or a local file failed.
    Io(cause: io.Error)
    /// The server answered `url` with the HTTP status `status`.
    Http(url: str, status: i64)
    /// The server at `url` could not be reached, for the reason given.
    Connect(url: str, reason: str)
    /// The server at `url` asked for credentials and none were accepted.
    Auth(url: str)
    /// The SSH host key of `host` is not in a known hosts file, or does not match the one recorded there.
    HostKey(host: str)
    /// The server sent something this client cannot read, as `what` says.
    Protocol(what: str)
    /// The server reported the error `message`.
    Remote(message: str)
    /// The URL or the server needs a feature this module does not implement, named by `what`.
    Unsupported(what: str)
}

/// Returns a one-line description of `e`.
pub fn message(e: Error) -> str {
    match e {
        Repo(cause) => git.message(cause)
        Io(cause) => "{cause}"
        Http(url, status) => "{url} answered with HTTP status {status}"
        Connect(url, reason) => "cannot reach {url}: {reason}"
        Auth(url) => "{url} needs credentials and none were accepted"
        HostKey(host) => "the SSH host key of {host} is not a known host key; add it to ~/.ssh/known_hosts"
        Protocol(what) => "protocol error: {what}"
        Remote(message) => "the remote reported: {message}"
        Unsupported(what) => "unsupported {what}"
    }
}

fn repo_error(e: git.Error) -> Error {
    Repo(e)
}
