import std/git
import std/text

fn local_path(url: str) -> str? {
    match text.strip_prefix(url, "file://") {
        some(rest) => return some(rest)
        none => {}
    }
    if text.contains(url, "://") {
        return none
    }
    let colon = text.index_byte(url, ':')
    let slash = text.index_byte(url, '/')
    if colon > 0 && (slash < 0 || colon < slash) && !(colon == 1 && url.len > 2 && (url[2] == '/' || url[2] == '\\')) {
        return none
    }
    some(url)
}

fn local_listing(src: *git.Repository, prefixes: str[]) -> Listed ! Error {
    var refs: git.Ref[] = []
    let all = git.refs(src, "refs/") catch {
        e => fail Repo(e)
    }
    for r in all {
        if wanted_name(r.name, prefixes) {
            refs.push(r)
        }
    }
    let head = git.symbolic_target(src, "HEAD") catch {
        e => fail Repo(e)
    }
    Listed { refs, head: head ?? "" }
}

fn local_fetch(src: *git.Repository, dst: *git.Repository, wants: str[]) ! Error {
    let ids = git.missing_objects(src, wants, fn(id: str) -> bool { git.has(dst, id) }) catch {
        e => fail Repo(e)
    }
    if ids.len == 0 {
        return
    }
    let pack = git.write_pack(src, ids) catch {
        e => fail Repo(e)
    }
    git.add_pack(dst, pack) catch {
        e => fail Repo(e)
    }
}
