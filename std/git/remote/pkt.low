import std/io
import std/text

enum Packet {
    Data(bytes: u8[])
    Flush
    Delim
    End
}

fn pkt_line(line: str) -> u8[] {
    pkt_data(bytes(line))
}

fn pkt_data(data: u8[]) -> u8[] {
    var out: u8[] = []
    text.append_hex(mut out, data.len + 4, 4, false)
    io.append(mut out, data)
    out
}

fn flush_pkt() -> u8[] {
    bytes("0000")
}

fn delim_pkt() -> u8[] {
    bytes("0001")
}

struct PktReader {
    data: u8[]
    at: i64
}

fn pkt_reader(data: u8[]) -> *PktReader {
    new(PktReader { data, at: 0 })
}

fn more(p: *PktReader) -> bool {
    p.at < p.data.len
}

fn next_packet(p: *PktReader) -> Packet ! Error {
    if p.at + 4 > p.data.len {
        fail Protocol("a truncated pkt-line")
    }
    let size = pkt_size(p.data[p.at..p.at + 4])?
    match size {
        0 => {
            p.at += 4
            return Flush
        }
        1 => {
            p.at += 4
            return Delim
        }
        2 => {
            p.at += 4
            return End
        }
        _ => {}
    }
    if size < 4 || p.at + size > p.data.len {
        fail Protocol("a truncated pkt-line")
    }
    let body = p.data[p.at + 4..p.at + size]
    p.at += size
    Data(body)
}

fn pkt_size(head: u8[]) -> i64 ! Error {
    var n = 0
    for c in head {
        let d = text.hex_digit(c)
        if d < 0 {
            fail Protocol("a pkt-line length that is not hex")
        }
        n = n * 16 + d
    }
    n
}

fn line_of(data: u8[]) -> str {
    text.trim_suffix(str(data), "\n")
}

fn read_until_flush(r: *io.Reader) -> u8[] ! Error {
    var out: u8[] = []
    for {
        let head = io.read_exact(r, 4) catch {
            e => fail Io(e)
        }
        io.append(mut out, head)
        let size = pkt_size(head)?
        if size == 0 {
            return out
        }
        if size < 4 {
            continue
        }
        let body = io.read_exact(r, size - 4) catch {
            e => fail Io(e)
        }
        io.append(mut out, body)
        if body.len >= 4 && str(body[..4]) == "ERR " {
            fail Remote(line_of(body[4..]))
        }
    }
}

fn check_err(data: u8[]) ! Error {
    if data.len >= 4 && str(data[..4]) == "ERR " {
        fail Remote(line_of(data[4..]))
    }
}

fn sideband(data: u8[], mut pack: u8[]) ! Error {
    if data.len == 0 {
        fail Protocol("an empty side-band packet")
    }
    match data[0] {
        1 => io.append(mut pack, data[1..])
        2 => {}
        3 => fail Remote(line_of(data[1..]))
        _ => fail Protocol("side-band channel {data[0]}")
    }
}
