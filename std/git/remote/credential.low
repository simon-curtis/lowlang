import std/http
import std/process
import std/text

/// A user name and password, or token, for an HTTP server.
pub struct Credential {
    /// The user name.
    pub user: str
    /// The password or access token.
    pub password: str
}

/// Returns a credential source that asks `git credential fill` for the credential of a URL, so the helpers configured for Git (`credential.helper`) answer as they do for Git, and returns `none` when Git is not installed or has no credential.
///
/// Git may prompt on the terminal when no helper has the credential; `GIT_TERMINAL_PROMPT=0` stops it.
pub fn git_credentials() -> fn(str) -> Credential? {
    fn(url: str) -> Credential? {
        ask_git(url)
    }
}

fn ask_git(url: str) -> Credential? {
    let program = process.find("git") ?? return none
    let parsed = http.parse_url(url) or return none
    var c = process.command(program, ["credential", "fill"])
    c.stdin = Piped
    c.stdout = Piped
    let request = "protocol={parsed.scheme}\nhost={parsed.host}\npath={text.trim_prefix(parsed.target, "/")}\n\n"
    let out = process.run(c, bytes(request)) or return none
    if !process.success(out.status) {
        return none
    }
    var user = ""
    var password = ""
    for line in text.lines(str(out.stdout)) {
        match text.strip_prefix(line, "username=") {
            some(v) => {
                user = v
            }
            none => {}
        }
        match text.strip_prefix(line, "password=") {
            some(v) => {
                password = v
            }
            none => {}
        }
    }
    if user == "" && password == "" {
        return none
    }
    some(Credential { user, password })
}

fn no_credentials(url: str) -> Credential? {
    none
}
