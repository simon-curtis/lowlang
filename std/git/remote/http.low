import std/git
import std/http
import std/text

struct HttpRemote {
    client: *http.Client
    url: str
    user: str
    password: str
    asked: bool
    credentials: fn(str) -> Credential?
}

fn http_session(url: str, o: Options) -> Session ! Error {
    let parsed = http.parse_url(url) catch {
        _ => fail Unsupported("URL {url}")
    }
    let base = text.trim_suffix(http.format_url(parsed), "/")
    var b = http.client().with_redirects(5).with_proxy_from_environment()
    match git.get(o.config, "http.proxy") {
        some(proxy) => { b = b.with_proxy(proxy) }
        none => {}
    }
    let h = new(HttpRemote { client: b.build(), url: base, user: parsed.user, password: parsed.password, asked: false, credentials: o.credentials })
    let info = h.exchange("GET", "{base}/info/refs?service=git-upload-pack", [], "")?
    let kind = http.header_value(info, "content-type") ?? ""
    if !text.starts_with(kind, "application/x-git-upload-pack-advertisement") {
        fail Unsupported("dumb HTTP server at {base}")
    }
    let s = opening(info.body)?
    Session {
        version: s.version
        advertisement: s.advertisement
        call: fn(request: u8[]) -> u8[] ! Error {
            let resp = h.exchange("POST", "{base}/git-upload-pack", request, "application/x-git-upload-pack-request")?
            resp.body
        }
    }
}

fn exchange(h: *HttpRemote, method: str, url: str, body: u8[], content_type: str) -> http.Response ! Error {
    for {
        var b = h.client.request(method, url).with_header("git-protocol", "version=2").with_header("user-agent", "git/low")
        if content_type != "" {
            b = b.with_body(body, content_type).with_header("accept", "application/x-git-upload-pack-result")
        }
        if h.user != "" || h.password != "" {
            b = b.with_basic_auth(h.user, h.password)
        }
        let resp = http.send(b) catch {
            e => fail Connect(h.url, describe_http(e))
        }
        if resp.status == 401 && !h.asked {
            h.asked = true
            let found = h.credentials(h.url) ?? fail Auth(h.url)
            h.user = found.user
            h.password = found.password
            continue
        }
        if resp.status == 401 || resp.status == 403 {
            fail Auth(h.url)
        }
        if resp.status != 200 {
            fail Http(url, resp.status)
        }
        return resp
    }
}

fn describe_http(e: http.Error) -> str {
    match e {
        InvalidUrl(u) => "the URL {u} is not valid"
        Connect(cause) => "{cause}"
        Tls(cause) => "TLS failed: {cause}"
        Timeout => "the request timed out"
        TooManyRedirects(n) => "too many redirects ({n})"
        Protocol(cause) => "a malformed HTTP response ({cause})"
        Decode(cause) => "a body that does not decode ({cause})"
        Status(code) => "HTTP status {code}"
        Io(cause) => "{cause}"
        _ => "the request failed"
    }
}
