import std/io
import std/net

fn stream_session(s: io.Stream) -> Session ! Error {
    let r = io.reader(s)
    let advertised = read_until_flush(r)?
    let opened = opening(advertised)?
    Session {
        version: opened.version
        advertisement: opened.advertisement
        call: fn(request: u8[]) -> u8[] ! Error {
            io.write_all(s, request) catch {
                e => fail Io(e)
            }
            read_until_flush(r)
        }
    }
}

fn daemon_session(host: str, port: i64, repo_path: str, work: fn(Session) ! Error) ! Error {
    using conn = net.dial(host, port) catch {
        e => fail Connect("git://{host}:{port}{repo_path}", "{e}")
    }
    let s = net.stream_on(conn.handle)
    io.write_all(s, pkt_line("git-upload-pack {repo_path}\0host={host}\0\0version=2\0")) catch {
        e => fail Io(e)
    }
    work(stream_session(s)?)?
}
