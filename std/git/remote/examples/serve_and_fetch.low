import std/file
import std/git
import std/git/remote
import std/http
import std/net
import std/text

fn origin(location: str) -> *git.Repository ! git.Error {
    let r = git.init(location, true)?
    let who = git.Signature { name: "Ada", email: "ada@example.com", time: 1700000000 }
    let blob = git.write_object(r, Blob, bytes("hello\n"))?
    let tree = git.write_tree(r, [git.TreeEntry { name: "hello.txt", mode: File, id: blob }])?
    let commit = git.write_commit(r, git.Commit { tree, author: who, committer: who, message: "hello\n" })?
    git.set_ref(r, "refs/heads/main", commit)?
    git.set_ref(r, "refs/tags/v1.0.0", commit)?
    r
}

fn repo(e: git.Error) -> remote.Error {
    Repo(e)
}

/// Serves a repository over smart HTTP on a loopback port and fetches it into another repository.
fn main() ! remote.Error {
    let dir = file.temp_dir("git-remote-") catch {
        e => fail Io(e)
    }
    defer file.remove_all(dir) or {}
    let src = origin("{dir}/origin.git") catch { e => fail repo(e) }
    using l = net.listen("127.0.0.1", 0) catch {
        e => fail Io(e)
    }
    let listening = l.handle
    let handler = remote.http_handler(src)
    spawn fn() { http.serve_on(listening, handler) or {} }()

    let url = "http://127.0.0.1:{l.handle.addr.port}/origin.git"
    let dst = git.init("{dir}/copy.git", true) catch { e => fail repo(e) }
    let fetched = remote.fetch(dst, url, remote.Options {})?
    print("HEAD -> {fetched.head}")
    for ref in fetched.refs {
        print("{ref.name} {ref.id[..7]}")
    }
    let c = git.read_commit(dst, git.resolve(dst, "main") catch { e => fail repo(e) }) catch { e => fail repo(e) }
    print("main: {text.trim(c.message)}")
}
