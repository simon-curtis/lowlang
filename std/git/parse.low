import std/io
import std/slices
import std/text

/// A person and the moment they authored, committed or tagged.
pub struct Signature {
    /// The name.
    pub name: str
    /// The email address, without the angle brackets.
    pub email: str
    /// The time in seconds since the Unix epoch.
    pub time: i64
    /// The time zone offset as Git writes it, such as `+0000` or `-0530`.
    pub zone: str = "+0000"
}

/// The fields of a commit object.
pub struct Commit {
    /// The id of the tree the commit records.
    pub tree: str
    /// The ids of the parent commits, first parent first.
    pub parents: str[] = []
    /// Who wrote the change and when.
    pub author: Signature
    /// Who made the commit and when.
    pub committer: Signature
    /// The message, everything after the blank line that ends the headers.
    pub message: str
}

/// The fields of an annotated tag object.
pub struct TagInfo {
    /// The id of the tagged object.
    pub object: str
    /// The type of the tagged object.
    pub kind: Kind
    /// The tag's name, such as `v1.0.0`.
    pub name: str
    /// Who made the tag and when.
    pub tagger: Signature
    /// The message.
    pub message: str
}

/// The type of an entry in a tree.
pub enum Mode {
    /// A regular file.
    File
    /// A regular file with its executable bits set.
    Executable
    /// A symbolic link, whose blob holds the target.
    Symlink
    /// A directory: another tree.
    Dir
    /// A commit of another repository, as a submodule records.
    Submodule
}

/// One entry of a tree.
pub struct TreeEntry {
    /// The file or directory name, a single path component.
    pub name: str
    /// The type of the entry.
    pub mode: Mode
    /// The id of the blob, tree or, for a submodule, commit.
    pub id: str
}

fn signature_of(s: str, what: str) -> Signature ! Error {
    let open = text.last_index_byte(s, '<')
    let close = text.last_index_byte(s, '>')
    if open < 0 || close < open {
        fail Malformed(what)
    }
    let name = text.trim(s[..open])
    let email = s[open + 1..close]
    let rest = text.fields(s[close + 1..])
    if rest.len != 2 {
        return Signature { name, email, time: 0, zone: "+0000" }
    }
    let time = text.parse_int(rest[0]) or fail Malformed(what)
    Signature { name, email, time, zone: rest[1] }
}

fn format_signature(s: Signature) -> str {
    "{s.name} <{s.email}> {s.time} {s.zone}"
}

struct Header {
    key: str
    value: str
}

fn headers(data: u8[], what: str) -> Header[] ! Error {
    let s = str(data)
    var out: Header[] = []
    var at = 0
    for at < s.len {
        var end = at
        for end < s.len && s[end] != '\n' {
            end += 1
        }
        let line = s[at..end]
        at = end + 1
        if line.len == 0 {
            out.push(Header { key: "", value: if at <= s.len { s[at..] } else { "" } })
            return out
        }
        if line[0] == ' ' {
            if out.len == 0 {
                fail Malformed(what)
            }
            let last = out.pop() ?? fail Malformed(what)
            out.push(Header { key: last.key, value: "{last.value}\n{line[1..]}" })
            continue
        }
        let space = text.index_byte(line, ' ')
        if space < 0 {
            fail Malformed(what)
        }
        out.push(Header { key: line[..space], value: line[space + 1..] })
    }
    out.push(Header { key: "", value: "" })
    out
}

/// Parses the bytes of the commit object `id`, which names it in errors.
///
/// Fails with `Malformed` when the tree, author or committer header is missing or malformed.
pub fn parse_commit(data: u8[], id: str) -> Commit ! Error {
    let what = "commit {id}"
    var tree = ""
    var parents: str[] = []
    var author: Signature? = none
    var committer: Signature? = none
    var message = ""
    for h in headers(data, what)? {
        match h.key {
            "tree" => {
                tree = h.value
            }
            "parent" => parents.push(h.value)
            "author" => {
                author = some(signature_of(h.value, what)?)
            }
            "committer" => {
                committer = some(signature_of(h.value, what)?)
            }
            "" => {
                message = h.value
            }
            _ => {}
        }
    }
    if !valid_id(tree) {
        fail Malformed(what)
    }
    Commit { tree, parents, author: author ?? fail Malformed(what), committer: committer ?? fail Malformed(what), message }
}

/// Parses the bytes of the tag object `id`, which names it in errors.
///
/// Fails with `Malformed` when the object, type or tag header is missing or malformed.
pub fn parse_tag(data: u8[], id: str) -> TagInfo ! Error {
    let what = "tag {id}"
    var object = ""
    var kind: Kind? = none
    var name = ""
    var tagger = Signature { name: "", email: "", time: 0 }
    var message = ""
    for h in headers(data, what)? {
        match h.key {
            "object" => {
                object = h.value
            }
            "type" => {
                kind = kind_named(h.value)
            }
            "tag" => {
                name = h.value
            }
            "tagger" => {
                tagger = signature_of(h.value, what)?
            }
            "" => {
                message = h.value
            }
            _ => {}
        }
    }
    if !valid_id(object) {
        fail Malformed(what)
    }
    TagInfo { object, kind: kind ?? fail Malformed(what), name, tagger, message }
}

fn mode_of(text_mode: str) -> Mode? {
    match text_mode {
        "100644" => some(File)
        "100664" => some(File)
        "100755" => some(Executable)
        "120000" => some(Symlink)
        "40000" => some(Dir)
        "040000" => some(Dir)
        "160000" => some(Submodule)
        _ => none
    }
}

fn mode_text(m: Mode) -> str {
    match m {
        File => "100644"
        Executable => "100755"
        Symlink => "120000"
        Dir => "40000"
        Submodule => "160000"
    }
}

/// Parses the bytes of the tree object `id`, which names it in errors.
///
/// Fails with `Malformed` when an entry is truncated, has an unknown mode, or has a name that is empty, `.`, `..` or holds `/`.
pub fn parse_tree(data: u8[], id: str) -> TreeEntry[] ! Error {
    let what = "tree {id}"
    var out: TreeEntry[] = []
    var at = 0
    for at < data.len {
        let space = index_of(data, at, ' ')
        if space < 0 {
            fail Malformed(what)
        }
        let nul = index_of(data, space + 1, 0)
        if nul < 0 || nul + 21 > data.len {
            fail Malformed(what)
        }
        let mode = mode_of(str(data[at..space])) ?? fail Malformed(what)
        let name = str(data[space + 1..nul])
        if name.len == 0 || name == "." || name == ".." || text.index_byte(name, '/') >= 0 {
            fail Malformed(what)
        }
        out.push(TreeEntry { name, mode, id: text.encode_hex(data[nul + 1..nul + 21]) })
        at = nul + 21
    }
    out
}

/// Returns the commit `id` of `r`, following annotated tags to it.
///
/// Fails with `NotFound` when an object is missing, with `Invalid` when `id` leads to an object that is not a commit and with `Malformed` when one is corrupt.
pub fn read_commit(r: *Repository, id: str) -> Commit ! Error {
    let found = r.peel(id, Commit)?
    parse_commit(r.read(found)?.data, found)
}

/// Returns the entries of the tree `id` of `r`, following an annotated tag or a commit to its tree.
///
/// Fails as `read_commit` does.
pub fn read_tree(r: *Repository, id: str) -> TreeEntry[] ! Error {
    let found = r.peel(id, Tree)?
    parse_tree(r.read(found)?.data, found)
}

/// Returns the annotated tag `id` of `r`.
///
/// Fails with `Invalid` when `id` is not a tag, and as `read` does.
pub fn read_tag(r: *Repository, id: str) -> TagInfo ! Error {
    let o = r.read(id)?
    match o.kind {
        Tag => parse_tag(o.data, id)
        _ => fail Invalid("{id} is a {kind_name(o.kind)}, not a tag")
    }
}

/// Returns the id of the object of kind `want` that `id` leads to: `id` itself when it has that kind, the object at the end of a chain of annotated tags, or a commit's tree.
///
/// Fails with `Invalid` when the chain ends at an object of another kind, and as `read` does.
pub fn peel(r: *Repository, id: str, want: Kind) -> str ! Error {
    var current = id
    for _ in 0..100 {
        let o = r.read(current)?
        if o.kind == want {
            return current
        }
        match o.kind {
            Tag => {
                current = parse_tag(o.data, current)?.object
            }
            Commit => {
                if want != Tree {
                    fail Invalid("{id} is a commit, not a {kind_name(want)}")
                }
                current = parse_commit(o.data, current)?.tree
            }
            _ => fail Invalid("{id} is a {kind_name(o.kind)}, not a {kind_name(want)}")
        }
    }
    fail Malformed("tag {id}, whose chain of tags is too long")
}

fn tree_key(e: TreeEntry) -> str {
    match e.mode {
        Dir => "{e.name}/"
        _ => e.name
    }
}

/// Stores a tree holding `entries` in `r` and returns its id. The entries are written in Git's order, so they can be given in any order.
///
/// Fails with `Invalid` for an entry whose name is empty, `.`, `..` or `.git` or holds `/` or NUL, or whose id is malformed, for two entries with one name, and with `Io` when the object cannot be written.
pub fn write_tree(r: *Repository, entries: TreeEntry[]) -> str ! Error {
    var sorted: TreeEntry[] = []
    for e in entries {
        if e.name.len == 0 || e.name == "." || e.name == ".." || e.name == ".git" || text.index_byte(e.name, '/') >= 0 || text.index_byte(e.name, 0) >= 0 {
            fail Invalid("{e.name} is not a valid tree entry name")
        }
        need_id(e.id)?
        sorted.push(e)
    }
    slices.sort_by(mut sorted, fn(a: TreeEntry, b: TreeEntry) -> bool { tree_key(a) < tree_key(b) })
    var data: u8[] = []
    for i in 0..sorted.len {
        let e = sorted[i]
        if i > 0 && sorted[i - 1].name == e.name {
            fail Invalid("the tree names {e.name} twice")
        }
        io.append(mut data, bytes("{mode_text(e.mode)} {e.name}\0"))
        io.append(mut data, raw_id(e.id))
    }
    r.write_object(Tree, data)
}

/// Stores the commit `c` in `r` and returns its id.
///
/// The message is stored as given, so end it with a newline as Git does.
/// Fails with `Invalid` when the tree or a parent id is malformed and with `Io` when the object cannot be written.
pub fn write_commit(r: *Repository, c: Commit) -> str ! Error {
    need_id(c.tree)?
    var out = "tree {c.tree}\n"
    for p in c.parents {
        need_id(p)?
        out = "{out}parent {p}\n"
    }
    out = "{out}author {format_signature(c.author)}\ncommitter {format_signature(c.committer)}\n\n{c.message}"
    r.write_object(Commit, bytes(out))
}

/// Stores the annotated tag `t` in `r` and returns its id. It does not create the reference; call `set_ref` with `refs/tags/<name>` for that.
///
/// Fails with `Invalid` when the object id is malformed and with `Io` when the object cannot be written.
pub fn write_tag(r: *Repository, t: TagInfo) -> str ! Error {
    need_id(t.object)?
    let out = "object {t.object}\ntype {kind_name(t.kind)}\ntag {t.name}\ntagger {format_signature(t.tagger)}\n\n{t.message}"
    r.write_object(Tag, bytes(out))
}
