import std/text

struct AttrRule {
    base: str
    pattern: str
    basename: bool
    dir_only: bool
    attrs: Attr[]
}

struct Attr {
    name: str
    state: AttrState
}

enum AttrState {
    Set
    Unset
    Unspecified
    Value(v: str)
}

fn parse_attributes(source: str, base: str) -> AttrRule[] {
    var out: AttrRule[] = []
    for raw in text.lines(source) {
        let line = text.trim(raw)
        if line.len == 0 || line[0] == '#' {
            continue
        }
        let fields = text.fields(line)
        var pattern = fields[0]
        if text.starts_with(pattern, "[attr]") || text.starts_with(pattern, "!") || text.starts_with(pattern, "\"") {
            continue
        }
        var dir_only = false
        if text.ends_with(pattern, "/") {
            dir_only = true
            pattern = pattern[..pattern.len - 1]
        }
        let basename = text.index_byte(pattern, '/') < 0
        pattern = text.trim_prefix(pattern, "/")
        var attrs: Attr[] = []
        for field in fields[1..] {
            add_attr(mut attrs, field)
        }
        out.push(AttrRule { base, pattern, basename, dir_only, attrs })
    }
    out
}

fn add_attr(mut attrs: Attr[], field: str) {
    if field == "binary" {
        attrs.push(Attr { name: "diff", state: Unset })
        attrs.push(Attr { name: "merge", state: Unset })
        attrs.push(Attr { name: "text", state: Unset })
        return
    }
    if text.starts_with(field, "-") {
        attrs.push(Attr { name: field[1..], state: Unset })
        return
    }
    if text.starts_with(field, "!") {
        attrs.push(Attr { name: field[1..], state: Unspecified })
        return
    }
    let eq = text.index_byte(field, '=')
    if eq >= 0 {
        attrs.push(Attr { name: field[..eq], state: Value(field[eq + 1..]) })
        return
    }
    attrs.push(Attr { name: field, state: Set })
}

fn rule_matches(rule: AttrRule, location: str, dir: bool) -> bool {
    if rule.dir_only && !dir {
        return false
    }
    var rel = location
    if rule.base != "" {
        rel = text.strip_prefix(location, "{rule.base}/") ?? return false
    }
    if rule.basename {
        let slash = text.last_index_byte(rel, '/')
        return wildmatch(rule.pattern, rel[slash + 1..])
    }
    wildmatch(rule.pattern, rel)
}

fn attribute(rules: AttrRule[], location: str, dir: bool, name: str) -> AttrState {
    var state: AttrState = Unspecified
    for rule in rules {
        var mentioned = false
        for a in rule.attrs {
            if a.name == name {
                mentioned = true
            }
        }
        if !mentioned || !rule_matches(rule, location, dir) {
            continue
        }
        for a in rule.attrs {
            if a.name == name {
                state = a.state
            }
        }
    }
    state
}

fn wildmatch(pattern: str, name: str) -> bool {
    match_at(pattern, 0, name, 0)
}

fn match_at(p: str, pi: i64, s: str, si: i64) -> bool {
    var i = pi
    var j = si
    for i < p.len {
        let c = p[i]
        if c == '*' {
            let double = i + 1 < p.len && p[i + 1] == '*'
            if double && (i == 0 || p[i - 1] == '/') && (i + 2 == p.len || p[i + 2] == '/') {
                if i + 2 == p.len {
                    return true
                }
                for k in j..s.len + 1 {
                    if (k == j || s[k - 1] == '/') && match_at(p, i + 3, s, k) {
                        return true
                    }
                }
                return false
            }
            var next = i + 1
            for next < p.len && p[next] == '*' {
                next += 1
            }
            for k in j..s.len + 1 {
                if match_at(p, next, s, k) {
                    return true
                }
                if k < s.len && s[k] == '/' {
                    return false
                }
            }
            return false
        }
        if j >= s.len {
            return false
        }
        if c == '?' {
            if s[j] == '/' {
                return false
            }
            i += 1
            j += 1
            continue
        }
        if c == '[' {
            let end = class_end(p, i)
            if end < 0 {
                if s[j] != '[' {
                    return false
                }
                i += 1
                j += 1
                continue
            }
            if s[j] == '/' || !class_matches(p[i + 1..end], s[j]) {
                return false
            }
            i = end + 1
            j += 1
            continue
        }
        var literal = c
        if c == '\\' && i + 1 < p.len {
            i += 1
            literal = p[i]
        }
        if s[j] != literal {
            return false
        }
        i += 1
        j += 1
    }
    j == s.len
}

fn class_end(p: str, open: i64) -> i64 {
    var k = open + 1
    if k < p.len && (p[k] == '!' || p[k] == '^') {
        k += 1
    }
    if k < p.len && p[k] == ']' {
        k += 1
    }
    for k < p.len {
        if p[k] == ']' {
            return k
        }
        k += 1
    }
    -1
}

fn class_matches(body: str, c: u8) -> bool {
    var k = 0
    var negate = false
    if body.len > 0 && (body[0] == '!' || body[0] == '^') {
        negate = true
        k = 1
    }
    var found = false
    for k < body.len {
        let lo = body[k]
        if k + 2 < body.len && body[k + 1] == '-' {
            if c >= lo && c <= body[k + 2] {
                found = true
            }
            k += 3
            continue
        }
        if c == lo {
            found = true
        }
        k += 1
    }
    found != negate
}
