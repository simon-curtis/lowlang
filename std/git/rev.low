import std/text

/// Returns the id of the object that `rev` names in `r`.
///
/// `rev` is a full object id, `HEAD`, or a reference name looked up as written and then under `refs/`, `refs/tags/`, `refs/heads/`, `refs/remotes/` and as `refs/remotes/<name>/HEAD`, in that order. A suffix `^{{commit}}`, `^{{tree}}`, `^{{blob}}` or `^{{tag}}` peels the object to that kind, and `^{{}}` follows annotated tags.
/// Fails with `NotFound` when nothing matches and with `Invalid` when the object cannot be peeled to the kind asked for.
pub fn resolve(r: *Repository, rev: str) -> str ! Error {
    var base = rev
    var want = ""
    if text.ends_with(rev, "}}") {
        let open = text.last_index(rev, "^{{")
        if open < 0 {
            fail NotFound("revision {rev}")
        }
        base = rev[..open]
        want = rev[open + 2..rev.len - 1]
    }
    let id = r.resolve_name(base)?
    if want == "" {
        if base == rev {
            return id
        }
        let peeled = r.peel_tags(id)?
        return if peeled == "" { id } else { peeled }
    }
    let k = kind_named(want) ?? fail Invalid("{rev} names an unknown object type")
    r.peel(id, k)
}

fn resolve_name(r: *Repository, name: str) -> str ! Error {
    if valid_id(name) {
        return name
    }
    for candidate in [name, "refs/{name}", "refs/tags/{name}", "refs/heads/{name}", "refs/remotes/{name}", "refs/remotes/{name}/HEAD"] {
        if candidate != "HEAD" && !valid_ref_name(candidate) {
            continue
        }
        let id = r.read_ref(candidate) catch {
            e => match e {
                NotFound(_) => continue
                _ => fail e
            }
        }
        return id
    }
    fail NotFound("revision {name}")
}
