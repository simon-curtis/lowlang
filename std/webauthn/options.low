import std/crypto
import std/json

/// Whether the authenticator should create a discoverable credential, the `residentKey` requirement of WebAuthn.
pub enum ResidentKey {
    /// A discoverable credential is not wanted; `residentKey` is sent as `discouraged`.
    Discouraged
    /// A discoverable credential is preferred; `residentKey` is sent as `preferred`.
    Preferred
    /// A discoverable credential is required; `residentKey` is sent as `required` and `requireResidentKey` as `true`.
    Required
}

/// How strongly the authenticator should verify the user, such as with a PIN or biometric, the `userVerification` requirement of WebAuthn.
pub enum UserVerification {
    /// User verification should not be performed.
    Discouraged
    /// User verification is performed when the authenticator supports it, but its absence is accepted.
    Preferred
    /// User verification must be performed. Pair it with `Expected.require_user_verification` so the server enforces it.
    Required
}

/// The `authenticatorSelection` criteria of a registration request.
pub struct Selection {
    /// The discoverable credential requirement, or `none` to leave `residentKey` out of the request. `requireResidentKey` is `true` only for `Required`.
    pub resident_key: ResidentKey? = none
    /// The user verification requirement. Defaults to `Preferred`.
    pub user_verification: UserVerification = Preferred
}

/// The inputs of a registration (credential creation) request.
///
/// `registration_options` turns it into the JSON for `navigator.credentials.create`. The defaults for `user_id` and `challenge` are evaluated each time a value is built, so every request gets fresh random values.
pub struct RegistrationOptions {
    /// The relying party identifier, normally the registrable domain of the site.
    pub rp_id: str
    /// The human-readable name of the relying party.
    pub rp_name: str
    /// The account name of the user, such as an email address.
    pub user_name: str
    /// The user handle, an opaque identifier of the account that should not reveal personal information. Defaults to 64 random bytes.
    pub user_id: []u8 = crypto.random(64)
    /// The display name of the user. When empty, the default, `user_name` is used.
    pub user_display_name: str = ""
    /// The random challenge the authenticator signs, which `verify_registration` must be given again as `Expected.challenge`. Defaults to 64 random bytes.
    pub challenge: []u8 = crypto.random(64)
    /// How long the client waits for the user, in milliseconds. Defaults to `60000`.
    pub timeout: i64 = 60000
    /// The credential ids the user already has, so the authenticator does not register the same one twice. Empty by default.
    pub exclude_credentials: [][]u8 = []
    /// The authenticator selection criteria, or `none` to omit `authenticatorSelection` and leave the choice to the client.
    pub selection: Selection? = none
    /// The COSE algorithm identifiers to accept, in order of preference. Defaults to `supported_algorithms()`: `-8` (EdDSA), `-7` (ES256) and `-257` (RS256), the algorithms `parse_public_key` supports.
    pub algorithms: []i64 = supported_algorithms()
}

/// The inputs of an authentication (assertion) request.
///
/// `authentication_options` turns it into the JSON for `navigator.credentials.get`. The default `challenge` is evaluated each time a value is built.
pub struct AuthenticationOptions {
    /// The relying party identifier.
    pub rp_id: str
    /// The random challenge the authenticator signs, which `verify_authentication` must be given again as `Expected.challenge`. Defaults to 64 random bytes.
    pub challenge: []u8 = crypto.random(64)
    /// How long the client waits for the user, in milliseconds. Defaults to `60000`.
    pub timeout: i64 = 60000
    /// The credential ids the user may authenticate with. Empty, the default, lets the client offer any discoverable credential for `rp_id`.
    pub allow_credentials: [][]u8 = []
    /// The user verification requirement. Defaults to `Preferred`.
    pub user_verification: UserVerification = Preferred
}

fn descriptors(name: str, ids: [][]u8) -> json.Member {
    var items: []json.Value = []
    for id in ids {
        let descriptor = [json.base64url_member("id", id), json.text_member("type", "public-key")]
        push(mut items, json.object_value(descriptor))
    }
    json.array_member(name, items)
}

fn resident_key_name(r: ResidentKey) -> str {
    match r {
        Discouraged => "discouraged"
        Preferred => "preferred"
        Required => "required"
    }
}

fn user_verification_name(u: UserVerification) -> str {
    match u {
        Discouraged => "discouraged"
        Preferred => "preferred"
        Required => "required"
    }
}

fn selection_member(s: Selection) -> json.Member {
    var members: []json.Member = []
    var required = false
    match s.resident_key {
        some(r) => {
            push(mut members, json.text_member("residentKey", resident_key_name(r)))
            required = r == Required
        }
        none => {}
    }
    push(mut members, json.bool_member("requireResidentKey", required))
    push(mut members, json.text_member("userVerification", user_verification_name(s.user_verification)))
    json.object_member("authenticatorSelection", members)
}

/// Returns the JSON object for `PublicKeyCredentialCreationOptions` described by `o`.
///
/// Binary values (`user.id`, `challenge` and credential ids) are Base64url without padding, as the JSON form of the WebAuthn API expects. `attestation` is always `none`, matching `verify_registration`, which accepts only that format. `authenticatorSelection` is present only when `o.selection` is set.
pub fn registration_options(o: RegistrationOptions) -> json.Value {
    let display = if o.user_display_name == "" { o.user_name } else { o.user_display_name }
    var params: []json.Value = []
    for alg in o.algorithms {
        let param = [json.text_member("type", "public-key"), json.int_member("alg", alg)]
        push(mut params, json.object_value(param))
    }
    let rp = [json.text_member("name", o.rp_name), json.text_member("id", o.rp_id)]
    let user = [json.base64url_member("id", o.user_id), json.text_member("name", o.user_name), json.text_member("displayName", display)]
    var members = [
        json.object_member("rp", rp),
        json.object_member("user", user),
        json.base64url_member("challenge", o.challenge),
        json.array_member("pubKeyCredParams", params),
        json.int_member("timeout", o.timeout),
        descriptors("excludeCredentials", o.exclude_credentials),
    ]
    match o.selection {
        some(s) => push(mut members, selection_member(s))
        none => {}
    }
    push(mut members, json.text_member("attestation", "none"))
    json.object_value(members)
}

/// Returns the JSON object for `PublicKeyCredentialRequestOptions` described by `o`.
///
/// Binary values (`challenge` and credential ids) are Base64url without padding.
pub fn authentication_options(o: AuthenticationOptions) -> json.Value {
    json.object_value([
        json.base64url_member("challenge", o.challenge),
        json.int_member("timeout", o.timeout),
        json.text_member("rpId", o.rp_id),
        descriptors("allowCredentials", o.allow_credentials),
        json.text_member("userVerification", user_verification_name(o.user_verification)),
    ])
}
