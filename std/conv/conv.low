extern "c" {
    fn strtod(s: ptr[u8], end: ptr) -> f64
    fn snprintf(buf: ptr[u8], n: i64, format: ptr[u8], ...) -> i32
}

pub enum ParseError {
    Empty
    Invalid(i64)
    Overflow
}

fn digit(c: u8, base: i64) -> i64? {
    var d = 99
    if c >= '0' && c <= '9' {
        d = i64(c - '0')
    } else if c >= 'a' && c <= 'z' {
        d = i64(c - 'a') + 10
    } else if c >= 'A' && c <= 'Z' {
        d = i64(c - 'A') + 10
    }
    if d >= base {
        return none
    }
    d
}

pub fn parse_radix(s: str, base: i64) -> i64 ! ParseError {
    if base < 2 || base > 36 {
        fail Invalid(0)
    }
    if s.len == 0 {
        fail Empty
    }
    var start = 0
    let negative = s[0] == '-'
    if negative || s[0] == '+' {
        start = 1
    }
    if start == s.len {
        fail Invalid(start)
    }
    let min = -9223372036854775807 - 1
    var n = 0
    for i in start..s.len {
        let d = match digit(s[i], base) {
            some(d) => d
            none => fail Invalid(i)
        }
        if n < (min + d) / base {
            fail Overflow
        }
        n = n * base - d
    }
    if negative {
        return n
    }
    if n == min {
        fail Overflow
    }
    -n
}

pub fn parse_int(s: str) -> i64 ! ParseError {
    parse_radix(s, 10)?
}

pub fn parse_bool(s: str) -> bool ! ParseError {
    match s {
        == "true" => true
        == "false" => false
        _ => {
            if s.len == 0 {
                fail Empty
            }
            fail Invalid(0)
        }
    }
}

fn digits(s: str, at: i64) -> i64 {
    var i = at
    for i < s.len && s[i] >= '0' && s[i] <= '9' {
        i += 1
    }
    i
}

fn lower(s: str) -> str {
    var b = bytes(s)
    for i in 0..b.len {
        if b[i] >= 'A' && b[i] <= 'Z' {
            b[i] += 32
        }
    }
    str(b)
}

fn special(s: str) -> bool {
    var rest = lower(s)
    if rest.len > 0 && (rest[0] == '+' || rest[0] == '-') {
        rest = rest[1..rest.len]
    }
    rest == "inf" || rest == "infinity" || rest == "nan"
}

fn syntax(s: str) -> i64? {
    var i = 0
    if s[0] == '+' || s[0] == '-' {
        i = 1
    }
    let whole = digits(s, i)
    var end = whole
    if end < s.len && s[end] == '.' {
        end = digits(s, end + 1)
    }
    if whole == i && end <= whole + 1 {
        return i
    }
    if end < s.len && (s[end] == 'e' || s[end] == 'E') {
        var exp = end + 1
        if exp < s.len && (s[exp] == '+' || s[exp] == '-') {
            exp += 1
        }
        let last = digits(s, exp)
        if last == exp {
            return exp
        }
        end = last
    }
    if end < s.len {
        return end
    }
    none
}

pub fn parse_float(s: str) -> f64 ! ParseError {
    if s.len == 0 {
        fail Empty
    }
    if !special(s) {
        match syntax(s) {
            some(at) => fail Invalid(at)
            none => {}
        }
    }
    let x = strtod(cstr(s), null)
    if !special(s) && (x > 1.7976931348623157e308 || x < -1.7976931348623157e308) {
        fail Overflow
    }
    x
}

pub fn radix(n: i64, base: i64) -> str {
    if n == 0 {
        return "0"
    }
    let symbols = "0123456789abcdefghijklmnopqrstuvwxyz"
    var out: []u8 = []
    var rest = n
    for rest != 0 {
        var d = rest % base
        if d < 0 {
            d = -d
        }
        push(mut out, symbols[d])
        rest /= base
    }
    if n < 0 {
        push(mut out, '-')
    }
    for i in 0..out.len / 2 {
        let j = out.len - 1 - i
        let swap = out[i]
        out[i] = out[j]
        out[j] = swap
    }
    str(out)
}

pub fn hex(n: i64) -> str {
    radix(n, 16)
}

pub fn fixed(x: f64, places: i64) -> str {
    var size = 64
    for {
        var buf: []u8 = []
        for i in 0..size {
            push(mut buf, 0)
        }
        let at = pin(buf)
        let n = i64(snprintf(at, size, cstr("%.*f"), i32(places), x))
        unpin(at)
        if n < size {
            return str(buf[0..n])
        }
        size = n + 1
    }
}
