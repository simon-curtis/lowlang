import std/ini
import std/text

/// Reads a config file, changes one value, adds a section and writes the result back out.
fn main() {
    let source = "; service config\nname = gateway\n\n[server]\nhost = example.com\nport: 8080\ngreeting = \"  hello  \"\n\n[logging]\nlevel = info\n"
    var config = ini.parse(source) catch {
        Syntax(line, message) => {
            print("line {line}: {message}")
            return
        }
    }

    print("sections: {text.join(config.sections(), ", ")}")
    print("server keys: {text.join(config.keys("server"), ", ")}")
    print("port: {config.get("server", "port") ?? "unset"}")
    print("timeout: {config.get("server", "timeout") ?? "unset"}")

    config.set("server", "port", "9090")
    config.set("logging", "level", "debug")
    config.set("metrics", "enabled", "true")
    config.set("metrics", "tag", " padded ")
    print(ini.format(config))

    let repeated = ini.parse_with("[mirrors]\nurl = a\nurl = b\nurl = c\n", ini.Options { collect: true }) or return
    print("mirrors: {text.join(repeated.get_all("mirrors", "url"), ", ")}")
    let last = ini.parse("[mirrors]\nurl = a\nurl = b\nurl = c\n") or return
    print("last wins: {text.join(last.get_all("mirrors", "url"), ", ")}")

    let bad = ini.parse("[server\nhost = x\n") catch {
        Syntax(line, message) => {
            print("line {line}: {message}")
            return
        }
    }
    print("{bad.sections.len} sections")
}
