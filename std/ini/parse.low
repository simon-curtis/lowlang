import std/text

/// Options for `parse_with`.
pub struct Options {
    /// Keeps every entry of a repeated key when `true`; when `false`, a repeated key within a section replaces the earlier entry in place, so the last value wins. Defaults to `false`.
    pub collect: bool = false
}

/// Parses INI text into a `Document`, with default `Options`.
///
/// See `parse_with`.
pub fn parse(source: str) -> Document ! Error {
    parse_with(source, Options {})
}

/// Parses INI text into a `Document`.
///
/// A leading UTF-8 byte order mark is dropped. Lines are split at `\n`; a `\r` before it is trimmed away. A line whose first non-blank character is `;` or `#` is a comment, and blank lines are skipped. `[name]` starts a section, and a header may be followed by a comment; repeating a name continues the same section. Entries before the first header belong to the unnamed section. An entry is split at the first `=` or `:`, and key and value are trimmed. An unquoted value is taken as it is, so `;` and `#` inside it are part of the value. A value starting with `"` is quoted: it understands `\n`, `\t`, `\r`, `\0`, `\\`, `\"`, `\'`, `\;`, `\#`, `\=`, `\:` and `\uXXXX` (not a surrogate), and may be followed by a comment. A line whose last non-blank character is an odd number of backslashes continues on the next line; the backslash is removed and the next line is trimmed before it is joined.
///
/// Fails with `Syntax`, which carries the line, for malformed input.
pub fn parse_with(source: str, options: Options) -> Document ! Error {
    var d = document()
    var current = d.sections[0]
    let body = text.trim_prefix(source, __str_view([0xEF, 0xBB, 0xBF]))
    let lines = text.split(body, '\n')
    var next = 0
    for next < lines.len {
        let number = next + 1
        let line = text.trim_start(lines[next])
        next += 1
        if line.len == 0 || line[0] == ';' || line[0] == '#' {
            continue
        }
        if line[0] == '[' {
            let name = header(line, number)?
            current = ensure(mut d, name)
            continue
        }
        let logical = join_continuations(lines, mut next, line)
        let e = entry(logical, number)?
        record(current, e, options.collect)
    }
    d
}

fn record(s: *Section, e: Entry, collect: bool) {
    if !collect {
        for i, existing in s.entries {
            if existing.key == e.key {
                s.entries[i] = e
                return
            }
        }
    }
    push(mut s.entries, e)
}

fn join_continuations(lines: []str, mut next: i64, first: str) -> str {
    var out: []u8 = []
    var physical = text.trim_end(first)
    for {
        let continues = text.trailing_backslashes(physical) % 2 == 1 && next < lines.len
        if !continues {
            text.append(mut out, physical)
            break
        }
        text.append(mut out, physical[..physical.len - 1])
        physical = text.trim_end(text.trim_start(lines[next]))
        next += 1
    }
    __str_view(out)
}

fn header(line: str, number: i64) -> str ! Error {
    let close = text.index_byte(line, ']')
    if close < 0 {
        fail Syntax(number, "unterminated section header")
    }
    let name = text.trim(line[1..close])
    if name.len == 0 {
        fail Syntax(number, "empty section name")
    }
    let rest = text.trim(line[close + 1..])
    if rest.len > 0 && rest[0] != ';' && rest[0] != '#' {
        fail Syntax(number, "unexpected text after section header")
    }
    name
}

fn separator(s: str) -> i64 {
    for i in 0..s.len {
        if s[i] == '=' || s[i] == ':' {
            return i
        }
    }
    -1
}

fn entry(logical: str, number: i64) -> Entry ! Error {
    let at = separator(logical)
    if at < 0 {
        fail Syntax(number, "expected = or : after key")
    }
    let key = text.trim(logical[..at])
    if key.len == 0 {
        fail Syntax(number, "empty key")
    }
    let rest = text.trim_start(logical[at + 1..])
    let value = value_of(rest, number)?
    Entry { key, value, line: number }
}

fn value_of(rest: str, number: i64) -> str ! Error {
    if rest.len == 0 || rest[0] != '"' {
        return text.trim_end(rest)
    }
    var out: []u8 = []
    var i = 1
    for i < rest.len {
        let c = rest[i]
        if c == '"' {
            let tail = text.trim(rest[i + 1..])
            if tail.len > 0 && tail[0] != ';' && tail[0] != '#' {
                fail Syntax(number, "unexpected text after quoted value")
            }
            return __str_view(out)
        }
        if c != '\\' {
            push(mut out, c)
            i += 1
            continue
        }
        i += escape(mut out, rest, i + 1, number)?
    }
    fail Syntax(number, "unterminated quoted value")
}

fn escape(mut out: []u8, s: str, at: i64, number: i64) -> i64 ! Error {
    if at >= s.len {
        fail Syntax(number, "dangling backslash")
    }
    let c = s[at]
    if c == 'u' {
        append_unicode(mut out, s, at + 1, number)?
        return 6
    }
    let plain: u8 = match c {
        == 'n' => '\n'
        == 't' => '\t'
        == 'r' => '\r'
        == '0' => 0
        == '\\' => '\\'
        == '"' => '"'
        == '\'' => '\''
        == ';' => ';'
        == '#' => '#'
        == '=' => '='
        == ':' => ':'
        _ => fail Syntax(number, "unknown escape")
    }
    push(mut out, plain)
    2
}

fn append_unicode(mut out: []u8, s: str, at: i64, number: i64) ! Error {
    if at + 4 > s.len {
        fail Syntax(number, "short unicode escape")
    }
    let code = text.parse_hex_at(s, at, 4) or fail Syntax(number, "bad unicode escape")
    if !text.is_scalar(u32(code)) {
        fail Syntax(number, "surrogate in unicode escape")
    }
    text.append_char(mut out, u32(code))
}
