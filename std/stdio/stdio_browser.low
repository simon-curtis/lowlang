import std/io

extern "low" {
    fn read(fd: i64, buf: ptr, n: i64) -> i64
    fn write(fd: i64, buf: ptr, n: i64)
    fn halt(code: i64)
}

fn stream(fd: i64) -> io.Stream {
    io.Stream {
        read: fn(buf) { receive(fd, buf) }
        write: fn(data) { send(fd, data) }
        close: fn() {}
    }
}

fn receive(fd: i64, buf: []u8) -> i64 ! io.Error {
    let n = read(fd, __slice_ptr(buf), buf.len)
    if n < 0 {
        fail io.Error.NotConnected
    }
    n
}

fn send(fd: i64, data: []u8) -> i64 ! io.Error {
    write(fd, __slice_ptr(data), data.len)
    data.len
}
