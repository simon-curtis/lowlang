import std/io

/// Returns a stream over standard input.
///
/// In the browser the host supplies the bytes, and a read fails with `NotConnected` when the host has no input to give.
pub fn stdin() -> io.Stream {
    stream(0)
}

/// Returns a stream over standard output.
pub fn stdout() -> io.Stream {
    stream(1)
}

/// Returns a stream over standard error.
pub fn stderr() -> io.Stream {
    stream(2)
}

/// Ends the program immediately with the status `code`.
///
/// Does not run pending `defer` blocks or drops and does not wait for other green threads. Does not return.
pub fn exit(code: i64) {
    halt(code)
}
