import std/io
import std/stdio

fn line_count(data: []u8) -> i64 {
    var lines = 0
    for b in data {
        if b == '\n' {
            lines += 1
        }
    }
    lines
}

/// Counts the bytes and lines of standard input and reports them on standard output, or the read error on standard error.
fn main() {
    let input = io.read_all(stdio.stdin()) catch {
        e => {
            io.write_all(stdio.stderr(), bytes("read standard input: {e}\n")) or {}
            stdio.exit(1)
            return
        }
    }
    let lines = line_count(input)
    io.write_all(stdio.stdout(), bytes("{input.len} bytes, {lines} lines\n")) or {}
}
