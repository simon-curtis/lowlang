import std/compress/snappy
import std/io
import std/text

/// Stores values as Snappy blocks, reads each block's decoded length from its header to refuse oversized values before decoding, and writes the same values as one framed stream.
fn main() ! io.Error {
    let values = [
        "session=a1b2c3",
        text.repeat("rows=100;", 200),
        text.repeat("x", 5000),
    ]

    var blocks: [][]u8 = []
    for v in values {
        push(mut blocks, snappy.compress_block(bytes(v)))
    }

    let budget = 2000
    for i in 0..blocks.len {
        let size = snappy.decoded_length(blocks[i])?
        if size > budget {
            print("value {i}: {size} bytes exceeds the budget of {budget}")
            continue
        }
        let value = snappy.decompress_block(blocks[i], budget)?
        print("value {i}: {size} bytes, {str(value[..14])}")
    }

    var stream: []u8 = []
    let enc = snappy.encoder(fn(chunk) {
        io.append(mut stream, chunk)
    })
    for v in values {
        enc.encode(bytes(v))?
    }
    enc.finish()?
    let joined = str(snappy.decompress(stream, 1 << 20)?)
    print("framed stream decodes to {joined.len} bytes: {joined == text.join(values, "")}")
}
