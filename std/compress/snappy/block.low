import std/compress/codec
import std/io

const max_expansion = 22
const hash_bits_limit = 16

fn read_length(data: []u8, mut at: i64) -> i64 ! io.Error {
    let length = codec.read_varint(data, mut at, 5)?
    if length > 0xFFFFFFFF {
        fail Malformed
    }
    i64(length)
}

/// Returns the decoded length stored in the header of the Snappy block `data`.
///
/// Reads only the leading varint. Fails with `Malformed` when it is truncated, longer than five bytes or above `0xFFFFFFFF`.
pub fn decoded_length(data: []u8) -> i64 ! io.Error {
    var at = 0
    read_length(data, mut at)?
}

/// Returns the bytes decoded from the Snappy block `data`, which is the raw block format with no framing.
///
/// Fails with `TooLarge` when the decoded length in the header exceeds `limit` and with `Malformed` when the header is invalid, claims more than 22 times the compressed size or the block does not decode to exactly that length.
pub fn decompress_block(data: []u8, limit: i64) -> []u8 ! io.Error {
    var at = 0
    let length = read_length(data, mut at)?
    if length > limit {
        fail TooLarge
    }
    if length > max_expansion * (data.len - at) {
        fail Malformed
    }
    let out = io.buffer(length)
    unpack(data, at, out)?
    out
}

fn unpack(data: []u8, start: i64, out: []u8) ! io.Error {
    let n = out.len
    var ip = start
    var op = 0
    for ip < data.len {
        let tag = i64(data[ip])
        ip += 1
        let kind = tag & 3
        if kind == 0 {
            var len = tag >> 2
            if len >= 60 {
                let width = len - 59
                if ip + width > data.len {
                    fail Malformed
                }
                len = i64(io.uint_le(data, ip, width))
                ip += width
            }
            len += 1
            if len > data.len - ip || len > n - op {
                fail Malformed
            }
            io.copy(out[op..op + len], data[ip..ip + len])
            ip += len
            op += len
            continue
        }
        var len = 0
        var offset = 0
        if kind == 1 {
            if ip + 1 > data.len {
                fail Malformed
            }
            len = 4 + (tag >> 2 & 7)
            offset = (tag >> 5) << 8 | i64(data[ip])
            ip += 1
        } else if kind == 2 {
            if ip + 2 > data.len {
                fail Malformed
            }
            len = 1 + (tag >> 2)
            offset = io.le16(data, ip)
            ip += 2
        } else {
            if ip + 4 > data.len {
                fail Malformed
            }
            len = 1 + (tag >> 2)
            offset = io.le32(data, ip)
            ip += 4
        }
        if offset == 0 || offset > op || len > n - op {
            fail Malformed
        }
        codec.copy_match(out, op, offset, len)
        op += len
    }
    if op != n {
        fail Malformed
    }
}

fn max_compressed(n: i64) -> i64 {
    32 + n + n / 6
}

fn put_literal(out: *codec.Buffer, src: []u8) {
    let n = src.len - 1
    let data = out.data
    var at = out.len
    if n < 60 {
        data[at] = u8(n << 2)
        at += 1
    } else {
        var width = 1
        for n >> (8 * width) != 0 {
            width += 1
        }
        data[at] = u8((59 + width) << 2)
        at += 1
        for k in 0..width {
            data[at] = u8(n >> (8 * k))
            at += 1
        }
    }
    io.copy(data[at..], src)
    out.len = at + src.len
}

fn put_copy_piece(out: *codec.Buffer, offset: i64, len: i64) {
    let data = out.data
    let at = out.len
    if len < 12 && offset < 2048 {
        data[at] = u8(1 | (len - 4) << 2 | (offset >> 8) << 5)
        data[at + 1] = u8(offset)
        out.len = at + 2
        return
    }
    if offset < 65536 {
        data[at] = u8(2 | (len - 1) << 2)
        data[at + 1] = u8(offset)
        data[at + 2] = u8(offset >> 8)
        out.len = at + 3
        return
    }
    data[at] = u8(3 | (len - 1) << 2)
    io.set_le32(data, at + 1, offset)
    out.len = at + 5
}

fn put_copy(out: *codec.Buffer, offset: i64, length: i64) {
    var len = length
    for len >= 68 {
        put_copy_piece(out, offset, 64)
        len -= 64
    }
    if len > 64 {
        put_copy_piece(out, offset, 60)
        len -= 60
    }
    put_copy_piece(out, offset, len)
}

fn slot(v: u32, shift: i64) -> i64 {
    i64((v * 0x1E35A7BD) >> shift)
}

fn table_bits(n: i64) -> i64 {
    var bits = 8
    for bits < hash_bits_limit && 1 << bits < n {
        bits += 1
    }
    bits
}

fn compress_into(table: []u32, bits: i64, src: []u8, out: *codec.Buffer) {
    let n = src.len
    codec.reserve(out, max_compressed(n))
    out.len = codec.write_varint(out.data, out.len, u64(n))
    if n == 0 {
        return
    }
    for i in 0..table.len {
        table[i] = 0
    }
    let shift = 32 - bits
    let last = n - 4
    var ip = 0
    var anchor = 0
    for ip <= last {
        let v = io.u32_le(src, ip)
        let h = slot(v, shift)
        let cand = i64(table[h]) - 1
        table[h] = u32(ip + 1)
        if cand >= 0 && io.u32_le(src, cand) == v {
            let len = 4 + codec.match_length(src, cand + 4, ip + 4, n - ip - 4)
            let offset = ip - cand
            if offset < 65536 || len >= 8 {
                if ip > anchor {
                    put_literal(out, src[anchor..ip])
                }
                put_copy(out, offset, len)
                ip += len
                anchor = ip
                if ip <= last {
                    table[slot(io.u32_le(src, ip - 1), shift)] = u32(ip)
                }
                continue
            }
        }
        ip += 1 + ((ip - anchor) >> 5)
    }
    if anchor < n {
        put_literal(out, src[anchor..])
    }
}

/// Returns `data` compressed as one Snappy block, which is the raw block format with no framing.
///
/// The block holds the whole of `data`. `compress` and `encoder` write the framing format, which splits input into 64 KiB chunks.
pub fn compress_block(data: []u8) -> []u8 {
    let bits = table_bits(data.len)
    let table: []u32 = __make(1 << bits)
    let out = codec.buffer(max_compressed(data.len))
    compress_into(table, bits, data, out)
    codec.contents(out)
}

