import std/compress/codec
import std/hash
import std/io
import std/math

struct Inflater {
    r: *codec.BitReader
    out: []u8
    pos: i64
    flushed: i64
    total: i64
    member: i64
    limit: i64
    sink: fn([]u8) ! io.Error
    format: Format
    crc: *hash.Crc32
    adler: u32
    one: []u8
    tables: Tables
    lens: []u8
    dynamic: *codec.Tables
    fixed: *codec.Tables
    fixed_lit: i64
    fixed_dist: i64
}

fn inflater(r: *codec.BitReader, format: Format, sink: fn([]u8) ! io.Error, limit: i64) -> *Inflater {
    new(Inflater {
        r
        out: __make(98304 + 258)
        pos: 0
        flushed: 0
        total: 0
        member: 0
        limit
        sink
        format
        crc: hash.crc32_new()
        adler: 1
        one: __make(1)
        tables: tables()
        lens: __make(320)
        dynamic: codec.tables(288, 10, 16384)
        fixed: codec.tables(288, 10, 2048)
        fixed_lit: -1
        fixed_dist: -1
    })
}

fn flush_output(s: *Inflater) ! io.Error {
    emit(s, s.out[s.flushed..s.pos])?
    s.flushed = s.pos
}

fn emit(s: *Inflater, chunk: []u8) ! io.Error {
    if chunk.len == 0 {
        return
    }
    s.total += chunk.len
    if s.total > s.limit {
        fail TooLarge
    }
    s.member += chunk.len
    match s.format {
        Raw => {}
        Zlib => {
            s.adler = hash.adler32_update(s.adler, chunk)
        }
        Gzip => hash.crc32_update(s.crc, chunk)
    }
    s.sink(chunk)?
}

fn shift_window(s: *Inflater) ! io.Error {
    flush_output(s)?
    let keep = s.pos - 32768
    __memmove(s.out, s.out[keep..s.pos])
    s.pos = 32768
    s.flushed = 32768
}

fn read_stored(s: *Inflater) ! io.Error {
    codec.align_input(s.r)
    let len = codec.take(s.r, 16)?
    let check = codec.take(s.r, 16)?
    if len != ~check & 0xFFFF {
        fail Malformed
    }
    let full = s.out.len - 258
    var left = len
    for left > 0 {
        if s.pos >= full {
            shift_window(s)?
        }
        let room = math.min(full - s.pos, left)
        codec.read_bytes(s.r, s.out[s.pos..s.pos + room])?
        s.pos += room
        left -= room
    }
}

fn read_codes(s: *Inflater, t: *codec.Tables, lit: i64, dist: i64) ! io.Error {
    let r = s.r
    let lengths = s.tables
    let pool = t.pool
    let out = s.out
    let full = out.len - 258
    for {
        if s.pos >= full {
            shift_window(s)?
        }
        let sym = codec.symbol(r, pool, lit, 10)?
        if sym < 256 {
            out[s.pos] = u8(sym)
            s.pos += 1
            continue
        }
        if sym == 256 {
            return
        }
        let li = sym - 257
        if li >= 29 {
            fail Malformed
        }
        let length = lengths.len_base[li] + codec.take(r, lengths.len_extra[li])?
        let ds = codec.symbol(r, pool, dist, 8)?
        if ds >= 30 {
            fail Malformed
        }
        let distance = lengths.dist_base[ds] + codec.take(r, lengths.dist_extra[ds])?
        if distance > s.pos {
            fail Malformed
        }
        codec.copy_match(out, s.pos, distance, length)
        s.pos += length
    }
}

fn read_fixed(s: *Inflater) ! io.Error {
    if s.fixed_lit < 0 {
        s.fixed_lit = codec.build_table(s.fixed, fixed_lengths(), 10)?
        s.fixed_dist = codec.build_table(s.fixed, fixed_distance_lengths(), 8)?
    }
    read_codes(s, s.fixed, s.fixed_lit, s.fixed_dist)?
}

fn read_dynamic(s: *Inflater) ! io.Error {
    let hlit = codec.take(s.r, 5)? + 257
    let hdist = codec.take(s.r, 5)? + 1
    let hclen = codec.take(s.r, 4)? + 4
    if hlit > 286 || hdist > 30 {
        fail Malformed
    }
    let order = s.tables.order
    let lens = s.lens
    for i in 0..19 {
        lens[i] = 0
    }
    for i in 0..hclen {
        lens[order[i]] = u8(codec.take(s.r, 3)?)
    }
    let t = s.dynamic
    codec.reset_tables(t)
    let clen = codec.build_table(t, lens[..19], 7)?
    let n = hlit + hdist
    var i = 0
    for i < n {
        let sym = codec.symbol(s.r, t.pool, clen, 7)?
        if sym < 16 {
            lens[i] = u8(sym)
            i += 1
            continue
        }
        var value: u8 = 0
        var repeat = 0
        if sym == 16 {
            if i == 0 {
                fail Malformed
            }
            value = lens[i - 1]
            repeat = 3 + codec.take(s.r, 2)?
        } else if sym == 17 {
            repeat = 3 + codec.take(s.r, 3)?
        } else {
            repeat = 11 + codec.take(s.r, 7)?
        }
        if i + repeat > n {
            fail Malformed
        }
        for k in i..i + repeat {
            lens[k] = value
        }
        i += repeat
    }
    if lens[256] == 0 {
        fail Malformed
    }
    codec.reset_tables(t)
    let lit = codec.build_table(t, lens[..hlit], 10)?
    let dist = codec.build_table(t, lens[hlit..n], 8)?
    read_codes(s, t, lit, dist)?
}

fn inflate_stream(s: *Inflater) ! io.Error {
    s.pos = 0
    s.flushed = 0
    for {
        let last = codec.take(s.r, 1)?
        let kind = codec.take(s.r, 2)?
        if kind == 0 {
            read_stored(s)?
        } else if kind == 1 {
            read_fixed(s)?
        } else if kind == 2 {
            read_dynamic(s)?
        } else {
            fail Malformed
        }
        if last == 1 {
            break
        }
    }
    flush_output(s)?
    codec.align_input(s.r)
}

fn zlib_member(s: *Inflater) ! io.Error {
    let cmf = codec.take(s.r, 8)?
    let flg = codec.take(s.r, 8)?
    if cmf & 15 != 8 || cmf >> 4 > 7 || (cmf << 8 | flg) % 31 != 0 {
        fail Malformed
    }
    if flg & 0x20 != 0 {
        fail Unsupported
    }
    s.adler = 1
    inflate_stream(s)?
    var expected = 0
    for _ in 0..4 {
        let b = codec.take(s.r, 8)?
        expected = expected << 8 | b
    }
    if u32(expected) != s.adler {
        fail Malformed
    }
}

fn header_byte(s: *Inflater, header: *hash.Crc32) -> i64 ! io.Error {
    let b = codec.take(s.r, 8)?
    s.one[0] = u8(b)
    hash.crc32_update(header, s.one)
    b
}

fn header_le16(s: *Inflater, header: *hash.Crc32) -> i64 ! io.Error {
    let low = header_byte(s, header)?
    let high = header_byte(s, header)?
    low | high << 8
}

fn trailer_le32(s: *Inflater) -> i64 ! io.Error {
    var v = 0
    for k in 0..4 {
        let b = codec.take(s.r, 8)?
        v |= b << (8 * k)
    }
    v
}

fn gzip_member(s: *Inflater) ! io.Error {
    let header = hash.crc32_new()
    let id1 = header_byte(s, header)?
    let id2 = header_byte(s, header)?
    let method = header_byte(s, header)?
    if id1 != 0x1F || id2 != 0x8B || method != 8 {
        fail Malformed
    }
    let flags = header_byte(s, header)?
    if flags & 0xE0 != 0 {
        fail Malformed
    }
    for _ in 0..6 {
        header_byte(s, header)?
    }
    if flags & 4 != 0 {
        let xlen = header_le16(s, header)?
        for _ in 0..xlen {
            header_byte(s, header)?
        }
    }
    if flags & 8 != 0 {
        for header_byte(s, header)? != 0 {}
    }
    if flags & 16 != 0 {
        for header_byte(s, header)? != 0 {}
    }
    if flags & 2 != 0 {
        let want = i64(hash.crc32_sum(header)) & 0xFFFF
        let low = codec.take(s.r, 8)?
        let high = codec.take(s.r, 8)?
        if low | high << 8 != want {
            fail Malformed
        }
    }
    s.crc = hash.crc32_new()
    s.member = 0
    inflate_stream(s)?
    let crc = trailer_le32(s)?
    let size = trailer_le32(s)?
    if u32(crc) != hash.crc32_sum(s.crc) || size != s.member & 0xFFFFFFFF {
        fail Malformed
    }
}

fn run(s: *Inflater) ! io.Error {
    match s.format {
        Raw => inflate_stream(s)?
        Zlib => zlib_member(s)?
        Gzip => {
            gzip_member(s)?
            for codec.has_more(s.r)? {
                gzip_member(s)?
            }
        }
    }
}

fn decode_stream(r: *io.Reader, format: Format, sink: fn([]u8) ! io.Error, limit: i64) ! io.Error {
    let reader = codec.stream_reader(r, 16384)
    let s = inflater(reader, format, sink, limit)
    reader.before_read = fn() ! io.Error {
        flush_output(s)
    }
    run(s)?
}

fn decode_buffer(data: []u8, format: Format, limit: i64) -> []u8 ! io.Error {
    let out = codec.output_for(data, limit)
    let sink = codec.collector(out)
    let s = inflater(codec.slice_reader(data), format, sink, limit)
    run(s)?
    codec.contents(out)
}

/// Decodes a raw DEFLATE stream from `r` and passes the decoded bytes to `sink` in chunks until the input ends.
///
/// Decoding stops after the final block.
/// Fails with `TooLarge` when the output would exceed `limit` bytes, `Malformed` when the input is invalid or truncated, and with any error `r` or `sink` returns. A chunk is valid only during the call to `sink`.
pub fn decode(r: *io.Reader, sink: fn([]u8) ! io.Error, limit: i64) ! io.Error {
    decode_stream(r, Raw, sink, limit)?
}

/// Decodes a zlib stream from `r` and passes the decoded bytes to `sink` in chunks until the input ends.
///
/// The header and the Adler-32 checksum are verified. A stream that needs a preset dictionary is `Unsupported`.
/// Fails with `TooLarge` when the output would exceed `limit` bytes, `Malformed` when the input is invalid or truncated, and with any error `r` or `sink` returns. A chunk is valid only during the call to `sink`.
pub fn zlib_decode(r: *io.Reader, sink: fn([]u8) ! io.Error, limit: i64) ! io.Error {
    decode_stream(r, Zlib, sink, limit)?
}

/// Decodes gzip from `r` and passes the decoded bytes to `sink` in chunks until the input ends.
///
/// Concatenated members are decoded in turn. The header checksum, the CRC-32 and the size in each trailer are verified.
/// Fails with `TooLarge` when the output would exceed `limit` bytes, `Malformed` when the input is invalid or truncated, and with any error `r` or `sink` returns. A chunk is valid only during the call to `sink`.
pub fn gzip_decode(r: *io.Reader, sink: fn([]u8) ! io.Error, limit: i64) ! io.Error {
    decode_stream(r, Gzip, sink, limit)?
}

/// Returns the bytes decoded from a raw DEFLATE stream in `data`.
///
/// Bytes after the final block are ignored.
/// Fails with `TooLarge` when the output would exceed `limit` bytes and with `Malformed` when the input is invalid or truncated.
pub fn decompress(data: []u8, limit: i64) -> []u8 ! io.Error {
    decode_buffer(data, Raw, limit)
}

/// Returns the bytes decoded from a zlib stream in `data`.
///
/// The header and the Adler-32 checksum are verified, and bytes after the stream are ignored. A stream that needs a preset dictionary is `Unsupported`.
/// Fails with `TooLarge` when the output would exceed `limit` bytes and with `Malformed` when the input is invalid or truncated.
pub fn zlib_decompress(data: []u8, limit: i64) -> []u8 ! io.Error {
    decode_buffer(data, Zlib, limit)
}

/// Returns the bytes decoded from gzip in `data`.
///
/// Concatenated members are decoded in turn. The header checksum, the CRC-32 and the size in each trailer are verified.
/// Fails with `TooLarge` when the output would exceed `limit` bytes and with `Malformed` when the input is invalid or truncated.
pub fn gzip_decompress(data: []u8, limit: i64) -> []u8 ! io.Error {
    decode_buffer(data, Gzip, limit)
}
