import std/compress/codec

fn fixed_code(lens: []u8, b: *codec.Builder) -> *codec.Code {
    let c = codec.code(lens.len)
    __memmove(c.lens, lens)
    codec.assign_codes(b, c.lens, c.codes)
    c
}

fn huffman(b: *codec.Builder, freq: []i64, c: *codec.Code, limit: i64) {
    codec.build(b, freq, c, limit)
    if c.used < 2 {
        c.lens[c.first] = 1
        c.lens[if c.first == 0 { 1 } else { 0 }] = 1
        codec.assign_codes(b, c.lens, c.codes)
    }
}
