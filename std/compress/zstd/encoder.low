import std/bits
import std/compress/codec
import std/hash
import std/io
import std/math

struct Params {
    wlog: i64
    hlog: i64
    clog: i64
    depth: i64
    lazy: i64
    minm: i64
    nice: i64
    skip: i64
}

/// A streaming Zstandard encoder made by `encoder`.
///
/// `encode` takes input in any chunking, `flush` writes the buffered input as blocks, and `finish` writes the last block and the content checksum. After `finish`, `encode`, `flush` and `finish` fail with `Invalid`. The frame carries no content size. A chunk is valid only during the call to `sink`.
pub struct Encoder {
    stream: *codec.Encoder
}

struct Framer {
    p: Params
    win: *codec.History
    content_size: i64
    started: bool
    sum: *hash.Xxh64
    reps: []i64
    saved: []i64
    m: *codec.Match
    lits: []u8
    nlit: i64
    seq_ll: []i32
    seq_ml: []i32
    seq_off: []i32
    nseq: i64
    ll_codes: []u8
    ml_codes: []u8
    of_codes: []u8
    out: *codec.Buffer
    body: *codec.Buffer
    tmp: *codec.Buffer
    huff: *HuffEnc
    codes: *Codes
    counts: []i64
    norm: []i32
    ll_norm: []i32
    ml_norm: []i32
    of_norm: []i32
    ll_pre: *FseEnc
    ml_pre: *FseEnc
    of_pre: *FseEnc
}

fn params(level: i64, content_size: i64) -> Params {
    let l = math.clamp(level, 1, 22)
    let depths = [1, 2, 6, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192, 256, 384, 512, 640, 768, 896, 1024, 1024, 1024]
    var wlog = math.min(18 + l, 23)
    var hlog = math.min(15 + (l + 1) / 2, 21)
    var clog = math.min(15 + l / 2 + 1, 22)
    if content_size >= 0 {
        wlog = math.max(10, math.min(wlog, bits.bit_length(u64(math.max(content_size, 2) - 1))))
        hlog = math.min(hlog, wlog + 1)
        clog = math.min(clog, wlog)
    }
    Params {
        wlog
        hlog
        clog
        depth: depths[l - 1]
        lazy: match l { < 3 => 0, < 6 => 1, _ => 2 }
        minm: if l < 3 { 5 } else { 4 }
        nice: math.min(16 * l + 16, 1024)
        skip: if l < 3 { 6 } else { 8 }
    }
}

/// Returns an encoder that writes one Zstandard frame to `sink`.
///
/// `level` is clamped to `1..22`; the window is at most 8 MiB and higher levels search more candidates.
pub fn encoder(level: i64, sink: fn([]u8) ! io.Error) -> *Encoder {
    let core = framer(level, -1, 1024)
    let stream = codec.encoder(core.out, block_size, sink, fn(chunk) { feed(core, chunk) }, fn() { sync(core) }, fn() { close(core) })
    new(Encoder { stream })
}

fn framer(level: i64, content_size: i64, capacity: i64) -> *Framer {
    let p = params(level, content_size)
    let window = 1 << p.wlog
    let span = if content_size >= 0 && content_size < 1 << 30 { math.max(content_size, 1) } else { 2 * window + 2 * block_size }
    let ll_norm = ll_default()
    let ml_norm = ml_default()
    let of_norm = of_default()
    new(Framer {
        p
        win: codec.history(window, span, p.minm, p.hlog, p.clog)
        content_size
        started: false
        sum: hash.xxh64_new(0)
        reps: [1, 4, 8]
        saved: [1, 4, 8]
        m: new(codec.Match { len: 0, off: 0 })
        lits: __make(block_size)
        nlit: 0
        seq_ll: __make(block_size / 3 + 1)
        seq_ml: __make(block_size / 3 + 1)
        seq_off: __make(block_size / 3 + 1)
        nseq: 0
        ll_codes: __make(block_size / 3 + 1)
        ml_codes: __make(block_size / 3 + 1)
        of_codes: __make(block_size / 3 + 1)
        out: codec.buffer(capacity)
        body: codec.buffer(block_size + 1024)
        tmp: codec.buffer(256)
        huff: huff_encoder()
        codes: codes()
        counts: __make(64)
        norm: __make(64)
        ll_norm
        ml_norm
        of_norm
        ll_pre: fse_encoder(ll_norm, ll_norm.len, 6)
        ml_pre: fse_encoder(ml_norm, ml_norm.len, 6)
        of_pre: fse_encoder(of_norm, of_norm.len, 5)
    })
}

fn find(e: *Framer, p: i64, end: i64) {
    codec.index_to(e.win, p, true)
    let hist = e.win.data
    e.m.len = e.p.minm - 1
    e.m.off = 0
    for k in 0..2 {
        let r = e.reps[k]
        if r <= p && r < e.win.window && hist[p] == hist[p - r] {
            let n = codec.match_length(hist, p, p - r, end - p)
            if n > e.m.len {
                e.m.len = n
                e.m.off = r
            }
        }
    }
    codec.walk(e.win.long, hist, p, end, e.win.window, e.p.nice, e.p.depth, e.m)
    codec.walk(e.win.short, hist, p, end, e.win.window, e.p.nice, math.max(2, e.p.depth / 4), e.m)
    if e.m.len < e.p.minm {
        e.m.len = 0
    }
}

fn gain(len: i64, off: i64) -> i64 {
    4 * len + 1 - bits.bit_length(u64(off + 1))
}

fn encode_offset(e: *Framer, ll: i64, off: i64) -> i64 {
    let reps = e.reps
    if ll > 0 {
        if off == reps[0] {
            return 1
        }
        if off == reps[1] {
            reps[1] = reps[0]
            reps[0] = off
            return 2
        }
        if off == reps[2] {
            reps[2] = reps[1]
            reps[1] = reps[0]
            reps[0] = off
            return 3
        }
    } else {
        if off == reps[1] {
            reps[1] = reps[0]
            reps[0] = off
            return 1
        }
        if off == reps[2] {
            reps[2] = reps[1]
            reps[1] = reps[0]
            reps[0] = off
            return 2
        }
        if off == reps[0] - 1 {
            reps[2] = reps[1]
            reps[1] = reps[0]
            reps[0] = off
            return 3
        }
    }
    reps[2] = reps[1]
    reps[1] = reps[0]
    reps[0] = off
    off + 3
}

fn add_literals(e: *Framer, from: i64, to: i64) {
    io.copy(e.lits[e.nlit..], e.win.data[from..to])
    e.nlit += to - from
}

fn add_sequence(e: *Framer, anchor: i64, p: i64, off: i64, len: i64) {
    add_literals(e, anchor, p)
    let ll = p - anchor
    let k = e.nseq
    e.seq_ll[k] = i32(ll)
    e.seq_ml[k] = i32(len - 3)
    e.seq_off[k] = i32(encode_offset(e, ll, off))
    e.nseq = k + 1
}

fn parse(e: *Framer, start: i64, end: i64) {
    e.nlit = 0
    e.nseq = 0
    let hist = e.win.data
    let limit = end - 8
    var anchor = start
    var p = start
    for p < limit {
        find(e, p, end)
        var len = e.m.len
        var off = e.m.off
        if len == 0 {
            p += 1 + ((p - anchor) >> e.p.skip)
            continue
        }
        var step = 0
        for step < e.p.lazy && len < e.p.nice && p + 1 < limit {
            find(e, p + 1, end)
            if e.m.len == 0 || gain(e.m.len, e.m.off) <= gain(len, off) + 4 {
                break
            }
            p += 1
            len = e.m.len
            off = e.m.off
            step += 1
        }
        let back = codec.extend_back(e.win, p, anchor, off)
        p -= back
        len += back
        add_sequence(e, anchor, p, off, len)
        p += len
        anchor = p
    }
    add_literals(e, anchor, end)
}

fn lit_header(w: *codec.Buffer, kind: i64, n: i64) {
    match n {
        < 32 => codec.put_byte(w, u8(kind | n << 3))
        < 4096 => codec.put_le(w, kind | 1 << 2 | n << 4, 2)
        _ => codec.put_le(w, kind | 3 << 2 | n << 4, 3)
    }
}

fn raw_literals(e: *Framer) {
    lit_header(e.body, 0, e.nlit)
    codec.put_bytes(e.body, e.lits[..e.nlit])
}

fn write_literals(e: *Framer) {
    let n = e.nlit
    let lits = e.lits[..n]
    if n == 0 {
        raw_literals(e)
        return
    }
    let h = e.huff
    let distinct = huff_count(h, lits)
    if distinct == 1 {
        lit_header(e.body, 1, n)
        codec.put_byte(e.body, lits[0])
        return
    }
    if n < 64 {
        raw_literals(e)
        return
    }
    huff_build(h, 11)
    if !huff_describe(h) || h.table.len + huff_size(h) + 8 >= n - (n >> 5) {
        raw_literals(e)
        return
    }
    let four = n >= 256
    let head = match n { <= 1023 => 3, <= 16383 => 4, _ => 5 }
    let start = e.body.len
    codec.put_le(e.body, 0, head)
    codec.put_bytes(e.body, codec.contents(h.table))
    if four {
        let jump = e.body.len
        codec.put_le(e.body, 0, 6)
        let seg = (n + 3) / 4
        for k in 0..4 {
            let from = k * seg
            let to = if k == 3 { n } else { from + seg }
            let s0 = e.body.len
            huff_encode(h, e.body, lits[from..to])
            if k < 3 {
                io.set_le16(e.body.data, jump + 2 * k, e.body.len - s0)
            }
        }
    } else {
        huff_encode(h, e.body, lits)
    }
    let comp = e.body.len - start - head
    if comp >= n {
        e.body.len = start
        raw_literals(e)
        return
    }
    let format = if !four { 0 } else { head - 2 }
    let width = match head { 3 => 10, 4 => 14, _ => 18 }
    let header = 2 | format << 2 | n << 4 | comp << (4 + width)
    for i in 0..head {
        e.body.data[start + i] = u8(header >> (8 * i))
    }
}

fn choose(e: *Framer, symbols: []u8, n: i64, max_log: i64, norm_default: []i32, log_default: i64, pre: *FseEnc, mut mode: i64) -> *FseEnc {
    let counts = e.counts
    for s in 0..64 {
        counts[s] = 0
    }
    var top = 0
    for i in 0..n {
        let s = i64(symbols[i])
        counts[s] += 1
        if s > top {
            top = s
        }
    }
    if counts[top] == n {
        mode = 1
        codec.put_byte(e.body, u8(top))
        return fse_rle_encoder()
    }
    let pre_cost = fse_cost(counts, top + 1, norm_default, norm_default.len, log_default)
    let log = optimal_log(max_log, n, top)
    normalize(counts, top + 1, n, log, e.norm)
    codec.reset(e.tmp)
    write_ncount(e.tmp, e.norm, top + 1, log)
    let own_cost = fse_cost(counts, top + 1, e.norm, top + 1, log) + 8 * e.tmp.len
    if pre_cost <= own_cost {
        mode = 0
        return pre
    }
    mode = 2
    codec.put_bytes(e.body, codec.contents(e.tmp))
    fse_encoder(e.norm, top + 1, log)
}

fn write_sequences(e: *Framer) {
    let n = e.nseq
    match n {
        < 128 => codec.put_byte(e.body, u8(n))
        < 0x7F00 => {
            codec.put_byte(e.body, u8((n >> 8) + 128))
            codec.put_byte(e.body, u8(n))
        }
        _ => {
            codec.put_byte(e.body, 255)
            codec.put_le(e.body, n - 0x7F00, 2)
        }
    }
    if n == 0 {
        return
    }
    let codes = e.codes
    for i in 0..n {
        e.ll_codes[i] = u8(ll_code(codes, i64(e.seq_ll[i])))
        e.ml_codes[i] = u8(ml_code(codes, i64(e.seq_ml[i])))
        e.of_codes[i] = u8(bits.bit_length(u64(e.seq_off[i])) - 1)
    }
    let modes_at = e.body.len
    codec.put_byte(e.body, 0)
    var ll_mode = 0
    var of_mode = 0
    var ml_mode = 0
    let lle = choose(e, e.ll_codes, n, 9, e.ll_norm, 6, e.ll_pre, mut ll_mode)
    let ofe = choose(e, e.of_codes, n, 8, e.of_norm, 5, e.of_pre, mut of_mode)
    let mle = choose(e, e.ml_codes, n, 9, e.ml_norm, 6, e.ml_pre, mut ml_mode)
    e.body.data[modes_at] = u8(ll_mode << 6 | of_mode << 4 | ml_mode << 2)
    let ll_base = codes.ll_base
    let ll_bits = codes.ll_bits
    let ml_base = codes.ml_base
    let ml_bits = codes.ml_bits
    let last = n - 1
    var sml = fse_init(mle, i64(e.ml_codes[last]))
    var sof = fse_init(ofe, i64(e.of_codes[last]))
    var sll = fse_init(lle, i64(e.ll_codes[last]))
    var i = last
    for i >= 0 {
        let llc = e.ll_codes[i]
        let mlc = e.ml_codes[i]
        let ofc = i64(e.of_codes[i])
        if i < last {
            sof = fse_encode(e.body, ofe, sof, ofc)
            sml = fse_encode(e.body, mle, sml, i64(mlc))
            sll = fse_encode(e.body, lle, sll, i64(llc))
        }
        codec.put_bits(e.body, i64(e.seq_ll[i]) - i64(ll_base[llc]), i64(ll_bits[llc]))
        codec.put_bits(e.body, i64(e.seq_ml[i]) + 3 - i64(ml_base[mlc]), i64(ml_bits[mlc]))
        codec.put_bits(e.body, i64(e.seq_off[i]) - (1 << ofc), ofc)
        i -= 1
    }
    fse_flush(e.body, mle, sml)
    fse_flush(e.body, ofe, sof)
    fse_flush(e.body, lle, sll)
    close_bits(e.body)
}

fn start_frame(e: *Framer) {
    if e.started {
        return
    }
    e.started = true
    codec.put_le(e.out, 0xFD2FB528, 4)
    let size = e.content_size
    if size < 0 {
        codec.put_byte(e.out, 0x04)
        codec.put_byte(e.out, u8((e.p.wlog - 10) << 3))
    } else if size < 256 {
        codec.put_byte(e.out, 0x24)
        codec.put_byte(e.out, u8(size))
    } else if size < 65536 + 256 {
        codec.put_byte(e.out, 0x64)
        codec.put_le(e.out, size - 256, 2)
    } else if size < 1 << 32 {
        codec.put_byte(e.out, 0xA4)
        codec.put_le(e.out, size, 4)
    } else {
        codec.put_byte(e.out, 0xE4)
        codec.put_le(e.out, size, 8)
    }
}

fn uniform(data: []u8) -> bool {
    let v = data[0]
    for b in data {
        if b != v {
            return false
        }
    }
    true
}

fn compress_block(e: *Framer, start: i64, end: i64, last: bool) {
    start_frame(e)
    let flag = if last { 1 } else { 0 }
    let size = end - start
    let data = e.win.data[start..end]
    if size > 0 && uniform(data) {
        codec.put_le(e.out, flag | 1 << 1 | size << 3, 3)
        codec.put_byte(e.out, data[0])
        return
    }
    if size > 16 {
        let reps = e.reps
        let saved = e.saved
        for k in 0..3 {
            saved[k] = reps[k]
        }
        parse(e, start, end)
        codec.reset(e.body)
        write_literals(e)
        write_sequences(e)
        if e.body.len < size {
            codec.put_le(e.out, flag | 2 << 1 | e.body.len << 3, 3)
            codec.put_bytes(e.out, codec.contents(e.body))
            return
        }
        for k in 0..3 {
            reps[k] = saved[k]
        }
    }
    codec.put_le(e.out, flag | size << 3, 3)
    codec.put_bytes(e.out, data)
}

fn feed(e: *Framer, data: []u8) {
    var at = 0
    for at < data.len {
        let n = codec.append(e.win, data[at..])
        hash.xxh64_update(e.sum, data[at..at + n])
        at += n
        for e.win.fill - e.win.pos > block_size {
            compress_block(e, e.win.pos, e.win.pos + block_size, false)
            e.win.pos += block_size
        }
    }
}

fn sync(e: *Framer) {
    for e.win.pos < e.win.fill {
        let end = math.min(e.win.fill, e.win.pos + block_size)
        compress_block(e, e.win.pos, end, false)
        e.win.pos = end
    }
}

fn close(e: *Framer) {
    for {
        let end = math.min(e.win.fill, e.win.pos + block_size)
        compress_block(e, e.win.pos, end, end == e.win.fill)
        e.win.pos = end
        if end == e.win.fill {
            break
        }
    }
    codec.put_le(e.out, i64(hash.xxh64_sum(e.sum) & 0xFFFFFFFF), 4)
}

/// Compresses `data` and passes each completed block to the encoder's `sink`.
///
/// Input is buffered until a block is full, so a call can produce no output. Fails with `Invalid` after `finish`, and with any error `sink` returns.
pub fn encode(e: *Encoder, data: []u8) ! io.Error {
    codec.encode(e.stream, data)?
}

/// Writes the buffered input as blocks, so a decoder can read everything encoded so far.
///
/// Fails with `Invalid` after `finish`, and with any error `sink` returns.
pub fn flush(e: *Encoder) ! io.Error {
    codec.flush(e.stream)?
}

/// Writes the buffered input as the last block, followed by the low 32 bits of the XXH64 content checksum.
///
/// Fails with `Invalid` when the stream is already finished, and with any error `sink` returns.
pub fn finish(e: *Encoder) ! io.Error {
    codec.finish(e.stream)?
}

/// Returns `data` compressed as one Zstandard frame.
///
/// `level` is clamped to `1..22`. The frame header records the content size and the window is reduced for small inputs.
pub fn compress(data: []u8, level: i64) -> []u8 {
    let e = framer(level, data.len, data.len / 2 + 64)
    feed(e, data)
    close(e)
    codec.contents(e.out)
}
