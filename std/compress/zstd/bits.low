import std/bits
import std/compress/codec
import std/io

struct BitIn {
    buf: []u8
    start: i64
    ptr: i64
    bits: u64
    used: i64
}

fn bit_in(buf: []u8, start: i64, end: i64) -> BitIn ! io.Error {
    if end <= start || end > buf.len || buf[end - 1] == 0 {
        fail Malformed
    }
    let padding = 9 - bits.bit_length(u64(buf[end - 1]))
    let size = end - start
    if size >= 8 {
        return BitIn { buf, start, ptr: end - 8, bits: io.u64_le(buf, end - 8), used: padding }
    }
    var acc: u64 = 0
    for i in 0..size {
        acc |= u64(buf[start + i]) << (8 * i)
    }
    BitIn { buf, start, ptr: start, bits: acc, used: padding + (8 - size) * 8 }
}

fn refill(mut b: BitIn) {
    var step = b.used >> 3
    if b.ptr - step < b.start {
        step = b.ptr - b.start
    }
    if step > 0 {
        b.ptr -= step
        b.used -= step * 8
        b.bits = io.u64_le(b.buf, b.ptr)
    }
}

fn read_bits(mut b: BitIn, n: i64) -> i64 {
    if b.used + n > 64 {
        refill(mut b)
    }
    let v = b.bits << b.used >> (64 - n)
    b.used += n
    i64(v)
}

fn bits_left(b: BitIn) -> i64 {
    (b.ptr - b.start) * 8 + 64 - b.used
}

fn close_bits(w: *codec.Buffer) {
    codec.put_bits(w, 1, 1)
    codec.align(w)
}
