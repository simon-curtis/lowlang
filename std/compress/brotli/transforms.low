fn transform_affixes() -> []str {
    [
        "", " ", " the ", "s ", " of ", " and ", ", ", " in ",
        " to ", "e ", "\"", ".", "\">", "\n", "]", " for ",
        " a ", " that ", ". ", " with ", "'", " from ", " by ", ". The ",
        " on ", " as ", " is ", "ing ", "\n\t", ":", "ed ", "(",
        " at ", "ly ", "=\"", ".com/", " of the ", ". This ", ",", " not ",
        "er ", "al ", "='", "ful ", "ive ", "less ", "est ", "ize ",
        " ", "ous ",
    ]
}

