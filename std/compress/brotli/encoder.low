import std/bits
import std/compress/codec
import std/io
import std/math

/// A streaming Brotli encoder made by `encoder`.
///
/// `encode` takes input in any chunking, `flush` ends the data written so far on a byte boundary, and `finish` ends the stream. After `finish`, `encode`, `flush` and `finish` fail with `Invalid`. A chunk is valid only during the call to `sink`.
pub struct Encoder {
    stream: *codec.Encoder
}

struct Compressor {
    level: i64
    max_distance: i64
    full: i64
    block: i64
    hist: []u8
    start: i64
    fill: i64
    done: i64
    inserted: i64
    head: []u32
    chain: []u32
    hash_shift: u32
    depth: i64
    nice: i64
    lazy: bool
    distances: []i64
    saved: []i64
    last: i64
    inserts: []u32
    copies: []u32
    dcodes: []u32
    dextras: []u32
    icodes: []u32
    ccodes: []u32
    symbols: []u32
    commands: i64
    out: *codec.Buffer
    builder: *codec.Builder
    tables: Tables
    command_freq: []i64
    distance_freq: []i64
    length_freq: []i64
    literals: *LiteralModel
    command_code: *codec.Code
    distance_code: *codec.Code
    length_code: *codec.Code
    run_syms: []u8
    run_extra: []u8
}

struct Match {
    len: i64
    distance: i64
    score: i64
}

fn window_bits(size: i64) -> i64 {
    var width = 10
    for width < 22 && (1 << width) - 16 < size {
        width += 1
    }
    width
}

fn compressor(level: i64, window: i64, capacity: i64) -> *Compressor {
    let clamped = math.clamp(level, 0, 11)
    let full = 1 << window
    let block = if full < 1 << 18 { full } else { 1 << 18 }
    let hash_bits = if clamped < 4 { 15 } else { 17 }
    let hist_size = if 2 * full < 65536 { 2 * full } else { 65536 }
    let chain_size = if full < 65536 { full } else { 65536 }
    let e = new(Compressor {
        level: clamped
        max_distance: full - 16
        full
        block
        hist: __make(hist_size)
        start: 0
        fill: 0
        done: 0
        inserted: 0
        head: __make(1 << hash_bits)
        chain: __make(chain_size)
        hash_shift: u32(32 - hash_bits)
        depth: if clamped <= 1 { 1 } else { 1 << (clamped - 1) }
        nice: if clamped < 5 { 32 } else { 16 << (clamped / 2) }
        lazy: clamped >= 4
        distances: [16, 15, 11, 4]
        saved: __make(4)
        last: 0
        inserts: __make(1024)
        copies: __make(1024)
        dcodes: __make(1024)
        dextras: __make(1024)
        icodes: __make(1024)
        ccodes: __make(1024)
        symbols: __make(1024)
        commands: 0
        out: codec.buffer(capacity)
        builder: codec.builder(704)
        tables: tables()
        command_freq: __make(704)
        distance_freq: __make(64)
        length_freq: __make(18)
        literals: literal_model(if clamped < 5 { 1 } else { clamped * 3 - 11 })
        command_code: codec.code(704)
        distance_code: codec.code(64)
        length_code: codec.code(18)
        run_syms: __make(720)
        run_extra: __make(720)
    })
    write_window_bits(e.out, window)
    e
}

/// Returns an encoder that writes a Brotli stream with a 22-bit window to `sink`.
///
/// `level` is clamped to `0..11`; `0` stores the data in uncompressed meta-blocks.
pub fn encoder(level: i64, sink: fn([]u8) ! io.Error) -> *Encoder {
    let core = compressor(level, 22, 65536)
    let stream = codec.encoder(core.out, 65536, sink, fn(chunk) { feed(core, chunk) }, fn() { sync(core) }, fn() { close(core) })
    new(Encoder { stream })
}

fn write_window_bits(w: *codec.Buffer, window: i64) {
    match window {
        16 => codec.put_bits(w, 0, 1)
        17 => codec.put_bits(w, 1, 7)
        > 17 => {
            codec.put_bits(w, 1, 1)
            codec.put_bits(w, window - 17, 3)
        }
        _ => {
            codec.put_bits(w, 1, 1)
            codec.put_bits(w, 0, 3)
            codec.put_bits(w, window - 8, 3)
        }
    }
}

fn make_room(e: *Compressor) {
    if e.hist.len < 2 * e.full {
        let grown: []u8 = __make(e.hist.len * 2)
        __memmove(grown, e.hist[..e.fill])
        e.hist = grown
        return
    }
    let stale = e.done - e.max_distance - e.start
    __memmove(e.hist, e.hist[stale..e.fill])
    e.start += stale
    e.fill -= stale
}

fn take_input(e: *Compressor, data: []u8) -> i64 {
    if e.fill == e.hist.len {
        make_room(e)
    }
    let n = __memmove(e.hist[e.fill..], data)
    e.fill += n
    for e.start + e.fill - e.done >= e.block {
        write_block(e, e.block)
    }
    n
}

fn feed(e: *Compressor, data: []u8) {
    var rest = data
    for rest.len > 0 {
        let n = take_input(e, rest)
        rest = rest[n..]
    }
}

fn write_pending(e: *Compressor) {
    let pending = e.start + e.fill - e.done
    if pending > 0 {
        write_block(e, pending)
    }
}

fn sync(e: *Compressor) {
    write_pending(e)
    codec.put_bits(e.out, 0, 1)
    codec.put_bits(e.out, 3, 2)
    codec.put_bits(e.out, 0, 3)
    codec.align(e.out)
}

fn close(e: *Compressor) {
    write_pending(e)
    codec.put_bits(e.out, 3, 2)
    codec.align(e.out)
}

/// Compresses `data` and passes the compressed bytes that are ready to the encoder's `sink`.
///
/// Input is buffered and written in meta-blocks of up to 256 KiB, so a call can produce no output. Fails with `Invalid` after `finish`, and with any error `sink` returns.
pub fn encode(e: *Encoder, data: []u8) ! io.Error {
    codec.encode(e.stream, data)?
}

/// Writes the buffered input and an empty metadata meta-block that pads the output to a byte boundary, so a decoder can read everything encoded so far.
///
/// Fails with `Invalid` after `finish`, and with any error `sink` returns.
pub fn flush(e: *Encoder) ! io.Error {
    codec.flush(e.stream)?
}

/// Writes the buffered input and the last meta-block, ending the stream.
///
/// Fails with `Invalid` when the stream is already finished, and with any error `sink` returns.
pub fn finish(e: *Encoder) ! io.Error {
    codec.finish(e.stream)?
}

fn write_length_header(w: *codec.Buffer, length: i64) {
    let m = length - 1
    let nibbles = if m < 1 << 16 { 4 } else if m < 1 << 20 { 5 } else { 6 }
    codec.put_bits(w, 0, 1)
    codec.put_bits(w, nibbles - 4, 2)
    codec.put_bits(w, m, 4 * nibbles)
}

fn write_uncompressed(e: *Compressor, length: i64) {
    let w = e.out
    write_length_header(w, length)
    codec.put_bits(w, 1, 1)
    codec.align(w)
    let at = e.done - e.start
    codec.put_bytes(w, e.hist[at..at + length])
}

fn write_block(e: *Compressor, length: i64) {
    if e.level == 0 {
        write_uncompressed(e, length)
        e.done += length
        return
    }
    let w = e.out
    codec.flush_bits(w)
    let start = codec.mark(w)
    __memmove(e.saved, e.distances)
    let last = e.last
    parse(e, e.done, e.done + length)
    write_compressed(e, length)
    codec.flush_bits(w)
    if w.len - start.len > length + 3 {
        codec.rewind(w, start)
        __memmove(e.distances, e.saved)
        e.last = last
        write_uncompressed(e, length)
    }
    e.done += length
}

fn hash_at(e: *Compressor, i: i64) -> i64 {
    let h = e.hist
    let v = u32(h[i]) | u32(h[i + 1]) << 8 | u32(h[i + 2]) << 16 | u32(h[i + 3]) << 24
    i64((v * 0x1E35A7BD) >> e.hash_shift)
}

fn grow_chain(e: *Compressor, need: i64) {
    var size = e.chain.len
    for size < need && size < e.full {
        size *= 2
    }
    if size == e.chain.len {
        return
    }
    let grown: []u32 = __make(size)
    __memmove(grown, e.chain)
    e.chain = grown
}

fn insert_until(e: *Compressor, p: i64) {
    let available = e.start + e.fill - 4
    let stop = if p <= available { p } else { available + 1 }
    if stop > e.chain.len && e.chain.len < e.full {
        grow_chain(e, stop)
    }
    let mask = e.chain.len - 1
    var q = e.inserted
    for q < stop {
        let h = hash_at(e, q - e.start)
        e.chain[q & mask] = e.head[h]
        e.head[h] = u32(q)
        q += 1
    }
    if p > e.inserted {
        e.inserted = p
    }
}

fn recent_distance(e: *Compressor, back: i64) -> i64 {
    e.distances[(e.last - back) & 3]
}

fn find_match(e: *Compressor, p: i64, end: i64) -> Match {
    var best = Match { len: 0, distance: 0, score: 100 }
    let limit = end - p
    if limit < 3 {
        return best
    }
    let h = e.hist
    let i = p - e.start
    let reach = if p - e.start < e.max_distance { p - e.start } else { e.max_distance }
    for k in 0..4 {
        let d = recent_distance(e, k + 1)
        if d > reach || h[i - d] != h[i] {
            continue
        }
        let len = codec.match_length(h, i - d, i, limit)
        if len >= 3 {
            let score = 135 * len + if k == 0 { 15 } else { -40 }
            if score > best.score {
                best = Match { len, distance: d, score }
            }
        }
    }
    if limit < 4 || i + 4 > e.fill {
        return best
    }
    let mask = e.chain.len - 1
    var candidate = e.head[hash_at(e, i)]
    var previous = 0
    for _ in 0..e.depth {
        let d = i64(u32(p) - candidate)
        if d <= previous || d > reach {
            break
        }
        previous = d
        let j = i - d
        if best.len < limit && h[j + best.len] == h[i + best.len] {
            let len = codec.match_length(h, j, i, limit)
            if len >= 4 {
                let score = 135 * len - 30 * (bits.bit_length(u64(d)) - 1)
                if score > best.score {
                    best = Match { len, distance: d, score }
                    if len >= e.nice {
                        break
                    }
                }
            }
        }
        candidate = e.chain[(p - d) & mask]
    }
    best
}

fn doubled(column: []u32) -> []u32 {
    let grown: []u32 = __make(column.len * 2)
    __memmove(grown, column)
    grown
}

fn grow_commands(e: *Compressor) {
    e.inserts = doubled(e.inserts)
    e.copies = doubled(e.copies)
    e.dcodes = doubled(e.dcodes)
    e.dextras = doubled(e.dextras)
    e.icodes = doubled(e.icodes)
    e.ccodes = doubled(e.ccodes)
    e.symbols = doubled(e.symbols)
}

fn short_code(e: *Compressor, d: i64) -> i64 {
    for k in 0..4 {
        if recent_distance(e, k + 1) == d {
            return k
        }
    }
    let deltas: []i64 = [-1, 1, -2, 2, -3, 3]
    for k in 0..6 {
        if recent_distance(e, 1) + deltas[k] == d {
            return 4 + k
        }
        if recent_distance(e, 2) + deltas[k] == d {
            return 10 + k
        }
    }
    -1
}

fn add_command(e: *Compressor, insert: i64, copy: i64, distance: i64) {
    if e.commands == e.inserts.len {
        grow_commands(e)
    }
    let n = e.commands
    e.inserts[n] = u32(insert)
    e.copies[n] = u32(copy)
    e.commands = n + 1
    if distance == 0 {
        e.dcodes[n] = 0xFFFF
    } else {
        var code = short_code(e, distance)
        var extra = 0
        if code < 0 {
            let x = distance + 3
            let width = bits.bit_length(u64(x)) - 2
            let high = (x >> width) & 1
            code = 16 + 2 * (width - 1) + high
            extra = x - ((2 + high) << width)
        }
        e.dcodes[n] = u32(code)
        e.dextras[n] = u32(extra)
        if code != 0 {
            e.distances[e.last & 3] = distance
            e.last += 1
        }
    }
    let ic = insert_code(e.tables, insert)
    let cc = copy_code(e.tables, copy)
    let dcode = e.dcodes[n]
    e.icodes[n] = u32(ic)
    e.ccodes[n] = u32(cc)
    e.symbols[n] = u32(command_symbol(ic, cc, dcode == 0 || dcode == 0xFFFF))
}

fn has_distance(e: *Compressor, n: i64) -> bool {
    e.symbols[n] >= 128 && e.dcodes[n] != 0xFFFF
}

fn parse(e: *Compressor, from: i64, end: i64) {
    e.commands = 0
    var p = from
    var literals = from
    for p < end {
        insert_until(e, p)
        var m = find_match(e, p, end)
        if m.len == 0 {
            p += 1
            continue
        }
        if e.lazy {
            for _ in 0..4 {
                if p + 1 >= end {
                    break
                }
                insert_until(e, p + 1)
                let next = find_match(e, p + 1, end)
                if next.score <= m.score + 175 {
                    break
                }
                p += 1
                m = next
            }
        }
        add_command(e, p - literals, m.len, m.distance)
        p += m.len
        literals = p
    }
    if literals < end {
        add_command(e, end - literals, 2, 0)
    }
}

fn insert_code(t: Tables, n: i64) -> i64 {
    if n < 6 {
        return n
    }
    var c = 23
    for t.insert_base[c] > n {
        c -= 1
    }
    c
}

fn copy_code(t: Tables, n: i64) -> i64 {
    if n < 10 {
        return n - 2
    }
    var c = 23
    for t.copy_base[c] > n {
        c -= 1
    }
    c
}

fn command_symbol(insert: i64, copy: i64, implicit: bool) -> i64 {
    let low = (insert & 7) << 3 | (copy & 7)
    if implicit && insert < 8 && copy < 16 {
        return (copy >> 3) << 6 | low
    }
    let cells: []i64 = [2, 3, 6, 4, 5, 8, 7, 9, 10]
    cells[3 * (insert >> 3) + (copy >> 3)] << 6 | low
}

fn distance_bits(code: i64) -> i64 {
    if code < 16 {
        0
    } else {
        1 + ((code - 16) >> 1)
    }
}

fn clear(freq: []i64) {
    for i in 0..freq.len {
        freq[i] = 0
    }
}

fn literal_context(h: []u8, k: i64, abs: i64, lut: []u8) -> i64 {
    let p1 = if abs >= 1 { i64(h[k - 1]) } else { 0 }
    let p2 = if abs >= 2 { i64(h[k - 2]) } else { 0 }
    i64(lut[1024 + p1] | lut[1280 + p2])
}

fn write_var_uint8(w: *codec.Buffer, v: i64) {
    if v == 0 {
        codec.put_bits(w, 0, 1)
        return
    }
    let width = bits.bit_length(u64(v)) - 1
    codec.put_bits(w, 1, 1)
    codec.put_bits(w, width, 3)
    codec.put_bits(w, v - (1 << width), width)
}

fn write_context_map(e: *Compressor) {
    let m = e.literals
    let n = m.clusters
    let order = m.mtf
    for i in 0..64 {
        order[i] = u8(i)
    }
    let values: []u8 = __make(64)
    clear(m.map_freq)
    for ctx in 0..64 {
        let v = m.map[ctx]
        var at = 0
        for order[at] != v {
            at += 1
        }
        for j in 0..at {
            order[at - j] = order[at - j - 1]
        }
        order[0] = v
        values[ctx] = u8(at)
        m.map_freq[at] += 1
    }
    let w = e.out
    codec.put_bits(w, 0, 1)
    write_code(e, m.map_freq[..n], m.map_code, n)
    for v in values {
        codec.put_code(w, m.map_code, i64(v))
    }
    codec.put_bits(w, 1, 1)
}

fn write_compressed(e: *Compressor, length: i64) {
    let t = e.tables
    let lut = t.context
    let h = e.hist
    let m = e.literals
    clear(m.hist)
    clear(e.command_freq)
    clear(e.distance_freq)
    var at = e.done - e.start
    for n in 0..e.commands {
        let insert = i64(e.inserts[n])
        for k in at..at + insert {
            m.hist[literal_context(h, k, k + e.start, lut) * 256 + i64(h[k])] += 1
        }
        at += insert + i64(e.copies[n])
        e.command_freq[e.symbols[n]] += 1
        if has_distance(e, n) {
            e.distance_freq[e.dcodes[n]] += 1
        }
    }
    cluster_literals(m)
    let w = e.out
    write_length_header(w, length)
    codec.put_bits(w, 0, 1)
    codec.put_bits(w, 0, 3)
    codec.put_bits(w, 0, 6)
    codec.put_bits(w, 2, 2)
    write_var_uint8(w, m.clusters - 1)
    if m.clusters > 1 {
        write_context_map(e)
    }
    codec.put_bits(w, 0, 1)
    for id in 0..m.clusters {
        write_code(e, cluster_freq(m, id), m.codes[id], 256)
    }
    write_code(e, e.command_freq, e.command_code, 704)
    write_code(e, e.distance_freq, e.distance_code, 64)
    at = e.done - e.start
    for n in 0..e.commands {
        let insert = i64(e.inserts[n])
        let copy = i64(e.copies[n])
        let ic = i64(e.icodes[n])
        let cc = i64(e.ccodes[n])
        codec.put_code(w, e.command_code, i64(e.symbols[n]))
        codec.put_bits(w, insert - t.insert_base[ic], t.insert_extra[ic])
        codec.put_bits(w, copy - t.copy_base[cc], t.copy_extra[cc])
        for k in at..at + insert {
            let ctx = literal_context(h, k, k + e.start, lut)
            codec.put_code(w, m.codes[m.map[ctx]], i64(h[k]))
        }
        at += insert + copy
        if has_distance(e, n) {
            let dcode = i64(e.dcodes[n])
            codec.put_code(w, e.distance_code, dcode)
            codec.put_bits(w, i64(e.dextras[n]), distance_bits(dcode))
        }
    }
}

fn write_simple_code(w: *codec.Buffer, c: *codec.Code, alphabet: i64) {
    let width = bits.bit_length(u64(alphabet - 1))
    codec.put_bits(w, 1, 2)
    if c.used <= 1 {
        codec.put_bits(w, 0, 2)
        codec.put_bits(w, c.first, width)
        return
    }
    let symbols: []i64 = [0, 0, 0, 0]
    var n = 0
    for len in 1..4 {
        for sym in 0..alphabet {
            if i64(c.lens[sym]) == len {
                symbols[n] = sym
                n += 1
            }
        }
    }
    codec.put_bits(w, n - 1, 2)
    for i in 0..n {
        codec.put_bits(w, symbols[i], width)
    }
    if n == 4 {
        codec.put_bits(w, if c.lens[symbols[0]] == 1 { 1 } else { 0 }, 1)
    }
}

fn add_run_symbol(e: *Compressor, at: i64, sym: u8, extra: u8) -> i64 {
    e.run_syms[at] = sym
    e.run_extra[at] = extra
    at + 1
}

fn reverse_runs(e: *Compressor, from: i64, to: i64) {
    var a = from
    var b = to - 1
    for a < b {
        let s = e.run_syms[a]
        e.run_syms[a] = e.run_syms[b]
        e.run_syms[b] = s
        let x = e.run_extra[a]
        e.run_extra[a] = e.run_extra[b]
        e.run_extra[b] = x
        a += 1
        b -= 1
    }
}

fn add_zero_run(e: *Compressor, at: i64, count: i64) -> i64 {
    var n = at
    var reps = count
    if reps == 11 {
        n = add_run_symbol(e, n, 0, 0)
        reps -= 1
    }
    if reps < 3 {
        for _ in 0..reps {
            n = add_run_symbol(e, n, 0, 0)
        }
        return n
    }
    let start = n
    reps -= 3
    for {
        n = add_run_symbol(e, n, 17, u8(reps & 7))
        reps >>= 3
        if reps == 0 {
            break
        }
        reps -= 1
    }
    reverse_runs(e, start, n)
    n
}

fn add_value_run(e: *Compressor, at: i64, previous: u8, value: u8, count: i64) -> i64 {
    var n = at
    var reps = count
    if previous != value {
        n = add_run_symbol(e, n, value, 0)
        reps -= 1
    }
    if reps == 7 {
        n = add_run_symbol(e, n, value, 0)
        reps -= 1
    }
    if reps < 3 {
        for _ in 0..reps {
            n = add_run_symbol(e, n, value, 0)
        }
        return n
    }
    let start = n
    reps -= 3
    for {
        n = add_run_symbol(e, n, 16, u8(reps & 3))
        reps >>= 2
        if reps == 0 {
            break
        }
        reps -= 1
    }
    reverse_runs(e, start, n)
    n
}

fn write_code(e: *Compressor, freq: []i64, c: *codec.Code, alphabet: i64) {
    let w = e.out
    codec.build(e.builder, freq, c, 15)
    if c.used <= 4 {
        write_simple_code(w, c, alphabet)
        return
    }
    let lens = c.lens
    var end = alphabet
    for lens[end - 1] == 0 {
        end -= 1
    }
    var runs = 0
    var previous: u8 = 8
    var i = 0
    for i < end {
        let value = lens[i]
        var j = i + 1
        for j < end && lens[j] == value {
            j += 1
        }
        if value == 0 {
            runs = add_zero_run(e, runs, j - i)
        } else {
            runs = add_value_run(e, runs, previous, value, j - i)
            previous = value
        }
        i = j
    }
    let lf = e.length_freq
    clear(lf)
    for k in 0..runs {
        lf[e.run_syms[k]] += 1
    }
    let lc = e.length_code
    codec.build(e.builder, lf, lc, 5)
    let single = lc.used == 1
    if single {
        lc.lens[lc.first] = 1
    }
    let order = e.tables.code_order
    var skip = 0
    if lc.lens[order[0]] == 0 && lc.lens[order[1]] == 0 {
        skip = if lc.lens[order[2]] == 0 { 3 } else { 2 }
    }
    var stored = 18
    if !single {
        for lc.lens[order[stored - 1]] == 0 {
            stored -= 1
        }
    }
    codec.put_bits(w, skip, 2)
    let value_bits: []i64 = [0, 7, 3, 2, 1, 15]
    let value_lens: []i64 = [2, 4, 3, 2, 2, 4]
    for k in skip..stored {
        let v = i64(lc.lens[order[k]])
        codec.put_bits(w, value_bits[v], value_lens[v])
    }
    for k in 0..runs {
        let sym = i64(e.run_syms[k])
        if !single {
            codec.put_code(w, lc, sym)
        }
        if sym == 16 {
            codec.put_bits(w, i64(e.run_extra[k]), 2)
        } else if sym == 17 {
            codec.put_bits(w, i64(e.run_extra[k]), 3)
        }
    }
}
