struct LenProbs {
    choice: []u16
    low: []u16
    mid: []u16
    high: []u16
}

struct Model {
    lc: i64
    lp: i64
    pb: i64
    state: i64
    rep0: i64
    rep1: i64
    rep2: i64
    rep3: i64
    is_match: []u16
    is_rep: []u16
    is_rep_g0: []u16
    is_rep_g1: []u16
    is_rep_g2: []u16
    is_rep0_long: []u16
    pos_slot: []u16
    spec_pos: []u16
    align: []u16
    match_len: LenProbs
    rep_len: LenProbs
    literal: []u16
}

fn probabilities(n: i64) -> []u16 {
    let p: []u16 = __make(n)
    fill(p)
    p
}

fn fill(p: []u16) {
    for i in 0..p.len {
        p[i] = 1024
    }
}

fn len_probabilities() -> LenProbs {
    LenProbs { choice: probabilities(2), low: probabilities(128), mid: probabilities(128), high: probabilities(256) }
}

fn fill_len(l: LenProbs) {
    fill(l.choice)
    fill(l.low)
    fill(l.mid)
    fill(l.high)
}

fn model(lc: i64, lp: i64, pb: i64) -> *Model {
    new(Model {
        lc
        lp
        pb
        state: 0
        rep0: 0
        rep1: 0
        rep2: 0
        rep3: 0
        is_match: probabilities(192)
        is_rep: probabilities(12)
        is_rep_g0: probabilities(12)
        is_rep_g1: probabilities(12)
        is_rep_g2: probabilities(12)
        is_rep0_long: probabilities(192)
        pos_slot: probabilities(256)
        spec_pos: probabilities(114)
        align: probabilities(16)
        match_len: len_probabilities()
        rep_len: len_probabilities()
        literal: probabilities(0x300 << (lc + lp))
    })
}

fn set_properties(m: *Model, lc: i64, lp: i64, pb: i64) {
    m.lc = lc
    m.lp = lp
    m.pb = pb
    let n = 0x300 << (lc + lp)
    if m.literal.len != n {
        m.literal = __make(n)
    }
}

fn set_properties_byte(m: *Model, b: u8) -> bool {
    if b >= 225 {
        return false
    }
    let v = i64(b)
    set_properties(m, v % 9, v / 9 % 5, v / 45)
    true
}

fn properties_byte(m: *Model) -> u8 {
    u8((m.pb * 5 + m.lp) * 9 + m.lc)
}

fn reset(m: *Model) {
    fill(m.is_match)
    fill(m.is_rep)
    fill(m.is_rep_g0)
    fill(m.is_rep_g1)
    fill(m.is_rep_g2)
    fill(m.is_rep0_long)
    fill(m.pos_slot)
    fill(m.spec_pos)
    fill(m.align)
    fill_len(m.match_len)
    fill_len(m.rep_len)
    fill(m.literal)
    m.state = 0
    m.rep0 = 0
    m.rep1 = 0
    m.rep2 = 0
    m.rep3 = 0
}

fn after_literal(s: i64) -> i64 {
    match s { < 4 => 0, < 10 => s - 3, _ => s - 6 }
}

fn after_match(s: i64) -> i64 {
    if s < 7 { 7 } else { 10 }
}

fn after_rep(s: i64) -> i64 {
    if s < 7 { 8 } else { 11 }
}

fn after_short_rep(s: i64) -> i64 {
    if s < 7 { 9 } else { 11 }
}

fn dictionary_size(b: u8) -> i64 {
    if b == 40 {
        return 0xFFFFFFFF
    }
    (2 | i64(b & 1)) << (i64(b) / 2 + 11)
}

fn dictionary_byte(size: i64) -> u8 {
    var b: u8 = 0
    for b < 40 && dictionary_size(b) < size {
        b += 1
    }
    b
}
