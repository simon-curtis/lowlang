import std/compress/codec
import std/io
import checksum = std/hash

/// A streaming xz encoder made by `encoder`.
///
/// `encode` takes input in any chunking and `finish` writes the end of the stream. The file holds at most one block of LZMA2 chunks with a CRC-64 integrity check. After `finish`, `encode` and `finish` fail with `Invalid`. A chunk is valid only during the call to `sink`.
pub struct Encoder {
    stream: *codec.Encoder
}

struct Packer {
    lz: *Lz
    res: *codec.Buffer
    crc: *checksum.Crc64
    total: i64
    compressed: i64
    stream_started: bool
    block_started: bool
}

fn append_crc32(mut b: []u8, from: i64) {
    let crc = checksum.crc32(b[from..])
    io.put_le32(mut b, i64(crc))
}

fn start_stream(p: *Packer) {
    if p.stream_started {
        return
    }
    p.stream_started = true
    var h: []u8 = [0xFD, 0x37, 0x7A, 0x58, 0x5A, 0, 0, 4]
    append_crc32(mut h, 6)
    codec.put_bytes(p.res, h)
}

fn start_block(p: *Packer) {
    if p.block_started {
        return
    }
    start_stream(p)
    p.block_started = true
    var h: []u8 = [2, 0, 0x21, 1, dictionary_byte(p.lz.dict), 0, 0, 0]
    append_crc32(mut h, 0)
    codec.put_bytes(p.res, h)
}

fn packer(level: i64, hint: i64, capacity: i64) -> *Packer {
    let l = clamp_level(level)
    let lz = lz_new(l, fitted_dict(l, hint), hint, true)
    let res = codec.buffer(capacity)
    let p = new(Packer {
        lz
        res
        crc: checksum.crc64_new()
        total: 0
        compressed: 0
        stream_started: false
        block_started: false
    })
    lz.emit = fn(chunk) {
        start_block(p)
        p.compressed += chunk.len
        codec.put_bytes(p.res, chunk)
    }
    p
}

fn pack(p: *Packer, data: []u8) {
    checksum.crc64_update(p.crc, data)
    p.total += data.len
    feed(p.lz, data)
}

fn close(p: *Packer) {
    finish_chunks(p.lz)
    start_stream(p)
    let res = p.res
    var index: []u8 = [0]
    if p.total > 0 {
        let end: []u8 = [0]
        p.lz.emit(end)
        for _ in 0..(4 - p.compressed % 4) % 4 {
            codec.put_byte(res, 0)
        }
        codec.put_le(res, i64(checksum.crc64_sum(p.crc)), 8)
        codec.put_varint(mut index, 1)
        codec.put_varint(mut index, u64(12 + p.compressed + 8))
        codec.put_varint(mut index, u64(p.total))
    } else {
        codec.put_varint(mut index, 0)
    }
    for index.len % 4 != 0 {
        push(mut index, 0)
    }
    append_crc32(mut index, 0)
    codec.put_bytes(res, index)
    var footer: []u8 = []
    io.put_le32(mut footer, index.len / 4 - 1)
    push(mut footer, 0)
    push(mut footer, 4)
    codec.put_le(res, i64(checksum.crc32(footer)), 4)
    codec.put_bytes(res, footer)
    codec.put_byte(res, 0x59)
    codec.put_byte(res, 0x5A)
}

/// Returns an encoder that writes an xz file to `sink`.
///
/// `level` is clamped to `0..9` and selects the dictionary size, from 256 KiB at `0` to 64 MiB at `9`, and the match search effort.
pub fn encoder(level: i64, sink: fn([]u8) ! io.Error) -> *Encoder {
    let core = packer(level, -1, 65536)
    let stream = codec.encoder(core.res, 65536, sink, fn(chunk) { pack(core, chunk) }, fn() {}, fn() { close(core) })
    new(Encoder { stream })
}

/// Compresses `data` and passes the compressed bytes that are ready to the encoder's `sink`.
///
/// Input is buffered, so a call can produce no output. Fails with `Invalid` after `finish`, and with any error `sink` returns.
pub fn encode(e: *Encoder, data: []u8) ! io.Error {
    codec.encode(e.stream, data)?
}

/// Writes the buffered input, the block padding and check, the index and the stream footer.
///
/// Fails with `Invalid` when the stream is already finished, and with any error `sink` returns.
pub fn finish(e: *Encoder) ! io.Error {
    codec.finish(e.stream)?
}

/// Returns `data` compressed as an xz file.
///
/// `level` is clamped to `0..9`; the dictionary is reduced for inputs smaller than it.
pub fn compress(data: []u8, level: i64) -> []u8 {
    let p = packer(level, data.len, data.len / 2 + 64)
    pack(p, data)
    close(p)
    codec.contents(p.res)
}

/// Returns `data` compressed in the `.lzma` format: a 13 byte header of properties, dictionary size and uncompressed size, then an LZMA stream.
///
/// `level` is clamped to `0..9`. The header records the size of `data`.
pub fn lzma_compress(data: []u8, level: i64) -> []u8 {
    let l = clamp_level(level)
    let dict = fitted_dict(l, data.len)
    let lz = lz_new(l, dict, data.len, false)
    feed(lz, data)
    pump(lz, true)
    flush_encoder(lz)
    let out = lz.out.data
    out[0] = properties_byte(lz.model)
    io.set_le32(out, 1, dict)
    io.set_le64(out, 5, data.len)
    codec.contents(lz.out)
}
