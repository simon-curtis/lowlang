import std/io
import std/math

/// A reader that hands out bits from the least significant end of each byte, from a slice or an `io.Reader`.
///
/// Every read that runs past the end of the input fails with `Malformed`. A reader made by `stream_reader` calls `before_read` each time it is about to ask its source for more bytes, so a decoder can pass its pending output to a sink first.
pub struct BitReader {
    /// Called before the source is read.
    pub before_read: fn() ! io.Error
    input: []u8
    at: i64
    end: i64
    bits: u64
    count: i64
    source: *io.Reader?
    eof: bool
}

/// Returns a reader over all of `data`.
pub fn slice_reader(data: []u8) -> *BitReader {
    new(BitReader { input: data, at: 0, end: data.len, bits: 0, count: 0, before_read: fn() {}, source: none, eof: false })
}

/// Returns a reader that pulls from `source` through a buffer of `size` bytes.
pub fn stream_reader(source: *io.Reader, size: i64) -> *BitReader {
    new(BitReader { input: __make(size), at: 0, end: 0, bits: 0, count: 0, before_read: fn() {}, source, eof: false })
}

fn pull(r: *BitReader) -> bool ! io.Error {
    match r.source {
        some(s) => {
            if r.eof {
                return false
            }
            r.before_read()?
            let n = io.read_some(s, r.input)?
            r.at = 0
            r.end = n
            if n == 0 {
                r.eof = true
            }
            n > 0
        }
        none => false
    }
}

/// Loads bytes into the accumulator until it holds more than 56 bits or the input ends.
///
/// Stops early, without asking the source for more, once the accumulator holds `need` bits and the buffered input is used up.
pub fn refill(r: *BitReader, need: i64) ! io.Error {
    var bits = r.bits
    var count = r.count
    for count <= 56 {
        if r.at == r.end {
            if count >= need {
                break
            }
            r.bits = bits
            r.count = count
            if !pull(r)? {
                return
            }
        }
        bits |= u64(r.input[r.at]) << u64(count)
        r.at += 1
        count += 8
    }
    r.bits = bits
    r.count = count
}

fn require(r: *BitReader, n: i64) ! io.Error {
    refill(r, n)?
    if r.count < n {
        fail Malformed
    }
}

/// Reads `n` bits as a number with the first bit read in the lowest position, for an `n` from 0 to 56.
///
/// Fails with `Malformed` when fewer than `n` bits remain.
pub fn take(r: *BitReader, n: i64) -> i64 ! io.Error {
    if r.count < n {
        require(r, n)?
    }
    let v = i64(r.bits) & ((1 << n) - 1)
    r.bits >>= u64(n)
    r.count -= n
    v
}

/// Returns the next `n` bits without consuming them, for an `n` from 0 to 56, loading more input when fewer are buffered.
///
/// Near the end of the input fewer than `n` bits can remain, and the missing high bits read as zero.
pub fn peek(r: *BitReader, n: i64) -> i64 ! io.Error {
    if r.count < n {
        refill(r, n)?
    }
    i64(r.bits) & ((1 << n) - 1)
}

/// Discards the next `n` bits, which must already be buffered by a `peek` or a `take`.
///
/// Fails with `Malformed` when fewer than `n` bits remain.
pub fn discard(r: *BitReader, n: i64) ! io.Error {
    if n > r.count {
        fail Malformed
    }
    r.bits >>= u64(n)
    r.count -= n
}

/// Returns the number of bits buffered in the accumulator, which modulo eight is the position within the current byte.
pub fn buffered_bits(r: *BitReader) -> i64 {
    r.count
}

/// Discards the bits left in the current byte.
pub fn align_input(r: *BitReader) {
    let partial = r.count % 8
    r.bits >>= u64(partial)
    r.count -= partial
}

/// Returns `true` when at least one more whole byte can be read, asking the source when the buffer is empty.
pub fn has_more(r: *BitReader) -> bool ! io.Error {
    r.count >= 8 || r.at < r.end || pull(r)?
}

/// Fills `dst` with the next whole bytes, which must start on a byte boundary.
///
/// Fails with `Malformed` when the input ends first. Call `align_input` first when a partial byte is pending.
pub fn read_bytes(r: *BitReader, dst: []u8) ! io.Error {
    var at = 0
    for at < dst.len && r.count >= 8 {
        dst[at] = u8(r.bits)
        r.bits >>= 8
        r.count -= 8
        at += 1
    }
    for at < dst.len {
        if r.at == r.end && !pull(r)? {
            fail Malformed
        }
        let n = __memmove(dst[at..], r.input[r.at..r.end])
        r.at += n
        at += n
    }
}

/// Reads exactly `dst.len` bytes from `source` into `dst`.
///
/// Fails with `Malformed` when the source ends first, and with any error the source returns.
pub fn read_full(source: *io.Reader, dst: []u8) ! io.Error {
    let got = io.read_up_to(source, dst)?
    if got < dst.len {
        fail Malformed
    }
}

/// Fills `head` from the start of the next frame or chunk and returns `true`, or returns `false` when the input has ended cleanly before its first byte.
///
/// Fails with `Malformed` when the input ends partway through `head`, and with any error the source returns.
pub fn read_head(source: *io.Reader, head: []u8) -> bool ! io.Error {
    let got = io.read_up_to(source, head)?
    if got == 0 {
        return false
    }
    if got < head.len {
        fail Malformed
    }
    true
}

/// Reads and discards `n` bytes from `source`.
///
/// Fails with `Malformed` when the source ends first, and with any error the source returns.
pub fn skip(source: *io.Reader, n: i64) ! io.Error {
    let scratch = io.buffer(math.min(n, 65536))
    var left = n
    for left > 0 {
        let step = math.min(left, scratch.len)
        read_full(source, scratch[..step])?
        left -= step
    }
}
