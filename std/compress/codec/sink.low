import std/io
import std/math

/// Passes the whole bytes ready in `b` to `sink` and empties `b` of them, calling `sink` only when there are some.
///
/// Fails with any error `sink` returns.
pub fn deliver(b: *Buffer, sink: fn([]u8) ! io.Error) ! io.Error {
    let ready = drain(b)
    if ready.len > 0 {
        sink(ready)?
    }
}

/// Returns an empty buffer for the output of decoding `input`, sized for typical expansion and never above `limit`.
pub fn output_for(input: []u8, limit: i64) -> *Buffer {
    buffer(math.min(input.len * 4 + 64, limit))
}

/// Returns everything `decode` writes to its sink when it reads `data`, for a one-shot decompress.
///
/// Fails with any error `decode` returns.
pub fn decompress(data: []u8, limit: i64, decode: fn(*io.Reader, fn([]u8) ! io.Error, i64) ! io.Error) -> []u8 ! io.Error {
    let out = output_for(data, limit)
    let source = io.bytes_reader(data)
    let sink = collector(out)
    decode(source, sink, limit)?
    contents(out)
}

/// Calls `step` with consecutive pieces of `data` of at most `size` bytes.
///
/// Fails with the first error `step` returns.
pub fn each_chunk(data: []u8, size: i64, step: fn([]u8) ! io.Error) ! io.Error {
    var rest = data
    for rest.len > 0 {
        let n = math.min(rest.len, size)
        step(rest[..n])?
        rest = rest[n..]
    }
}
