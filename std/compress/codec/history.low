import std/io

/// The input window of an LZ77 encoder: the bytes seen so far, the position up to which they have been written out, and a short-match and a long-match hash chain over them.
///
/// Made by `history`. `append` fills it and slides it forward when it is full, `index_to` adds positions to the chains, and the chains answer searches through `walk`.
pub struct History {
    /// The window storage. The first `fill` bytes hold input.
    pub data: []u8
    /// The number of bytes of `data` that hold input.
    pub fill: i64
    /// The position in `data` of the first byte not yet written out.
    pub pos: i64
    /// The chain over the short match width.
    pub short: *Chain
    /// The chain over eight-byte matches.
    pub long: *Chain
    /// The farthest back, in bytes, that a match may reach.
    pub window: i64
    next_insert: i64
}

/// Returns an empty history of `span` bytes with matches reaching back up to `window` bytes.
///
/// The short chain hashes `short_width` bytes. Both chains hash into `hash_bits` bits and remember the last `1 << link_bits` positions.
pub fn history(window: i64, span: i64, short_width: i64, hash_bits: i64, link_bits: i64) -> *History {
    new(History { data: __make(span), fill: 0, pos: 0, short: chain(short_width, hash_bits, link_bits), long: chain(8, hash_bits, link_bits), window, next_insert: 0 })
}

/// Adds the positions from the first one not yet added up to `target` to the long chain, when `deep`, and to the short chain.
pub fn index_to(h: *History, target: i64, deep: bool) {
    let data = h.data
    for i in h.next_insert..target {
        link(h.short, data, i)
        if deep {
            link(h.long, data, i)
        }
    }
    if target > h.next_insert {
        h.next_insert = target
    }
}

/// Copies the start of `input` after the bytes already held and returns the number copied.
///
/// A history that is full first slides forward so that only `window` bytes before `pos` stay, which moves `fill`, `pos` and every position in the chains back by the same amount.
pub fn append(h: *History, input: []u8) -> i64 {
    if h.fill == h.data.len {
        slide_history(h)
    }
    let n = io.copy(h.data[h.fill..], input)
    h.fill += n
    n
}

fn slide_history(h: *History) {
    let delta = h.pos - h.window
    io.copy(h.data, h.data[delta..h.fill])
    h.fill -= delta
    h.pos -= delta
    h.next_insert = if h.next_insert > delta { h.next_insert - delta } else { 0 }
    slide(h.short, delta)
    slide(h.long, delta)
}

/// Returns the number of bytes, at most `p - anchor`, by which a match found at `p` with distance `off` also matches the bytes just before `p`.
pub fn extend_back(h: *History, p: i64, anchor: i64, off: i64) -> i64 {
    let data = h.data
    var n = 0
    for p - n > anchor && p - n - off > 0 && data[p - n - 1] == data[p - n - 1 - off] {
        n += 1
    }
    n
}
