import std/compress/codec
import std/io

struct BitIn {
    source: *io.Reader
    chunk: []u8
    at: i64
    end: i64
    acc: u64
    held: i64
    eof: bool
}

fn bit_in(source: *io.Reader) -> *BitIn {
    new(BitIn { source, chunk: io.buffer(65536), at: 0, end: 0, acc: 0, held: 0, eof: false })
}

fn refill(b: *BitIn) ! io.Error {
    for b.held <= 56 {
        if b.at == b.end {
            if b.eof {
                return
            }
            let n = io.read_some(b.source, b.chunk)?
            if n == 0 {
                b.eof = true
                return
            }
            b.at = 0
            b.end = n
        }
        b.acc = b.acc << 8 | u64(b.chunk[b.at])
        b.at += 1
        b.held += 8
    }
}

fn mask(n: i64) -> u64 {
    (u64(1) << n) - 1
}

fn take(b: *BitIn, n: i64) -> i64 ! io.Error {
    if b.held < n {
        refill(b)?
        if b.held < n {
            fail Malformed
        }
    }
    b.held -= n
    i64(b.acc >> b.held & mask(n))
}

fn take_bit(b: *BitIn) -> bool ! io.Error {
    take(b, 1)? == 1
}

fn align_in(b: *BitIn) {
    b.held -= b.held % 8
}

fn exhausted(b: *BitIn) -> bool ! io.Error {
    if b.held == 0 {
        refill(b)?
    }
    b.held == 0
}

struct BitOut {
    out: *codec.Buffer
    acc: u64
    held: i64
}

fn bit_out(capacity: i64) -> *BitOut {
    new(BitOut { out: codec.buffer(capacity), acc: 0, held: 0 })
}

fn put(w: *BitOut, v: i64, n: i64) {
    let out = w.out
    if out.len + 8 > out.data.len {
        codec.reserve(out, 8)
    }
    let data = out.data
    var at = out.len
    var held = w.held + n
    let acc = w.acc << n | u64(v) & mask(n)
    for held >= 8 {
        held -= 8
        data[at] = u8(acc >> held)
        at += 1
    }
    w.acc = acc
    w.held = held
    out.len = at
}

fn align_out(w: *BitOut) {
    if w.held > 0 {
        put(w, 0, 8 - w.held)
    }
}

