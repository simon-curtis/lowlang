import std/compress/bzip2
import std/io
import std/slices
import std/text

/// Compresses the same text at block sizes 1 and 9, reads the block size back from each stream header, and shows a flipped bit being caught by the checksum.
fn main() ! io.Error {
    let doc = bytes(text.repeat("sort the rotations, then run-length the result\n", 100))

    for level in [1, 9] {
        let packed = bzip2.compress(doc, level)
        let back = bzip2.decompress(packed, 1 << 20)?
        print("level {level}: header {str(packed[..4])}, round trip {slices.equal(back, doc)}")
    }

    var damaged = slices.clone(bzip2.compress(doc, 9))
    damaged[damaged.len / 2] ^= 0x10
    let _ = bzip2.decompress(damaged, 1 << 20) catch {
        _ => {
            print("damaged stream rejected")
            return
        }
    }
    print("damage went unnoticed")
}
