import std/crypto
import std/crypto/hash
import std/crypto/x509
import std/io
import std/text

/// A certificate digest as an SDP `a=fingerprint` line carries it (RFC 8122).
pub struct Fingerprint {
    /// The hash name in lower case: `sha-1`, `sha-256`, `sha-384` or `sha-512`.
    pub algorithm: str
    /// The digest of the DER certificate.
    pub digest: u8[]
}

/// A certificate and the private key that signs for it.
pub struct Identity {
    /// The DER encoding of the certificate.
    pub certificate: u8[]
    /// The key of the certificate.
    pub key: x509.PrivateKey
}

/// Returns a new self-signed ECDSA P-256 identity with the subject `common_name`, valid from `not_before` to `not_after` in Unix seconds.
///
/// The serial number is random. Browsers make the same kind of certificate for each peer connection (RFC 8827 section 6.5).
pub fn generate_identity(common_name: str, not_before: i64, not_after: i64) -> Identity ! io.Error {
    let key = x509.generate_private_key(x509.KeyType.P256)?
    var serial = crypto.random(8)
    serial[0] = serial[0] & 0x7F
    serial[7] = serial[7] | 1
    let certificate = x509.create_self_signed(x509.Template { serial, subject: common_name, not_before, not_after }, key)?
    Identity { certificate, key }
}

fn algorithm_of(name: str) -> hash.Algorithm? {
    match name {
        "sha-1" => hash.sha1()
        "sha-256" => hash.sha256()
        "sha-384" => hash.sha384()
        "sha-512" => hash.sha512()
        _ => none
    }
}

/// Returns the digest of `certificate` under the hash `algorithm`.
///
/// Fails with `Unsupported` for a hash other than `sha-1`, `sha-256`, `sha-384` and `sha-512`.
pub fn fingerprint(algorithm: str, certificate: u8[]) -> Fingerprint ! io.Error {
    let name = text.lower(algorithm)
    let h = match algorithm_of(name) {
        some(found) => found
        none => fail Unsupported
    }
    let digest = hash.sum(h, certificate)
    Fingerprint { algorithm: name, digest }
}

/// Returns `f` as the value of an `a=fingerprint` line: the hash name, a space and the upper-case hex octets separated by colons.
pub fn format_fingerprint(f: Fingerprint) -> str {
    var out: u8[] = bytes(f.algorithm)
    out.push(' ')
    for i, b in f.digest {
        if i > 0 {
            out.push(':')
        }
        text.append_hex(mut out, i64(b), 2, true)
    }
    str(out)
}

fn nibble(c: u8) -> i64 {
    if c >= '0' && c <= '9' {
        return i64(c - '0')
    }
    if c >= 'A' && c <= 'F' {
        return i64(c - 'A') + 10
    }
    if c >= 'a' && c <= 'f' {
        return i64(c - 'a') + 10
    }
    -1
}

/// Parses the value of an `a=fingerprint` line, as `format_fingerprint` writes it.
///
/// The hash name is matched without regard to case and the octets in either case. Fails with `Malformed` for a missing space, an octet that is not two hex digits or a digest of the wrong length, and with `Unsupported` for an unknown hash.
pub fn parse_fingerprint(value: str) -> Fingerprint ! io.Error {
    let parts = text.split(text.trim(value), ' ')
    if parts.len != 2 {
        fail Malformed
    }
    let name = text.lower(parts[0])
    let h = match algorithm_of(name) {
        some(found) => found
        none => fail Unsupported
    }
    let octets = text.split(parts[1], ':')
    if octets.len != h.size {
        fail Malformed
    }
    var digest: u8[] = []
    for octet in octets {
        let pair = bytes(octet)
        if pair.len != 2 {
            fail Malformed
        }
        let high = nibble(pair[0])
        let low = nibble(pair[1])
        if high < 0 || low < 0 {
            fail Malformed
        }
        digest.push(u8(high * 16 + low))
    }
    Fingerprint { algorithm: name, digest }
}

/// Returns whether `certificate` hashes to the digest of `f`, compared in constant time.
pub fn fingerprint_matches(f: Fingerprint, certificate: u8[]) -> bool {
    let computed = fingerprint(f.algorithm, certificate) or return false
    hash.equal(computed.digest, f.digest)
}
