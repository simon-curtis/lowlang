import std/dtls
import std/dtls/session
import std/io
import std/net

fn pump(h: net.SocketHandle, incoming: chan[u8[]]) {
    let buf = io.buffer(65536)
    for {
        let packet = net.receive_from_on(h, buf) catch {
            _ => break
        }
        let data = io.buffer(packet.size)
        let _ = io.copy(data, buf[..packet.size])
        select {
            incoming <- data => {}
            else => {}
        }
    }
}

fn transport(h: net.SocketHandle, remote: net.Addr, incoming: chan[u8[]]) -> session.Transport {
    session.Transport {
        send: fn(d) {
            net.send_to_on(h, d, remote) or 0
        }
        incoming
    }
}

fn main() {
    let client_identity = dtls.generate_identity("client", 1700000000, 4102444800) or return
    let server_identity = dtls.generate_identity("server", 1700000000, 4102444800) or return
    let client_print = dtls.fingerprint("sha-256", client_identity.certificate) or return
    let server_print = dtls.fingerprint("sha-256", server_identity.certificate) or return
    using var client_socket = net.bind_udp("127.0.0.1", 0) or return
    using var server_socket = net.bind_udp("127.0.0.1", 0) or return
    let client_handle = net.detach_socket(mut client_socket)
    let server_handle = net.detach_socket(mut server_socket)
    let client_incoming = chan[u8[]](64)
    let server_incoming = chan[u8[]](64)
    spawn pump(client_handle, client_incoming)
    spawn pump(server_handle, server_incoming)
    let client_config = dtls.Config { client: true, identity: client_identity, fingerprints: [server_print] }
    let server_config = dtls.Config { client: false, identity: server_identity, fingerprints: [client_print] }
    using client = session.open(client_config, transport(client_handle, server_handle.addr, client_incoming))
    using server = session.open(server_config, transport(server_handle, client_handle.addr, server_incoming))
    session.wait_connected(client.handle) or return
    session.wait_connected(server.handle) or return
    print("connected")
    session.send(client.handle, bytes("ping")) or return
    let message = session.receive(server.handle) or return
    print("server received {str(message)}")
    session.close_session(client.handle)
}
