import std/dtls
import std/slices

fn flush(from: *dtls.Conn, to: *dtls.Conn, now: i64) {
    for {
        let datagram = dtls.poll_transmit(from) ?? break
        dtls.receive(to, datagram, now)
    }
}

fn main() {
    let client_identity = dtls.generate_identity("client", 1700000000, 4102444800) or return
    let server_identity = dtls.generate_identity("server", 1700000000, 4102444800) or return
    let client_print = dtls.fingerprint("sha-256", client_identity.certificate) or return
    let server_print = dtls.fingerprint("sha-256", server_identity.certificate) or return
    let client = dtls.conn(dtls.Config { client: true, identity: client_identity, fingerprints: [server_print], srtp_profiles: [dtls.srtp_aes128_cm_sha1_80] })
    let server = dtls.conn(dtls.Config { client: false, identity: server_identity, fingerprints: [client_print], srtp_profiles: [dtls.srtp_aes128_cm_sha1_80] })
    dtls.start(client, 0)
    for round in 0..10 {
        flush(client, server, round)
        flush(server, client, round)
    }
    print("client {dtls.state(client)} server {dtls.state(server)}")
    print("AES-128-GCM suite: {dtls.cipher_suite(client) == 0xC02B} profile {dtls.srtp_profile(client)}")
    dtls.write(client, bytes("hello")) or return
    flush(client, server, 11)
    let message = dtls.read(server) ?? []
    print("server read {str(message)}")
    let client_keys = dtls.export_keying_material(client, "EXTRACTOR-dtls_srtp", 60) or return
    let server_keys = dtls.export_keying_material(server, "EXTRACTOR-dtls_srtp", 60) or return
    print("keys agree: {client_keys.len == 60 && slices.equal(client_keys, server_keys)}")
}
