import std/crypto/aead
import std/io

const record_header = 13
/// The DTLS 1.2 protocol version code, `0xFEFD`.
pub const dtls12 = 0xFEFD
const type_change_cipher_spec = 20
const type_alert = 21
const type_handshake = 22
const type_application = 23

struct Raw {
    kind: i64
    epoch: i64
    seq: i64
    header: u8[]
    body: u8[]
}

fn split_records(datagram: u8[]) -> Raw[] {
    var out: Raw[] = []
    var at = 0
    for at < datagram.len {
        if datagram[at] & 0xE0 == 0x20 {
            at = split_unified(datagram, at, mut out)
            if at < 0 {
                break
            }
            continue
        }
        if at + record_header > datagram.len {
            break
        }
        let kind = i64(datagram[at])
        let length = io.be16(datagram, at + 11)
        if datagram[at + 1] != 0xFE || at + record_header + length > datagram.len {
            break
        }
        let epoch = io.be16(datagram, at + 3)
        let high = io.be16(datagram, at + 5)
        let low = io.be32(datagram, at + 7)
        let body = datagram[at + record_header..at + record_header + length]
        out.push(Raw { kind, epoch, seq: high << 32 | low, header: [], body })
        at += record_header + length
    }
    out
}

fn sequence_bytes(epoch: i64, seq: i64) -> u8[] {
    var out: u8[] = []
    io.put_be16(mut out, epoch)
    io.put_be16(mut out, seq >> 32)
    io.put_be32(mut out, seq & 0xFFFFFFFF)
    out
}

fn frame(kind: i64, epoch: i64, seq: i64, body: u8[]) -> u8[] {
    var out: u8[] = [u8(kind)]
    io.put_be16(mut out, dtls12)
    let number = sequence_bytes(epoch, seq)
    io.append(mut out, number)
    io.put_be16(mut out, body.len)
    io.append(mut out, body)
    out
}

struct Window {
    top: i64
    bits: u64
}

fn window() -> *Window {
    new(Window { top: -1, bits: 0 })
}

fn fresh(w: *Window, seq: i64) -> bool {
    if seq > w.top {
        return true
    }
    let behind = w.top - seq
    if behind >= 64 {
        return false
    }
    ((w.bits >> behind) & 1) == 0
}

fn mark(w: *Window, seq: i64) {
    if seq > w.top {
        let shift = seq - w.top
        w.bits = if shift >= 64 { 0 } else { w.bits << shift }
        w.bits = w.bits | 1
        w.top = seq
        return
    }
    let behind = w.top - seq
    let one: u64 = 1
    w.bits = w.bits | (one << behind)
}

struct Cipher {
    aead: aead.Aead
    iv: u8[]
    chacha: bool
}

fn overhead(c: Cipher) -> i64 {
    let explicit = if c.chacha { 0 } else { 8 }
    explicit + c.aead.tag_size
}

fn nonce_of(c: Cipher, number: u8[], explicit: u8[]) -> u8[] {
    let nonce = io.buffer(12)
    let _ = io.copy(nonce, c.iv)
    if c.chacha {
        for i in 0..8 {
            nonce[4 + i] = nonce[4 + i] ^ number[i]
        }
        return nonce
    }
    let _ = io.copy(nonce[4..], explicit)
    nonce
}

fn additional_data(number: u8[], kind: i64, length: i64) -> u8[] {
    var out: u8[] = []
    io.append(mut out, number)
    out.push(u8(kind))
    io.put_be16(mut out, dtls12)
    io.put_be16(mut out, length)
    out
}

fn seal_record(c: Cipher, kind: i64, epoch: i64, seq: i64, plain: u8[]) -> u8[] {
    let number = sequence_bytes(epoch, seq)
    let aad = additional_data(number, kind, plain.len)
    let nonce = nonce_of(c, number, number)
    let sealed = c.aead.seal(nonce, plain, aad)
    if c.chacha {
        return sealed
    }
    var out: u8[] = []
    io.append(mut out, number)
    io.append(mut out, sealed)
    out
}

fn open_record(c: Cipher, kind: i64, epoch: i64, seq: i64, body: u8[]) -> u8[] ! io.Error {
    let explicit = if c.chacha { 0 } else { 8 }
    if body.len < explicit + c.aead.tag_size {
        fail Invalid
    }
    let number = sequence_bytes(epoch, seq)
    let length = body.len - explicit - c.aead.tag_size
    let aad = additional_data(number, kind, length)
    let nonce = nonce_of(c, number, body[..explicit])
    c.aead.open(nonce, body[explicit..], aad)
}
