import std/crypto/hash
import std/io

const msg_hello_request = 0
const msg_client_hello = 1
const msg_server_hello = 2
const msg_hello_verify = 3
const msg_certificate = 11
const msg_server_key_exchange = 12
const msg_certificate_request = 13
const msg_server_hello_done = 14
const msg_certificate_verify = 15
const msg_client_key_exchange = 16
const msg_finished = 20

const ext_groups = 10
const ext_points = 11
const ext_schemes = 13
const ext_srtp = 14
const ext_master = 23
const ext_renegotiation = 0xFF01

const alert_close_notify = 0
const alert_unexpected_message = 10
const alert_handshake_failure = 40
const alert_bad_certificate = 42
const alert_illegal_parameter = 47
const alert_decode_error = 50
const alert_decrypt_error = 51
const alert_protocol_version = 70
const alert_no_renegotiation = 100
const alert_unsupported_extension = 110

const max_message = 65536
const handshake_header = 12

fn offered_schemes() -> i64[] {
    [0x0403, 0x0503]
}

fn unfragmented(kind: i64, seq: i64, body: u8[]) -> u8[] {
    var out: u8[] = [u8(kind)]
    io.put_be24(mut out, body.len)
    io.put_be16(mut out, seq)
    io.put_be24(mut out, 0)
    io.put_be24(mut out, body.len)
    io.append(mut out, body)
    out
}

struct ClientHello {
    random: u8[]
    session_id: u8[]
    cookie: u8[]
    suites: i64[]
    compressions: u8[]
    exts: Extension[]
}

fn parse_client_hello(body: u8[]) -> ClientHello ! io.Error {
    let c = cursor(body)
    let version = u16_of(c)?
    if version > 0xFEFD {
        fail Unsupported
    }
    let random = take(c, 32)?
    let session_id = vector8(c)?
    let cookie = vector8(c)?
    let block = vector16(c)?
    if session_id.len > 32 || block.len % 2 != 0 || block.len == 0 {
        fail Malformed
    }
    let compressions = vector8(c)?
    let exts = extensions(c)?
    var suites: i64[] = []
    for i in 0..block.len / 2 {
        suites.push(io.be16(block, 2 * i))
    }
    ClientHello { random, session_id, cookie, suites, compressions, exts }
}

fn cookie_for(secret: u8[], h: ClientHello) -> u8[] {
    var data: u8[] = []
    io.append(mut data, h.random)
    put_vector8(mut data, h.session_id)
    put_u16_list(mut data, h.suites)
    put_vector8(mut data, h.compressions)
    hash.hmac(hash.sha256(), secret, data)
}

struct ServerHello {
    random: u8[]
    session_id: u8[]
    suite: i64
    compression: i64
    exts: Extension[]
}

fn parse_server_hello(body: u8[]) -> ServerHello ! io.Error {
    let c = cursor(body)
    let version = u16_of(c)?
    if version != 0xFEFD {
        fail Unsupported
    }
    let random = take(c, 32)?
    let session_id = vector8(c)?
    let suite = u16_of(c)?
    let compression = u8_of(c)?
    let exts = extensions(c)?
    if session_id.len > 32 {
        fail Malformed
    }
    ServerHello { random, session_id, suite, compression, exts }
}

fn parse_hello_verify(body: u8[]) -> u8[] ! io.Error {
    let c = cursor(body)
    let version = u16_of(c)?
    if version != 0xFEFF && version != 0xFEFD {
        fail Unsupported
    }
    let cookie = vector8(c)?
    end(c)?
    cookie
}

fn parse_certificates(body: u8[]) -> u8[][] ! io.Error {
    let c = cursor(body)
    let block = vector24(c)?
    end(c)?
    let list = cursor(block)
    var out: u8[][] = []
    for left(list) > 0 {
        let entry = vector24(list)?
        if entry.len == 0 {
            fail Malformed
        }
        out.push(entry)
    }
    out
}

fn certificate_body(certificate: u8[]) -> u8[] {
    var list: u8[] = []
    put_vector24(mut list, certificate)
    var out: u8[] = []
    put_vector24(mut out, list)
    out
}

struct KeyExchange {
    group: i64
    public: u8[]
    params: u8[]
    scheme: i64
    signature: u8[]
}

fn parse_key_exchange(body: u8[]) -> KeyExchange ! io.Error {
    let c = cursor(body)
    if u8_of(c)? != 3 {
        fail Unsupported
    }
    let group = u16_of(c)?
    let public = vector8(c)?
    let params = body[..c.at]
    let scheme = u16_of(c)?
    let signature = vector16(c)?
    end(c)?
    KeyExchange { group, public, params, scheme, signature }
}

fn parse_certificate_request(body: u8[]) -> i64[] ! io.Error {
    let c = cursor(body)
    let types = vector8(c)?
    let schemes = vector16(c)?
    let _ = vector16(c)?
    end(c)?
    if types.len == 0 || schemes.len % 2 != 0 {
        fail Malformed
    }
    var out: i64[] = []
    for i in 0..schemes.len / 2 {
        out.push(io.be16(schemes, 2 * i))
    }
    out
}

fn srtp_extension(profiles: i64[]) -> u8[] {
    var out: u8[] = []
    put_u16_list(mut out, profiles)
    put_vector8(mut out, [])
    out
}

fn parse_srtp_extension(body: u8[]) -> i64[] ! io.Error {
    let c = cursor(body)
    let block = vector16(c)?
    let mki = vector8(c)?
    end(c)?
    if block.len % 2 != 0 || block.len == 0 || mki.len != 0 {
        fail Malformed
    }
    var out: i64[] = []
    for i in 0..block.len / 2 {
        out.push(io.be16(block, 2 * i))
    }
    out
}
