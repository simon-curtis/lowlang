import std/rand
import std/slices

/// Rolls a reproducible game session from fixed seeds: a shuffled deck, weighted loot drops and a sample of players.
fn main() {
    var r = rand.seeded(7)
    var deck = ["ace", "king", "queen", "jack", "ten"]
    r.shuffle(mut deck)
    print("deck {deck}")
    print("dealt {r.pick(deck) ?? "nothing"}")

    let loot = ["potion", "arrow", "gem", "crown"]
    let weights = [60.0, 30.0, 9.0, 1.0]
    let cumulative = rand.cumulative(weights)
    var drops: [str: i64] = [:]
    for roll in 0..1000 {
        let index = r.pick_cumulative(cumulative) ?? 0
        drops[loot[index]] = (drops[loot[index]] ?? 0) + 1
    }
    print("1000 drops {drops}")

    let damage = r.between(5, 9)
    print("damage {damage}, crit: {r.chance(0.25)}, die {r.below(6) + 1}")
    print("turn order {r.permutation(5)}")
    print("sampled players {r.sample(100, 4)}")
    print("poisson arrivals {r.poisson(4.0)}, successes in 20 trials {r.binomial(20, 0.5)}")

    var again = rand.seeded(7)
    var same = ["ace", "king", "queen", "jack", "ten"]
    again.shuffle(mut same)
    print("same seed, same deck: {slices.equal(same, deck)}")

    var first = rand.pcg32(42, 1)
    var second = rand.pcg32(42, 2)
    print("pcg32 streams differ: {first.next32() != second.next32()}")
}
