import std/crypto
import std/crypto/aead

fn chacha_block(r: Rng) -> []u64 {
    let s: []u32 = __make(32)
    s[4] = u32(r.s0)
    s[5] = u32(r.s0 >> 32)
    s[6] = u32(r.s1)
    s[7] = u32(r.s1 >> 32)
    s[8] = u32(r.s2)
    s[9] = u32(r.s2 >> 32)
    s[10] = u32(r.s3)
    s[11] = u32(r.s3 >> 32)
    s[12] = u32(r.counter)
    s[13] = u32(r.counter >> 32)
    let out: []u64 = __make(8)
    let raw: ptr = __slice_ptr(out)
    let at: ptr[u8] = raw
    let bytes = view(at, 64)
    aead.chacha20_state(s, bytes)
    out
}

fn word_le(b: []u8, at: i64) -> u64 {
    var w: u64 = 0
    for i in 0..8 {
        w |= u64(b[at + i]) << u64(8 * i)
    }
    w
}

fn chacha_from(seed: []u8) -> Rng {
    Rng {
        engine: ChaCha
        s0: word_le(seed, 0)
        s1: word_le(seed, 8)
        s2: word_le(seed, 16)
        s3: word_le(seed, 24)
        pos: 8
    }
}

/// Returns a ChaCha20 generator (RFC 8439 block function, 20 rounds) keyed by the 32-byte `seed`.
///
/// The output is the keystream of the key with an all-zero nonce and a 64-bit block counter starting at `0`, consumed as little-endian 64-bit words. Fails with `BadSeed` when `seed` is not exactly 32 bytes. The same seed always produces the same sequence.
pub fn chacha(seed: []u8) -> Rng ! Error {
    if seed.len != 32 {
        fail BadSeed
    }
    chacha_from(seed)
}

/// Returns a ChaCha20 generator keyed with 32 bytes from `crypto.random`.
///
/// The sequence differs on every call. This is the generator to use when the output must be unpredictable.
pub fn chacha_rng() -> Rng {
    let seed = crypto.random(32)
    chacha_from(seed)
}

fn chacha_next(mut r: Rng) -> u64 {
    if r.pos >= 8 {
        r.block = chacha_block(r)
        r.counter += 1
        r.pos = 0
    }
    let result = r.block[r.pos]
    r.pos += 1
    result
}
