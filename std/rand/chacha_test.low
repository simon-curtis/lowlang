import std/testing
import std/text

fn zero_key() -> []u8 {
    var key: []u8 = []
    for _ in 0..32 {
        push(mut key, 0)
    }
    key
}

fn bytes_of(words: []u64) -> []u8 {
    var out: []u8 = []
    for w in words {
        for i in 0..8 {
            push(mut out, u8(w >> u64(8 * i)))
        }
    }
    out
}

fn test_counter_above_32_bits_carries_into_the_second_counter_word(t: *testing.T) {
    var r = chacha(zero_key()) or return
    r.counter = 1 << 32
    t.equal(text.encode_hex(bytes_of(chacha_block(r))), "3db41d3aa0d329285de6f225e6e24bd59c9a17006943d5c9b680e3873bdc683a5819469899989690c281cd17c96159af0682b5b903468a61f50228cf09622b5a")
}

fn test_counter_zero_matches_the_rfc_8439_appendix_a_vector(t: *testing.T) {
    let r = chacha(zero_key()) or return
    t.equal(text.encode_hex(bytes_of(chacha_block(r))), "76b8e0ada0f13d90405d6ae55386bd28bdd219b8a08ded1aa836efcc8b770dc7da41597c5157488d7724e03fb8d84a376a43b8f41518a11cc387b669b2ee6586")
}
