pub struct Builder {
    bytes: []u8 = []
}

pub fn write(mut b: Builder, s: str) {
    for i in 0..s.len {
        push(mut b.bytes, s[i])
    }
}

pub fn write_byte(mut b: Builder, c: u8) {
    push(mut b.bytes, c)
}

pub fn write_char(mut b: Builder, c: u32) {
    if c < 0x80 {
        push(mut b.bytes, u8(c))
        return
    }
    if c < 0x800 {
        push(mut b.bytes, u8(0xC0 | (c >> 6)))
        push(mut b.bytes, u8(0x80 | (c & 0x3F)))
        return
    }
    if c < 0x10000 {
        push(mut b.bytes, u8(0xE0 | (c >> 12)))
        push(mut b.bytes, u8(0x80 | ((c >> 6) & 0x3F)))
        push(mut b.bytes, u8(0x80 | (c & 0x3F)))
        return
    }
    push(mut b.bytes, u8(0xF0 | (c >> 18)))
    push(mut b.bytes, u8(0x80 | ((c >> 12) & 0x3F)))
    push(mut b.bytes, u8(0x80 | ((c >> 6) & 0x3F)))
    push(mut b.bytes, u8(0x80 | (c & 0x3F)))
}

pub fn length(b: Builder) -> i64 {
    b.bytes.len
}

pub fn build(b: Builder) -> str {
    str(b.bytes)
}

pub fn from_char(c: u32) -> str {
    var b = Builder {}
    b.write_char(c)
    b.build()
}

pub fn char_count(s: str) -> i64 {
    var n = 0
    for c in s {
        n += 1
    }
    n
}

pub fn has_prefix(s: str, prefix: str) -> bool {
    prefix.len <= s.len && s[0..prefix.len] == prefix
}

pub fn has_suffix(s: str, suffix: str) -> bool {
    suffix.len <= s.len && s[s.len - suffix.len..s.len] == suffix
}

pub fn index(s: str, sub: str) -> i64? {
    for i in 0..s.len - sub.len + 1 {
        if s[i..i + sub.len] == sub {
            return i
        }
    }
    none
}

pub fn last_index(s: str, sub: str) -> i64? {
    var i = s.len - sub.len
    for i >= 0 {
        if s[i..i + sub.len] == sub {
            return i
        }
        i -= 1
    }
    none
}

pub fn contains(s: str, sub: str) -> bool {
    match index(s, sub) {
        some(at) => true
        none => false
    }
}

pub fn count(s: str, sub: str) -> i64 {
    if sub.len == 0 {
        return char_count(s) + 1
    }
    var n = 0
    var i = 0
    for i + sub.len <= s.len {
        if s[i..i + sub.len] == sub {
            n += 1
            i += sub.len
        } else {
            i += 1
        }
    }
    n
}

fn space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12
}

pub fn trim_start(s: str) -> str {
    var lo = 0
    for lo < s.len && space(s[lo]) {
        lo += 1
    }
    s[lo..s.len]
}

pub fn trim_end(s: str) -> str {
    var hi = s.len
    for hi > 0 && space(s[hi - 1]) {
        hi -= 1
    }
    s[0..hi]
}

pub fn trim(s: str) -> str {
    trim_end(trim_start(s))
}

pub fn trim_prefix(s: str, prefix: str) -> str {
    if has_prefix(s, prefix) {
        return s[prefix.len..s.len]
    }
    s
}

pub fn trim_suffix(s: str, suffix: str) -> str {
    if has_suffix(s, suffix) {
        return s[0..s.len - suffix.len]
    }
    s
}

pub fn chars(s: str) -> []str {
    var starts: []i64 = []
    for i, c in s {
        push(mut starts, i)
    }
    var out: []str = []
    for k, start in starts {
        var end = s.len
        if k + 1 < starts.len {
            end = starts[k + 1]
        }
        push(mut out, s[start..end])
    }
    out
}

pub fn split(s: str, sep: str) -> []str {
    if sep.len == 0 {
        return chars(s)
    }
    var parts: []str = []
    var start = 0
    var i = 0
    for i + sep.len <= s.len {
        if s[i..i + sep.len] == sep {
            push(mut parts, s[start..i])
            i += sep.len
            start = i
        } else {
            i += 1
        }
    }
    push(mut parts, s[start..s.len])
    parts
}

pub fn fields(s: str) -> []str {
    var out: []str = []
    var i = 0
    for i < s.len {
        for i < s.len && space(s[i]) {
            i += 1
        }
        let start = i
        for i < s.len && !space(s[i]) {
            i += 1
        }
        if i > start {
            push(mut out, s[start..i])
        }
    }
    out
}

pub fn lines(s: str) -> []str {
    var out: []str = []
    var start = 0
    for i in 0..s.len {
        if s[i] == '\n' {
            push(mut out, trim_suffix(s[start..i], "\r"))
            start = i + 1
        }
    }
    if start < s.len {
        push(mut out, trim_suffix(s[start..s.len], "\r"))
    }
    out
}

pub fn join(parts: []str, sep: str) -> str {
    var b = Builder {}
    for i, part in parts {
        if i > 0 {
            b.write(sep)
        }
        b.write(part)
    }
    b.build()
}

pub fn repeat(s: str, n: i64) -> str {
    var b = Builder {}
    for i in 0..n {
        b.write(s)
    }
    b.build()
}

pub fn replace(s: str, old: str, new: str) -> str {
    if old.len == 0 {
        return s
    }
    split(s, old) |> join(new)
}

pub fn to_upper(s: str) -> str {
    var b = bytes(s)
    for i in 0..b.len {
        if b[i] >= 'a' && b[i] <= 'z' {
            b[i] -= 32
        }
    }
    str(b)
}

pub fn to_lower(s: str) -> str {
    var b = bytes(s)
    for i in 0..b.len {
        if b[i] >= 'A' && b[i] <= 'Z' {
            b[i] += 32
        }
    }
    str(b)
}

pub fn pad_left(s: str, width: i64, fill: u32) -> str {
    var b = Builder {}
    for i in char_count(s)..width {
        b.write_char(fill)
    }
    b.write(s)
    b.build()
}

pub fn pad_right(s: str, width: i64, fill: u32) -> str {
    var b = Builder {}
    b.write(s)
    for i in char_count(s)..width {
        b.write_char(fill)
    }
    b.build()
}
