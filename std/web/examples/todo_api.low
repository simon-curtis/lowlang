import std/header
import std/http
import std/io
import std/net
import std/web

struct NewTodo {
    title: str
}

struct Todo {
    id: i64
    title: str
    owner: str
}

struct Store {
    todos: []Todo
}

fn todo_app() -> *web.App {
    let store = new(Store { todos: [] })
    let app = web.app()
    web.get(app, "/health", fn(c) { web.text(200, "ok") })

    let api = web.group(app, "/api", [web.api_key("x-api-key", fn(key) -> str? {
        if key == "k-ada" { "ada" } else { none }
    })])
    web.query_endpoint[[]Todo](api, "GET", "/todos", fn(c) -> []Todo ! web.Problem { store.todos })
    web.endpoint[NewTodo, Todo](api, "POST", "/todos", 201, fn(c, body) -> Todo ! web.Problem {
        if body.title.len == 0 {
            fail Unprocessable("title is required")
        }
        let todo = Todo { id: store.todos.len + 1, title: body.title, owner: c.user }
        push(mut store.todos, todo)
        todo
    })
    web.query_endpoint[Todo](api, "GET", "/todos/:id", fn(c) -> Todo ! web.Problem {
        let id = web.param_int(c, "id")?
        for t in store.todos {
            if t.id == id {
                return t
            }
        }
        fail NotFound
    })
    app
}

fn show(label: str, resp: http.Response) {
    print("{label}: {resp.status} {http.text(resp)}")
}

/// Serves a typed JSON API behind an API key middleware on a loopback port and calls it with the HTTP client.
fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let listening = l.handle
    let handler = web.handler(todo_app())
    spawn fn() { http.serve_on(listening, handler) or {} }()

    let client = http.client().with_base_url("http://127.0.0.1:{l.handle.addr.port}").with_timeout(5000).build()
    show("health", client.get("/health") or return)
    show("no key", client.get("/api/todos") or return)

    let authed = http.client().with_base_url("http://127.0.0.1:{l.handle.addr.port}").with_header("x-api-key", "k-ada").with_timeout(5000).build()
    show("create", authed.request("POST", "/api/todos").with_json(NewTodo { title: "write docs" }).send() or return)
    show("empty title", authed.request("POST", "/api/todos").with_json(NewTodo { title: "" }).send() or return)
    show("list", authed.get("/api/todos") or return)
    show("one", authed.get("/api/todos/1") or return)
    show("missing", authed.get("/api/todos/9") or return)
    show("not a number", authed.get("/api/todos/x") or return)
    let wrong = authed.del("/api/todos/1") or return
    print("wrong method: {wrong.status} allow={http.header_value(wrong, "allow") ?? "-"}")
    net.close_listener(l)
}
