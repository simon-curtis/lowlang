import std/file
import std/io
import std/testing
import std/text
import std/time

fn scratch() -> str {
    file.temp_dir("low-session-store") or panic("no temporary directory")
}

fn opened(target: str, limit: i64) -> *Revocations {
    file_tables(target, limit) or panic("cannot open the store")
}

fn test_what_a_full_table_spilled_outlasts_the_process(t: *testing.T) {
    let dir = scratch()
    defer file.remove_all(dir) or {}
    let target = file.child_path(dir, "revoked")
    let r = opened(target, 4)
    let h = visited(store_of(r))
    let ada = cookie_from(asked(h, "/in?as=ada", ""))
    let gone = signed_out(h, 11)
    quiet(r)
    testing.equal(t, text.lines(file.read_text(target) or "").len, 6)

    let after = visited(store_of(opened(target, 4)))
    testing.equal(t, who(after, ada), "ada")
    for cookie in gone {
        testing.equal(t, who(after, cookie), "nobody")
    }
}

fn test_what_the_last_generation_revoked_outlasts_the_process(t: *testing.T) {
    let dir = scratch()
    defer file.remove_all(dir) or {}
    let target = file.child_path(dir, "revoked")
    let r = opened(target, 4)
    r.generations = 1
    let h = visited(store_of(r))
    let ada = cookie_from(asked(h, "/in?as=ada", ""))
    let _ = signed_out(h, 11)
    quiet(r)

    testing.equal(t, who(visited(store_of(opened(target, 4))), ada), "nobody")
}

fn refusing(target: str, lines: str) ! io.Error {
    fail NoSpace
}

fn test_an_entry_the_device_refuses_is_not_reported_recorded_and_empties_the_file(t: *testing.T) {
    let dir = scratch()
    defer file.remove_all(dir) or {}
    let target = file.child_path(dir, "revoked")
    let r = opened(target, 64)
    let j = r.journal ?? return
    let store = store_of(r)
    let far = time.now() + 600
    testing.is_true(t, store.revoke("first", far))
    j.disk = Disk { append: refusing, write: j.disk.write, rename: j.disk.rename }
    testing.is_false(t, store.revoke("second", far))
    testing.is_true(t, store.revoked("second", far))
    testing.is_false(t, store.revoked("unseen", far))
    testing.equal(t, file.read_text(target) or "unread", "")
    testing.is_true(t, store_of(opened(target, 64)).revoked("unseen", time.now()))
}

fn test_a_file_that_can_be_neither_written_nor_emptied_revokes_every_key(t: *testing.T) {
    let dir = scratch()
    defer file.remove_all(dir) or {}
    let r = opened(file.child_path(dir, "revoked"), 64)
    let j = r.journal ?? return
    let store = store_of(r)
    let far = time.now() + 600
    testing.is_true(t, store.revoke("first", far))
    j.disk = Disk { append: refusing, write: fn(target: str, pieces: str[]) ! io.Error { fail NoSpace }, rename: j.disk.rename }
    testing.is_false(t, store.revoke("second", far))
    testing.is_true(t, store.revoked("unseen", far + 600))
    testing.is_false(t, store.revoke("third", far))
}

fn test_the_file_is_written_anew_once_its_entries_have_lapsed(t: *testing.T) {
    let dir = scratch()
    defer file.remove_all(dir) or {}
    let target = file.child_path(dir, "revoked")
    let r = opened(target, 64)
    let j = r.journal ?? return
    j.slack = 4
    let store = store_of(r)
    let now = time.now()
    for i in 0..10 {
        testing.is_true(t, store.revoke("lapsed{i}", now - 1))
    }
    testing.equal(t, text.lines(file.read_text(target) or "").len, 11)
    r.swept = 0
    testing.is_true(t, store.revoke("live", now + 600))
    quiet(r)
    testing.equal(t, text.lines(file.read_text(target) or "").len, 2)
    testing.is_true(t, store_of(opened(target, 64)).revoked("live", now))
}

fn test_a_table_set_aside_is_refused_from_the_file_with_and_without_its_filter(t: *testing.T) {
    let dir = scratch()
    defer file.remove_all(dir) or {}
    let target = file.child_path(dir, "revoked")
    let now = time.now()
    let far = now + 600
    let aside = "{checked("floors 0 0")}{entry_line("first", far)}{entry_line("second", far)}{freeze_line("sessions")}{entry_line("third", far)}"
    file.write_text(target, aside) or panic("write")
    let cut = opened(target, 2)
    testing.equal(t, cut.sessions.until.len, 3)
    testing.equal(t, cut.sessions.aside.len, 0)
    testing.is_false(t, store_of(cut).revoked("unseen", now))

    file.write_text(target, "{aside}{filter_line("sessions", filter_of(["first": far, "second": far], 2, now))}") or panic("write")
    let r = opened(target, 2)
    testing.equal(t, r.sessions.until.len, 1)
    testing.equal(t, r.sessions.spilled.len, 1)
    for key in ["first", "second", "third"] {
        testing.is_true(t, store_of(r).revoked(key, now))
    }
    testing.is_false(t, store_of(r).revoked("unseen", now))
}

fn test_entries_recorded_while_the_file_is_written_anew_are_in_the_new_file(t: *testing.T) {
    let dir = scratch()
    defer file.remove_all(dir) or {}
    let target = file.child_path(dir, "revoked")
    let r = opened(target, 64)
    let j = r.journal ?? return
    let store = store_of(r)
    let now = time.now()
    testing.is_true(t, store.revoke("first", now + 600))
    j.appended = j.slack + 1
    let begun = chan[bool]()
    let go = chan[bool]()
    let write = j.disk.write
    j.disk = Disk {
        append: j.disk.append
        write: fn(to: str, pieces: str[]) ! io.Error {
            begun <- true
            <-go
            write(to, pieces)?
        }
        rename: j.disk.rename
    }
    testing.is_true(t, store.revoke("second", now + 600))
    <-begun
    testing.is_true(t, store.revoke("meanwhile", now + 600))
    go <- true
    quiet(r)
    testing.equal(t, text.lines(file.read_text(target) or "").len, 4)
    let after = store_of(opened(target, 64))
    for key in ["first", "second", "meanwhile"] {
        testing.is_true(t, after.revoked(key, now))
    }
    testing.is_false(t, after.revoked("unseen", now))
}

fn test_a_file_longer_than_one_read_is_restored_whole(t: *testing.T) {
    let dir = scratch()
    defer file.remove_all(dir) or {}
    let target = file.child_path(dir, "revoked")
    let now = time.now()
    var content: u8[] = bytes(checked("floors 0 0"))
    for i in 0..4000 {
        text.append(mut content, entry_line("key{i}", now + 600 + i))
    }
    file.write_text(target, str(content)) or panic("write")
    let r = opened(target, 8192)
    testing.equal(t, r.sessions.until.len, 4000)
    for i in 0..4000 {
        testing.equal(t, r.sessions.until["key{i}"] ?? 0, now + 600 + i)
    }
    testing.is_false(t, store_of(r).revoked("unseen", now))
}
