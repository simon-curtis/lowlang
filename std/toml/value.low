/// A TOML date, a time, or both, as the fields of a calendar date and a clock time.
///
/// Which fields hold data depends on the `Value` variant that carries it: `LocalDate` uses `year`, `month` and `day`, `LocalTime` uses `hour`, `minute`, `second` and `nanosecond`, and `LocalDateTime` and `OffsetDateTime` use all of them. The other fields are `0`. `datetime_text` formats it as RFC 3339 text.
pub struct DateTime {
    /// The year, `0` to `9999`.
    pub year: i64 = 0
    /// The month, `1` to `12`.
    pub month: i64 = 0
    /// The day of the month, `1` to `31`, valid for the month.
    pub day: i64 = 0
    /// The hour, `0` to `23`.
    pub hour: i64 = 0
    /// The minute, `0` to `59`.
    pub minute: i64 = 0
    /// The second, `0` to `59`; a leap second is not accepted.
    pub second: i64 = 0
    /// The fraction of a second in nanoseconds, `0` to `999999999`. Digits beyond nine are truncated by the parser.
    pub nanosecond: i64 = 0
    /// The offset from UTC in minutes, east positive; `0` for `Z`. It is only meaningful for an `OffsetDateTime`.
    pub offset: i64 = 0
}

/// A TOML value (TOML 1.0.0).
pub enum Value {
    /// A string.
    Str(str)
    /// A 64-bit signed integer. The parser rejects a literal outside that range.
    Int(i64)
    /// A 64-bit float, including `inf`, `-inf` and `nan`.
    Float(f64)
    /// A boolean.
    Bool(bool)
    /// A date and time with an offset from UTC, such as `1979-05-27T07:32:00Z`.
    OffsetDateTime(DateTime)
    /// A date and time without an offset, such as `1979-05-27T07:32:00`.
    LocalDateTime(DateTime)
    /// A date without a time, such as `1979-05-27`.
    LocalDate(DateTime)
    /// A time without a date, such as `07:32:00`.
    LocalTime(DateTime)
    /// An array of values. Elements may have different types.
    Array([]Value)
    /// A table, which a `Value` holds by pointer; inline tables and `[table]` sections both produce one.
    Table(*Table)
}

/// An ordered table of keys and values.
pub struct Table {
    /// The keys in the order they were first inserted or appeared in the document, each once.
    pub keys: []str
    /// The value of each key in `keys`.
    pub values: [str: Value]
}

/// The error returned when parsing TOML fails.
pub enum Error {
    /// The document is not valid TOML. `line` and `column` count from `1`, with the column in bytes from the start of the line, and `message` describes the problem.
    Syntax(line: i64, column: i64, message: str)
}

/// Returns a new empty table.
pub fn new_table() -> *Table {
    new(Table { keys: [], values: [:] })
}

/// Sets `key` to `v` in `t`.
///
/// A new key is appended to `keys`; an existing key keeps its position and takes the new value.
pub fn insert(t: *Table, key: str, v: Value) {
    match t.values[key] {
        some(_) => {}
        none => push(mut t.keys, key)
    }
    t.values[key] = v
}

/// Returns the value at `path` in `t`, or `none` when there is none.
///
/// `path` is a TOML key, with dots for nesting and quotes for a part that contains a dot or other characters outside letters, digits, `_` and `-`, for example `server.http` or `a."b.c"`. Only tables are entered, never arrays. It returns `none` for a path that is not a valid key, a missing part, or a part that is not a table.
pub fn get(t: *Table, path: str) -> Value? {
    let parts = match key_path(path) {
        some(found) => found
        none => return none
    }
    var current = t
    for i, part in parts {
        let v = match current.values[part] {
            some(found) => found
            none => return none
        }
        if i == parts.len - 1 {
            return v
        }
        match v {
            Table(inner) => {
                current = inner
            }
            _ => return none
        }
    }
    none
}

/// Returns the table at `path`, or `none` when the path does not exist or the value is not a table. See `get` for `path`.
pub fn table(t: *Table, path: str) -> *Table? {
    match get(t, path) {
        some(v) => match v {
            Table(inner) => inner
            _ => none
        }
        none => none
    }
}

/// Returns the string at `path`, or `none` when the path does not exist or the value is not a string. See `get` for `path`.
pub fn text(t: *Table, path: str) -> str? {
    match get(t, path) {
        some(v) => match v {
            Str(s) => s
            _ => none
        }
        none => none
    }
}

/// Returns the integer at `path`, or `none` when the path does not exist or the value is not an integer. See `get` for `path`.
pub fn integer(t: *Table, path: str) -> i64? {
    match get(t, path) {
        some(v) => match v {
            Int(n) => n
            _ => none
        }
        none => none
    }
}

/// Returns the float at `path`, or `none` when the path does not exist or the value is not a float; an integer is not converted. See `get` for `path`.
pub fn float(t: *Table, path: str) -> f64? {
    match get(t, path) {
        some(v) => match v {
            Float(x) => x
            _ => none
        }
        none => none
    }
}

/// Returns the boolean at `path`, or `none` when the path does not exist or the value is not a boolean. See `get` for `path`.
pub fn boolean(t: *Table, path: str) -> bool? {
    match get(t, path) {
        some(v) => match v {
            Bool(b) => b
            _ => none
        }
        none => none
    }
}

/// Returns the array at `path`, or `none` when the path does not exist or the value is not an array. An array of tables is an array of `Table` values. See `get` for `path`.
pub fn array(t: *Table, path: str) -> []Value? {
    match get(t, path) {
        some(v) => match v {
            Array(items) => items
            _ => none
        }
        none => none
    }
}

/// Returns the `DateTime` at `path` for any of the four date and time kinds, or `none` when the path does not exist or the value is none of them.
///
/// The kind is lost, so use `get` to tell them apart. See `get` for `path`.
pub fn datetime(t: *Table, path: str) -> DateTime? {
    match get(t, path) {
        some(v) => match v {
            OffsetDateTime(d) => d
            LocalDateTime(d) => d
            LocalDate(d) => d
            LocalTime(d) => d
            _ => none
        }
        none => none
    }
}

/// Returns the RFC 3339 text of a date or time value, or `none` for any other value.
///
/// An `OffsetDateTime` is `YYYY-MM-DDTHH:MM:SS` followed by `Z` for a zero offset or `+HH:MM` or `-HH:MM`; a `LocalDateTime` is the same without the offset, a `LocalDate` is `YYYY-MM-DD` and a `LocalTime` is `HH:MM:SS`. A fraction of a second is written after a `.` with trailing zeros removed, and left out when it is zero.
pub fn datetime_text(v: Value) -> str? {
    var out: []u8 = []
    match v {
        OffsetDateTime(d) => {
            write_date(mut out, d)
            push(mut out, 'T')
            write_time(mut out, d)
            write_offset(mut out, d.offset)
        }
        LocalDateTime(d) => {
            write_date(mut out, d)
            push(mut out, 'T')
            write_time(mut out, d)
        }
        LocalDate(d) => write_date(mut out, d)
        LocalTime(d) => write_time(mut out, d)
        _ => return none
    }
    __str_view(out)
}

fn write_padded(mut out: []u8, n: i64, width: i64) {
    var digits: []u8 = __make(width)
    var rest = n
    var i = width - 1
    for i >= 0 {
        digits[i] = u8(rest % 10) + '0'
        rest = rest / 10
        i -= 1
    }
    __extend(mut out, __str_view(digits))
}

fn write_date(mut out: []u8, d: DateTime) {
    write_padded(mut out, d.year, 4)
    push(mut out, '-')
    write_padded(mut out, d.month, 2)
    push(mut out, '-')
    write_padded(mut out, d.day, 2)
}

fn write_time(mut out: []u8, d: DateTime) {
    write_padded(mut out, d.hour, 2)
    push(mut out, ':')
    write_padded(mut out, d.minute, 2)
    push(mut out, ':')
    write_padded(mut out, d.second, 2)
    if d.nanosecond == 0 {
        return
    }
    var width = 9
    var fraction = d.nanosecond
    for fraction % 10 == 0 {
        fraction = fraction / 10
        width -= 1
    }
    push(mut out, '.')
    write_padded(mut out, fraction, width)
}

fn write_offset(mut out: []u8, offset: i64) {
    if offset == 0 {
        push(mut out, 'Z')
        return
    }
    var magnitude = offset
    if offset < 0 {
        push(mut out, '-')
        magnitude = -offset
    } else {
        push(mut out, '+')
    }
    write_padded(mut out, magnitude / 60, 2)
    push(mut out, ':')
    write_padded(mut out, magnitude % 60, 2)
}
