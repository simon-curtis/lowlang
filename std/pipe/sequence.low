/// Returns the number of bytes in `q`.
pub fn length(q: Sequence) -> i64 {
    q.end - q.start
}

/// Returns whether `q` has no bytes.
pub fn is_empty(q: Sequence) -> bool {
    q.end == q.start
}

/// Returns the part of `q` from stream offset `from` to `to`.
///
/// The offsets are clamped to the bounds of `q`, and an empty sequence results if `to` is before `from`. Shares the bytes with `q`.
pub fn slice(q: Sequence, from: i64, to: i64) -> Sequence {
    let start = if from < q.start { q.start } else { from }
    let end = if to > q.end { q.end } else { to }
    Sequence { segments: q.segments, start, end: if end < start { start } else { end } }
}

/// Returns the bytes of `q` as contiguous slices, in order.
///
/// The slices are views of the pipe's buffer and are not copies.
pub fn spans(q: Sequence) -> [][]u8 {
    var out: [][]u8 = []
    for seg in q.segments {
        let lo = if q.start > seg.offset { q.start - seg.offset } else { 0 }
        let top = seg.offset + seg.filled
        let hi = if q.end < top { q.end - seg.offset } else { seg.filled }
        if lo < hi {
            push(mut out, seg.data[lo..hi])
        }
    }
    out
}

/// Returns the first contiguous slice of `q`, or an empty slice if `q` is empty.
pub fn first(q: Sequence) -> []u8 {
    let parts = spans(q)
    if parts.len == 0 {
        let empty: []u8 = []
        return empty
    }
    parts[0]
}

/// Returns a copy of the bytes of `q` as one slice.
pub fn to_bytes(q: Sequence) -> []u8 {
    let out: []u8 = __make(length(q))
    var at = 0
    for part in spans(q) {
        __memmove(out[at..], part)
        at += part.len
    }
    out
}

/// Returns the byte at stream offset `position`, or `0` if no segment of `q` holds it.
///
/// The offset is not checked against the bounds of `q`.
pub fn byte_at(q: Sequence, position: i64) -> u8 {
    for seg in q.segments {
        if position >= seg.offset && position < seg.offset + seg.filled {
            return seg.data[position - seg.offset]
        }
    }
    0
}

/// Returns the stream offset of the first byte of `q` equal to `b`, or -1 if there is none.
pub fn index_of(q: Sequence, b: u8) -> i64 {
    var at = q.start
    for part in spans(q) {
        for i, x in part {
            if x == b {
                return at + i
            }
        }
        at += part.len
    }
    -1
}

/// A cursor that reads values from a `Sequence` and tracks its position.
pub struct SequenceReader {
    sequence: Sequence
    position: i64
}

/// Returns a `SequenceReader` positioned at the start of `q`.
pub fn sequence_reader(q: Sequence) -> *SequenceReader {
    new(SequenceReader { sequence: q, position: q.start })
}

/// Returns the stream offset of the next unread byte.
///
/// This is an offset in the same coordinates as `Sequence.start`, not a count of the bytes read.
pub fn consumed(r: *SequenceReader) -> i64 {
    r.position
}

/// Returns the number of bytes not yet read.
pub fn remaining(r: *SequenceReader) -> i64 {
    r.sequence.end - r.position
}

/// Returns the bytes not yet read as a `Sequence`.
pub fn unread(r: *SequenceReader) -> Sequence {
    slice(r.sequence, r.position, r.sequence.end)
}

/// Advances over `n` bytes and returns `true`, or returns `false` and does not move if fewer than `n` remain.
pub fn skip(r: *SequenceReader, n: i64) -> bool {
    if remaining(r) < n {
        return false
    }
    r.position += n
    true
}

/// Returns the next byte and advances past it, or `none` at the end.
pub fn next_byte(r: *SequenceReader) -> u8? {
    if r.position >= r.sequence.end {
        return none
    }
    let b = byte_at(r.sequence, r.position)
    r.position += 1
    b
}

/// Returns the next byte without advancing, or `none` at the end.
pub fn peek_byte(r: *SequenceReader) -> u8? {
    byte_at(r.sequence, r.position) when r.position < r.sequence.end
}

/// Returns the next `n` bytes and advances past them, or `none` and does not move if fewer than `n` remain.
pub fn read_exact(r: *SequenceReader, n: i64) -> Sequence? {
    if remaining(r) < n {
        return none
    }
    let out = slice(r.sequence, r.position, r.position + n)
    r.position += n
    out
}

/// Returns the bytes before the next `delimiter` and advances past the delimiter.
///
/// Returns `none` and does not move if there is no delimiter in the unread bytes.
pub fn read_to(r: *SequenceReader, delimiter: u8) -> Sequence? {
    let rest = unread(r)
    let at = index_of(rest, delimiter)
    if at < 0 {
        return none
    }
    let out = slice(r.sequence, r.position, at)
    r.position = at + 1
    out
}

/// Returns the next line without its terminator and advances past it.
///
/// A line ends at `\n`, and a `\r` just before it is removed too. Returns `none` and does not move if the unread bytes contain no `\n`.
pub fn read_line(r: *SequenceReader) -> Sequence? {
    let line = read_to(r, '\n')
    match line {
        some(l) => {
            if length(l) > 0 && byte_at(l, l.end - 1) == '\r' {
                return slice(l, l.start, l.end - 1)
            }
            l
        }
        none => none
    }
}

/// Returns whether the unread bytes begin with `expected`, without advancing.
pub fn is_next(r: *SequenceReader, expected: []u8) -> bool {
    if remaining(r) < expected.len {
        return false
    }
    for i, b in expected {
        if byte_at(r.sequence, r.position + i) != b {
            return false
        }
    }
    true
}

/// Reads `size` bytes as a big-endian unsigned integer and advances past them, or returns `none` and does not move if fewer than `size` remain.
///
/// `size` is at most 8.
pub fn read_be(r: *SequenceReader, size: i64) -> u64? {
    if remaining(r) < size {
        return none
    }
    var v: u64 = 0
    for i in 0..size {
        v = v << 8 | u64(byte_at(r.sequence, r.position + i))
    }
    r.position += size
    v
}

/// Reads `size` bytes as a little-endian unsigned integer and advances past them, or returns `none` and does not move if fewer than `size` remain.
///
/// `size` is at most 8.
pub fn read_le(r: *SequenceReader, size: i64) -> u64? {
    if remaining(r) < size {
        return none
    }
    var v: u64 = 0
    var i = size - 1
    for i >= 0 {
        v = v << 8 | u64(byte_at(r.sequence, r.position + i))
        i -= 1
    }
    r.position += size
    v
}
