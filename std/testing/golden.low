import std/file
import std/math
import std/path
import std/text

/// Checks `actual` against the golden file `name` in the directory `Settings.golden_dir` of `t`.
///
/// The file is `name` with `.golden` appended. See `golden_in`; the files are rewritten when `Settings.update_golden` is `true`, which the `-update` flag sets.
pub fn golden(t: *T, name: str, actual: str) -> bool {
    golden_in(t, t.settings.golden_dir, name, actual, t.settings.update_golden)
}

/// Checks `actual` against the file `dir/name.golden`, or rewrites that file when `update` is `true`.
///
/// When updating, creates the directory if needed, writes `actual` and returns `true`; an error creating or writing is recorded on `t` and gives `false`. Otherwise returns `true` when the file's text equals `actual`. A file that cannot be read, such as a missing one, and a difference are both recorded as errors that name `-update`, and the difference shows the first line that differs, or the two line counts.
pub fn golden_in(t: *T, dir: str, name: str, actual: str, update: bool) -> bool {
    let target = "{dir}/{name}.golden"
    if update {
        return rewrite(t, target, actual)
    }
    let want = file.read_text(target) catch {
        e => {
            error(t, "golden {name}: cannot read {target}: {format(e)}; run with -update to create it")
            return false
        }
    }
    if actual == want {
        return true
    }
    error(t, "golden {name}: output differs from {target}; run with -update to accept it\n{line_difference(actual, want)}")
    false
}

fn rewrite(t: *T, target: str, actual: str) -> bool {
    file.mkdir_all(path.dir(target)) catch {
        e => {
            error(t, "golden: cannot create {path.dir(target)}: {format(e)}")
            return false
        }
    }
    file.write_text(target, actual) catch {
        e => {
            error(t, "golden: cannot write {target}: {format(e)}")
            return false
        }
    }
    true
}

fn line_difference(actual: str, want: str) -> str {
    let got_lines = text.split(actual, '\n')
    let want_lines = text.split(want, '\n')
    let shared = math.min(got_lines.len, want_lines.len)
    for i in 0..shared {
        if got_lines[i] != want_lines[i] {
            return "line {i + 1}:\n  got:  {got_lines[i]}\n  want: {want_lines[i]}"
        }
    }
    "line counts differ: got {got_lines.len}, want {want_lines.len}"
}
