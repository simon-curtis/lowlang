import std/testing
import std/text

enum SizeError {
    Empty
    BadUnit(unit: str)
    BadNumber
}

fn parse_size(s: str) -> i64 ! SizeError {
    if s.len == 0 {
        fail Empty
    }
    var end = 0
    for end < s.len && s[end] >= '0' && s[end] <= '9' {
        end += 1
    }
    let amount = text.parse_int(s[..end]) catch { _ => fail BadNumber }
    let unit = s[end..]
    match unit {
        "" => amount
        "KB" => amount * 1000
        "MB" => amount * 1000000
        _ => fail BadUnit(unit)
    }
}

fn test_units(t: *testing.T) {
    t.equal(parse_size("512") catch { e => t.unexpected(e, -1) }, 512)
    t.equal(parse_size("3KB") catch { e => t.unexpected(e, -1) }, 3000)
    t.equal(parse_size("2MB") catch { e => t.unexpected(e, -1) }, 2000000)
}

fn test_rejects(t: *testing.T) {
    let empty = parse_size("") catch { e => t.expect_error(e, SizeError.Empty, -1) }
    let unit = parse_size("5GB") catch { e => t.expect_error(e, SizeError.BadUnit("GB"), -1) }
    t.equal(empty, -1)
    t.equal(unit, -1)
}

fn test_cases(t: *testing.T) {
    let cases: [str: i64] = ["1KB": 1000, "10": 10, "7MB": 7000000]
    t.table(cases, fn(st, want) {
        st.log("checked {st.name}")
        st.is_true(want > 0)
    })
}

fn test_roundtrip(t: *testing.T) {
    t.check_ints(200, 42, 0, 100000, fn(n) {
        let size = parse_size("{n}KB") catch { _ => return false }
        size == n * 1000
    })
}

fn test_wrong_expectation(t: *testing.T) {
    t.equal(parse_size("4KB") catch { e => t.unexpected(e, -1) }, 4096)
    t.contains("bad unit", "number")
    t.log("the run goes on after a failed check")
}

fn test_platform(t: *testing.T) {
    t.skip("needs a network")
}

/// Runs a small suite with verbose reports and no timings, including one test that fails on purpose to show the failure report.
fn main() {
    let tests = [
        testing.Test { name: "units", run: test_units },
        testing.Test { name: "rejects", run: test_rejects },
        testing.Test { name: "cases", run: test_cases },
        testing.Test { name: "roundtrip", run: test_roundtrip },
        testing.Test { name: "wrong_expectation", run: test_wrong_expectation },
        testing.Test { name: "platform", run: test_platform }
    ]
    let failed = testing.run_with(tests, testing.Settings { verbose: true, timing: false })
    print("{failed} test failed")

    let settings = testing.settings_from(["-run", "cases", "-notime"]) catch { _ => testing.Settings {} }
    print("filtered run: {testing.run_with(tests, settings)} failed")
    print("selected: {testing.selected("cases/1KB", "cases/1KB")} {testing.selected("units", "cases")}")
}
