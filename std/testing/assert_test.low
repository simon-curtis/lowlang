import std/text

enum SampleError {
    Missing
    Wrong(at: i64)
}

struct Sample {
    id: i64
    label: str
}

struct Visits {
    names: []str
}

fn probe() -> *T {
    make_t("probe", Settings {})
}

fn notes(p: *T) -> []str {
    recorded(p)
}

fn visit(visits: *Visits, st: *T) {
    push(mut visits.names, st.name)
}

fn test_a_passing_assertion_records_nothing(t: *T) {
    let p = probe()
    t.is_true(equal(p, 1, 1))
    t.is_true(not_equal(p, 1, 2))
    t.is_true(equal_slice(p, [1, 2], [1, 2]))
    t.is_true(is_true(p, true))
    t.is_true(is_false(p, false))
    let present: i64? = 1
    t.is_true(is_some(p, present))
    let nothing: i64? = none
    t.is_true(is_none(p, nothing))
    t.is_true(contains(p, "abc", "b"))
    t.is_true(contains(p, "abc", ""))
    t.is_true(contains_item(p, [1, 2, 3], 2))
    t.is_true(close_to(p, 1.0, 1.25, 0.25))
    t.is_true(close_to(p, 1.25, 1.0, 0.25))
    t.is_true(equal(p, Sample { id: 1, label: "a" }, Sample { id: 1, label: "a" }))
    t.is_false(failed(p))
    t.equal(notes(p).len, 0)
}

fn test_equal_reports_both_values(t: *T) {
    let p = probe()
    t.is_false(equal(p, 1, 2))
    t.is_true(failed(p))
    t.equal_slice(notes(p), ["equal: got 1, want 2"])
}

fn test_equal_quotes_text(t: *T) {
    let p = probe()
    t.is_false(equal(p, "a\"b", "c\nd"))
    t.equal_slice(notes(p), ["equal: got \"a\\\"b\", want \"c\\nd\""])
}

fn test_equal_renders_structs(t: *T) {
    let p = probe()
    t.is_false(equal(p, Sample { id: 1, label: "a" }, Sample { id: 2, label: "b" }))
    t.equal_slice(notes(p), ["equal: got Sample{{id: 1, label: \"a\"}}, want Sample{{id: 2, label: \"b\"}}"])
}

fn test_equal_renders_optionals_and_floats(t: *T) {
    let p = probe()
    let absent: i64? = none
    let three: i64? = 3
    t.is_false(equal(p, absent, three))
    t.is_false(equal(p, 1.5, 2.5))
    t.equal_slice(notes(p), ["equal: got none, want 3", "equal: got 1.5, want 2.5"])
}

fn test_not_equal_reports_the_shared_value(t: *T) {
    let p = probe()
    t.is_false(not_equal(p, "same", "same"))
    t.equal_slice(notes(p), ["not_equal: both are \"same\""])
}

fn test_equal_slice_reports_the_first_difference(t: *T) {
    let p = probe()
    t.is_false(equal_slice(p, [1, 2, 3], [1, 2, 4]))
    t.is_false(equal_slice(p, [9, 2, 3], [1, 2, 3]))
    t.equal_slice(notes(p), [
        "equal_slice: got [1, 2, 3], want [1, 2, 4] (first difference at index 2)"
        "equal_slice: got [9, 2, 3], want [1, 2, 3] (first difference at index 0)"
    ])
}

fn test_equal_slice_reports_the_lengths(t: *T) {
    let p = probe()
    let empty: []i64 = []
    t.is_false(equal_slice(p, [1, 2], [1, 2, 3]))
    t.is_false(equal_slice(p, [1, 2, 3], [1, 2]))
    t.is_false(equal_slice(p, empty, [1]))
    t.is_true(equal_slice(p, empty, empty))
    t.equal_slice(notes(p), [
        "equal_slice: got [1, 2], want [1, 2, 3] (lengths 2 and 3)"
        "equal_slice: got [1, 2, 3], want [1, 2] (lengths 3 and 2)"
        "equal_slice: got [], want [1] (lengths 0 and 1)"
    ])
}

fn test_boolean_assertions(t: *T) {
    let p = probe()
    t.is_false(is_true(p, false))
    t.is_false(is_false(p, true))
    t.equal_slice(notes(p), ["is_true: got false", "is_false: got true"])
}

fn test_optional_assertions(t: *T) {
    let p = probe()
    let absent: i64? = none
    t.is_false(is_some(p, absent))
    let five: i64? = 5
    let word: str? = "five"
    t.is_false(is_none(p, five))
    t.is_false(is_none(p, word))
    t.equal_slice(notes(p), ["is_some: got none", "is_none: got 5", "is_none: got \"five\""])
}

fn test_contains_reports_the_text_it_missed(t: *T) {
    let p = probe()
    t.is_false(contains(p, "abc", "x"))
    t.is_false(contains(p, "", "x"))
    t.is_false(contains(p, "abc", "ABC"))
    t.equal_slice(notes(p), [
        "contains: \"abc\" does not contain \"x\""
        "contains: \"\" does not contain \"x\""
        "contains: \"abc\" does not contain \"ABC\""
    ])
}

fn test_contains_item_reports_the_item_it_missed(t: *T) {
    let p = probe()
    let empty: []i64 = []
    t.is_false(contains_item(p, [1, 2], 3))
    t.is_false(contains_item(p, empty, 3))
    t.is_false(contains_item(p, ["a"], "b"))
    t.equal_slice(notes(p), [
        "contains_item: [1, 2] does not contain 3"
        "contains_item: [] does not contain 3"
        "contains_item: [\"a\"] does not contain \"b\""
    ])
}

fn test_close_to_reports_the_gap(t: *T) {
    let p = probe()
    t.is_false(close_to(p, 1.5, 2.5, 0.25))
    t.is_false(close_to(p, 2.5, 1.5, 0.25))
    t.equal_slice(notes(p), [
        "close_to: got 1.5, want 2.5 within 0.25"
        "close_to: got 2.5, want 1.5 within 0.25"
    ])
}

fn test_close_to_never_accepts_nan(t: *T) {
    let p = probe()
    let nan = 0.0 / 0.0
    t.is_false(close_to(p, nan, 1.0, 100.0))
    t.is_false(close_to(p, 1.0, nan, 100.0))
    t.is_false(close_to(p, nan, nan, 100.0))
    t.equal(notes(p).len, 3)
}

fn test_close_to_accepts_the_tolerance_itself(t: *T) {
    let p = probe()
    t.is_true(close_to(p, 1.0, 1.5, 0.5))
    t.is_true(close_to(p, 3.0, 3.0, 0.0))
    t.is_false(close_to(p, 3.0, 3.5, 0.0))
}

fn test_unexpected_records_the_error_and_returns_the_fallback(t: *T) {
    let p = probe()
    let got = unexpected(p, SampleError.Wrong(7), 42)
    t.equal(got, 42)
    t.is_true(failed(p))
    t.equal_slice(notes(p), ["unexpected error: Wrong{{at: 7}}"])
}

fn test_unexpected_works_in_a_catch_handler(t: *T) {
    let p = probe()
    let parsed = text.parse_int("12x") catch { e => unexpected(p, e, -1) }
    t.equal(parsed, -1)
    t.equal_slice(notes(p), ["unexpected error: BadDigit{{at: 2}}"])
}

fn test_expect_error_accepts_the_wanted_error(t: *T) {
    let p = probe()
    let got = expect_error(p, SampleError.Missing, SampleError.Missing, "fallback")
    t.equal(got, "fallback")
    t.is_false(failed(p))
    t.equal(notes(p).len, 0)
}

fn test_expect_error_reports_a_different_error(t: *T) {
    let p = probe()
    let got = expect_error(p, SampleError.Wrong(1), SampleError.Wrong(2), 5)
    t.equal(got, 5)
    t.is_true(failed(p))
    t.equal_slice(notes(p), ["expect_error: got Wrong{{at: 1}}, want Wrong{{at: 2}}"])
}

fn test_error_and_log_record_notes_in_order(t: *T) {
    let p = probe()
    log(p, "first")
    t.is_false(failed(p))
    error(p, "second")
    t.is_true(failed(p))
    log(p, "third")
    t.equal_slice(notes(p), ["first", "second", "third"])
}

fn test_error_if_returns_its_condition(t: *T) {
    let p = probe()
    t.is_false(error_if(p, false, "not recorded"))
    t.is_false(failed(p))
    t.is_true(error_if(p, true, "recorded"))
    t.is_true(failed(p))
    t.equal_slice(notes(p), ["recorded"])
}

fn test_sub_runs_a_selected_subtest_and_names_it_after_its_parent(t: *T) {
    let p = make_t("parent", Settings { filter: "parent/child" })
    let visits = new(Visits { names: [] })
    let ok = sub(p, "child", fn(st) { visit(visits, st) })
    t.is_true(ok)
    t.is_false(failed(p))
    t.equal_slice(visits.names, ["parent/child"])
}

fn test_sub_skips_a_subtest_the_filter_leaves_out(t: *T) {
    let p = make_t("parent", Settings { filter: "parent/other" })
    let visits = new(Visits { names: [] })
    let ok = sub(p, "child", fn(st) { visit(visits, st) })
    t.is_true(ok)
    t.is_false(failed(p))
    t.equal(visits.names.len, 0)
}

fn test_sub_without_a_time_limit_still_finishes(t: *T) {
    let p = make_t("parent", Settings { timeout_ms: 0 })
    let visits = new(Visits { names: [] })
    let ok = sub(p, "child", fn(st) { visit(visits, st) })
    t.is_true(ok)
    t.equal_slice(visits.names, ["parent/child"])
}

fn test_table_runs_every_case_in_insertion_order(t: *T) {
    let p = make_t("parent", Settings {})
    let visits = new(Visits { names: [] })
    let cases: [str: i64] = ["one": 1, "two": 2, "three": 3]
    let ok = table(p, cases, fn(st, n) { visit(visits, st) })
    t.is_true(ok)
    t.equal_slice(visits.names, ["parent/one", "parent/two", "parent/three"])
}

fn test_table_of_names_each_case_with_the_name_function(t: *T) {
    let p = make_t("parent", Settings {})
    let visits = new(Visits { names: [] })
    let cases = [Sample { id: 1, label: "a" }, Sample { id: 2, label: "b" }]
    let ok = table_of(p, cases, fn(c) { "{c.label}{c.id}" }, fn(st, c) { visit(visits, st) })
    t.is_true(ok)
    t.equal_slice(visits.names, ["parent/a1", "parent/b2"])
}

fn test_table_honours_the_filter_per_case(t: *T) {
    let p = make_t("parent", Settings { filter: "parent/tw" })
    let visits = new(Visits { names: [] })
    let cases: [str: i64] = ["one": 1, "two": 2, "twelve": 12]
    let ok = table(p, cases, fn(st, n) { visit(visits, st) })
    t.is_true(ok)
    t.equal_slice(visits.names, ["parent/two", "parent/twelve"])
}

fn test_format_renders_values_for_messages(t: *T) {
    t.equal(format(7), "7")
    t.equal(format("a"), "\"a\"")
    t.equal(format([1, 2]), "[1, 2]")
    t.equal(format(Sample { id: 1, label: "x" }), "Sample{{id: 1, label: \"x\"}}")
    t.equal(format(SampleError.Missing), "Missing")
}
