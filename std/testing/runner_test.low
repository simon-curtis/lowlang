import std/flag
import std/text

struct SelectCase {
    filter: str
    name: str
    want: bool
}

struct FlagCase {
    args: []str
    filter: str
    verbose: bool
    timing: bool
    update_golden: bool
    timeout_ms: i64
    list: bool
    one: str
}

struct FlagFailure {
    args: []str
    message: str
}

fn select_name(c: SelectCase) -> str {
    "{text.quote(c.filter)} on {text.quote(c.name)}"
}

fn flag_name(c: FlagCase) -> str {
    text.join(c.args, " ")
}

fn flag_failure_name(c: FlagFailure) -> str {
    text.join(c.args, " ")
}

fn flag_case(args: []str) -> FlagCase {
    FlagCase { args, filter: "", verbose: false, timing: true, update_golden: false, timeout_ms: 30000, list: false, one: "" }
}

fn settings_failure(args: []str) -> str {
    let parsed = settings_from(args) catch { e => return flag_message(e) }
    "parsed {parsed.filter}"
}

fn test_selected_with_an_empty_filter(t: *T) {
    let cases = [
        SelectCase { filter: "", name: "", want: true }
        SelectCase { filter: "", name: "anything", want: true }
        SelectCase { filter: "", name: "a/b/c", want: true }
    ]
    t.table_of(cases, select_name, fn(st, c) {
        st.equal(selected(c.filter, c.name), c.want)
    })
}

fn test_selected_matches_a_substring_of_the_first_level(t: *T) {
    let cases = [
        SelectCase { filter: "abc", name: "abc", want: true }
        SelectCase { filter: "b", name: "abc", want: true }
        SelectCase { filter: "ab", name: "abc", want: true }
        SelectCase { filter: "bc", name: "abc", want: true }
        SelectCase { filter: "abc", name: "ab", want: false }
        SelectCase { filter: "x", name: "abc", want: false }
        SelectCase { filter: "ac", name: "abc", want: false }
        SelectCase { filter: "A", name: "abc", want: false }
        SelectCase { filter: "abc", name: "", want: false }
    ]
    t.table_of(cases, select_name, fn(st, c) {
        st.equal(selected(c.filter, c.name), c.want)
    })
}

fn test_selected_compares_each_level_at_its_own_depth(t: *T) {
    let cases = [
        SelectCase { filter: "a/b", name: "abc/xbz", want: true }
        SelectCase { filter: "a/b", name: "abc/xyz", want: false }
        SelectCase { filter: "a/b", name: "xyz/xbz", want: false }
        SelectCase { filter: "a/b", name: "xbz/abc", want: false }
        SelectCase { filter: "a/b/c", name: "a/b/c", want: true }
        SelectCase { filter: "a/b/c", name: "a/b/x", want: false }
        SelectCase { filter: "a/b/c", name: "a/x/c", want: false }
        SelectCase { filter: "a/b/c", name: "x/b/c", want: false }
        SelectCase { filter: "a", name: "xyz/abc", want: false }
        SelectCase { filter: "b", name: "abc/xyz", want: true }
    ]
    t.table_of(cases, select_name, fn(st, c) {
        st.equal(selected(c.filter, c.name), c.want)
    })
}

fn test_selected_lets_deeper_levels_of_the_name_match_anything(t: *T) {
    let cases = [
        SelectCase { filter: "a", name: "abc/anything/else", want: true }
        SelectCase { filter: "a/b", name: "abc/bcd/zzz", want: true }
        SelectCase { filter: "a/b", name: "abc/bcd/zzz/more", want: true }
        SelectCase { filter: "a/b", name: "abc/xyz/zzz", want: false }
    ]
    t.table_of(cases, select_name, fn(st, c) {
        st.equal(selected(c.filter, c.name), c.want)
    })
}

fn test_selected_lets_a_shorter_name_match_a_longer_filter(t: *T) {
    let cases = [
        SelectCase { filter: "a/b", name: "abc", want: true }
        SelectCase { filter: "a/b/c", name: "abc", want: true }
        SelectCase { filter: "a/b/c", name: "abc/xbz", want: true }
        SelectCase { filter: "a/b", name: "xyz", want: false }
    ]
    t.table_of(cases, select_name, fn(st, c) {
        st.equal(selected(c.filter, c.name), c.want)
    })
}

fn test_selected_treats_empty_levels_as_matching_everything(t: *T) {
    let cases = [
        SelectCase { filter: "/b", name: "abc/b", want: true }
        SelectCase { filter: "/b", name: "abc/x", want: false }
        SelectCase { filter: "a/", name: "abc/anything", want: true }
        SelectCase { filter: "a/", name: "xyz/anything", want: false }
        SelectCase { filter: "/", name: "abc/def", want: true }
        SelectCase { filter: "a//c", name: "abc/anything/xcx", want: true }
        SelectCase { filter: "a//c", name: "abc/anything/xyz", want: false }
        SelectCase { filter: "a", name: "/abc", want: false }
        SelectCase { filter: "a", name: "abc/", want: true }
    ]
    t.table_of(cases, select_name, fn(st, c) {
        st.equal(selected(c.filter, c.name), c.want)
    })
}

fn test_settings_from_without_flags_gives_the_defaults(t: *T) {
    let defaults = Settings {}
    let got = settings_from([]) catch { e => unexpected(t, e, defaults) }
    t.equal(got.filter, defaults.filter)
    t.equal(got.verbose, defaults.verbose)
    t.equal(got.timing, defaults.timing)
    t.equal(got.timeout_ms, defaults.timeout_ms)
    t.equal(got.golden_dir, defaults.golden_dir)
    t.equal(got.update_golden, defaults.update_golden)
    t.equal(got.list, defaults.list)
    t.equal(got.one, defaults.one)
    t.equal(got.timeout_ms, 30000)
}

fn test_settings_from_reads_each_flag(t: *T) {
    var filter = flag_case(["-run", "parse/ok"])
    filter.filter = "parse/ok"
    var verbose = flag_case(["-v"])
    verbose.verbose = true
    var quiet = flag_case(["-notime"])
    quiet.timing = false
    var update = flag_case(["-update"])
    update.update_golden = true
    var timeout = flag_case(["-timeout", "250"])
    timeout.timeout_ms = 250
    var unlimited = flag_case(["-timeout", "0"])
    unlimited.timeout_ms = 0
    var list = flag_case(["-list"])
    list.list = true
    var one = flag_case(["-one", "alpha"])
    one.one = "alpha"
    let cases = [filter, verbose, quiet, update, timeout, unlimited, list, one]
    t.table_of(cases, flag_name, fn(st, c) {
        let defaults = Settings {}
        let got = settings_from(c.args) catch { e => unexpected(st, e, defaults) }
        st.equal(got.filter, c.filter)
        st.equal(got.verbose, c.verbose)
        st.equal(got.timing, c.timing)
        st.equal(got.update_golden, c.update_golden)
        st.equal(got.timeout_ms, c.timeout_ms)
        st.equal(got.list, c.list)
        st.equal(got.one, c.one)
    })
}

fn test_settings_from_combines_flags(t: *T) {
    let defaults = Settings {}
    let args = ["-v", "-run", "alpha", "-notime", "-timeout", "0", "-list", "-one", "beta", "-update"]
    let got = settings_from(args) catch { e => unexpected(t, e, defaults) }
    t.equal(got.filter, "alpha")
    t.is_true(got.verbose)
    t.is_false(got.timing)
    t.is_true(got.update_golden)
    t.equal(got.timeout_ms, 0)
    t.is_true(got.list)
    t.equal(got.one, "beta")
}

fn test_settings_from_accepts_the_joined_and_double_dash_forms(t: *T) {
    let defaults = Settings {}
    let joined = settings_from(["-run=alpha", "--one=beta", "--timeout=0", "--list"]) catch { e => unexpected(t, e, defaults) }
    t.equal(joined.filter, "alpha")
    t.equal(joined.one, "beta")
    t.equal(joined.timeout_ms, 0)
    t.is_true(joined.list)
}

fn test_settings_from_keeps_the_last_value_of_a_repeated_flag(t: *T) {
    let defaults = Settings {}
    let got = settings_from(["-run", "first", "-run", "second", "-timeout", "5", "-timeout", "0"]) catch { e => unexpected(t, e, defaults) }
    t.equal(got.filter, "second")
    t.equal(got.timeout_ms, 0)
}

fn test_settings_from_leaves_the_golden_directory_alone(t: *T) {
    let defaults = Settings {}
    let got = settings_from(["-update", "-v"]) catch { e => unexpected(t, e, defaults) }
    t.equal(got.golden_dir, "testdata")
}

fn test_settings_from_failures(t: *T) {
    let cases = [
        FlagFailure { args: ["-nope"], message: "unknown flag -nope" }
        FlagFailure { args: ["--nope=1"], message: "unknown flag -nope" }
        FlagFailure { args: ["-run"], message: "flag -run needs a value" }
        FlagFailure { args: ["-one"], message: "flag -one needs a value" }
        FlagFailure { args: ["-timeout"], message: "flag -timeout needs a value" }
        FlagFailure { args: ["-timeout", "soon"], message: "flag -timeout cannot take soon" }
        FlagFailure { args: ["-timeout", "1.5"], message: "flag -timeout cannot take 1.5" }
        FlagFailure { args: ["-timeout="], message: "flag -timeout cannot take " }
        FlagFailure { args: ["-v", "-nope"], message: "unknown flag -nope" }
    ]
    t.table_of(cases, flag_failure_name, fn(st, c) {
        st.equal(settings_failure(c.args), c.message)
    })
}

fn test_flag_message_names_the_flag_and_value(t: *T) {
    t.equal(flag_message(flag.Error.Unknown("x")), "unknown flag -x")
    t.equal(flag_message(flag.Error.Missing("run")), "flag -run needs a value")
    t.equal(flag_message(flag.Error.Invalid("timeout", "abc")), "flag -timeout cannot take abc")
}

fn test_specs_describe_every_flag_that_settings_from_reads(t: *T) {
    let names = ["run", "v", "notime", "update", "timeout", "list", "one"]
    var found: []str = []
    for spec in specs() {
        push(mut found, spec.name)
    }
    t.equal_slice(found, names)
}
