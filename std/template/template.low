import std/io

/// How the value of an `{{ expression }}` is escaped before it is written.
pub enum Escape {
    /// Escapes `&`, `<`, `>`, `"` and `'` as HTML entities. A `Data.Safe` value and the output of the `raw` filter are written unchanged.
    Html
    /// Writes values as they are.
    None
}

/// Why compiling or rendering a template failed.
/// `template` names the template where the problem is, and `line` and `column` count from 1, with the column in bytes. `describe` formats an error as one line.
pub enum Error {
    /// The template source is not valid: an unclosed tag, an unknown or unbalanced statement, or a bad expression. `message` says which.
    Parse(template: str, line: i64, column: i64, message: str)
    /// Rendering failed: a value has the wrong type for an operation or a filter, an unknown filter is used, or, with `Options.strict`, a name, key or index is missing. `message` says which.
    Render(template: str, line: i64, column: i64, message: str)
    /// An `include`, `extends` or `render` names a template that is not in the `Set`. `name` is the missing template.
    /// `line` and `column` are `0` when the name came directly from `render` or `render_to`.
    NotFound(template: str, line: i64, column: i64, name: str)
    /// The `include` and `extends` chain is deeper than `Options.max_depth`.
    TooDeep(template: str, line: i64, column: i64)
    /// The output would be longer than `Options.max_output` bytes.
    TooLarge
    /// Writing to the stream given to `render_to` failed with `cause`.
    Write(cause: io.Error)
}

/// Why a filter registered with `add_filter` rejected its input.
pub enum FilterError {
    /// The filter cannot work with its subject or arguments. `message` is reported in a `Render` error as `filter name: message`.
    Invalid(message: str)
}

/// Settings of a `Set`.
pub struct Options {
    /// How values are escaped on output. Defaults to `Html`.
    pub escape: Escape = Html
    /// Whether a missing value is an error. When `true`, an undefined variable, a missing map key or list index, and a member read of `null` fail with `Error.Render`. When `false`, the default, they give `null`. The subject of the `default` filter is always lenient.
    pub strict: bool = false
    /// The deepest nesting of `include` and `extends` allowed. Defaults to `32`.
    pub max_depth: i64 = 32
    /// The most output a single render may produce, in bytes. Defaults to 16 MiB.
    pub max_output: i64 = 16777216
}

/// A collection of named templates and filters that render together.
/// A `Set` is only read while rendering, so green threads may share one once it is built. `include` and `extends` look templates up by name in the same `Set`.
pub struct Set {
    options: Options
    templates: [str: *Template]
    filters: [str: fn(Data, []Data) -> Data ! FilterError]
}

/// Returns an empty `Set` with `options`.
pub fn set(options: Options) -> Set {
    let templates: [str: *Template] = [:]
    let filters: [str: fn(Data, []Data) -> Data ! FilterError] = [:]
    Set { options, templates, filters }
}

/// Compiles `source` and adds it to `s` under `name`, replacing any template of that name.
/// Fails with `Error.Parse` when the source is not a valid template.
pub fn add(mut s: Set, name: str, source: str) ! Error {
    let t = compile(name, source)?
    s.templates[name] = new(t)
}

/// Registers the filter function `f` under `name` for use as `value | name(arguments)`.
/// `f` receives the subject and the argument list. It takes precedence over a built-in filter of the same name, and a `FilterError` it returns becomes an `Error.Render`.
pub fn add_filter(mut s: Set, name: str, f: fn(Data, []Data) -> Data ! FilterError) {
    s.filters[name] = f
}

/// Returns whether `s` has a template named `name`.
pub fn has(s: Set, name: str) -> bool {
    match s.templates[name] {
        some(_) => true
        none => false
    }
}

/// Returns `e` as a one-line message, `template:line:column: message`.
/// A `NotFound` for a name given to `render` has no position and reads `template NAME not found`.
pub fn describe(e: Error) -> str {
    match e {
        Parse(template, line, column, message) => "{template}:{line}:{column}: {message}"
        Render(template, line, column, message) => "{template}:{line}:{column}: {message}"
        NotFound(template, line, column, name) => {
            if line == 0 {
                return "template {name} not found"
            }
            "{template}:{line}:{column}: template {name} not found"
        }
        TooDeep(template, line, column) => "{template}:{line}:{column}: templates are nested too deeply"
        TooLarge => "output is too large"
        Write(_) => "write failed"
    }
}

/// Renders the template `name` of `s` with `data` and returns the output.
/// `data` is the root scope: names in the template are looked up in it when it is a `Data.Map`. Fails with `NotFound` when `name` is not in `s`, and with `Render`, `TooDeep` or `TooLarge` while rendering.
pub fn render(s: Set, name: str, data: Data) -> str ! Error {
    let c = start(s, data, none)
    render_named(c, name)?
    __str_view(c.out)
}

/// Renders the template `name` of `s` with `data` and writes the output to `out`.
/// Output is written in chunks as it is produced, so part of it may already be written when an error is returned. Fails as `render` does and with `Write` when `out` fails.
pub fn render_to(s: Set, name: str, data: Data, out: io.Stream) ! Error {
    let c = start(s, data, out)
    render_named(c, name)?
    flush(c)?
}

/// Compiles `source` and renders it once with `data`, with default `Options`.
pub fn render_source(source: str, data: Data) -> str ! Error {
    var s = set(Options {})
    s.add("source", source)?
    s.render("source", data)?
}
