struct Pos {
    line: i64
    column: i64
}

enum Op {
    Or
    And
    Equal
    NotEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    Contains
    Add
    Subtract
    Multiply
    Divide
    Remainder
}

enum Expr {
    Literal(Data)
    Variable(str, Pos)
    LoopVar(str, Pos)
    Member(*Expr, str, Pos)
    Index(*Expr, *Expr, Pos)
    Negate(*Expr, Pos)
    Not(*Expr)
    Binary(Op, *Expr, *Expr, Pos)
    Filter(*Expr, str, []Expr, Pos)
}

struct Branch {
    cond: Expr
    body: []Node
}

struct Each {
    key: str
    value: str
    iterable: Expr
    body: []Node
    empty: []Node
    pos: Pos
}

enum Node {
    Text(str)
    Output(Expr, Pos)
    If([]Branch, []Node)
    Loop(Each)
    Include(Expr, Pos)
    Block(str, []Node)
    Let(str, Expr)
}

struct Template {
    name: str
    nodes: []Node
    parent: str
    parent_pos: Pos
    extends: bool
    blocks: [str: []Node]
}
