import std/testing

struct Texts {
    name: str
    pattern: str
    flags: Flags
    input: str
    want: str[]
}

struct Offsets {
    name: str
    pattern: str
    input: str
    want: i64[]
}

struct Verdict {
    name: str
    pattern: str
    flags: Flags
    input: str
    want: bool
}

fn caseless() -> Flags {
    Flags { ignore_case: true }
}

fn lines() -> Flags {
    Flags { multiline: true }
}

fn exact() -> Flags {
    Flags {}
}

fn built(t: *testing.T, pattern: str, flags: Flags) -> Regex {
    compile_with(pattern, flags) catch {
        Invalid(at, message) => t.must(message, Regex { engine: interpreted([]), groups: 0 })
    }
}

fn texts_of(re: Regex, input: str) -> str[] {
    var out: str[] = []
    for m in find_all(re, input) {
        out.push(text(m))
    }
    out
}

fn starts_of(re: Regex, input: str) -> i64[] {
    var out: i64[] = []
    for m in find_all(re, input) {
        out.push(start(m))
    }
    out
}

fn ends_of(re: Regex, input: str) -> i64[] {
    var out: i64[] = []
    for m in find_all(re, input) {
        out.push(end(m))
    }
    out
}

fn texts_name(c: Texts) -> str {
    c.name
}

fn offsets_name(c: Offsets) -> str {
    c.name
}

fn verdict_name(c: Verdict) -> str {
    c.name
}

fn check_texts(t: *testing.T, cases: Texts[]) {
    testing.table_of(t, cases, texts_name, fn(t: *testing.T, c: Texts) {
        let re = built(t, c.pattern, c.flags)
        t.equal_slice(texts_of(re, c.input), c.want)
    })
}

fn check_verdicts(t: *testing.T, cases: Verdict[]) {
    testing.table_of(t, cases, verdict_name, fn(t: *testing.T, c: Verdict) {
        let re = built(t, c.pattern, c.flags)
        t.equal(is_match(re, c.input), c.want)
    })
}

fn test_fold_orbits(t: *testing.T) {
    check_texts(t, [
        Texts { name: "k", pattern: "k", flags: caseless(), input: "k K \u212A", want: ["k", "K", "\u212A"] }
        Texts { name: "kelvin sign", pattern: "\\u212A", flags: caseless(), input: "k K \u212A", want: ["k", "K", "\u212A"] }
        Texts { name: "capital k", pattern: "K", flags: caseless(), input: "k K \u212A", want: ["k", "K", "\u212A"] }
        Texts { name: "s", pattern: "s", flags: caseless(), input: "s S \u017F", want: ["s", "S", "\u017F"] }
        Texts { name: "long s", pattern: "\u017F", flags: caseless(), input: "s S \u017F", want: ["s", "S", "\u017F"] }
        Texts { name: "sigma", pattern: "\u03C3", flags: caseless(), input: "\u03C3 \u03C2 \u03A3", want: ["\u03C3", "\u03C2", "\u03A3"] }
        Texts { name: "final sigma", pattern: "\u03C2", flags: caseless(), input: "\u03C3 \u03C2 \u03A3", want: ["\u03C3", "\u03C2", "\u03A3"] }
        Texts { name: "capital sigma", pattern: "\u03A3", flags: caseless(), input: "\u03C3 \u03C2 \u03A3", want: ["\u03C3", "\u03C2", "\u03A3"] }
        Texts { name: "sharp s", pattern: "\u00DF", flags: caseless(), input: "\u00DF \u1E9E", want: ["\u00DF", "\u1E9E"] }
        Texts { name: "capital sharp s", pattern: "\u1E9E", flags: caseless(), input: "\u00DF \u1E9E", want: ["\u00DF", "\u1E9E"] }
        Texts { name: "cherokee", pattern: "\u13A0", flags: caseless(), input: "\u13A0 \uAB70", want: ["\u13A0", "\uAB70"] }
        Texts { name: "cherokee small", pattern: "\uAB70", flags: caseless(), input: "\u13A0 \uAB70", want: ["\u13A0", "\uAB70"] }
        Texts { name: "digraph capital", pattern: "\u01C4", flags: caseless(), input: "\u01C4\u01C5\u01C6", want: ["\u01C4", "\u01C5", "\u01C6"] }
        Texts { name: "digraph title", pattern: "\u01C5", flags: caseless(), input: "\u01C4\u01C5\u01C6", want: ["\u01C4", "\u01C5", "\u01C6"] }
        Texts { name: "digraph small", pattern: "\u01C6", flags: caseless(), input: "\u01C4\u01C5\u01C6", want: ["\u01C4", "\u01C5", "\u01C6"] }
        Texts { name: "adjacent pair", pattern: "\u0101", flags: caseless(), input: "\u0100\u0101", want: ["\u0100", "\u0101"] }
        Texts { name: "accent", pattern: "\u00E9", flags: caseless(), input: "\u00C9 \u00E9", want: ["\u00C9", "\u00E9"] }
        Texts { name: "greek and cyrillic", pattern: "\u0436\u03B1", flags: caseless(), input: "\u0416\u0391", want: ["\u0416\u0391"] }
        Texts { name: "ascii", pattern: "abc", flags: caseless(), input: "ABC aBc", want: ["ABC", "aBc"] }
        Texts { name: "scoped", pattern: "(?i:k)k", flags: exact(), input: "Kk KK", want: ["Kk"] }
        Texts { name: "inline", pattern: "(?i)\u00E9", flags: exact(), input: "\u00C9", want: ["\u00C9"] }
        Texts { name: "switched off", pattern: "(?i)(?-i)k", flags: exact(), input: "k K \u212A", want: ["k"] }
        Texts { name: "case-sensitive", pattern: "k", flags: exact(), input: "k K \u212A", want: ["k"] }
        Texts { name: "case-sensitive accent", pattern: "\u00E9", flags: exact(), input: "\u00C9 \u00E9", want: ["\u00E9"] }
    ])
}

fn test_fold_classes(t: *testing.T) {
    check_texts(t, [
        Texts { name: "range", pattern: "[a-z]", flags: caseless(), input: "\u212A\u017F", want: ["\u212A", "\u017F"] }
        Texts { name: "range upper", pattern: "[A-Z]+", flags: caseless(), input: "aK\u212A\u017Fz", want: ["aK\u212A\u017Fz"] }
        Texts { name: "single member", pattern: "[k]", flags: caseless(), input: "kK\u212Ax", want: ["k", "K", "\u212A"] }
        Texts { name: "negated", pattern: "[^k]", flags: caseless(), input: "kK\u212Axy", want: ["x", "y"] }
        Texts { name: "negated kelvin", pattern: "[^\\u212A]", flags: caseless(), input: "kK\u212Axy", want: ["x", "y"] }
        Texts { name: "negated range", pattern: "[^a-z]", flags: caseless(), input: "aZ\u212A\u017F1", want: ["1"] }
        Texts { name: "negated case-sensitive", pattern: "[^k]", flags: exact(), input: "kK\u212A", want: ["K", "\u212A"] }
        Texts { name: "greek range", pattern: "[\u03B1-\u03C9]+", flags: caseless(), input: "\u03A3\u03C2\u0391", want: ["\u03A3\u03C2\u0391"] }
        Texts { name: "whole code space", pattern: "[\\x00-\\U0010FFFF]", flags: caseless(), input: "a\u212A", want: ["a", "\u212A"] }
        Texts { name: "class with word", pattern: "[\\w]+", flags: caseless(), input: "\u212Ak\u00E9", want: ["\u212Ak\u00E9"] }
        Texts { name: "mixed items", pattern: "[x\u00E9]", flags: caseless(), input: "X\u00C9", want: ["X", "\u00C9"] }
    ])
}

fn test_word_classes(t: *testing.T) {
    check_texts(t, [
        Texts { name: "latin", pattern: "\\w+", flags: exact(), input: "caf\u00E9 na\u00EFve", want: ["caf\u00E9", "na\u00EFve"] }
        Texts { name: "boundaries", pattern: "\\b\\w+\\b", flags: exact(), input: "caf\u00E9 na\u00EFve \u65E5\u672C\u8A9E", want: ["caf\u00E9", "na\u00EFve", "\u65E5\u672C\u8A9E"] }
        Texts { name: "combining mark", pattern: "\\w+", flags: exact(), input: "e\u0301x y", want: ["e\u0301x", "y"] }
        Texts { name: "lone mark", pattern: "\\w", flags: exact(), input: "\u0301", want: ["\u0301"] }
        Texts { name: "joiner", pattern: "\\w+", flags: exact(), input: "a\u200Db a\u200Cb", want: ["a\u200Db", "a\u200Cb"] }
        Texts { name: "decimal number", pattern: "\\w+", flags: exact(), input: "\u0663\u0664 x", want: ["\u0663\u0664", "x"] }
        Texts { name: "connector", pattern: "\\w+", flags: exact(), input: "a\u203Fb", want: ["a\u203Fb"] }
        Texts { name: "letter number", pattern: "\\w", flags: exact(), input: "\u2163", want: ["\u2163"] }
        Texts { name: "circled letter", pattern: "\\w", flags: exact(), input: "\u24B6\u24D0", want: ["\u24B6", "\u24D0"] }
        Texts { name: "supplementary", pattern: "\\b\\w\\b", flags: exact(), input: "\U0001D49C", want: ["\U0001D49C"] }
        Texts { name: "not word", pattern: "\\W", flags: exact(), input: "\u00E9 \u3002\U0001F600\u00B2", want: [" ", "\u3002", "\U0001F600", "\u00B2"] }
        Texts { name: "negated class", pattern: "[^\\W\\d]+", flags: exact(), input: "\u00E9a1", want: ["\u00E9a"] }
        Texts { name: "class with digits", pattern: "[\\d\\w-]+", flags: exact(), input: "\u00E9-1", want: ["\u00E9-1"] }
        Texts { name: "digit stays ascii", pattern: "\\d+", flags: exact(), input: "12\u0663", want: ["12"] }
        Texts { name: "space stays ascii", pattern: "\\s", flags: exact(), input: "a\u00A0 ", want: [" "] }
        Texts { name: "caseless word", pattern: "\\w+", flags: caseless(), input: "\u212A\u00E9", want: ["\u212A\u00E9"] }
        Texts { name: "caseless non-word", pattern: "\\W", flags: caseless(), input: "a\u212A!", want: ["!"] }
    ])
}

fn test_word_boundaries(t: *testing.T) {
    check_verdicts(t, [
        Verdict { name: "after space", pattern: "\\b\u00E9", flags: exact(), input: " \u00E9", want: true }
        Verdict { name: "inside word", pattern: "\\b\u00E9", flags: exact(), input: "a\u00E9", want: false }
        Verdict { name: "not boundary inside", pattern: "a\\B\u00E9", flags: exact(), input: "a\u00E9", want: true }
        Verdict { name: "boundary at end", pattern: "\u00E9\\b", flags: exact(), input: "caf\u00E9", want: true }
        Verdict { name: "not boundary before letter", pattern: "\\Bf\u00E9", flags: exact(), input: "caf\u00E9", want: true }
        Verdict { name: "mark continues word", pattern: "e\\B\u0301", flags: exact(), input: "e\u0301", want: true }
        Verdict { name: "ideographs", pattern: "\\b\u672C\\b", flags: exact(), input: "\u65E5\u672C\u8A9E", want: false }
        Verdict { name: "ideographs apart", pattern: "\\b\u672C\\b", flags: exact(), input: "\u65E5 \u672C \u8A9E", want: true }
        Verdict { name: "punctuation before", pattern: "\\b\u00E9", flags: exact(), input: "\u3002\u00E9", want: true }
        Verdict { name: "invalid byte after", pattern: "a\\b", flags: exact(), input: "a\xE9", want: true }
        Verdict { name: "invalid byte before", pattern: "\\ba", flags: exact(), input: "\xE9a", want: true }
        Verdict { name: "truncated sequence", pattern: "a\\b", flags: exact(), input: "a\xE3\x81", want: true }
        Verdict { name: "stray continuation", pattern: "\\ba", flags: exact(), input: "\x80a", want: true }
        Verdict { name: "ascii word", pattern: "\\bfoo\\b", flags: exact(), input: "a foo_", want: false }
        Verdict { name: "ascii boundary", pattern: "\\bfoo\\b", flags: exact(), input: "a foo!", want: true }
    ])
}

fn test_multiline_starts(t: *testing.T) {
    let cases = [
        Offsets { name: "lf", pattern: "^", input: "a\nb", want: [0, 2] }
        Offsets { name: "cr", pattern: "^", input: "a\rb", want: [0, 2] }
        Offsets { name: "crlf", pattern: "^", input: "a\r\nb", want: [0, 3] }
        Offsets { name: "lf then cr", pattern: "^", input: "a\n\rb", want: [0, 2, 3] }
        Offsets { name: "two cr", pattern: "^", input: "\r\r", want: [0, 1, 2] }
        Offsets { name: "trailing cr", pattern: "^", input: "a\r", want: [0, 2] }
        Offsets { name: "trailing lf", pattern: "^", input: "a\n", want: [0, 2] }
        Offsets { name: "bare crlf", pattern: "^", input: "\r\n", want: [0, 2] }
        Offsets { name: "empty", pattern: "^", input: "", want: [0] }
        Offsets { name: "mixed", pattern: "^", input: "one\ntwo\rthree\r\nfour", want: [0, 4, 8, 15] }
    ]
    testing.table_of(t, cases, offsets_name, fn(t: *testing.T, c: Offsets) {
        let re = built(t, c.pattern, lines())
        t.equal_slice(starts_of(re, c.input), c.want)
    })
}

fn test_multiline_ends(t: *testing.T) {
    let cases = [
        Offsets { name: "lf", pattern: "$", input: "a\nb", want: [1, 3] }
        Offsets { name: "cr", pattern: "$", input: "a\rb", want: [1, 3] }
        Offsets { name: "crlf", pattern: "$", input: "a\r\nb", want: [1, 4] }
        Offsets { name: "lf then cr", pattern: "$", input: "a\n\rb", want: [1, 2, 4] }
        Offsets { name: "two cr", pattern: "$", input: "a\r\r", want: [1, 2, 3] }
        Offsets { name: "trailing cr", pattern: "$", input: "a\r", want: [1, 2] }
        Offsets { name: "trailing lf", pattern: "$", input: "a\n", want: [1, 2] }
        Offsets { name: "bare crlf", pattern: "$", input: "\r\n", want: [0, 2] }
        Offsets { name: "empty", pattern: "$", input: "", want: [0] }
        Offsets { name: "mixed", pattern: "$", input: "one\ntwo\rthree\r\nfour", want: [3, 7, 13, 19] }
    ]
    testing.table_of(t, cases, offsets_name, fn(t: *testing.T, c: Offsets) {
        let re = built(t, c.pattern, lines())
        t.equal_slice(starts_of(re, c.input), c.want)
    })
}

fn test_multiline_lines(t: *testing.T) {
    check_texts(t, [
        Texts { name: "lf lines", pattern: "^\\w+$", flags: lines(), input: "one\ntwo\nthree", want: ["one", "two", "three"] }
        Texts { name: "cr lines", pattern: "^\\w+$", flags: lines(), input: "one\rtwo\rthree", want: ["one", "two", "three"] }
        Texts { name: "crlf lines", pattern: "^\\w+$", flags: lines(), input: "one\r\ntwo\r\nthree", want: ["one", "two", "three"] }
        Texts { name: "mixed lines", pattern: "^\\w+$", flags: lines(), input: "one\ntwo\rthree\r\nfour", want: ["one", "two", "three", "four"] }
        Texts { name: "empty lines", pattern: "^$", flags: lines(), input: "a\r\rb\n\nc", want: ["", ""] }
        Texts { name: "dot keeps carriage return", pattern: "^.*$", flags: lines(), input: "a\rb", want: ["a\rb"] }
        Texts { name: "class stops at line end", pattern: "^[^\\r\\n]*$", flags: lines(), input: "a\rb\r\nc", want: ["a", "b", "c"] }
        Texts { name: "inline flag", pattern: "(?m)^b$", flags: exact(), input: "a\rb\rc", want: ["b"] }
    ])
}

fn test_multiline_crlf_is_one_terminator(t: *testing.T) {
    let re = built(t, "(?m)a$", exact())
    t.equal_slice(ends_of(re, "a\r\nb"), [1])
    let between = built(t, "(?m)a\\r$", exact())
    t.equal(is_match(between, "a\r\n"), false)
    let before_lf = built(t, "(?m)a\\r\\n$", exact())
    t.equal(is_match(before_lf, "a\r\n"), true)
}

fn test_text_anchors_ignore_carriage_return(t: *testing.T) {
    check_verdicts(t, [
        Verdict { name: "start after cr", pattern: "^b", flags: exact(), input: "a\rb", want: false }
        Verdict { name: "start after lf", pattern: "^b", flags: exact(), input: "a\nb", want: false }
        Verdict { name: "end before cr", pattern: "a$", flags: exact(), input: "a\rb", want: false }
        Verdict { name: "end before final cr", pattern: "a$", flags: exact(), input: "a\r", want: false }
        Verdict { name: "end before final lf", pattern: "a$", flags: exact(), input: "a\n", want: true }
        Verdict { name: "absolute end before lf", pattern: "a\\z", flags: exact(), input: "a\n", want: false }
    ])
}

fn test_engine_paths(t: *testing.T) {
    let re = built(t, "(?i)(k+)(\\w+)", exact())
    let m = find(re, "x \u212AK\u00E9 y") ?? return t.fatal("no match")
    t.equal(text(m), "\u212AK\u00E9")
    t.equal(group(m, 1) ?? "", "\u212AK")
    t.equal(group(m, 2) ?? "", "\u00E9")
    t.equal(is_match(re, "none here!"), false)
    t.equal(is_match(re, "\u212A"), false)
    let parts = split(built(t, "\\W+", exact()), "caf\u00E9, na\u00EFve; \u65E5\u672C")
    t.equal_slice(parts, ["caf\u00E9", "na\u00EFve", "\u65E5\u672C"])
    let replaced = replace_all(built(t, "(?i)k", exact()), "kK\u212A!", fn(found: Match) -> str { "." })
    t.equal(replaced, "...!")
    t.equal(full_match(built(t, "(?i)\\w+", exact()), "\u212A\u017F") != none, true)
}
