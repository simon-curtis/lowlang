import std/regex
import std/text

fn matched(m: regex.Match?) -> bool {
    match m {
        some(_) => true
        none => false
    }
}

fn reject(pattern: str) {
    regex.compile(pattern) catch {
        Invalid(at, message) => {
            print("pattern {text.quote(pattern)} rejected at {at}: {message}")
            return
        }
    }
}

/// Extracts fields from log text with capture groups, rewrites matches, splits on separators and reports a malformed pattern.
fn main() ! regex.Error {
    let log = "2025-03-14 09:26:53 ERROR disk /dev/sda1 at 93%\n2025-03-14 09:27:01 INFO backup finished in 12s\n2025-03-15 00:00:07 ERROR disk /dev/sdb2 at 97%\n"

    let entry = regex.compile("(?m)^(\\d{{4}})-(\\d\\d)-(\\d\\d) [\\d:]+ (ERROR|WARN) (.*)$")?
    print("groups: {regex.group_count(entry)}")
    for m in regex.find_all(entry, log) {
        let month = regex.group(m, 2) ?? "?"
        let day = regex.group(m, 3) ?? "?"
        let rest = regex.group(m, 5) ?? ""
        print("{day}/{month} {rest} (bytes {regex.start(m)}..{regex.end(m)})")
    }

    let percent = regex.compile("(\\d+)%")?
    let rounded = regex.replace_all(percent, log, fn(m: regex.Match) -> str {
        let value = regex.group(m, 1) ?? "0"
        let n = text.parse_int(value) or 0
        "{n / 10 * 10}%"
    })
    print(text.lines(rounded)[0])

    let disk = regex.compile("/dev/(sd[a-z])(\\d)")?
    let found = regex.find(disk, log) ?? return
    print("{regex.text(found)}: device {regex.group(found, 1) ?? ""} partition {regex.group(found, 2) ?? ""}")

    let separator = regex.compile("\\s*[,;]\\s*")?
    print(regex.split(separator, "red , green;blue ,yellow"))
    print(regex.split_n(separator, "a,b,c,d", 2))

    let loud = regex.compile_with("error", regex.Flags { ignore_case: true })?
    print("case-insensitive matches: {regex.find_all(loud, log).len}")

    let hex = regex.compile("[a-f0-9]+")?
    print("whole match: {matched(regex.full_match(hex, "cafe42"))} {matched(regex.full_match(hex, "cafe42!"))}")

    reject("(unclosed")
    reject("*start")
    reject("(?=ahead)")
}
