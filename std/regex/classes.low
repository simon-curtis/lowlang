import std/unicode

fn table_u32(table: str, at: i64) -> u32 {
    u32(table[at]) | u32(table[at + 1]) << 8 | u32(table[at + 2]) << 16 | u32(table[at + 3]) << 24
}

fn orbit_count(table: str) -> i64 {
    table.len / fold_entry_size
}

fn orbit_code(table: str, i: i64) -> u32 {
    table_u32(table, i * fold_entry_size)
}

fn orbit_following(table: str, i: i64) -> u32 {
    table_u32(table, i * fold_entry_size + 4)
}

fn orbit_from(table: str, code: u32) -> i64 {
    var lo = 0
    var hi = orbit_count(table)
    for lo < hi {
        let mid = (lo + hi) / 2
        if orbit_code(table, mid) < code {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

fn orbit_next(table: str, c: u32) -> u32 {
    let i = orbit_from(table, c)
    if i < orbit_count(table) && orbit_code(table, i) == c {
        return orbit_following(table, i)
    }
    c
}

fn add_orbit(mut out: Range[], table: str, c: u32) {
    var member = orbit_next(table, c)
    for member != c {
        out.push(Range { lo: member, hi: member })
        member = orbit_next(table, member)
    }
}

fn fold(ranges: Range[]) -> Range[] {
    let table = fold_orbits_table()
    let count = orbit_count(table)
    var out: Range[] = []
    for r in ranges {
        out.push(r)
        var i = orbit_from(table, r.lo)
        for i < count && orbit_code(table, i) <= r.hi {
            add_orbit(mut out, table, orbit_code(table, i))
            i += 1
        }
    }
    normalize(out)
}

fn word() -> Range[] {
    let table = word_ranges_table()
    var out: Range[] = []
    var at = 0
    for at < table.len {
        out.push(Range { lo: table_u32(table, at), hi: table_u32(table, at + 4) })
        at += word_entry_size
    }
    out
}

fn word_rune(c: u32) -> bool {
    if c < 0x80 {
        return word_byte(u8(c))
    }
    let table = word_ranges_table()
    var lo = 0
    var hi = table.len / word_entry_size
    for lo < hi {
        let mid = (lo + hi) / 2
        let at = mid * word_entry_size
        if c < table_u32(table, at) {
            hi = mid
        } else if c > table_u32(table, at + 4) {
            lo = mid + 1
        } else {
            return true
        }
    }
    false
}

fn word_byte(c: u8) -> bool {
    c >= '0' && c <= '9' || c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c == '_'
}

fn word_before(input: str, pos: i64) -> bool {
    if pos == 0 {
        return false
    }
    let last = input[pos - 1]
    if last < 0x80 {
        return word_byte(last)
    }
    var start = pos - 1
    let floor = if pos > 4 { pos - 4 } else { 0 }
    for start > floor && input[start] & 0xC0 == 0x80 {
        start -= 1
    }
    let r = unicode.decode_rune(input, start)
    r.size == pos - start && !unicode.is_invalid(r) && word_rune(r.code)
}

fn word_at(input: str, pos: i64) -> bool {
    if pos >= input.len {
        return false
    }
    let first = input[pos]
    if first < 0x80 {
        return word_byte(first)
    }
    let r = unicode.decode_rune(input, pos)
    !unicode.is_invalid(r) && word_rune(r.code)
}

fn line_start(input: str, pos: i64) -> bool {
    if pos == 0 {
        return true
    }
    let before = input[pos - 1]
    if before == '\n' {
        return true
    }
    before == '\r' && (pos == input.len || input[pos] != '\n')
}

fn line_end(input: str, pos: i64) -> bool {
    if pos == input.len {
        return true
    }
    let at = input[pos]
    if at == '\r' {
        return true
    }
    at == '\n' && (pos == 0 || input[pos - 1] != '\r')
}
