import std/unicode

struct Search {
    from: i64
    anchored: bool = false
    whole: bool = false
    reject_empty: bool = false
    first: bool = false
}

struct Frame {
    pc: i64
    slot: i64
    value: i64
}

struct Queue {
    sparse: []i64
    pcs: []i64
    slots: []i64
    len: i64
}

struct Core {
    program: []Inst
    width: i64
    input: str
    scratch: []i64
    stack: []Frame
}

struct Machine {
    core: Core
    run: Queue
    next: Queue
    best: []i64
    matched: bool
    engine: Engine
    link: *Machine?
}

struct Pool {
    lock: i64
    idle: *Machine?
}

fn new_pool() -> *Pool {
    new(Pool { lock: 0, idle: none })
}

struct Engine {
    program: []Inst
    size: i64
    start: fn(mut Core, mut Queue, i64)
    step: fn(mut Machine, Search, i64, u32, i64)
    skip: fn(str, i64) -> i64
}

fn interpreted(program: []Inst) -> Engine {
    Engine { program, size: program.len, start: start_thread, step, skip: stay }
}

fn stay(input: str, from: i64) -> i64 {
    from
}

const end_of_input: u32 = 0xFFFFFFFF

fn queue(size: i64, width: i64) -> Queue {
    Queue { sparse: __make(size), pcs: __make(size), slots: __make(size * width), len: 0 }
}

fn machine(re: Regex, width: i64, input: str) -> Machine {
    let engine = re.engine
    let program = engine.program
    let core = Core { program, width, input, scratch: __make(slot_count(re)), stack: __make(2 * program.len + 2) }
    let run = queue(engine.size, width)
    let next = queue(engine.size, width)
    Machine { core, run, next, best: __make(width), matched: false, engine, link: none }
}

fn borrow(re: Regex, pool: *Pool, width: i64, input: str) -> *Machine {
    __lock(mut pool.lock)
    let idle = pool.idle
    match idle {
        some(m) => {
            pool.idle = m.link
            __unlock(mut pool.lock)
            m.core.input = input
            m
        }
        none => {
            __unlock(mut pool.lock)
            new(machine(re, width, input))
        }
    }
}

fn release(pool: *Pool, m: *Machine) {
    m.core.input = ""
    __lock(mut pool.lock)
    m.link = pool.idle
    pool.idle = some(m)
    __unlock(mut pool.lock)
}

fn search(mut m: Machine, s: Search) -> bool {
    let input = m.core.input
    let { start, step, skip } = m.engine
    m.matched = false
    m.run.len = 0
    var pos = s.from
    for {
        if m.run.len == 0 && (m.matched || s.anchored && pos > s.from) {
            break
        }
        if m.run.len == 0 && !s.anchored {
            pos = skip(input, pos)
        }
        if !m.matched && (!s.anchored || pos == s.from) {
            start(mut m.core, mut m.run, pos)
        }
        var c = end_of_input
        var width = 0
        if pos < input.len {
            let r = unicode.decode_rune(input, pos)
            c = r.code
            width = r.size
        }
        m.next.len = 0
        step(mut m, s, pos, c, pos + width)
        if s.first && m.matched || pos >= input.len {
            break
        }
        pos += width
        let done = m.run
        m.run = m.next
        m.next = done
    }
    m.matched
}

fn start_thread(mut core: Core, mut q: Queue, pos: i64) {
    for i in 0..core.width {
        core.scratch[i] = -1
    }
    add(core, mut q, 0, pos)
}

fn step(mut m: Machine, s: Search, pos: i64, c: u32, next_pos: i64) {
    for j in 0..m.run.len {
        let pc = m.run.pcs[j]
        match m.core.program[pc] {
            Done => {
                if accepts(m.core, s, pos) {
                    keep(mut m, j)
                    return
                }
            }
            Char(want) => {
                if c == want {
                    advance(mut m, j, pc, next_pos)
                }
            }
            Class(ranges) => {
                if in_class(ranges, c) {
                    advance(mut m, j, pc, next_pos)
                }
            }
            _ => {}
        }
    }
}

fn accepts(core: Core, s: Search, pos: i64) -> bool {
    if s.whole && pos != core.input.len {
        return false
    }
    !(s.reject_empty && pos == s.from)
}

fn keep(mut m: Machine, j: i64) {
    let w = m.core.width
    for i in 0..w {
        m.best[i] = m.run.slots[j * w + i]
    }
    m.matched = true
}

fn advance(mut m: Machine, j: i64, pc: i64, next_pos: i64) {
    resume(mut m, j)
    add(m.core, mut m.next, pc + 1, next_pos)
}

fn resume(mut m: Machine, j: i64) {
    let w = m.core.width
    for i in 0..w {
        m.core.scratch[i] = m.run.slots[j * w + i]
    }
}

fn add(core: Core, mut q: Queue, start: i64, pos: i64) {
    let stack = core.stack
    stack[0] = Frame { pc: start, slot: -1, value: 0 }
    var top = 1
    for top > 0 {
        top -= 1
        let f = stack[top]
        if f.slot >= 0 {
            core.scratch[f.slot] = f.value
            continue
        }
        let pc = f.pc
        let at = q.sparse[pc]
        if at < q.len && q.pcs[at] == pc {
            continue
        }
        let k = q.len
        q.sparse[pc] = k
        q.pcs[k] = pc
        q.len += 1
        match core.program[pc] {
            Jump(to) => {
                stack[top] = Frame { pc: to, slot: -1, value: 0 }
                top += 1
            }
            Split(first, second) => {
                stack[top] = Frame { pc: second, slot: -1, value: 0 }
                stack[top + 1] = Frame { pc: first, slot: -1, value: 0 }
                top += 2
            }
            Save(slot) => {
                if slot < core.width {
                    stack[top] = Frame { pc: -1, slot, value: core.scratch[slot] }
                    top += 1
                    core.scratch[slot] = pos
                }
                stack[top] = Frame { pc: pc + 1, slot: -1, value: 0 }
                top += 1
            }
            Check(look) => {
                if holds(look, core.input, pos) {
                    stack[top] = Frame { pc: pc + 1, slot: -1, value: 0 }
                    top += 1
                }
            }
            _ => {
                for i in 0..core.width {
                    q.slots[k * core.width + i] = core.scratch[i]
                }
            }
        }
    }
}

fn holds(look: Look, input: str, pos: i64) -> bool {
    match look {
        TextStart => pos == 0
        TextEnd => pos == input.len
        EndOrFinalNewline => pos == input.len || pos == input.len - 1 && input[pos] == '\n'
        LineStart => pos == 0 || input[pos - 1] == '\n'
        LineEnd => pos == input.len || input[pos] == '\n'
        WordBoundary => word_before(input, pos) != word_at(input, pos)
        NotWordBoundary => word_before(input, pos) == word_at(input, pos)
    }
}

fn word_before(input: str, pos: i64) -> bool {
    pos > 0 && word_byte(input[pos - 1])
}

fn word_at(input: str, pos: i64) -> bool {
    pos < input.len && word_byte(input[pos])
}

fn word_byte(c: u8) -> bool {
    c >= '0' && c <= '9' || c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c == '_'
}

fn in_class(ranges: []Range, c: u32) -> bool {
    var lo = 0
    var hi = ranges.len
    for lo < hi {
        let mid = (lo + hi) / 2
        let r = ranges[mid]
        if c < r.lo {
            hi = mid
        } else if c > r.hi {
            lo = mid + 1
        } else {
            return true
        }
    }
    false
}
