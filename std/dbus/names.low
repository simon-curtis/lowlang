const max_name_length = 255

fn letter(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
}

fn digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn identifier_byte(c: u8, first: bool) -> bool {
    letter(c) || c == '_' || !first && digit(c)
}

fn identifier(s: str) -> bool {
    if s.len == 0 {
        return false
    }
    for i in 0..s.len {
        if !identifier_byte(s[i], i == 0) {
            return false
        }
    }
    true
}

fn dotted_elements(s: str, element: fn(str) -> bool) -> bool {
    if s.len == 0 || s.len > max_name_length {
        return false
    }
    var elements = 0
    var start = 0
    for i in 0..s.len + 1 {
        if i == s.len || s[i] == '.' {
            if !element(s[start..i]) {
                return false
            }
            elements += 1
            start = i + 1
        }
    }
    elements >= 2
}

fn bus_name_element(s: str, unique: bool) -> bool {
    if s.len == 0 {
        return false
    }
    for i in 0..s.len {
        let c = s[i]
        let allowed = letter(c) || c == '_' || c == '-' || digit(c) && (unique || i > 0)
        if !allowed {
            return false
        }
    }
    true
}

/// Returns whether `s` is a valid object path.
///
/// A path is `/` alone, or `/` followed by elements of letters, digits and `_` separated by single `/` with no trailing `/`.
pub fn valid_object_path(s: str) -> bool {
    if s == "/" {
        return true
    }
    if s.len < 2 || s[0] != '/' {
        return false
    }
    var previous_slash = true
    for i in 0..s.len {
        let c = s[i]
        if c == '/' {
            if previous_slash && i > 0 {
                return false
            }
            previous_slash = true
        } else if letter(c) || digit(c) || c == '_' {
            previous_slash = false
        } else {
            return false
        }
    }
    !previous_slash
}

/// Returns whether `s` is a valid interface name.
///
/// An interface name has at least two elements separated by `.`, each of letters, digits and `_` that does not start with a digit, and is at most 255 bytes.
pub fn valid_interface(s: str) -> bool {
    dotted_elements(s, identifier)
}

/// Returns whether `s` is a valid member name, a method or signal name.
///
/// A member name is one element of letters, digits and `_` that does not start with a digit, and is at most 255 bytes.
pub fn valid_member(s: str) -> bool {
    s.len <= max_name_length && identifier(s)
}

/// Returns whether `s` is a valid error name, which follows the rules of an interface name.
pub fn valid_error_name(s: str) -> bool {
    valid_interface(s)
}

/// Returns whether `s` is a valid bus name, a well-known name such as `org.example.Service` or a unique name such as `:1.42`.
///
/// A well-known name has at least two elements separated by `.`, each of letters, digits, `_` and `-` that does not start with a digit. A unique name starts with `:`, has at least two elements and may start its elements with digits. Both are at most 255 bytes.
pub fn valid_bus_name(s: str) -> bool {
    if s.len > 0 && s[0] == ':' {
        return dotted_elements(s[1..], fn(element) bus_name_element(element, true))
    }
    dotted_elements(s, fn(element) bus_name_element(element, false))
}
