import std/dbus
import std/net

const guid = "0123456789abcdef0123456789abcdef"

fn greet(c: dbus.Call) -> dbus.Value[] ! dbus.Error {
    let name = dbus.string_of(c.message.body[0])?
    [dbus.Value.String("hello, {name}")]
}

fn serve_peer(h: net.ConnHandle, done: chan[bool]) {
    using peer = dbus.accept_over(h, dbus.ServerAuth { guid }) or panic("accept")
    let service = dbus.serve(peer)
    let spec = dbus.InterfaceSpec {
        name: "org.example.Greeter",
        methods: [dbus.MethodSpec { name: "Greet", in_signature: "s", out_signature: "s", in_names: ["name"], out_names: ["greeting"], handler: greet }],
        properties: [dbus.read_only_property("Language", "s", fn() -> dbus.Value ! dbus.Error { dbus.Value.String("en") })],
    }
    dbus.export(service, "/org/example/Greeter", spec) or panic("export")
    dbus.begin(peer)
    <-dbus.ended(peer)
    done <- true
}

/// Connects two D-Bus peers over a socket pair, calls a method and reads a property on the exported object, and lists its introspected interfaces.
fn main() ! dbus.Error {
    using var pair = net.socketpair() or panic("pair")
    let client_side = net.detach(mut pair.first)
    let server_side = net.detach(mut pair.second)
    let done = chan[bool](1)
    spawn serve_peer(server_side, done)

    using client = dbus.connect_over(client_side, false)?
    let reply = dbus.call(client, dbus.method_call("", "/org/example/Greeter", "org.example.Greeter", "Greet", [dbus.Value.String("low")]))?
    print("reply {reply.body}")
    let language = dbus.get_property(client, "", "/org/example/Greeter", "org.example.Greeter", "Language")?
    print("language {language}")
    let node = dbus.introspect(client, "", "/org/example/Greeter")?
    for i in node.interfaces {
        print("interface {i.name}")
    }
    dbus.shutdown(client)
    <-done
    print("peer ended")
}
