import std/os
import std/text

const hex_digits = "0123456789abcdef"

/// One entry of a D-Bus address list: a transport and its `key=value` pairs.
///
/// `unix:path=/run/user/1000/bus,guid=1234` has the transport `unix` and the keys `path` and `guid`. The values are unescaped.
pub struct Address {
    /// The transport name, such as `unix`.
    pub transport: str
    /// The keys and values in the order they were written. A key given twice keeps its first value.
    pub keys: [str: str]
}

fn plain(b: u8) -> bool {
    (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '-' || b == '_' || b == '/' || b == '.' || b == '\\' || b == '*'
}

fn hex_value(b: u8) -> i64 {
    if b >= '0' && b <= '9' {
        return i64(b) - i64('0')
    }
    if b >= 'a' && b <= 'f' {
        return i64(b) - i64('a') + 10
    }
    if b >= 'A' && b <= 'F' {
        return i64(b) - i64('A') + 10
    }
    -1
}

/// Returns `s` escaped for use as a value in an address.
///
/// Every byte other than a letter, a digit and `-_/.\*` becomes `%` and two lowercase hexadecimal digits.
pub fn escape_address_value(s: str) -> str {
    var out: u8[] = []
    for i in 0..s.len {
        let b = s[i]
        if plain(b) {
            out.push(b)
        } else {
            out.push('%')
            out.push(hex_digits[i64(b) >> 4])
            out.push(hex_digits[i64(b) & 15])
        }
    }
    str(out)
}

/// Returns the bytes `s` stands for once its `%` escapes are decoded.
///
/// Fails with `Address` when a `%` is not followed by two hexadecimal digits.
pub fn unescape_address_value(s: str) -> str ! Error {
    var out: u8[] = []
    var i = 0
    for i < s.len {
        let b = s[i]
        if b != '%' {
            out.push(b)
            i += 1
            continue
        }
        if i + 2 >= s.len {
            fail Address("truncated escape in {s}")
        }
        let high = hex_value(s[i + 1])
        let low = hex_value(s[i + 2])
        if high < 0 || low < 0 {
            fail Address("invalid escape in {s}")
        }
        out.push(u8(high * 16 + low))
        i += 3
    }
    str(out)
}

fn parse_address_entry(entry: str) -> Address ! Error {
    let colon = text.index_byte(entry, ':')
    if colon <= 0 {
        fail Address("{entry} has no transport name")
    }
    var keys: [str: str] = [:]
    let rest = entry[colon + 1..]
    if rest.len > 0 {
        for pair in text.split(rest, ',') {
            if pair.len == 0 {
                continue
            }
            let equals = text.index_byte(pair, '=')
            if equals <= 0 || equals == pair.len - 1 {
                fail Address("{pair} is not a key=value pair")
            }
            let key = pair[..equals]
            if keys[key] == none {
                keys[key] = unescape_address_value(pair[equals + 1..])?
            }
        }
    }
    Address { transport: entry[..colon], keys }
}

/// Parses the address list `s` into its entries, in order.
///
/// Entries are separated by `;` and pairs by `,`, and an empty entry or pair is skipped. Fails with `Address` when no entry is left, an entry has no transport, a pair is not `key=value` with a non-empty value or an escape is invalid.
pub fn parse_addresses(s: str) -> Address[] ! Error {
    var out: Address[] = []
    for entry in text.split(s, ';') {
        if entry.len > 0 {
            out.push(parse_address_entry(entry)?)
        }
    }
    if out.len == 0 {
        fail Address("the address list is empty")
    }
    out
}

/// Returns the text of `a`, which `parse_addresses` reads back.
pub fn address_text(a: Address) -> str {
    var pairs: str[] = []
    for key, value in a.keys {
        pairs.push("{key}={escape_address_value(value)}")
    }
    "{a.transport}:{text.join(pairs, ",")}"
}

/// Returns the guid key of `a`, or an empty string when it has none.
pub fn address_guid(a: Address) -> str {
    a.keys["guid"] ?? ""
}

/// Returns the path to connect to for the `unix` address `a`: the `path` key, an abstract name as `@` and the `abstract` key, or `bus` inside `$XDG_RUNTIME_DIR` for `runtime=yes`.
///
/// The result is what `net.connect_unix` takes. Fails with `Address` for another transport, for an address that gives none or more than one of `path`, `abstract` and `runtime`, and for `runtime=yes` without `XDG_RUNTIME_DIR`.
pub fn socket_path(a: Address) -> str ! Error {
    if a.transport != "unix" {
        fail Address("the transport {a.transport} is not supported")
    }
    let path = a.keys["path"] ?? ""
    let abstract_name = a.keys["abstract"] ?? ""
    let runtime = a.keys["runtime"] ?? ""
    var given = 0
    if path.len > 0 {
        given += 1
    }
    if abstract_name.len > 0 {
        given += 1
    }
    if runtime.len > 0 {
        given += 1
    }
    if given != 1 {
        fail Address("a unix address needs exactly one of path, abstract and runtime")
    }
    if path.len > 0 {
        return path
    }
    if abstract_name.len > 0 {
        return "@{abstract_name}"
    }
    if runtime != "yes" {
        fail Address("runtime must be yes")
    }
    let dir = os.env("XDG_RUNTIME_DIR") ?? ""
    if dir.len == 0 {
        fail Address("runtime=yes needs XDG_RUNTIME_DIR")
    }
    "{dir}/bus"
}

fn variable(name: str) -> str {
    os.env(name) ?? ""
}

/// Returns the addresses of the session bus.
///
/// Reads `DBUS_SESSION_BUS_ADDRESS`; when it is unset or empty, the address is `unix:path=` followed by `bus` inside `XDG_RUNTIME_DIR`. Fails with `Address` when neither is set or the variable does not parse.
pub fn session_addresses() -> Address[] ! Error {
    let given = variable("DBUS_SESSION_BUS_ADDRESS")
    if given.len > 0 {
        return parse_addresses(given)
    }
    let dir = variable("XDG_RUNTIME_DIR")
    if dir.len == 0 {
        fail Address("neither DBUS_SESSION_BUS_ADDRESS nor XDG_RUNTIME_DIR is set")
    }
    let path = escape_address_value("{dir}/bus")
    parse_addresses("unix:path={path}")
}

/// Returns the addresses of the system bus.
///
/// Reads `DBUS_SYSTEM_BUS_ADDRESS`; when it is unset or empty, the address is `unix:path=/run/dbus/system_bus_socket`. Fails with `Address` when the variable does not parse.
pub fn system_addresses() -> Address[] ! Error {
    let given = variable("DBUS_SYSTEM_BUS_ADDRESS")
    if given.len > 0 {
        return parse_addresses(given)
    }
    parse_addresses("unix:path=/run/dbus/system_bus_socket")
}
