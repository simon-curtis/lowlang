import std/io

/// The error type of the D-Bus module.
pub enum Error {
    /// A system call on the connection failed. `cause` is the I/O error.
    Io(cause: io.Error)
    /// A bus address could not be parsed or names no transport this module supports. `reason` says why.
    Address(reason: str)
    /// The authentication handshake failed. `reason` says why.
    Auth(reason: str)
    /// A type signature is invalid or exceeds a limit of the specification. `reason` says why.
    Signature(reason: str)
    /// A bus name, interface name, member name, error name or object path is invalid. `reason` says why.
    Name(reason: str)
    /// A value cannot be marshalled or does not have the type the caller asked for. `reason` says why.
    Marshal(reason: str)
    /// Bytes received are not a valid message. `reason` says why.
    Malformed(reason: str)
    /// The peer replied to a method call with an error. `name` is the error name and `message` its text, which is empty when the reply carried none.
    Remote(name: str, message: str)
    /// A method call got no reply in time.
    Timeout
    /// A method call was stopped by its cancellation token.
    Cancelled
    /// The connection is closed.
    Closed
    /// A message or array exceeds the limit of the specification.
    TooLarge
}
