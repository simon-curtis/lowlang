import std/text

const max_signature_length = 255
const max_array_depth = 32
const max_struct_depth = 32
const max_container_depth = 64

/// A D-Bus type: one complete type of a signature.
pub enum Type {
    /// BYTE, `y`: an unsigned 8-bit integer.
    Byte
    /// BOOLEAN, `b`: `0` or `1` in 4 bytes.
    Boolean
    /// INT16, `n`: a signed 16-bit integer.
    Int16
    /// UINT16, `q`: an unsigned 16-bit integer.
    UInt16
    /// INT32, `i`: a signed 32-bit integer.
    Int32
    /// UINT32, `u`: an unsigned 32-bit integer.
    UInt32
    /// INT64, `x`: a signed 64-bit integer.
    Int64
    /// UINT64, `t`: an unsigned 64-bit integer.
    UInt64
    /// DOUBLE, `d`: an IEEE 754 binary64 float.
    Double
    /// STRING, `s`: UTF-8 text with no NUL.
    String
    /// OBJECT_PATH, `o`: a string that is a valid object path.
    ObjectPath
    /// SIGNATURE, `g`: a string that is a valid signature, with a one-byte length.
    Signature
    /// UNIX_FD, `h`: an index into the file descriptors that travel with the message.
    UnixFd
    /// VARIANT, `v`: a value preceded by its own signature.
    Variant
    /// ARRAY, `a` followed by the element type.
    Array(element: *Type)
    /// STRUCT, `(` and `)` around one or more field types.
    Struct(fields: []Type)
    /// DICT_ENTRY, `{` and `}` around a basic key type and a value type. Only an array element can be one.
    DictEntry(key: *Type, value: *Type)
}

struct Parser {
    text: str
    at: i64
}

fn invalid(reason: str, text: str, at: i64) -> Error {
    Signature("{reason} at {at} in {text}")
}

fn basic_type(c: u8) -> Type? {
    match c {
        'y' => Type.Byte
        'b' => Type.Boolean
        'n' => Type.Int16
        'q' => Type.UInt16
        'i' => Type.Int32
        'u' => Type.UInt32
        'x' => Type.Int64
        't' => Type.UInt64
        'd' => Type.Double
        's' => Type.String
        'o' => Type.ObjectPath
        'g' => Type.Signature
        'h' => Type.UnixFd
        _ => none
    }
}

fn is_basic(t: Type) -> bool {
    match t {
        Variant => false
        Array(_) => false
        Struct(_) => false
        DictEntry(_, _) => false
        _ => true
    }
}

fn parse_one(p: *Parser, arrays: i64, structs: i64) -> Type ! Error {
    if p.at >= p.text.len {
        fail invalid("incomplete type", p.text, p.at)
    }
    let start = p.at
    let c = p.text[start]
    p.at += 1
    match basic_type(c) {
        some(t) => return t
        none => {}
    }
    match c {
        'v' => Type.Variant
        'a' => {
            if arrays >= max_array_depth || arrays + structs >= max_container_depth {
                fail invalid("arrays nested too deeply", p.text, start)
            }
            if p.at < p.text.len && p.text[p.at] == '{' {
                Type.Array(new(parse_entry(p, arrays + 1, structs)?))
            } else {
                Type.Array(new(parse_one(p, arrays + 1, structs)?))
            }
        }
        '(' => parse_struct(p, arrays, structs)?
        _ => fail invalid("unknown type code {text.from_char(u32(c))}", p.text, start)
    }
}

fn parse_struct(p: *Parser, arrays: i64, structs: i64) -> Type ! Error {
    let start = p.at - 1
    if structs >= max_struct_depth || arrays + structs >= max_container_depth {
        fail invalid("structs nested too deeply", p.text, start)
    }
    var fields: []Type = []
    for {
        if p.at >= p.text.len {
            fail invalid("unterminated struct", p.text, start)
        }
        if p.text[p.at] == ')' {
            p.at += 1
            break
        }
        push(mut fields, parse_one(p, arrays, structs + 1)?)
    }
    if fields.len == 0 {
        fail invalid("empty struct", p.text, start)
    }
    Type.Struct(fields)
}

fn parse_entry(p: *Parser, arrays: i64, structs: i64) -> Type ! Error {
    let start = p.at
    p.at += 1
    if structs >= max_struct_depth || arrays + structs >= max_container_depth {
        fail invalid("structs nested too deeply", p.text, start)
    }
    let key = parse_one(p, arrays, structs + 1)?
    if !is_basic(key) {
        fail invalid("dict entry key is not a basic type", p.text, start)
    }
    let value = parse_one(p, arrays, structs + 1)?
    if p.at >= p.text.len || p.text[p.at] != '}' {
        fail invalid("dict entry does not hold exactly a key and a value", p.text, start)
    }
    p.at += 1
    Type.DictEntry(new(key), new(value))
}

/// Parses `s` as a signature and returns its complete types in order.
///
/// An empty signature gives an empty slice. Fails with `Signature` when `s` is longer than 255 bytes, holds an unknown type code, an incomplete or empty container, a dict entry that is not an array element or has a non-basic key or other than two types, or nests arrays more than 32 deep, structs and dict entries more than 32 deep, or containers more than 64 deep in all.
pub fn parse_signature(s: str) -> []Type ! Error {
    if s.len > max_signature_length {
        fail Signature("signature is {s.len} bytes, the limit is {max_signature_length}")
    }
    let p = new(Parser { text: s, at: 0 })
    var types: []Type = []
    for p.at < s.len {
        push(mut types, parse_one(p, 0, 0)?)
    }
    types
}

/// Parses `s` as exactly one complete type.
///
/// Fails with `Signature` for an empty signature, for more than one type and for everything `parse_signature` rejects.
pub fn parse_type(s: str) -> Type ! Error {
    let types = parse_signature(s)?
    if types.len != 1 {
        fail Signature("expected one complete type in {s}")
    }
    types[0]
}

/// Parses `s` as the element type of an array: exactly one complete type, or one dict entry in braces such as `{sv}`.
///
/// Fails with `Signature` as `parse_type` does.
pub fn parse_element(s: str) -> Type ! Error {
    let array = parse_type("a{s}") catch {
        _ => fail Signature("{s} is not one complete array element type")
    }
    match array {
        Array(element) => *element
        _ => fail Signature("{s} is not one complete array element type")
    }
}

fn type_code(t: Type) -> u8 {
    match t {
        Byte => 'y'
        Boolean => 'b'
        Int16 => 'n'
        UInt16 => 'q'
        Int32 => 'i'
        UInt32 => 'u'
        Int64 => 'x'
        UInt64 => 't'
        Double => 'd'
        String => 's'
        ObjectPath => 'o'
        Signature => 'g'
        UnixFd => 'h'
        Variant => 'v'
        Array(_) => 'a'
        Struct(_) => '('
        DictEntry(_, _) => '{'
    }
}

fn append_type(mut out: []u8, t: Type) {
    push(mut out, type_code(t))
    match t {
        Array(element) => append_type(mut out, *element)
        Struct(fields) => {
            for f in fields {
                append_type(mut out, f)
            }
            push(mut out, ')')
        }
        DictEntry(key, value) => {
            append_type(mut out, *key)
            append_type(mut out, *value)
            push(mut out, '}')
        }
        _ => {}
    }
}

/// Returns the signature text of the types `types`, which `parse_signature` reads back.
pub fn signature_text(types: []Type) -> str {
    var out: []u8 = []
    for t in types {
        append_type(mut out, t)
    }
    str(out)
}

/// Returns the signature text of the single type `t`.
pub fn type_signature(t: Type) -> str {
    signature_text([t])
}

fn alignment(t: Type) -> i64 {
    match t {
        Byte => 1
        Boolean => 4
        Int16 => 2
        UInt16 => 2
        Int32 => 4
        UInt32 => 4
        Int64 => 8
        UInt64 => 8
        Double => 8
        String => 4
        ObjectPath => 4
        Signature => 1
        UnixFd => 4
        Variant => 1
        Array(_) => 4
        Struct(_) => 8
        DictEntry(_, _) => 8
    }
}
