/// A D-Bus value of any type.
///
/// Every variant is one type of the specification. A value knows its own signature except for an empty array, which carries its element type as signature text.
pub enum Value {
    /// BYTE.
    Byte(value: u8)
    /// BOOLEAN.
    Boolean(value: bool)
    /// INT16. Low has no 16-bit signed integer, so the value is an `i64` that must lie in `-32768` to `32767` to be marshalled.
    Int16(value: i64)
    /// UINT16.
    UInt16(value: u16)
    /// INT32.
    Int32(value: i32)
    /// UINT32.
    UInt32(value: u32)
    /// INT64.
    Int64(value: i64)
    /// UINT64.
    UInt64(value: u64)
    /// DOUBLE.
    Double(value: f64)
    /// STRING. Marshalling fails when it holds a NUL byte or is not valid UTF-8.
    String(value: str)
    /// OBJECT_PATH. Marshalling fails when it is not a valid object path.
    ObjectPath(value: str)
    /// SIGNATURE. Marshalling fails when it is not a valid signature.
    Signature(value: str)
    /// UNIX_FD. The value is the file descriptor number: marshalling appends it to the descriptors of the message, once however often it appears, and writes its index, and decoding replaces the index with the descriptor that arrived.
    UnixFd(fd: i64)
    /// An ARRAY of BYTE, `ay`, held as bytes. Decoding always produces it for `ay`, and marshalling accepts it and `Array("y", ...)` alike.
    Bytes(data: u8[])
    /// An ARRAY other than `ay`. `element` is the signature of one element, which every item must have, and which gives the type of an empty array.
    Array(element: str, items: Value[])
    /// A STRUCT.
    Struct(fields: Value[])
    /// A VARIANT holding `inner`.
    Variant(inner: *Value)
    /// A DICT_ENTRY. Only an `Array` item can be one.
    DictEntry(key: *Value, value: *Value)
}

/// Returns a variant that holds `v`.
pub fn variant(v: Value) -> Value {
    Value.Variant(new(v))
}

/// Returns an `as` array of the strings `items`.
pub fn strings(items: str[]) -> Value {
    var values: Value[] = []
    for item in items {
        values.push(Value.String(item))
    }
    Value.Array("s", values)
}

/// Returns an `a{sv}` array of the entries of `entries`, in insertion order, with each value wrapped in a variant unless it already is one.
pub fn dict(entries: [str: Value]) -> Value {
    var items: Value[] = []
    for name, v in entries {
        let wrapped = match v {
            Variant(_) => v
            _ => variant(v)
        }
        items.push(Value.DictEntry(new(Value.String(name)), new(wrapped)))
    }
    Value.Array("{{sv}}", items)
}

fn type_of(v: Value) -> Type ! Error {
    match v {
        Byte(_) => Type.Byte
        Boolean(_) => Type.Boolean
        Int16(_) => Type.Int16
        UInt16(_) => Type.UInt16
        Int32(_) => Type.Int32
        UInt32(_) => Type.UInt32
        Int64(_) => Type.Int64
        UInt64(_) => Type.UInt64
        Double(_) => Type.Double
        String(_) => Type.String
        ObjectPath(_) => Type.ObjectPath
        Signature(_) => Type.Signature
        UnixFd(_) => Type.UnixFd
        Bytes(_) => Type.Array(new(Type.Byte))
        Array(element, _) => Type.Array(new(parse_element(element)?))
        Struct(fields) => {
            if fields.len == 0 {
                fail Marshal("a struct needs at least one field")
            }
            var types: Type[] = []
            for f in fields {
                types.push(type_of(f)?)
            }
            Type.Struct(types)
        }
        Variant(_) => Type.Variant
        DictEntry(key, value) => Type.DictEntry(new(type_of(*key)?), new(type_of(*value)?))
    }
}

/// Returns the signature of `v`.
///
/// Fails with `Signature` when an array's `element` is not one complete type, and with `Marshal` for an empty struct.
pub fn signature_of(v: Value) -> str ! Error {
    type_signature(type_of(v)?)
}

/// Returns the signature of the values `values` in order, as a message with that body carries.
///
/// Fails as `signature_of` does.
pub fn values_signature(values: Value[]) -> str ! Error {
    var types: Type[] = []
    for v in values {
        types.push(type_of(v)?)
    }
    signature_text(types)
}

fn value_code(v: Value) -> u8 {
    match v {
        Byte(_) => 'y'
        Boolean(_) => 'b'
        Int16(_) => 'n'
        UInt16(_) => 'q'
        Int32(_) => 'i'
        UInt32(_) => 'u'
        Int64(_) => 'x'
        UInt64(_) => 't'
        Double(_) => 'd'
        String(_) => 's'
        ObjectPath(_) => 'o'
        Signature(_) => 'g'
        UnixFd(_) => 'h'
        Bytes(_) => 'a'
        Array(_, _) => 'a'
        Struct(_) => '('
        Variant(_) => 'v'
        DictEntry(_, _) => '{'
    }
}

fn kind(v: Value) -> str {
    match v {
        Byte(_) => "BYTE"
        Boolean(_) => "BOOLEAN"
        Int16(_) => "INT16"
        UInt16(_) => "UINT16"
        Int32(_) => "INT32"
        UInt32(_) => "UINT32"
        Int64(_) => "INT64"
        UInt64(_) => "UINT64"
        Double(_) => "DOUBLE"
        String(_) => "STRING"
        ObjectPath(_) => "OBJECT_PATH"
        Signature(_) => "SIGNATURE"
        UnixFd(_) => "UNIX_FD"
        Bytes(_) => "ARRAY of BYTE"
        Array(_, _) => "ARRAY"
        Struct(_) => "STRUCT"
        Variant(_) => "VARIANT"
        DictEntry(_, _) => "DICT_ENTRY"
    }
}

fn mismatch(want: str, v: Value) -> Error {
    Marshal("expected {want}, found {kind(v)}")
}

/// Returns the boolean in `v`.
///
/// Fails with `Marshal` unless `v` is a `Boolean`.
pub fn bool_of(v: Value) -> bool ! Error {
    match v {
        Boolean(b) => b
        _ => fail mismatch("BOOLEAN", v)
    }
}

/// Returns the integer in `v` as an `i64`.
///
/// Accepts every integer variant. Fails with `Marshal` for another variant and for a `UInt64` above the `i64` range.
pub fn int_of(v: Value) -> i64 ! Error {
    match v {
        Byte(b) => i64(b)
        Int16(n) => n
        UInt16(n) => i64(n)
        Int32(n) => i64(n)
        UInt32(n) => i64(n)
        Int64(n) => n
        UInt64(n) => {
            if n > 0x7FFFFFFFFFFFFFFF {
                fail Marshal("UINT64 {n} does not fit an i64")
            }
            i64(n)
        }
        _ => fail mismatch("an integer", v)
    }
}

/// Returns the integer in `v` as a `u64`.
///
/// Accepts every integer variant. Fails with `Marshal` for another variant and for a negative value.
pub fn uint_of(v: Value) -> u64 ! Error {
    match v {
        UInt64(n) => n
        _ => {
            let n = int_of(v)?
            if n < 0 {
                fail Marshal("{n} is negative")
            }
            u64(n)
        }
    }
}

/// Returns the float in `v`.
///
/// Fails with `Marshal` unless `v` is a `Double`.
pub fn double_of(v: Value) -> f64 ! Error {
    match v {
        Double(d) => d
        _ => fail mismatch("DOUBLE", v)
    }
}

/// Returns the text of a `String`, `ObjectPath` or `Signature`.
///
/// Fails with `Marshal` for another variant.
pub fn string_of(v: Value) -> str ! Error {
    match v {
        String(s) => s
        ObjectPath(s) => s
        Signature(s) => s
        _ => fail mismatch("STRING", v)
    }
}

/// Returns the file descriptor number of a `UnixFd`.
///
/// Fails with `Marshal` for another variant.
pub fn fd_of(v: Value) -> i64 ! Error {
    match v {
        UnixFd(fd) => fd
        _ => fail mismatch("UNIX_FD", v)
    }
}

/// Returns the bytes of a `Bytes` or of an `Array` of `Byte` values.
///
/// Fails with `Marshal` for another variant or an array of another type.
pub fn bytes_of(v: Value) -> u8[] ! Error {
    match v {
        Bytes(data) => data
        Array(_, items) => {
            var out: u8[] = []
            for item in items {
                match item {
                    Byte(b) => out.push(b)
                    _ => fail mismatch("ARRAY of BYTE", v)
                }
            }
            out
        }
        _ => fail mismatch("ARRAY of BYTE", v)
    }
}

/// Returns the items of an array.
///
/// A `Bytes` value gives its bytes as `Byte` values. Fails with `Marshal` for another variant.
pub fn array_of(v: Value) -> Value[] ! Error {
    match v {
        Array(_, items) => items
        Bytes(data) => {
            var items: Value[] = []
            for b in data {
                items.push(Value.Byte(b))
            }
            items
        }
        _ => fail mismatch("ARRAY", v)
    }
}

/// Returns the fields of a `Struct`.
///
/// Fails with `Marshal` for another variant.
pub fn fields_of(v: Value) -> Value[] ! Error {
    match v {
        Struct(fields) => fields
        _ => fail mismatch("STRUCT", v)
    }
}

/// Returns the value inside a `Variant`.
///
/// Fails with `Marshal` for another variant.
pub fn unwrap(v: Value) -> Value ! Error {
    match v {
        Variant(inner) => *inner
        _ => fail mismatch("VARIANT", v)
    }
}

/// Returns the entries of an array of dict entries with string keys, in order, with variant values unwrapped.
///
/// Fails with `Marshal` for another variant, an item that is not a dict entry or a key that is not a string. A repeated key keeps its last value.
pub fn dict_of(v: Value) -> [str: Value] ! Error {
    var out: [str: Value] = [:]
    for item in array_of(v)? {
        match item {
            DictEntry(key, value) => {
                let name = string_of(*key)?
                out[name] = match *value {
                    Variant(inner) => *inner
                    other => other
                }
            }
            _ => fail mismatch("DICT_ENTRY", item)
        }
    }
    out
}
