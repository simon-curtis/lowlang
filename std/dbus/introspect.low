import std/xml

const introspect_doctype = "<!DOCTYPE node PUBLIC \"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN\"\n \"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd\">\n"

/// An argument of a method or signal in an introspection document.
pub struct ArgumentInfo {
    /// The argument name, empty when the document gives none.
    pub name: str
    /// The signature of the argument, one complete type.
    pub signature: str
    /// `in` or `out`. Signal arguments are `out`.
    pub direction: str
}

/// A method in an introspection document.
pub struct MethodInfo {
    /// The method name.
    pub name: str
    /// The arguments, in order.
    pub arguments: []ArgumentInfo
}

/// A signal in an introspection document.
pub struct SignalInfo {
    /// The signal name.
    pub name: str
    /// The arguments, in order.
    pub arguments: []ArgumentInfo
}

/// A property in an introspection document.
pub struct PropertyInfo {
    /// The property name.
    pub name: str
    /// The signature of the property, one complete type.
    pub signature: str
    /// `read`, `write` or `readwrite`.
    pub access: str
}

/// An interface in an introspection document.
pub struct InterfaceInfo {
    /// The interface name.
    pub name: str
    /// The methods of the interface.
    pub methods: []MethodInfo
    /// The signals of the interface.
    pub signals: []SignalInfo
    /// The properties of the interface.
    pub properties: []PropertyInfo
}

/// An object described by an introspection document.
pub struct NodeInfo {
    /// The name of the node, empty for the root of a document.
    pub name: str
    /// The interfaces the object implements.
    pub interfaces: []InterfaceInfo
    /// The names of the child nodes, relative to the object path.
    pub nodes: []str
}

fn xml_failure(e: xml.Error) -> Error {
    match e {
        Malformed(line, column, message) => Error.Malformed("introspection XML at {line}:{column}: {message}")
        Limit(line, column, message) => Error.Malformed("introspection XML at {line}:{column}: {message}")
        Unsupported(message) => Error.Malformed("introspection XML: {message}")
    }
}

fn required(e: *xml.Element, attribute: str) -> str ! Error {
    match xml.attribute(e, attribute) {
        some(value) => value
        none => fail Malformed("an introspection {e.name.local} has no {attribute}")
    }
}

fn arguments_of(e: *xml.Element, default_direction: str) -> []ArgumentInfo ! Error {
    var out: []ArgumentInfo = []
    for a in xml.children(e, "arg") {
        let signature = required(a, "type")?
        parse_type(signature)?
        let direction = xml.attribute(a, "direction") ?? default_direction
        if direction != "in" && direction != "out" {
            fail Malformed("an argument direction is in or out, not {direction}")
        }
        push(mut out, ArgumentInfo { name: xml.attribute(a, "name") ?? "", signature, direction })
    }
    out
}

fn interface_of(e: *xml.Element) -> InterfaceInfo ! Error {
    var methods: []MethodInfo = []
    for m in xml.children(e, "method") {
        push(mut methods, MethodInfo { name: required(m, "name")?, arguments: arguments_of(m, "in")? })
    }
    var signals: []SignalInfo = []
    for s in xml.children(e, "signal") {
        push(mut signals, SignalInfo { name: required(s, "name")?, arguments: arguments_of(s, "out")? })
    }
    var properties: []PropertyInfo = []
    for p in xml.children(e, "property") {
        let signature = required(p, "type")?
        parse_type(signature)?
        let access = required(p, "access")?
        if access != "read" && access != "write" && access != "readwrite" {
            fail Malformed("a property access is read, write or readwrite, not {access}")
        }
        push(mut properties, PropertyInfo { name: required(p, "name")?, signature, access })
    }
    InterfaceInfo { name: required(e, "name")?, methods, signals, properties }
}

/// Parses the introspection document `document` into the node it describes.
///
/// Reads the XML with `std/xml`, so the document type declaration is accepted and not fetched. Fails with `Malformed` when the XML is not well formed, the root is not `node`, a name or type attribute is missing, a signature is not one complete type or a direction or access value is unknown.
pub fn parse_introspection(document: str) -> NodeInfo ! Error {
    let root = xml.parse(bytes(document)) catch {
        e => fail xml_failure(e)
    }
    if root.name.local != "node" {
        fail Malformed("an introspection document starts with node, not {root.name.local}")
    }
    var interfaces: []InterfaceInfo = []
    for i in xml.children(root, "interface") {
        push(mut interfaces, interface_of(i)?)
    }
    var nodes: []str = []
    for n in xml.children(root, "node") {
        push(mut nodes, required(n, "name")?)
    }
    NodeInfo { name: xml.attribute(root, "name") ?? "", interfaces, nodes }
}

fn write_arguments(w: *xml.Writer, arguments: []ArgumentInfo, with_direction: bool) {
    for a in arguments {
        xml.start_element(w, "arg")
        if a.name.len > 0 {
            xml.write_attribute(w, "name", a.name)
        }
        xml.write_attribute(w, "type", a.signature)
        if with_direction {
            xml.write_attribute(w, "direction", a.direction)
        }
        xml.end_element(w)
    }
}

/// Returns the introspection document for `node`, with the document type declaration the specification asks for.
///
/// `parse_introspection` reads the result back.
pub fn introspection_xml(node: NodeInfo) -> str {
    let w = xml.writer(true)
    xml.start_element(w, "node")
    if node.name.len > 0 {
        xml.write_attribute(w, "name", node.name)
    }
    for i in node.interfaces {
        xml.start_element(w, "interface")
        xml.write_attribute(w, "name", i.name)
        for m in i.methods {
            xml.start_element(w, "method")
            xml.write_attribute(w, "name", m.name)
            write_arguments(w, m.arguments, true)
            xml.end_element(w)
        }
        for s in i.signals {
            xml.start_element(w, "signal")
            xml.write_attribute(w, "name", s.name)
            write_arguments(w, s.arguments, false)
            xml.end_element(w)
        }
        for p in i.properties {
            xml.start_element(w, "property")
            xml.write_attribute(w, "name", p.name)
            xml.write_attribute(w, "type", p.signature)
            xml.write_attribute(w, "access", p.access)
            xml.end_element(w)
        }
        xml.end_element(w)
    }
    for n in node.nodes {
        xml.start_element(w, "node")
        xml.write_attribute(w, "name", n)
        xml.end_element(w)
    }
    xml.end_element(w)
    "{introspect_doctype}{xml.finish(w)}"
}

/// Returns the introspection XML of the object `path` of `destination`.
///
/// Fails with `Remote` when the peer reports an error, with `Malformed` when the reply is not one string, and with the errors of `call_on` otherwise.
pub fn introspect_xml_on(h: *ConnectionHandle, destination: str, path: str) -> str ! Error {
    let reply = call_on(h, method_call(destination, path, introspectable_interface, "Introspect", []))?
    if reply.body.len != 1 {
        fail Malformed("Introspect returned {reply.body.len} values")
    }
    string_of(reply.body[0])?
}

/// Returns the introspection XML of a remote object.
///
/// Does the same as `introspect_xml_on` on the handle of `c`.
pub fn introspect_xml(c: Connection, destination: str, path: str) -> str ! Error {
    introspect_xml_on(c.handle, destination, path)
}

/// Returns the description of the object `path` of `destination`.
///
/// Calls `Introspect` and parses the reply as `parse_introspection` does.
pub fn introspect_on(h: *ConnectionHandle, destination: str, path: str) -> NodeInfo ! Error {
    parse_introspection(introspect_xml_on(h, destination, path)?)?
}

/// Returns the description of a remote object.
///
/// Does the same as `introspect_on` on the handle of `c`.
pub fn introspect(c: Connection, destination: str, path: str) -> NodeInfo ! Error {
    introspect_on(c.handle, destination, path)
}
