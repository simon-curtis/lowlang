import std/slices
import std/text

const max_args = 64

/// A match rule: the conditions a message must meet for the bus to route it to a connection.
///
/// An empty string leaves a condition out. `rule_text` writes the rule the way `AddMatch` takes it.
pub struct MatchRule {
    /// The message type: `signal`, `method_call`, `method_return` or `error`.
    pub kind: str = ""
    /// The sender, a unique or well-known bus name. The bus applies it; `rule_matches` ignores it.
    pub sender: str = ""
    /// The interface of the message.
    pub interface: str = ""
    /// The member of the message.
    pub member: str = ""
    /// The object path of the message.
    pub path: str = ""
    /// A path that the object path of the message must equal or lie below.
    pub path_namespace: str = ""
    /// The destination of the message. The bus applies it; `rule_matches` ignores it.
    pub destination: str = ""
    /// Conditions on string arguments of the body: the argument at an index must be a string equal to the text.
    pub args: [i64: str] = [:]
    /// Conditions on string or object path arguments: the argument at an index and the text must be equal, or one must end in `/` and begin the other.
    pub arg_paths: [i64: str] = [:]
    /// A name that the first argument must equal or lie below as a dotted name.
    pub arg0_namespace: str = ""
}

/// Returns the rule for the signal `member` of `interface` emitted by the object `path`, leaving out each that is empty.
pub fn signal_rule(path: str, interface: str, member: str) -> MatchRule {
    MatchRule { kind: "signal", path, interface, member }
}

/// Returns `s` quoted for a match rule value.
///
/// The text is wrapped in single quotes and each single quote inside becomes `'\''`, the way libdbus writes it.
pub fn quote_rule_value(s: str) -> str {
    "'{text.replace(s, "'", "'\\''")}'"
}

fn index_keys(values: [i64: str]) -> i64[] {
    var keys: i64[] = []
    for k, _ in values {
        keys.push(k)
    }
    slices.sort(mut keys)
    keys
}

fn add_pair(mut parts: str[], key: str, value: str) {
    if value.len > 0 {
        parts.push("{key}={quote_rule_value(value)}")
    }
}

/// Returns `r` as the text `AddMatch` and `RemoveMatch` take, with the keys in a fixed order and each value quoted.
///
/// Fails with `Name` when `kind` is not one of the four message types, an interface, member, path, namespace or bus name is invalid, or an argument index is not between `0` and `63`.
pub fn rule_text(r: MatchRule) -> str ! Error {
    if r.kind.len > 0 && r.kind != "signal" && r.kind != "method_call" && r.kind != "method_return" && r.kind != "error" {
        fail Name("invalid match rule type {text.quote(r.kind)}")
    }
    if r.sender.len > 0 && !valid_bus_name(r.sender) {
        fail Name("invalid match rule sender {text.quote(r.sender)}")
    }
    if r.destination.len > 0 && !valid_bus_name(r.destination) {
        fail Name("invalid match rule destination {text.quote(r.destination)}")
    }
    if r.interface.len > 0 && !valid_interface(r.interface) {
        fail Name("invalid match rule interface {text.quote(r.interface)}")
    }
    if r.member.len > 0 && !valid_member(r.member) {
        fail Name("invalid match rule member {text.quote(r.member)}")
    }
    if r.path.len > 0 && !valid_object_path(r.path) {
        fail Name("invalid match rule path {text.quote(r.path)}")
    }
    if r.path_namespace.len > 0 && !valid_object_path(r.path_namespace) {
        fail Name("invalid match rule path namespace {text.quote(r.path_namespace)}")
    }
    var parts: str[] = []
    add_pair(mut parts, "type", r.kind)
    add_pair(mut parts, "sender", r.sender)
    add_pair(mut parts, "interface", r.interface)
    add_pair(mut parts, "member", r.member)
    add_pair(mut parts, "path", r.path)
    add_pair(mut parts, "path_namespace", r.path_namespace)
    add_pair(mut parts, "destination", r.destination)
    for i in index_keys(r.args) {
        if i < 0 || i >= max_args {
            fail Name("match rule argument index {i} is not between 0 and 63")
        }
        parts.push("arg{i}={quote_rule_value(r.args[i] ?? "")}")
    }
    for i in index_keys(r.arg_paths) {
        if i < 0 || i >= max_args {
            fail Name("match rule argument index {i} is not between 0 and 63")
        }
        parts.push("arg{i}path={quote_rule_value(r.arg_paths[i] ?? "")}")
    }
    add_pair(mut parts, "arg0namespace", r.arg0_namespace)
    text.join(parts, ",")
}

fn kind_name(m: Message) -> str {
    match m.kind {
        MethodCall => "method_call"
        MethodReturn => "method_return"
        ErrorReply => "error"
        Signal => "signal"
    }
}

fn path_related(pattern: str, value: str) -> bool {
    if pattern == value {
        return true
    }
    if pattern.len > 0 && pattern[pattern.len - 1] == '/' && text.starts_with(value, pattern) {
        return true
    }
    value.len > 0 && value[value.len - 1] == '/' && text.starts_with(pattern, value)
}

fn within_path(namespace: str, path: str) -> bool {
    if namespace == "/" || path == namespace {
        return true
    }
    text.starts_with(path, "{namespace}/")
}

fn argument_string(m: Message, index: i64) -> str? {
    if index >= m.body.len {
        return none
    }
    match m.body[index] {
        String(s) => s
        _ => none
    }
}

fn argument_path(m: Message, index: i64) -> str? {
    if index >= m.body.len {
        return none
    }
    match m.body[index] {
        String(s) => s
        ObjectPath(s) => s
        _ => none
    }
}

/// Returns whether the message `m` meets the conditions of `r`.
///
/// Checks the type, interface, member, path, path namespace and arguments. The bus matches `sender` and `destination` against unique names, so a rule that names a well-known sender cannot be tested here and those two conditions are ignored.
pub fn rule_matches(r: MatchRule, m: Message) -> bool {
    if r.kind.len > 0 && r.kind != kind_name(m) {
        return false
    }
    if r.interface.len > 0 && r.interface != m.interface {
        return false
    }
    if r.member.len > 0 && r.member != m.member {
        return false
    }
    if r.path.len > 0 && r.path != m.path {
        return false
    }
    if r.path_namespace.len > 0 && !within_path(r.path_namespace, m.path) {
        return false
    }
    for i in index_keys(r.args) {
        let want = r.args[i] ?? ""
        let found = argument_string(m, i)
        if found != want {
            return false
        }
    }
    for i in index_keys(r.arg_paths) {
        let want = r.arg_paths[i] ?? ""
        let found = argument_path(m, i)
        match found {
            some(s) => {
                if !path_related(want, s) {
                    return false
                }
            }
            none => return false
        }
    }
    if r.arg0_namespace.len > 0 {
        match argument_string(m, 0) {
            some(s) => {
                if s != r.arg0_namespace && !text.starts_with(s, "{r.arg0_namespace}.") {
                    return false
                }
            }
            none => return false
        }
    }
    true
}
