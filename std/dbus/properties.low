const properties_interface = "org.freedesktop.DBus.Properties"
const peer_interface = "org.freedesktop.DBus.Peer"
const introspectable_interface = "org.freedesktop.DBus.Introspectable"

/// The content of a `PropertiesChanged` signal.
pub struct PropertiesChanged {
    /// The interface whose properties changed.
    pub interface: str
    /// The properties that changed with their new values, unwrapped from their variants.
    pub changed: [str: Value]
    /// The names of the properties that changed without the signal carrying their new values.
    pub invalidated: []str
}

fn property_call(destination: str, path: str, member: str, body: []Value) -> Message {
    method_call(destination, path, properties_interface, member, body)
}

/// Returns the value of the property `name` of `interface` on the object `path` of `destination`, unwrapped from its variant.
///
/// Fails with `Remote` when the peer reports an error such as `org.freedesktop.DBus.Error.UnknownProperty`, with `Malformed` when the reply is not one variant, and with the errors of `call_on` otherwise.
pub fn get_property_on(h: *ConnectionHandle, destination: str, path: str, interface: str, name: str) -> Value ! Error {
    let reply = call_on(h, property_call(destination, path, "Get", [Value.String(interface), Value.String(name)]))?
    if reply.body.len != 1 {
        fail Malformed("Get returned {reply.body.len} values")
    }
    unwrap(reply.body[0])?
}

/// Returns the value of a property of a remote object.
///
/// Does the same as `get_property_on` on the handle of `c`.
pub fn get_property(c: Connection, destination: str, path: str, interface: str, name: str) -> Value ! Error {
    get_property_on(c.handle, destination, path, interface, name)
}

/// Sets the property `name` of `interface` on the object `path` of `destination` to `v`, which is sent in a variant.
///
/// Fails with `Remote` when the peer reports an error such as `org.freedesktop.DBus.Error.PropertyReadOnly` or `InvalidArgs`, and with the errors of `call_on` otherwise.
pub fn set_property_on(h: *ConnectionHandle, destination: str, path: str, interface: str, name: str, v: Value) ! Error {
    call_on(h, property_call(destination, path, "Set", [Value.String(interface), Value.String(name), variant(v)]))?
}

/// Sets a property of a remote object.
///
/// Does the same as `set_property_on` on the handle of `c`.
pub fn set_property(c: Connection, destination: str, path: str, interface: str, name: str, v: Value) ! Error {
    set_property_on(c.handle, destination, path, interface, name, v)
}

/// Returns every property of `interface` on the object `path` of `destination`, by name in the order the peer sent them, with the values unwrapped from their variants.
///
/// Fails as `get_property_on` does.
pub fn get_all_on(h: *ConnectionHandle, destination: str, path: str, interface: str) -> [str: Value] ! Error {
    let reply = call_on(h, property_call(destination, path, "GetAll", [Value.String(interface)]))?
    if reply.body.len != 1 {
        fail Malformed("GetAll returned {reply.body.len} values")
    }
    dict_of(reply.body[0])?
}

/// Returns every property of an interface of a remote object.
///
/// Does the same as `get_all_on` on the handle of `c`.
pub fn get_all(c: Connection, destination: str, path: str, interface: str) -> [str: Value] ! Error {
    get_all_on(c.handle, destination, path, interface)
}

/// Returns the `PropertiesChanged` signal from `path` for `interface`, carrying the values `changed` and the names `invalidated`.
///
/// The values are wrapped in variants unless they already are.
pub fn properties_changed_signal(path: str, interface: str, changed: [str: Value], invalidated: []str) -> Message {
    signal(path, properties_interface, "PropertiesChanged", [Value.String(interface), dict(changed), strings(invalidated)])
}

/// Reads the body of the `PropertiesChanged` signal `m`.
///
/// Fails with `Malformed` when `m` is not that signal or its body is not `sa{sv}as`.
pub fn properties_changed(m: Message) -> PropertiesChanged ! Error {
    if m.kind != MessageType.Signal || m.interface != properties_interface || m.member != "PropertiesChanged" {
        fail Malformed("the message is not a PropertiesChanged signal")
    }
    if values_signature(m.body)? != "sa{{sv}}as" {
        fail Malformed("a PropertiesChanged body is sa{{sv}}as")
    }
    var invalidated: []str = []
    for item in array_of(m.body[2])? {
        push(mut invalidated, string_of(item)?)
    }
    PropertiesChanged { interface: string_of(m.body[0])?, changed: dict_of(m.body[1])?, invalidated }
}

/// Sends `Ping` to the peer `destination` and waits for the reply.
///
/// Fails with the errors of `call_on`.
pub fn ping_on(h: *ConnectionHandle, destination: str) ! Error {
    call_on(h, method_call(destination, "/", peer_interface, "Ping", []))?
}

/// Sends `Ping` to the peer `destination`.
///
/// Does the same as `ping_on` on the handle of `c`.
pub fn ping(c: Connection, destination: str) ! Error {
    ping_on(c.handle, destination)
}

/// Asks the peer `destination` for its machine id, 32 hexadecimal digits.
///
/// Fails with the errors of `call_on` and with `Malformed` when the reply is not one string.
pub fn machine_id_on(h: *ConnectionHandle, destination: str) -> str ! Error {
    let reply = call_on(h, method_call(destination, "/", peer_interface, "GetMachineId", []))?
    if reply.body.len != 1 {
        fail Malformed("GetMachineId returned {reply.body.len} values")
    }
    string_of(reply.body[0])?
}

/// Asks the peer `destination` for its machine id.
///
/// Does the same as `machine_id_on` on the handle of `c`.
pub fn machine_id(c: Connection, destination: str) -> str ! Error {
    machine_id_on(c.handle, destination)
}
