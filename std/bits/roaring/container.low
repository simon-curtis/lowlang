import std/bits
import std/math

enum Kind {
    Array
    Bitmap
    Run
}

enum Op {
    And
    Or
    Xor
    AndNot
}

struct Container {
    kind: Kind
    card: i64
    values: []u16
    runs: i64
    words: []u64
}

fn array_container(capacity: i64) -> *Container {
    let values: []u16 = __make(capacity)
    new(Container { kind: Array, card: 0, values, runs: 0, words: [] })
}

fn bitmap_container(words: []u64, card: i64) -> *Container {
    new(Container { kind: Bitmap, card, values: [], runs: 0, words })
}

fn run_container(values: []u16, runs: i64, card: i64) -> *Container {
    new(Container { kind: Run, card, values, runs, words: [] })
}

fn single_container(v: i64) -> *Container {
    let c = array_container(4)
    c.values[0] = u16(v)
    c.card = 1
    c
}

fn range_container(lo: i64, hi: i64) -> *Container {
    let values: []u16 = __make(2)
    values[0] = u16(lo)
    values[1] = u16(hi - lo)
    tidy(run_container(values, 1, hi - lo + 1))
}

fn clone_container(c: *Container) -> *Container {
    let values: []u16 = __make(c.values.len)
    __memmove(values, c.values)
    let words: []u64 = __make(c.words.len)
    __memmove(words, c.words)
    new(Container { kind: c.kind, card: c.card, values, runs: c.runs, words })
}

fn run_start(c: *Container, i: i64) -> i64 {
    i64(c.values[2 * i])
}

fn run_last(c: *Container, i: i64) -> i64 {
    i64(c.values[2 * i]) + i64(c.values[2 * i + 1])
}

fn is_full(c: *Container) -> bool {
    c.card == 65536
}

fn lower_bound(values: []u16, from: i64, to: i64, v: i64) -> i64 {
    var lo = from
    var hi = to
    for lo < hi {
        let mid = (lo + hi) >> 1
        if i64(values[mid]) < v {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

fn run_index(c: *Container, v: i64) -> i64 {
    var lo = 0
    var hi = c.runs
    for lo < hi {
        let mid = (lo + hi) >> 1
        if run_start(c, mid) <= v {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo - 1
}

fn bit(v: i64) -> u64 {
    u64(1) << (v & 63)
}

fn container_contains(c: *Container, v: i64) -> bool {
    match c.kind {
        Array => {
            let i = lower_bound(c.values, 0, c.card, v)
            i < c.card && i64(c.values[i]) == v
        }
        Bitmap => (c.words[v >> 6] & bit(v)) != 0
        Run => {
            let i = run_index(c, v)
            i >= 0 && v <= run_last(c, i)
        }
    }
}

fn reserve_values(c: *Container, n: i64) {
    if n <= c.values.len {
        return
    }
    var size = if c.values.len * 2 < n { n } else { c.values.len * 2 }
    if c.kind == Array && size > 4096 {
        size = 4096
    }
    let grown: []u16 = __make(size)
    __memmove(grown, c.values)
    c.values = grown
}

fn open_gap(c: *Container, at: i64, used: i64, width: i64) {
    reserve_values(c, used + width)
    __memmove(c.values[at + width..used + width], c.values[at..used])
}

fn close_gap(c: *Container, at: i64, used: i64, width: i64) {
    __memmove(c.values[at..used - width], c.values[at + width..used])
}

fn container_add(c: *Container, v: i64) -> bool {
    match c.kind {
        Array => array_add(c, v)
        Bitmap => bitmap_add(c, v)
        Run => run_add(c, v)
    }
}

fn container_remove(c: *Container, v: i64) -> bool {
    match c.kind {
        Array => array_remove(c, v)
        Bitmap => bitmap_remove(c, v)
        Run => run_remove(c, v)
    }
}

fn array_add(c: *Container, v: i64) -> bool {
    let i = lower_bound(c.values, 0, c.card, v)
    if i < c.card && i64(c.values[i]) == v {
        return false
    }
    if c.card == 4096 {
        *c = *to_bitmap(c)
        return bitmap_add(c, v)
    }
    open_gap(c, i, c.card, 1)
    c.values[i] = u16(v)
    c.card += 1
    true
}

fn array_remove(c: *Container, v: i64) -> bool {
    let i = lower_bound(c.values, 0, c.card, v)
    if i == c.card || i64(c.values[i]) != v {
        return false
    }
    close_gap(c, i, c.card, 1)
    c.card -= 1
    true
}

fn bitmap_add(c: *Container, v: i64) -> bool {
    let w = c.words[v >> 6]
    if (w & bit(v)) != 0 {
        return false
    }
    c.words[v >> 6] = w | bit(v)
    c.card += 1
    true
}

fn bitmap_remove(c: *Container, v: i64) -> bool {
    let w = c.words[v >> 6]
    if (w & bit(v)) == 0 {
        return false
    }
    c.words[v >> 6] = w & ~bit(v)
    c.card -= 1
    if c.card <= 4096 {
        *c = *to_array(c)
    }
    true
}

fn run_add(c: *Container, v: i64) -> bool {
    let i = run_index(c, v)
    if i >= 0 && v <= run_last(c, i) {
        return false
    }
    let joins_left = i >= 0 && run_last(c, i) + 1 == v
    let joins_right = i + 1 < c.runs && run_start(c, i + 1) == v + 1
    if joins_left && joins_right {
        c.values[2 * i + 1] = u16(run_last(c, i + 1) - run_start(c, i))
        close_gap(c, 2 * i + 2, 2 * c.runs, 2)
        c.runs -= 1
    } else if joins_left {
        c.values[2 * i + 1] += 1
    } else if joins_right {
        c.values[2 * i + 2] = u16(v)
        c.values[2 * i + 3] += 1
    } else {
        open_gap(c, 2 * i + 2, 2 * c.runs, 2)
        c.values[2 * i + 2] = u16(v)
        c.values[2 * i + 3] = 0
        c.runs += 1
    }
    c.card += 1
    true
}

fn run_remove(c: *Container, v: i64) -> bool {
    let i = run_index(c, v)
    if i < 0 || v > run_last(c, i) {
        return false
    }
    let first = run_start(c, i)
    let last = run_last(c, i)
    if first == last {
        close_gap(c, 2 * i, 2 * c.runs, 2)
        c.runs -= 1
    } else if v == first {
        c.values[2 * i] = u16(v + 1)
        c.values[2 * i + 1] -= 1
    } else if v == last {
        c.values[2 * i + 1] -= 1
    } else {
        c.values[2 * i + 1] = u16(v - 1 - first)
        open_gap(c, 2 * i + 2, 2 * c.runs, 2)
        c.values[2 * i + 2] = u16(v + 1)
        c.values[2 * i + 3] = u16(last - v - 1)
        c.runs += 1
    }
    c.card -= 1
    true
}

fn apply_mask(words: []u64, i: i64, mask: u64, op: Op) {
    match op {
        And => {
            words[i] &= mask
        }
        Or => {
            words[i] |= mask
        }
        Xor => {
            words[i] ^= mask
        }
        AndNot => {
            words[i] &= ~mask
        }
    }
}

fn range_words(words: []u64, lo: i64, hi: i64, op: Op) {
    let first = lo >> 6
    let last = hi >> 6
    let head: u64 = 0xFFFFFFFFFFFFFFFF << (lo & 63)
    let tail: u64 = 0xFFFFFFFFFFFFFFFF >> (63 - (hi & 63))
    if first == last {
        apply_mask(words, first, head & tail, op)
        return
    }
    apply_mask(words, first, head, op)
    match op {
        And => {}
        Or => {
            for i in first + 1..last {
                words[i] = 0xFFFFFFFFFFFFFFFF
            }
        }
        Xor => {
            for i in first + 1..last {
                words[i] = ~words[i]
            }
        }
        AndNot => {
            for i in first + 1..last {
                words[i] = 0
            }
        }
    }
    apply_mask(words, last, tail, op)
}

fn words_of(c: *Container) -> []u64 {
    let words: []u64 = __make(1024)
    match c.kind {
        Array => {
            for i in 0..c.card {
                let v = i64(c.values[i])
                words[v >> 6] |= bit(v)
            }
        }
        Bitmap => {
            __memmove(words, c.words)
        }
        Run => {
            for i in 0..c.runs {
                range_words(words, run_start(c, i), run_last(c, i), Or)
            }
        }
    }
    words
}

fn to_bitmap(c: *Container) -> *Container {
    bitmap_container(words_of(c), c.card)
}

fn write_values(c: *Container, out: []u16) {
    match c.kind {
        Array => {
            __memmove(out, c.values[..c.card])
        }
        Bitmap => {
            var k = 0
            for i, word in c.words {
                var w = word
                for w != 0 {
                    out[k] = u16((i << 6) | bits.trailing_zeros(w))
                    k += 1
                    w &= w - 1
                }
            }
        }
        Run => {
            var k = 0
            for i in 0..c.runs {
                for v in run_start(c, i)..run_last(c, i) + 1 {
                    out[k] = u16(v)
                    k += 1
                }
            }
        }
    }
}

fn to_array(c: *Container) -> *Container {
    let out = array_container(c.card)
    write_values(c, out.values)
    out.card = c.card
    out
}

fn count_runs(c: *Container) -> i64 {
    match c.kind {
        Array => {
            var runs = if c.card > 0 { 1 } else { 0 }
            for i in 1..c.card {
                if i64(c.values[i]) != i64(c.values[i - 1]) + 1 {
                    runs += 1
                }
            }
            runs
        }
        Bitmap => {
            var runs = 0
            var carry: u64 = 0
            for w in c.words {
                runs += bits.popcount(w & ~((w << 1) | carry))
                carry = w >> 63
            }
            runs
        }
        Run => c.runs
    }
}

fn to_run(c: *Container, runs: i64) -> *Container {
    let values: []u16 = __make(2 * runs)
    var n = 0
    match c.kind {
        Array => {
            var i = 0
            for i < c.card {
                let first = i64(c.values[i])
                var j = i + 1
                for j < c.card && i64(c.values[j]) == first + j - i {
                    j += 1
                }
                values[2 * n] = u16(first)
                values[2 * n + 1] = u16(j - i - 1)
                n += 1
                i = j
            }
        }
        Bitmap => {
            var i = 0
            var w = c.words[0]
            for {
                for w == 0 && i < 1023 {
                    i += 1
                    w = c.words[i]
                }
                if w == 0 {
                    break
                }
                let first = (i << 6) + bits.trailing_zeros(w)
                w |= w - 1
                for w == 0xFFFFFFFFFFFFFFFF && i < 1023 {
                    i += 1
                    w = c.words[i]
                }
                if w == 0xFFFFFFFFFFFFFFFF {
                    values[2 * n] = u16(first)
                    values[2 * n + 1] = u16(65535 - first)
                    n += 1
                    break
                }
                let last = (i << 6) + bits.trailing_zeros(~w) - 1
                values[2 * n] = u16(first)
                values[2 * n + 1] = u16(last - first)
                n += 1
                w &= w + 1
            }
        }
        Run => {
            return c
        }
    }
    run_container(values, n, c.card)
}

fn tidy(c: *Container) -> *Container {
    let runs = count_runs(c)
    let other = if c.card <= 4096 { 2 * c.card } else { 8192 }
    if 2 + 4 * runs < other {
        return to_run(c, runs)
    }
    if c.card <= 4096 {
        if c.kind == Array { c } else { to_array(c) }
    } else {
        if c.kind == Bitmap { c } else { to_bitmap(c) }
    }
}

fn from_words(words: []u64) -> *Container {
    var card = 0
    for w in words {
        card += bits.popcount(w)
    }
    let c = bitmap_container(words, card)
    if card <= 4096 {
        return to_array(c)
    }
    c
}

fn from_values(out: *Container, n: i64) -> *Container {
    out.card = n
    if n > 4096 {
        return to_bitmap(out)
    }
    out
}

fn array_and(a: *Container, b: *Container) -> *Container {
    let small = if a.card <= b.card { a } else { b }
    let large = if a.card <= b.card { b } else { a }
    let out = array_container(small.card)
    var n = 0
    var j = 0
    if small.card * 32 < large.card {
        for i in 0..small.card {
            let v = i64(small.values[i])
            j = lower_bound(large.values, j, large.card, v)
            if j == large.card {
                break
            }
            if i64(large.values[j]) == v {
                out.values[n] = u16(v)
                n += 1
            }
        }
        out.card = n
        return out
    }
    var i = 0
    for i < small.card && j < large.card {
        let x = small.values[i]
        let y = large.values[j]
        if x < y {
            i += 1
        } else if y < x {
            j += 1
        } else {
            out.values[n] = x
            n += 1
            i += 1
            j += 1
        }
    }
    out.card = n
    out
}

fn array_merge(a: *Container, b: *Container, op: Op) -> *Container {
    let capacity = if op == AndNot { a.card } else { a.card + b.card }
    let out = array_container(capacity)
    let keep_b = op != AndNot
    let keep_both = op == Or
    var n = 0
    var i = 0
    var j = 0
    for i < a.card && j < b.card {
        let x = a.values[i]
        let y = b.values[j]
        if x < y {
            out.values[n] = x
            n += 1
            i += 1
        } else if y < x {
            if keep_b {
                out.values[n] = y
                n += 1
            }
            j += 1
        } else {
            if keep_both {
                out.values[n] = x
                n += 1
            }
            i += 1
            j += 1
        }
    }
    if i < a.card {
        __memmove(out.values[n..], a.values[i..a.card])
        n += a.card - i
    }
    if keep_b && j < b.card {
        __memmove(out.values[n..], b.values[j..b.card])
        n += b.card - j
    }
    from_values(out, n)
}

fn filter(a: *Container, b: *Container, keep: bool) -> *Container {
    let out = array_container(a.card)
    var n = 0
    for i in 0..a.card {
        let v = a.values[i]
        if container_contains(b, i64(v)) == keep {
            out.values[n] = v
            n += 1
        }
    }
    out.card = n
    out
}

fn push_run(values: []u16, n: i64, first: i64, last: i64) {
    values[2 * n] = u16(first)
    values[2 * n + 1] = u16(last - first)
}

fn finish_runs(values: []u16, n: i64) -> *Container {
    if n == 0 {
        return array_container(0)
    }
    var card = 0
    for i in 0..n {
        card += i64(values[2 * i + 1]) + 1
    }
    tidy(run_container(values, n, card))
}

fn run_and(a: *Container, b: *Container) -> *Container {
    let values: []u16 = __make(2 * (a.runs + b.runs))
    var n = 0
    var i = 0
    var j = 0
    for i < a.runs && j < b.runs {
        let first = math.max(run_start(a, i), run_start(b, j))
        let last_a = run_last(a, i)
        let last_b = run_last(b, j)
        let last = math.min(last_a, last_b)
        if first <= last {
            push_run(values, n, first, last)
            n += 1
        }
        if last_a < last_b {
            i += 1
        } else {
            j += 1
        }
    }
    finish_runs(values, n)
}

fn run_or(a: *Container, b: *Container) -> *Container {
    let values: []u16 = __make(2 * (a.runs + b.runs))
    var n = 0
    var i = 0
    var j = 0
    var first = -1
    var last = -2
    for i < a.runs || j < b.runs {
        let take_a = j == b.runs || (i < a.runs && run_start(a, i) <= run_start(b, j))
        let source = if take_a { a } else { b }
        let k = if take_a { i } else { j }
        let s = run_start(source, k)
        let e = run_last(source, k)
        if take_a {
            i += 1
        } else {
            j += 1
        }
        if s <= last + 1 {
            if e > last {
                last = e
            }
        } else {
            if first >= 0 {
                push_run(values, n, first, last)
                n += 1
            }
            first = s
            last = e
        }
    }
    if first >= 0 {
        push_run(values, n, first, last)
        n += 1
    }
    finish_runs(values, n)
}

fn run_complement(c: *Container) -> *Container {
    let values: []u16 = __make(2 * (c.runs + 1))
    var n = 0
    var next = 0
    for i in 0..c.runs {
        if run_start(c, i) > next {
            push_run(values, n, next, run_start(c, i) - 1)
            n += 1
        }
        next = run_last(c, i) + 1
    }
    if next <= 65535 {
        push_run(values, n, next, 65535)
        n += 1
    }
    run_container(values, n, 65536 - c.card)
}

fn apply_words(dst: []u64, other: *Container, op: Op) {
    match other.kind {
        Bitmap => {
            let src = other.words
            match op {
                And => {
                    for i in 0..1024 {
                        dst[i] &= src[i]
                    }
                }
                Or => {
                    for i in 0..1024 {
                        dst[i] |= src[i]
                    }
                }
                Xor => {
                    for i in 0..1024 {
                        dst[i] ^= src[i]
                    }
                }
                AndNot => {
                    for i in 0..1024 {
                        dst[i] &= ~src[i]
                    }
                }
            }
        }
        Array => {
            for i in 0..other.card {
                let v = i64(other.values[i])
                apply_mask(dst, v >> 6, bit(v), op)
            }
        }
        Run => {
            if op == And {
                var next = 0
                for i in 0..other.runs {
                    if run_start(other, i) > next {
                        range_words(dst, next, run_start(other, i) - 1, AndNot)
                    }
                    next = run_last(other, i) + 1
                }
                if next <= 65535 {
                    range_words(dst, next, 65535, AndNot)
                }
            } else {
                for i in 0..other.runs {
                    range_words(dst, run_start(other, i), run_last(other, i), op)
                }
            }
        }
    }
}

fn words_op(a: *Container, b: *Container, op: Op, inplace: bool) -> *Container {
    if inplace && a.kind == Bitmap {
        apply_words(a.words, b, op)
        return from_words(a.words)
    }
    if a.kind != Bitmap && b.kind == Bitmap && op != AndNot {
        let words = words_of(b)
        apply_words(words, a, op)
        return from_words(words)
    }
    let words = words_of(a)
    apply_words(words, b, op)
    from_words(words)
}

fn container_and(a: *Container, b: *Container, inplace: bool) -> *Container {
    if a.kind == Array && b.kind == Array {
        return array_and(a, b)
    }
    if a.kind == Array {
        return filter(a, b, true)
    }
    if b.kind == Array {
        return filter(b, a, true)
    }
    if a.kind == Run && b.kind == Run {
        return run_and(a, b)
    }
    words_op(a, b, And, inplace)
}

fn container_or(a: *Container, b: *Container, inplace: bool) -> *Container {
    if a.kind == Array && b.kind == Array {
        return array_merge(a, b, Or)
    }
    if is_full(a) {
        return if inplace { a } else { clone_container(a) }
    }
    if is_full(b) {
        return clone_container(b)
    }
    if a.kind == Run && b.kind == Run {
        return run_or(a, b)
    }
    if a.kind == Run && b.kind == Array {
        return run_or(a, to_run(b, count_runs(b)))
    }
    if a.kind == Array && b.kind == Run {
        return run_or(to_run(a, count_runs(a)), b)
    }
    words_op(a, b, Or, inplace)
}

fn container_xor(a: *Container, b: *Container, inplace: bool) -> *Container {
    if a.kind == Array && b.kind == Array {
        return array_merge(a, b, Xor)
    }
    words_op(a, b, Xor, inplace)
}

fn container_and_not(a: *Container, b: *Container, inplace: bool) -> *Container {
    if a.kind == Array && b.kind == Array {
        return array_merge(a, b, AndNot)
    }
    if a.kind == Array {
        return filter(a, b, false)
    }
    if a.kind == Run && b.kind == Run {
        return run_and(a, run_complement(b))
    }
    words_op(a, b, AndNot, inplace)
}

fn container_op(a: *Container, b: *Container, op: Op, inplace: bool) -> *Container {
    match op {
        And => container_and(a, b, inplace)
        Or => container_or(a, b, inplace)
        Xor => container_xor(a, b, inplace)
        AndNot => container_and_not(a, b, inplace)
    }
}

fn container_equal(a: *Container, b: *Container) -> bool {
    if a.card != b.card {
        return false
    }
    if a.kind == Array && b.kind == Array {
        for i in 0..a.card {
            if a.values[i] != b.values[i] {
                return false
            }
        }
        return true
    }
    if a.kind == Bitmap && b.kind == Bitmap {
        for i in 0..1024 {
            if a.words[i] != b.words[i] {
                return false
            }
        }
        return true
    }
    container_and(a, b, false).card == a.card
}

fn container_subset(a: *Container, b: *Container) -> bool {
    a.card <= b.card && container_and(a, b, false).card == a.card
}

fn container_rank(c: *Container, v: i64) -> i64 {
    match c.kind {
        Array => lower_bound(c.values, 0, c.card, v + 1)
        Bitmap => {
            let last = v >> 6
            var total = 0
            for i in 0..last {
                total += bits.popcount(c.words[i])
            }
            total + bits.popcount(c.words[last] & (0xFFFFFFFFFFFFFFFF >> (63 - (v & 63))))
        }
        Run => {
            var total = 0
            for i in 0..c.runs {
                let first = run_start(c, i)
                if first > v {
                    break
                }
                let last = run_last(c, i)
                total += math.min(last, v) - first + 1
            }
            total
        }
    }
}

fn container_select(c: *Container, k: i64) -> i64 {
    match c.kind {
        Array => i64(c.values[k])
        Bitmap => {
            var left = k
            var i = 0
            for {
                let n = bits.popcount(c.words[i])
                if left < n {
                    break
                }
                left -= n
                i += 1
            }
            (i << 6) | bits.select_in_word(c.words[i], left)
        }
        Run => {
            var left = k
            var i = 0
            for {
                let n = run_last(c, i) - run_start(c, i) + 1
                if left < n {
                    break
                }
                left -= n
                i += 1
            }
            run_start(c, i) + left
        }
    }
}

fn container_min(c: *Container) -> i64 {
    match c.kind {
        Array => i64(c.values[0])
        Bitmap => {
            var i = 0
            for c.words[i] == 0 {
                i += 1
            }
            (i << 6) | bits.trailing_zeros(c.words[i])
        }
        Run => run_start(c, 0)
    }
}

fn container_max(c: *Container) -> i64 {
    match c.kind {
        Array => i64(c.values[c.card - 1])
        Bitmap => {
            var i = 1023
            for c.words[i] == 0 {
                i -= 1
            }
            (i << 6) | (63 - bits.leading_zeros(c.words[i]))
        }
        Run => run_last(c, c.runs - 1)
    }
}

fn container_emit(c: *Container, high: u32, out: []u32, at: i64) {
    match c.kind {
        Array => {
            for i in 0..c.card {
                out[at + i] = high | u32(c.values[i])
            }
        }
        Bitmap => {
            var k = at
            for i, word in c.words {
                var w = word
                for w != 0 {
                    out[k] = high | u32((i << 6) | bits.trailing_zeros(w))
                    k += 1
                    w &= w - 1
                }
            }
        }
        Run => {
            var k = at
            for i in 0..c.runs {
                for v in run_start(c, i)..run_last(c, i) + 1 {
                    out[k] = high | u32(v)
                    k += 1
                }
            }
        }
    }
}

fn container_visit(c: *Container, high: u32, f: fn(u32) -> bool) -> bool {
    match c.kind {
        Array => {
            for i in 0..c.card {
                if !f(high | u32(c.values[i])) {
                    return false
                }
            }
        }
        Bitmap => {
            for i, word in c.words {
                var w = word
                for w != 0 {
                    if !f(high | u32((i << 6) | bits.trailing_zeros(w))) {
                        return false
                    }
                    w &= w - 1
                }
            }
        }
        Run => {
            for i in 0..c.runs {
                for v in run_start(c, i)..run_last(c, i) + 1 {
                    if !f(high | u32(v)) {
                        return false
                    }
                }
            }
        }
    }
    true
}
