import std/math

/// Returns the number of bits set in `x`.
pub fn popcount(x: u64) -> i64 {
    var v = x - ((x >> 1) & 0x5555555555555555)
    v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333)
    v = (v + (v >> 4)) & 0x0F0F0F0F0F0F0F0F
    i64((v * 0x0101010101010101) >> 56)
}

/// Returns the number of zero bits below the lowest set bit of `x`.
///
/// Returns `64` when `x` is zero. Uses the processor's bit scan instruction.
pub fn trailing_zeros(x: u64) -> i64 {
    __ctz(x)
}

/// Returns the number of zero bits above the highest set bit of `x`.
///
/// Returns `64` when `x` is zero.
pub fn leading_zeros(x: u64) -> i64 {
    var v = x | (x >> 1)
    v |= v >> 2
    v |= v >> 4
    v |= v >> 8
    v |= v >> 16
    v |= v >> 32
    64 - popcount(v)
}

/// Returns the number of bits needed to write `x`, which is `0` for zero and `1` for one.
pub fn bit_length(x: u64) -> i64 {
    64 - leading_zeros(x)
}

/// Returns `x` rotated left by `n` bits, with the bits shifted out of the top re-entering at the bottom.
///
/// `n` runs from `0` to `32`.
pub fn rotl32(x: u32, n: i64) -> u32 {
    x << n | x >> (32 - n)
}

/// Returns `x` rotated right by `n` bits, with the bits shifted out of the bottom re-entering at the top.
///
/// `n` runs from `0` to `32`.
pub fn rotr32(x: u32, n: i64) -> u32 {
    x >> n | x << (32 - n)
}

/// Returns `x` rotated left by `n` bits, with the bits shifted out of the top re-entering at the bottom.
///
/// `n` runs from `0` to `64`.
pub fn rotl64(x: u64, n: i64) -> u64 {
    x << n | x >> (64 - n)
}

/// Returns `x` rotated right by `n` bits, with the bits shifted out of the bottom re-entering at the top.
///
/// `n` runs from `0` to `64`.
pub fn rotr64(x: u64, n: i64) -> u64 {
    x >> n | x << (64 - n)
}

/// Returns the position of the `k`th set bit of `x`, counting from zero at the least significant bit.
///
/// Returns `64` when `x` has `k` or fewer set bits.
pub fn select_in_word(x: u64, k: i64) -> i64 {
    var v = x
    for _ in 0..k {
        v &= v - 1
    }
    trailing_zeros(v)
}

/// A growable set of non-negative integers stored as one bit per member in `u64` words.
///
/// Create one with `set`. A `Set` is used through a pointer and grows when a member beyond its capacity is added. Membership operations take constant time; whole-set operations, `count` and the scans take time proportional to the number of words, and scans skip empty words 64 members at a time. Members must not be negative.
pub struct Set {
    words: []u64
}

/// Returns an empty set with room for members below `capacity` without growing.
pub fn set(capacity: i64) -> *Set {
    let words: []u64 = __make((capacity + 63) >> 6)
    new(Set { words })
}

/// Returns a new set with the same members as `s`.
pub fn clone(s: *Set) -> *Set {
    let words: []u64 = __make(s.words.len)
    __memmove(words, s.words)
    new(Set { words })
}

fn reserve(s: *Set, words: i64) {
    if words <= s.words.len {
        return
    }
    let size = if s.words.len * 2 < words { words } else { s.words.len * 2 }
    let grown: []u64 = __make(size)
    __memmove(grown, s.words)
    s.words = grown
}

fn bit(x: i64) -> u64 {
    u64(1) << (x & 63)
}

/// Adds `x` to `s`, growing the set when `x` is beyond its capacity.
///
/// Adding a member that is present changes nothing.
pub fn add(s: *Set, x: i64) {
    reserve(s, (x >> 6) + 1)
    s.words[x >> 6] |= bit(x)
}

/// Removes `x` from `s`.
///
/// Does nothing when `x` is not a member, including when it is negative or beyond the capacity.
pub fn remove(s: *Set, x: i64) {
    if x >= 0 && x >> 6 < s.words.len {
        s.words[x >> 6] &= ~bit(x)
    }
}

/// Adds `x` to `s` when it is absent and removes it when it is present.
///
/// Grows the set when `x` is beyond its capacity.
pub fn toggle(s: *Set, x: i64) {
    reserve(s, (x >> 6) + 1)
    s.words[x >> 6] ^= bit(x)
}

/// Returns `true` when `x` is a member of `s`.
///
/// Returns `false` for a negative `x` and for one beyond the capacity.
pub fn contains(s: *Set, x: i64) -> bool {
    x >= 0 && x >> 6 < s.words.len && (s.words[x >> 6] & bit(x)) != 0
}

/// Returns the number of members of `s`.
pub fn count(s: *Set) -> i64 {
    var total = 0
    for w in s.words {
        total += popcount(w)
    }
    total
}

/// Removes every member from `s`, keeping its capacity.
pub fn clear(s: *Set) {
    let words = s.words
    for i in 0..words.len {
        words[i] = 0
    }
}

fn word_at(s: *Set, i: i64) -> u64 {
    if i < s.words.len { s.words[i] } else { 0 }
}

/// Adds every member of `b` to `a`, growing `a` when `b` is larger.
pub fn union_with(a: *Set, b: *Set) {
    reserve(a, b.words.len)
    let words = a.words
    for i, w in b.words {
        words[i] |= w
    }
}

/// Removes from `a` every member that is not in `b`.
pub fn intersect_with(a: *Set, b: *Set) {
    let words = a.words
    for i in 0..words.len {
        words[i] &= word_at(b, i)
    }
}

/// Removes from `a` every member that is in `b`.
pub fn difference_with(a: *Set, b: *Set) {
    let words = a.words
    let shared = math.min(words.len, b.words.len)
    for i in 0..shared {
        words[i] &= ~b.words[i]
    }
}

/// Makes `a` the symmetric difference of `a` and `b`: members in exactly one of the two.
///
/// Grows `a` when `b` is larger.
pub fn xor_with(a: *Set, b: *Set) {
    reserve(a, b.words.len)
    let words = a.words
    for i, w in b.words {
        words[i] ^= w
    }
}

/// Returns a new set of the members that are in `a` or `b`.
///
/// Neither argument changes.
pub fn union(a: *Set, b: *Set) -> *Set {
    let out = clone(a)
    union_with(out, b)
    out
}

/// Returns a new set of the members that are in both `a` and `b`.
///
/// Neither argument changes.
pub fn intersect(a: *Set, b: *Set) -> *Set {
    let out = clone(a)
    intersect_with(out, b)
    out
}

/// Returns a new set of the members of `a` that are not in `b`.
///
/// Neither argument changes.
pub fn difference(a: *Set, b: *Set) -> *Set {
    let out = clone(a)
    difference_with(out, b)
    out
}

/// Returns a new set of the members that are in exactly one of `a` and `b`.
///
/// Neither argument changes.
pub fn xor(a: *Set, b: *Set) -> *Set {
    let out = clone(a)
    xor_with(out, b)
    out
}

/// Returns `true` when `a` and `b` have the same members.
///
/// Capacity is not compared, so sets of different capacity can be equal.
pub fn equal(a: *Set, b: *Set) -> bool {
    let size = math.max(a.words.len, b.words.len)
    for i in 0..size {
        if word_at(a, i) != word_at(b, i) {
            return false
        }
    }
    true
}

/// Returns `true` when every member of `a` is also in `b`.
///
/// An empty set is a subset of every set.
pub fn subset(a: *Set, b: *Set) -> bool {
    for i, w in a.words {
        if (w & ~word_at(b, i)) != 0 {
            return false
        }
    }
    true
}

/// Returns the smallest member of `s` that is at least `from`, or `none` when there is none.
///
/// A negative `from` starts at zero.
pub fn next_set(s: *Set, from: i64) -> i64? {
    let start = if from < 0 { 0 } else { from }
    var i = start >> 6
    if i >= s.words.len {
        return none
    }
    var w = s.words[i] & (0xFFFFFFFFFFFFFFFF << (start & 63))
    for w == 0 {
        i += 1
        if i == s.words.len {
            return none
        }
        w = s.words[i]
    }
    (i << 6) | trailing_zeros(w)
}

/// Returns the smallest non-member of `s` that is at least `from`.
///
/// A negative `from` starts at zero. Every value beyond the capacity is a non-member, so the result is never `none` and is at most the capacity rounded up to a multiple of 64.
pub fn next_clear(s: *Set, from: i64) -> i64 {
    let start = if from < 0 { 0 } else { from }
    var i = start >> 6
    if i >= s.words.len {
        return start
    }
    var w = ~s.words[i] & (0xFFFFFFFFFFFFFFFF << (start & 63))
    for w == 0 {
        i += 1
        if i == s.words.len {
            return i << 6
        }
        w = ~s.words[i]
    }
    (i << 6) | trailing_zeros(w)
}

/// Calls `f` with each member of `s` in increasing order.
///
/// Stops early when `f` returns `false`.
pub fn for_each(s: *Set, f: fn(i64) -> bool) {
    for i, word in s.words {
        var w = word
        for w != 0 {
            if !f((i << 6) | trailing_zeros(w)) {
                return
            }
            w &= w - 1
        }
    }
}

/// Returns the members of `s` in increasing order.
pub fn members(s: *Set) -> []i64 {
    let out: []i64 = __make(count(s))
    var k = 0
    for i, word in s.words {
        var w = word
        for w != 0 {
            out[k] = (i << 6) | trailing_zeros(w)
            k += 1
            w &= w - 1
        }
    }
    out
}

/// Returns the smallest member of `s`, or `none` when it is empty.
pub fn min(s: *Set) -> i64? {
    next_set(s, 0)
}

/// Returns the largest member of `s`, or `none` when it is empty.
pub fn max(s: *Set) -> i64? {
    var i = s.words.len - 1
    for i >= 0 {
        let w = s.words[i]
        if w != 0 {
            return (i << 6) | (63 - leading_zeros(w))
        }
        i -= 1
    }
    none
}

/// Returns the number of members of `s` that are at most `x`.
///
/// Returns `0` for a negative `x` and the total count for an `x` beyond the capacity.
pub fn rank(s: *Set, x: i64) -> i64 {
    if x < 0 {
        return 0
    }
    let last = x >> 6
    let full = math.min(last, s.words.len)
    var total = 0
    for i in 0..full {
        total += popcount(s.words[i])
    }
    if last < s.words.len {
        total += popcount(s.words[last] & (0xFFFFFFFFFFFFFFFF >> (63 - (x & 63))))
    }
    total
}

/// Returns the member of `s` with zero-based position `k` in increasing order, or `none` when `k` is negative or at least `count(s)`.
///
/// This is the inverse of `rank`: `rank(s, x) - 1` is the position of the member `x`.
pub fn select_at(s: *Set, k: i64) -> i64? {
    if k < 0 {
        return none
    }
    var left = k
    for i, w in s.words {
        let c = popcount(w)
        if left < c {
            return (i << 6) | select_in_word(w, left)
        }
        left -= c
    }
    none
}
