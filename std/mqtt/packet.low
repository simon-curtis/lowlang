/// The error type of the mqtt module, returned by the codec, connecting, publishing and subscribing.
pub enum Error {
    /// The broker could not be reached or the TLS handshake failed.
    Connect
    /// The client is closed or the connection ended.
    Closed
    /// A connect, read, write or wait exceeded its time limit.
    Timeout
    /// The bytes are not a valid MQTT packet: a bad length, a flag that must be zero, a truncated field, a string that is not valid UTF-8 or contains U+0000, a zero packet identifier, a property value out of its range such as a topic alias of zero, or a property that is repeated or not allowed in the packet.
    Malformed
    /// A well-formed packet that the protocol does not allow at this point: an unexpected packet type, a topic alias above the limit or not yet bound, a PUBCOMP before its PUBREC, a SUBACK or UNSUBACK with a different number of codes than filters, or more unacknowledged messages than the receive maximum.
    Protocol
    /// A packet is longer than the maximum packet size that applies to it, or longer than the protocol maximum of 268435455 bytes.
    TooLarge
    /// A topic name or topic filter is empty, longer than 65535 bytes, contains a wildcard where it is not allowed or is not valid UTF-8.
    InvalidTopic
    /// A string is longer than 65535 bytes, is not valid UTF-8 or contains U+0000.
    InvalidString
    /// An argument is out of range, such as a QoS above 2 or an empty list of filters.
    Invalid
    /// The call needs something the connection does not offer: a QoS or retained messages above what the broker accepts, or a protocol version other than 3.1.1 and 5.
    Unsupported
    /// The broker refused the connection. `code` is the CONNACK return code of MQTT 3.1.1 (`1` to `5`) or the reason code of MQTT 5 (`0x80` and above).
    Refused(code: i64)
    /// The broker answered a publish, subscribe or unsubscribe with a failure. `code` is the reason code, `0x80` or above.
    Rejected(code: i64)
    /// The broker sent a DISCONNECT. `code` is its reason code and `reason` its reason string, empty when there is none.
    Disconnected(code: i64, reason: str)
    /// The broker did not keep the session, so a message that was waiting for its acknowledgement cannot be completed.
    SessionLost
    /// Every packet identifier is in use.
    Exhausted
    /// The connection is still up, so it cannot be re-established.
    Connected
}

/// The protocol version of a connection.
pub enum Version {
    /// MQTT 3.1.1, protocol level 4.
    V311 = 4
    /// MQTT 5.0, protocol level 5.
    V5 = 5
}

/// A user property: a name and a value that the protocol carries without interpreting.
pub struct UserProperty {
    /// The property name.
    pub name: str
    /// The property value.
    pub value: str
}

/// The properties of an MQTT 5 packet, each absent when `none` or empty.
///
/// MQTT 3.1.1 has no properties and ignores them. A property that the packet type does not allow fails encoding with `Protocol`, and decoding with `Malformed`.
pub struct Properties {
    /// The payload format indicator: `0` for unspecified bytes, `1` for UTF-8 text. PUBLISH and will.
    pub payload_format: i64? = none
    /// The message expiry interval in seconds. PUBLISH and will.
    pub message_expiry: i64? = none
    /// The content type of the payload. PUBLISH and will.
    pub content_type: str? = none
    /// The topic a response should be published to. PUBLISH and will.
    pub response_topic: str? = none
    /// The data that ties a response to its request. PUBLISH and will.
    pub correlation_data: u8[]? = none
    /// The subscription identifiers that matched, from `1` to `268435455`. PUBLISH from a broker carries one for each matching subscription, SUBSCRIBE carries one.
    pub subscription_ids: i64[] = []
    /// The session expiry interval in seconds. CONNECT, CONNACK and DISCONNECT.
    pub session_expiry: i64? = none
    /// The client identifier the broker assigned. CONNACK.
    pub assigned_client_id: str? = none
    /// The keep alive in seconds the broker requires instead of the client's. CONNACK.
    pub server_keep_alive: i64? = none
    /// The authentication method for enhanced authentication. CONNECT, CONNACK and AUTH.
    pub auth_method: str? = none
    /// The authentication data for enhanced authentication. CONNECT, CONNACK and AUTH.
    pub auth_data: u8[]? = none
    /// Whether the broker may send reason strings and user properties on failures. CONNECT.
    pub request_problem_information: bool? = none
    /// The delay in seconds before the broker publishes the will. Will only.
    pub will_delay: i64? = none
    /// Whether the broker should return response information. CONNECT.
    pub request_response_information: bool? = none
    /// The basis for the response topic of the request and response pattern. CONNACK.
    pub response_information: str? = none
    /// The broker to use instead of this one. CONNACK and DISCONNECT.
    pub server_reference: str? = none
    /// A human readable reason for the packet. CONNACK, the acknowledgements, SUBACK, UNSUBACK, DISCONNECT and AUTH.
    pub reason_string: str? = none
    /// The most unacknowledged QoS 1 and 2 messages the sender accepts at once, from `1` to `65535`. CONNECT and CONNACK.
    pub receive_maximum: i64? = none
    /// The highest topic alias the sender accepts. CONNECT and CONNACK.
    pub topic_alias_maximum: i64? = none
    /// The topic alias of a PUBLISH, from `1` to `65535`.
    pub topic_alias: i64? = none
    /// The highest QoS the broker accepts, `0` or `1`. CONNACK.
    pub maximum_qos: i64? = none
    /// Whether the broker supports retained messages. CONNACK.
    pub retain_available: bool? = none
    /// The user properties in the order sent. Allowed in every packet type that has properties.
    pub user_properties: UserProperty[] = []
    /// The largest packet the sender accepts, from `1` to `4294967295`. CONNECT and CONNACK.
    pub maximum_packet_size: i64? = none
    /// Whether the broker supports wildcard subscriptions. CONNACK.
    pub wildcard_subscription_available: bool? = none
    /// Whether the broker supports subscription identifiers. CONNACK.
    pub subscription_identifiers_available: bool? = none
    /// Whether the broker supports shared subscriptions. CONNACK.
    pub shared_subscription_available: bool? = none
}

/// A will message the broker publishes when the connection ends without a DISCONNECT.
pub struct Will {
    /// The topic the will is published to.
    pub topic: str
    /// The will payload.
    pub payload: u8[] = []
    /// The QoS the will is published at, `0` to `2`.
    pub qos: i64 = 0
    /// Whether the will is retained.
    pub retain: bool = false
    /// The will properties of MQTT 5: `will_delay`, `payload_format`, `message_expiry`, `content_type`, `response_topic`, `correlation_data` and `user_properties`.
    pub properties: Properties = Properties {}
}

/// The CONNECT packet.
pub struct Connect {
    /// The protocol version.
    pub version: Version = Version.V5
    /// The client identifier. Empty asks the broker to assign one.
    pub client_id: str = ""
    /// Clean start in MQTT 5, clean session in MQTT 3.1.1: whether the broker discards any stored session.
    pub clean_start: bool = true
    /// The keep alive interval in seconds. `0` turns it off.
    pub keep_alive: i64 = 0
    /// The user name, or `none`.
    pub username: str? = none
    /// The password, or `none`. MQTT 3.1.1 only allows one together with a user name.
    pub password: u8[]? = none
    /// The will message, or `none`.
    pub will: Will? = none
    /// The CONNECT properties.
    pub properties: Properties = Properties {}
}

/// The CONNACK packet.
pub struct Connack {
    /// Whether the broker kept a session for the client.
    pub session_present: bool = false
    /// The MQTT 3.1.1 return code or MQTT 5 reason code. `0` is success.
    pub code: i64 = 0
    /// The CONNACK properties.
    pub properties: Properties = Properties {}
}

/// The PUBLISH packet.
pub struct Publish {
    /// The topic name. Empty only in MQTT 5 when `properties.topic_alias` names an alias already bound.
    pub topic: str
    /// The payload.
    pub payload: u8[] = []
    /// The QoS, `0` to `2`.
    pub qos: i64 = 0
    /// Whether the message is retained.
    pub retain: bool = false
    /// Whether this is a resend of an earlier attempt.
    pub dup: bool = false
    /// The packet identifier. Used when `qos` is above `0`, and `0` otherwise.
    pub id: i64 = 0
    /// The PUBLISH properties.
    pub properties: Properties = Properties {}
}

/// The body of PUBACK, PUBREC, PUBREL and PUBCOMP.
pub struct Ack {
    /// The packet identifier of the PUBLISH.
    pub id: i64
    /// The MQTT 5 reason code. `0` is success; `0x80` and above is a failure. MQTT 3.1.1 has none and reads as `0`.
    pub code: i64 = 0
    /// The properties of MQTT 5.
    pub properties: Properties = Properties {}
}

/// One topic filter of a SUBSCRIBE with its subscription options.
pub struct Filter {
    /// The topic filter, which may contain `+` and `#`.
    pub filter: str
    /// The highest QoS the broker may deliver at, `0` to `2`.
    pub qos: i64 = 0
    /// MQTT 5: whether the broker skips messages the client published itself.
    pub no_local: bool = false
    /// MQTT 5: whether the broker keeps the retain flag as published instead of clearing it for live delivery.
    pub retain_as_published: bool = false
    /// MQTT 5: when retained messages are sent. `0` at subscribe, `1` at subscribe when the subscription is new, `2` never.
    pub retain_handling: i64 = 0
}

/// The SUBSCRIBE packet.
pub struct Subscribe {
    /// The packet identifier.
    pub id: i64
    /// The filters, at least one.
    pub filters: Filter[]
    /// The SUBSCRIBE properties.
    pub properties: Properties = Properties {}
}

/// The SUBACK packet.
pub struct Suback {
    /// The packet identifier of the SUBSCRIBE.
    pub id: i64
    /// One code for each filter in order: the granted QoS `0` to `2`, or a failure of `0x80` and above.
    pub codes: i64[]
    /// The SUBACK properties.
    pub properties: Properties = Properties {}
}

/// The UNSUBSCRIBE packet.
pub struct Unsubscribe {
    /// The packet identifier.
    pub id: i64
    /// The filters to remove, at least one.
    pub filters: str[]
    /// The UNSUBSCRIBE properties.
    pub properties: Properties = Properties {}
}

/// The UNSUBACK packet.
pub struct Unsuback {
    /// The packet identifier of the UNSUBSCRIBE.
    pub id: i64
    /// One code for each filter in order. `0` is success and `0x11` means no such subscription. MQTT 3.1.1 carries none, so the list is empty there.
    pub codes: i64[]
    /// The UNSUBACK properties.
    pub properties: Properties = Properties {}
}

/// The DISCONNECT packet.
pub struct Disconnect {
    /// The MQTT 5 reason code. `0` is a normal disconnection.
    pub code: i64 = 0
    /// The properties of MQTT 5.
    pub properties: Properties = Properties {}
}

/// The AUTH packet of MQTT 5 enhanced authentication.
pub struct Auth {
    /// The reason code: `0x00` success, `0x18` continue authentication or `0x19` re-authenticate.
    pub code: i64 = 0x18
    /// The properties. `auth_method` and `auth_data` carry the exchange.
    pub properties: Properties = Properties {}
}

/// A decoded or to be encoded MQTT control packet.
pub enum Packet {
    /// CONNECT, sent by the client.
    Connect(connect: Connect)
    /// CONNACK, the broker's answer to CONNECT.
    Connack(connack: Connack)
    /// PUBLISH, in either direction.
    Publish(publish: Publish)
    /// PUBACK, the acknowledgement of a QoS 1 PUBLISH.
    Puback(ack: Ack)
    /// PUBREC, the first answer to a QoS 2 PUBLISH.
    Pubrec(ack: Ack)
    /// PUBREL, the release of a QoS 2 message.
    Pubrel(ack: Ack)
    /// PUBCOMP, the last step of a QoS 2 exchange.
    Pubcomp(ack: Ack)
    /// SUBSCRIBE, sent by the client.
    Subscribe(subscribe: Subscribe)
    /// SUBACK, the broker's answer to SUBSCRIBE.
    Suback(suback: Suback)
    /// UNSUBSCRIBE, sent by the client.
    Unsubscribe(unsubscribe: Unsubscribe)
    /// UNSUBACK, the broker's answer to UNSUBSCRIBE.
    Unsuback(unsuback: Unsuback)
    /// PINGREQ, the keep alive probe.
    Pingreq
    /// PINGRESP, the answer to PINGREQ.
    Pingresp
    /// DISCONNECT, in either direction in MQTT 5 and from the client in MQTT 3.1.1.
    Disconnect(disconnect: Disconnect)
    /// AUTH, in either direction in MQTT 5.
    Auth(auth: Auth)
}
