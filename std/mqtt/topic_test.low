import std/testing

struct Match {
    filter: str
    topic: str
    want: bool
}

fn match_name(c: Match) -> str {
    "{c.filter} vs {c.topic}"
}

fn check_match(t: *testing.T, c: Match) {
    t.equal(matches(c.filter, c.topic), c.want)
}

fn test_matches_spec_examples(t: *testing.T) {
    let cases: Match[] = [
        Match { filter: "sport/tennis/player1/#", topic: "sport/tennis/player1", want: true }
        Match { filter: "sport/tennis/player1/#", topic: "sport/tennis/player1/ranking", want: true }
        Match { filter: "sport/tennis/player1/#", topic: "sport/tennis/player1/score/wimbledon", want: true }
        Match { filter: "sport/#", topic: "sport", want: true }
        Match { filter: "#", topic: "sport/tennis", want: true }
        Match { filter: "sport/tennis/+", topic: "sport/tennis/player1", want: true }
        Match { filter: "sport/tennis/+", topic: "sport/tennis/player2", want: true }
        Match { filter: "sport/tennis/+", topic: "sport/tennis/player1/ranking", want: false }
        Match { filter: "sport/+", topic: "sport", want: false }
        Match { filter: "sport/+", topic: "sport/", want: true }
        Match { filter: "+", topic: "finance", want: true }
        Match { filter: "+", topic: "a/b", want: false }
        Match { filter: "+/tennis/#", topic: "sport/tennis/player1", want: true }
        Match { filter: "+/+", topic: "/finance", want: true }
        Match { filter: "/+", topic: "/finance", want: true }
        Match { filter: "/+", topic: "finance", want: false }
        Match { filter: "a/b", topic: "a/b", want: true }
        Match { filter: "a/b", topic: "a/b/c", want: false }
        Match { filter: "a/b/c", topic: "a/b", want: false }
        Match { filter: "a/b", topic: "A/b", want: false }
        Match { filter: "a//b", topic: "a//b", want: true }
        Match { filter: "a/+/b", topic: "a//b", want: true }
        Match { filter: "a/#", topic: "a/", want: true }
    ]
    t.table_of(cases, match_name, check_match)
}

fn test_matches_dollar_topics(t: *testing.T) {
    let cases: Match[] = [
        Match { filter: "#", topic: "$SYS/broker/uptime", want: false }
        Match { filter: "+/broker/uptime", topic: "$SYS/broker/uptime", want: false }
        Match { filter: "+/#", topic: "$SYS/broker", want: false }
        Match { filter: "$SYS/#", topic: "$SYS/broker/uptime", want: true }
        Match { filter: "$SYS/+/uptime", topic: "$SYS/broker/uptime", want: true }
        Match { filter: "$SYS/broker/uptime", topic: "$SYS/broker/uptime", want: true }
        Match { filter: "a/$b", topic: "a/$b", want: true }
        Match { filter: "a/+", topic: "a/$b", want: true }
    ]
    t.table_of(cases, match_name, check_match)
}

fn test_matches_shared(t: *testing.T) {
    let cases: Match[] = [
        Match { filter: "$share/g/a/b", topic: "a/b", want: true }
        Match { filter: "$share/g/a/+", topic: "a/b", want: true }
        Match { filter: "$share/g/#", topic: "a/b", want: true }
        Match { filter: "$share/g/a/b", topic: "a/c", want: false }
        Match { filter: "$share/g/#", topic: "$SYS/x", want: false }
        Match { filter: "$share/g", topic: "g", want: false }
        Match { filter: "$share//a", topic: "a", want: false }
    ]
    t.table_of(cases, match_name, check_match)
}

fn test_matches_invalid_input(t: *testing.T) {
    let cases: Match[] = [
        Match { filter: "", topic: "a", want: false }
        Match { filter: "a", topic: "", want: false }
        Match { filter: "a/#/b", topic: "a/x/b", want: false }
        Match { filter: "a+", topic: "a1", want: false }
        Match { filter: "a/b#", topic: "a/b", want: false }
        Match { filter: "#", topic: "a/+", want: false }
        Match { filter: "#", topic: "a/#", want: false }
        Match { filter: "a", topic: "a\0", want: false }
    ]
    t.table_of(cases, match_name, check_match)
}

fn test_valid_topic_name(t: *testing.T) {
    let good = ["a", "a/b", "/", "//", "/a", "a/", "$SYS/x", "a b", "日本/語", "😀"]
    for s in good {
        t.is_true(valid_topic_name(s))
    }
    let bad = ["", "+", "#", "a/+", "a/#", "a+b", "a#", "a\0", "\xC0\x80", "\xED\xA0\x80"]
    for s in bad {
        t.is_false(valid_topic_name(s))
    }
    t.is_true(valid_topic_name(text_of(65535)))
    t.is_false(valid_topic_name(text_of(65536)))
}

fn test_valid_filter(t: *testing.T) {
    let good = ["a", "#", "+", "a/#", "+/+", "+/a/+", "/", "/#", "//+", "a/+/b", "$SYS/#", "$share/g/a", "$share/g/#", "$share/g/+/b", "$share/g/a/b", "a b/+", "$share"]
    for s in good {
        t.is_true(valid_filter(s))
    }
    let bad = ["", "a#", "a+", "#/a", "a/#/b", "a/b#", "a/+b", "a/b+", "++", "##", "+#", "$share/", "$share/g", "$share/g/", "$share//a", "$share/+/a", "$share/#/a", "$share/g/a#", "a\0b"]
    for s in bad {
        t.is_false(valid_filter(s))
    }
    t.is_false(valid_filter(text_of(65536)))
}
