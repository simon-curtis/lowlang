import std/text
import std/unicode

const max_string = 65535

/// Returns whether `s` can be sent as an MQTT UTF-8 string.
///
/// A string is valid when it is at most 65535 bytes, is well-formed UTF-8 without surrogates and contains no U+0000.
pub fn valid_string(s: str) -> bool {
    if s.len > max_string {
        return false
    }
    if !unicode.utf8_valid(s) {
        return false
    }
    for i in 0..s.len {
        if s[i] == 0 {
            return false
        }
    }
    true
}

fn has_wildcard(s: str) -> bool {
    for i in 0..s.len {
        if s[i] == '+' || s[i] == '#' {
            return true
        }
    }
    false
}

/// Returns whether `topic` is a valid topic name for PUBLISH.
///
/// A topic name is not empty, is a valid MQTT string and has no `+` or `#`.
pub fn valid_topic_name(topic: str) -> bool {
    topic.len > 0 && valid_string(topic) && !has_wildcard(topic)
}

fn valid_levels(filter: str) -> bool {
    let levels = text.split(filter, '/')
    for i, level in levels {
        if level == "#" && i != levels.len - 1 {
            return false
        }
        if level != "#" && level != "+" && has_wildcard(level) {
            return false
        }
    }
    true
}

fn shared_rest(filter: str) -> str? {
    if !text.starts_with(filter, "$share/") {
        return none
    }
    let rest = filter[7..]
    let cut = text.index_byte(rest, '/')
    if cut < 1 {
        return some("")
    }
    let group = rest[..cut]
    if has_wildcard(group) {
        return some("")
    }
    some(rest[cut + 1..])
}

/// Returns whether `filter` is a valid topic filter for SUBSCRIBE.
///
/// A filter is not empty and is a valid MQTT string. `+` must be a whole level and `#` must be a whole level and the last one. A shared subscription `$share/group/filter` has a group of at least one character without `/`, `+` or `#` and a valid filter after it.
pub fn valid_filter(filter: str) -> bool {
    if filter.len == 0 || !valid_string(filter) {
        return false
    }
    match shared_rest(filter) {
        some(rest) => rest.len > 0 && valid_levels(rest)
        none => valid_levels(filter)
    }
}

/// Returns whether the topic name `topic` matches the topic filter `filter`.
///
/// `+` matches exactly one level, including an empty one, and `#` matches the parent level and every level below it, so `sport/#` matches `sport`. A topic that starts with `$` matches no filter whose first level is `+` or `#`. A shared subscription is matched by the filter after `$share/group/`. An invalid filter or topic matches nothing.
pub fn matches(filter: str, topic: str) -> bool {
    if !valid_filter(filter) || !valid_topic_name(topic) {
        return false
    }
    var pattern = filter
    match shared_rest(filter) {
        some(rest) => { pattern = rest }
        none => {}
    }
    let want = text.split(pattern, '/')
    let have = text.split(topic, '/')
    if topic[0] == '$' && (want[0] == "#" || want[0] == "+") {
        return false
    }
    for i, level in want {
        if level == "#" {
            return true
        }
        if i >= have.len {
            return false
        }
        if level != "+" && level != have[i] {
            return false
        }
    }
    want.len == have.len
}
