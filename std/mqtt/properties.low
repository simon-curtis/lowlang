import std/io

const k_connect = 1
const k_connack = 2
const k_publish = 3
const k_puback = 4
const k_pubrec = 5
const k_pubrel = 6
const k_pubcomp = 7
const k_subscribe = 8
const k_suback = 9
const k_unsubscribe = 10
const k_unsuback = 11
const k_disconnect = 14
const k_auth = 15
const k_will = 16

const id_user_property = 0x26
const id_subscription_id = 0x0B

fn bit(kind: i64) -> i64 {
    1 << kind
}

fn acknowledgements() -> i64 {
    bit(k_puback) | bit(k_pubrec) | bit(k_pubrel) | bit(k_pubcomp)
}

fn everything() -> i64 {
    bit(k_connect) | bit(k_connack) | bit(k_publish) | bit(k_will) | bit(k_subscribe) | bit(k_suback) | bit(k_unsubscribe) | bit(k_unsuback) | bit(k_disconnect) | bit(k_auth) | acknowledgements()
}

fn contexts(id: i64) -> i64 {
    match id {
        0x01 => bit(k_publish) | bit(k_will)
        0x02 => bit(k_publish) | bit(k_will)
        0x03 => bit(k_publish) | bit(k_will)
        0x08 => bit(k_publish) | bit(k_will)
        0x09 => bit(k_publish) | bit(k_will)
        0x0B => bit(k_publish) | bit(k_subscribe)
        0x11 => bit(k_connect) | bit(k_connack) | bit(k_disconnect)
        0x12 => bit(k_connack)
        0x13 => bit(k_connack)
        0x15 => bit(k_connect) | bit(k_connack) | bit(k_auth)
        0x16 => bit(k_connect) | bit(k_connack) | bit(k_auth)
        0x17 => bit(k_connect)
        0x18 => bit(k_will)
        0x19 => bit(k_connect)
        0x1A => bit(k_connack)
        0x1C => bit(k_connack) | bit(k_disconnect)
        0x1F => bit(k_connack) | acknowledgements() | bit(k_suback) | bit(k_unsuback) | bit(k_disconnect) | bit(k_auth)
        0x21 => bit(k_connect) | bit(k_connack)
        0x22 => bit(k_connect) | bit(k_connack)
        0x23 => bit(k_publish)
        0x24 => bit(k_connack)
        0x25 => bit(k_connack)
        0x26 => everything()
        0x27 => bit(k_connect) | bit(k_connack)
        0x28 => bit(k_connack)
        0x29 => bit(k_connack)
        0x2A => bit(k_connack)
        _ => 0
    }
}

struct Cursor {
    data: u8[]
    at: i64
    end: i64
}

fn cursor(data: u8[]) -> *Cursor {
    new(Cursor { data, at: 0, end: data.len })
}

fn left(c: *Cursor) -> i64 {
    c.end - c.at
}

fn take(c: *Cursor, n: i64) -> u8[] ! Error {
    if n < 0 || n > left(c) {
        fail Malformed
    }
    let part = c.data[c.at..c.at + n]
    c.at += n
    part
}

fn take_u8(c: *Cursor) -> i64 ! Error {
    if left(c) < 1 {
        fail Malformed
    }
    let b = c.data[c.at]
    c.at += 1
    i64(b)
}

fn take_u16(c: *Cursor) -> i64 ! Error {
    let part = take(c, 2)?
    io.be16(part, 0)
}

fn take_u32(c: *Cursor) -> i64 ! Error {
    let part = take(c, 4)?
    io.be32(part, 0)
}

fn take_flag(c: *Cursor) -> bool ! Error {
    let b = take_u8(c)?
    if b > 1 {
        fail Malformed
    }
    b == 1
}

fn take_variable(c: *Cursor) -> i64 ! Error {
    let v = read_variable(c.data[..c.end], c.at)?
    c.at += v.size
    v.value
}

fn take_string(c: *Cursor) -> str ! Error {
    let n = take_u16(c)?
    let part = take(c, n)?
    let s = str(part)
    if !valid_string(s) {
        fail Malformed
    }
    s
}

fn take_binary(c: *Cursor) -> u8[] ! Error {
    let n = take_u16(c)?
    take(c, n)?
}

fn take_ranged(c: *Cursor, size: i64, min: i64) -> i64 ! Error {
    let v = match size {
        1 => take_u8(c)?
        2 => take_u16(c)?
        _ => take_u32(c)?
    }
    if v < min {
        fail Malformed
    }
    v
}

fn read_property(c: *Cursor, id: i64, mut p: Properties) ! Error {
    match id {
        0x01 => {
            let v = take_ranged(c, 1, 0)?
            if v > 1 {
                fail Malformed
            }
            p.payload_format = v
        }
        0x02 => { p.message_expiry = take_ranged(c, 4, 0)? }
        0x03 => { p.content_type = take_string(c)? }
        0x08 => { p.response_topic = take_string(c)? }
        0x09 => { p.correlation_data = take_binary(c)? }
        0x0B => {
            let v = take_variable(c)?
            if v < 1 {
                fail Malformed
            }
            p.subscription_ids.push(v)
        }
        0x11 => { p.session_expiry = take_ranged(c, 4, 0)? }
        0x12 => { p.assigned_client_id = take_string(c)? }
        0x13 => { p.server_keep_alive = take_ranged(c, 2, 0)? }
        0x15 => { p.auth_method = take_string(c)? }
        0x16 => { p.auth_data = take_binary(c)? }
        0x17 => { p.request_problem_information = take_flag(c)? }
        0x18 => { p.will_delay = take_ranged(c, 4, 0)? }
        0x19 => { p.request_response_information = take_flag(c)? }
        0x1A => { p.response_information = take_string(c)? }
        0x1C => { p.server_reference = take_string(c)? }
        0x1F => { p.reason_string = take_string(c)? }
        0x21 => { p.receive_maximum = take_ranged(c, 2, 1)? }
        0x22 => { p.topic_alias_maximum = take_ranged(c, 2, 0)? }
        0x23 => { p.topic_alias = take_ranged(c, 2, 1)? }
        0x24 => {
            let v = take_ranged(c, 1, 0)?
            if v > 1 {
                fail Malformed
            }
            p.maximum_qos = v
        }
        0x25 => { p.retain_available = take_flag(c)? }
        0x26 => {
            let name = take_string(c)?
            let value = take_string(c)?
            p.user_properties.push(UserProperty { name, value })
        }
        0x27 => { p.maximum_packet_size = take_ranged(c, 4, 1)? }
        0x28 => { p.wildcard_subscription_available = take_flag(c)? }
        0x29 => { p.subscription_identifiers_available = take_flag(c)? }
        0x2A => { p.shared_subscription_available = take_flag(c)? }
        _ => fail Malformed
    }
}

fn read_properties(c: *Cursor, kind: i64) -> Properties ! Error {
    let length = take_variable(c)?
    if length > left(c) {
        fail Malformed
    }
    let section = new(Cursor { data: c.data, at: c.at, end: c.at + length })
    c.at += length
    var p = Properties {}
    var seen = 0
    for left(section) > 0 {
        let id = take_variable(section)?
        if (contexts(id) >> kind) & 1 == 0 {
            fail Malformed
        }
        let repeatable = id == id_user_property || (id == id_subscription_id && kind == k_publish)
        if !repeatable {
            if (seen >> id) & 1 == 1 {
                fail Malformed
            }
            seen = seen | (1 << id)
        }
        read_property(section, id, mut p)?
    }
    p
}

fn permit(kind: i64, id: i64) ! Error {
    if (contexts(id) >> kind) & 1 == 0 {
        fail Protocol
    }
}

fn emit_number(mut out: u8[], kind: i64, id: i64, size: i64, min: i64, v: i64?) ! Error {
    match v {
        some(n) => {
            permit(kind, id)?
            if n < min || n >= (1 << (8 * size)) {
                fail Invalid
            }
            out.push(u8(id))
            io.put_be(mut out, n, size)
        }
        none => {}
    }
}

fn emit_flag(mut out: u8[], kind: i64, id: i64, v: bool?) ! Error {
    match v {
        some(on) => {
            permit(kind, id)?
            out.push(u8(id))
            out.push(if on { 1 } else { 0 })
        }
        none => {}
    }
}

fn emit_text(mut out: u8[], kind: i64, id: i64, v: str?) ! Error {
    match v {
        some(s) => {
            permit(kind, id)?
            out.push(u8(id))
            put_string(mut out, s)?
        }
        none => {}
    }
}

fn emit_bytes(mut out: u8[], kind: i64, id: i64, v: u8[]?) ! Error {
    match v {
        some(b) => {
            permit(kind, id)?
            out.push(u8(id))
            put_binary(mut out, b)?
        }
        none => {}
    }
}

fn property_bytes(p: Properties, kind: i64) -> u8[] ! Error {
    var b: u8[] = []
    emit_number(mut b, kind, 0x01, 1, 0, p.payload_format)?
    emit_number(mut b, kind, 0x02, 4, 0, p.message_expiry)?
    emit_text(mut b, kind, 0x03, p.content_type)?
    emit_text(mut b, kind, 0x08, p.response_topic)?
    emit_bytes(mut b, kind, 0x09, p.correlation_data)?
    if p.subscription_ids.len > 1 && kind != k_publish {
        fail Protocol
    }
    for id in p.subscription_ids {
        permit(kind, id_subscription_id)?
        if id < 1 {
            fail Invalid
        }
        b.push(u8(id_subscription_id))
        put_variable(mut b, id)?
    }
    emit_number(mut b, kind, 0x11, 4, 0, p.session_expiry)?
    emit_text(mut b, kind, 0x12, p.assigned_client_id)?
    emit_number(mut b, kind, 0x13, 2, 0, p.server_keep_alive)?
    emit_text(mut b, kind, 0x15, p.auth_method)?
    emit_bytes(mut b, kind, 0x16, p.auth_data)?
    emit_flag(mut b, kind, 0x17, p.request_problem_information)?
    emit_number(mut b, kind, 0x18, 4, 0, p.will_delay)?
    emit_flag(mut b, kind, 0x19, p.request_response_information)?
    emit_text(mut b, kind, 0x1A, p.response_information)?
    emit_text(mut b, kind, 0x1C, p.server_reference)?
    emit_text(mut b, kind, 0x1F, p.reason_string)?
    emit_number(mut b, kind, 0x21, 2, 1, p.receive_maximum)?
    emit_number(mut b, kind, 0x22, 2, 0, p.topic_alias_maximum)?
    emit_number(mut b, kind, 0x23, 2, 1, p.topic_alias)?
    emit_number(mut b, kind, 0x24, 1, 0, p.maximum_qos)?
    emit_flag(mut b, kind, 0x25, p.retain_available)?
    for u in p.user_properties {
        permit(kind, id_user_property)?
        b.push(u8(id_user_property))
        put_string(mut b, u.name)?
        put_string(mut b, u.value)?
    }
    emit_number(mut b, kind, 0x27, 4, 1, p.maximum_packet_size)?
    emit_flag(mut b, kind, 0x28, p.wildcard_subscription_available)?
    emit_flag(mut b, kind, 0x29, p.subscription_identifiers_available)?
    emit_flag(mut b, kind, 0x2A, p.shared_subscription_available)?
    b
}

fn put_properties(mut out: u8[], p: Properties, kind: i64) ! Error {
    let body = property_bytes(p, kind)?
    put_variable(mut out, body.len)?
    io.append(mut out, body)
}
