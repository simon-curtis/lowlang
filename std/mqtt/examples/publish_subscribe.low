import std/io
import std/mqtt
import std/net

fn send(stream: io.Stream, packet: mqtt.Packet) {
    let data = mqtt.encode(packet, mqtt.Version.V5) or return
    io.write_all(stream, data) or {}
}

fn serve_connection(stream: io.Stream) {
    let r = io.reader(stream)
    var filter = ""
    for {
        let packet = mqtt.read_packet(r, mqtt.Version.V5, 0) or return
        match packet {
            Connect(c) => send(stream, mqtt.Packet.Connack(mqtt.Connack {}))
            Subscribe(s) => {
                filter = s.filters[0].filter
                send(stream, mqtt.Packet.Suback(mqtt.Suback { id: s.id, codes: [1] }))
            }
            Publish(p) => {
                send(stream, mqtt.Packet.Puback(mqtt.Ack { id: p.id }))
                if mqtt.matches(filter, p.topic) {
                    send(stream, mqtt.Packet.Publish(mqtt.Publish { topic: p.topic, payload: p.payload, qos: 1, id: 1 }))
                }
            }
            Disconnect(d) => return
            _ => {}
        }
    }
}

fn serve(l: net.ListenerHandle) {
    let h = net.accept_handle(l) or return
    using c = net.adopt(h)
    serve_connection(net.stream(c))
}

/// Subscribes to a topic filter on a stub broker on loopback, publishes at QoS 1 and prints the message the broker delivers back.
fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    spawn serve(l.handle)

    using c = mqtt.connect(mqtt.Options { port: l.handle.addr.port, client_id: "example" }) catch {
        e => panic("connect failed: {e}")
    }
    let granted = mqtt.subscribe(c, [mqtt.Filter { filter: "sensors/+/temperature", qos: 1 }]) catch {
        e => panic("subscribe failed: {e}")
    }
    print("granted {granted.codes[0]}")

    let options = mqtt.PublishOptions { qos: 1 }
    let receipt = mqtt.publish(c, "sensors/kitchen/temperature", bytes("21.5"), options) catch {
        e => panic("publish failed: {e}")
    }
    print("acknowledged with code {receipt.code}")

    let m = (<-c.messages) ?? panic("connection closed")
    print("{m.topic}: {str(m.payload)} at qos {m.qos}")
    net.close_listener(l)
}
