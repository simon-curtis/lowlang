import std/io
import std/text
import std/testing

fn nibble(c: u8) -> i64 {
    if c >= '0' && c <= '9' {
        return i64(c) - 48
    }
    if c >= 'A' && c <= 'F' {
        return i64(c) - 55
    }
    i64(c) - 87
}

fn hex(s: str) -> u8[] {
    var out: u8[] = []
    var i = 0
    for i < s.len {
        if s[i] == ' ' {
            i += 1
            continue
        }
        out.push(u8(nibble(s[i]) * 16 + nibble(s[i + 1])))
        i += 2
    }
    out
}

fn label(e: Error) -> str {
    match e {
        Malformed => "Malformed"
        Closed => "Closed"
        TooLarge => "TooLarge"
        Unsupported => "Unsupported"
        Protocol => "Protocol"
        Invalid => "Invalid"
        InvalidTopic => "InvalidTopic"
        InvalidString => "InvalidString"
        _ => "other"
    }
}

fn outcome(data: u8[], v: Version) -> str {
    decode(data, v) catch {
        e => return label(e)
    }
    "ok"
}

fn limited(data: u8[], v: Version, limit: i64) -> str {
    let r = io.bytes_reader(data)
    read_packet(r, v, limit) catch {
        e => return label(e)
    }
    "ok"
}

fn put_outcome(n: i64) -> str {
    var out: u8[] = []
    put_variable(mut out, n) catch {
        e => return label(e)
    }
    "ok"
}

fn read_outcome(h: str) -> str {
    read_variable(hex(h), 0) catch {
        e => return label(e)
    }
    "ok"
}

fn encoded(t: *testing.T, p: Packet, v: Version) -> u8[] {
    let empty: u8[] = []
    encode(p, v) catch {
        e => testing.must(t, e, empty)
    }
}

fn decoded(t: *testing.T, data: u8[], v: Version) -> Packet {
    decode(data, v) catch {
        e => testing.must(t, e, Packet.Pingreq)
    }
}

fn refused(p: Packet, v: Version) -> str {
    encode(p, v) catch {
        e => return label(e)
    }
    "ok"
}

fn test_variable_boundaries(t: *testing.T) {
    let cases: [i64: str] = [
        0: "00", 1: "01", 127: "7F", 128: "80 01", 16383: "FF 7F", 16384: "80 80 01", 2097151: "FF FF 7F",
        2097152: "80 80 80 01", 268435455: "FF FF FF 7F",
    ]
    for n, h in cases {
        var out: u8[] = []
        put_variable(mut out, n) catch {
            e => t.fatal(label(e))
        }
        t.equal_slice(out, hex(h))
        let back = read_variable(hex(h), 0) catch {
            e => testing.must(t, e, Varint { value: 0, size: 0 })
        }
        t.equal(back.value, n)
        t.equal(back.size, hex(h).len)
    }
}

fn test_variable_at_offset(t: *testing.T) {
    let back = read_variable(hex("AA BB 80 01 CC"), 2) catch {
        e => testing.must(t, e, Varint { value: 0, size: 0 })
    }
    t.equal(back.value, 128)
    t.equal(back.size, 2)
}

fn test_variable_out_of_range(t: *testing.T) {
    t.equal(put_outcome(268435456), "TooLarge")
    t.equal(put_outcome(-1), "TooLarge")
    t.equal(put_outcome(268435455), "ok")
}

fn test_variable_malformed(t: *testing.T) {
    let cases = ["", "80", "FF FF", "80 80 80", "80 80 80 80 01", "FF FF FF FF 7F", "80 00", "80 80 00", "FF FF FF 80"]
    for h in cases {
        t.equal(read_outcome(h), "Malformed")
    }
}

fn test_packet_length_malformed(t: *testing.T) {
    t.equal(outcome(hex("30 80 00"), Version.V311), "Malformed")
    t.equal(outcome(hex("30 80"), Version.V311), "Malformed")
    t.equal(outcome(hex("30 FF FF FF FF 01"), Version.V311), "Malformed")
    t.equal(outcome(hex("30 05 00 01 61"), Version.V311), "Malformed")
    t.equal(outcome(hex(""), Version.V311), "Malformed")
}

fn test_packet_limit(t: *testing.T) {
    t.equal(limited(hex("30 07 00 03 61 2F 62 68 69"), Version.V311, 8), "TooLarge")
    t.equal(limited(hex("30 07 00 03 61 2F 62 68 69"), Version.V311, 9), "ok")
    t.equal(limited(hex("30 07 00 03 61 2F 62"), Version.V311, 100), "Closed")
    t.equal(limited(hex(""), Version.V311, 100), "Closed")
    let exact = io.bytes_reader(hex("30 07 00 03 61 2F 62 68 69"))
    let fits = read_packet(exact, Version.V311, 9) catch {
        e => testing.must(t, e, Packet.Pingreq)
    }
    match fits {
        Publish(m) => {
            t.equal(m.topic, "a/b")
            t.equal_slice(m.payload, bytes("hi"))
        }
        _ => t.error("not a PUBLISH")
    }
}

fn test_known_connect_311(t: *testing.T) {
    let p = Packet.Connect(Connect { version: Version.V311, client_id: "c", keep_alive: 60 })
    t.equal_slice(encoded(t, p, Version.V311), hex("10 0D 00 04 4D 51 54 54 04 02 00 3C 00 01 63"))
}

fn test_known_connect_v5(t: *testing.T) {
    let p = Packet.Connect(Connect { client_id: "c", keep_alive: 60 })
    t.equal_slice(encoded(t, p, Version.V5), hex("10 0E 00 04 4D 51 54 54 05 02 00 3C 00 00 01 63"))
    let props = Properties { session_expiry: 3600 }
    let q = Packet.Connect(Connect { client_id: "c", keep_alive: 60, properties: props })
    t.equal_slice(encoded(t, q, Version.V5), hex("10 13 00 04 4D 51 54 54 05 02 00 3C 05 11 00 00 0E 10 00 01 63"))
}

fn test_known_connect_with_will_311(t: *testing.T) {
    let will = Will { topic: "w", payload: bytes("x"), qos: 1, retain: true }
    let p = Packet.Connect(Connect {
        version: Version.V311
        client_id: "c"
        keep_alive: 60
        username: "u"
        password: bytes("p")
        will
    })
    let want = hex("10 19 00 04 4D 51 54 54 04 EE 00 3C 00 01 63 00 01 77 00 01 78 00 01 75 00 01 70")
    t.equal_slice(encoded(t, p, Version.V311), want)
    match decoded(t, want, Version.V311) {
        Connect(c) => {
            t.equal(c.client_id, "c")
            t.equal(c.username, "u")
            let pw: u8[] = c.password ?? []
            t.equal_slice(pw, bytes("p"))
            let w = c.will ?? Will { topic: "" }
            t.equal(w.topic, "w")
            t.equal(w.qos, 1)
            t.equal(w.retain, true)
            t.equal(c.clean_start, true)
            t.equal(c.keep_alive, 60)
        }
        _ => t.error("not a CONNECT")
    }
}

fn test_known_publish(t: *testing.T) {
    let p = Packet.Publish(Publish { topic: "a/b", payload: bytes("hi") })
    t.equal_slice(encoded(t, p, Version.V311), hex("30 07 00 03 61 2F 62 68 69"))
    let q = Packet.Publish(Publish { topic: "a/b", payload: bytes("x"), qos: 1, id: 10, retain: true, dup: true })
    t.equal_slice(encoded(t, q, Version.V311), hex("3B 08 00 03 61 2F 62 00 0A 78"))
    let aliased = Properties { topic_alias: 3 }
    let r = Packet.Publish(Publish { topic: "a", payload: bytes("x"), properties: aliased })
    t.equal_slice(encoded(t, r, Version.V5), hex("30 08 00 01 61 03 23 00 03 78"))
    let again = Packet.Publish(Publish { topic: "", payload: bytes("x"), properties: aliased })
    t.equal_slice(encoded(t, again, Version.V5), hex("30 07 00 00 03 23 00 03 78"))
}

fn test_known_small_packets(t: *testing.T) {
    t.equal_slice(encoded(t, Packet.Pingreq, Version.V311), hex("C0 00"))
    t.equal_slice(encoded(t, Packet.Pingresp, Version.V5), hex("D0 00"))
    t.equal_slice(encoded(t, Packet.Disconnect(Disconnect {}), Version.V311), hex("E0 00"))
    t.equal_slice(encoded(t, Packet.Disconnect(Disconnect {}), Version.V5), hex("E0 00"))
    t.equal_slice(encoded(t, Packet.Disconnect(Disconnect { code: 0x8B }), Version.V5), hex("E0 02 8B 00"))
    t.equal_slice(encoded(t, Packet.Connack(Connack { session_present: true }), Version.V311), hex("20 02 01 00"))
    t.equal_slice(encoded(t, Packet.Connack(Connack { code: 5 }), Version.V311), hex("20 02 00 05"))
    t.equal_slice(encoded(t, Packet.Connack(Connack {}), Version.V5), hex("20 03 00 00 00"))
    t.equal_slice(encoded(t, Packet.Puback(Ack { id: 10 }), Version.V311), hex("40 02 00 0A"))
    t.equal_slice(encoded(t, Packet.Puback(Ack { id: 10, code: 0x10 }), Version.V311), hex("40 02 00 0A"))
    t.equal_slice(encoded(t, Packet.Puback(Ack { id: 10 }), Version.V5), hex("40 02 00 0A"))
    t.equal_slice(encoded(t, Packet.Puback(Ack { id: 10, code: 0x10 }), Version.V5), hex("40 03 00 0A 10"))
    t.equal_slice(encoded(t, Packet.Pubrec(Ack { id: 10 }), Version.V311), hex("50 02 00 0A"))
    t.equal_slice(encoded(t, Packet.Pubrel(Ack { id: 10 }), Version.V311), hex("62 02 00 0A"))
    t.equal_slice(encoded(t, Packet.Pubcomp(Ack { id: 10 }), Version.V311), hex("70 02 00 0A"))
    t.equal_slice(encoded(t, Packet.Auth(Auth { code: 0 }), Version.V5), hex("F0 00"))
    t.equal_slice(encoded(t, Packet.Auth(Auth {}), Version.V5), hex("F0 02 18 00"))
}

fn test_known_subscriptions(t: *testing.T) {
    let sub = Packet.Subscribe(Subscribe { id: 10, filters: [Filter { filter: "a/b", qos: 1 }] })
    t.equal_slice(encoded(t, sub, Version.V311), hex("82 08 00 0A 00 03 61 2F 62 01"))
    let options = Filter { filter: "a/b", qos: 2, no_local: true, retain_as_published: true, retain_handling: 2 }
    let rich = Packet.Subscribe(Subscribe { id: 10, filters: [options] })
    t.equal_slice(encoded(t, rich, Version.V5), hex("82 09 00 0A 00 00 03 61 2F 62 2E"))
    t.equal_slice(encoded(t, Packet.Suback(Suback { id: 10, codes: [1, 0x80] }), Version.V311), hex("90 04 00 0A 01 80"))
    t.equal_slice(encoded(t, Packet.Suback(Suback { id: 10, codes: [2] }), Version.V5), hex("90 04 00 0A 00 02"))
    t.equal_slice(encoded(t, Packet.Unsubscribe(Unsubscribe { id: 10, filters: ["a/b"] }), Version.V311), hex("A2 07 00 0A 00 03 61 2F 62"))
    t.equal_slice(encoded(t, Packet.Unsuback(Unsuback { id: 10, codes: [] }), Version.V311), hex("B0 02 00 0A"))
    t.equal_slice(encoded(t, Packet.Unsuback(Unsuback { id: 10, codes: [0, 0x11] }), Version.V5), hex("B0 05 00 0A 00 00 11"))
}

fn test_known_bytes_decode(t: *testing.T) {
    t.equal(outcome(hex("C0 00"), Version.V311), "ok")
    t.equal(outcome(hex("D0 00"), Version.V5), "ok")
    t.equal(outcome(hex("40 02 00 0A"), Version.V5), "ok")
    let p = decoded(t, hex("40 03 00 0A 10"), Version.V5)
    match p {
        Puback(a) => {
            t.equal(a.id, 10)
            t.equal(a.code, 0x10)
        }
        _ => t.error("not a PUBACK")
    }
    let long = decoded(t, hex("40 07 00 0A 10 03 1F 00 00"), Version.V5)
    match long {
        Puback(a) => t.equal(a.code, 0x10)
        _ => t.error("not a PUBACK")
    }
}

fn sample_properties() -> Properties {
    Properties {
        payload_format: 1
        message_expiry: 120
        content_type: "text/plain"
        response_topic: "reply/to"
        correlation_data: bytes("corr")
        subscription_ids: [7, 300]
        topic_alias: 5
        user_properties: [UserProperty { name: "k", value: "v" }, UserProperty { name: "k", value: "w" }]
    }
}

fn all_connack_properties() -> Properties {
    Properties {
        session_expiry: 60
        assigned_client_id: "auto-1"
        server_keep_alive: 30
        auth_method: "m"
        auth_data: bytes("d")
        response_information: "info"
        server_reference: "other:1883"
        reason_string: "fine"
        receive_maximum: 20
        topic_alias_maximum: 8
        maximum_qos: 1
        retain_available: false
        user_properties: [UserProperty { name: "a", value: "b" }]
        maximum_packet_size: 4096
        wildcard_subscription_available: true
        subscription_identifiers_available: false
        shared_subscription_available: true
    }
}

fn round_trips(t: *testing.T, p: Packet, v: Version) {
    let first = encoded(t, p, v)
    let back = decoded(t, first, v)
    let second = encoded(t, back, v)
    t.equal_slice(second, first)
}

fn test_round_trip_every_packet_v5(t: *testing.T) {
    let v = Version.V5
    let will = Will {
        topic: "w/t"
        payload: bytes("gone")
        qos: 2
        retain: true
        properties: Properties { will_delay: 5, payload_format: 0, message_expiry: 9, content_type: "c", response_topic: "r", correlation_data: bytes("z"), user_properties: [UserProperty { name: "n", value: "v" }] }
    }
    let connect_properties = Properties {
        session_expiry: 3600
        receive_maximum: 10
        maximum_packet_size: 65536
        topic_alias_maximum: 4
        request_response_information: true
        request_problem_information: false
        auth_method: "SCRAM"
        auth_data: bytes("first")
        user_properties: [UserProperty { name: "a", value: "b" }]
    }
    let connect = Connect { client_id: "client", clean_start: false, keep_alive: 15, username: "u", password: bytes("p"), will, properties: connect_properties }
    let packets: Packet[] = [
        Packet.Connect(connect)
        Packet.Connack(Connack { session_present: true, code: 0, properties: all_connack_properties() })
        Packet.Connack(Connack { code: 0x87, properties: Properties { reason_string: "no" } })
        Packet.Publish(Publish { topic: "a/b", payload: bytes("body"), qos: 0, retain: true, properties: sample_properties() })
        Packet.Publish(Publish { topic: "a/b", payload: [], qos: 1, id: 1, dup: true })
        Packet.Publish(Publish { topic: "", payload: bytes("x"), qos: 2, id: 65535, properties: Properties { topic_alias: 2 } })
        Packet.Puback(Ack { id: 3, code: 0x10, properties: Properties { reason_string: "none", user_properties: [UserProperty { name: "a", value: "b" }] } })
        Packet.Puback(Ack { id: 3 })
        Packet.Pubrec(Ack { id: 4, code: 0x97 })
        Packet.Pubrel(Ack { id: 4, code: 0x92 })
        Packet.Pubcomp(Ack { id: 4 })
        Packet.Subscribe(Subscribe { id: 2, filters: [Filter { filter: "a/+", qos: 1, no_local: true }, Filter { filter: "$share/g/b/#", qos: 2, retain_as_published: true, retain_handling: 1 }], properties: Properties { subscription_ids: [42] } })
        Packet.Suback(Suback { id: 2, codes: [1, 2, 0x8F, 0x9E], properties: Properties { reason_string: "x" } })
        Packet.Unsubscribe(Unsubscribe { id: 5, filters: ["a/+", "b"], properties: Properties { user_properties: [UserProperty { name: "a", value: "b" }] } })
        Packet.Unsuback(Unsuback { id: 5, codes: [0, 0x11] })
        Packet.Pingreq
        Packet.Pingresp
        Packet.Disconnect(Disconnect {})
        Packet.Disconnect(Disconnect { code: 0x04 })
        Packet.Disconnect(Disconnect { code: 0x8B, properties: Properties { session_expiry: 0, reason_string: "bye", server_reference: "next:1883" } })
        Packet.Auth(Auth {})
        Packet.Auth(Auth { code: 0, properties: Properties { auth_method: "SCRAM", auth_data: bytes("fin") } })
        Packet.Auth(Auth { code: 0x19, properties: Properties { auth_method: "SCRAM", reason_string: "again" } })
    ]
    for p in packets {
        round_trips(t, p, v)
    }
}

fn test_round_trip_every_packet_311(t: *testing.T) {
    let v = Version.V311
    let will = Will { topic: "w/t", payload: bytes("gone"), qos: 1, retain: false }
    let packets: Packet[] = [
        Packet.Connect(Connect { version: v, client_id: "client", clean_start: false, keep_alive: 15, username: "u", password: bytes("p"), will })
        Packet.Connect(Connect { version: v, client_id: "", keep_alive: 0 })
        Packet.Connect(Connect { version: v, client_id: "u-only", username: "user" })
        Packet.Connack(Connack { session_present: true, code: 0 })
        Packet.Connack(Connack { code: 4 })
        Packet.Publish(Publish { topic: "a/b", payload: bytes("body"), qos: 0, retain: true })
        Packet.Publish(Publish { topic: "a/b", payload: [], qos: 1, id: 1, dup: true })
        Packet.Publish(Publish { topic: "t", payload: bytes("x"), qos: 2, id: 65535 })
        Packet.Puback(Ack { id: 3 })
        Packet.Pubrec(Ack { id: 4 })
        Packet.Pubrel(Ack { id: 4 })
        Packet.Pubcomp(Ack { id: 4 })
        Packet.Subscribe(Subscribe { id: 2, filters: [Filter { filter: "a/+", qos: 1 }, Filter { filter: "b/#", qos: 2 }] })
        Packet.Suback(Suback { id: 2, codes: [0, 1, 2, 0x80] })
        Packet.Unsubscribe(Unsubscribe { id: 5, filters: ["a/+", "b"] })
        Packet.Unsuback(Unsuback { id: 5, codes: [] })
        Packet.Pingreq
        Packet.Pingresp
        Packet.Disconnect(Disconnect {})
    ]
    for p in packets {
        round_trips(t, p, v)
    }
}

fn test_round_trip_drops_5_only_fields_in_311(t: *testing.T) {
    let rich = Packet.Puback(Ack { id: 8, code: 0x10, properties: Properties { reason_string: "x" } })
    let back = decoded(t, encoded(t, rich, Version.V311), Version.V311)
    match back {
        Puback(a) => {
            t.equal(a.id, 8)
            t.equal(a.code, 0)
            t.equal(a.properties.reason_string, none)
        }
        _ => t.error("not a PUBACK")
    }
    let ids = Packet.Publish(Publish { topic: "a", qos: 0, properties: sample_properties() })
    let plain = decoded(t, encoded(t, ids, Version.V311), Version.V311)
    match plain {
        Publish(m) => t.equal(m.properties.subscription_ids.len, 0)
        _ => t.error("not a PUBLISH")
    }
}

fn test_encode_rejects(t: *testing.T) {
    t.equal(refused(Packet.Publish(Publish { topic: "", payload: [] }), Version.V311), "InvalidTopic")
    t.equal(refused(Packet.Publish(Publish { topic: "", payload: [] }), Version.V5), "InvalidTopic")
    t.equal(refused(Packet.Publish(Publish { topic: "a/+", payload: [] }), Version.V5), "InvalidTopic")
    t.equal(refused(Packet.Publish(Publish { topic: "a", qos: 3, id: 1 }), Version.V5), "Invalid")
    t.equal(refused(Packet.Publish(Publish { topic: "a", qos: 1, id: 0 }), Version.V5), "Invalid")
    t.equal(refused(Packet.Publish(Publish { topic: "a", qos: 1, id: 65536 }), Version.V5), "Invalid")
    t.equal(refused(Packet.Publish(Publish { topic: "a", qos: 0, dup: true }), Version.V5), "Invalid")
    t.equal(refused(Packet.Subscribe(Subscribe { id: 1, filters: [] }), Version.V5), "Invalid")
    t.equal(refused(Packet.Subscribe(Subscribe { id: 1, filters: [Filter { filter: "a#" }] }), Version.V5), "InvalidTopic")
    t.equal(refused(Packet.Subscribe(Subscribe { id: 1, filters: [Filter { filter: "a", qos: 3 }] }), Version.V5), "Invalid")
    t.equal(refused(Packet.Subscribe(Subscribe { id: 1, filters: [Filter { filter: "a", retain_handling: 3 }] }), Version.V5), "Invalid")
    t.equal(refused(Packet.Subscribe(Subscribe { id: 1, filters: [Filter { filter: "$share/g/a", no_local: true }] }), Version.V5), "Invalid")
    t.equal(refused(Packet.Subscribe(Subscribe { id: 1, filters: [Filter { filter: "$share/g/a" }] }), Version.V5), "ok")
    t.equal(refused(Packet.Subscribe(Subscribe { id: 1, filters: [Filter { filter: "a", no_local: true }] }), Version.V5), "ok")
    let twice = Properties { subscription_ids: [1, 2] }
    t.equal(refused(Packet.Subscribe(Subscribe { id: 1, filters: [Filter { filter: "a" }], properties: twice }), Version.V5), "Protocol")
    t.equal(refused(Packet.Publish(Publish { topic: "a", properties: twice }), Version.V5), "ok")
    t.equal(refused(Packet.Unsubscribe(Unsubscribe { id: 1, filters: [] }), Version.V5), "Invalid")
    t.equal(refused(Packet.Auth(Auth {}), Version.V311), "Unsupported")
    t.equal(refused(Packet.Puback(Ack { id: 0 }), Version.V5), "Invalid")
    t.equal(refused(Packet.Connect(Connect { client_id: "a\0b" }), Version.V5), "InvalidString")
    t.equal(refused(Packet.Connect(Connect { keep_alive: 65536 }), Version.V5), "Invalid")
    t.equal(refused(Packet.Connect(Connect { version: Version.V311, password: bytes("p") }), Version.V311), "Invalid")
    t.equal(refused(Packet.Connect(Connect { will: Will { topic: "w", qos: 3 } }), Version.V5), "Invalid")
    t.equal(refused(Packet.Connect(Connect { will: Will { topic: "w/#" } }), Version.V5), "InvalidTopic")
    t.equal(refused(Packet.Connect(Connect { will: Will { topic: "w", payload: bytes(text_of(65536)) } }), Version.V5), "TooLarge")
}

fn test_flags_and_shapes_malformed(t: *testing.T) {
    let v = Version.V5
    t.equal(outcome(hex("36 05 00 01 61 00 01"), v), "Malformed")
    t.equal(outcome(hex("3C 04 00 01 61 78"), v), "Malformed")
    t.equal(outcome(hex("60 02 00 01"), v), "Malformed")
    t.equal(outcome(hex("62 02 00 00"), v), "Malformed")
    t.equal(outcome(hex("80 06 00 01 00 01 61 00"), v), "Malformed")
    t.equal(outcome(hex("82 02 00 01"), v), "Malformed")
    t.equal(outcome(hex("82 03 00 01 00"), v), "Malformed")
    t.equal(outcome(hex("A2 03 00 01 00"), v), "Malformed")
    t.equal(outcome(hex("A0 04 00 01 00 00"), v), "Malformed")
    t.equal(outcome(hex("00 00"), v), "Malformed")
    t.equal(outcome(hex("C1 00"), v), "Malformed")
    t.equal(outcome(hex("C0 01 00"), v), "Malformed")
    t.equal(outcome(hex("D0 01 00"), v), "Malformed")
    t.equal(outcome(hex("20 03 02 00 00"), v), "Malformed")
    t.equal(outcome(hex("40 02 00 00"), v), "Malformed")
    t.equal(outcome(hex("40 02 00"), v), "Malformed")
    t.equal(outcome(hex("40 03 00 0A 10 00 00"), v), "Malformed")
    t.equal(outcome(hex("C0 00 00"), v), "Malformed")
    t.equal(outcome(hex("F0 00"), Version.V311), "Malformed")
    t.equal(outcome(hex("E0 01 00"), Version.V311), "Malformed")
}

fn test_subscription_identifier_repeats(t: *testing.T) {
    t.equal(outcome(hex("82 0B 00 01 04 0B 01 0B 02 00 01 61 00"), Version.V5), "Malformed")
    t.equal(outcome(hex("82 09 00 01 02 0B 01 00 01 61 00"), Version.V5), "ok")
    t.equal(outcome(hex("30 09 00 01 61 04 0B 01 0B 02 78"), Version.V5), "ok")
}

fn test_connack_from_a_311_broker(t: *testing.T) {
    t.equal(outcome(hex("20 02 00 01"), Version.V5), "Unsupported")
    t.equal(outcome(hex("20 02 00 01"), Version.V311), "ok")
    t.equal(outcome(hex("20 02 00 02"), Version.V5), "Malformed")
    t.equal(outcome(hex("20 02 00 00"), Version.V5), "Malformed")
    t.equal(limited(hex("20 02 00 01"), Version.V5, 0), "Unsupported")
}

fn test_filter_options_malformed(t: *testing.T) {
    t.equal(outcome(hex("82 09 00 01 00 00 03 61 2F 62 03"), Version.V5), "Malformed")
    t.equal(outcome(hex("82 09 00 01 00 00 03 61 2F 62 30"), Version.V5), "Malformed")
    t.equal(outcome(hex("82 09 00 01 00 00 03 61 2F 62 40"), Version.V5), "Malformed")
    t.equal(outcome(hex("82 08 00 01 00 03 61 2F 62 04"), Version.V311), "Malformed")
}

fn test_connect_malformed(t: *testing.T) {
    let v = Version.V311
    t.equal(outcome(hex("10 0D 00 04 4D 51 54 54 04 03 00 3C 00 01 63"), v), "Malformed")
    t.equal(outcome(hex("10 0D 00 04 4D 51 54 54 04 20 00 3C 00 01 63"), v), "Malformed")
    t.equal(outcome(hex("10 0D 00 04 4D 51 54 54 04 18 00 3C 00 01 63"), v), "Malformed")
    t.equal(outcome(hex("10 0D 00 04 4D 51 54 54 04 42 00 3C 00 01 63"), v), "Malformed")
    t.equal(outcome(hex("10 0D 00 04 4D 51 54 55 04 02 00 3C 00 01 63"), v), "Malformed")
    t.equal(outcome(hex("10 0D 00 04 4D 51 54 54 04 02 00 3C 00 01"), v), "Malformed")
    t.equal(outcome(hex("10 0E 00 04 4D 51 54 54 04 02 00 3C 00 01 63 00"), v), "Malformed")
}

fn test_connect_unsupported(t: *testing.T) {
    t.equal(outcome(hex("10 0D 00 04 4D 51 54 54 03 02 00 3C 00 01 63"), Version.V311), "Unsupported")
    t.equal(outcome(hex("10 0D 00 04 4D 51 54 54 06 02 00 3C 00 01 63"), Version.V311), "Unsupported")
    t.equal(outcome(hex("10 0F 00 06 4D 51 49 73 64 70 03 02 00 3C 00 01 63"), Version.V311), "Unsupported")
}

fn test_connect_version_comes_from_packet(t: *testing.T) {
    let p = decoded(t, hex("10 0E 00 04 4D 51 54 54 05 02 00 3C 00 00 01 63"), Version.V311)
    match p {
        Connect(c) => {
            t.equal(c.version, Version.V5)
            t.equal(c.client_id, "c")
        }
        _ => t.error("not a CONNECT")
    }
}

fn test_strings(t: *testing.T) {
    let valid = ["", "a", "héllo", "日本語", "😀", "a/b c", "�", "\U0010FFFF"]
    for s in valid {
        t.is_true(valid_string(s))
    }
    let invalid = ["a\0b", "\0", "\xC0\x80", "\xED\xA0\x80", "\xED\xBF\xBF", "\xF4\x90\x80\x80", "\xFF", "\xC3", "ab\xE2\x82"]
    for s in invalid {
        t.is_false(valid_string(s))
    }
    t.is_true(valid_string(text_of(65535)))
    t.is_false(valid_string(text_of(65536)))
}

fn text_of(n: i64) -> str {
    text.repeat("a", n)
}

fn test_decode_string_validation(t: *testing.T) {
    let v = Version.V311
    t.equal(outcome(hex("30 05 00 03 61 00 62"), v), "Malformed")
    t.equal(outcome(hex("30 06 00 03 ED A0 80"), v), "Malformed")
    t.equal(outcome(hex("30 05 00 03 C0 80 61"), v), "Malformed")
    t.equal(outcome(hex("30 06 00 04 61 62 F0 9F"), v), "Malformed")
    let emoji = decoded(t, hex("30 08 00 04 F0 9F 98 80 78 79"), v)
    match emoji {
        Publish(m) => t.equal(m.topic, "😀")
        _ => t.error("not a PUBLISH")
    }
}
