import std/ice
import std/net

fn address(text: str, port: i64) -> net.Addr {
    net.Addr { ip: net.parse_ip(text) or [], port }
}

fn exchange(a: *ice.Agent, b: *ice.Agent, local_a: net.Addr, local_b: net.Addr, now: i64) {
    for {
        let t = ice.poll_transmit(a) ?? break
        ice.receive(b, local_b, local_a, t.data, now)
    }
    for {
        let t = ice.poll_transmit(b) ?? break
        ice.receive(a, local_a, local_b, t.data, now)
    }
}

fn describe(name: str, a: *ice.Agent) {
    match ice.selected(a) {
        some(s) => print("{name} selected {net.format(s.local.addr)} -> {net.format(s.remote.addr)}")
        none => print("{name} selected nothing")
    }
}

fn main() {
    let local_a = address("10.0.0.1", 5000)
    let local_b = address("10.0.0.2", 6000)
    let a = ice.agent(ice.Config { controlling: true, hosts: [local_a] })
    let b = ice.agent(ice.Config { controlling: false, hosts: [local_b] })
    ice.set_remote_credentials(a, b.local_ufrag, b.local_pwd, 0)
    ice.set_remote_credentials(b, a.local_ufrag, a.local_pwd, 0)
    ice.gather(a, 0)
    ice.gather(b, 0)
    for c in ice.local_candidates(a) {
        print(ice.format(c))
        ice.add_remote_candidate(b, c, 0)
    }
    for c in ice.local_candidates(b) {
        print(ice.format(c))
        ice.add_remote_candidate(a, c, 0)
    }
    ice.end_of_remote_candidates(a, 0)
    ice.end_of_remote_candidates(b, 0)
    var now = 0
    for now < 5000 && (a.state != ice.State.Completed || b.state != ice.State.Completed) {
        ice.tick(a, now)
        ice.tick(b, now)
        exchange(a, b, local_a, local_b, now)
        now += 10
    }
    describe("a", a)
    describe("b", b)
    print("a is controlling: {a.controlling}")
}
