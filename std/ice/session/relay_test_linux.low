import std/crypto/x509
import std/file
import std/io
import std/net
import std/os
import std/process
import std/testing
import std/text
import std/tls
import std/turn

const server_source = "testdata/turn/pion"

fn go(args: str[]) -> process.Output {
    var command = process.command("go", args)
    command.dir = server_source
    process.run(command, []) or panic("go {args[0]}")
}

fn build_server(t: *testing.T) -> str? {
    for name in ["go", "timeout"] {
        if process.find(name) == none {
            testing.skip(t, "{name} is not installed")
            return none
        }
    }
    let fetched = go(["mod", "download"])
    if !process.success(fetched.status) {
        testing.skip(t, "the pion/turn modules cannot be downloaded: {str(fetched.stderr)}")
        return none
    }
    let binary = "{os.temp_dir_path()}/low-turnserver-{os.pid()}"
    let built = go(["build", "-o", binary, "."])
    if !process.success(built.status) {
        testing.fatal(t, "go build: {str(built.stderr)}")
        return none
    }
    binary
}

fn read_ports(stream: io.Stream) -> i64[] {
    let buf = io.buffer(64)
    var line = ""
    for !text.contains(line, "\n") {
        let n = stream.read(buf) or 0
        if n == 0 {
            panic("the TURN server ended before printing its ports")
        }
        line = "{line}{str(buf[..n])}"
    }
    var ports: i64[] = []
    for field in text.fields(line) {
        ports.push(text.parse_int(field) or panic("port {field}"))
    }
    ports
}

fn test_a_relay_only_agent_connects_through_pion_turn_over_udp_tcp_and_tls(t: *testing.T) {
    let binary = build_server(t) ?? return
    let certificate = identity(["turn.test"], [[127, 0, 0, 1]])
    let base = "{os.temp_dir_path()}/low-turnserver-{os.pid()}"
    file.write_file("{base}.crt", bytes(x509.certificate_pem(certificate.certificates[0]))) or panic("write certificate")
    file.write_file("{base}.key", bytes(x509.private_key_pem(certificate.key ?? panic("key")) or panic("key pem"))) or panic("write key")
    defer {
        file.remove("{base}.crt") or {}
        file.remove("{base}.key") or {}
    }
    using child = process.start(process.Command { program: "timeout", args: ["60", binary, "{base}.crt", "{base}.key"], stdin: process.Stdio.Piped, stdout: process.Stdio.Piped, stderr: process.Stdio.Null }) or panic("start")
    let ports = read_ports(child.handle.stdout ?? panic("no stdout"))
    let trusting = tls.Config { roots: [root_of(certificate)] }
    for i, transport in [turn.Transport.Udp, turn.Transport.Tcp, turn.Transport.Tls] {
        let server = turn.Config { server: net.parse_addr("127.0.0.1:{ports[i]}") or panic("addr"), transport, server_name: if transport == turn.Transport.Tls { "turn.test" } else { "" }, username: "alice", password: "secret" }
        connect_through(t, server, trusting)
    }
    let stdin = child.handle.stdin ?? panic("no stdin")
    stdin.close()
}
