import std/ice
import std/ice/session

fn next_event(h: session.Handle) -> ice.Event? {
    select {
        e = <-h.events => e
        after(10000) => none
    }
}

fn relay(from: session.Handle, to: session.Handle, completed: chan[bool]) {
    for {
        let e = next_event(from) ?? break
        match e {
            LocalCandidate(c) => {
                session.add_remote_candidate(to, c) or break
            }
            GatheringComplete => {
                session.end_of_remote_candidates(to) or break
            }
            StateChanged(s) => {
                if s == ice.State.Completed {
                    completed <- true
                }
            }
            Selected(_, _) => {}
        }
    }
}

fn main() {
    let config = ice.Config { controlling: true }
    using a = session.open(session.Options { config, bind: ["127.0.0.1"] }) or return
    using b = session.open(session.Options { config: ice.Config { controlling: false }, bind: ["127.0.0.1"] }) or return
    let ca = session.credentials(a.handle) or return
    let cb = session.credentials(b.handle) or return
    session.set_remote_credentials(a.handle, cb.ufrag, cb.pwd) or return
    session.set_remote_credentials(b.handle, ca.ufrag, ca.pwd) or return
    let done_a = chan[bool](1)
    let done_b = chan[bool](1)
    spawn relay(a.handle, b.handle, done_a)
    spawn relay(b.handle, a.handle, done_b)
    session.gather(a.handle) or return
    session.gather(b.handle) or return
    select {
        <-done_a => {}
        after(10000) => {
            print("timed out")
            return
        }
    }
    select {
        <-done_b => {}
        after(10000) => {
            print("timed out")
            return
        }
    }
    print("both sides completed")
    session.send(a.handle, [0x16, 1, 2, 3]) or return
    let got: session.Datagram? = select {
        d = <-b.handle.incoming => d
        after(5000) => none
    }
    match got {
        some(d) => print("b received {d.data.len} bytes starting {d.data[0]}")
        none => print("nothing received")
    }
}
