import std/io
import std/net

fn link_local(ip: u8[]) -> bool {
    if ip.len == 4 {
        return ip[0] == 169 && ip[1] == 254
    }
    ip[0] == 0xfe && (ip[1] & 0xc0) == 0x80
}

/// Returns the IP addresses of the host's interfaces that make host candidates: global and private unicast addresses of both families on interfaces that are up, in the order the operating system lists them.
///
/// Link-local addresses are left out because `net.Addr` carries no zone. Loopback addresses are included only when `loopback` is true. Fails with the error of `net.interfaces` when the system cannot list its interfaces.
pub fn local_addresses(loopback: bool) -> u8[][] ! io.Error {
    var out: u8[][] = []
    for i in net.interfaces()? {
        if i.up && (loopback || !i.loopback) {
            for a in i.addresses {
                if !link_local(a.ip) {
                    out.push(a.ip)
                }
            }
        }
    }
    out
}
