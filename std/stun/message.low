import std/crypto
import std/crypto/hash
import checksum = std/hash
import std/io

/// The fixed value `0x2112A442` that follows the length in every RFC 8489 message.
pub const magic_cookie = 0x2112A442

/// The size of the message header in bytes.
pub const header_size = 20

/// The Binding method, used by ICE and for address discovery.
pub const binding = 0x001

/// The Allocate method (RFC 8656).
pub const allocate = 0x003

/// The Refresh method (RFC 8656).
pub const refresh = 0x004

/// The Send method, an indication (RFC 8656).
pub const send = 0x006

/// The Data method, an indication (RFC 8656).
pub const data = 0x007

/// The CreatePermission method (RFC 8656).
pub const create_permission = 0x008

/// The ChannelBind method (RFC 8656).
pub const channel_bind = 0x009

/// The MAPPED-ADDRESS attribute.
pub const attr_mapped_address = 0x0001

/// The USERNAME attribute.
pub const attr_username = 0x0006

/// The MESSAGE-INTEGRITY attribute, an HMAC-SHA1.
pub const attr_message_integrity = 0x0008

/// The ERROR-CODE attribute.
pub const attr_error_code = 0x0009

/// The UNKNOWN-ATTRIBUTES attribute.
pub const attr_unknown_attributes = 0x000A

/// The CHANNEL-NUMBER attribute (RFC 8656).
pub const attr_channel_number = 0x000C

/// The LIFETIME attribute (RFC 8656).
pub const attr_lifetime = 0x000D

/// The XOR-PEER-ADDRESS attribute (RFC 8656).
pub const attr_xor_peer_address = 0x0012

/// The DATA attribute (RFC 8656).
pub const attr_data = 0x0013

/// The REALM attribute.
pub const attr_realm = 0x0014

/// The NONCE attribute.
pub const attr_nonce = 0x0015

/// The XOR-RELAYED-ADDRESS attribute (RFC 8656).
pub const attr_xor_relayed_address = 0x0016

/// The REQUESTED-ADDRESS-FAMILY attribute (RFC 8656).
pub const attr_requested_address_family = 0x0017

/// The EVEN-PORT attribute (RFC 8656).
pub const attr_even_port = 0x0018

/// The REQUESTED-TRANSPORT attribute (RFC 8656).
pub const attr_requested_transport = 0x0019

/// The DONT-FRAGMENT attribute (RFC 8656).
pub const attr_dont_fragment = 0x001A

/// The MESSAGE-INTEGRITY-SHA256 attribute.
pub const attr_message_integrity_sha256 = 0x001C

/// The PASSWORD-ALGORITHM attribute.
pub const attr_password_algorithm = 0x001D

/// The USERHASH attribute.
pub const attr_userhash = 0x001E

/// The XOR-MAPPED-ADDRESS attribute.
pub const attr_xor_mapped_address = 0x0020

/// The RESERVATION-TOKEN attribute (RFC 8656).
pub const attr_reservation_token = 0x0022

/// The PRIORITY attribute of ICE (RFC 8445).
pub const attr_priority = 0x0024

/// The USE-CANDIDATE attribute of ICE (RFC 8445).
pub const attr_use_candidate = 0x0025

/// The PASSWORD-ALGORITHMS attribute.
pub const attr_password_algorithms = 0x8002

/// The ALTERNATE-DOMAIN attribute.
pub const attr_alternate_domain = 0x8003

/// The SOFTWARE attribute.
pub const attr_software = 0x8022

/// The ALTERNATE-SERVER attribute.
pub const attr_alternate_server = 0x8023

/// The FINGERPRINT attribute, a CRC-32 xor `0x5354554E`.
pub const attr_fingerprint = 0x8028

/// The ICE-CONTROLLED attribute (RFC 8445).
pub const attr_ice_controlled = 0x8029

/// The ICE-CONTROLLING attribute (RFC 8445).
pub const attr_ice_controlling = 0x802A

/// The RESPONSE-ORIGIN attribute.
pub const attr_response_origin = 0x802B

/// The OTHER-ADDRESS attribute.
pub const attr_other_address = 0x802C

/// The class of a message, held in two bits of its type.
pub enum Class {
    /// A request that expects a response.
    Request = 0
    /// A message that expects no response.
    Indication = 1
    /// The response to a request that succeeded.
    Success = 2
    /// The response to a request that failed.
    Error = 3
}

/// One type-length-value attribute with its padding removed.
pub struct Attribute {
    /// The attribute type, below `0x8000` when a receiver must understand it.
    pub kind: i64
    /// The value, without the padding that follows it on the wire.
    pub value: u8[]
}

/// A STUN message: class, method, transaction ID and attributes in order.
///
/// `parse` keeps the bytes a message was read from, which `check_integrity` and `check_fingerprint` need.
pub struct Message {
    /// The class of the message.
    pub class: Class
    /// The 12-bit method.
    pub method: i64
    /// The 12-byte transaction ID.
    pub transaction: u8[]
    /// The attributes in wire order.
    pub attributes: Attribute[] = []
    /// The byte written after an attribute value to reach a multiple of four bytes. Receivers ignore it, so any value is valid.
    pub padding: u8 = 0
    raw: u8[] = []
    offsets: i64[] = []
}

/// Which keyed hash of the message a check refers to.
pub enum Integrity {
    /// MESSAGE-INTEGRITY, HMAC-SHA1 with a 20-byte value.
    Sha1
    /// MESSAGE-INTEGRITY-SHA256, HMAC-SHA256 truncated to 16 to 32 bytes in steps of four.
    Sha256
}

/// What `seal` appends to a message: the keyed hashes over everything before them, then the FINGERPRINT.
pub struct Protection {
    /// The HMAC key, the password for short-term credentials and the long-term key (`long_term_key`) for long-term credentials.
    pub key: u8[]
    /// Whether to append MESSAGE-INTEGRITY.
    pub sha1: bool = true
    /// Whether to append MESSAGE-INTEGRITY-SHA256 with the full 32 bytes.
    pub sha256: bool = false
    /// Whether to end the message with FINGERPRINT.
    pub fingerprint: bool = true
}

/// Returns a message of `class` and `method` with a random transaction ID and no attributes.
pub fn message(class: Class, method: i64) -> Message {
    Message { class, method, transaction: crypto.random(12) }
}

/// Appends an attribute of type `kind` to `m`.
pub fn add(mut m: Message, kind: i64, value: u8[]) {
    m.attributes.push(Attribute { kind, value })
}

/// Returns the value of the first attribute of type `kind` in `m`, or `none`.
pub fn find(m: Message, kind: i64) -> u8[]? {
    for a in m.attributes {
        if a.kind == kind {
            return a.value
        }
    }
    none
}

/// Returns whether `data` has the shape of a STUN message: a 20-byte header whose top two bits are zero and whose magic cookie matches.
///
/// RFC 7983 demultiplexes STUN from DTLS and RTP by the first byte, 0 to 3.
pub fn looks_like(data: u8[]) -> bool {
    data.len >= header_size && data[0] < 4 && io.be32(data, 4) == magic_cookie
}

fn type_code(class: Class, method: i64) -> i64 {
    let c = class.index
    (method & 0x000F) | ((c & 1) << 4) | ((method & 0x0070) << 1) | ((c & 2) << 7) | ((method & 0x0F80) << 2)
}

fn class_of(code: i64) -> Class {
    match ((code >> 4) & 1) | ((code >> 7) & 2) {
        0 => Class.Request
        1 => Class.Indication
        2 => Class.Success
        _ => Class.Error
    }
}

fn method_of(code: i64) -> i64 {
    (code & 0x000F) | ((code >> 1) & 0x0070) | ((code >> 2) & 0x0F80)
}

fn put_attribute(mut out: u8[], kind: i64, value: u8[], padding: u8) {
    io.put_be16(mut out, kind)
    io.put_be16(mut out, value.len)
    io.append(mut out, value)
    for _ in 0..(4 - value.len % 4) % 4 {
        out.push(padding)
    }
}

fn start(m: Message) -> u8[] {
    var out: u8[] = []
    io.put_be16(mut out, type_code(m.class, m.method))
    io.put_be16(mut out, 0)
    io.put_be32(mut out, magic_cookie)
    io.append(mut out, m.transaction)
    for a in m.attributes {
        put_attribute(mut out, a.kind, a.value, m.padding)
    }
    io.set_be16(out, 2, out.len - header_size)
    out
}

/// Returns the wire form of `m` with its attributes as given.
///
/// The transaction ID must be 12 bytes; any other length is a programming error and panics.
pub fn encode(m: Message) -> u8[] {
    if m.transaction.len != 12 {
        panic("stun: transaction ID must be 12 bytes")
    }
    start(m)
}


fn with_length(out: u8[], extra: i64) -> u8[] {
    let copy = io.buffer(out.len)
    io.copy(copy, out)
    io.set_be16(copy, 2, out.len - header_size + extra)
    copy
}

/// Returns the wire form of `m` followed by the hashes and fingerprint that `p` asks for.
///
/// Each hash covers the message up to its own attribute with the length field set as RFC 8489 section 14.5 prescribes. Attributes of `m` of the same types are not removed.
pub fn seal(m: Message, p: Protection) -> u8[] {
    var out = encode(m)
    if p.sha1 {
        let value = hash.hmac(hash.sha1(), p.key, with_length(out, 24))
        put_attribute(mut out, attr_message_integrity, value, m.padding)
    }
    if p.sha256 {
        let value = hash.hmac(hash.sha256(), p.key, with_length(out, 36))
        put_attribute(mut out, attr_message_integrity_sha256, value, m.padding)
    }
    if p.fingerprint {
        let crc = checksum.crc32(with_length(out, 8))
        var value: u8[] = []
        io.put_be32(mut value, i64(crc ^ 0x5354554E))
        put_attribute(mut out, attr_fingerprint, value, m.padding)
    }
    io.set_be16(out, 2, out.len - header_size)
    out
}

/// Reads one message from `data`, which must be exactly one datagram.
///
/// Fails with `Malformed` when the header is shorter than 20 bytes, the top two bits of the type are set, the length is not a multiple of four or does not match `data`, the magic cookie differs, or an attribute runs past the end.
pub fn parse(data: u8[]) -> Message ! io.Error {
    if data.len < header_size || data[0] & 0xC0 != 0 {
        fail Malformed
    }
    let length = io.be16(data, 2)
    if length % 4 != 0 || data.len != header_size + length || io.be32(data, 4) != magic_cookie {
        fail Malformed
    }
    let code = io.be16(data, 0)
    var attributes: Attribute[] = []
    var offsets: i64[] = []
    var at = header_size
    for at < data.len {
        if data.len - at < 4 {
            fail Malformed
        }
        let kind = io.be16(data, at)
        let size = io.be16(data, at + 2)
        let padded = (size + 3) / 4 * 4
        if data.len - at - 4 < padded {
            fail Malformed
        }
        attributes.push(Attribute { kind, value: data[at + 4..at + 4 + size] })
        offsets.push(at)
        at += 4 + padded
    }
    let transaction = io.buffer(12)
    io.copy(transaction, data[8..20])
    Message { class: class_of(code), method: method_of(code), transaction, attributes, raw: data, offsets }
}

fn position(m: Message, kind: i64) -> i64? {
    for i, a in m.attributes {
        if a.kind == kind {
            return i
        }
    }
    none
}

/// Checks the MESSAGE-INTEGRITY or MESSAGE-INTEGRITY-SHA256 attribute of a parsed message against `key`.
///
/// The hash covers the message up to the attribute with the length field adjusted to end after it, so attributes that follow, such as FINGERPRINT, do not matter. Fails with `NotFound` when the attribute is absent, `Invalid` when `m` was not produced by `parse` or the value has an invalid length, and `Denied` when the hash differs. The comparison takes the same time for every value.
pub fn check_integrity(m: Message, key: u8[], which: Integrity) ! io.Error {
    let kind = match which {
        Sha1 => attr_message_integrity
        Sha256 => attr_message_integrity_sha256
    }
    let i = position(m, kind) ?? fail NotFound
    if m.raw.len == 0 {
        fail Invalid
    }
    let value = m.attributes[i].value
    let valid = match which {
        Sha1 => value.len == 20
        Sha256 => value.len >= 16 && value.len <= 32 && value.len % 4 == 0
    }
    if !valid {
        fail Invalid
    }
    let end = m.offsets[i]
    let covered = io.buffer(end)
    io.copy(covered, m.raw[..end])
    io.set_be16(covered, 2, end - header_size + 4 + (value.len + 3) / 4 * 4)
    let algorithm = match which {
        Sha1 => hash.sha1()
        Sha256 => hash.sha256()
    }
    let expected = hash.hmac(algorithm, key, covered)
    if !hash.equal(expected[..value.len], value) {
        fail Denied
    }
}

/// Checks the FINGERPRINT attribute of a parsed message.
///
/// The attribute must be the last one. Fails with `NotFound` when it is absent, `Invalid` when `m` was not produced by `parse`, and `Malformed` when it is not last or the CRC-32 differs.
pub fn check_fingerprint(m: Message) ! io.Error {
    let i = position(m, attr_fingerprint) ?? fail NotFound
    if m.raw.len == 0 {
        fail Invalid
    }
    let value = m.attributes[i].value
    if i != m.attributes.len - 1 || value.len != 4 {
        fail Malformed
    }
    let end = m.offsets[i]
    let covered = io.buffer(end)
    io.copy(covered, m.raw[..end])
    io.set_be16(covered, 2, end - header_size + 8)
    if i64(checksum.crc32(covered) ^ 0x5354554E) != io.be32(value, 0) {
        fail Malformed
    }
}
