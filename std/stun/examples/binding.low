import std/net
import std/stun

fn main() {
    using server = net.bind_udp("127.0.0.1", 0) or return
    spawn stun.serve(server.handle, stun.ServerConfig { software: "example" })

    using client = stun.client("127.0.0.1") or return
    let seen = stun.binding_address(client, server.handle.addr, stun.Config {}) or {
        print("binding failed")
        return
    }
    print("matches the client socket: {net.format(seen) == net.format(client.socket.addr)}")

    var request = stun.message(stun.Class.Request, stun.binding)
    stun.add_text(mut request, stun.attr_username, "alice:bob")
    let wire = stun.seal(request, stun.Protection { key: bytes("password") })
    let parsed = stun.parse(wire) or return
    print("request is {wire.len} bytes with {parsed.attributes.len} attributes")
    stun.check_integrity(parsed, bytes("password"), stun.Integrity.Sha1) or {
        print("integrity failed")
        return
    }
    stun.check_fingerprint(parsed) or {
        print("fingerprint failed")
        return
    }
    print("integrity and fingerprint verified")
}
