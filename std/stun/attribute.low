import std/crypto/hash
import std/crypto/md5
import std/io
import std/net
import std/slices
import std/text

/// An ERROR-CODE attribute: a code from 300 to 699 and a reason phrase.
pub struct ErrorCode {
    /// The numeric code, such as 401 or 487.
    pub code: i64
    /// The reason phrase.
    pub reason: str
}

fn address_body(a: net.Addr, mask: u8[]) -> u8[] {
    var out: u8[] = [0, if net.v6(a.ip) { 2 } else { 1 }]
    let port = a.port ^ (magic_cookie >> 16)
    io.put_be16(mut out, if mask.len == 0 { a.port } else { port })
    for i, b in a.ip {
        out.push(if mask.len == 0 { b } else { b ^ mask[i] })
    }
    out
}

fn mask_of(transaction: u8[], size: i64) -> u8[] {
    var mask: u8[] = []
    io.put_be32(mut mask, magic_cookie)
    io.append(mut mask, transaction)
    mask[..size]
}

fn address_of(value: u8[], mask: u8[]) -> net.Addr ! io.Error {
    if value.len < 4 {
        fail Malformed
    }
    let size = match value[1] {
        1 => 4
        2 => 16
        _ => fail Malformed
    }
    if value.len != 4 + size {
        fail Malformed
    }
    let ip = io.buffer(size)
    for i in 0..size {
        ip[i] = value[4 + i] ^ if mask.len == 0 { 0 } else { mask[i] }
    }
    let port = io.be16(value, 2) ^ if mask.len == 0 { 0 } else { magic_cookie >> 16 }
    net.Addr { ip, port }
}

/// Returns the value of a MAPPED-ADDRESS style attribute for `a`: a zero byte, the family, the port and the address.
pub fn address_value(a: net.Addr) -> u8[] {
    address_body(a, [])
}

/// Returns the value of an XOR-MAPPED-ADDRESS style attribute for `a`, with the port xored with the top half of the magic cookie and the address with the cookie followed by `transaction` (RFC 8489 section 14.2).
pub fn xor_address_value(a: net.Addr, transaction: u8[]) -> u8[] {
    address_body(a, mask_of(transaction, a.ip.len))
}

/// Appends a MAPPED-ADDRESS style attribute of type `kind` holding `a`.
pub fn add_address(mut m: Message, kind: i64, a: net.Addr) {
    add(mut m, kind, address_value(a))
}

/// Appends an XOR-MAPPED-ADDRESS style attribute of type `kind` holding `a`, such as `attr_xor_mapped_address` or `attr_xor_peer_address`.
pub fn add_xor_address(mut m: Message, kind: i64, a: net.Addr) {
    add(mut m, kind, xor_address_value(a, m.transaction))
}

/// Reads a MAPPED-ADDRESS style attribute of type `kind` from `m`.
///
/// Fails with `NotFound` when the attribute is absent and `Malformed` when its family or length is invalid.
pub fn get_address(m: Message, kind: i64) -> net.Addr ! io.Error {
    let value = find(m, kind) ?? fail NotFound
    address_of(value, [])
}

/// Reads an XOR-MAPPED-ADDRESS style attribute of type `kind` from `m`, undoing the xor with the magic cookie and the transaction ID.
///
/// Fails with `NotFound` when the attribute is absent and `Malformed` when its family or length is invalid.
pub fn get_xor_address(m: Message, kind: i64) -> net.Addr ! io.Error {
    let value = find(m, kind) ?? fail NotFound
    if value.len < 4 {
        fail Malformed
    }
    let size = if value[1] == 2 { 16 } else { 4 }
    address_of(value, mask_of(m.transaction, size))
}

/// Returns the address a Binding response reports: XOR-MAPPED-ADDRESS, or MAPPED-ADDRESS from a server that predates RFC 5389.
///
/// Fails with `NotFound` when neither is present and `Malformed` when the one present is invalid.
pub fn reflexive_address(m: Message) -> net.Addr ! io.Error {
    match find(m, attr_xor_mapped_address) {
        some(_) => get_xor_address(m, attr_xor_mapped_address)
        none => get_address(m, attr_mapped_address)
    }
}

/// Appends a text attribute of type `kind`, such as `attr_username`, `attr_software`, `attr_realm` or `attr_nonce`.
pub fn add_text(mut m: Message, kind: i64, value: str) {
    add(mut m, kind, bytes(value))
}

/// Returns the text attribute of type `kind` in `m`, or `none`.
pub fn get_text(m: Message, kind: i64) -> str? {
    match find(m, kind) {
        some(v) => str(v)
        none => none
    }
}

/// Appends a 32-bit attribute of type `kind`, such as `attr_priority` or `attr_lifetime`.
pub fn add_u32(mut m: Message, kind: i64, v: i64) {
    var value: u8[] = []
    io.put_be32(mut value, v)
    add(mut m, kind, value)
}

/// Returns the 32-bit attribute of type `kind` in `m`.
///
/// Fails with `NotFound` when absent and `Malformed` when its length is not 4.
pub fn get_u32(m: Message, kind: i64) -> i64 ! io.Error {
    let value = find(m, kind) ?? fail NotFound
    if value.len != 4 {
        fail Malformed
    }
    io.be32(value, 0)
}

/// Appends a 64-bit attribute of type `kind`, such as `attr_ice_controlling` or `attr_ice_controlled`.
pub fn add_u64(mut m: Message, kind: i64, v: u64) {
    var value: u8[] = []
    io.put_be64(mut value, i64(v))
    add(mut m, kind, value)
}

/// Returns the 64-bit attribute of type `kind` in `m`.
///
/// Fails with `NotFound` when absent and `Malformed` when its length is not 8.
pub fn get_u64(m: Message, kind: i64) -> u64 ! io.Error {
    let value = find(m, kind) ?? fail NotFound
    if value.len != 8 {
        fail Malformed
    }
    io.u64_be(value, 0)
}

/// Appends an ERROR-CODE attribute with `code` and `reason`.
pub fn add_error_code(mut m: Message, code: i64, reason: str) {
    var value: u8[] = [0, 0, u8(code / 100), u8(code % 100)]
    text.append(mut value, reason)
    add(mut m, attr_error_code, value)
}

/// Returns the ERROR-CODE attribute of `m`, or `none` when absent or shorter than four bytes.
pub fn error_code(m: Message) -> ErrorCode? {
    let value = find(m, attr_error_code) ?? return none
    if value.len < 4 {
        return none
    }
    ErrorCode { code: i64(value[2] & 7) * 100 + i64(value[3]), reason: str(value[4..]) }
}

/// Appends an UNKNOWN-ATTRIBUTES attribute listing `kinds`.
pub fn add_unknown_attributes(mut m: Message, kinds: i64[]) {
    var value: u8[] = []
    for k in kinds {
        io.put_be16(mut value, k)
    }
    add(mut m, attr_unknown_attributes, value)
}

/// Returns the types of the attributes of `m` below `0x8000` that are not in `known`, which a receiver must reject with a 420 response.
pub fn unknown_required(m: Message, known: i64[]) -> i64[] {
    var out: i64[] = []
    for a in m.attributes {
        if a.kind < 0x8000 && !slices.contains(known, a.kind) {
            out.push(a.kind)
        }
    }
    out
}

/// Returns the long-term credential key `MD5(username ":" realm ":" password)` of RFC 8489 section 9.2.2.
///
/// The password is used as given: SASLprep is not applied, so a password that SASLprep changes must be prepared by the caller.
pub fn long_term_key(username: str, realm: str, password: str) -> u8[] {
    md5.sum(bytes("{username}:{realm}:{password}"))
}

/// Returns the long-term credential key `SHA-256(username ":" realm ":" password)` for the SHA-256 password algorithm of RFC 8489 section 9.2.2.
pub fn long_term_key_sha256(username: str, realm: str, password: str) -> u8[] {
    hash.sum(hash.sha256(), bytes("{username}:{realm}:{password}"))
}
