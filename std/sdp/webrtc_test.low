import std/slices
import std/testing
import std/text

fn capture_session(name: str) -> Session {
    parse(capture(name)) or panic("{name} did not parse")
}

fn test_chromium_offer_carries_the_jsep_attributes_of_a_bundle(t: *testing.T) {
    let s = capture_session("chromium_offer")
    testing.error_if(t, s.media.len != 3, "media {s.media.len}")
    let mids = bundle(s) or panic("bundle")
    testing.error_if(t, !slices.equal(mids, ["0", "1", "2"]), "bundle {mids}")
    for m in s.media {
        testing.error_if(t, (ice_ufrag(s, m) ?? "").len != 4 || (ice_pwd(s, m) ?? "").len != 24, "credentials of {mid(m) ?? "?"}")
        testing.error_if(t, !slices.equal(ice_options(s, m), ["trickle"]), "ice options")
        testing.error_if(t, fingerprints(s, m).len != 1 || !text.starts_with(fingerprints(s, m)[0], "sha-256 "), "fingerprint")
        testing.error_if(t, (setup(s, m) or none) != some(Setup.ActPass), "setup")
        testing.error_if(t, direction(s, m) != Direction.SendRecv, "direction")
    }
    let audio = s.media[0]
    testing.error_if(t, !rtcp_mux(audio) || !rtcp_rsize(audio) || candidates(audio).len != 2, "audio transport")
    testing.error_if(t, (mid(audio) ?? "") != "0" || (msids(audio) or [])[0].stream != "-" || (msids(audio) or [])[0].track == none, "audio ids")
    let opus = (rtpmaps(audio) or [])[0]
    testing.error_if(t, opus.payload_type != 111 || opus.encoding != "opus" || opus.clock_rate != 48000 || opus.channels != 2, "opus {opus.encoding}")
    let fmtp = (fmtps(audio) or [])[0]
    testing.error_if(t, fmtp.format != "111" || fmtp.parameters != "minptime=10;useinbandfec=1", "opus fmtp")
    let extmap = (extmaps(s, audio) or [])[0]
    testing.error_if(t, extmap.id != 1 || extmap.uri != "urn:ietf:params:rtp-hdrext:ssrc-audio-level" || extmap.direction != none, "extmap")
    let sources = ssrcs(audio) or []
    testing.error_if(t, sources.len != 2 || sources[0].name != "cname" || sources[1].name != "msid", "audio ssrcs")
}

fn test_chromium_video_has_feedback_and_a_retransmission_group(t: *testing.T) {
    let s = capture_session("chromium_offer")
    let video = s.media[1]
    let vp8 = (rtpmaps(video) or [])[0]
    testing.error_if(t, vp8.encoding != "VP8" || vp8.channels != 0, "vp8")
    var nack_pli = 0
    for f in feedbacks(video) or [] {
        if f.format == "96" && f.kind == "nack" && f.parameter == "pli" {
            nack_pli += 1
        }
    }
    testing.error_if(t, nack_pli != 1, "nack pli of 96 {nack_pli}")
    let groups = ssrc_groups(video) or []
    testing.error_if(t, groups.len != 1 || groups[0].semantics != "FID" || groups[0].ssrcs.len != 2, "ssrc-group")
    testing.error_if(t, (ssrcs(video) or []).len == 0, "video ssrcs")
}

fn test_chromium_data_channel_section_names_the_sctp_port_and_message_size(t: *testing.T) {
    let s = capture_session("chromium_offer")
    let app = s.media[2]
    testing.error_if(t, !is_data_channel(app) || app.formats[0] != "webrtc-datachannel", "not a data channel")
    testing.error_if(t, (sctp_port(app) or none) != some(5000), "sctp-port")
    testing.error_if(t, (max_message_size(app) or none) != some(262144), "max-message-size")
    testing.error_if(t, (sctp_port(s.media[0]) or some(0)) != none, "sctp-port on audio")
    testing.error_if(t, is_data_channel(s.media[0]), "audio is a data channel")
}

fn test_chromium_answer_takes_the_active_role_and_receives(t: *testing.T) {
    let s = capture_session("chromium_answer")
    for m in s.media {
        testing.error_if(t, (setup(s, m) or none) != some(Setup.Active), "setup of {mid(m) ?? "?"}")
    }
    testing.error_if(t, direction(s, s.media[0]) != Direction.RecvOnly, "audio direction")
    testing.error_if(t, s.media[0].port != 52303 || s.media[0].connections[0].address != "192.0.2.10", "audio address")
}

fn test_firefox_puts_the_fingerprint_on_the_session_and_credentials_on_each_media(t: *testing.T) {
    let s = capture_session("firefox_offer")
    testing.error_if(t, fingerprints(s, s.media[0]).len != 1 || fingerprints(s, s.media[2]).len != 1, "inherited fingerprint")
    testing.error_if(t, s.media[0].attributes.len == 0 || has(s.media[0].attributes, "fingerprint"), "fingerprint on media")
    for m in s.media {
        testing.error_if(t, ice_ufrag(s, m) != ice_ufrag(s, s.media[0]) || ice_ufrag(s, m) == none || ice_pwd(s, m) == none, "credentials of {mid(m) ?? "?"}")
        testing.error_if(t, !has(m.attributes, "ice-ufrag"), "ufrag on {mid(m) ?? "?"}")
    }
    testing.error_if(t, direction(s, s.media[0]) != Direction.SendRecv, "direction")
    testing.error_if(t, !end_of_candidates(s, s.media[0]) || candidates(s.media[0]).len != 8, "candidates {candidates(s.media[0]).len}")
    testing.error_if(t, (sctp_port(s.media[2]) or none) != some(5000) || (max_message_size(s.media[2]) or none) != some(1073741823), "data channel")
}

fn test_firefox_extmap_carries_a_direction_and_fmtp_may_lack_an_equals_sign(t: *testing.T) {
    let s = capture_session("firefox_offer")
    let audio = s.media[0]
    var limited = 0
    for e in extmaps(s, audio) or [] {
        if e.id == 2 && e.direction == some(Direction.RecvOnly) && e.uri == "urn:ietf:params:rtp-hdrext:csrc-audio-level" {
            limited += 1
        }
    }
    testing.error_if(t, limited != 1, "extmap 2/recvonly")
    var digits = 0
    for f in fmtps(audio) or [] {
        if f.format == "101" && f.parameters == "0-15" {
            digits += 1
        }
    }
    testing.error_if(t, digits != 1, "fmtp 101")
    let g722 = (rtpmaps(audio) or [])[1]
    testing.error_if(t, g722.encoding != "G722" || g722.clock_rate != 8000 || g722.channels != 1, "G722/8000/1")
}

fn test_pion_offer_has_ssrc_labels_and_fingerprint_before_the_first_media(t: *testing.T) {
    let s = capture_session("pion_offer")
    testing.error_if(t, !has(s.attributes, "cryptex") || !has(s.attributes, "extmap-allow-mixed"), "session attributes")
    testing.error_if(t, fingerprints(s, s.media[0]).len != 1, "inherited fingerprint")
    let audio = s.media[0]
    let sources = ssrcs(audio) or []
    testing.error_if(t, sources.len != 4 || sources[2].name != "mslabel" || sources[3].name != "label", "ssrc names")
    let ids = msids(audio) or []
    testing.error_if(t, ids.len != 1 || ids[0].track == none || ids[0].stream == "-", "msid")
    testing.error_if(t, (max_message_size(s.media[2]) or none) != some(1073741823), "max-message-size")
}

fn test_a_description_built_from_attributes_formats_and_parses_back(t: *testing.T) {
    let s = Session {
        origin: Origin { session_id: "42" }
        attributes: [group_attribute(Group { semantics: "BUNDLE", mids: ["a", "b"] }), property("ice-lite")]
        media: [
            Media {
                kind: "audio"
                protocol: "UDP/TLS/RTP/SAVPF"
                formats: ["111"]
                connections: [Connection { address: "0.0.0.0" }]
                attributes: [
                    attribute("mid", "a")
                    setup_attribute(Setup.Passive)
                    direction_attribute(Direction.SendOnly)
                    rtpmap_attribute(Rtpmap { payload_type: 111, encoding: "opus", clock_rate: 48000, channels: 2 })
                    fmtp_attribute(Fmtp { format: "111", parameters: "useinbandfec=1" })
                    feedback_attribute(RtcpFeedback { format: "111", kind: "nack", parameter: "pli" })
                    extmap_attribute(Extmap { id: 3, direction: Direction.RecvOnly, uri: "urn:x", attributes: "k" })
                    msid_attribute(Msid { stream: "s", track: "t" })
                    ssrc_attribute(Ssrc { id: 7, name: "cname", value: "me" })
                    ssrc_group_attribute(SsrcGroup { semantics: "FID", ssrcs: [7, 8] })
                ]
            }
        ]
    }
    let back = parse(format(s)) or {
        testing.fatal(t, "did not parse")
        return
    }
    let m = back.media[0]
    testing.error_if(t, !ice_lite(back) || !slices.equal(bundle(back) or [], ["a", "b"]), "session")
    testing.error_if(t, (setup(back, m) or none) != some(Setup.Passive) || direction(back, m) != Direction.SendOnly, "setup and direction")
    testing.error_if(t, (rtpmaps(m) or [])[0].channels != 2 || (fmtps(m) or [])[0].parameters != "useinbandfec=1", "codec")
    testing.error_if(t, (feedbacks(m) or [])[0].parameter != "pli", "feedback")
    let e = (extmaps(back, m) or [])[0]
    testing.error_if(t, e.id != 3 || e.direction != some(Direction.RecvOnly) || e.uri != "urn:x" || e.attributes != "k", "extmap")
    testing.error_if(t, (msids(m) or [])[0].track != "t" || (ssrcs(m) or [])[0].value != "me", "ids")
    testing.error_if(t, !slices.equal((ssrc_groups(m) or [])[0].ssrcs, [7, 8]), "ssrc group")
    testing.error_if(t, format(back) != format(s), "second format differs")
}

fn media_with(name: str, value: str) -> Media {
    Media { kind: "audio", protocol: "RTP/AVP", formats: ["0"], attributes: [attribute(name, value)] }
}

fn empty_session() -> Session {
    Session { origin: Origin { session_id: "1" } }
}

fn refused_setup(value: str) -> bool {
    setup(empty_session(), media_with("setup", value)) catch {
        Attribute(name, _) => return name == "setup"
        _ => return false
    }
    false
}

fn refused_rtpmap(value: str) -> bool {
    rtpmaps(media_with("rtpmap", value)) catch {
        Attribute(name, _) => return name == "rtpmap"
        _ => return false
    }
    false
}

fn refused_extmap(value: str) -> bool {
    extmaps(empty_session(), media_with("extmap", value)) catch {
        Attribute(name, _) => return name == "extmap"
        _ => return false
    }
    false
}

fn refused_sctp_port(value: str) -> bool {
    sctp_port(media_with("sctp-port", value)) catch {
        Attribute(name, _) => return name == "sctp-port"
        _ => return false
    }
    false
}

fn refused_ssrc(value: str) -> bool {
    ssrcs(media_with("ssrc", value)) catch {
        Attribute(name, _) => return name == "ssrc"
        _ => return false
    }
    false
}

fn test_malformed_attributes_fail_with_their_name(t: *testing.T) {
    let cases: [str: bool] = [
        "setup both": refused_setup("both")
        "setup case": refused_setup("Active")
        "rtpmap without a clock": refused_rtpmap("111 opus")
        "rtpmap without an encoding": refused_rtpmap("111")
        "rtpmap with a text payload type": refused_rtpmap("x opus/48000")
        "rtpmap with four parts": refused_rtpmap("111 opus/48000/2/1")
        "extmap id zero": refused_extmap("0 urn:x")
        "extmap id 256": refused_extmap("256 urn:x")
        "extmap unknown direction": refused_extmap("1/sideways urn:x")
        "extmap without a uri": refused_extmap("1")
        "sctp-port above 65535": refused_sctp_port("65536")
        "sctp-port text": refused_sctp_port("five")
        "ssrc with a text source": refused_ssrc("abc cname:x")
    ]
    for name, ok in cases {
        testing.error_if(t, !ok, name)
    }
}

fn test_a_property_attribute_has_an_empty_value_and_an_absent_one_has_none(t: *testing.T) {
    let attributes = [property("rtcp-mux"), attribute("mid", "0")]
    testing.error_if(t, get(attributes, "rtcp-mux") != some(""), "property")
    testing.error_if(t, get(attributes, "rtcp-rsize") != none || has(attributes, "rtcp-rsize"), "absent")
    testing.error_if(t, !slices.equal(all(attributes, "mid"), ["0"]), "all")
}

fn test_a_media_direction_overrides_the_session_direction(t: *testing.T) {
    let s = Session { origin: Origin { session_id: "1" }, attributes: [direction_attribute(Direction.RecvOnly)] }
    let plain = Media { kind: "audio", protocol: "RTP/AVP", formats: ["0"] }
    let own = Media { kind: "audio", protocol: "RTP/AVP", formats: ["0"], attributes: [direction_attribute(Direction.Inactive)] }
    testing.error_if(t, direction(s, plain) != Direction.RecvOnly, "inherited")
    testing.error_if(t, direction(s, own) != Direction.Inactive, "own")
    testing.error_if(t, direction(empty_session(), plain) != Direction.SendRecv, "default")
}
