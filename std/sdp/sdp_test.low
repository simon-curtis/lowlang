import std/file
import std/testing
import std/text

fn capture(name: str) -> str {
    file.read_text("testdata/sdp/{name}.sdp") or panic("read {name}")
}

fn test_captured_descriptions_format_to_the_text_they_parsed_from(t: *testing.T) {
    for name in ["chromium_offer", "chromium_answer", "firefox_offer", "pion_offer"] {
        let source = capture(name)
        let session = parse(source) or {
            testing.fatal(t, "{name} did not parse")
            return
        }
        testing.error_if(t, format(session) != source, "{name} formats differently")
    }
}

fn test_every_line_type_of_rfc_8866_round_trips(t: *testing.T) {
    let source = "v=0\r\no=jdoe 2890844526 2890842807 IN IP4 10.47.16.5\r\ns=SDP Seminar\r\ni=A seminar\r\nu=http://www.example.com/seminars/sdp.pdf\r\ne=j.doe@example.com (Jane Doe)\r\np=+1 617 555-6011\r\nc=IN IP4 224.2.17.12/127\r\nb=AS:128\r\nt=2873397496 2873404696\r\nr=7d 1h 0 25h\r\nt=0 0\r\nz=2882844526 -1h 2898848070 0\r\nk=clear:secret\r\na=recvonly\r\nm=audio 49170/2 RTP/AVP 0 8\r\ni=Voice\r\nc=IN IP6 ff15::101\r\nb=TIAS:64000\r\nk=prompt\r\na=rtpmap:0 PCMU/8000\r\nm=video 51372 RTP/AVP 99\r\na=rtpmap:99 h263-1998/90000\r\n"
    let s = parse(source) or {
        testing.fatal(t, "did not parse")
        return
    }
    testing.error_if(t, s.origin.username != "jdoe" || s.origin.session_id != "2890844526" || s.origin.address != "10.47.16.5", "origin")
    testing.error_if(t, s.name != "SDP Seminar" || s.info != "A seminar" || s.emails.len != 1 || s.phones.len != 1, "descriptive lines")
    testing.error_if(t, s.connections[0].address != "224.2.17.12/127" || s.bandwidths[0].kind != "AS" || s.bandwidths[0].value != 128, "connection and bandwidth")
    testing.error_if(t, s.timings.len != 2 || s.timings[0].start != 2873397496 || s.timings[0].repeats.len != 1 || s.timings[1].repeats.len != 0, "timings")
    testing.error_if(t, s.zone != "2882844526 -1h 2898848070 0" || s.key != "clear:secret", "zone and key")
    testing.error_if(t, s.media.len != 2 || s.media[0].port != 49170 || s.media[0].port_count != 2 || s.media[0].formats.len != 2, "first media")
    testing.error_if(t, s.media[0].title != "Voice" || s.media[0].bandwidths[0].value != 64000 || s.media[0].key != "prompt", "media lines")
    testing.error_if(t, format(s) != source, "format differs")
}

fn test_lf_line_endings_parse_to_the_same_description(t: *testing.T) {
    let crlf = capture("chromium_offer")
    let lf = parse(text.replace(crlf, "\r\n", "\n")) or {
        testing.fatal(t, "LF text did not parse")
        return
    }
    testing.error_if(t, format(lf) != crlf, "LF text formats differently")
}

fn failed_line(source: str) -> i64 {
    parse(source) catch {
        Line(number, _) => return number
        _ => return -1
    }
    0
}

fn test_malformed_descriptions_fail_at_the_line_that_is_wrong(t: *testing.T) {
    let head = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n"
    let cases: [str: bool] = [
        "no v line": failed_line("o=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\n") == 1
        "v=1": failed_line("v=1\r\n") == 1
        "empty line": failed_line(head + "\r\na=mid:0\r\n") == 5
        "no equals": failed_line(head + "mid:0\r\n") == 5
        "unknown type": failed_line(head + "x=1\r\n") == 5
        "second origin": failed_line(head + "o=- 1 1 IN IP4 127.0.0.1\r\n") == 5
        "second v": failed_line(head + "v=0\r\n") == 5
        "short origin": failed_line("v=0\r\no=- 1 1 IN IP4\r\ns=-\r\n") == 2
        "repeat before timing": failed_line("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nr=7d 1h 0 25h\r\n") == 4
        "port above 65535": failed_line(head + "m=audio 65536 RTP/AVP 0\r\n") == 5
        "no formats": failed_line(head + "m=audio 9 RTP/AVP\r\n") == 5
        "negative port count": failed_line(head + "m=audio 9/0 RTP/AVP 0\r\n") == 5
        "session line in media": failed_line(head + "m=audio 9 RTP/AVP 0\r\no=- 1 1 IN IP4 127.0.0.1\r\n") == 6
        "bad bandwidth": failed_line(head + "b=AS128\r\n") == 5
        "bad connection": failed_line(head + "c=IN IP4\r\n") == 5
    ]
    for name, ok in cases {
        testing.error_if(t, !ok, name)
    }
}

fn missing_line(source: str) -> str {
    parse(source) catch {
        Missing(name) => return name
        _ => return "other error"
    }
    ""
}

fn test_a_description_without_a_required_line_is_missing_it(t: *testing.T) {
    testing.error_if(t, missing_line("v=0\r\ns=-\r\n") != "o=", "origin")
    testing.error_if(t, missing_line("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\n") != "s=", "name")
    testing.error_if(t, missing_line("") != "v=", "version")
}

fn test_a_session_without_timings_is_written_with_t_0_0(t: *testing.T) {
    let s = Session { origin: Origin { session_id: "1" } }
    testing.error_if(t, format(s) != "v=0\r\no=- 1 0 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n", "text {text.quote(format(s))}")
}
