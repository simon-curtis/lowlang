import std/text

/// Which way media flows in a media description (RFC 8866 section 6.7).
pub enum Direction {
    /// `sendrecv`: both send and receive.
    SendRecv
    /// `sendonly`: the offerer only sends.
    SendOnly
    /// `recvonly`: the offerer only receives.
    RecvOnly
    /// `inactive`: nothing flows.
    Inactive
}

/// Which side opens the DTLS connection (RFC 4145 and RFC 8842).
pub enum Setup {
    /// `active`: the side starts the handshake as the DTLS client.
    Active
    /// `passive`: the side waits for the handshake as the DTLS server.
    Passive
    /// `actpass`: the side accepts either role, which only an offer may say.
    ActPass
    /// `holdconn`: the connection is not to be made yet.
    Hold
}

/// An `a=group` attribute (RFC 5888): a list of media identifiers that belong together.
pub struct Group {
    /// The semantics, such as `BUNDLE`.
    pub semantics: str
    /// The `mid` values of the media descriptions in the group.
    pub mids: str[]
}

/// An `a=rtpmap` attribute (RFC 8866 section 6.6).
pub struct Rtpmap {
    /// The payload type.
    pub payload_type: i64
    /// The encoding name, such as `opus` or `VP8`.
    pub encoding: str
    /// The clock rate in hertz.
    pub clock_rate: i64
    /// The number of audio channels, 0 when the attribute does not state it.
    pub channels: i64 = 0
}

/// An `a=fmtp` attribute (RFC 8866 section 6.15).
pub struct Fmtp {
    /// The format the parameters belong to, a payload type for RTP.
    pub format: str
    /// The format specific parameters, as written.
    pub parameters: str
}

/// An `a=rtcp-fb` attribute (RFC 4585 section 4.2).
pub struct RtcpFeedback {
    /// The payload type the feedback applies to, or `*` for all.
    pub format: str
    /// The feedback type, such as `nack`, `ccm`, `transport-cc` or `goog-remb`.
    pub kind: str
    /// What follows the type, such as `pli` or `fir`, or empty.
    pub parameter: str = ""
}

/// An `a=extmap` attribute (RFC 8285 section 5).
pub struct Extmap {
    /// The identifier an RTP header extension element carries, 1 to 255.
    pub id: i64
    /// The direction the extension is limited to, or `none` for both.
    pub direction: Direction? = none
    /// The URI that names the extension.
    pub uri: str
    /// The extension attributes after the URI, or empty.
    pub attributes: str = ""
}

/// An `a=ssrc` attribute (RFC 5576 section 4.1).
pub struct Ssrc {
    /// The synchronization source the attribute describes.
    pub id: i64
    /// The source attribute name, such as `cname` or `msid`.
    pub name: str
    /// The text after the colon, or `none` for a source attribute without one.
    pub value: str? = none
}

/// An `a=ssrc-group` attribute (RFC 5576 section 4.2).
pub struct SsrcGroup {
    /// The semantics, such as `FID` or `SIM`.
    pub semantics: str
    /// The synchronization sources in the group.
    pub ssrcs: i64[]
}

/// An `a=msid` attribute (RFC 8830): the media stream and the track a media description carries.
pub struct Msid {
    /// The stream identifier, `-` for a track without a stream.
    pub stream: str
    /// The track identifier, or `none` when the attribute names only the stream.
    pub track: str? = none
}

/// Returns the value of the first attribute named `name`, or `none` when there is none.
///
/// A property attribute that has no value gives the empty string.
pub fn get(attributes: Attribute[], name: str) -> str? {
    for a in attributes {
        if a.name == name {
            return a.value ?? ""
        }
    }
    none
}

/// Returns whether an attribute named `name` is present, with or without a value.
pub fn has(attributes: Attribute[], name: str) -> bool {
    get(attributes, name) != none
}

/// Returns the values of every attribute named `name` in order, the empty string for a property attribute.
pub fn all(attributes: Attribute[], name: str) -> str[] {
    var out: str[] = []
    for a in attributes {
        if a.name == name {
            out.push(a.value ?? "")
        }
    }
    out
}

/// Returns the property attribute `a=name`.
pub fn property(name: str) -> Attribute {
    Attribute { name }
}

/// Returns the attribute `a=name:value`.
pub fn attribute(name: str, value: str) -> Attribute {
    Attribute { name, value }
}

fn inherited(s: Session, m: Media, name: str) -> str? {
    get(m.attributes, name) ?? get(s.attributes, name)
}

fn invalid(name: str, value: str) -> Error {
    Error.Attribute(name, value)
}

fn count_of(name: str, value: str, s: str) -> i64 ! Error {
    let n = text.parse_int(s) or fail invalid(name, value)
    if n < 0 {
        fail invalid(name, value)
    }
    n
}

/// Returns the attribute name of `d`: `sendrecv`, `sendonly`, `recvonly` or `inactive`.
pub fn direction_name(d: Direction) -> str {
    match d {
        SendRecv => "sendrecv"
        SendOnly => "sendonly"
        RecvOnly => "recvonly"
        Inactive => "inactive"
    }
}

fn direction_of(name: str) -> Direction? {
    match name {
        "sendrecv" => Direction.SendRecv
        "sendonly" => Direction.SendOnly
        "recvonly" => Direction.RecvOnly
        "inactive" => Direction.Inactive
        _ => none
    }
}

/// Returns the property attribute for `d`.
pub fn direction_attribute(d: Direction) -> Attribute {
    property(direction_name(d))
}

fn direction_in(attributes: Attribute[]) -> Direction? {
    for a in attributes {
        match direction_of(a.name) {
            some(d) => return d
            none => {}
        }
    }
    none
}

/// Returns the direction of `m`: its own direction attribute, else the session's, else `SendRecv`.
pub fn direction(s: Session, m: Media) -> Direction {
    direction_in(m.attributes) ?? direction_in(s.attributes) ?? Direction.SendRecv
}

/// Returns the attribute value of `p`: `active`, `passive`, `actpass` or `holdconn`.
pub fn setup_name(p: Setup) -> str {
    match p {
        Active => "active"
        Passive => "passive"
        ActPass => "actpass"
        Hold => "holdconn"
    }
}

/// Returns the `a=setup` attribute for `p`.
pub fn setup_attribute(p: Setup) -> Attribute {
    attribute("setup", setup_name(p))
}

/// Returns the setup of `m`, from its own `a=setup` or else the session's, or `none` when neither has one.
///
/// Fails with `Attribute` for a value that is not one of the four.
pub fn setup(s: Session, m: Media) -> Setup? ! Error {
    let value = inherited(s, m, "setup") ?? return none
    match value {
        "active" => Setup.Active
        "passive" => Setup.Passive
        "actpass" => Setup.ActPass
        "holdconn" => Setup.Hold
        _ => fail invalid("setup", value)
    }
}

/// Returns the ICE username fragment of `m`, from its own `a=ice-ufrag` or else the session's.
pub fn ice_ufrag(s: Session, m: Media) -> str? {
    inherited(s, m, "ice-ufrag")
}

/// Returns the ICE password of `m`, from its own `a=ice-pwd` or else the session's.
pub fn ice_pwd(s: Session, m: Media) -> str? {
    inherited(s, m, "ice-pwd")
}

/// Returns the ICE options of `m`, such as `trickle`, from its own `a=ice-options` or else the session's.
pub fn ice_options(s: Session, m: Media) -> str[] {
    text.fields(inherited(s, m, "ice-options") ?? "")
}

/// Returns whether the session has `a=ice-lite`.
pub fn ice_lite(s: Session) -> bool {
    has(s.attributes, "ice-lite")
}

/// Returns the values of the `a=fingerprint` attributes of `m`, or of the session when `m` has none.
///
/// The values are in the form `std/dtls`'s `parse_fingerprint` reads.
pub fn fingerprints(s: Session, m: Media) -> str[] {
    let own = all(m.attributes, "fingerprint")
    if own.len > 0 { own } else { all(s.attributes, "fingerprint") }
}

/// Returns the `a=mid` value of `m`.
pub fn mid(m: Media) -> str? {
    get(m.attributes, "mid")
}

/// Returns the `a=group` attributes of the session.
///
/// Fails with `Attribute` for one without semantics.
pub fn groups(s: Session) -> Group[] ! Error {
    var out: Group[] = []
    for value in all(s.attributes, "group") {
        let f = text.fields(value)
        if f.len == 0 {
            fail invalid("group", value)
        }
        out.push(Group { semantics: f[0], mids: f[1..] })
    }
    out
}

/// Returns the group attribute for `g`.
pub fn group_attribute(g: Group) -> Attribute {
    attribute("group", "{g.semantics} {text.join(g.mids, " ")}")
}

/// Returns the `mid` values of the first `BUNDLE` group of the session, or an empty list when there is none.
pub fn bundle(s: Session) -> str[] ! Error {
    for g in groups(s)? {
        if g.semantics == "BUNDLE" {
            return g.mids
        }
    }
    []
}

/// Returns the values of the `a=candidate` attributes of `m`, which `std/ice`'s `parse` reads.
pub fn candidates(m: Media) -> str[] {
    all(m.attributes, "candidate")
}

/// Returns whether `m` or the session has `a=end-of-candidates`.
pub fn end_of_candidates(s: Session, m: Media) -> bool {
    has(m.attributes, "end-of-candidates") || has(s.attributes, "end-of-candidates")
}

/// Returns whether `m` describes a data channel transport (RFC 8841): an application media description over `UDP/DTLS/SCTP` or `TCP/DTLS/SCTP` whose format is `webrtc-datachannel`.
pub fn is_data_channel(m: Media) -> bool {
    m.kind == "application" && text.ends_with(m.protocol, "DTLS/SCTP") && m.formats.len == 1 && m.formats[0] == "webrtc-datachannel"
}

/// Returns the SCTP port of `m` from `a=sctp-port`, or `none` when it has none.
///
/// Fails with `Attribute` for a value that is not a port.
pub fn sctp_port(m: Media) -> i64? ! Error {
    let value = get(m.attributes, "sctp-port") ?? return none
    let port = count_of("sctp-port", value, value)?
    if port > 65535 {
        fail invalid("sctp-port", value)
    }
    port
}

/// Returns the largest message `m` accepts from `a=max-message-size`, where 0 means no limit, or `none` when it has none.
///
/// Fails with `Attribute` for a value that is not a number.
pub fn max_message_size(m: Media) -> i64? ! Error {
    let value = get(m.attributes, "max-message-size") ?? return none
    count_of("max-message-size", value, value)?
}

fn split_first(value: str) -> str[] {
    let space = text.index_byte(value, ' ')
    if space < 0 {
        return [value]
    }
    [value[..space], text.trim_start(value[space + 1..])]
}

fn parse_rtpmap(value: str) -> Rtpmap ! Error {
    let halves = split_first(value)
    if halves.len != 2 {
        fail invalid("rtpmap", value)
    }
    let parts = text.split(halves[1], '/')
    if parts.len < 2 || parts.len > 3 || parts[0].len == 0 {
        fail invalid("rtpmap", value)
    }
    var channels = 0
    if parts.len == 3 {
        channels = count_of("rtpmap", value, parts[2])?
    }
    Rtpmap { payload_type: count_of("rtpmap", value, halves[0])?, encoding: parts[0], clock_rate: count_of("rtpmap", value, parts[1])?, channels }
}

/// Returns the `a=rtpmap` attributes of `m`.
///
/// Fails with `Attribute` for one that is not `<payload type> <encoding>/<clock rate>[/<channels>]`.
pub fn rtpmaps(m: Media) -> Rtpmap[] ! Error {
    var out: Rtpmap[] = []
    for value in all(m.attributes, "rtpmap") {
        out.push(parse_rtpmap(value)?)
    }
    out
}

/// Returns the `a=rtpmap` attribute for `r`.
pub fn rtpmap_attribute(r: Rtpmap) -> Attribute {
    let channels = if r.channels > 0 { "/{r.channels}" } else { "" }
    attribute("rtpmap", "{r.payload_type} {r.encoding}/{r.clock_rate}{channels}")
}

/// Returns the `a=fmtp` attributes of `m`.
///
/// Fails with `Attribute` for one without a format and parameters.
pub fn fmtps(m: Media) -> Fmtp[] ! Error {
    var out: Fmtp[] = []
    for value in all(m.attributes, "fmtp") {
        let halves = split_first(value)
        if halves.len != 2 {
            fail invalid("fmtp", value)
        }
        out.push(Fmtp { format: halves[0], parameters: halves[1] })
    }
    out
}

/// Returns the `a=fmtp` attribute for `f`.
pub fn fmtp_attribute(f: Fmtp) -> Attribute {
    attribute("fmtp", "{f.format} {f.parameters}")
}

/// Returns the `a=rtcp-fb` attributes of `m`.
///
/// Fails with `Attribute` for one without a format and a type.
pub fn feedbacks(m: Media) -> RtcpFeedback[] ! Error {
    var out: RtcpFeedback[] = []
    for value in all(m.attributes, "rtcp-fb") {
        let halves = split_first(value)
        if halves.len != 2 {
            fail invalid("rtcp-fb", value)
        }
        let rest = split_first(halves[1])
        out.push(RtcpFeedback { format: halves[0], kind: rest[0], parameter: if rest.len == 2 { rest[1] } else { "" } })
    }
    out
}

/// Returns the `a=rtcp-fb` attribute for `f`.
pub fn feedback_attribute(f: RtcpFeedback) -> Attribute {
    let parameter = if f.parameter.len > 0 { " {f.parameter}" } else { "" }
    attribute("rtcp-fb", "{f.format} {f.kind}{parameter}")
}

fn parse_extmap(value: str) -> Extmap ! Error {
    let halves = split_first(value)
    if halves.len != 2 {
        fail invalid("extmap", value)
    }
    let rest = split_first(halves[1])
    let slash = text.index_byte(halves[0], '/')
    var id_text = halves[0]
    var direction: Direction? = none
    if slash >= 0 {
        id_text = halves[0][..slash]
        direction = direction_of(halves[0][slash + 1..])
        if direction == none {
            fail invalid("extmap", value)
        }
    }
    let id = count_of("extmap", value, id_text)?
    if id < 1 || id > 255 {
        fail invalid("extmap", value)
    }
    Extmap { id, direction, uri: rest[0], attributes: if rest.len == 2 { rest[1] } else { "" } }
}

/// Returns the `a=extmap` attributes of `m`, then those of the session, which apply to every media description that does not name the same identifier.
///
/// Fails with `Attribute` for one whose identifier is outside 1 to 255, whose direction is unknown or that has no URI.
pub fn extmaps(s: Session, m: Media) -> Extmap[] ! Error {
    var out: Extmap[] = []
    for value in all(m.attributes, "extmap") {
        out.push(parse_extmap(value)?)
    }
    for value in all(s.attributes, "extmap") {
        out.push(parse_extmap(value)?)
    }
    out
}

/// Returns the `a=extmap` attribute for `e`.
pub fn extmap_attribute(e: Extmap) -> Attribute {
    let direction = match e.direction {
        some(d) => "/{direction_name(d)}"
        none => ""
    }
    let attributes = if e.attributes.len > 0 { " {e.attributes}" } else { "" }
    attribute("extmap", "{e.id}{direction} {e.uri}{attributes}")
}

/// Returns whether `m` has `a=rtcp-mux`.
pub fn rtcp_mux(m: Media) -> bool {
    has(m.attributes, "rtcp-mux")
}

/// Returns whether `m` has `a=rtcp-rsize`.
pub fn rtcp_rsize(m: Media) -> bool {
    has(m.attributes, "rtcp-rsize")
}

fn parse_msid(value: str) -> Msid ! Error {
    let f = text.fields(value)
    if f.len == 0 || f.len > 2 {
        fail invalid("msid", value)
    }
    Msid { stream: f[0], track: if f.len == 2 { f[1] } else { none } }
}

/// Returns the `a=msid` attributes of `m`.
///
/// Fails with `Attribute` for one that is not a stream identifier with an optional track identifier.
pub fn msids(m: Media) -> Msid[] ! Error {
    var out: Msid[] = []
    for value in all(m.attributes, "msid") {
        out.push(parse_msid(value)?)
    }
    out
}

/// Returns the `a=msid` attribute for `i`.
pub fn msid_attribute(i: Msid) -> Attribute {
    match i.track {
        some(track) => attribute("msid", "{i.stream} {track}")
        none => attribute("msid", i.stream)
    }
}

/// Returns the `a=ssrc` attributes of `m`.
///
/// Fails with `Attribute` for one without a numeric source.
pub fn ssrcs(m: Media) -> Ssrc[] ! Error {
    var out: Ssrc[] = []
    for value in all(m.attributes, "ssrc") {
        let halves = split_first(value)
        if halves.len != 2 {
            fail invalid("ssrc", value)
        }
        let id = count_of("ssrc", value, halves[0])?
        let parsed = parse_attribute(halves[1])
        out.push(Ssrc { id, name: parsed.name, value: parsed.value })
    }
    out
}

/// Returns the `a=ssrc` attribute for `r`.
pub fn ssrc_attribute(r: Ssrc) -> Attribute {
    match r.value {
        some(v) => attribute("ssrc", "{r.id} {r.name}:{v}")
        none => attribute("ssrc", "{r.id} {r.name}")
    }
}

/// Returns the `a=ssrc-group` attributes of `m`.
///
/// Fails with `Attribute` for one without semantics or with a source that is not a number.
pub fn ssrc_groups(m: Media) -> SsrcGroup[] ! Error {
    var out: SsrcGroup[] = []
    for value in all(m.attributes, "ssrc-group") {
        let f = text.fields(value)
        if f.len == 0 {
            fail invalid("ssrc-group", value)
        }
        var sources: i64[] = []
        for id in f[1..] {
            sources.push(count_of("ssrc-group", value, id)?)
        }
        out.push(SsrcGroup { semantics: f[0], ssrcs: sources })
    }
    out
}

/// Returns the `a=ssrc-group` attribute for `g`.
pub fn ssrc_group_attribute(g: SsrcGroup) -> Attribute {
    var parts: str[] = [g.semantics]
    for id in g.ssrcs {
        parts.push("{id}")
    }
    attribute("ssrc-group", text.join(parts, " "))
}
