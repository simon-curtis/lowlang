import std/sdp
import std/text

fn main() {
    let offer = sdp.parse("v=0\r\no=- 4611731400430051336 2 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\na=group:BUNDLE 0\r\nm=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\nc=IN IP4 0.0.0.0\r\na=ice-ufrag:f5Yc\r\na=ice-pwd:3j7ZB9Qxg5o2FZ1tn2eGyF1d\r\na=ice-options:trickle\r\na=fingerprint:sha-256 7B:8B:F0:65:5F:78:E2:51:3B:AC:6F:F3:3F:46:1B:35:DC:B8:5F:64:1A:24:C2:43:F0:A1:58:D0:A1:2C:19:08\r\na=setup:actpass\r\na=mid:0\r\na=sctp-port:5000\r\na=max-message-size:262144\r\n") or return
    let data = offer.media[0]
    print("{data.kind} {data.protocol} mid {sdp.mid(data) ?? "?"}, data channel {sdp.is_data_channel(data)}")
    print("ufrag {sdp.ice_ufrag(offer, data) ?? "?"}, trickle {sdp.ice_options(offer, data)[0] == "trickle"}")
    print("sctp port {(sdp.sctp_port(data) or none) ?? 0}, largest message {(sdp.max_message_size(data) or none) ?? 0}")
    print("bundle {(sdp.bundle(offer) or [])}")
    let setup = (sdp.setup(offer, data) or none) ?? sdp.Setup.ActPass
    print("offer setup {sdp.setup_name(setup)}")

    let answer = sdp.Session {
        origin: sdp.Origin { session_id: "1", session_version: "2" }
        attributes: [sdp.group_attribute(sdp.Group { semantics: "BUNDLE", mids: ["0"] })]
        media: [
            sdp.Media {
                kind: data.kind
                protocol: data.protocol
                formats: data.formats
                connections: [sdp.Connection { address: "0.0.0.0" }]
                attributes: [
                    sdp.attribute("ice-ufrag", "kQ2d")
                    sdp.attribute("ice-pwd", "Jx0v8dqLw7yZfW1mU4c3Rk9a")
                    sdp.attribute("fingerprint", sdp.get(data.attributes, "fingerprint") ?? "")
                    sdp.setup_attribute(sdp.Setup.Active)
                    sdp.attribute("mid", "0")
                    sdp.attribute("sctp-port", "5000")
                ]
            }
        ]
    }
    print(text.trim_end(text.replace(sdp.format(answer), "\r\n", "\n")))
}
