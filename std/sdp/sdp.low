import std/text

/// Why a session description did not parse.
pub enum Error {
    /// Line `number`, counting from 1, is not valid for the reason `reason`.
    Line(number: i64, reason: str)
    /// The attribute `name` has the value `value`, which does not have the form the attribute defines.
    Attribute(name: str, value: str)
    /// The description lacks the line or attribute `name` that it needs.
    Missing(name: str)
}

/// The `o=` line (RFC 8866 section 5.2): who created the description and which version of it this is.
pub struct Origin {
    /// The user name, `-` when the host has none.
    pub username: str = "-"
    /// The session identifier, a decimal number that stays the same for the life of the session.
    pub session_id: str
    /// The version, a decimal number that rises with every change to the description.
    pub session_version: str = "0"
    /// The network type, `IN`.
    pub net_type: str = "IN"
    /// The address type, `IP4` or `IP6`.
    pub addr_type: str = "IP4"
    /// The address of the machine that made the description, as written.
    pub address: str = "127.0.0.1"
}

/// A `c=` line (RFC 8866 section 5.7).
pub struct Connection {
    /// The network type, `IN`.
    pub net_type: str = "IN"
    /// The address type, `IP4` or `IP6`.
    pub addr_type: str = "IP4"
    /// The address as written, with a time to live or an address count after a `/` for a multicast address.
    pub address: str
}

/// A `b=` line (RFC 8866 section 5.8).
pub struct Bandwidth {
    /// The bandwidth type, such as `AS` or `TIAS`.
    pub kind: str
    /// The value, in the unit the type defines.
    pub value: i64
}

/// A `t=` line (RFC 8866 section 5.9) with the `r=` lines that follow it.
pub struct Timing {
    /// The start time in seconds since 1900, 0 for a session that is not bounded.
    pub start: i64 = 0
    /// The stop time in seconds since 1900, 0 for a session that is not bounded.
    pub stop: i64 = 0
    /// The values of the `r=` lines of the timing, as written.
    pub repeats: str[] = []
}

/// An `a=` line (RFC 8866 section 5.13).
pub struct Attribute {
    /// The name before the first colon.
    pub name: str
    /// The text after the first colon, or `none` for a property attribute that has no colon.
    pub value: str? = none
}

/// A media description: its `m=` line and the lines that follow it up to the next `m=`.
pub struct Media {
    /// The media type: `audio`, `video`, `application` and so on.
    pub kind: str
    /// The port, 9 when the description relies on ICE for addresses.
    pub port: i64 = 9
    /// The number of consecutive ports that follow `port`, 1 unless the line has a `/` after the port.
    pub port_count: i64 = 1
    /// The transport protocol, such as `UDP/TLS/RTP/SAVPF` or `UDP/DTLS/SCTP`.
    pub protocol: str
    /// The media formats: payload type numbers for an RTP protocol and `webrtc-datachannel` for a data channel.
    pub formats: str[] = []
    /// The `i=` line, the title of the media.
    pub title: str? = none
    /// The `c=` lines.
    pub connections: Connection[] = []
    /// The `b=` lines.
    pub bandwidths: Bandwidth[] = []
    /// The `k=` line, as written.
    pub key: str? = none
    /// The `a=` lines in the order they appear.
    pub attributes: Attribute[] = []
}

/// A session description (RFC 8866).
pub struct Session {
    /// The `o=` line.
    pub origin: Origin
    /// The `s=` line, `-` when the session has no name.
    pub name: str = "-"
    /// The `i=` line.
    pub info: str? = none
    /// The `u=` line.
    pub uri: str? = none
    /// The `e=` lines.
    pub emails: str[] = []
    /// The `p=` lines.
    pub phones: str[] = []
    /// The `c=` lines of the session level.
    pub connections: Connection[] = []
    /// The `b=` lines of the session level.
    pub bandwidths: Bandwidth[] = []
    /// The `t=` lines. `format` writes `t=0 0` for a session that has none.
    pub timings: Timing[] = []
    /// The `z=` line, as written.
    pub zone: str? = none
    /// The `k=` line, as written.
    pub key: str? = none
    /// The `a=` lines of the session level, in the order they appear.
    pub attributes: Attribute[] = []
    /// The media descriptions in the order they appear.
    pub media: Media[] = []
}

struct Entry {
    number: i64
    kind: u8
    value: str
}

fn read_lines(source: str) -> Entry[] ! Error {
    var out: Entry[] = []
    for i, raw in text.lines(source) {
        if raw.len < 2 || raw[1] != '=' {
            fail Line(i + 1, "not a type=value line")
        }
        out.push(Entry { number: i + 1, kind: raw[0], value: raw[2..] })
    }
    out
}

fn number_of(line: Entry, s: str) -> i64 ! Error {
    let n = text.parse_int(s) or fail Line(line.number, "not a number")
    if n < 0 {
        fail Line(line.number, "negative number")
    }
    n
}

fn parse_connection(line: Entry) -> Connection ! Error {
    let f = text.split(line.value, ' ')
    if f.len != 3 || f[2].len == 0 {
        fail Line(line.number, "c= needs a network type, an address type and an address")
    }
    Connection { net_type: f[0], addr_type: f[1], address: f[2] }
}

fn parse_bandwidth(line: Entry) -> Bandwidth ! Error {
    let colon = text.index_byte(line.value, ':')
    if colon <= 0 {
        fail Line(line.number, "b= needs a type, a colon and a value")
    }
    Bandwidth { kind: line.value[..colon], value: number_of(line, line.value[colon + 1..])? }
}

fn parse_attribute(value: str) -> Attribute {
    let colon = text.index_byte(value, ':')
    if colon < 0 {
        return Attribute { name: value }
    }
    Attribute { name: value[..colon], value: value[colon + 1..] }
}

fn parse_origin(line: Entry) -> Origin ! Error {
    let f = text.split(line.value, ' ')
    if f.len != 6 {
        fail Line(line.number, "o= needs six fields")
    }
    Origin { username: f[0], session_id: f[1], session_version: f[2], net_type: f[3], addr_type: f[4], address: f[5] }
}

fn parse_timing(line: Entry) -> Timing ! Error {
    let f = text.split(line.value, ' ')
    if f.len != 2 {
        fail Line(line.number, "t= needs a start and a stop time")
    }
    Timing { start: number_of(line, f[0])?, stop: number_of(line, f[1])? }
}

fn duplicate(line: Entry) -> Error {
    Error.Line(line.number, "more than one line of this type")
}

fn parse_media_line(line: Entry) -> Media ! Error {
    let f = text.split(line.value, ' ')
    if f.len < 4 {
        fail Line(line.number, "m= needs a media type, a port, a protocol and a format")
    }
    var port = f[1]
    var port_count = 1
    let slash = text.index_byte(port, '/')
    if slash >= 0 {
        port_count = number_of(line, port[slash + 1..])?
        port = port[..slash]
        if port_count < 1 {
            fail Line(line.number, "port count below 1")
        }
    }
    let number = number_of(line, port)?
    if number > 65535 {
        fail Line(line.number, "port above 65535")
    }
    Media { kind: f[0], port: number, port_count, protocol: f[2], formats: f[3..] }
}

fn parse_media(head: Entry, lines: Entry[]) -> Media ! Error {
    var media = parse_media_line(head)?
    for line in lines {
        match line.kind {
            'i' => {
                if media.title != none {
                    fail duplicate(line)
                }
                media.title = line.value
            }
            'c' => media.connections.push(parse_connection(line)?)
            'b' => media.bandwidths.push(parse_bandwidth(line)?)
            'k' => {
                if media.key != none {
                    fail duplicate(line)
                }
                media.key = line.value
            }
            'a' => media.attributes.push(parse_attribute(line.value))
            _ => fail Line(line.number, "line type not allowed in a media description")
        }
    }
    media
}

fn parse_header(lines: Entry[]) -> Session ! Error {
    var origin: Origin? = none
    var name: str? = none
    var session = Session { origin: Origin { session_id: "0" } }
    for line in lines {
        match line.kind {
            'o' => {
                if origin != none {
                    fail duplicate(line)
                }
                origin = parse_origin(line)?
            }
            's' => {
                if name != none {
                    fail duplicate(line)
                }
                name = line.value
            }
            'i' => {
                if session.info != none {
                    fail duplicate(line)
                }
                session.info = line.value
            }
            'u' => {
                if session.uri != none {
                    fail duplicate(line)
                }
                session.uri = line.value
            }
            'e' => session.emails.push(line.value)
            'p' => session.phones.push(line.value)
            'c' => session.connections.push(parse_connection(line)?)
            'b' => session.bandwidths.push(parse_bandwidth(line)?)
            't' => session.timings.push(parse_timing(line)?)
            'r' => {
                if session.timings.len == 0 {
                    fail Line(line.number, "r= before any t=")
                }
                session.timings[session.timings.len - 1].repeats.push(line.value)
            }
            'z' => {
                if session.zone != none {
                    fail duplicate(line)
                }
                session.zone = line.value
            }
            'k' => {
                if session.key != none {
                    fail duplicate(line)
                }
                session.key = line.value
            }
            'a' => session.attributes.push(parse_attribute(line.value))
            _ => fail Line(line.number, "unknown line type")
        }
    }
    session.origin = origin ?? fail Missing("o=")
    session.name = name ?? fail Missing("s=")
    session
}

/// Parses a session description, with lines ended by CRLF or by LF alone.
///
/// The lines `v=0`, `o=` and `s=` are required, and the `v=` line comes first. The lines of a section may come in any order; `a=` lines keep theirs. Fails with `Line` for a line that is empty, has no `type=` prefix, has a type RFC 8866 does not define, appears twice where only one is allowed or whose fields do not parse.
pub fn parse(source: str) -> Session ! Error {
    let lines = read_lines(source)?
    if lines.len == 0 {
        fail Missing("v=")
    }
    if lines[0].kind != 'v' || lines[0].value != "0" {
        fail Line(lines[0].number, "the description must start with v=0")
    }
    var first_media = lines.len
    for i in 1..lines.len {
        if lines[i].kind == 'm' {
            first_media = i
            break
        }
        if lines[i].kind == 'v' {
            fail duplicate(lines[i])
        }
    }
    var session = parse_header(lines[1..first_media])?
    var at = first_media
    for at < lines.len {
        var end = at + 1
        for end < lines.len && lines[end].kind != 'm' {
            end += 1
        }
        session.media.push(parse_media(lines[at], lines[at + 1..end])?)
        at = end
    }
    session
}

fn format_connection(c: Connection) -> str {
    "c={c.net_type} {c.addr_type} {c.address}"
}

fn format_origin(o: Origin) -> str {
    "o={o.username} {o.session_id} {o.session_version} {o.net_type} {o.addr_type} {o.address}"
}

fn format_attribute(a: Attribute) -> str {
    match a.value {
        some(v) => "a={a.name}:{v}"
        none => "a={a.name}"
    }
}

fn format_media_line(m: Media) -> str {
    let port = if m.port_count == 1 { "{m.port}" } else { "{m.port}/{m.port_count}" }
    "m={m.kind} {port} {m.protocol} {text.join(m.formats, " ")}"
}

fn push_common(mut out: str[], title: str?, connections: Connection[], bandwidths: Bandwidth[], key: str?, attributes: Attribute[]) {
    match title {
        some(t) => out.push("i={t}")
        none => {}
    }
    for c in connections {
        out.push(format_connection(c))
    }
    for b in bandwidths {
        out.push("b={b.kind}:{b.value}")
    }
    match key {
        some(k) => out.push("k={k}")
        none => {}
    }
    for a in attributes {
        out.push(format_attribute(a))
    }
}

/// Returns `s` as text, one line per entry in the order of RFC 8866 section 5, each ended by CRLF.
///
/// A session without a `t=` line gets `t=0 0`. `parse` reads the result back to an equal value, and `format` of what `parse` read from a description in that order returns the same text.
pub fn format(s: Session) -> str {
    var out: str[] = ["v=0", format_origin(s.origin), "s={s.name}"]
    match s.info {
        some(i) => out.push("i={i}")
        none => {}
    }
    match s.uri {
        some(u) => out.push("u={u}")
        none => {}
    }
    for e in s.emails {
        out.push("e={e}")
    }
    for p in s.phones {
        out.push("p={p}")
    }
    for c in s.connections {
        out.push(format_connection(c))
    }
    for b in s.bandwidths {
        out.push("b={b.kind}:{b.value}")
    }
    if s.timings.len == 0 {
        out.push("t=0 0")
    }
    for t in s.timings {
        out.push("t={t.start} {t.stop}")
        for r in t.repeats {
            out.push("r={r}")
        }
    }
    match s.zone {
        some(z) => out.push("z={z}")
        none => {}
    }
    match s.key {
        some(k) => out.push("k={k}")
        none => {}
    }
    for a in s.attributes {
        out.push(format_attribute(a))
    }
    for m in s.media {
        out.push(format_media_line(m))
        out.push_common(m.title, m.connections, m.bandwidths, m.key, m.attributes)
    }
    out.push("")
    text.join(out, "\r\n")
}
