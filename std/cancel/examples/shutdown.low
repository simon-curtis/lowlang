import std/cancel
import std/io

fn run_steps(t: *cancel.Token, steps: []str, name: str) ! io.Error {
    for step in steps {
        cancel.check(t)?
        print("{name}: {step}")
    }
}

fn watch(t: *cancel.Token, name: str, stopped: chan[str]) {
    let waited = cancel.pause(t, 60000)
    stopped <- "{name} stopped, waited the full time: {waited}"
}

/// A shutdown token cancels a job and a watcher through child tokens, and a callback releases the job's resources.
fn main() {
    let shutdown = cancel.token()
    let job = cancel.child(shutdown)
    let stopped = chan[str]()
    spawn watch(job, "watcher", stopped)

    using cleanup = cancel.on_cancel(job, fn() { print("job cancelled: removing temporary files") })

    let steps = ["fetch", "unpack", "compress", "upload"]
    run_steps(job, steps[..2], "job") catch {
        _ => print("job aborted early")
    }

    cancel.cancel(shutdown)
    print("shutdown cancelled: {cancel.cancelled(shutdown)}, job cancelled: {cancel.cancelled(job)}")

    run_steps(job, steps[2..], "job") catch {
        Aborted => print("job aborted before compress")
        _ => print("job failed")
    }
    print(<-stopped ?? "")

    let late = cancel.child(shutdown)
    print("child made after shutdown is cancelled: {cancel.cancelled(late)}")
    print("pause on it returns at once: {cancel.pause(late, 60000)}")

    let own = cancel.token()
    let sibling = cancel.child(own)
    cancel.cancel(sibling)
    print("cancelling a child leaves its parent running: {!cancel.cancelled(own)}")
}
