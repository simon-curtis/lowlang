import std/time
import std/time/duration

fn producer(out: chan[i64], gap: duration.Duration, count: i64) {
    for n in 1..count + 1 {
        time.sleep_for(gap)
        out <- n
    }
}

fn collect(source: chan[i64], expected: i64, limit: duration.Duration) -> []i64 {
    var received: []i64 = []
    let deadline = time.timer(limit)
    for received.len < expected {
        let next = select {
            n = <-source => n ?? break
            <-deadline.fired => break
        }
        push(mut received, next)
    }
    time.stop_timer(deadline)
    received
}

/// Collects results from a producer under a deadline, then shows a stalled producer hitting it.
fn main() {
    let watch = time.start()

    let steady = chan[i64](4)
    spawn producer(steady, duration.milliseconds(5), 3)
    let first = collect(steady, 3, duration.seconds(5))
    print("steady producer delivered {first.len} of 3: {first}")

    let stalled = chan[i64](4)
    spawn producer(stalled, duration.seconds(30), 1)
    let second = collect(stalled, 1, duration.milliseconds(50))
    print("stalled producer delivered {second.len} of 1")

    let waited = watch.elapsed()
    print("waited at least the deadline: {duration.after(waited, duration.milliseconds(50))}")
    print("waited less than the stall: {duration.before(waited, duration.seconds(10))}")
}
