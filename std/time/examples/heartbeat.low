import std/time
import std/time/duration

/// Runs a periodic check on a ticker until it has passed three times, then cancels a pending timeout.
fn main() {
    let watch = time.start()
    let beat = time.ticker(duration.milliseconds(10))
    let give_up = time.timer(duration.seconds(10))

    var checks = 0
    for checks < 3 {
        select {
            <-beat.ticks => {
                checks += 1
                print("check {checks}")
            }
            <-give_up.fired => {
                print("gave up")
                break
            }
        }
    }
    time.stop_ticker(beat)
    print("timeout cancelled: {time.stop_timer(give_up)}")
    print("three periods took at least 30ms: {duration.after(watch.elapsed(), duration.milliseconds(29))}")

    time.sleep_for(duration.milliseconds(5))
    print("wall clock is after 2020: {time.now() > 1577836800}")
    let first = time.monotonic()
    let second = time.monotonic()
    print("monotonic never goes back: {second >= first}")
}
