import std/locale
import std/locale/reltime
import std/time/duration
import std/time/humanize

fn show(tag: str, d: duration.Duration) {
    let l = locale.parse(tag) or locale.root()
    let long = humanize.ago_in(l, d, reltime.Width.Long) or "?"
    let short = humanize.ago_in(l, d, reltime.Width.Short) or "?"
    print("{tag}: {long} | {short}")
}

fn main() {
    let past = duration.hours(3)
    show("en", past)
    show("de", past)
    show("fr", past)
    show("ja", past)
    show("ar", past)
    show("en", duration.seconds(-172800))
    show("es", duration.seconds(2))
}
