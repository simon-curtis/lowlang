extern "c" {
    fn clock_gettime(clock: i32, mut spec: Timespec) -> i32
}

extern struct Timespec {
    sec: i64 = 0
    nsec: i64 = 0
}

pub struct Instant {
    nanos: i64 = 0
}

pub struct Duration {
    pub nanos: i64
}

fn clock(id: i32) -> i64 {
    var spec = Timespec {}
    clock_gettime(id, mut spec)
    spec.sec * 1000000000 + spec.nsec
}

pub fn now() -> Instant {
    Instant { nanos: clock(1) }
}

pub fn elapsed(start: Instant) -> Duration {
    Duration { nanos: clock(1) - start.nanos }
}

pub fn between(start: Instant, end: Instant) -> Duration {
    Duration { nanos: end.nanos - start.nanos }
}

pub fn unix() -> i64 {
    clock(0) / 1000000000
}

pub fn unix_nanos() -> i64 {
    clock(0)
}

pub fn micros(d: Duration) -> f64 {
    f64(d.nanos) / 1000.0
}

pub fn millis(d: Duration) -> f64 {
    f64(d.nanos) / 1000000.0
}

pub fn seconds(d: Duration) -> f64 {
    f64(d.nanos) / 1000000000.0
}
