import std/math
import std/text
import std/time/rounding

struct Policy {
    name: str
    mode: rounding.Rounding
}

fn whole_cents(tenths: i64, mode: rounding.Rounding) -> i64 {
    let q = math.floor_div(tenths, 10)
    let r = math.floor_mod(tenths, 10)
    rounding.apply(q, r, 10, mode)
}

/// Rounds amounts held in tenths of a cent to whole cents under each rounding mode, for charges and refunds.
fn main() {
    let policies = [
        Policy { name: "Trunc", mode: rounding.Rounding.Trunc },
        Policy { name: "Ceil", mode: rounding.Rounding.Ceil },
        Policy { name: "Floor", mode: rounding.Rounding.Floor },
        Policy { name: "Expand", mode: rounding.Rounding.Expand },
        Policy { name: "HalfExpand", mode: rounding.Rounding.HalfExpand },
        Policy { name: "HalfEven", mode: rounding.Rounding.HalfEven },
        Policy { name: "HalfTrunc", mode: rounding.Rounding.HalfTrunc },
        Policy { name: "HalfCeil", mode: rounding.Rounding.HalfCeil },
        Policy { name: "HalfFloor", mode: rounding.Rounding.HalfFloor }
    ]
    let amounts = [124, 125, 135, 126, -124, -125, -135, -126]

    var header = text.pad_right("tenths", 11, ' ')
    for amount in amounts {
        header = "{header}{text.pad_left("{amount}", 5, ' ')}"
    }
    print(header)

    for policy in policies {
        var row = text.pad_right(policy.name, 11, ' ')
        for amount in amounts {
            row = "{row}{text.pad_left("{whole_cents(amount, policy.mode)}", 5, ' ')}"
        }
        print(row)
    }

    let exact = rounding.apply(12, 0, 10, rounding.Rounding.Ceil)
    print("an exact multiple never moves: {exact}")
}
