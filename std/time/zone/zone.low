import std/file
import std/os
import std/slices
import std/text
import std/time/fault
import std/time/offset
import std/time/timestamp

/// A time zone: a name and the rules that give the UTC offset at each instant.
///
/// Copies of a `Zone` share the same rules. A zone is made by `named`, `local`, `load_from`, `from_posix`, `fixed` or `utc`.
pub struct Zone {
    name: str
    rules: *Rules
}

/// The offset, abbreviation and daylight saving flag in force in a zone over some period.
pub struct Info {
    /// The offset from UTC.
    pub offset: offset.Offset
    /// The zone abbreviation, such as `CET` or `PDT`.
    pub abbreviation: str
    /// Whether daylight saving time is in effect.
    pub dst: bool
}

/// A change in a zone's `Info` at one instant.
pub struct Transition {
    /// The instant the change takes effect.
    pub at: timestamp.Timestamp
    /// The `Info` in force just before `at`.
    pub before: Info
    /// The `Info` in force from `at`.
    pub after: Info
}

/// The offsets a zone allows for one local date and time, which a local time needs because daylight saving changes can repeat it or skip it.
pub enum Candidates {
    /// The local time occurs once, at `only`.
    One(only: offset.Offset)
    /// The local time occurs twice because the clocks go back. `earlier` is the offset of the first occurrence and `later` is the offset of the second.
    Overlap(earlier: offset.Offset, later: offset.Offset)
    /// The local time does not occur because the clocks go forward. `before` is the offset in force before the change and `after` is the offset after it.
    Gap(before: offset.Offset, after: offset.Offset)
}

const transition_limit = 10000
const zoneinfo_root = "/usr/share/zoneinfo"

fn fixed_kind(o: offset.Offset) -> Kind {
    let label = if offset.is_utc(o) { "UTC" } else { offset.to_string(o) }
    Kind { offset: o, dst: false, abbreviation: label }
}

/// Returns a zone that always has the offset `o`.
///
/// It is named `UTC` for a zero offset and otherwise by the offset text, such as `+05:30`, and that is also its abbreviation.
pub fn fixed(o: offset.Offset) -> Zone {
    let kind = fixed_kind(o)
    Zone { name: kind.abbreviation, rules: new(Rules { times: [], segments: [], before: kind, last: kind, footer: none }) }
}

/// Returns the zone with a zero offset, named `UTC`.
pub fn utc() -> Zone {
    fixed(offset.utc())
}

/// Returns a zone described by the POSIX `TZ` rule `rule`, named `name`.
///
/// A rule such as `CET-1CEST,M3.5.0,M10.5.0/3` has standard and daylight names, offsets and the dates the daylight period starts and ends. A rule without daylight saving gives a fixed zone. Fails with `Syntax` at the offset of the first byte of the rule that does not fit.
pub fn from_posix(rule: str, name: str) -> Zone ! fault.Fault {
    let footer = parse_rule(rule)?
    let kind = footer.standard
    Zone { name, rules: new(Rules { times: [], segments: [], before: kind, last: kind, footer }) }
}

/// Returns the name of `z`.
pub fn name(z: Zone) -> str {
    z.name
}

/// Returns whether `z` has a single offset for all time, with no recorded transitions and no daylight saving rule.
pub fn is_fixed(z: Zone) -> bool {
    let r = z.rules
    if r.times.len > 0 {
        return false
    }
    match r.footer {
        some(f) => f.daylight == none
        none => true
    }
}

/// Returns the offset of `z` when `z` is the zone `fixed` makes for it, and `none` for every other zone.
///
/// A zone from `from_posix`, `decode` or a database file is not such a zone, even when its offset never changes, because `fixed` also decides the name.
pub fn fixed_offset(z: Zone) -> offset.Offset? {
    if !is_fixed(z) {
        return none
    }
    let o = z.rules.last.offset
    if z.name == fixed_kind(o).abbreviation { some(o) } else { none }
}

fn check_name(name: str) ! fault.Fault {
    if name.len == 0 || name[0] == '/' || text.contains(name, "..") || text.index_byte(name, '\0') >= 0 || text.index_byte(name, '\\') >= 0 {
        fail Invalid("zone name")
    }
}

fn try_read(path: str) -> []u8? ! fault.Fault {
    let data = file.read_file(path) catch {
        NotFound => return none
        NotDir => return none
        IsDir => return none
        e => fail Malformed("zone file {path}: unreadable")
    }
    data
}

fn find_file(name: str) -> []u8? ! fault.Fault {
    let dir = os.env("ZONEINFO") ?? ""
    if dir.len > 0 {
        match try_read("{dir}/{name}")? {
            some(data) => return data
            none => {}
        }
    }
    try_read("{zoneinfo_root}/{name}")
}

/// Returns the zone with the IANA name `name`, such as `Europe/Paris`.
///
/// The name is read from the directory in the `ZONEINFO` environment variable when it is set and has the file, and then from `/usr/share/zoneinfo`. Fails with `Invalid` when the name is empty, starts with `/`, or contains `..`, a backslash or a NUL byte. Fails with `UnknownZone` when no file has the name, except that `UTC` then returns `utc()`. Fails with `Malformed` when the file is unreadable or is not valid TZif data.
pub fn named(name: str) -> Zone ! fault.Fault {
    check_name(name)?
    let data = find_file(name)? ?? return missing(name)
    decode(name, data)
}

fn missing(name: str) -> Zone ! fault.Fault {
    if name == "UTC" {
        return utc()
    }
    fail UnknownZone(name)
}

/// Returns the zone with the name `name`, with its TZif data supplied by `source`.
///
/// `source` returns the data for a name, or `none` when it has none. Use `tzdata.source()` to read the embedded database. Fails with `Invalid` for a bad name as `named` does, with `UnknownZone` when `source` returns `none`, and with `Malformed` when the data is not valid.
pub fn load_from(name: str, source: fn(str) -> []u8?) -> Zone ! fault.Fault {
    check_name(name)?
    let data = source(name) ?? fail UnknownZone(name)
    decode(name, data)
}

fn load_or_none(name: str) -> Zone? {
    let z = named(name) or return none
    z
}

fn name_from_path(path: str) -> str {
    let marker = "zoneinfo/"
    let at = text.last_index(path, marker)
    if at < 0 { path } else { path[at + marker.len..] }
}

fn from_path(path: str) -> Zone ! fault.Fault {
    let data = try_read(path)? ?? fail UnknownZone(path)
    decode(name_from_path(path), data)
}

fn from_variable(value: str) -> Zone ! fault.Fault {
    let rule = if value.len > 0 && value[0] == ':' { value[1..] } else { value }
    if rule.len == 0 {
        return utc()
    }
    if rule[0] == '/' {
        return from_path(rule)
    }
    let named = load_or_none(rule) ?? return posix_or_unknown(rule)
    named
}

fn posix_or_unknown(rule: str) -> Zone ! fault.Fault {
    from_posix(rule, rule) or fail UnknownZone(rule)
}

fn from_localtime() -> Zone? {
    let data = file.read_file("/etc/localtime") or return none
    let target = file.readlink("/etc/localtime") or ""
    let name = if target.len == 0 { "Local" } else { name_from_path(target) }
    let z = decode(name, data) or return none
    z
}

fn from_timezone_file() -> Zone? {
    let content = file.read_text("/etc/timezone") or return none
    load_or_none(text.trim(content))
}

/// Returns the system's local time zone.
///
/// The `TZ` environment variable is used when it is set. A leading `:` is dropped, an empty value is UTC, a value starting with `/` is a zone file, and other values are tried as a zone name and then as a POSIX rule. Failing all of those gives `UnknownZone`. Without `TZ` the zone comes from `/etc/localtime`, named from the link target after `zoneinfo/` or `Local`, then from the name in `/etc/timezone`, and falls back to UTC.
pub fn local() -> Zone ! fault.Fault {
    match os.env("TZ") {
        some(value) => return from_variable(value)
        none => {}
    }
    from_localtime() ?? from_timezone_file() ?? utc()
}

fn info_of(k: Kind) -> Info {
    Info { offset: k.offset, abbreviation: k.abbreviation, dst: k.dst }
}

fn count_through(times: []i64, key: i64) -> i64 {
    var low = 0
    var high = times.len
    for low < high {
        let mid = (low + high) / 2
        if times[mid] <= key {
            low = mid + 1
        } else {
            high = mid
        }
    }
    low
}

fn after_table(r: *Rules, at: i64) -> Kind {
    match r.footer {
        some(f) => footer_kind(f, at)
        none => r.last
    }
}

fn kind_at(r: *Rules, at: i64) -> Kind {
    let n = r.times.len
    if n == 0 {
        return after_table(r, at)
    }
    if at < r.times[0] {
        return r.before
    }
    let i = count_through(r.times, at) - 1
    if i == n - 1 {
        return after_table(r, at)
    }
    r.segments[i]
}

fn kind_in(r: *Rules, i: i64) -> Kind {
    if i < 0 {
        return r.before
    }
    if i == r.times.len - 1 {
        return after_table(r, r.times[i])
    }
    r.segments[i]
}

fn next_flip(r: *Rules, after: i64) -> Flip? {
    let n = r.times.len
    var i = count_through(r.times, after)
    for i < n {
        let flip = Flip { at: r.times[i], before: kind_in(r, i - 1), after: kind_in(r, i) }
        if changed(flip.before, flip.after) {
            return flip
        }
        i += 1
    }
    let f = r.footer ?? return none
    let floor = if n > 0 && r.times[n - 1] > after { r.times[n - 1] } else { after }
    footer_next(f, floor)
}

fn footer_previous_flip(r: *Rules, bound: i64) -> Flip? {
    let f = r.footer ?? return none
    let flip = footer_previous(f, bound) ?? return none
    if r.times.len == 0 || flip.at > r.times[r.times.len - 1] {
        return flip
    }
    none
}

fn previous_flip(r: *Rules, bound: i64) -> Flip? {
    match footer_previous_flip(r, bound) {
        some(flip) => return flip
        none => {}
    }
    var i = count_through(r.times, bound - 1) - 1
    for i >= 0 {
        let flip = Flip { at: r.times[i], before: kind_in(r, i - 1), after: kind_in(r, i) }
        if changed(flip.before, flip.after) {
            return flip
        }
        i -= 1
    }
    none
}

/// Returns the `Info` in force in `z` at `ts`.
pub fn info_at(z: Zone, ts: timestamp.Timestamp) -> Info {
    info_of(kind_at(z.rules, timestamp.unix_seconds(ts)))
}

/// Returns the UTC offset in force in `z` at `ts`.
pub fn offset_at(z: Zone, ts: timestamp.Timestamp) -> offset.Offset {
    kind_at(z.rules, timestamp.unix_seconds(ts)).offset
}

/// Returns whether daylight saving time is in effect in `z` at `ts`.
pub fn is_dst_at(z: Zone, ts: timestamp.Timestamp) -> bool {
    kind_at(z.rules, timestamp.unix_seconds(ts)).dst
}

fn transition_of(flip: Flip) -> Transition? {
    let at = timestamp.from_unix(flip.at) or return none
    Transition { at, before: info_of(flip.before), after: info_of(flip.after) }
}

fn ceil_seconds(ts: timestamp.Timestamp) -> i64 {
    timestamp.unix_seconds(ts) + if timestamp.subsec_nanos(ts) > 0 { 1 } else { 0 }
}

/// Returns the first change of offset, abbreviation or daylight saving flag after `ts`, or `none` when the zone has none after it.
///
/// A fraction of a second in `ts` is ignored. A transition outside the supported timestamp years is not returned.
pub fn next_transition(z: Zone, ts: timestamp.Timestamp) -> Transition? {
    let flip = next_flip(z.rules, timestamp.unix_seconds(ts)) ?? return none
    transition_of(flip)
}

/// Returns the latest change of offset, abbreviation or daylight saving flag before `ts`, or `none` when the zone has none before it.
pub fn previous_transition(z: Zone, ts: timestamp.Timestamp) -> Transition? {
    let flip = previous_flip(z.rules, ceil_seconds(ts)) ?? return none
    transition_of(flip)
}

/// Returns the changes of `z` from `from` up to but not including `to`, in time order.
///
/// At most 10000 are returned.
pub fn transitions(z: Zone, from: timestamp.Timestamp, to: timestamp.Timestamp) -> []Transition {
    var found: []Transition = []
    let end = ceil_seconds(to)
    var cursor = ceil_seconds(from) - 1
    for found.len < transition_limit {
        let flip = next_flip(z.rules, cursor) ?? break
        if flip.at >= end {
            break
        }
        let t = transition_of(flip) ?? break
        push(mut found, t)
        cursor = flip.at
    }
    found
}

fn window_flips(r: *Rules, low: i64, high: i64) -> []Flip {
    var flips: []Flip = []
    var cursor = low
    for flips.len < 16 {
        let flip = next_flip(r, cursor) ?? break
        if flip.at > high {
            break
        }
        push(mut flips, flip)
        cursor = flip.at
    }
    flips
}

fn has_offset(found: []offset.Offset, o: offset.Offset) -> bool {
    found.contains(o)
}

fn valid_offsets(r: *Rules, local_seconds: i64, flips: []Flip) -> []offset.Offset {
    var tried: []offset.Offset = [kind_at(r, local_seconds - 100000).offset]
    for flip in flips {
        if !has_offset(tried, flip.after.offset) {
            push(mut tried, flip.after.offset)
        }
    }
    var valid: []offset.Offset = []
    for o in tried {
        if kind_at(r, local_seconds - offset.seconds_of(o)).offset == o {
            push(mut valid, o)
        }
    }
    valid
}

fn gap_at(flips: []Flip, local_seconds: i64) -> Candidates? {
    for flip in flips {
        let before = secs(flip.before)
        let after = secs(flip.after)
        if before < after && flip.at + before <= local_seconds && local_seconds < flip.at + after {
            return Gap(flip.before.offset, flip.after.offset)
        }
    }
    none
}

fn overlap_of(valid: []offset.Offset) -> Candidates {
    var earlier = valid[0]
    var later = valid[0]
    for o in valid {
        earlier = offset.max(earlier, o)
        later = offset.min(later, o)
    }
    Overlap(earlier, later)
}

/// Returns the offsets `z` allows for a local time given as seconds since the Unix epoch counted as if the local clock were UTC.
///
/// The result is `One` for a time that occurs once, `Overlap` for one that occurs twice and `Gap` for one that does not occur.
pub fn candidates(z: Zone, local_seconds: i64) -> Candidates {
    let r = z.rules
    let flips = window_flips(r, local_seconds - 100000, local_seconds + 100000)
    let valid = valid_offsets(r, local_seconds, flips)
    match valid.len {
        1 => One(valid[0])
        > 1 => overlap_of(valid)
        _ => gap_at(flips, local_seconds) ?? One(kind_at(r, local_seconds).offset)
    }
}
