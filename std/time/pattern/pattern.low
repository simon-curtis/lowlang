import std/builder
import std/text
import std/time/calendar
import std/time/fault

/// The calendar and clock values a pattern reads or writes, each optional so that a pattern can fill in only the parts it names.
///
/// `render` takes the values to print from it and `scan` returns the values it found in it. The date and time types convert to and from `Fields` with `to_fields` and `from_fields`.
pub struct Fields {
    /// The year, which can be negative.
    pub year: i64? = none
    /// The month, from `1` for January to `12`.
    pub month: i64? = none
    /// The day of the month, from `1` to `31`.
    pub day: i64? = none
    /// The day of the year, from `1` to `366`.
    pub day_of_year: i64? = none
    /// The ISO weekday, from `1` for Monday to `7` for Sunday.
    pub weekday: i64? = none
    /// The ISO 8601 week-numbering year.
    pub iso_year: i64? = none
    /// The ISO 8601 week number, from `1` to `53`.
    pub iso_week: i64? = none
    /// The week of the year counting from the first Sunday, from `0` to `53`.
    pub week_sunday: i64? = none
    /// The week of the year counting from the first Monday, from `0` to `53`.
    pub week_monday: i64? = none
    /// The century, which is the year divided by `100`, from `0` to `99`.
    pub century: i64? = none
    /// The year within its century, from `0` to `99`.
    pub year_of_century: i64? = none
    /// The hour on the 24-hour clock, from `0` to `23`.
    pub hour: i64? = none
    /// The hour on the 12-hour clock, from `1` to `12`.
    pub hour12: i64? = none
    /// The half of the day: `0` for before noon and `1` for after.
    pub period: i64? = none
    /// The minute, from `0` to `59`.
    pub minute: i64? = none
    /// The second, from `0` to `59`.
    ///
    /// A `60` is read as `59` when scanning.
    pub second: i64? = none
    /// The nanosecond within the second, from `0` to `999999999`.
    pub nanosecond: i64? = none
    /// The offset from UTC in seconds, positive to the east.
    pub offset_seconds: i64? = none
    /// The zone abbreviation, such as `UTC` or `CEST`.
    pub zone_abbreviation: str? = none
    /// The seconds since the Unix epoch.
    pub unix_seconds: i64? = none
}

/// The words a pattern prints and recognises for months, weekdays and the halves of the day.
///
/// Month lists have twelve entries from January and weekday lists have seven entries from Monday. A list of any other length is rejected with `Invalid` by `render`, `scan` and `check_names`.
pub struct Names {
    /// The full month names, from January.
    pub months: []str
    /// The abbreviated month names, from January.
    pub short_months: []str
    /// The full weekday names, from Monday.
    pub weekdays: []str
    /// The abbreviated weekday names, from Monday.
    pub short_weekdays: []str
    /// The text for before noon.
    pub am: str
    /// The text for after noon.
    pub pm: str
}

/// Returns the English `Names`: full and abbreviated months and weekdays, `AM` and `PM`.
pub fn english() -> Names {
    Names {
        months: calendar.month_names(),
        short_months: calendar.short_month_names(),
        weekdays: calendar.weekday_names(),
        short_weekdays: calendar.short_weekday_names(),
        am: "AM",
        pm: "PM"
    }
}

enum Pad {
    Tight
    Space
    Zero
}

struct Spec {
    verb: u8
    pad: Pad
    upper: bool
    arg: i64
}

enum Item {
    Text(text: str)
    Blank(count: i64)
    Field(spec: Spec)
}

/// A layout compiled by `compile`, ready for `render` and `scan`.
pub struct Pattern {
    items: []Item
}

enum Class {
    Unknown
    Locale
    Number
    Name
    Zone
    Fraction
    Composite
    Literal
}

struct Source {
    text: str
    at: i64
    items: []Item
    run: builder.Builder
    blanks: i64
}

fn classify(v: u8) -> Class {
    match v {
        == 'Y' || == 'y' || == 'C' || == 'm' || == 'd' || == 'e' || == 'j' => Class.Number
        == 'u' || == 'w' || == 'U' || == 'W' || == 'V' || == 'G' => Class.Number
        == 'H' || == 'I' || == 'M' || == 'S' || == 's' => Class.Number
        == 'a' || == 'A' || == 'b' || == 'B' || == 'p' || == 'P' || == 'Z' => Class.Name
        == 'z' => Class.Zone
        == 'f' || == 'N' => Class.Fraction
        == 'F' || == 'T' || == 'R' || == 'D' => Class.Composite
        == '%' || == 'n' || == 't' => Class.Literal
        == 'c' || == 'x' || == 'X' => Class.Locale
        _ => Class.Unknown
    }
}

fn flush_text(mut s: Source) {
    if builder.len(s.run) == 0 {
        return
    }
    let item = Item.Text(builder.to_str(s.run))
    push(mut s.items, item)
    s.run = builder.builder()
}

fn flush_blanks(mut s: Source) {
    if s.blanks == 0 {
        return
    }
    let item = Item.Blank(s.blanks)
    push(mut s.items, item)
    s.blanks = 0
}

fn add_byte(mut s: Source, c: u8) {
    flush_blanks(mut s)
    builder.write_byte(mut s.run, c)
}

fn add_blank(mut s: Source) {
    flush_text(mut s)
    s.blanks += 1
}

fn add_field(mut s: Source, spec: Spec) {
    flush_text(mut s)
    flush_blanks(mut s)
    let item = Item.Field(spec)
    push(mut s.items, item)
}

fn default_pad(verb: u8) -> Pad {
    if verb == 'e' { Pad.Space } else { Pad.Zero }
}

fn add_plain(mut s: Source, verb: u8) {
    let spec = Spec { verb, pad: default_pad(verb), upper: false, arg: 0 }
    add_field(mut s, spec)
}

fn add_composite(mut s: Source, verb: u8) {
    match verb {
        'F' => {
            add_plain(mut s, 'Y')
            add_byte(mut s, '-')
            add_plain(mut s, 'm')
            add_byte(mut s, '-')
            add_plain(mut s, 'd')
        }
        'T' => {
            add_plain(mut s, 'H')
            add_byte(mut s, ':')
            add_plain(mut s, 'M')
            add_byte(mut s, ':')
            add_plain(mut s, 'S')
        }
        'R' => {
            add_plain(mut s, 'H')
            add_byte(mut s, ':')
            add_plain(mut s, 'M')
        }
        _ => {
            add_plain(mut s, 'm')
            add_byte(mut s, '/')
            add_plain(mut s, 'd')
            add_byte(mut s, '/')
            add_plain(mut s, 'y')
        }
    }
}

struct Modifiers {
    pad: Pad?
    pad_at: i64
    upper_at: i64
    arg: i64
    arg_at: i64
    colons: i64
}

fn padding_flag(c: u8) -> Pad? {
    match c {
        '-' => Pad.Tight
        '_' => Pad.Space
        _ => if c == '0' { Pad.Zero } else { none }
    }
}

fn read_flags(mut s: Source) -> Modifiers {
    var m = Modifiers { pad: none, pad_at: -1, upper_at: -1, arg: 0, arg_at: -1, colons: 0 }
    for s.at < s.text.len {
        let c = s.text[s.at]
        let pad = padding_flag(c)
        if pad != none {
            m.pad = pad
            m.pad_at = s.at
        } else if c == '^' {
            m.upper_at = s.at
        } else {
            break
        }
        s.at += 1
    }
    if s.at < s.text.len && s.text[s.at] >= '0' && s.text[s.at] <= '9' {
        m.arg = i64(s.text[s.at] - '0')
        m.arg_at = s.at
        s.at += 1
    }
    for s.at < s.text.len && s.text[s.at] == ':' {
        m.colons += 1
        s.at += 1
    }
    m
}

fn first_flag(m: Modifiers) -> i64 {
    if m.pad_at >= 0 && (m.upper_at < 0 || m.pad_at < m.upper_at) {
        return m.pad_at
    }
    m.upper_at
}

fn verb_text(v: u8) -> str {
    text.from_char(u32(v))
}

fn reject_flags(m: Modifiers) ! fault.Fault {
    let at = first_flag(m)
    if at >= 0 {
        fail Syntax(at)
    }
}

fn reject_arguments(m: Modifiers, verb_at: i64) ! fault.Fault {
    if m.arg_at >= 0 || m.colons > 0 {
        fail Syntax(verb_at)
    }
}

fn compile_number(mut s: Source, m: Modifiers, verb: u8) ! fault.Fault {
    if m.upper_at >= 0 {
        fail Syntax(m.upper_at)
    }
    let spec = Spec { verb, pad: m.pad ?? default_pad(verb), upper: false, arg: 0 }
    add_field(mut s, spec)
}

fn compile_name(mut s: Source, m: Modifiers, verb: u8) ! fault.Fault {
    if m.pad_at >= 0 {
        fail Syntax(m.pad_at)
    }
    if verb == 'P' && m.upper_at >= 0 {
        fail Syntax(m.upper_at)
    }
    let spec = Spec { verb, pad: Pad.Zero, upper: m.upper_at >= 0, arg: 0 }
    add_field(mut s, spec)
}

fn compile_zone(mut s: Source, m: Modifiers, at: i64) ! fault.Fault {
    reject_flags(m)?
    if m.arg_at >= 0 || m.colons > 2 {
        fail Syntax(at)
    }
    let spec = Spec { verb: 'z', pad: Pad.Zero, upper: false, arg: m.colons }
    add_field(mut s, spec)
}

fn compile_fraction(mut s: Source, m: Modifiers, verb: u8, at: i64) ! fault.Fault {
    reject_flags(m)?
    if m.colons > 0 {
        fail Syntax(at)
    }
    if verb == 'N' {
        if m.arg_at >= 0 {
            fail Syntax(at)
        }
        let spec = Spec { verb: 'f', pad: Pad.Zero, upper: false, arg: 9 }
        add_field(mut s, spec)
        return
    }
    if m.arg_at >= 0 && m.arg != 3 && m.arg != 6 && m.arg != 9 {
        fail Syntax(m.arg_at)
    }
    let spec = Spec { verb: 'f', pad: Pad.Zero, upper: false, arg: m.arg }
    add_field(mut s, spec)
}

fn compile_verb(mut s: Source) ! fault.Fault {
    s.at += 1
    let m = read_flags(mut s)
    if s.at >= s.text.len {
        fail Syntax(s.text.len)
    }
    let at = s.at
    let verb = s.text[at]
    s.at += 1
    let class = classify(verb)
    if class == Class.Unknown {
        fail Syntax(at)
    }
    if class == Class.Locale {
        fail Unsupported("locale verb %{verb_text(verb)}")
    }
    if class == Class.Zone {
        compile_zone(mut s, m, at)?
        return
    }
    if class == Class.Fraction {
        compile_fraction(mut s, m, verb, at)?
        return
    }
    reject_arguments(m, at)?
    if class == Class.Number {
        compile_number(mut s, m, verb)?
        return
    }
    if class == Class.Name {
        compile_name(mut s, m, verb)?
        return
    }
    reject_flags(m)?
    if class == Class.Composite {
        add_composite(mut s, verb)
        return
    }
    let literal: u8 = match verb { 'n' => '\n', 't' => '\t', _ => '%' }
    add_byte(mut s, literal)
}

/// Compiles a layout into a `Pattern`.
///
/// Text is copied as written and a `%` starts a verb. The verbs are:
///
/// - Date: `%Y` year, `%y` year of century, `%C` century, `%m` month, `%d` day, `%e` day padded with a space, `%j` day of year, `%u` weekday from `1` for Monday, `%w` weekday from `0` for Sunday, `%U` and `%W` week of the year from Sunday or Monday, `%V` ISO week and `%G` ISO year.
/// - Names: `%a` and `%A` short and full weekday, `%b` and `%B` short and full month, `%p` `AM` or `PM` and `%P` the same in lower case, `%Z` the zone abbreviation.
/// - Time: `%H` hour, `%I` hour on the 12-hour clock, `%M` minute, `%S` second and `%s` Unix seconds.
/// - Fraction: `%f` six digits when formatting and one to nine when parsing, `%3f`, `%6f` and `%9f` an exact digit count, and `%N` nine digits.
/// - Offset: `%z` as `+hhmm`, `%:z` as `+hh:mm` and `%::z` as `+hh:mm:ss`.
/// - Shorthand: `%F` for `%Y-%m-%d`, `%T` for `%H:%M:%S`, `%R` for `%H:%M` and `%D` for `%m/%d/%y`.
/// - Literal: `%%`, `%n` for a newline and `%t` for a tab.
///
/// Numeric verbs take a padding flag after the `%`: `-` for none, `_` for spaces and `0` for zeros. Name verbs take `^` to print in upper case. Numbers are zero padded by default, except `%e`. A run of spaces in the layout prints that many spaces and matches that many or more when scanning. Fails with `Syntax` at the offset of an unknown verb, a flag the verb does not accept or an incomplete verb, and with `Unsupported` for the locale verbs `%c`, `%x` and `%X`.
pub fn compile(text: str) -> Pattern ! fault.Fault {
    var s = Source { text, at: 0, items: [], run: builder.builder(), blanks: 0 }
    for s.at < text.len {
        let c = text[s.at]
        match c {
            '%' => compile_verb(mut s)?
            ' ' => {
                add_blank(mut s)
                s.at += 1
            }
            _ => {
                add_byte(mut s, c)
                s.at += 1
            }
        }
    }
    flush_text(mut s)
    flush_blanks(mut s)
    Pattern { items: s.items }
}

/// Which kinds of value a pattern touches, as returned by `uses`.
pub struct Uses {
    /// The pattern uses a year, month, day, weekday or week verb.
    pub date: bool
    /// The pattern uses an hour, minute, second, fraction or `am`/`pm` verb.
    pub time: bool
    /// The pattern uses the UTC offset verb `%z`.
    pub offset: bool
    /// The pattern uses the zone abbreviation verb `%Z`.
    pub zone: bool
    /// The pattern uses the Unix seconds verb `%s`.
    pub unix: bool
}

fn is_date_verb(v: u8) -> bool {
    v == 'Y' || v == 'y' || v == 'C' || v == 'm' || v == 'd' || v == 'e' || v == 'j' || v == 'b' || v == 'B' || v == 'a' || v == 'A' ||
        v == 'u' || v == 'w' || v == 'U' || v == 'W' || v == 'V' || v == 'G'
}

fn is_time_verb(v: u8) -> bool {
    v == 'H' || v == 'I' || v == 'M' || v == 'S' || v == 'f' || v == 'p' || v == 'P'
}

/// Returns which kinds of value `p` reads or writes.
pub fn uses(p: Pattern) -> Uses {
    var u = Uses { date: false, time: false, offset: false, zone: false, unix: false }
    for item in p.items {
        match item {
            Field(spec) => {
                if is_date_verb(spec.verb) {
                    u.date = true
                } else if is_time_verb(spec.verb) {
                    u.time = true
                } else if spec.verb == 'z' {
                    u.offset = true
                } else if spec.verb == 'Z' {
                    u.zone = true
                } else {
                    u.unix = true
                }
            }
            _ => {}
        }
    }
    u
}

/// Checks that `p` uses only the kinds of value the caller supplies, where `date` and `time` say whether date and time-of-day values are available.
///
/// Fails with `Invalid` when `p` needs a date or a time of day that is not available, and always when it needs an offset, a zone name or Unix time.
pub fn restrict(p: Pattern, date: bool, time: bool) ! fault.Fault {
    let u = uses(p)
    if u.date && !date {
        fail Invalid("pattern needs date")
    }
    if u.time && !time {
        fail Invalid("pattern needs time of day")
    }
    if u.offset {
        fail Invalid("pattern needs offset")
    }
    if u.zone {
        fail Invalid("pattern needs zone name")
    }
    if u.unix {
        fail Invalid("pattern needs unix time")
    }
}

/// Checks that `n` has twelve month names, twelve short month names, seven weekday names and seven short weekday names.
///
/// Fails with `Invalid` otherwise.
pub fn check_names(n: Names) ! fault.Fault {
    if n.months.len != 12 || n.short_months.len != 12 || n.weekdays.len != 7 || n.short_weekdays.len != 7 {
        fail Invalid("pattern names")
    }
}
