import std/time/date
import std/time/datetime
import std/time/fault
import std/time/pattern

fn german() -> pattern.Names {
    pattern.Names {
        months: ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"],
        short_months: ["Jan", "Feb", "Mär", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Dez"],
        weekdays: ["Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag"],
        short_weekdays: ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"],
        am: "vorm.",
        pm: "nachm."
    }
}

/// Compiles layouts once, renders and reads them for several dates, and swaps in German names.
fn main() ! fault.Fault {
    let stamp = pattern.compile("%Y%m%dT%H%M%S")?
    let long = pattern.compile("%A, %-d. %B %Y, %I:%M %p")?
    let uses = pattern.uses(long)
    print("long layout reads date {uses.date} time {uses.time} offset {uses.offset} zone {uses.zone}")

    let moments = [
        datetime.of(2026, 11, 13, 9, 5, 0, 0)?,
        datetime.of(2026, 12, 24, 18, 30, 15, 0)?
    ]
    for moment in moments {
        let file_name = datetime.format_with(moment, stamp)?
        let english = datetime.format_with(moment, long)?
        let deutsch = datetime.format_names(moment, long, german())?
        print("{file_name}")
        print("  {english}")
        print("  {deutsch}")
    }

    let parsed = datetime.parse_pattern("20261113T090500", stamp)?
    print("parsed {datetime.to_string(parsed)}")
    let reply = datetime.parse_names("Freitag, 13. November 2026, 09:05 vorm.", long, german())?
    print("parsed {datetime.to_string(reply)}")

    let fields = pattern.scan(pattern.compile("%d/%m/%y")?, "13/11/26", pattern.english())?
    print("day {fields.day ?? 0} month {fields.month ?? 0} year of century {fields.year_of_century ?? 0}")
    let birthday = date.from_fields(fields)?
    print("century is read as {date.to_string(birthday)}")

    let flags = pattern.compile("%^a %_d %j %U %u")?
    print(pattern.render(flags, datetime.to_fields(moments[0]), pattern.english())?)

    let date_only = pattern.compile("%Y-%m-%d")?
    pattern.restrict(date_only, true, false)?
    print("a date layout restricted to dates is accepted")
    let clock_only = pattern.compile("%H:%M")?
    pattern.restrict(clock_only, true, false) catch {
        f => print("restricting a time layout to dates: {fault.to_string(f)}")
    }

    let verbs = pattern.compile("%Y-%q") catch {
        Syntax(at) => {
            print("unknown verb at byte {at}")
            pattern.compile("%Y")?
        }
        _ => pattern.compile("%Y")?
    }
    print("fell back to {pattern.uses(verbs).date}")
}
