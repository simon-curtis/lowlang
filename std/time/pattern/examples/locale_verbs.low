import std/locale
import std/locale/datefmt
import std/time/datetime
import std/time/fault
import std/time/pattern

fn render(tag: str, layout: str, dt: datetime.DateTime) -> str ! fault.Fault {
    let l = locale.parse(tag) or locale.root()
    let layouts = datefmt.layouts(l) or pattern.Layouts { date: "%F", time: "%T", date_time: "%F %T" }
    let p = pattern.compile_in(layout, layouts)?
    datetime.format_names(dt, p, datefmt.names(l))?
}

fn main() {
    let dt = datetime.of(2024, 3, 5, 15, 45, 30, 0) or datetime.epoch()
    for tag in ["en", "en-GB", "de", "fr", "ja"] {
        let line = render(tag, "%x | %X | %c | %A %B" , dt) catch {
            e => "error"
        }
        print("{tag}: {line}")
    }
}
