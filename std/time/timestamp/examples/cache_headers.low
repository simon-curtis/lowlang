import std/time/duration
import std/time/fault
import std/time/rounding
import std/time/timestamp

fn describe(label: str, ts: timestamp.Timestamp) {
    print("{label}: {timestamp.to_string(ts)} ({timestamp.unix_seconds(ts)})")
}

fn modified_since(last_modified: str, header: str) -> str ! fault.Fault {
    let modified = timestamp.parse_http_date(last_modified)?
    let since = timestamp.parse_http_date(header)?
    if timestamp.after(modified, since) {
        return "200 send the body"
    }
    "304 not modified"
}

/// Reads HTTP dates and RFC 3339 times, decides freshness and renders the headers back.
fn main() ! fault.Fault {
    let stored = timestamp.parse("2026-11-13T10:30:15.250+02:00")?
    describe("stored", stored)

    let expires = timestamp.plus(stored, duration.hours(24))?
    print("Expires: {timestamp.to_http_date(expires)}")

    let request = timestamp.parse_http_date("Fri, 13 Nov 2026 18:00:00 GMT")?
    let age = timestamp.since(request, stored)
    print("age {duration.friendly(age)}")
    print("fresh {timestamp.before(request, expires)}")

    let whole = timestamp.truncate(stored, duration.seconds(1))?
    print("Last-Modified: {timestamp.to_http_date(whole)}")
    let hour = timestamp.round(stored, duration.hours(1), rounding.Rounding.HalfExpand)?
    describe("nearest hour", hour)

    let verdict = modified_since("Fri, 13 Nov 2026 08:30:15 GMT", "Thu, 12 Nov 2026 00:00:00 GMT")?
    print(verdict)
    let unchanged = modified_since("Fri, 13 Nov 2026 08:30:15 GMT", "Fri, 13 Nov 2026 08:30:15 GMT")?
    print(unchanged)

    let legacy = timestamp.parse_http_date("Friday, 13-Nov-26 08:30:15 GMT")?
    print("rfc 850 {timestamp.to_string(legacy)}")

    let bad = timestamp.parse("2026-11-13 10:30") catch {
        Syntax(at) => {
            print("rejected at byte {at}")
            return
        }
        _ => return
    }
    print("parsed {timestamp.to_string(bad)}")
}
