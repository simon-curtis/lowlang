import std/time/date
import std/time/datetime
import std/time/duration
import std/time/fault
import std/time/rounding
import std/time/span
import std/time/timeofday

fn show(label: str, dt: datetime.DateTime) {
    print("{label}: {datetime.format(dt, "%a %d %b %H:%M") or "?"}")
}

/// Books recurring appointments on wall-clock times that carry no zone, snaps a request to the slot grid and measures the gaps.
fn main() ! fault.Fault {
    let requested = datetime.parse("2026-11-13T09:07:41.5")?
    let slot = datetime.round(requested, span.Unit.Minutes, 15, rounding.Rounding.HalfExpand)?
    show("requested", requested)
    show("slot", slot)
    show("slot starts the hour", datetime.truncate(slot, span.Unit.Hours)?)

    let visit = datetime.plus_duration(slot, duration.minutes(45))?
    show("visit ends", visit)

    let checkups = [
        datetime.plus(slot, span.weeks(2))?,
        datetime.plus(slot, span.months(3))?,
        datetime.plus(slot, span.of_calendar(1, 0, 0, 0, duration.hours(2))?)?
    ]
    for next in checkups {
        let wait = datetime.until(slot, next, span.Diff { largest: span.Unit.Years, smallest: span.Unit.Hours })?
        print("  {datetime.to_string(next)} in {span.friendly(wait)}")
    }

    let closing = datetime.end_of_day(datetime.date(slot))
    print("closing {datetime.to_string(closing)}")
    print("minutes left in the day: {duration.whole_minutes(datetime.duration_until(slot, closing))}")

    let lunch = datetime.with_time(slot, timeofday.noon())
    print("lunch is after the slot: {datetime.after(lunch, slot)}")

    let held = datetime.parse_with("2026-12-24 08:30", "%Y-%m-%d %H:%M")?
    print("christmas eve slot {datetime.to_string(held)}, {date.weekday_name(datetime.weekday(held))}")
    print("earlier of the two: {datetime.to_string(datetime.min(held, slot))}")

    let zoned = datetime.parse("2026-11-13T09:00:00+01:00") catch {
        Syntax(at) => {
            print("offsets are not civil time: rejected at byte {at}")
            return
        }
        _ => return
    }
    print(datetime.to_string(zoned))
}
