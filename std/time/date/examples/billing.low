import std/time/clock
import std/time/date
import std/time/fault
import std/time/span
import std/time/timestamp

fn label(d: date.Date) -> str {
    "{date.weekday_short_name(date.weekday(d))} {date.to_string(d)}"
}

fn next_business_day(d: date.Date) -> date.Date ! fault.Fault {
    var day = date.plus_days(d, 1)?
    for date.weekday(day) == date.Weekday.Saturday || date.weekday(day) == date.Weekday.Sunday {
        day = date.plus_days(day, 1)?
    }
    day
}

/// Builds a monthly billing schedule that clamps at month ends and moves due dates off weekends.
fn main() ! fault.Fault {
    let now = timestamp.parse("2026-11-13T09:00:00Z")?
    let c = clock.fixed(now)
    let today = date.today(c)
    print("today is {label(today)}, day {date.day_of_year(today)} of {date.days_in_year(today)}, quarter {date.quarter(today)}")

    let anchor = date.of(2026, 1, 31)?
    print("subscription anchored on {label(anchor)}")
    for n in 1..5 {
        let due = date.plus_months(anchor, n)?
        print("  month {n}: due {label(due)}")
    }

    let first_due = date.plus(anchor, span.months(1))?
    let payable = next_business_day(first_due)?
    print("first invoice due {label(first_due)}, collected {label(payable)}")

    let friday = date.next_weekday(today, date.Weekday.Friday)?
    let on_friday = date.on_or_next(today, date.Weekday.Friday)?
    print("next friday {label(friday)}, on or next friday {label(on_friday)}")
    let thanksgiving = date.from_weekday_in_month(2026, date.Month.November, date.Weekday.Thursday, 4)?
    print("fourth thursday of november {label(thanksgiving)}")

    let fiscal_end = date.of(2027, 3, 31)?
    let to_end = date.until(today, fiscal_end, span.Diff { largest: span.Unit.Months })?
    print("until {label(fiscal_end)}: {span.friendly(to_end)}")

    var weekdays = 0
    for day in date.range_inclusive(date.first_of_month(today), date.last_of_month(today))? {
        let w = date.weekday(day)
        if w != date.Weekday.Saturday && w != date.Weekday.Sunday {
            weekdays += 1
        }
    }
    print("{date.month_name(date.month(today))} has {weekdays} weekdays of {date.days_in_month(today)} days")

    let week = date.iso_week(today)
    print("iso week {week.year}-W{week.week}")
    print("format: {date.format(today, "%A, %-d %B %Y")?}")
    let parsed = date.parse_with("13/11/2026", "%d/%m/%Y")?
    print("parsed {date.to_string(parsed)} equal {date.equal(parsed, today)}")

    let impossible = date.of(2026, 2, 30) catch {
        Invalid(what) => {
            print("rejected: invalid {what}")
            return
        }
        _ => return
    }
    print(date.to_string(impossible))
}
